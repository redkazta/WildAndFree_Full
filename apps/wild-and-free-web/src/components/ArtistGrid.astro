---
import ArtistCard from './ArtistCard.astro';

export type Props = {
  artists: Array<{
    id: string;
    name: string;
    role: string;
    image_url: string;
  }>;
};

const { artists } = Astro.props;
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
	{artists.map((artist) => <ArtistCard artist={artist} />)}
</div>

<style>
	/* Usando Tailwind */
</style>
