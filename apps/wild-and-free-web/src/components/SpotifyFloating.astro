---
import { fade } from 'astro:transitions';
---
<!-- Spotify Floating Player (Global) -->
<!-- Uses Spotify Embed Iframe for auth/playback handling -->
<!-- Fallback to Mock if needed (handled by iframe src) -->
<div id="spotify-floating" transition:persist class="fixed bottom-6 right-6 z-[9999] w-[260px] sm:w-[300px]">
  <div id="spotify-container" class="bg-black/95 backdrop-blur-md border border-[var(--primary)]/30 rounded-xl overflow-hidden shadow-[0_8px_32px_rgba(0,0,0,0.5)] w-full h-[80px] hover:border-[var(--primary)]/60 transition-all">
    <iframe 
        id="spotify-iframe"
        style="border-radius:12px" 
        src="https://open.spotify.com/embed/track/4cOdK2wGLETKBW3PvgPWqT?utm_source=generator&theme=0" 
        width="100%" 
        height="100%" 
        frameborder="0" 
        allowfullscreen="" 
        allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" 
        loading="lazy">
    </iframe>
  </div>
</div>

<script>
    const spotifyIframe = document.getElementById('spotify-iframe') as HTMLIFrameElement;
    
    // Listen for external play events (from Search or elsewhere)
    window.addEventListener('play-spotify-track', (e: any) => {
        const trackId = e.detail?.id;
        if (trackId && spotifyIframe) {
            // Update src to new track
            spotifyIframe.src = `https://open.spotify.com/embed/track/${trackId}?utm_source=generator&theme=0`;
        }
        
        // Pause Radio if playing
        window.dispatchEvent(new CustomEvent('pause-radio'));
    });
</script>
