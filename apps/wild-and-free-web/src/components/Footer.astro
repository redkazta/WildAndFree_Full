---
---

<footer class="bg-[var(--bg)] border-t border-[var(--border)] pt-12 md:pt-24 pb-8 md:pb-12 px-6">
  <div class="max-w-[1400px] mx-auto space-y-12 md:space-y-16">
    <div class="flex flex-col md:flex-row justify-between items-start gap-8 md:gap-12">
      <div class="space-y-6">
        <div class="text-3xl font-black tracking-[0.2em]">
          <span class="text-wild-orange">WILD</span>
          <span class="text-[var(--text)]">GVNG</span>
        </div>
        <p class="text-[var(--text)] font-bold text-sm tracking-widest max-w-xs">
          Redefiniendo la cultura urbana desde el underground hasta la cima.
        </p>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 gap-8 md:gap-24">
        <div class="space-y-6">
          <h4 class="text-label-sm font-black uppercase tracking-widest text-wild-orange/80">Navegación</h4>
          <ul class="space-y-4">
            <li><a href="/artistas" class="text-sm font-black text-[var(--text)] hover:text-wild-orange transition-colors">Artistas</a></li>
            <li><a href="/musica" class="text-sm font-black text-[var(--text)] hover:text-wild-orange transition-colors">Música</a></li>
            <li><a href="/eventos" class="text-sm font-black text-[var(--text)] hover:text-wild-orange transition-colors">Eventos</a></li>
            <li><a href="/tienda" class="text-sm font-black text-[var(--text)] hover:text-wild-orange transition-colors">Tienda</a></li>
          </ul>
        </div>
        <div class="space-y-6">
          <h4 class="text-label-sm font-black uppercase tracking-widest text-wild-orange/80">Cuenta</h4>
          <ul class="space-y-4">
            <li><a href="/login" class="text-sm font-black text-[var(--text)] hover:text-wild-orange transition-colors">Login</a></li>
            <li><a href="/registro" class="text-sm font-black text-[var(--text)] hover:text-wild-orange transition-colors">Registro</a></li>
            <li><a href="/perfil" class="text-sm font-black text-[var(--text)] hover:text-wild-orange transition-colors">Mi Perfil</a></li>
          </ul>
        </div>
        <div class="space-y-6">
          <h4 class="text-label-sm font-black uppercase tracking-widest text-wild-orange/80">Social</h4>
          <div class="flex gap-4">
            <a href="#" class="w-9 h-9 md:w-10 md:h-10 rounded-wild-lg bg-[var(--bg-card)] border border-[var(--border)] flex items-center justify-center text-[var(--text)] hover:bg-wild-orange hover:text-black transition-all">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                        </a>
                        <a href="#" class="w-9 h-9 md:w-10 md:h-10 rounded-wild-lg bg-[var(--bg-card)] border border-[var(--border)] flex items-center justify-center text-[var(--text)] hover:bg-wild-orange hover:text-black transition-all">
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.01 0 0 0-1.94-1.42C18.88 4.67 12 4.67 12 4.67s-6.88 0-8.6.33a2.78 2.01 0 0 0-1.94 1.42A29 29 0 0 0 1 12a29 29 0 0 0 .46 5.58 2.78 2.01 0 0 0 1.94 1.42c1.72.33 8.6.33 8.6.33s6.88 0 8.6-.33a2.78 2.01 0 0 0 1.94-1.42A29 29 0 0 0 23 12a29 29 0 0 0-.46-5.58z"></path><polygon points="9.75 15.02 15.5 12 9.75 8.98 9.75 15.02"></polygon></svg>
                        </a>
          </div>
        </div>
      </div>
    </div>

    <div class="pt-8 border-t border-[var(--border-faint)] flex flex-col md:flex-row justify-between items-center gap-6">
      <p class="text-label-sm font-black uppercase tracking-widest text-[var(--text-faint)]">
        &copy; 2026 Wild Gvng. Todos los derechos reservados.
      </p>
      <div class="flex gap-8">
        <a href="#" class="text-label-sm font-black uppercase tracking-widest text-[var(--text-faint)] hover:text-[var(--text)] transition-colors">Privacidad</a>
        <a href="#" class="text-label-sm font-black uppercase tracking-widest text-[var(--text-faint)] hover:text-[var(--text)] transition-colors">Términos</a>
      </div>
    </div>
  </div>
</footer>
