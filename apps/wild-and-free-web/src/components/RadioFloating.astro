---
---
<!-- Radio Floating Player (Global) -->
<div id="radio-floating" transition:persist class="fixed bottom-4 left-4 z-[9999]">
  <!-- Collapsed: just the icon (mobile) -->
  <button id="radio-expand" class="md:hidden w-10 h-10 rounded-full bg-[var(--bg)] border border-[var(--primary)]/40 flex items-center justify-center shadow-[0_4px_16px_rgba(0,0,0,0.5)] hover:border-[var(--primary)]/70 transition-all active:scale-95">
    <img src="/wg_logo.png" width="24" height="24" class="w-6 h-6 rounded-full object-cover" />
  </button>

  <!-- Full player (always visible on desktop, toggle on mobile) -->
  <div id="radio-full" class="hidden md:flex w-[260px] sm:w-[300px] flex-col bg-[var(--bg)] border border-[var(--primary)]/30 rounded-xl overflow-hidden shadow-[0_8px_32px_rgba(0,0,0,0.5)] group hover:border-[var(--primary)]/60 transition-all">
    <!-- Player Header -->
	    <div class="p-2.5 flex gap-2.5 items-center bg-[var(--bg)]">
        <div class="w-9 h-9 bg-[var(--bg-card)] rounded-lg overflow-hidden flex-shrink-0 relative border border-[var(--border-faint)]">
            <img id="radio-cover" src="/wg_logo.png" width="36" height="36" class="w-full h-full object-cover opacity-80 group-hover:opacity-100 transition-opacity" />
            <div class="absolute inset-0 flex items-center justify-center bg-[var(--bg-card)]">
                <div id="radio-live-dot" class="w-1.5 h-1.5 bg-[var(--text-muted)] rounded-full"></div>
            </div>
        </div>
        <div class="overflow-hidden flex-1 min-w-0">
            <h4 id="radio-title" class="text-[11px] font-black text-[var(--text)] uppercase truncate tracking-wide group-hover:text-[var(--primary)] transition-colors">Wild Gvng Radio</h4>
            <p id="radio-artist" class="text-[8px] text-[var(--text-muted)] font-bold uppercase truncate tracking-wider">Cargando...</p>
        </div>
        <button id="radio-toggle" class="w-7 h-7 bg-[var(--primary)] text-black rounded-full flex items-center justify-center hover:scale-110 active:scale-95 transition-all shadow-[0_0_12px_rgba(201,131,0,0.3)]">
            <svg id="radio-play" width="10" height="10" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            <svg id="radio-pause" width="10" height="10" viewBox="0 0 24 24" fill="currentColor" class="hidden"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
        </button>
    </div>

    <!-- Controls -->
    <div class="px-2.5 pb-1.5 flex items-center justify-between gap-2 border-t border-[var(--border-faint)] pt-1.5" style="background: var(--bg-card);">
        <button id="radio-fav-btn" class="p-1 text-[var(--text-muted)] hover:text-[var(--primary)] transition-colors" title="Favoritos">
            <svg id="radio-fav-icon" width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </button>
        <div id="radio-eq" class="flex items-end gap-0.5 h-3 opacity-0 transition-opacity">
            <div class="w-0.5 bg-[var(--primary)] animate-[eq_1s_ease-in-out_infinite]"></div>
            <div class="w-0.5 bg-[var(--primary)] animate-[eq_1.2s_ease-in-out_infinite_0.1s]"></div>
            <div class="w-0.5 bg-[var(--primary)] animate-[eq_0.8s_ease-in-out_infinite_0.2s]"></div>
            <div class="w-0.5 bg-[var(--primary)] animate-[eq_1.5s_ease-in-out_infinite_0.3s]"></div>
            <div class="w-0.5 bg-[var(--primary)] animate-[eq_0.9s_ease-in-out_infinite_0.4s]"></div>
        </div>
        <button id="radio-info-btn" class="p-1 text-[var(--text-muted)] hover:text-[var(--text)] transition-colors" title="Ver Radio">
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        </button>
    </div>
  </div>
</div>

<style>
    @keyframes eq {
        0%, 100% { height: 20%; }
        50% { height: 80%; }
    }
    /* Mobile: expanded state */
    #radio-floating.expanded #radio-expand { display: none; }
    #radio-floating.expanded #radio-full { display: flex; }
    @media (max-width: 768px) {
      #radio-full { width: 200px !important; }
    }
</style>

<script>
    import { supabase } from '../lib/supabase';
    import { Favorites } from '../lib/favorites.js';

    // Mobile expand/collapse
    const radioExpand = document.getElementById('radio-expand');
    const radioFull = document.getElementById('radio-full');
    const floating = document.getElementById('radio-floating');
    if (radioExpand && floating) {
        radioExpand.addEventListener('click', () => {
            // Close spotify if open
            document.getElementById('spotify-floating')?.classList.remove('expanded');
            floating.classList.toggle('expanded');
        });
        // Close when tapping outside
        document.addEventListener('click', (e) => {
            if (floating.classList.contains('expanded') && !floating.contains(e.target as Node)) {
                floating.classList.remove('expanded');
            }
        });
    }

    const radioToggle = document.getElementById('radio-toggle');
    const radioPlay = document.getElementById('radio-play');
    const radioPause = document.getElementById('radio-pause');
    const radioEq = document.getElementById('radio-eq');
    const radioFavBtn = document.getElementById('radio-fav-btn');
    const radioFavIcon = document.getElementById('radio-fav-icon');
    const radioTitle = document.getElementById('radio-title');
    const radioArtist = document.getElementById('radio-artist');
    const radioCover = document.getElementById('radio-cover') as HTMLImageElement;
    const radioLiveDot = document.getElementById('radio-live-dot');
    const radioInfoBtn = document.getElementById('radio-info-btn');

    let isPlaying = false;
    let audio: HTMLAudioElement | null = null;
    let currentMode: 'live' | 'auto' | 'episode' | 'none' = 'none';
    let currentMetadata: any = {
        id: 'radio-wild-free-fm',
        title: 'Wild Gvng Radio',
        artist: 'Cargando...',
        image: '/wg_logo.png'
    };

    const RADIO_TRACK_ID = 'radio-wild-free-fm';

    function setPlaying(playing: boolean) {
        isPlaying = playing;
        if (radioPlay) radioPlay.classList.toggle('hidden', playing);
        if (radioPause) radioPause.classList.toggle('hidden', !playing);
        if (radioEq) radioEq.style.opacity = playing ? '1' : '0';
        if (radioLiveDot) {
            radioLiveDot.classList.toggle('bg-[var(--text-muted)]', !playing);
            radioLiveDot.classList.toggle('bg-red-500', playing);
            radioLiveDot.classList.toggle('animate-pulse', playing);
        }
    }

    function updateMeta(meta: any) {
        currentMetadata = { ...currentMetadata, ...meta };
        if (radioTitle) radioTitle.textContent = meta.title || currentMetadata.title;
        if (radioArtist) radioArtist.textContent = meta.artist || currentMetadata.artist;
        if (radioCover && meta.image) radioCover.src = meta.image;
    }

    async function loadConfig() {
        try {
            const { data } = await supabase
                .from('radio_config')
                .select('*')
                .eq('id', 'main')
                .single();
            if (data) {
                if (data.live_url) currentMetadata.liveUrl = data.live_url;
                if (data.auto_radio_url) currentMetadata.autoUrl = data.auto_radio_url;
                if (!data.is_live && data.auto_radio_url) {
                    currentMode = 'auto';
                } else if (data.is_live) {
                    currentMode = 'live';
                }
            }
        } catch (e) {
            console.warn('[Radio] Config load error:', e);
        }
    }

    async function loadFavorites() {
        try {
            const favs = await Favorites.get();
            const isFav = favs.some((f: any) => f.track_id === RADIO_TRACK_ID);
            if (radioFavIcon) {
                radioFavIcon.setAttribute('fill', isFav ? 'var(--primary)' : 'none');
            }
            if (radioFavBtn) {
                radioFavBtn.classList.toggle('text-[var(--primary)]', isFav);
                radioFavBtn.classList.toggle('text-[var(--text-muted)]', !isFav);
            }
        } catch (e) {}
    }

    function playRadio() {
        if (audio) { audio.pause(); audio = null; }

        let src = '';
        if (currentMode === 'live' && currentMetadata.liveUrl) {
            src = currentMetadata.liveUrl;
        } else if (currentMode === 'auto' && currentMetadata.autoUrl) {
            src = currentMetadata.autoUrl;
        } else {
            src = 'https://stream.zeno.fm/a3gxu5m2rxzuv';
        }

        audio = new Audio(src);
        audio.play().then(() => setPlaying(true)).catch(() => setPlaying(false));
        audio.onerror = () => setPlaying(false);
        audio.onended = () => setPlaying(false);

        window.dispatchEvent(new CustomEvent('play-radio', { detail: currentMetadata }));
        window.dispatchEvent(new CustomEvent('pause-spotify'));
    }

    function stopRadio() {
        if (audio) { audio.pause(); audio = null; }
        setPlaying(false);
    }

    // Init
    loadConfig().then(loadFavorites);

    // Toggle play/pause
    if (radioToggle) {
        radioToggle.addEventListener('click', () => {
            if (isPlaying) stopRadio();
            else playRadio();
        });
    }

    // Favorite toggle
    if (radioFavBtn) {
        radioFavBtn.addEventListener('click', async () => {
            const favs = await Favorites.get();
            const isFav = favs.some((f: any) => f.track_id === RADIO_TRACK_ID);
            if (isFav) {
                await Favorites.remove(RADIO_TRACK_ID);
            } else {
                await Favorites.add({
                    track_id: RADIO_TRACK_ID,
                    title: currentMetadata.title,
                    artist: currentMetadata.artist,
                    image: currentMetadata.image,
                    type: 'radio'
                });
            }
            loadFavorites();
        });
    }

    // Info button -> go to radio page
    if (radioInfoBtn) {
        radioInfoBtn.addEventListener('click', () => {
            window.location.href = '/radio';
        });
    }

    // Listen for external pause
    window.addEventListener('pause-radio', () => stopRadio());

    // Listen for config updates
    window.addEventListener('radio-config-updated', () => loadConfig());
</script>
