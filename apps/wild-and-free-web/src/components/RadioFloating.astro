---
---
<!-- Radio Floating Player (Global) -->
<div id="radio-floating" transition:persist class="fixed bottom-6 left-6 z-[9999] w-[300px] sm:w-[350px]">
  <div id="radio-container" class="bg-black/90 backdrop-blur-xl border border-white/10 rounded-2xl overflow-hidden shadow-2xl w-full flex flex-col">
    
    <!-- Player Header -->
    <div class="p-4 flex gap-4 items-center bg-[#111]">
        <div class="w-14 h-14 bg-zinc-800 rounded-lg overflow-hidden flex-shrink-0 relative">
            <img id="radio-cover" src="https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?w=150&q=80" class="w-full h-full object-cover" />
            <div class="absolute inset-0 flex items-center justify-center bg-black/30">
                <div class="w-3 h-3 bg-red-500 rounded-full animate-pulse"></div>
            </div>
        </div>
        <div class="overflow-hidden flex-1">
            <h4 id="radio-title" class="text-sm font-black text-white uppercase truncate">Wild & Free FM</h4>
            <p id="radio-artist" class="text-[10px] text-gray-400 font-bold uppercase truncate">En Vivo • 24/7</p>
        </div>
        <button id="radio-toggle" class="w-10 h-10 bg-[var(--primary)] text-white rounded-full flex items-center justify-center hover:scale-105 active:scale-95 transition-all">
            <svg id="radio-play" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            <svg id="radio-pause" width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="hidden"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
        </button>
    </div>

    <!-- Controls -->
    <div class="px-4 pb-4 flex items-center justify-between gap-2 border-t border-white/5 pt-2">
        <button id="radio-fav-btn" class="p-2 text-gray-400 hover:text-white transition-colors" title="Agregar a Favoritos">
            <svg id="radio-fav-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </button>
        
        <!-- Visualizer -->
        <div id="radio-eq" class="flex items-end gap-1 h-6 opacity-0 transition-opacity">
            <div class="w-1 bg-[var(--primary)] animate-[eq_1s_ease-in-out_infinite]"></div>
            <div class="w-1 bg-[var(--primary)] animate-[eq_1.2s_ease-in-out_infinite_0.1s]"></div>
            <div class="w-1 bg-[var(--primary)] animate-[eq_0.8s_ease-in-out_infinite_0.2s]"></div>
            <div class="w-1 bg-[var(--primary)] animate-[eq_1.5s_ease-in-out_infinite_0.3s]"></div>
        </div>

        <button class="p-2 text-gray-400 hover:text-white transition-colors" title="Ver Detalles">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        </button>
    </div>
  </div>
</div>

<style>
    @keyframes eq {
        0%, 100% { height: 20%; }
        50% { height: 80%; }
    }
</style>

<script>
    import { Favorites } from '../lib/favorites.js';

    const radioToggle = document.getElementById('radio-toggle');
    const radioPlay = document.getElementById('radio-play');
    const radioPause = document.getElementById('radio-pause');
    const radioEq = document.getElementById('radio-eq');
    const radioFavBtn = document.getElementById('radio-fav-btn');
    const radioFavIcon = document.getElementById('radio-fav-icon');
    
    let isPlaying = false;
    const RADIO_TRACK_ID = 'radio-wild-free-fm';
    const RADIO_METADATA = {
        id: RADIO_TRACK_ID,
        title: 'Wild & Free FM',
        artist: 'En Vivo • 24/7',
        image: 'https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?w=150&q=80'
    };

    // Favorites Logic
    const updateFavIcon = () => {
        if (Favorites.has(RADIO_TRACK_ID)) {
            radioFavIcon?.setAttribute('fill', 'currentColor');
            radioFavIcon?.classList.add('text-[var(--primary)]');
        } else {
            radioFavIcon?.setAttribute('fill', 'none');
            radioFavIcon?.classList.remove('text-[var(--primary)]');
        }
    };

    radioFavBtn?.addEventListener('click', async () => {
        await Favorites.toggle(RADIO_METADATA);
        updateFavIcon();
    });

    // Listen for updates from other components
    window.addEventListener('favorites-updated', updateFavIcon);
    
    // Initial check
    // Wait a bit for auth to settle or use event
    setTimeout(updateFavIcon, 1000);


    // Simulate audio player
    const audio = new Audio('https://stream.zeno.fm/ez250525258uv'); // Example stream or placeholder

    // Listen for Spotify Play event to pause
    window.addEventListener('play-spotify-track', () => {
        if (isPlaying) {
            isPlaying = false;
            radioPlay?.classList.remove('hidden');
            radioPause?.classList.add('hidden');
            radioEq?.classList.add('opacity-0');
            audio.pause();
        }
    });

    // Listen for internal pause request
    window.addEventListener('pause-radio', () => {
        if (isPlaying) {
            isPlaying = false;
            radioPlay?.classList.remove('hidden');
            radioPause?.classList.add('hidden');
            radioEq?.classList.add('opacity-0');
            audio.pause();
        }
    });

    // Listen for external play request (e.g. from Radio page)
    window.addEventListener('play-radio', () => {
        if (!isPlaying) {
            isPlaying = true;
            radioPlay?.classList.add('hidden');
            radioPause?.classList.remove('hidden');
            radioEq?.classList.remove('opacity-0');
            audio.play().catch(e => console.log('Audio play failed', e));
        }
    });

    radioToggle?.addEventListener('click', () => {
        isPlaying = !isPlaying;
        
        if (isPlaying) {
            radioPlay?.classList.add('hidden');
            radioPause?.classList.remove('hidden');
            radioEq?.classList.remove('opacity-0');
            audio.play().catch(e => console.log('Audio play failed', e));
            // Notify others
            window.dispatchEvent(new CustomEvent('play-radio'));
        } else {
            radioPlay?.classList.remove('hidden');
            radioPause?.classList.add('hidden');
            radioEq?.classList.add('opacity-0');
            audio.pause();
        }
    });
</script>
