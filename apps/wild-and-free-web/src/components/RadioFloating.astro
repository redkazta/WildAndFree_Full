---
---
<div id="radio-floating" transition:persist class="fixed bottom-6 left-6 z-[9999] group flex flex-col items-start gap-2">
  <!-- Expanded Content (Shows on Hover/Active) -->
  <div class="bg-black/90 backdrop-blur-xl border border-white/10 rounded-2xl p-4 mb-2 shadow-2xl w-64 transform translate-y-4 opacity-0 invisible group-hover:translate-y-0 group-hover:opacity-100 group-hover:visible transition-all duration-300 origin-bottom-left">
    
    <div class="flex items-start gap-3 mb-3">
        <div class="w-12 h-12 bg-zinc-800 rounded-lg overflow-hidden flex-shrink-0 relative">
            <img id="radio-cover" src="https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?w=150&q=80" class="w-full h-full object-cover" />
            <div class="absolute inset-0 flex items-center justify-center bg-black/30">
                <div class="w-3 h-3 bg-red-500 rounded-full animate-pulse"></div>
            </div>
        </div>
        <div class="overflow-hidden">
            <h4 id="radio-title" class="text-xs font-black text-white uppercase truncate">Wild & Free FM</h4>
            <p id="radio-artist" class="text-[10px] text-gray-400 font-bold uppercase truncate">En Vivo • 24/7</p>
        </div>
    </div>

    <div class="flex items-center justify-between gap-2">
        <button class="p-2 text-gray-400 hover:text-white transition-colors" title="Agregar a Favoritos">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        </button>
        
        <button class="p-2 text-gray-400 hover:text-white transition-colors" title="Agregar a Playlist">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
        </button>

        <button class="p-2 text-gray-400 hover:text-white transition-colors ml-auto" title="Ver Detalles">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><line x1="12" y1="16" x2="12" y2="12"></line><line x1="12" y1="8" x2="12.01" y2="8"></line></svg>
        </button>
    </div>
  </div>

  <!-- Main Toggle Button -->
  <button id="radio-toggle" class="w-14 h-14 bg-[var(--primary)] text-white rounded-full shadow-lg shadow-orange-500/20 flex items-center justify-center hover:scale-105 active:scale-95 transition-all duration-300 relative overflow-hidden group/btn">
      <div class="absolute inset-0 bg-gradient-to-tr from-black/20 to-transparent"></div>
      
      <!-- Play Icon -->
      <svg id="radio-play" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="relative z-10"><path d="M8 5v14l11-7z"/></svg>
      
      <!-- Pause Icon (Hidden by default) -->
      <svg id="radio-pause" width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="relative z-10 hidden"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
      
      <!-- Equalizer Animation (When playing) -->
      <div id="radio-eq" class="absolute bottom-0 left-0 right-0 h-1/2 flex items-end justify-center gap-0.5 opacity-0 transition-opacity">
          <div class="w-1 bg-white/50 animate-[eq_1s_ease-in-out_infinite]"></div>
          <div class="w-1 bg-white/50 animate-[eq_1.2s_ease-in-out_infinite_0.1s]"></div>
          <div class="w-1 bg-white/50 animate-[eq_0.8s_ease-in-out_infinite_0.2s]"></div>
          <div class="w-1 bg-white/50 animate-[eq_1.5s_ease-in-out_infinite_0.3s]"></div>
      </div>
  </button>
</div>

<style>
    @keyframes eq {
        0%, 100% { height: 20%; }
        50% { height: 80%; }
    }
</style>

<script>
    const radioToggle = document.getElementById('radio-toggle');
    const radioPlay = document.getElementById('radio-play');
    const radioPause = document.getElementById('radio-pause');
    const radioEq = document.getElementById('radio-eq');
    let isPlaying = false;

    // Simulate audio player
    const audio = new Audio('https://stream.zeno.fm/ez250525258uv'); // Example stream or placeholder

    // Listen for Spotify Play event to pause
    window.addEventListener('play-spotify-track', () => {
        if (isPlaying) {
            isPlaying = false;
            radioPlay?.classList.remove('hidden');
            radioPause?.classList.add('hidden');
            radioEq?.classList.add('opacity-0');
            audio.pause();
        }
    });

    // Listen for internal pause request
    window.addEventListener('pause-radio', () => {
        if (isPlaying) {
            isPlaying = false;
            radioPlay?.classList.remove('hidden');
            radioPause?.classList.add('hidden');
            radioEq?.classList.add('opacity-0');
            audio.pause();
        }
    });

    radioToggle?.addEventListener('click', () => {
        isPlaying = !isPlaying;
        
        if (isPlaying) {
            radioPlay?.classList.add('hidden');
            radioPause?.classList.remove('hidden');
            radioEq?.classList.remove('opacity-0');
            audio.play().catch(e => console.log('Audio play failed', e));
            // Notify others
            window.dispatchEvent(new CustomEvent('play-radio'));
        } else {
            radioPlay?.classList.remove('hidden');
            radioPause?.classList.add('hidden');
            radioEq?.classList.add('opacity-0');
            audio.pause();
        }
    });
</script>
