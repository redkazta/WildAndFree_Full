---
export type Props = {
  title: string;
  subtitle?: string;
  label?: string;
};

const { title, subtitle, label } = Astro.props;
---

<div class="text-center space-y-4 mb-section">
  {label && (
    <span class="text-label font-black uppercase text-wild-orange tracking-widest">
      {label}
    </span>
  )}
  <h2 class="text-display-md font-black uppercase tracking-tighter text-white relative inline-block">
    {title}
  </h2>
  {subtitle && (
    <p class="text-label font-bold text-gray-500 uppercase max-w-content mx-auto">
      {subtitle}
    </p>
  )}
</div>
