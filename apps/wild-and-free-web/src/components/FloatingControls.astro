---
import RadioFloating from './RadioFloating.astro';
import SpotifyFloating from './SpotifyFloating.astro';
---

<!-- Reproductores flotantes: viven ocultos hasta que el usuario los habilite. -->
<div id="wg-floating-layer" hidden>
  <RadioFloating />
  <SpotifyFloating />
</div>

<!-- Aviso de primera visita -->
<div
  id="wg-floating-prompt"
  class="wg-fp-overlay"
  role="dialog"
  aria-modal="true"
  aria-labelledby="wg-fp-title"
  hidden
>
  <div class="wg-fp-card">
    <button type="button" id="wg-fp-close" class="wg-fp-close" aria-label="Cerrar aviso">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <span class="wg-fp-kicker">Tu experiencia</span>
    <h2 id="wg-fp-title" class="wg-fp-title">Música y radio<br /><span>siempre a la mano</span></h2>
    <p class="wg-fp-text">
      Podemos dejar la radio de Wild Gvng y la playlist de Spotify flotando en la esquina
      mientras navegas. Tú decides: activarlas ahora o cuando quieras desde Configuración.
    </p>

    <div class="wg-fp-visual" aria-hidden="true">
      <div class="wg-fp-visual-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4.9 19.1C1 15.2 1 8.8 4.9 4.9"></path>
          <path d="M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5"></path>
          <path d="M16.2 7.8c2.3 2.3 2.3 6.1 0 8.5"></path>
          <path d="M19.1 4.9C23 8.8 23 15.2 19.1 19.1"></path>
          <circle cx="12" cy="12" r="2"></circle>
        </svg>
        <span>Radio</span>
      </div>
      <div class="wg-fp-visual-divider"></div>
      <div class="wg-fp-visual-item">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor">
          <path d="M12 0C5.4 0 0 5.4 0 12s5.4 12 12 12 12-5.4 12-12S18.66 0 12 0zm5.521 17.34c-.24.359-.66.48-1.021.24-2.82-1.74-6.36-2.101-10.561-1.141-.418.122-.779-.179-.899-.539-.12-.421.18-.78.54-.9 4.56-1.021 8.52-.6 11.64 1.32.42.18.479.659.301 1.02zm1.44-3.3c-.301.42-.841.6-1.262.3-3.239-1.98-8.159-2.58-11.939-1.38-.479.12-1.02-.12-1.14-.6-.12-.48.12-1.021.6-1.141C9.6 9.9 15 10.561 18.72 12.84c.361.181.54.78.241 1.2zm.12-3.36C15.24 8.4 8.82 8.16 5.16 9.301c-.6.179-1.2-.181-1.38-.721-.18-.601.18-1.2.72-1.381 4.26-1.26 11.28-1.02 15.721 1.621.539.3.719 1.02.419 1.56-.299.421-1.02.599-1.559.3z"></path>
        </svg>
        <span>Spotify</span>
      </div>
    </div>

    <label class="wg-fp-check">
      <input type="checkbox" id="wg-fp-never" />
      <span class="wg-fp-check-box" aria-hidden="true">
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 6 9 17l-5-5"></path>
        </svg>
      </span>
      <span>No volver a mostrar este aviso</span>
    </label>

    <div class="wg-fp-actions">
      <button type="button" id="wg-fp-later" class="wg-fp-btn wg-fp-btn--ghost">Ahora no</button>
      <button type="button" id="wg-fp-enable" class="wg-fp-btn wg-fp-btn--primary">Activar</button>
    </div>
  </div>
</div>

<!-- Confirmación sutil -->
<div id="wg-floating-toast" class="wg-fp-toast" role="status" aria-live="polite" hidden>
  <span class="wg-fp-toast-dot" aria-hidden="true"></span>
  <span id="wg-floating-toast-msg"></span>
</div>

<style>
  /* ===== Aviso de primera visita ===== */
  #wg-floating-layer[hidden] {
    display: none !important;
  }

  .wg-fp-overlay {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: rgba(0, 0, 0, 0.72);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .wg-fp-overlay[hidden],
  .wg-fp-toast[hidden] {
    display: none !important;
  }

  .wg-fp-card {
    position: relative;
    width: min(460px, 100%);
    background: #0b0b0b;
    border: 1px solid rgba(201, 131, 0, 0.35);
    border-radius: 24px;
    padding: 34px 30px 28px;
    box-shadow: 0 30px 90px rgba(0, 0, 0, 0.7), 0 0 60px -30px rgba(201, 131, 0, 0.5);
    animation: wgFpIn 0.28s ease-out;
  }

  @keyframes wgFpIn {
    from {
      opacity: 0;
      transform: translateY(14px) scale(0.98);
    }
    to {
      opacity: 1;
      transform: translateY(0) scale(1);
    }
  }

  .wg-fp-close {
    position: absolute;
    top: 16px;
    right: 16px;
    width: 32px;
    height: 32px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border-radius: 9999px;
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: rgba(255, 255, 255, 0.5);
    background: rgba(255, 255, 255, 0.03);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }

  .wg-fp-close:hover {
    color: #ffffff;
    border-color: rgba(255, 255, 255, 0.3);
  }

  .wg-fp-kicker {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: 9px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.3em;
    color: var(--primary, #c98300);
    margin-bottom: 12px;
  }

  .wg-fp-kicker::before {
    content: '';
    width: 26px;
    height: 2px;
    background: var(--primary, #c98300);
  }

  .wg-fp-title {
    margin: 0;
    font-size: clamp(1.65rem, 6vw, 2.1rem);
    line-height: 0.98;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    color: #ffffff;
  }

  .wg-fp-title span {
    color: var(--primary, #c98300);
  }

  .wg-fp-text {
    margin: 16px 0 20px;
    font-size: 13px;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.62);
  }

  .wg-fp-visual {
    display: flex;
    align-items: stretch;
    gap: 12px;
    margin-bottom: 22px;
  }

  .wg-fp-visual-item {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 9px;
    padding: 12px 10px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.09);
    background: rgba(255, 255, 255, 0.03);
    color: rgba(255, 255, 255, 0.75);
    font-size: 9px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .wg-fp-visual-item svg {
    color: var(--primary, #c98300);
    flex-shrink: 0;
  }

  .wg-fp-visual-divider {
    width: 1px;
    background: rgba(255, 255, 255, 0.08);
  }

  .wg-fp-check {
    display: flex;
    align-items: center;
    gap: 10px;
    cursor: pointer;
    user-select: none;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255, 255, 255, 0.45);
    margin-bottom: 22px;
  }

  .wg-fp-check input {
    position: absolute;
    opacity: 0;
    pointer-events: none;
  }

  .wg-fp-check-box {
    width: 18px;
    height: 18px;
    flex-shrink: 0;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 2px solid rgba(255, 255, 255, 0.2);
    border-radius: 5px;
    color: #000000;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .wg-fp-check-box svg {
    opacity: 0;
    transition: opacity 0.15s ease;
  }

  .wg-fp-check input:checked + .wg-fp-check-box {
    background: var(--primary, #c98300);
    border-color: var(--primary, #c98300);
  }

  .wg-fp-check input:checked + .wg-fp-check-box svg {
    opacity: 1;
  }

  .wg-fp-check input:focus-visible + .wg-fp-check-box {
    outline: 2px solid var(--primary, #c98300);
    outline-offset: 2px;
  }

  .wg-fp-actions {
    display: flex;
    gap: 10px;
  }

  .wg-fp-btn {
    flex: 1;
    padding: 14px 18px;
    border-radius: 12px;
    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    cursor: pointer;
    font-family: inherit;
    transition: transform 0.15s ease, background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
  }

  .wg-fp-btn:active {
    transform: scale(0.98);
  }

  .wg-fp-btn--ghost {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: rgba(255, 255, 255, 0.7);
  }

  .wg-fp-btn--ghost:hover {
    border-color: rgba(255, 255, 255, 0.4);
    color: #ffffff;
  }

  .wg-fp-btn--primary {
    background: var(--primary, #c98300);
    border: 1px solid var(--primary, #c98300);
    color: #000000;
  }

  .wg-fp-btn--primary:hover {
    filter: brightness(1.1);
  }

  /* ===== Toast ===== */
  .wg-fp-toast {
    position: fixed;
    left: 50%;
    bottom: 24px;
    transform: translateX(-50%);
    z-index: 10001;
    display: flex;
    align-items: center;
    gap: 10px;
    max-width: calc(100vw - 32px);
    padding: 12px 18px;
    border-radius: 9999px;
    background: #0b0b0b;
    border: 1px solid rgba(201, 131, 0, 0.45);
    box-shadow: 0 16px 40px rgba(0, 0, 0, 0.6);
    color: rgba(255, 255, 255, 0.85);
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.02em;
    animation: wgFpToastIn 0.25s ease-out;
  }

  .wg-fp-toast-dot {
    width: 6px;
    height: 6px;
    border-radius: 9999px;
    background: var(--primary, #c98300);
    box-shadow: 0 0 10px var(--primary, #c98300);
    flex-shrink: 0;
  }

  @keyframes wgFpToastIn {
    from {
      opacity: 0;
      transform: translate(-50%, 12px);
    }
    to {
      opacity: 1;
      transform: translate(-50%, 0);
    }
  }

  @media (max-width: 640px) {
    .wg-fp-overlay {
      align-items: flex-end;
      padding: 0;
    }

    .wg-fp-card {
      width: 100%;
      border-radius: 24px 24px 0 0;
      border-bottom: 0;
      padding: 30px 22px calc(26px + env(safe-area-inset-bottom));
      animation: wgFpInMobile 0.3s ease-out;
    }

    @keyframes wgFpInMobile {
      from {
        opacity: 0;
        transform: translateY(40px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .wg-fp-toast {
      bottom: calc(16px + env(safe-area-inset-bottom));
      border-radius: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .wg-fp-card,
    .wg-fp-toast {
      animation: none;
    }
  }
</style>

<script>
  const RADIO_KEY = 'wg-floating-radio';
  const MUSIC_KEY = 'wg-floating-music';
  const SEEN_KEY = 'wg-floating-prompt-seen';
  const SNOOZE_KEY = 'wg-floating-prompt-snooze';

  const layer = document.getElementById('wg-floating-layer');
  const prompt = document.getElementById('wg-floating-prompt');
  const neverCheckbox = document.getElementById('wg-fp-never') as HTMLInputElement | null;
  const toast = document.getElementById('wg-floating-toast');
  const toastMsg = document.getElementById('wg-floating-toast-msg');
  let toastTimer: number | undefined;

  function readPref(key: string): string | null {
    try {
      return localStorage.getItem(key);
    } catch {
      return null;
    }
  }

  function writePref(key: string, value: string): void {
    try {
      localStorage.setItem(key, value);
    } catch {
      /* almacenamiento no disponible */
    }
  }

  function removePref(key: string): void {
    try {
      localStorage.removeItem(key);
    } catch {
      /* almacenamiento no disponible */
    }
  }

  function syncConfigToggles(): void {
    const radio = readPref(RADIO_KEY) === '1';
    const music = readPref(MUSIC_KEY) === '1';
    document.querySelectorAll<HTMLElement>('.cfg-toggle[data-floating]').forEach((toggle) => {
      const kind = toggle.getAttribute('data-floating');
      toggle.classList.toggle('active', kind === 'radio' ? radio : music);
    });
  }

  function applyPreferences(): void {
    const radio = readPref(RADIO_KEY) === '1';
    const music = readPref(MUSIC_KEY) === '1';
    const anyEnabled = radio || music;

    if (layer) layer.hidden = !anyEnabled;

    const radioEl = document.getElementById('radio-floating') as HTMLElement | null;
    const spotifyEl = document.getElementById('spotify-floating') as HTMLElement | null;
    if (radioEl) radioEl.style.display = radio ? '' : 'none';
    if (spotifyEl) spotifyEl.style.display = music ? '' : 'none';

    if (music) {
      // Carga el iframe de Spotify solo cuando la música flotante se habilita.
      window.setTimeout(() => {
        window.dispatchEvent(new CustomEvent('wg:floating-enable-spotify'));
      }, 0);
    }

    syncConfigToggles();
  }

  function showToast(message: string): void {
    if (!toast || !toastMsg) return;
    toastMsg.textContent = message;
    toast.hidden = false;
    if (toastTimer) window.clearTimeout(toastTimer);
    toastTimer = window.setTimeout(() => {
      toast.hidden = true;
    }, 4500);
  }

  function openPrompt(): void {
    if (!prompt) return;
    prompt.hidden = false;
    document.body.style.overflow = 'hidden';
    window.setTimeout(() => {
      document.getElementById('wg-fp-enable')?.focus();
    }, 60);
  }

  function closePrompt(): void {
    if (!prompt) return;
    prompt.hidden = true;
    document.body.style.overflow = '';
  }

  function enableFloating(): void {
    writePref(RADIO_KEY, '1');
    writePref(MUSIC_KEY, '1');
    writePref(SEEN_KEY, '1');
    closePrompt();
    applyPreferences();
    showToast('Listo. Radio y música flotantes activadas.');
  }

  function declineFloating(): void {
    if (neverCheckbox?.checked) {
      writePref(SEEN_KEY, '1');
      writePref(RADIO_KEY, '0');
      writePref(MUSIC_KEY, '0');
    } else {
      // Solo se silencia durante esta sesión; en la próxima visita se vuelve a ofrecer.
      try {
        sessionStorage.setItem(SNOOZE_KEY, '1');
      } catch {
        /* almacenamiento no disponible */
      }
    }
    closePrompt();
    applyPreferences();
    showToast('Entendido, puedes habilitarlo desde configuración en cualquier momento.');
  }

  // Estado inicial (no muestra nada si el usuario ya decidió).
  applyPreferences();

  const hasPreference = readPref(RADIO_KEY) !== null || readPref(MUSIC_KEY) !== null;
  const promptSeen = readPref(SEEN_KEY) === '1';
  let snoozed = false;
  try {
    snoozed = sessionStorage.getItem(SNOOZE_KEY) === '1';
  } catch {
    /* almacenamiento no disponible */
  }

  // El aviso solo aparece en las páginas de radio y música.
  const path = window.location.pathname;
  const isMediaPage =
    path === '/radio' ||
    path.indexOf('/radio/') === 0 ||
    path === '/musica' ||
    path.indexOf('/musica/') === 0;

  if (isMediaPage && !hasPreference && !promptSeen && !snoozed) {
    window.setTimeout(openPrompt, 1200);
  }

  document.getElementById('wg-fp-enable')?.addEventListener('click', enableFloating);
  document.getElementById('wg-fp-later')?.addEventListener('click', declineFloating);
  document.getElementById('wg-fp-close')?.addEventListener('click', declineFloating);

  // Cerrar al hacer clic en el fondo del overlay.
  prompt?.addEventListener('click', (event) => {
    if (event.target === prompt) declineFloating();
  });

  // Cerrar con Escape.
  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && prompt && !prompt.hidden) {
      declineFloating();
    }
  });

  // Cambios hechos desde Configuración.
  window.addEventListener('wg:floating-prefs-changed', () => {
    applyPreferences();
  });

  // "Mostrar aviso de nuevo" desde Configuración.
  window.addEventListener('wg:floating-prompt-show', () => {
    removePref(SEEN_KEY);
    removePref(RADIO_KEY);
    removePref(MUSIC_KEY);
    applyPreferences();
    openPrompt();
  });
</script>
