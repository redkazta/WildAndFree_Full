---
const links = [
  {
    href: '/the-wild-times',
    label: 'The Wild Times',
    description: 'Noticias, anuncios y el feed de la crew.',
    iconPaths: ['M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2Zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2', 'M18 14h-8', 'M15 18h-5', 'M10 6h8v4h-8V6Z'],
  },
  {
    href: '/musica',
    label: 'Música',
    description: 'Tracks, EPs y lanzamientos del colectivo.',
    iconPaths: ['M9 18V5l12-2v13', 'M9 18a2 2 0 1 0 0-4', 'M21 16a2 2 0 1 0 0-4'],
  },
  {
    href: '/radio',
    label: 'Radio',
    description: 'La señal de Wild Gvng, 24/7.',
    iconPaths: ['M4.9 19.1C1 15.2 1 8.8 4.9 4.9', 'M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5', 'M12 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6z', 'M12 12v9'],
  },
  {
    href: '/podcasts',
    label: 'Podcasts',
    description: 'Conversaciones, historias y voces del barrio.',
    iconPaths: ['M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z', 'M19 10v2a7 7 0 0 1-14 0v-2', 'M12 19v4', 'M8 23h8'],
  },
  {
    href: '/wild-and-free-tv',
    label: 'Wild TV',
    description: 'Sesiones, visuales y contenido en video.',
    iconPaths: ['M4 4h16v16H4z', 'M10 8l6 4-6 4z'],
  },
  {
    href: '/artistas',
    label: 'Artistas',
    description: 'La alineación oficial de la gang.',
    iconPaths: ['M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2', 'M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8z'],
  },
  {
    href: '/versus',
    label: 'Versus',
    description: 'Batallas de freestyle y torneo de escritas.',
    iconPaths: ['M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z', 'M14 2v6h6', 'M8 13h2', 'M8 17h2', 'M14 13h2', 'M14 17h2'],
  },
  {
    href: '/eventos',
    label: 'Eventos',
    description: 'Fechas, line-ups y boletos con QR.',
    iconPaths: ['M3 6h18', 'M3 12h18', 'M3 18h18'],
  },
  {
    href: '/tienda',
    label: 'Tienda',
    description: 'Merch oficial y ediciones limitadas.',
    iconPaths: ['M6 9h12l-1.2 11H7.2L6 9z', 'M9 9V6a3 3 0 0 1 6 0v3'],
  },
  {
    href: '/wild-and-free-league',
    label: 'Wild and Free League',
    description: 'La liga de freestyle nacida en Torreón.',
    iconPaths: ['M12 2C9 2 6.5 4 6.5 6.5C6.5 8.1 7.2 9.5 8.5 10.5C8.8 10.7 9 11 9 11.5V15C9 15.6 9.4 16 10 16H14C14.6 16 15 15.6 15 15V11.5C15 11 15.2 10.7 15.5 10.5C16.8 9.5 17.5 8.1 17.5 6.5C17.5 4 15 2 12 2ZM12 4C13.7 4 15 5.1 15 6.5C15 7.4 14.6 8.2 13.9 8.7C13.3 9.1 13 9.8 13 10.5V14H11V10.5C11 9.8 10.7 9.1 10.1 8.7C9.4 8.2 9 7.4 9 6.5C9 5.1 10.3 4 12 4Z M9 18H15V20H9V18Z'],
  },
  {
    href: '/wild-writings',
    label: 'Wild Writings',
    description: 'Letras, ensayos y palabra escrita.',
    iconPaths: ['M4 20h16', 'M6 16l8-8 4 4-8 8-4 0 0-4z'],
  },
  {
    href: '/#patrocinadores',
    label: 'Patrocinadores',
    description: 'Las marcas que sostienen el movimiento.',
    iconPaths: ['M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z'],
  },
