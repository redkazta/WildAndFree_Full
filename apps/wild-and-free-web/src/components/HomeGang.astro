---

<section id="la-gang" class="gang-section">
  <div class="gang-bg" aria-hidden="true"></div>
  <div class="gang-glow" aria-hidden="true"></div>

  <div class="relative z-10 max-w-[1400px] mx-auto px-5 sm:px-8 py-20 md:py-28">
    <div class="grid grid-cols-1 lg:grid-cols-[1.05fr_0.95fr] gap-10 lg:gap-16 items-end mb-14 md:mb-20">
      <div>
        <span class="gang-kicker">
          <span class="w-8 h-[2px] bg-[var(--primary)]"></span>
          Wild Gvng · Torreón · Desde 2018
        </span>
        <h2 class="gang-title">
          La gang<br />
          <span>no pide permiso</span>
        </h2>
      </div>

      <div class="space-y-6">
        <p class="gang-copy">
          Somos colectivo, sello y calle. Aquí vive el freestyle, la música, la radio,
          los torneos y la cultura que se construye desde abajo. No seguimos tendencias:
          las hacemos.
        </p>

        <div class="grid grid-cols-2 sm:grid-cols-4 gap-3">
          <div class="gang-stat">
            <span class="gang-stat-value">+500</span>
            <span class="gang-stat-label">MC registrados</span>
          </div>
          <div class="gang-stat">
            <span class="gang-stat-value">+200</span>
            <span class="gang-stat-label">Batallas</span>
          </div>
          <div class="gang-stat">
            <span class="gang-stat-value">24/7</span>
            <span class="gang-stat-label">Radio</span>
          </div>
          <div class="gang-stat">
            <span class="gang-stat-value">01</span>
            <span class="gang-stat-label">Crew</span>
          </div>
        </div>

        <div class="flex flex-wrap gap-3">
          <a href="/registro" class="gang-cta gang-cta--primary">Únete a la crew</a>
          <a href="/radio" class="gang-cta gang-cta--ghost">Escucha la radio</a>
        </div>
      </div>
    </div>

    <div class="flex items-center justify-between gap-4 mb-6 border-t border-white/10 pt-6">
      <h3 class="text-[11px] font-black uppercase tracking-[0.3em] text-[var(--primary)]">Explora el universo</h3>
      <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-white/30">12 accesos directos</span>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-3">
      {links.map((link, index) => (
        <a href={link.href} class="gang-card group">
          <div class="flex items-start justify-between mb-6">
            <svg class="w-5 h-5 text-[var(--primary)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              {link.iconPaths.map((path) => <path d={path} />)}
            </svg>
            <span class="text-[9px] font-black tracking-[0.2em] text-white/20">{String(index + 1).padStart(2, '0')}</span>
          </div>
          <div class="flex-1">
            <h4 class="text-xs font-black uppercase tracking-[0.08em] text-white group-hover:text-[var(--primary)] transition-colors leading-tight">
              {link.label}
            </h4>
            <p class="mt-2 text-[10px] leading-relaxed text-white/45">{link.description}</p>
          </div>
          <span class="mt-4 inline-flex items-center gap-1 text-[9px] font-black uppercase tracking-[0.2em] text-white/30 group-hover:text-[var(--primary)] transition-colors">
            Entrar
            <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg>
          </span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .gang-section {
    position: relative;
    overflow: hidden;
    background: #050505;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .gang-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.06) 1px, transparent 1px);
    background-size: 28px 28px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 90%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 90%);
    pointer-events: none;
  }

  .gang-glow {
    position: absolute;
    top: -160px;
    left: -120px;
    width: 560px;
    height: 560px;
    border-radius: 9999px;
    background: radial-gradient(circle, rgba(201, 131, 0, 0.16) 0%, transparent 65%);
    filter: blur(24px);
    pointer-events: none;
  }

  .gang-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 9px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: var(--primary, #c98300);
    margin-bottom: 14px;
  }

  .gang-title {
    margin: 0;
    font-size: clamp(2.6rem, 8vw, 5.5rem);
    line-height: 0.86;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: -0.04em;
    color: #ffffff;
  }

  .gang-title span {
    color: var(--primary, #c98300);
  }

  .gang-copy {
    margin: 0;
    font-size: 13px;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.6);
    max-width: 520px;
  }

  .gang-stat {
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.03);
    border-radius: 12px;
    padding: 10px 12px;
  }

  .gang-stat-value {
    display: block;
    font-size: 13px;
    font-weight: 900;
    color: var(--primary, #c98300);
    letter-spacing: 0.02em;
  }

  .gang-stat-label {
    display: block;
    margin-top: 2px;
    font-size: 7px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: rgba(255, 255, 255, 0.35);
  }

  .gang-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 12px 18px;
    border-radius: 9999px;
    font-size: 9px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    transition: all 0.2s ease;
  }

  .gang-cta--primary {
    background: var(--primary, #c98300);
    color: #000000;
  }

  .gang-cta--primary:hover {
    filter: brightness(1.1);
    transform: translateY(-1px);
  }

  .gang-cta--ghost {
    border: 1px solid rgba(255, 255, 255, 0.18);
    color: rgba(255, 255, 255, 0.7);
  }

  .gang-cta--ghost:hover {
    border-color: var(--primary, #c98300);
    color: var(--primary, #c98300);
  }

  .gang-card {
    display: flex;
    flex-direction: column;
    min-height: 180px;
    padding: 18px;
    background: #0b0b0b;
    border: 1px solid rgba(255, 255, 255, 0.09);
    border-radius: 16px;
    text-decoration: none;
    transition: border-color 0.25s ease, box-shadow 0.25s ease, transform 0.25s ease;
  }

  .gang-card:hover {
    border-color: rgba(201, 131, 0, 0.55);
    box-shadow: 0 0 42px -18px rgba(201, 131, 0, 0.5);
    transform: translateY(-2px);
  }

  @media (prefers-reduced-motion: reduce) {
    .gang-card,
    .gang-cta {
      transition: none;
    }
  }
</style>
