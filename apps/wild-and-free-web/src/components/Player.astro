---
---
<div id="global-player" transition:persist class="fixed bottom-0 left-0 right-0 z-[100] transform translate-y-full transition-transform duration-500">
  <div class="max-w-[1400px] mx-auto px-4 pb-4">
    <div class="bg-[var(--bg)] border border-[var(--border)] rounded-3xl p-4 flex items-center gap-6 shadow-2xl shadow-wild-orange/10">
      <!-- Track Info -->
      <div class="flex items-center gap-4 min-w-[200px]">
        <div class="w-14 h-14 rounded-xl bg-wild-orange flex-shrink-0 overflow-hidden shadow-lg">
          <img id="player-img" src="" alt="Cover" width="56" height="56" class="w-full h-full object-cover hidden">
          <div id="player-placeholder" class="w-full h-full flex items-center justify-center text-[var(--text)] font-black text-xs uppercase">WG</div>
        </div>
        <div class="overflow-hidden">
          <h4 id="player-title" class="text-sm font-black text-[var(--text)] uppercase truncate tracking-tight">Selecciona música</h4>
          <p id="player-artist" class="text-[10px] text-wild-orange font-bold uppercase tracking-widest truncate">Wild Gvng Radio</p>
        </div>
      </div>

      <!-- Controls -->
      <div class="flex-1 flex flex-col items-center gap-2">
        <div class="flex items-center gap-8">
          <button class="text-[var(--text-faint)] hover:text-[var(--text)] transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18V6h2v12H6zm3.5-6L19 6v12l-9.5-6z"/></svg>
          </button>
          <button id="player-play-btn" class="w-12 h-12 rounded-full bg-white text-black flex items-center justify-center hover:bg-wild-orange hover:text-[var(--text)] transition-all transform active:scale-90">
            <svg id="play-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            <svg id="pause-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="hidden"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
          </button>
          <button class="text-[var(--text-faint)] hover:text-[var(--text)] transition-colors">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
          </button>
        </div>
        <div class="w-full max-w-md flex items-center gap-3">
          <span class="text-[9px] font-bold text-[var(--text-faint)]">0:00</span>
          <div class="flex-1 h-1 bg-[var(--bg-card)] rounded-full overflow-hidden group cursor-pointer">
            <div id="player-progress" class="h-full bg-wild-orange w-0 group-hover:bg-[var(--bg-hover)] transition-all"></div>
          </div>
          <span class="text-[9px] font-bold text-[var(--text-faint)]">3:45</span>
        </div>
      </div>

      <!-- Volume & Extras -->
      <div class="hidden md:flex items-center gap-6 min-w-[200px] justify-end">
        <div class="flex items-center gap-3">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="text-[var(--text-faint)]"><path d="M11 5L6 9H2v6h4l5 4V5zM19.07 4.93a10 10 0 0 1 0 14.14M15.54 8.46a5 5 0 0 1 0 7.07"/></svg>
          <div class="w-24 h-1 bg-[var(--bg-card)] rounded-full overflow-hidden cursor-pointer group">
            <div class="h-full bg-white w-2/3 group-hover:bg-wild-orange transition-all"></div>
          </div>
        </div>
        <button id="player-close" class="text-[var(--text-faint)] hover:text-red-500 transition-colors">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M18 6L6 18M6 6l12 12"/></svg>
        </button>
      </div>
    </div>
  </div>
</div>

<script>
  class GlobalPlayer {
    el: HTMLElement | null;
    titleEl: HTMLElement | null;
    artistEl: HTMLElement | null;
    imgEl: HTMLElement | null;
    placeholderEl: HTMLElement | null;
    playBtn: HTMLElement | null;
    playIcon: HTMLElement | null;
    pauseIcon: HTMLElement | null;
    closeBtn: HTMLElement | null;
    isPlaying: boolean;

    constructor() {
      this.el = document.getElementById('global-player');
      this.titleEl = document.getElementById('player-title');
      this.artistEl = document.getElementById('player-artist');
      this.imgEl = document.getElementById('player-img');
      this.placeholderEl = document.getElementById('player-placeholder');
      this.playBtn = document.getElementById('player-play-btn');
      this.playIcon = document.getElementById('play-icon');
      this.pauseIcon = document.getElementById('pause-icon');
      this.closeBtn = document.getElementById('player-close');
      this.isPlaying = false;
      this.init();
    }

    init() {
      this.playBtn?.addEventListener('click', () => this.togglePlay());
      this.closeBtn?.addEventListener('click', () => this.hide());

      window.addEventListener('wild-play', (e: any) => {
        const detail = e?.detail || {};
        this.play(detail);
      });
    }

    play(track: any) {
      if (this.titleEl) this.titleEl.textContent = track.title || 'Reproduciendo';
      if (this.artistEl) this.artistEl.textContent = track.artist || 'Wild Gvng';

      if (track.image && this.imgEl instanceof HTMLImageElement) {
        this.imgEl.src = track.image;
        this.imgEl.classList.remove('hidden');
        this.placeholderEl?.classList.add('hidden');
      } else {
        if (this.imgEl instanceof HTMLImageElement) this.imgEl.classList.add('hidden');
        this.placeholderEl?.classList.remove('hidden');
      }

      this.show();
      this.setPlaying(true);
    }

    togglePlay() {
      this.setPlaying(!this.isPlaying);
    }

    setPlaying(playing: boolean) {
      this.isPlaying = Boolean(playing);
      if (this.isPlaying) {
        this.playIcon?.classList.add('hidden');
        this.pauseIcon?.classList.remove('hidden');
      } else {
        this.playIcon?.classList.remove('hidden');
        this.pauseIcon?.classList.add('hidden');
      }
    }

    show() {
      this.el?.classList.remove('translate-y-full');
    }

    hide() {
      this.el?.classList.add('translate-y-full');
      this.setPlaying(false);
    }
  }

  if (!(window as any).globalPlayer) (window as any).globalPlayer = new GlobalPlayer();
</script>

<style>
  #global-player {
    filter: drop-shadow(0 -10px 25px rgba(0,0,0,0.5));
  }
</style>
