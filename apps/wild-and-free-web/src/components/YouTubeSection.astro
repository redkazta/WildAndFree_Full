---
// Videos del canal @wildandfree1899 — se agregan más aquí y se renderizan solos
const videos = [
  {
    id: 'N76IKDNViig',
    title: '[OCTAVOS] LALO VS POCKET',
    subtitle: 'Ascensión 2019 · T2',
    url: 'https://www.youtube.com/watch?v=N76IKDNViig&list=PLFgjkl6vInbrQUBWhgvCgx7Gglzf7MMKl',
  },
  {
    id: 'FLVp9ac7q5I',
    title: '[OCTAVOS] RALF VS CENIT',
    subtitle: 'F #03 MAR · T2 2019',
    url: 'https://www.youtube.com/watch?v=FLVp9ac7q5I&list=PLFgjkl6vInbpXEKo7hsGTZda5Z-VGouOh',
  },
  {
    id: 'avVRvkl7Nug',
    title: '[OCTAVOS] PATS VS JADER',
    subtitle: 'F #01 FEB · T3 2020',
    url: 'https://www.youtube.com/watch?v=avVRvkl7Nug&list=PLFgjkl6vInbomF5fth8vXCtjrdlOkfAI5',
  },
];

const channelUrl = 'https://www.youtube.com/@wildandfree1899';
---

<section class="relative overflow-hidden bg-black border-t border-[var(--border)]/10">
	<!-- Grid pattern -->
	<div class="absolute inset-0 z-0 bg-black [background-image:radial-gradient(#111_1px,transparent_1px)] [background-size:24px_24px]"></div>
	<div class="absolute inset-0 z-0 opacity-10 [background-image:linear-gradient(45deg,transparent_49%,rgba(201,131,0,0.04)_49%,rgba(201,131,0,0.04)_51%,transparent_51%)] [background-size:48px_48px]"></div>

	<div class="relative z-10 max-w-[1350px] mx-auto px-6 py-16 md:py-24">

		<!-- Section header -->
		<div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-8">
			<div>
				<span class="inline-flex items-center gap-2 text-[9px] font-black uppercase tracking-[0.3em] text-wild-red mb-2">
					<span class="w-2 h-2 bg-wild-red rounded-full animate-pulse"></span>
					Archivo en video
				</span>
				<h2 class="text-3xl md:text-5xl font-black uppercase tracking-tighter leading-none text-[var(--text)]">
					Wild <span class="text-wild-orange">And Free</span> TV
				</h2>
				<p class="text-[11px] md:text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] mt-2">
					Batallas, octavos y finales de la liga
				</p>
			</div>
			<a
				href={channelUrl}
				target="_blank"
				rel="noopener noreferrer"
				class="self-start sm:self-auto inline-flex items-center gap-2 px-4 py-2.5 border border-wild-orange/50 text-wild-orange text-[10px] font-black uppercase tracking-[0.2em] rounded-full hover:bg-wild-orange hover:text-black transition-all"
			>
				<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M23.5 6.2a3 3 0 0 0-2.1-2.1C19.5 3.6 12 3.6 12 3.6s-7.5 0-9.4.5A3 3 0 0 0 .5 6.2 31 31 0 0 0 0 12a31 31 0 0 0 .5 5.8 3 3 0 0 0 2.1 2.1c1.9.5 9.4.5 9.4.5s7.5 0 9.4-.5a3 3 0 0 0 2.1-2.1A31 31 0 0 0 24 12a31 31 0 0 0-.5-5.8zM9.5 15.6V8.4L15.8 12l-6.3 3.6z"/></svg>
				Ver canal
			</a>
		</div>

		<!-- Video grid -->
		<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
			{videos.map((video) => (
				<a
					href={video.url}
					target="_blank"
					rel="noopener noreferrer"
					class="group relative block bg-[var(--bg-card)] border border-[var(--border)] rounded-xl overflow-hidden hover:border-wild-orange/60 transition-all duration-300 hover:-translate-y-1 hover:shadow-[0_12px_40px_rgba(201,131,0,0.15)]"
				>
					<!-- Thumbnail -->
					<div class="relative aspect-video overflow-hidden bg-[#0a0a0a]">
						<img
							src={`https://i.ytimg.com/vi/${video.id}/hqdefault.jpg`}
							alt={video.title}
							loading="lazy"
							width="480"
							height="360"
							class="w-full h-full object-cover grayscale-[35%] group-hover:grayscale-0 group-hover:scale-105 transition-all duration-500"
						/>
						<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent"></div>

						<!-- Play button -->
						<div class="absolute inset-0 flex items-center justify-center">
							<span class="w-12 h-12 rounded-full bg-black/60 backdrop-blur border border-white/20 flex items-center justify-center group-hover:bg-wild-orange group-hover:border-wild-orange group-hover:scale-110 transition-all duration-300">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" class="text-white group-hover:text-black ml-0.5 transition-colors"><path d="M8 5v14l11-7z"/></svg>
							</span>
						</div>

						<!-- Corner tag -->
						<span class="absolute top-2 left-2 px-2 py-0.5 bg-black/70 backdrop-blur border border-wild-orange/40 text-wild-orange text-[8px] font-black uppercase tracking-[0.2em] rounded">
							YouTube
						</span>
					</div>

					<!-- Info -->
					<div class="p-3 border-t border-[var(--border)]/50">
						<h3 class="text-xs md:text-sm font-black uppercase tracking-wide text-[var(--text)] truncate group-hover:text-wild-orange transition-colors">
							{video.title}
						</h3>
						<p class="text-[9px] font-bold uppercase tracking-widest text-[var(--text-muted)] mt-1 truncate">
							{video.subtitle}
						</p>
					</div>
				</a>
			))}
		</div>

		<!-- Footer note -->
		<p class="mt-6 text-center text-[9px] font-bold uppercase tracking-[0.25em] text-[var(--text-muted)]">
			Más contenido en <span class="text-wild-orange">@wildandfree1899</span>
		</p>

	</div>
</section>
