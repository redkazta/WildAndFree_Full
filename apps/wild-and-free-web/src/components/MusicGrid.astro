---
const releases = [
  {
    title: "Neon Nights",
    artist: "Nova K",
    artistId: "a1",
    cover: "https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?auto=format&fit=crop&w=600&q=80",
    type: "Single"
  },
  {
    title: "Underground",
    artist: "Sable",
    artistId: "a2",
    cover: "https://images.unsplash.com/photo-1493225255756-d9584f8606e9?auto=format&fit=crop&w=600&q=80",
    type: "EP"
  },
  {
    title: "Velocity",
    artist: "Mira V",
    artistId: "a3",
    cover: "https://images.unsplash.com/photo-1514525253440-b393452e8d26?auto=format&fit=crop&w=600&q=80",
    type: "Album"
  }
];
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
  {releases.map((release) => (
    <article class="group space-y-6">
      <div class="relative aspect-square overflow-hidden rounded-wild-xl bg-[#111] border border-white/10 group-hover:border-wild-orange/30 transition-all duration-500">
        <img 
          src={release.cover} 
          alt={release.title}
          width="600"
          height="600"
          loading="lazy" 
          class="w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-110 transition-all duration-700"
        />
        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center">
          <button class="w-16 h-16 rounded-full bg-wild-orange text-black flex items-center justify-center transform scale-90 group-hover:scale-100 transition-transform duration-500 shadow-2xl shadow-wild-orange/40">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" class="translate-x-0.5"><path d="M8 5v14l11-7z"/></svg>
          </button>
        </div>
      </div>
      <div class="space-y-2 text-center lg:text-left px-2">
        <div class="flex items-center justify-center lg:justify-start gap-3">
          <span class="px-2 py-0.5 rounded text-label-sm font-black uppercase tracking-widest bg-white/10 border border-white/10 text-white group-hover:text-wild-orange group-hover:border-wild-orange/20 transition-colors">
            {release.type}
          </span>
        </div>
        <h3 class="text-xl font-black uppercase tracking-tight text-white group-hover:text-wild-orange transition-colors">{release.title}</h3>
        <a href={`/artista/${release.artistId}`} class="inline-block text-sm text-white font-black uppercase tracking-widest hover:text-wild-orange transition-colors">{release.artist}</a>
      </div>
    </article>
  ))}
</div>

<style>
  /* Usando Tailwind */
</style>
