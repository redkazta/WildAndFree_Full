---
const releases = [
  {
    title: "Neon Nights",
    artist: "Nova K",
    cover: "https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?auto=format&fit=crop&w=600&q=80",
    type: "Single"
  },
  {
    title: "Underground",
    artist: "Sable",
    cover: "https://images.unsplash.com/photo-1493225255756-d9584f8606e9?auto=format&fit=crop&w=600&q=80",
    type: "EP"
  },
  {
    title: "Velocity",
    artist: "Mira V",
    cover: "https://images.unsplash.com/photo-1514525253440-b393452e8d26?auto=format&fit=crop&w=600&q=80",
    type: "Album"
  }
];
---

<div class="music-grid">
  {releases.map((release) => (
    <article class="release-card">
      <div class="cover-wrapper">
        <img src={release.cover} alt={release.title} loading="lazy" />
        <div class="play-overlay">
          <button class="play-btn">▶</button>
        </div>
      </div>
      <div class="info">
        <span class="type">{release.type}</span>
        <h3 class="title">{release.title}</h3>
        <p class="artist">{release.artist}</p>
      </div>
    </article>
  ))}
</div>

<style>
  .music-grid {
    display: grid;
    grid-template-columns: repeat(1, 1fr);
    gap: 32px;
  }

  @media (min-width: 768px) {
    .music-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .release-card {
    group: relative;
  }

  .cover-wrapper {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
    margin-bottom: 16px;
    border: 1px solid rgba(255, 255, 255, 0.1);
  }

  img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
    filter: grayscale(50%);
  }

  .release-card:hover img {
    transform: scale(1.05);
    filter: grayscale(0%);
  }

  .play-overlay {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.4);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .release-card:hover .play-overlay {
    opacity: 1;
  }

  .play-btn {
    width: 64px;
    height: 64px;
    border-radius: 50%;
    background: var(--primary-color);
    border: none;
    color: #000;
    font-size: 24px;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding-left: 4px; /* Optical center */
  }

  .info {
    text-align: center;
  }

  .type {
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--primary-color);
    display: block;
    margin-bottom: 8px;
  }

  .title {
    font-size: 18px;
    font-weight: 700;
    margin: 0 0 4px;
    text-transform: uppercase;
  }

  .artist {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
    margin: 0;
  }
</style>
