---
// Componente Modal de Perfil con Autenticación
---

<!-- Modal de Perfil Mejorado con Autenticación -->
<div class="modal" id="profile-modal">
	<div class="modal-header">
		<h3 class="modal-title">Mi Perfil</h3>
		<button class="modal-close" aria-label="Cerrar">
			<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
				<path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854Z"/>
			</svg>
		</button>
	</div>
	<div class="modal-content">
		<!-- Estado Autenticado -->
		<div class="profile-authenticated" id="profile-authenticated" style="display: none;">
			<div class="profile-header">
				<div class="profile-avatar">
					<img id="profile-avatar" src="data:image/svg+xml,%3Csvg%20xmlns%3D%27http%3A//www.w3.org/2000/svg%27%20width%3D%2780%27%20height%3D%2780%27%20viewBox%3D%270%200%2080%2080%27%3E%3Cdefs%3E%3CradialGradient%20id%3D%27g%27%20cx%3D%2730%25%27%20cy%3D%2720%25%27%20r%3D%2780%25%27%3E%3Cstop%20stop-color%3D%27%23C98300%27/%3E%3Cstop%20offset%3D%271%27%20stop-color%3D%27%23000000%27/%3E%3C/radialGradient%3E%3C/defs%3E%3Crect%20width%3D%2780%27%20height%3D%2780%27%20rx%3D%2740%27%20fill%3D%27url(%23g)%27/%3E%3Cpath%20d%3D%27M40%2042c7.2%200%2013-5.8%2013-13s-5.8-13-13-13-13%205.8-13%2013%205.8%2013%2013%2013z%27%20fill%3D%27%23ffffff%27%20opacity%3D%270.18%27/%3E%3Cpath%20d%3D%27M18%2070c4.8-12.2%2016.4-18%2022-18s17.2%205.8%2022%2018%27%20fill%3D%27%23ffffff%27%20opacity%3D%270.18%27/%3E%3C/svg%3E" alt="Avatar">
				</div>
				<div class="profile-info">
					<h4 id="profile-name">Usuario Wild</h4>
					<p id="profile-email">miembro@wildgvng.com</p>
				</div>
			</div>
			<div class="profile-menu">
				<a href="/perfil" class="profile-link">
					<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
						<path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
					</svg>
					Ver Perfil
				</a>
				<a href="/pedidos" class="profile-link">
					<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
						<path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .49.598l-1 5a.5.5 0 0 1-.465.401l-9.397.472L4.415 11H13a.5.5 0 0 1 0 1H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM3.102 4l.84 4.479 9.144-.459L13.89 4H3.102zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
					</svg>
					Mis Pedidos
				</a>
				<a href="/configuracion" class="profile-link">
					<svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
						<path d="M8 4.754a3.246 3.246 0 1 0 0 6.492 3.246 3.246 0 0 0 0-6.492zM5.754 8a2.246 2.246 0 1 1 4.492 0 2.246 2.246 0 0 1-4.492 0z"/>
						<path d="M9.796 1.343c-.527-1.79-3.065-1.79-3.592 0l-.094.319a.873.873 0 0 1-1.255.52l-.292-.16c-1.64-.892-3.433.902-2.54 2.541l.159.292a.873.873 0 0 1 .52 1.255l-.319.094c-1.79.527-1.79 3.065 0 3.592l.319.094a.873.873 0 0 1 .52 1.255l-.16.292c-.892 1.64.901 3.434 2.541 2.54l.292-.159a.873.873 0 0 1 1.255.52l.094.319c.527 1.79 3.065 1.79 3.592 0l.094-.319a.873.873 0 0 1 1.255-.52l.292.16c1.64.892 3.434-.902 2.54-2.541l-.159-.292a.873.873 0 0 1 .52-1.255l.319-.094c1.79-.527 1.79-3.065 0-3.592l-.319-.094a.873.873 0 0 1-.52-1.255l.16-.292c.892-1.64-.901-3.434-2.541-2.54l-.292.159a.873.873 0 0 1-1.255-.52l-.094-.319z"/>
					</svg>
					Configuración
				</a>
				<button class="logout-btn" id="logout-btn">Cerrar Sesión</button>
			</div>
		</div>
		<!-- Estado No Autenticado -->
		<div class="profile-guest" id="profile-guest">
			<div class="profile-login-prompt">
				<h4>¡Bienvenido a Wild Gvng!</h4>
				<p>Inicia sesión para acceder a todas las funciones</p>
			</div>
			<div class="profile-actions">
				<a href="/login" class="btn-primary profile-btn">Iniciar Sesión</a>
				<a href="/registro" class="btn-secondary profile-btn">Crear Cuenta</a>
			</div>
		</div>
	</div>
</div>

<style>
.profile-authenticated {
	display: block;
}

.profile-guest {
	text-align: center;
	padding: 20px 0;
}

.profile-login-prompt {
	margin-bottom: 24px;
}

.profile-login-prompt h4 {
	margin: 0 0 8px 0;
	color: #fff;
	font-size: 16px;
	font-family: 'Noto Sans JP', sans-serif;
}

.profile-login-prompt p {
	margin: 0;
	color: rgba(255, 255, 255, 0.6);
	font-size: 14px;
	font-family: 'Noto Sans JP', sans-serif;
}

.profile-actions {
	display: flex;
	flex-direction: column;
	gap: 12px;
}

.profile-btn {
	width: 100%;
	text-align: center;
	text-decoration: none;
	padding: 12px 16px;
	border-radius: 6px;
	font-size: 14px;
	font-weight: 600;
	font-family: 'Noto Sans JP', sans-serif;
	transition: all 0.2s;
	text-transform: uppercase;
	letter-spacing: 0.05em;
	cursor: pointer;
}

.btn-primary.profile-btn {
	background: var(--primary-color);
	color: #000;
	border: none;
}

.btn-primary.profile-btn:hover {
	background: #fff;
	transform: translateY(-2px);
}

.btn-secondary.profile-btn {
	background: transparent;
	color: var(--primary-color);
	border: 1px solid var(--primary-color);
}

.btn-secondary.profile-btn:hover {
	background: var(--primary-color);
	color: #000;
}

.logout-btn {
	width: 100%;
	padding: 12px 16px;
	background: rgba(255, 255, 255, 0.05);
	border: 1px solid rgba(255, 255, 255, 0.3);
	color: rgba(255, 255, 255, 0.7);
	border-radius: 6px;
	font-size: 14px;
	font-weight: 600;
	font-family: 'Noto Sans JP', sans-serif;
	cursor: pointer;
	transition: all 0.2s;
	text-transform: uppercase;
	letter-spacing: 0.05em;
}

.logout-btn:hover {
	background: rgba(255, 255, 255, 0.1);
	color: #fff;
	border-color: #fff;
}
</style>
