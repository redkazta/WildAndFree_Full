---
import { supabase } from '../lib/supabase';
import { sponsors as fallbackSponsors, type Sponsor } from '../data/sponsorsData';

export type Props = {
  /** Ancla de la sección. */
  id?: string;
  /** Permite ocultar el encabezado si se embebe en otra sección. */
  showHeader?: boolean;
};

const { id = 'patrocinadores', showHeader = true } = Astro.props;

function initials(name: string): string {
  return name
    .split(/\s+/)
    .map((word) => word[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
}

let allSponsors: Sponsor[] = fallbackSponsors;

try {
  const { data, error } = await supabase
    .from('sponsors')
    .select('id, name, slug, description, logo_url, website_url, tier, sort_order')
    .eq('is_active', true)
    .order('sort_order', { ascending: true });

  if (!error && data && data.length > 0) {
    allSponsors = data.map((sponsor: any) => ({
      id: sponsor.slug || sponsor.id,
      name: sponsor.name,
      description: sponsor.description || '',
      url: sponsor.website_url || undefined,
      logo: sponsor.logo_url || undefined,
      monogram: initials(sponsor.name),
      tier: sponsor.tier === 'main' ? 'main' : 'secondary',
      tag: sponsor.tier === 'main' ? 'Patrocinador Principal' : undefined,
    }));
  }
} catch {
  // Si la tabla aún no existe, se mantiene el fallback local.
}

const mainIndex = allSponsors.map((sponsor) => sponsor.tier).indexOf('main');
const mainSponsor = mainIndex >= 0 ? allSponsors[mainIndex] : undefined;
const secondarySponsors = allSponsors.filter((sponsor) => sponsor.tier !== 'main');
---

<section id={id} class="sponsors-section" aria-labelledby={`${id}-title`}>
  <!-- Fondo: grid de puntos + glow dorado -->
  <div class="sponsors-bg" aria-hidden="true"></div>
  <div class="sponsors-glow" aria-hidden="true"></div>

  <div class="relative z-10 max-w-[1400px] mx-auto px-5 sm:px-8 py-20 md:py-28">
    {showHeader && (
      <header class="max-w-3xl mb-12 md:mb-16">
        <span class="inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.3em] text-[var(--primary)] mb-4">
          <span class="w-8 h-[2px] bg-[var(--primary)]"></span>
          El movimiento es apoyado por
        </span>
        <h2 id={`${id}-title`} class="text-4xl sm:text-5xl md:text-7xl font-black uppercase tracking-tighter leading-[0.9]">
          <span class="text-[var(--text)]">Patrocinadores</span>
          <br class="sm:hidden" />
          <span class="text-[var(--primary)]"> Oficiales</span>
        </h2>
        <p class="mt-5 text-xs sm:text-sm font-bold uppercase tracking-[0.18em] text-white/50 max-w-xl">
          Marcas que creen en la cultura y apoyan el movimiento.
        </p>
      </header>
    )}

    {mainSponsor && (
      <article class="sponsor-main group">
        <!-- Panel del logotipo -->
        <div class="sponsor-main-visual">
          <span class="sponsor-tier-chip">{mainSponsor.tag ?? 'Patrocinador Principal'}</span>
          <span class="sponsor-index" aria-hidden="true">01</span>

          <div class="sponsor-mark sponsor-mark--lg">
            {mainSponsor.logo ? (
              <img
                src={mainSponsor.logo}
                alt={`Logotipo de ${mainSponsor.name}`}
                width="280"
                height="120"
                loading="lazy"
                decoding="async"
                class="max-h-28 w-auto object-contain"
              />
            ) : (
              <>
                <span class="sponsor-monogram">{mainSponsor.monogram ?? initials(mainSponsor.name)}</span>
                <span class="sponsor-wordmark">{mainSponsor.name}</span>
              </>
            )}
          </div>

          <span class="sponsor-visual-caption">Cultura · Calle · Talento local</span>
        </div>

        <!-- Contenido -->
        <div class="sponsor-main-body">
          <p class="text-[10px] font-black uppercase tracking-[0.3em] text-[var(--primary)] mb-3">
            Aliado desde el día uno
          </p>
          <h3 class="text-2xl sm:text-3xl md:text-4xl font-black uppercase tracking-tight text-white leading-none">
            {mainSponsor.name}
          </h3>
          <p class="mt-4 text-sm md:text-base leading-relaxed text-white/70 max-w-lg">
            {mainSponsor.description}
          </p>

          {mainSponsor.url && (
            <a
              href={mainSponsor.url}
              target="_blank"
              rel="noopener noreferrer"
              class="sponsor-link mt-8"
            >
              Visitar sitio web
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M7 17 17 7" />
                <path d="M8 7h9v9" />
              </svg>
            </a>
          )}
        </div>
      </article>
    )}

    {secondarySponsors.length > 0 && (
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 mt-6">
        {secondarySponsors.map((sponsor: Sponsor, index: number) => (
          <article class="sponsor-card group">
            <div class="sponsor-card-visual">
              <span class="sponsor-index" aria-hidden="true">
                {String(index + 2).padStart(2, '0')}
              </span>
              <div class="sponsor-mark">
                {sponsor.logo ? (
                  <img
                    src={sponsor.logo}
                    alt={`Logotipo de ${sponsor.name}`}
                    width="180"
                    height="80"
                    loading="lazy"
                    decoding="async"
                    class="max-h-16 w-auto object-contain"
                  />
                ) : (
                  <>
                    <span class="sponsor-monogram">{sponsor.monogram ?? initials(sponsor.name)}</span>
                    <span class="sponsor-wordmark">{sponsor.name}</span>
                  </>
                )}
              </div>
            </div>

            <div class="p-6 flex flex-col flex-1">
              <h3 class="text-base font-black uppercase tracking-wide text-white">
                {sponsor.name}
              </h3>
              <p class="mt-2 text-xs sm:text-sm leading-relaxed text-white/70 flex-1">
                {sponsor.description}
              </p>

              {sponsor.url ? (
                <a
                  href={sponsor.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="sponsor-link mt-5"
                >
                  Visitar sitio web
                  <svg
                    xmlns="http://www.w3.org/2000/svg"
                    width="14"
                    height="14"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7" />
                    <path d="M8 7h9v9" />
                  </svg>
                </a>
              ) : (
                <span class="mt-5 inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-white/30">
                  <span class="w-1.5 h-1.5 rounded-full bg-white/30"></span>
                  Creatividad en casa
                </span>
              )}
            </div>
          </article>
        ))}
      </div>
    )}
  </div>
</section>

<style>
  .sponsors-section {
    position: relative;
    overflow: hidden;
    background: #050505;
    border-top: 1px solid rgba(255, 255, 255, 0.08);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .sponsors-bg {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.07) 1px, transparent 1px);
    background-size: 26px 26px;
    mask-image: linear-gradient(to bottom, black 0%, transparent 85%);
    -webkit-mask-image: linear-gradient(to bottom, black 0%, transparent 85%);
    pointer-events: none;
  }

  .sponsors-glow {
    position: absolute;
    top: -180px;
    right: -120px;
    width: 520px;
    height: 520px;
    border-radius: 9999px;
    background: radial-gradient(circle, rgba(201, 131, 0, 0.18) 0%, transparent 65%);
    filter: blur(20px);
    pointer-events: none;
  }

  /* ===== Tarjeta principal ===== */
  .sponsor-main {
    display: grid;
    grid-template-columns: 1fr;
    background: #0b0b0b;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 24px;
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  @media (min-width: 768px) {
    .sponsor-main {
      grid-template-columns: 1.05fr 1fr;
    }
  }

  .sponsor-main:hover {
    border-color: rgba(201, 131, 0, 0.55);
    box-shadow: 0 0 70px -22px rgba(201, 131, 0, 0.5);
    transform: translateY(-2px);
  }

  .sponsor-main-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 300px;
    padding: 56px 32px;
    background:
      radial-gradient(circle at 50% 45%, rgba(201, 131, 0, 0.1) 0%, transparent 60%),
      repeating-linear-gradient(
        45deg,
        rgba(255, 255, 255, 0.02) 0px,
        rgba(255, 255, 255, 0.02) 1px,
        transparent 1px,
        transparent 12px
      );
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  @media (min-width: 768px) {
    .sponsor-main-visual {
      border-bottom: 0;
      border-right: 1px solid rgba(255, 255, 255, 0.08);
      min-height: 400px;
    }
  }

  .sponsor-main-body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 40px 28px;
  }

  @media (min-width: 768px) {
    .sponsor-main-body {
      padding: 56px 48px;
    }
  }

  .sponsor-tier-chip {
    position: absolute;
    top: 20px;
    left: 20px;
    font-size: 9px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: #050505;
    background: var(--primary, #c98300);
    padding: 6px 10px;
    border-radius: 9999px;
  }

  .sponsor-index {
    position: absolute;
    top: 20px;
    right: 20px;
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.2em;
    color: rgba(255, 255, 255, 0.25);
  }

  .sponsor-visual-caption {
    position: absolute;
    bottom: 20px;
    left: 0;
    right: 0;
    text-align: center;
    font-size: 9px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.28em;
    color: rgba(255, 255, 255, 0.25);
  }

  /* ===== Lockup tipográfico (fallback de logo) ===== */
  .sponsor-mark {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    text-align: center;
    padding: 0 12px;
  }

  .sponsor-monogram {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 68px;
    height: 68px;
    border-radius: 18px;
    border: 2px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.04);
    color: #ffffff;
    font-size: 24px;
    font-weight: 900;
    letter-spacing: 0.04em;
    line-height: 1;
    transition: border-color 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
  }

  .sponsor-mark--lg .sponsor-monogram {
    width: 96px;
    height: 96px;
    border-radius: 24px;
    font-size: 34px;
  }

  .sponsor-wordmark {
    display: block;
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.24em;
    color: rgba(255, 255, 255, 0.75);
    max-width: 240px;
    line-height: 1.35;
    transition: color 0.3s ease;
  }

  .sponsor-mark--lg .sponsor-wordmark {
    font-size: 15px;
    letter-spacing: 0.3em;
  }

  .group:hover .sponsor-monogram {
    border-color: rgba(201, 131, 0, 0.7);
    color: var(--primary, #c98300);
    box-shadow: 0 0 32px -10px rgba(201, 131, 0, 0.6);
  }

  .group:hover .sponsor-wordmark {
    color: #ffffff;
  }

  /* ===== Tarjetas secundarias ===== */
  .sponsor-card {
    display: flex;
    flex-direction: column;
    background: #0b0b0b;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 18px;
    overflow: hidden;
    transition: border-color 0.3s ease, box-shadow 0.3s ease, transform 0.3s ease;
  }

  .sponsor-card:hover {
    border-color: rgba(201, 131, 0, 0.5);
    box-shadow: 0 0 48px -18px rgba(201, 131, 0, 0.45);
    transform: translateY(-2px);
  }

  .sponsor-card-visual {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 150px;
    padding: 32px 24px;
    background:
      radial-gradient(circle at 50% 50%, rgba(201, 131, 0, 0.07) 0%, transparent 65%),
      #090909;
    border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  }

  /* ===== Enlace ===== */
  .sponsor-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    width: fit-content;
    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.22em;
    color: var(--primary, #c98300);
    transition: color 0.2s ease, gap 0.2s ease;
  }

  .sponsor-link:hover {
    color: #ffffff;
    gap: 12px;
  }

  @media (prefers-reduced-motion: reduce) {
    .sponsor-main,
    .sponsor-card,
    .sponsor-monogram,
    .sponsor-wordmark,
    .sponsor-link {
      transition: none;
    }
  }
</style>
