---
const events = [
  {
    date: "MAR 15",
    city: "Buenos Aires",
    venue: "Niceto Club",
    status: "Tickets Available"
  },
  {
    date: "MAR 22",
    city: "Cordoba",
    venue: "Club Paraguay",
    status: "Sold Out"
  },
  {
    date: "APR 05",
    city: "Rosario",
    venue: "Studio Theater",
    status: "Selling Fast"
  }
];
---

<div class="space-y-4">
  {events.map((event) => (
    <div class="group flex flex-col md:flex-row md:items-center justify-between p-8 rounded-3xl bg-white/[0.02] border border-white/5 hover:bg-white/[0.05] hover:border-orange-500/20 transition-all duration-300 gap-6">
      <div class="flex items-center gap-8">
        <div class="text-center min-w-[80px]">
          <div class="text-3xl font-black text-orange-500 tracking-tighter leading-none">{event.date.split(' ')[1]}</div>
          <div class="text-[10px] font-black uppercase tracking-[0.2em] text-white">{event.date.split(' ')[0]}</div>
        </div>
        <div class="space-y-1">
          <h3 class="text-2xl font-black uppercase tracking-tight text-white">{event.city}</h3>
          <p class="text-sm text-white font-black uppercase tracking-widest">{event.venue}</p>
        </div>
      </div>
      <div class="flex items-center gap-6">
        <span class={`text-[10px] font-black uppercase tracking-[0.2em] ${event.status === 'Sold Out' ? 'text-red-500' : 'text-orange-500/60'}`}>
          {event.status}
        </span>
        <button 
          class={`px-8 py-4 rounded-full text-xs font-black uppercase tracking-[0.2em] transition-all duration-300 ${
            event.status === 'Sold Out' 
            ? 'bg-white/5 text-white/20 cursor-not-allowed border border-white/5' 
            : 'bg-white text-black hover:bg-orange-500 transform hover:-translate-y-1'
          }`}
          disabled={event.status === 'Sold Out'}
        >
          {event.status === 'Sold Out' ? 'Agotado' : 'Tickets'}
        </button>
      </div>
    </div>
  ))}
</div>

<style>
  /* Usando Tailwind */
</style>
