---
const { events = [] } = Astro.props;
---

<div class="grid grid-cols-1 gap-6">
  {events.map((event: any) => (
    <div class="group relative flex flex-col md:flex-row items-center gap-8 p-6 rounded-wild-xl bg-[var(--bg-card)] border border-[var(--border)] hover:bg-[var(--bg-card)] hover:border-wild-orange/30 transition-all duration-500">
      <!-- Event Image -->
      <div class="w-full md:w-48 aspect-video md:aspect-square rounded-wild-lg overflow-hidden shrink-0">
        <img src={event.image_url} alt={event.title} width="400" height="400" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700" />
      </div>

      <!-- Event Info -->
      <div class="flex-1 space-y-4 text-center md:text-left">
        <div class="flex flex-wrap justify-center md:justify-start gap-4">
          <span class="px-3 py-1 rounded-full bg-[var(--bg-card)] border border-[var(--border)] text-label-sm font-black uppercase tracking-widest text-[var(--text-muted)]">
            {event.date}
          </span>
          <span class={`px-3 py-1 rounded-full text-label-sm font-black uppercase tracking-widest ${
            event.status === 'disponible' ? 'bg-green-500/10 border-green-500/20 text-green-500' : 'bg-wild-orange/10 border-wild-orange/20 text-wild-orange'
          }`}>
            {event.status === 'disponible' ? 'Boletos Disponibles' : 'Próximamente'}
          </span>
        </div>
        
        <div>
          <h3 class="text-3xl font-black uppercase tracking-tighter text-[var(--text)] group-hover:text-wild-orange transition-colors">{event.title}</h3>
          <p class="text-sm font-black text-[var(--text-faint)] uppercase tracking-widest">{event.location.nombre} // {event.location.ciudad}</p>
        </div>
      </div>

      <!-- Pricing & Action -->
      <div class="flex flex-col items-center md:items-end gap-4 shrink-0 w-full md:w-auto">
        <div class="text-center md:text-right">
          <p class="text-label-sm font-black uppercase tracking-widest text-[var(--text-faint)]">Desde</p>
          <p class="text-3xl font-black text-[var(--text)] tracking-tighter">${event.tickets.precio_min}</p>
        </div>
        <button class={`w-full md:w-auto px-8 py-4 rounded-wild-lg text-label-sm font-black uppercase tracking-widest transition-all transform hover:-translate-y-1 ${
          event.status === 'disponible' ? 'bg-white text-black hover:bg-wild-orange hover:text-[var(--text)]' : 'bg-[var(--bg-card)] border border-[var(--border)] text-[var(--text-faint)] cursor-not-allowed'
        }`}>
          {event.status === 'disponible' ? 'Comprar Boletos' : 'Avisarme'}
        </button>
      </div>
    </div>
  ))}
</div>
