---
const { events = [] } = Astro.props;
---

<div class="grid grid-cols-1 gap-6">
  {events.map((event) => (
    <div class="group relative flex flex-col md:flex-row items-center gap-8 p-6 rounded-3xl bg-white/[0.02] border border-white/5 hover:bg-white/[0.05] hover:border-orange-500/30 transition-all duration-500">
      <!-- Event Image -->
      <div class="w-full md:w-48 aspect-video md:aspect-square rounded-2xl overflow-hidden shrink-0">
        <img src={event.image_url} alt={event.title} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700" />
      </div>

      <!-- Event Info -->
      <div class="flex-1 space-y-4 text-center md:text-left">
        <div class="flex flex-wrap justify-center md:justify-start gap-4">
          <span class="px-3 py-1 rounded-full bg-white/5 border border-white/10 text-[10px] font-black uppercase tracking-widest text-white/60">
            {event.date}
          </span>
          <span class={`px-3 py-1 rounded-full text-[10px] font-black uppercase tracking-widest ${
            event.status === 'disponible' ? 'bg-green-500/10 border-green-500/20 text-green-500' : 'bg-orange-500/10 border-orange-500/20 text-orange-500'
          }`}>
            {event.status === 'disponible' ? 'Boletos Disponibles' : 'Próximamente'}
          </span>
        </div>
        
        <div>
          <h3 class="text-3xl font-black uppercase tracking-tighter text-white group-hover:text-orange-500 transition-colors">{event.title}</h3>
          <p class="text-sm font-black text-white/40 uppercase tracking-widest">{event.location.nombre} // {event.location.ciudad}</p>
        </div>
      </div>

      <!-- Pricing & Action -->
      <div class="flex flex-col items-center md:items-end gap-4 shrink-0 w-full md:w-auto">
        <div class="text-center md:text-right">
          <p class="text-[10px] font-black uppercase tracking-widest text-white/40">Desde</p>
          <p class="text-3xl font-black text-white tracking-tighter">${event.tickets.precio_min}</p>
        </div>
        <button class={`w-full md:w-auto px-8 py-4 rounded-2xl text-[10px] font-black uppercase tracking-[0.2em] transition-all transform hover:-translate-y-1 ${
          event.status === 'disponible' ? 'bg-white text-black hover:bg-orange-500 hover:text-white' : 'bg-white/5 border border-white/10 text-white/20 cursor-not-allowed'
        }`}>
          {event.status === 'disponible' ? 'Comprar Boletos' : 'Avisarme'}
        </button>
      </div>
    </div>
  ))}
</div>
