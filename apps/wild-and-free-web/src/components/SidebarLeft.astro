      </button>
    </div>
  </nav>
  <div class="sidebar-footer">
    <p class="sidebar-tagline">Built to move as one.</p>
  </div>
</aside>

<script>
  // Client-side sidebar functionality
  window.sidebarStore = {
    isOpen: false,
    
    open() {
      this.isOpen = true;
      const sidebar = document.getElementById('sidebar');
      if (sidebar) {
        sidebar.classList.add('sidebar--open');
        document.documentElement.style.overflow = 'hidden';
      }
    },
    
    close() {
      this.isOpen = false;
      const sidebar = document.getElementById('sidebar');
      if (sidebar) {
        sidebar.classList.remove('sidebar--open');
        document.documentElement.style.overflow = '';
      }
    },
    
    toggle() {
      this.isOpen ? this.close() : this.open();
    }
  };

  // Initialize event listeners
  document.addEventListener('DOMContentLoaded', () => {
    const closeBtn = document.querySelector('.close-btn');
    const locationBtn = document.querySelector('.location-btn');
    
    if (closeBtn) {
      closeBtn.addEventListener('click', () => window.sidebarStore.close());
    }
    
    if (locationBtn) {
      locationBtn.addEventListener('click', () => {
        alert('Selector de ubicación - próximamente');
      });
    }
  });
</script>

<style>
  .sidebar {
    position: fixed;
    top: 0;
    left: -320px;
    width: 320px;
    height: 100vh;
    background: linear-gradient(180deg, #000 0%, #111 100%);
    border-right: 1px solid rgba(201, 131, 0, 0.3);
    z-index: 2000;
    transition: left 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    display: flex;
    flex-direction: column;
    padding: 0;
    font-family: 'Noto Sans JP', 'Inter', system-ui, -apple-system, sans-serif;
  }

  .sidebar--open {
    left: 0;
  }

  .sidebar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px 24px;
    border-bottom: 1px solid rgba(201, 131, 0, 0.3);
    background: linear-gradient(90deg, #000 0%, #111 100%);
  }

  .sidebar-logo {
    display: flex;
    flex-direction: column;
    gap: 1px;
    font-weight: 900;
    font-size: 14px;
    letter-spacing: 0.2em;
    color: #fff;
    text-transform: uppercase;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .sidebar-logo .logo-line {
    display: block;
    font-weight: 900;
    letter-spacing: 0.25em;
  }

  .close-btn {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.7);
    font-size: 16px;
    cursor: pointer;
    padding: 8px;
    border-radius: 2px;
    transition: all 0.2s;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .close-btn:hover {
    color: var(--primary-color);
    background: rgba(201, 131, 0, 0.1);
  }

  .sidebar-nav {
    flex: 1;
    padding: 24px;
    overflow-y: auto;
  }

  .nav-section {
    margin-bottom: 24px;
  }

  .nav-section-title {
    font-size: 11px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0 0 12px 0;
    padding: 0 16px;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    border-radius: 6px;
    transition: all 0.2s;
    margin: 2px 0;
    border-left: 3px solid transparent;
  }

  .nav-item svg {
    width: 14px;
    height: 14px;
    opacity: 0.7;
    transition: all 0.2s;
  }

  .nav-item:hover {
    color: var(--primary-color);
    background: rgba(201, 131, 0, 0.1);
    transform: translateX(4px);
    border-left-color: var(--primary-color);
  }

  .nav-item:hover svg {
    opacity: 1;
    color: var(--primary-color);
  }

  .location-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 10px 16px;
    background: transparent;
    border: none;
    color: var(--primary-color);
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s;
    margin: 2px 0;
    border-left: 3px solid transparent;
  }

  .location-btn:hover {
    background: rgba(201, 131, 0, 0.1);
    transform: translateX(4px);
    border-left-color: var(--primary-color);
  }

  .location-btn svg {
    width: 14px;
    height: 14px;
    opacity: 0.7;
    transition: all 0.2s;
  }

  .location-btn:hover svg {
    opacity: 1;
  }

  .sidebar-footer {
    padding: 20px 24px;
    border-top: 1px solid rgba(138, 3, 3, 0.2);
    background: linear-gradient(90deg, #111 0%, #000 100%);
  }

  .sidebar-tagline {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.3);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
    text-align: center;
    font-weight: 500;
  }

  @media (min-width: 1024px) {
    .sidebar {
      left: 0;
      position: sticky;
      top: 80px;
      height: calc(100vh - 80px);
      border-right: 1px solid rgba(255, 255, 255, 0.15);
    }
  }

  /* Mobile overlay */
  @media (max-width: 1023px) {
    .sidebar::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: -1;
      opacity: 0;
      transition: opacity 0.3s;
      pointer-events: none;
    }

    .sidebar--open::before {
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>