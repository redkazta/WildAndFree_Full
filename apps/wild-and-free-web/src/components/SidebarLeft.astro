---
export type Props = {
  isOpen: boolean;
  onClose: () => void;
};

const { isOpen, onClose } = Astro.props;
---

<aside class:list={["sidebar", { "sidebar--open": isOpen }]}>
  <div class="sidebar-header">
    <h3 class="sidebar-title">Wild Gvng</h3>
    <button class="close-btn" on:click={onClose}>✕</button>
  </div>
  <nav class="sidebar-nav">
    <a href="#artistas" class="nav-item">Artistas</a>
    <a href="#music" class="nav-item">Música</a>
    <a href="#events" class="nav-item">Eventos</a>
    <a href="#shop" class="nav-item">Tienda</a>
    <div class="nav-divider"></div>
    <a href="#login" class="nav-item">Iniciar Sesión</a>
    <a href="#cart" class="nav-item">Mi Carrito</a>
    <a href="#wishlist" class="nav-item">Mi Wishlist</a>
    <div class="nav-divider"></div>
    <button class="location-btn">Elegir Ubicación</button>
  </nav>
  <div class="sidebar-footer">
    <p class="sidebar-tagline">Built to move as one.</p>
  </div>
</aside>

<style>
  .sidebar {
    position: fixed;
    top: 0;
    left: -320px;
    width: 320px;
    height: 100vh;
    background: #0a0a0a;
    border-right: 1px solid rgba(255, 255, 255, 0.1);
    z-index: 2000;
    transition: left 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    display: flex;
    flex-direction: column;
    padding: 24px;
  }

  .sidebar--open {
    left: 0;
  }

  .sidebar-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 32px;
  }

  .sidebar-title {
    font-size: 24px;
    font-weight: 900;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .close-btn {
    background: none;
    border: none;
    color: #fff;
    font-size: 20px;
    cursor: pointer;
    padding: 4px;
    opacity: 0.6;
    transition: opacity 0.2s;
  }

  .close-btn:hover {
    opacity: 1;
  }

  .sidebar-nav {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .nav-item {
    padding: 12px 16px;
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    font-size: 14px;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border-radius: 4px;
    transition: all 0.2s;
    position: relative;
  }

  .nav-item:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.05);
  }

  .nav-divider {
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin: 16px 0;
  }

  .location-btn {
    padding: 12px 16px;
    background: transparent;
    border: 1px solid var(--primary-color);
    color: var(--primary-color);
    font-size: 12px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s;
    margin-top: 8px;
  }

  .location-btn:hover {
    background: var(--primary-color);
    color: #000;
  }

  .sidebar-footer {
    margin-top: auto;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .sidebar-tagline {
    font-size: 11px;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
    text-align: center;
  }

  @media (min-width: 1024px) {
    .sidebar {
      left: 0;
      position: sticky;
      top: 80px;
      height: calc(100vh - 80px);
      border-right: 1px solid rgba(255, 255, 255, 0.1);
    }
  }
</style>
