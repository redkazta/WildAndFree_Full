---
declare const Astro: any;

const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/artistas', label: 'Artistas' },
  { href: '/versus', label: 'Versus' },
  { href: '/musica', label: 'Música' },
  { href: '/radio', label: 'Radio' },
  { href: '/podcasts', label: 'Podcasts' },
  { href: '/eventos', label: 'Eventos' },
  { href: '/tienda', label: 'Tienda' },
  { href: '/wild-and-free-league', label: 'WILD AND FREE' },
  { href: '/honor-and-free', label: 'HONOR AND FREE' },
  { href: '/ascension', label: 'ASCENSIÓN' },
  { href: '/wild-writings', label: 'WILD WRITINGS' }
];

const isActive = (href: string) => {
  if (currentPath === href) return true;
  if (href === '/artistas' && currentPath.startsWith('/artista/')) return true;
  if (href === '/eventos' && currentPath.startsWith('/evento/')) return true;
  if (href === '/radio' && currentPath.startsWith('/radio')) return true;
  return false;
};
---

<aside class="fixed top-0 left-[-288px] w-72 h-screen bg-black border-r-2 border-white z-[2000] transition-all duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] flex flex-col shadow-[20px_0_50px_rgba(0,0,0,1)]" id="sidebar">
  <div class="p-8 flex flex-col h-full relative">
    <!-- Header Sidebar -->
    <div class="flex items-center justify-between mb-12">
      <div class="py-2 flex items-center gap-3">
        <img src="/assets/wildgvng-logo.svg" alt="Wild Gvng Logo" class="w-12 h-12 md:w-14 md:h-14 object-contain" />
        <span class="text-2xl font-black tracking-tighter italic"><span class="text-wild-orange">WILD</span> <span class="text-white">GVNG</span></span>
      </div>
      <button id="sidebar-close" class="p-2 text-white hover:text-wild-orange transition-all duration-300 group" aria-label="Cerrar menú">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="group-hover:rotate-90 transition-transform duration-300"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
      </button>
    </div>

    <div class="space-y-12">
      <!-- Nav Section -->
      <div class="space-y-6">
        <h4 class="text-[12px] font-black uppercase tracking-[0.4em] text-wild-orange border-l-4 border-wild-orange pl-4">Explorar</h4>
        <nav class="flex flex-col gap-1">
          {navItems.map(item => (
            <a
              href={item.href}
              class={`group flex items-center gap-4 py-4 px-4 text-xs font-black uppercase tracking-widest rounded-xl transition-all ${isActive(item.href) ? 'text-wild-orange bg-white/10' : 'text-white hover:text-wild-orange hover:bg-white/10'}`}
            >
              <span class={`w-2 h-2 rounded-full transition-colors ${isActive(item.href) ? 'bg-wild-orange' : 'bg-white group-hover:bg-wild-orange'}`}></span>
              {item.label}
            </a>
          ))}
        </nav>
      </div>

      <!-- Account Section -->
      <div class="space-y-6">
        <h4 class="text-[12px] font-black uppercase tracking-[0.4em] text-white border-l-4 border-white pl-4">Cuenta</h4>
        <nav class="flex flex-col gap-1">
          <a href="/login" class="group flex items-center gap-4 py-4 px-4 text-xs font-black uppercase tracking-widest text-white hover:text-wild-orange hover:bg-white/10 rounded-xl transition-all">
            <span class="w-2 h-2 rounded-full bg-white group-hover:bg-wild-orange transition-colors"></span>
            Entrar
          </a>
          <a href="/perfil" class="group flex items-center gap-4 py-4 px-4 text-xs font-black uppercase tracking-widest text-white hover:text-wild-orange hover:bg-white/10 rounded-xl transition-all">
            <span class="w-2 h-2 rounded-full bg-white group-hover:bg-wild-orange transition-colors"></span>
            Mi Perfil
          </a>
        </nav>
      </div>
    </div>

    <!-- Footer Sidebar -->
    <div class="mt-auto pt-8 border-t-2 border-white space-y-6">
      <div class="flex items-center gap-4">
        <button class="location-btn w-full py-5 px-6 bg-black border-2 border-white text-[11px] font-black uppercase tracking-[0.2em] text-white hover:bg-wild-orange hover:text-black transition-all">
          Ubicación: Torreón Coahuila
        </button>
      </div>
      <div class="text-center">
        <div class="text-[11px] font-black tracking-[0.4em] text-wild-orange">WILD GVNG © 2026</div>
      </div>
    </div>
  </div>
</aside>
