---
// No props needed - we'll use client-side JavaScript
---

<aside class="fixed top-0 left-[-320px] lg:left-0 w-80 h-screen bg-black/95 backdrop-blur-3xl border-r border-white/10 z-[2000] transition-all duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] flex flex-col shadow-[20px_0_50px_rgba(0,0,0,0.8)]" id="sidebar">
  <div class="p-8 flex flex-col h-full relative">
    <!-- Close Button -->
    <button id="sidebar-close" class="lg:hidden absolute top-6 right-6 p-3 text-white hover:text-orange-500 hover:bg-white/5 rounded-xl transition-all duration-300" aria-label="Cerrar menú">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
    </button>

    <div class="space-y-12 mt-10 lg:mt-0">
      <!-- Nav Section -->
      <div class="space-y-6">
        <h4 class="text-[11px] font-black uppercase tracking-[0.3em] text-orange-500/80">Explorar</h4>
        <nav class="flex flex-col gap-2">
          <a href="/artistas" class="group flex items-center gap-4 py-3 text-sm font-black uppercase tracking-widest text-white hover:text-orange-500 transition-all">
            <span class="w-1.5 h-1.5 rounded-full bg-white/20 group-hover:bg-orange-500 transition-colors"></span>
            Artistas
          </a>
          <a href="/musica" class="group flex items-center gap-4 py-3 text-sm font-black uppercase tracking-widest text-white hover:text-orange-500 transition-all">
            <span class="w-1.5 h-1.5 rounded-full bg-white/20 group-hover:bg-orange-500 transition-colors"></span>
            Música
          </a>
          <a href="/eventos" class="group flex items-center gap-4 py-3 text-sm font-black uppercase tracking-widest text-white hover:text-orange-500 transition-all">
            <span class="w-1.5 h-1.5 rounded-full bg-white/20 group-hover:bg-orange-500 transition-colors"></span>
            Eventos
          </a>
          <a href="/tienda" class="group flex items-center gap-4 py-3 text-sm font-black uppercase tracking-widest text-white hover:text-orange-500 transition-all">
            <span class="w-1.5 h-1.5 rounded-full bg-white/20 group-hover:bg-orange-500 transition-colors"></span>
            Tienda
          </a>
        </nav>
      </div>

      <!-- Account Section -->
      <div class="space-y-6">
        <h4 class="text-[11px] font-black uppercase tracking-[0.3em] text-orange-500/80">Cuenta</h4>
        <nav class="flex flex-col gap-2">
          <a href="/login" class="group flex items-center gap-4 py-3 text-sm font-black uppercase tracking-widest text-white hover:text-orange-500 transition-all">
            <span class="w-1.5 h-1.5 rounded-full bg-white/20 group-hover:bg-orange-500 transition-colors"></span>
            Login
          </a>
          <a href="/perfil" class="group flex items-center gap-4 py-3 text-sm font-black uppercase tracking-widest text-white hover:text-orange-500 transition-all">
            <span class="w-1.5 h-1.5 rounded-full bg-white/20 group-hover:bg-orange-500 transition-colors"></span>
            Mi Perfil
          </a>
        </nav>
      </div>
    </div>

    <!-- Footer Sidebar -->
    <div class="mt-auto pt-8 border-t border-white/10 space-y-6">
      <div class="flex items-center gap-4">
        <button class="location-btn w-full py-4 px-6 bg-white/5 border border-white/10 rounded-2xl text-[11px] font-black uppercase tracking-[0.2em] text-white hover:bg-white/10 transition-all">
          Ubicación: CDMX
        </button>
      </div>
      <div class="text-center">
        <div class="text-[10px] font-black tracking-[0.3em] text-orange-500">WILD GVNG © 2024</div>
      </div>
    </div>
  </div>
</aside>

<script>
  // Client-side sidebar functionality
  window.sidebarStore = {
    isOpen: false,
    scrollbarWidth: 0,
    
    open() {
      this.isOpen = true;
      const sidebar = document.getElementById('sidebar');
      if (sidebar) {
        sidebar.classList.add('sidebar--open');
        const scrollbarWidth = window.innerWidth - document.documentElement.clientWidth;
        this.scrollbarWidth = scrollbarWidth;
        document.documentElement.style.overflow = 'hidden';
        document.documentElement.style.paddingRight = scrollbarWidth > 0 ? `${scrollbarWidth}px` : '';
      }
    },
    
    close() {
      this.isOpen = false;
      const sidebar = document.getElementById('sidebar');
      if (sidebar) {
        sidebar.classList.remove('sidebar--open');
        document.documentElement.style.overflow = '';
        document.documentElement.style.paddingRight = '';
      }
    },
    
    toggle() {
      this.isOpen ? this.close() : this.open();
    }
  };

  // Initialize event listeners
  document.addEventListener('DOMContentLoaded', () => {
    const closeBtn = document.querySelector('.close-btn');
    const locationBtn = document.querySelector('.location-btn');
    
    if (closeBtn) {
      closeBtn.addEventListener('click', () => window.sidebarStore.close());
    }
    
    if (locationBtn) {
      locationBtn.addEventListener('click', () => {
        alert('Selector de ubicación - próximamente');
      });
    }
  });
</script>

<style>
  .sidebar {
    position: fixed;
    top: 0;
    left: -320px;
    width: 320px;
    height: 100vh;
    background: linear-gradient(180deg, #000 0%, #111 100%);
    border-right: 1px solid rgba(201, 131, 0, 0.18);
    box-shadow: 18px 0 60px rgba(0, 0, 0, 0.55), 1px 0 0 rgba(138, 3, 3, 0.22) inset;
    z-index: 2000;
    transition: left 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    display: flex;
    flex-direction: column;
    padding: 0;
    font-family: 'Noto Sans JP', 'Inter', system-ui, -apple-system, sans-serif;
  }

  .sidebar--open {
    left: 0;
  }

  .close-btn {
    background: transparent;
    border: 1px solid rgba(255, 255, 255, 0.14);
    color: rgba(255, 255, 255, 0.75);
    cursor: pointer;
    padding: 0;
    border-radius: 10px;
    transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .close-btn:hover {
    color: #fff;
    background: rgba(138, 3, 3, 0.12);
    border-color: rgba(138, 3, 3, 0.35);
  }

  .sidebar-nav {
    flex: 1;
    padding: 24px;
    overflow-y: auto;
  }

  .nav-section {
    margin-bottom: 24px;
  }

  .nav-section-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 16px;
    margin: 0 0 12px 0;
  }

  .nav-section-title {
    font-size: 11px;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.4);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
    padding: 0;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 16px;
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    border-radius: 6px;
    transition: background 0.15s ease, color 0.15s ease;
    margin: 2px 0;
    position: relative;
  }

  .nav-item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 8px;
    bottom: 8px;
    width: 2px;
    border-radius: 2px;
    background: transparent;
    transition: background 0.15s ease;
  }

  .nav-item svg {
    width: 14px;
    height: 14px;
    opacity: 0.7;
    transition: opacity 0.15s ease, color 0.15s ease;
  }

  .nav-item:hover {
    color: #fff;
    background: rgba(255, 255, 255, 0.06);
  }

  .nav-item:hover::before {
    background: rgba(138, 3, 3, 0.45);
  }

  .nav-item:hover svg {
    opacity: 1;
    color: rgba(201, 131, 0, 0.95);
  }

  .location-btn {
    display: flex;
    align-items: center;
    gap: 12px;
    width: 100%;
    padding: 10px 16px;
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.8);
    font-size: 14px;
    font-weight: 500;
    text-align: left;
    border-radius: 6px;
    cursor: pointer;
    transition: background 0.15s ease, color 0.15s ease;
    margin: 2px 0;
  }

  .location-btn svg {
    width: 14px;
    height: 14px;
    opacity: 0.7;
    transition: opacity 0.15s ease, color 0.15s ease;
  }

  .sidebar-footer {
    padding: 20px 24px;
    border-top: 1px solid rgba(138, 3, 3, 0.2);
    background: linear-gradient(90deg, #111 0%, #000 100%);
  }

  .sidebar-tagline {
    font-size: 10px;
    color: rgba(255, 255, 255, 0.3);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    margin: 0;
    text-align: center;
    font-weight: 500;
  }

  @media (min-width: 1024px) {
    .sidebar {
      left: 0;
      position: sticky;
      top: 80px;
      height: calc(100vh - 80px);
      border-right: 1px solid rgba(255, 255, 255, 0.15);
    }
  }

  /* Mobile overlay */
  @media (max-width: 1023px) {
    .sidebar::before {
      content: '';
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: rgba(0, 0, 0, 0.5);
      z-index: -1;
      opacity: 0;
      transition: opacity 0.3s;
      pointer-events: none;
    }

    .sidebar--open::before {
      opacity: 1;
      pointer-events: auto;
    }
  }
</style>
