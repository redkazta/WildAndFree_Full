---
declare const Astro: any;
const currentPath = Astro.url.pathname;

const navItems = [
	{ href: '/the-wild-times', label: 'THE WILD TIMES', icon: 'M4 6h16M4 12h16M4 18h16M8 6v12M16 6v12' },
		  { href: '/wild-writings', label: 'WILD WRITINGS', icon: 'M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732zM3 21h18' },
	  { href: '/artistas', label: 'Artistas', icon: 'M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z' },
  { href: '/versus', label: 'Versus', icon: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z' },
  { href: '/musica', label: 'Música', icon: 'M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z' },
  { href: '/radio', label: 'Radio', icon: 'M3.24 6.15C2.51 6.43 2 7.17 2 8v12c0 1.1.89 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2H8.3l8.26-3.34-.37-.91L3.24 6.15z' },
  { href: '/podcasts', label: 'Podcasts', icon: 'M20 2H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-8 6c1.66 0 3 1.34 3 3s-1.34 3-3 3-3-1.34-3-3 1.34-3 3-3zm6 10H6v-1c0-2 4-3.1 6-3.1s6 1.1 6 3.1v1z' },
  { href: '/eventos', label: 'Eventos', icon: 'M19 3h-1V1h-2v2H8V1H6v2H5c-1.1 0-2 .9-2 2v14c0 1.1.9 2 2 2h14c1.1 0 2-.9 2-2V5c0-1.1-.9-2-2-2zm0 16H5V8h14v11z' },
  { href: '/tienda', label: 'Tienda', icon: 'M7 18c-1.1 0-1.99.9-1.99 2S5.9 22 7 22s2-.9 2-2-.9-2-2-2zM1 2v2h2l3.6 7.59-1.35 2.45c-.16.28-.25.61-.25.96 0 1.1.9 2 2 2h12v-2H7.42c-.14 0-.25-.11-.25-.25l.03-.12.9-1.63h7.45c.75 0 1.41-.41 1.75-1.03l3.58-6.49c.08-.14.12-.31.12-.48 0-.55-.45-1-1-1H5.21l-.94-2H1zm16 16c-1.1 0-1.99.9-1.99 2s.89 2 1.99 2 2-.9 2-2-.9-2-2-2z' },
  { href: '/wild-and-free-league', label: 'WILD AND FREE', icon: 'M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z' },
  { href: '/honor-and-free', label: 'HONOR AND FREE', icon: 'M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z' },
  { href: '/ascension', label: 'ASCENSIÓN', icon: 'M16 6l2.29 2.29-4.88 4.88-4-4L2 16.59 3.41 18l6-6 4 4 6.3-6.29L22 12V6z' },
  { href: '/wild-writings', label: 'WILD WRITINGS', icon: 'M3 17.25V21h3.75L17.81 9.94l-3.75-3.75L3 17.25zM20.71 7.04a1 1 0 000-1.41l-2.34-2.34a1 1 0 00-1.41 0l-1.83 1.83 3.75 3.75 1.83-1.83z' },
];

const isActive = (href: string) => {
  if (currentPath === href) return true;
  if (href === '/wild-writings' && currentPath === '/wild-writings') return true;
  	  if (href === '/the-wild-times' && currentPath === '/the-wild-times') return true;
  	  if (href === '/artistas' && currentPath.startsWith('/artista')) return true;
  return false;
};
---

<aside id="sidebar" class="fixed top-0 left-[-288px] w-72 h-screen bg-[var(--bg)] border-r border-[var(--border)] z-[2000] transition-all duration-500 ease-[cubic-bezier(0.23,1,0.32,1)] flex flex-col" style="padding-bottom: 100px;">
  <div class="px-5 pt-5 flex flex-col h-full">

    <!-- Logo -->
    <div class="flex items-center justify-between mb-8">
      <a href="/" class="flex items-center gap-3">
        <img src="/wg_logo.png" alt="Wild Gvng" class="w-8 h-8 object-contain" />
        <span class="text-xl font-black tracking-tighter"><span class="text-[var(--primary)]">WILD</span> <span class="text-[var(--text)]">GVNG</span></span>
      </a>
      <button id="sidebar-close" class="p-2 text-[var(--text-muted)] hover:text-[var(--primary)] transition-colors">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>

    <!-- Nav -->
    <nav class="flex flex-col gap-0.5">
      {navItems.map(item => (
        <a href={item.href}
          class:list={[
            'flex items-center gap-3 py-2.5 px-3 rounded-lg text-xs font-bold uppercase tracking-wider transition-all',
            isActive(item.href)
              ? 'text-[var(--primary)] bg-[var(--primary-soft)]'
              : 'text-[var(--text-secondary)] hover:text-[var(--text)] hover:bg-[var(--bg-hover)]'
          ]}>
          {item.icon && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="flex-shrink-0 opacity-60"><path d={item.icon}/></svg>
          )}
          {!item.icon && <span class="w-[18px] h-[18px] flex-shrink-0"></span>}
          <span class="truncate">{item.label}</span>
        </a>
      ))}
    </nav>

    <!-- Spacer -->
    <div class="flex-1"></div>

    <!-- Bottom -->
    <div class="border-t border-[var(--border)] pt-4 pb-4 flex flex-col gap-1">
      <!-- Theme Toggle -->
      <div class="flex items-center justify-between py-2.5 px-3 rounded-lg">
        <div class="flex items-center gap-3">
          <svg id="theme-icon-dark" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0 opacity-60 text-[var(--text-secondary)]"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
          <svg id="theme-icon-light" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0 opacity-60 text-[var(--text-secondary)]" style="display:none;"><circle cx="12" cy="12" r="5"/><line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/><line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/><line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/><line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/></svg>
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)]">Tema</span>
        </div>
        <button id="theme-toggle" class="relative w-11 h-6 rounded-full bg-[var(--border)] transition-colors duration-300 focus:outline-none" aria-label="Cambiar tema">
          <span id="theme-toggle-dot" class="absolute top-0.5 left-0.5 w-5 h-5 rounded-full bg-[var(--primary)] transition-transform duration-300 shadow-md"></span>
        </button>
      </div>

      <a href="/login" class="flex items-center gap-3 py-2.5 px-3 rounded-lg text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] hover:text-[var(--text)] hover:bg-[var(--bg-hover)] transition-all">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0 opacity-60"><path d="M15 3h4a2 2 0 012 2v14a2 2 0 01-2 2h-4M10 17l5-5-5-5M15 12H3"/></svg>
        Entrar
      </a>
      <a href="/perfil" class="flex items-center gap-3 py-2.5 px-3 rounded-lg text-xs font-bold uppercase tracking-wider text-[var(--text-secondary)] hover:text-[var(--text)] hover:bg-[var(--bg-hover)] transition-all">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0 opacity-60"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        Mi Perfil
      </a>
      <a href="/configuracion" class:list={[
        'flex items-center gap-3 py-2.5 px-3 rounded-lg text-xs font-bold uppercase tracking-wider transition-all',
        currentPath === '/configuracion'
          ? 'text-[var(--primary)] bg-[var(--primary-soft)]'
          : 'text-[var(--text-secondary)] hover:text-[var(--text)] hover:bg-[var(--bg-hover)]'
      ]}>
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="flex-shrink-0 opacity-60"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 00.33 1.82l.06.06a2 2 0 010 2.83 2 2 0 01-2.83 0l-.06-.06a1.65 1.65 0 00-1.82-.33 1.65 1.65 0 00-1 1.51V21a2 2 0 01-4 0v-.09A1.65 1.65 0 009 19.4a1.65 1.65 0 00-1.82.33l-.06.06a2 2 0 01-2.83-2.83l.06-.06A1.65 1.65 0 004.68 15a1.65 1.65 0 00-1.51-1H3a2 2 0 010-4h.09A1.65 1.65 0 004.6 9a1.65 1.65 0 00-.33-1.82l-.06-.06a2 2 0 012.83-2.83l.06.06A1.65 1.65 0 009 4.68a1.65 1.65 0 001-1.51V3a2 2 0 014 0v.09a1.65 1.65 0 001 1.51 1.65 1.65 0 001.82-.33l.06-.06a2 2 0 012.83 2.83l-.06.06A1.65 1.65 0 0019.4 9a1.65 1.65 0 001.51 1H21a2 2 0 010 4h-.09a1.65 1.65 0 00-1.51 1z"/></svg>
        Configuración
      </a>
      <div class="text-center pt-3">
        <span class="text-[9px] font-bold tracking-[0.3em] text-[var(--text-muted)]">WILD GVNG © 2026</span>
      </div>
    </div>
  </div>
</aside>

	<script>
		// Theme toggle logic — fully self-contained, no library needed
		function initTheme() {
			const toggle = document.getElementById('theme-toggle');
			const dot = document.getElementById('theme-toggle-dot');
			const iconDark = document.getElementById('theme-icon-dark');
			const iconLight = document.getElementById('theme-icon-light');
			if (!toggle || !dot) return;

			function getTheme() {
				return document.documentElement.getAttribute('data-theme') || localStorage.getItem('wg-theme') || 'dark';
			}

			function updateIcons() {
				const isLight = getTheme() === 'light';
				if (iconDark) iconDark.style.display = isLight ? 'none' : 'block';
				if (iconLight) iconLight.style.display = isLight ? 'block' : 'none';
				dot.style.transform = isLight ? 'translateX(20px)' : 'translateX(0)';
			}

			function applyTheme(theme) {
				document.documentElement.classList.add('theme-transition');
				document.documentElement.setAttribute('data-theme', theme);
				localStorage.setItem('wg-theme', theme);
				updateIcons();
				setTimeout(() => document.documentElement.classList.remove('theme-transition'), 350);
			}

			updateIcons();

			toggle.addEventListener('click', () => {
				const current = getTheme();
				const newTheme = current === 'light' ? 'dark' : 'light';
				applyTheme(newTheme);
				// Sync to Supabase if logged in
				(async () => {
					try {
						const { createClient } = await import('@supabase/supabase-js');
						const url = import.meta.env.PUBLIC_SUPABASE_URL;
						const key = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
						if (!url || !key) return;
						const sb = createClient(url, key);
						const { data: { session } } = await sb.auth.getSession();
						if (session?.user) {
							await sb.from('user_settings').upsert({ user_id: session.user.id, theme: newTheme }, { onConflict: 'user_id' });
						}
					} catch (e) { /* silent */ }
				})();
			});
		}

		initTheme();
		document.addEventListener('astro:after-swap', initTheme);
	</script>
