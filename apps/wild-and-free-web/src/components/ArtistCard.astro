---
export type Props = {
  artist: {
    id: string;
    name: string;
    role: string;
    image_url: string;
  };
};

const { artist } = Astro.props;
---

<article class="card">
	<div class="media">
		<img src={artist.image_url} alt={artist.name} loading="lazy" />
		<div class="overlay">
			<p class="name">{artist.name}</p>
			<p class="role">{artist.role}</p>
		</div>
	</div>
</article>

<style>
	.card {
		border-radius: 18px;
		overflow: hidden;
		background: rgba(255, 255, 255, 0.03);
		border: 1px solid rgba(255, 255, 255, 0.06);
		transition:
			transform 160ms ease,
			border-color 160ms ease,
			box-shadow 160ms ease;
	}

	.media {
		position: relative;
		aspect-ratio: 1 / 1;
		overflow: hidden;
	}

	img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		transform: scale(1);
		transition: transform 240ms ease;
		filter: contrast(1.05) saturate(0.95);
	}

	.overlay {
		position: absolute;
		left: 0;
		right: 0;
		bottom: 0;
		padding: 14px 14px 12px;
		background: linear-gradient(to top, rgba(0, 0, 0, 0.82), rgba(0, 0, 0, 0));
	}

	.name {
		margin: 0;
		font-size: 16px;
		letter-spacing: -0.01em;
	}

	.role {
		margin: 2px 0 0;
		color: rgba(255, 255, 255, 0.72);
		font-size: 13px;
	}

	.card:hover {
		transform: translateY(-2px);
		border-color: color-mix(in srgb, var(--primary-color) 55%, rgba(255, 255, 255, 0.12) 45%);
		box-shadow:
			0 0 0 1px color-mix(in srgb, var(--primary-color) 55%, transparent 45%),
			0 18px 54px rgba(0, 0, 0, 0.6);
	}

	.card:hover img {
		transform: scale(1.06);
	}
</style>

