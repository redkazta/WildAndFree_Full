---
const { products = [] } = Astro.props;
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
  {products.map((product) => (
    <article class="group space-y-6">
      <div class="relative aspect-[3/4] overflow-hidden rounded-3xl bg-[#111] border border-white/5 group-hover:border-orange-500/30 transition-all duration-500">
        <img 
          src={product.image_url} 
          alt={product.name} 
          loading="lazy" 
          class="w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-110 transition-all duration-700"
        />
        
        <!-- Hover Overlay -->
        <div class="absolute inset-0 bg-black/80 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex flex-col items-center justify-center p-6 text-center space-y-6">
          <div class="space-y-4">
            <p class="text-white text-[10px] font-bold leading-relaxed uppercase tracking-wider line-clamp-3">
              {product.description}
            </p>
            <div class="flex justify-center gap-2">
              {product.atributos.tallas.map(talla => (
                <span class="w-8 h-8 rounded-lg border border-white/20 flex items-center justify-center text-[10px] font-black text-white">{talla}</span>
              ))}
            </div>
          </div>

          <!-- Quantity Selector -->
          <div class="flex items-center bg-white/10 rounded-xl p-1 border border-white/5">
            <button class="w-8 h-8 flex items-center justify-center text-white hover:text-orange-500 transition-colors qty-minus">-</button>
            <span class="px-4 text-[10px] font-black text-white qty-value">1</span>
            <button class="w-8 h-8 flex items-center justify-center text-white hover:text-orange-500 transition-colors qty-plus">+</button>
          </div>

          <div class="w-full space-y-2">
            <button class="add-to-cart-btn w-full py-4 rounded-2xl bg-orange-500 text-black text-[10px] font-black uppercase tracking-widest transition-all shadow-xl shadow-orange-500/20 hover:bg-white active:scale-95">
              Añadir al Carro
            </button>
            <button class="w-full py-3 rounded-xl bg-white/5 border border-white/10 text-white text-[9px] font-black uppercase tracking-widest hover:bg-white/10 transition-all">
              Ver Detalles
            </button>
          </div>
        </div>

        <!-- Top Right Actions -->
        <div class="absolute top-4 right-4 flex flex-col gap-2">
          <button class="wishlist-btn w-10 h-10 rounded-full bg-black/40 backdrop-blur-md border border-white/10 flex items-center justify-center text-white hover:text-red-500 transition-all transform hover:scale-110">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l8.94-8.94 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          </button>
        </div>
      </div>

<script>
  // Handle Quantity Controls
  document.querySelectorAll('.qty-plus').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const parent = (e.target as HTMLElement).parentElement;
      const valueEl = parent?.querySelector('.qty-value');
      if (valueEl) valueEl.textContent = (parseInt(valueEl.textContent!) + 1).toString();
    });
  });

  document.querySelectorAll('.qty-minus').forEach(btn => {
    btn.addEventListener('click', (e) => {
      const parent = (e.target as HTMLElement).parentElement;
      const valueEl = parent?.querySelector('.qty-value');
      if (valueEl) {
        const current = parseInt(valueEl.textContent!);
        if (current > 1) valueEl.textContent = (current - 1).toString();
      }
    });
  });

  // Handle Add to Cart Visual Sync
  document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const cartBadge = document.querySelector('[data-target="cart-popover"] span');
      if (cartBadge) {
        const current = parseInt(cartBadge.textContent!);
        cartBadge.textContent = (current + 1).toString();
        
        // Show visual feedback on button
        const originalText = btn.textContent;
        btn.textContent = '¡Agregado!';
        btn.classList.add('bg-green-500');
        setTimeout(() => {
          btn.textContent = originalText;
          btn.classList.remove('bg-green-500');
        }, 1500);
      }
    });
  });

  // Handle Wishlist Visual Sync
  document.querySelectorAll('.wishlist-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      const wishlistBadge = document.querySelector('[data-target="wishlist-popover"] span');
      if (wishlistBadge) {
        const current = parseInt(wishlistBadge.textContent!);
        wishlistBadge.textContent = (current + 1).toString();
        btn.classList.toggle('text-red-500');
        btn.classList.toggle('fill-red-500');
      }
    });
  });
</script>
      <div class="space-y-2 text-center">
        <h3 class="text-xl font-black uppercase tracking-tight text-white group-hover:text-orange-500 transition-colors">{product.name}</h3>
        <p class="text-orange-500 font-black tracking-tighter text-2xl">${product.price_base}</p>
      </div>
    </article>
  ))}
</div>
