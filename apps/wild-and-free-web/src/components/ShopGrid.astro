---
const products = [
  {
    name: "Core Hoodie",
    price: "$65.00",
    image: "https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&w=600&q=80"
  },
  {
    name: "Tour Tee",
    price: "$35.00",
    image: "https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?auto=format&fit=crop&w=600&q=80"
  },
  {
    name: "Beanie",
    price: "$25.00",
    image: "https://images.unsplash.com/photo-1576871337622-98d48d1cf531?auto=format&fit=crop&w=600&q=80"
  }
];
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
  {products.map((product) => (
    <article class="group space-y-6">
      <div class="relative aspect-[3/4] overflow-hidden rounded-3xl bg-[#111] border border-white/5 group-hover:border-orange-500/30 transition-all duration-500">
        <img 
          src={product.image} 
          alt={product.name} 
          loading="lazy" 
          class="w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-110 transition-all duration-700"
        />
        <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex items-center justify-center">
          <button class="px-8 py-4 rounded-full bg-white text-black text-xs font-black uppercase tracking-widest transform scale-90 group-hover:scale-100 transition-all duration-500 shadow-2xl hover:bg-orange-500">
            Añadir al Carro
          </button>
        </div>
      </div>
      <div class="space-y-1 text-center">
        <h3 class="text-lg font-black uppercase tracking-tight text-white group-hover:text-orange-500 transition-colors">{product.name}</h3>
        <p class="text-orange-500 font-black tracking-tighter text-xl">{product.price}</p>
      </div>
    </article>
  ))}
</div>

<style>
  /* Usando Tailwind */
</style>
