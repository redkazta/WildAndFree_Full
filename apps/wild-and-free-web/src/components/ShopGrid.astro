---
const { products = [] } = Astro.props;
---

<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-10">
  {products.map((product) => (
    <article class="group space-y-6">
      <div class="relative aspect-[3/4] overflow-hidden rounded-3xl bg-[#111] border border-white/5 group-hover:border-orange-500/30 transition-all duration-500">
        <img 
          src={product.image_url} 
          alt={product.name} 
          loading="lazy" 
          class="w-full h-full object-cover grayscale opacity-80 group-hover:grayscale-0 group-hover:opacity-100 group-hover:scale-110 transition-all duration-700"
        />
        <div class="absolute inset-0 bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity duration-500 flex flex-col items-center justify-center p-8 text-center space-y-4">
          <p class="text-white text-[10px] font-bold leading-relaxed uppercase tracking-wider line-clamp-3">
            {product.description}
          </p>
          <div class="flex gap-2">
            {product.atributos.tallas.map(talla => (
              <span class="w-8 h-8 rounded-lg border border-white/20 flex items-center justify-center text-[10px] font-black text-white">{talla}</span>
            ))}
          </div>
          <button class="w-full py-4 rounded-2xl bg-white text-black text-[10px] font-black uppercase tracking-widest transform scale-90 group-hover:scale-100 transition-all duration-500 shadow-2xl hover:bg-orange-500 hover:text-white">
            Añadir al Carro
          </button>
        </div>
      </div>
      <div class="space-y-2 text-center">
        <h3 class="text-xl font-black uppercase tracking-tight text-white group-hover:text-orange-500 transition-colors">{product.name}</h3>
        <p class="text-orange-500 font-black tracking-tighter text-2xl">${product.price_base}</p>
      </div>
    </article>
  ))}
</div>
