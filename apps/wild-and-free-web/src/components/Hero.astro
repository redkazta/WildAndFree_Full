---
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
		<!-- Animated Geometric Background Pattern -->
		<div class="absolute inset-0 z-0 bg-[var(--bg)]"></div>

	<div class="relative z-10 max-w-[1400px] mx-auto px-6 w-full grid lg:grid-cols-2 gap-8 lg:gap-24 items-center">
		<!-- Left Column - Content -->
		<div class="space-y-8 text-center lg:text-left order-2 lg:order-1">
			<!-- Badge -->
			<div class="inline-flex items-center gap-3 px-5 py-2.5 rounded-full bg-[var(--bg-card)] border border-[var(--border)]">
				<img src="/assets/wildgvng-logo.svg" alt="Wild Gvng Logo" class="w-6 h-6 object-contain" />
				<span class="text-xs font-black uppercase tracking-[0.2em] text-[var(--text-muted)]">DESDE 2018, TORREÓN, COAHUILA, MÉXICO</span>
			</div>

			<!-- Title -->
			<div class="space-y-3">
				<h1 class="text-5xl md:text-8xl lg:text-[9rem] font-black leading-[0.85] tracking-tighter">
					<span class="block text-[var(--text)]">WILD</span>
					<span class="block text-wild-orange">GVNG</span>
				</h1>
			</div>

			<!-- Wild And Free League segment -->
			<div class="inline-flex items-center gap-4 bg-[var(--bg-card)] border border-[var(--border)] rounded-2xl p-5 md:p-3 wg-league-card">
								<img src="/wild_and_free.jpg" alt="Wild And Free League" class="w-14 h-14 md:w-10 md:h-10 object-cover rounded-xl flex-shrink-0 wg-league-img" />
				<div class="text-left">
					<div class="text-[11px] font-black uppercase tracking-[0.2em] text-wild-orange mb-1">WILD AND FREE LEAGUE</div>
					<p class="text-sm text-[var(--text-secondary)] font-medium leading-relaxed max-w-md">
						Liga de Freestyle nacida en Torreón, Coahuila, México, 2018. Bosque Venustiano Carranza.
					</p>
				</div>
			</div>

			<!-- CTA Buttons -->
			<div class="flex flex-col sm:flex-row items-center justify-center lg:justify-start gap-3 sm:gap-5 pt-2">
				<a
					href="/artistas"
					class="group relative w-full sm:w-auto px-6 sm:px-10 py-3 sm:py-5 bg-wild-orange text-black text-sm font-black uppercase tracking-[0.15em] rounded-full overflow-hidden transition-all duration-300 transform hover:-translate-y-1 hover:shadow-2xl hover:shadow-wild-orange/30 text-center"
				>
					<span class="relative z-10">Explorar Crew</span>
					<div class="absolute inset-0 bg-white scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></div>
				</a>
				<a
					href="/musica"
					class="w-full sm:w-auto px-6 sm:px-10 py-3 sm:py-5 border border-[var(--border-strong)] text-[var(--text)] text-sm font-black uppercase tracking-[0.15em] rounded-full hover:bg-[var(--bg-card)] hover:border-wild-orange/50 transition-all duration-300 text-center"
				>
					Escuchar Música
				</a>
				<a
					href="/registro"
					class="w-full sm:w-auto px-6 sm:px-8 py-3 sm:py-4 bg-[var(--bg-card)] border border-[var(--border)] text-[var(--text-secondary)] text-xs font-black uppercase tracking-[0.15em] rounded-full hover:bg-wild-orange hover:text-black hover:border-wild-orange transition-all duration-300 text-center"
				>
					Únete a la Crew
				</a>
			</div>
		</div>

		<!-- Right Column - Logo Visual -->
		<div class="hidden lg:flex items-center justify-center order-1 lg:order-2">
			<div class="relative">
				<div class="relative w-[400px] h-[400px] xl:w-[480px] xl:h-[480px] rounded-wild-lg border border-[var(--border)] bg-[var(--bg-card)] flex items-center justify-center p-10 overflow-hidden group">
					<div class="absolute inset-4 rounded-wild-lg border border-wild-orange/10 group-hover:border-wild-orange/30 transition-all duration-700"></div>

					<div class="absolute top-0 left-0 w-12 h-[2px] bg-wild-orange/40"></div>
					<div class="absolute top-0 left-0 w-[2px] h-12 bg-wild-orange/40"></div>
					<div class="absolute top-0 right-0 w-12 h-[2px] bg-wild-orange/40"></div>
					<div class="absolute top-0 right-0 w-[2px] h-12 bg-wild-orange/40"></div>
					<div class="absolute bottom-0 left-0 w-12 h-[2px] bg-wild-orange/40"></div>
					<div class="absolute bottom-0 left-0 w-[2px] h-12 bg-wild-orange/40"></div>
					<div class="absolute bottom-0 right-0 w-12 h-[2px] bg-wild-orange/40"></div>
					<div class="absolute bottom-0 right-0 w-[2px] h-12 bg-wild-orange/40"></div>

					<img
						src="/wg_logo.png"
						alt="WILD GVNG Logo"
						width="480"
						height="480"
						class="w-full h-full object-contain relative z-10 drop-shadow-2xl group-hover:scale-105 transition-transform duration-700"
					/>
				</div>
			</div>
		</div>
	</div>


</section>
