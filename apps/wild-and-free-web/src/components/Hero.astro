---
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-20">
	<!-- Animated Geometric Background Pattern -->
	<div class="absolute inset-0 z-0">
		<!-- Dark base -->
		<div class="absolute inset-0 bg-black"></div>

		<!-- Subtle grid pattern -->
		<div class="absolute inset-0 bg-[linear-gradient(rgba(255,255,255,0.02)_1px,transparent_1px),linear-gradient(90deg,rgba(255,255,255,0.02)_1px,transparent_1px)] bg-[size:80px_80px]"></div>

		<!-- Gradient orbs -->
		<div class="absolute top-1/4 left-1/4 w-[500px] h-[500px] bg-wild-orange/10 blur-[150px] rounded-full animate-pulse"></div>
		<div class="absolute bottom-1/4 right-1/4 w-[500px] h-[500px] bg-wild-orange/5 blur-[150px] rounded-full animate-pulse delay-1000"></div>

		<!-- Diagonal accent lines -->
		<div class="absolute inset-0 overflow-hidden">
			<div class="absolute top-0 left-0 w-full h-full">
				<div class="absolute top-[15%] left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-wild-orange/20 to-transparent animate-gradient-shift"></div>
				<div class="absolute top-[35%] left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
				<div class="absolute top-[55%] left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-wild-orange/15 to-transparent animate-gradient-shift"></div>
				<div class="absolute top-[75%] left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-white/10 to-transparent"></div>
				<div class="absolute top-[90%] left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-wild-orange/10 to-transparent animate-gradient-shift"></div>
			</div>
		</div>

		<!-- Subtle diagonal stripes -->
		<div class="absolute inset-0 bg-[repeating-linear-gradient(45deg,transparent,transparent_40px,rgba(201,131,0,0.015)_40px,rgba(201,131,0,0.015)_41px)]"></div>
	</div>

	<div class="relative z-10 max-w-[1400px] mx-auto px-6 w-full grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
		<!-- Left Column - Content -->
		<div class="space-y-10 text-center lg:text-left order-2 lg:order-1">
			<!-- Badge -->
			<div class="inline-flex items-center gap-4 px-5 py-2.5 rounded-full bg-white/[0.03] border border-white/10 backdrop-blur-md">
				<img src="/assets/wildgvng-logo.svg" alt="Wild Gvng Logo" class="w-7 h-7 object-contain" />
				<span class="relative flex h-2 w-2">
					<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-wild-orange opacity-75"></span>
					<span class="relative inline-flex rounded-full h-2 w-2 bg-wild-orange"></span>
				</span>
				<span class="text-xs font-black uppercase tracking-[0.25em] text-white/70">Est. 2024 · La Liga Original</span>
			</div>

			<!-- Title -->
			<div class="space-y-3">
				<h1 class="text-7xl md:text-8xl lg:text-[9rem] font-black leading-[0.85] tracking-tighter">
					<span class="block text-white">WILD</span>
					<span class="block text-transparent bg-clip-text bg-gradient-to-r from-wild-orange via-amber-400 to-wild-orange bg-[length:200%_auto] animate-gradient-shift">GVNG</span>
				</h1>
				<p class="text-lg md:text-xl text-white/70 font-semibold max-w-xl mx-auto lg:mx-0 leading-relaxed">
					El movimiento que redefine la cultura urbana. Sonido crudo, libertad absoluta.
				</p>
			</div>

			<!-- CTA Buttons -->
			<div class="flex flex-wrap items-center justify-center lg:justify-start gap-5 pt-2">
				<a
					href="#artistas"
					class="group relative px-10 py-5 bg-wild-orange text-black text-sm font-black uppercase tracking-[0.15em] rounded-full overflow-hidden transition-all duration-300 transform hover:-translate-y-1 hover:shadow-2xl hover:shadow-wild-orange/30"
				>
					<span class="relative z-10">Explorar Crew</span>
					<div class="absolute inset-0 bg-white scale-x-0 group-hover:scale-x-100 transition-transform duration-300 origin-left"></div>
				</a>
				<a
					href="#music"
					class="px-10 py-5 border border-white/20 text-white text-sm font-black uppercase tracking-[0.15em] rounded-full hover:bg-white/5 hover:border-wild-orange/50 transition-all duration-300 backdrop-blur-sm"
				>
					Escuchar Música
				</a>
			</div>

			<!-- Stats Row -->
			<div class="flex flex-wrap items-center justify-center lg:justify-start gap-10 pt-4">
				<div class="text-center lg:text-left">
					<div class="text-3xl md:text-4xl font-black text-white leading-none">1,200+</div>
					<div class="text-xs font-bold text-white/40 uppercase tracking-[0.15em] mt-2">Members</div>
				</div>
				<div class="w-[1px] h-10 bg-white/10 hidden sm:block"></div>
				<div class="text-center lg:text-left">
					<div class="text-3xl md:text-4xl font-black text-wild-orange leading-none">50+</div>
					<div class="text-xs font-bold text-white/40 uppercase tracking-[0.15em] mt-2">Events</div>
				</div>
				<div class="w-[1px] h-10 bg-white/10 hidden sm:block"></div>
				<div class="text-center lg:text-left">
					<div class="text-3xl md:text-4xl font-black text-white leading-none">8</div>
					<div class="text-xs font-bold text-white/40 uppercase tracking-[0.15em] mt-2">Artists</div>
				</div>
			</div>
		</div>

		<!-- Right Column - Logo Visual -->
		<div class="hidden lg:flex items-center justify-center order-1 lg:order-2">
			<div class="relative">
				<!-- Glow behind logo -->
				<div class="absolute inset-0 bg-wild-orange/20 blur-[100px] rounded-full scale-150 animate-pulse"></div>

				<!-- Logo container with border -->
				<div class="relative w-[400px] h-[400px] xl:w-[480px] xl:h-[480px] rounded-wild-lg border border-white/10 bg-white/[0.02] backdrop-blur-xl flex items-center justify-center p-10 overflow-hidden group">
					<!-- Inner border accent -->
					<div class="absolute inset-4 rounded-wild-lg border border-wild-orange/10 group-hover:border-wild-orange/30 transition-all duration-700"></div>

					<!-- Corner accents -->
					<div class="absolute top-0 left-0 w-12 h-[2px] bg-gradient-to-r from-wild-orange to-transparent"></div>
					<div class="absolute top-0 left-0 w-[2px] h-12 bg-gradient-to-b from-wild-orange to-transparent"></div>
					<div class="absolute top-0 right-0 w-12 h-[2px] bg-gradient-to-l from-wild-orange to-transparent"></div>
					<div class="absolute top-0 right-0 w-[2px] h-12 bg-gradient-to-b from-wild-orange to-transparent"></div>
					<div class="absolute bottom-0 left-0 w-12 h-[2px] bg-gradient-to-r from-wild-orange to-transparent"></div>
					<div class="absolute bottom-0 left-0 w-[2px] h-12 bg-gradient-to-t from-wild-orange to-transparent"></div>
					<div class="absolute bottom-0 right-0 w-12 h-[2px] bg-gradient-to-l from-wild-orange to-transparent"></div>
					<div class="absolute bottom-0 right-0 w-[2px] h-12 bg-gradient-to-t from-wild-orange to-transparent"></div>

					<img
						src="/wg_logo.png"
						alt="WILD GVNG Logo"
						width="480"
						height="480"
						class="w-full h-full object-contain relative z-10 drop-shadow-2xl group-hover:scale-105 transition-transform duration-700"
					/>
				</div>

				<!-- Floating stat badges -->
				<div class="absolute -top-4 -right-4 bg-black/80 border border-wild-orange/30 backdrop-blur-xl rounded-xl px-5 py-3 shadow-2xl">
					<div class="text-2xl font-black text-wild-orange leading-none">#1</div>
					<div class="text-[10px] font-bold text-white/50 uppercase tracking-[0.1em] mt-1">Urbano</div>
				</div>
				<div class="absolute -bottom-4 -left-4 bg-black/80 border border-white/10 backdrop-blur-xl rounded-xl px-5 py-3 shadow-2xl">
					<div class="flex items-center gap-2">
						<div class="flex -space-x-1">
							<div class="w-5 h-5 rounded-full bg-wild-orange/30 border border-wild-orange/50 flex items-center justify-center text-[8px] font-black text-wild-orange">WG</div>
						</div>
						<span class="text-[10px] font-bold text-white/60 uppercase tracking-[0.1em]">La Liga</span>
					</div>
				</div>
			</div>
		</div>
	</div>

	<!-- Scroll Indicator -->
	<div class="absolute bottom-10 left-1/2 -translate-x-1/2 flex flex-col items-center gap-3">
		<div class="w-[1px] h-16 bg-gradient-to-b from-transparent via-white/20 to-wild-orange animate-scroll-down"></div>
		<span class="text-[10px] font-bold text-white/20 uppercase tracking-[0.3em]">Scroll</span>
	</div>
</section>
