---
export type Props = {
  crewName: string;
};

const { crewName } = Astro.props;
---

<section class="hero">
	<div class="banner-bg"></div>
	<div class="content">
		<p class="tag">Musicians Hub</p>
		<h1 class="title" data-text={crewName}>{crewName}</h1>
		<p class="subtitle">Oscuro. Minimalista. Creado para moverse como uno.</p>
		<div class="actions">
			<a class="button" href="#artists">
				<span>Explorar Crew</span>
			</a>
		</div>
	</div>
</section>

<style>
	.hero {
		min-height: 90vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding: 120px 0 60px;
		position: relative;
		overflow: hidden;
	}

	.banner-bg {
		position: absolute;
		inset: 0;
		background-image: url('https://images.unsplash.com/photo-1493225255756-d9584f8606e9?auto=format&fit=crop&w=2000&q=80');
		background-size: cover;
		background-position: center;
		filter: grayscale(100%) contrast(1.2) brightness(0.4);
		z-index: -2;
	}

	.hero::after {
		content: '';
		position: absolute;
		inset: 0;
		background: linear-gradient(to bottom, rgba(5,5,5,0.3), #050505);
		z-index: -1;
	}

	.content {
		position: relative;
		z-index: 1;
		max-width: 1400px;
		margin: 0 auto;
		width: 100%;
		padding: 0 24px;
	}

	.tag {
		margin: 0 0 24px;
		letter-spacing: 0.4em;
		text-transform: uppercase;
		color: var(--primary-color);
		font-size: 11px;
		font-weight: 700;
	}

	.title {
		margin: 0;
		font-size: clamp(64px, 12vw, 180px);
		line-height: 0.85;
		letter-spacing: -0.06em;
		text-transform: uppercase;
		font-weight: 900;
		color: transparent;
		-webkit-text-stroke: 1px rgba(255, 255, 255, 0.4);
		position: relative;
		z-index: 1;
	}
	
	.title::before {
		content: attr(data-text);
		position: absolute;
		top: 0;
		left: 0;
		color: #fff;
		opacity: 0.1;
		filter: blur(12px);
		z-index: -1;
	}

	.subtitle {
		margin: 32px 0 0;
		color: #888;
		font-size: 18px;
		max-width: 40ch;
		line-height: 1.5;
		font-weight: 300;
	}

	.actions {
		margin-top: 48px;
	}

	.button {
		display: inline-flex;
		align-items: center;
		justify-content: center;
		padding: 16px 32px;
		text-decoration: none;
		color: #000;
		background: var(--primary-color);
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		font-size: 14px;
		clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
		transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
	}

	.button:hover {
		transform: translateY(-2px);
		box-shadow: 0 10px 30px -10px var(--primary-color);
		filter: brightness(1.1);
	}
</style>
