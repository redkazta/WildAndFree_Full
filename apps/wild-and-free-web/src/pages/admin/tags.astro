---
import Layout from '../../layouts/Layout.astro';

// Para la página de admin, vamos a hacer la verificación en el cliente
// para evitar problemas con los imports asíncronos en el frontmatter
---

<Layout config={{
  name: "Admin - Gestión de Tags",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>
  <div class="min-h-screen bg-black text-white">
    <div class="container mx-auto px-4 py-8">
      <h1 class="text-3xl font-bold mb-8">Gestión de Tags</h1>
      
      <!-- Sección de Tags -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold mb-6">Tags Disponibles</h2>
        <div id="tags-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          <!-- Los tags se cargarán dinámicamente aquí -->
        </div>
      </section>

      <!-- Sección de Usuarios -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold mb-6">Usuarios con Tags</h2>
        <div class="overflow-x-auto">
          <table class="w-full bg-gray-900 rounded-lg">
            <thead>
              <tr class="border-b border-gray-700">
                <th class="text-left p-4">Usuario</th>
                <th class="text-left p-4">Rol</th>
                <th class="text-left p-4">Tags</th>
                <th class="text-left p-4">Acciones</th>
              </tr>
            </thead>
            <tbody id="users-table-body">
              <!-- Los usuarios se cargarán dinámicamente aquí -->
            </tbody>
          </table>
        </div>
      </section>

      <!-- Formulario para crear nuevo tag -->
      <section class="mb-12">
        <h2 class="text-2xl font-bold mb-6">Crear Nuevo Tag</h2>
        <form id="create-tag-form" class="bg-gray-900 p-6 rounded-lg">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-4">
            <div>
              <label class="block text-sm font-medium mb-2">Nombre del Tag</label>
              <input 
                type="text" 
                id="tag-name" 
                class="w-full p-2 bg-gray-800 border border-gray-600 rounded focus:outline-none focus:border-wild-orange"
                required
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2">Color</label>
              <input 
                type="color" 
                id="tag-color" 
                class="w-full h-10 bg-gray-800 border border-gray-600 rounded"
                value="#C98300"
              />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2">Animación</label>
              <select 
                id="tag-animation" 
                class="w-full p-2 bg-gray-800 border border-gray-600 rounded focus:outline-none focus:border-wild-orange"
              >
                <option value="none">Ninguna</option>
                <option value="pulse">Pulso</option>
                <option value="bounce">Rebote</option>
                <option value="glow">Brillo</option>
              </select>
            </div>
          </div>
          <button 
            type="submit" 
            class="bg-orange-600 hover:bg-orange-700 text-white font-bold py-2 px-4 rounded transition-colors"
          >
            Crear Tag
          </button>
        </form>
      </section>
    </div>
  </div>
</Layout>

<script>
  import { getAllTags, createTag, deleteTag, getUsersWithTags, assignTagToUser } from '../../lib/tags-admin-gateway.js';
  import { supabase } from '../../lib/supabase.js';

  interface Tag {
    id: number;
    name: string;
    color: string;
    animation: string;
  }

  interface UserWithTags {
    id: string;
    username: string;
    full_name: string;
    role: string;
    tags: Tag[];
  }

  let allTagsData: Tag[] = [];
  let usersData: UserWithTags[] = [];

  // Función para cargar datos iniciales
  async function loadInitialData() {
    try {
      // Verificar autenticación primero
      const { data: { session } } = await supabase.auth.getSession();

      if (!session) {
        window.location.href = '/login';
        return;
      }

      // Verificar rol de admin
      const { data: profile } = await supabase
        .from('profiles')
        .select('role')
        .eq('id', session.user.id)
        .single();

      const roleId = parseInt(profile?.role || '0');
      if (roleId < 1 || roleId > 11) {
        window.location.href = '/perfil';
        return;
      }

      // Cargar tags
      const tagsResponse = await getAllTags();
      allTagsData = tagsResponse.tags || [];
      renderTagsList();

      // Cargar usuarios
      const usersResponse = await getUsersWithTags();
      usersData = usersResponse.users || [];
      renderUsersTable();
    } catch (error) {
      console.error('Error loading initial data:', error);
      alert('Error al cargar los datos');
    }
  }

  // Función para renderizar la lista de tags
  function renderTagsList() {
    const container = document.getElementById('tags-container');
    if (!container) return;

    if (!allTagsData || allTagsData.length === 0) {
      container.innerHTML = '<p class="text-white/60">No hay tags disponibles</p>';
      return;
    }

    container.innerHTML = allTagsData.map(tag => `
      <div class="bg-gray-900 p-4 rounded-lg border border-gray-700">
        <div class="flex items-center justify-between mb-2">
          <h3 class="font-bold" style="color: ${tag.color}">${tag.name}</h3>
          <button 
            onclick="deleteTag(${tag.id})" 
            class="text-red-500 hover:text-red-400 text-sm"
          >
            Eliminar
          </button>
        </div>
        <div class="text-sm text-white/60 mb-2">Animación: ${tag.animation}</div>
        <div class="flex items-center gap-2">
          <div 
            class="w-4 h-4 rounded-full" 
            style="background-color: ${tag.color}"
          ></div>
          <span class="text-xs text-white/60">${tag.color}</span>
        </div>
      </div>
    `).join('');
  }

  // Función para renderizar la tabla de usuarios
  function renderUsersTable() {
    const tbody = document.getElementById('users-table-body');
    if (!tbody) return;

    if (!usersData || usersData.length === 0) {
      tbody.innerHTML = '<tr><td colspan="4" class="text-center py-4 text-white/60">No hay usuarios</td></tr>';
      return;
    }

    tbody.innerHTML = usersData.map(user => `
      <tr class="border-b border-white/10">
        <td class="py-2">
          <div>
            <div class="font-bold">${user.full_name || user.username}</div>
            <div class="text-xs text-white/60">@${user.username}</div>
          </div>
        </td>
        <td class="py-2">
          <span class="text-xs bg-white/10 px-2 py-1 rounded">
            ${user.role || 'fan'}
          </span>
        </td>
        <td class="py-2">
          <div class="flex flex-wrap gap-1">
            ${user.tags?.map(tag => `
              <span 
                class="text-xs px-2 py-1 rounded"
                style="background-color: ${tag.color}20; color: ${tag.color};"
              >
                ${tag.name}
              </span>
            `).join('') || ''}
            ${(!user.tags || user.tags.length === 0) ? (
              '<span class="text-xs text-white/60">Sin tags</span>'
            ) : ''}
          </div>
        </td>
        <td class="py-2">
          <button 
            class="text-wild-orange hover:text-orange-400 text-xs"
            onclick="showAssignModal('${user.id}', '${user.username}')"
          >
            Asignar Tag
          </button>
        </td>
      </tr>
    `).join('');
  }

  // Función para mostrar modal de asignación
  // @ts-ignore
  window.showAssignModal = function(userId: string, username: string) {
    const tagOptions = allTagsData.map(tag => `
      <option value="${tag.id}">${tag.name}</option>
    `).join('');

    const modal = document.createElement('div');
    modal.className = 'fixed inset-0 bg-black/80 flex items-center justify-center z-50';
    modal.innerHTML = `
      <div class="bg-gray-900 p-6 rounded-lg max-w-md w-full mx-4">
        <h3 class="text-xl font-bold mb-4">Asignar Tag a @${username}</h3>
        <div class="mb-4">
          <label class="block text-sm font-medium mb-2">Seleccionar Tag</label>
          <select id="assign-tag-select" class="w-full p-2 bg-gray-800 border border-gray-600 rounded">
            ${tagOptions}
          </select>
        </div>
        <div class="flex gap-2">
          <button 
            onclick="assignTag('${userId}')" 
            class="flex-1 bg-orange-600 hover:bg-orange-700 text-white font-bold py-2 px-4 rounded"
          >
            Asignar
          </button>
          <button 
            onclick="this.closest('.fixed').remove()" 
            class="flex-1 bg-gray-700 hover:bg-gray-600 text-white font-bold py-2 px-4 rounded"
          >
            Cancelar
          </button>
        </div>
      </div>
    `;
    document.body.appendChild(modal);
  }

  // Función para asignar tag
  // @ts-ignore
  window.assignTag = async function(userId: string) {
    const select = document.getElementById('assign-tag-select') as HTMLSelectElement;
    if (!select) return;
    const tagId = select.value;
    
    try {
      await assignTagToUser(userId, parseInt(tagId));
      alert('Tag asignado exitosamente');
      const modal = document.querySelector('.fixed');
      if (modal) modal.remove();
      await loadInitialData(); // Recargar datos
    } catch (error) {
      console.error('Error assigning tag:', error);
      alert('Error al asignar el tag');
    }
  }

  // Función para eliminar tag
  // @ts-ignore
  window.deleteTag = async function(tagId: number) {
    if (!confirm('¿Estás seguro de eliminar este tag?')) return;
    
    try {
      await deleteTag(tagId);
      alert('Tag eliminado exitosamente');
      await loadInitialData(); // Recargar datos
    } catch (error) {
      console.error('Error deleting tag:', error);
      alert('Error al eliminar el tag');
    }
  }

  // Event listener para el formulario de creación
  document.getElementById('create-tag-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const nameInput = document.getElementById('tag-name') as HTMLInputElement;
    const colorInput = document.getElementById('tag-color') as HTMLInputElement;
    const animationInput = document.getElementById('tag-animation') as HTMLSelectElement;

    if (!nameInput || !colorInput || !animationInput) return;

    const name = nameInput.value;
    const color = colorInput.value;
    const animation = animationInput.value;
    
    try {
      await createTag({ name, color, animation });
      alert('Tag creado exitosamente');
      
      // Reset form
      const form = e.target as HTMLFormElement;
      form.reset();
      
      await loadInitialData(); // Recargar datos
    } catch (error) {
      console.error('Error creating tag:', error);
      alert('Error al crear el tag');
    }
  });

  // Cargar datos al inicio
  loadInitialData();

</script>
