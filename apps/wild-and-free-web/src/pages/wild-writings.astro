---
import Layout from '../layouts/Layout.astro';

const config = {
  name: "Wild Gvng - Wild Writings",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
};
---

<Layout config={config}>
  <main class="min-h-screen bg-black pt-32 pb-20 px-6">
    <div class="max-w-[1400px] mx-auto space-y-20">
      <div class="space-y-4 text-center">
        <h1 class="text-6xl md:text-8xl font-black tracking-tighter text-white uppercase leading-none">
          WILD <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-red-600">WRITINGS</span>
        </h1>
        <p class="text-xl text-white font-bold uppercase tracking-[0.3em]">Liga de Escritas • Próximamente</p>
      </div>

      <div class="flex flex-col items-center justify-center py-40 border-2 border-dashed border-white/5 rounded-[4rem] bg-white/[0.02]">
        <div class="w-24 h-24 rounded-full bg-orange-500/10 flex items-center justify-center mb-8">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-500"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
        </div>
        <h2 class="text-3xl font-black text-white uppercase tracking-tighter mb-4">Arquivando la Pluma</h2>
        <p class="text-white/40 font-bold uppercase tracking-widest text-center max-w-md">Estamos preparando el escenario para las mejores batallas escritas de la escena. Mantente atento.</p>
      </div>
    </div>
  </main>
</Layout>
