---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Wild Writings",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};

const articles = [
  {
    id: 1,
    title: "LA PLUMA ES MÁS FUERTE",
    subtitle: "ANÁLISIS DE LA ÚLTIMA BATALLA ESCRITA",
    author: "ESCRITOR FANTASMA",
    date: "21.03.2024",
    content: "En un mundo dominado por el freestyle instantáneo, las batallas escritas resurgen como el arte supremo de la complejidad lírica. La noche de ayer en el Foro Underground presenciamos...",
    image: "https://images.unsplash.com/photo-1455390582262-044cdead277a?w=600&h=400&fit=crop",
    type: "RESEÑA"
  },
  {
    id: 2,
    title: "MANIFIESTO: ESTILO SALVAJE",
    subtitle: "FILOSOFÍA DE LA CALLE",
    author: "DESCONOCIDO",
    date: "20.03.2024",
    content: "No seguimos reglas, las creamos. El estilo salvaje no es solo una estética, es una forma de vida que rechaza la conformidad y abraza el caos controlado del entorno urbano.",
    image: "https://images.unsplash.com/photo-1517976487492-5750f3195933?w=600&h=800&fit=crop",
    type: "OPINIÓN"
  },
  {
    id: 3,
    title: "POESÍA DE ASFALTO",
    subtitle: "SELECCIÓN SEMANAL",
    author: "SABLE",
    date: "19.03.2024",
    content: "Luces de neón parpadean / ritmos rotos en la acera / la ciudad respira humo / y exhala quimeras. Una colección de versos encontrados en las paredes del metro.",
    type: "POESÍA"
  },
  {
    id: 4,
    title: "BATTLE LEAGUE: NUEVAS REGLAS",
    subtitle: "FORMATO 2024",
    author: "ADMIN",
    date: "18.03.2024",
    content: "Se acabaron los límites de tiempo. 3 rondas. Sin censura. Solo barras puras y duras. El nuevo formato busca premiar la creatividad sobre la agresividad vacía.",
    image: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=600&h=600&fit=crop",
    type: "NOTICIAS"
  }
];
---

<Layout config={config}>
  <div class="min-h-screen bg-[#e5e5e5] pb-20 px-4 md:px-8 relative overflow-hidden font-mono text-black">
    
    <!-- Paper Texture Overlay -->
    <div class="fixed inset-0 pointer-events-none opacity-40 mix-blend-multiply z-0" style="background-image: url('https://www.transparenttextures.com/patterns/cardboard-flat.png');"></div>

    <div class="max-w-[1200px] mx-auto relative z-10">
      
      <!-- Masthead -->
      <header class="border-b-4 border-black mb-12 pb-4 text-center">
        <div class="flex justify-between items-end border-b-2 border-black pb-2 mb-2">
           <span class="text-xs font-bold uppercase tracking-widest">VOL. 24</span>
           <span class="text-xs font-bold uppercase tracking-widest">EST. 2024</span>
           <span class="text-xs font-bold uppercase tracking-widest">PRECIO: GRATIS</span>
        </div>
        <h1 class="text-6xl md:text-9xl font-black tracking-tighter uppercase leading-none transform scale-y-110">
          THE WILD TIMES
        </h1>
        <div class="flex justify-center items-center gap-4 mt-2 border-t-2 border-black pt-2">
           <span class="bg-black text-white px-2 py-1 text-sm font-bold uppercase">FANZINE OFICIAL</span>
           <span class="font-bold uppercase tracking-widest text-sm">VOZ DE LA CALLE • TINTA Y SANGRE</span>
        </div>
      </header>

      <!-- Grid Layout -->
      <div class="grid grid-cols-1 md:grid-cols-12 gap-8">
        
        <!-- Main Lead Article (Left Col) -->
        <article class="md:col-span-8 border-r-0 md:border-r-2 border-black pr-0 md:pr-8 space-y-6">
           <div class="relative group cursor-pointer">
              <div class="absolute inset-0 bg-[var(--street-accent)] translate-x-2 translate-y-2 group-hover:translate-x-1 group-hover:translate-y-1 transition-transform"></div>
              <img src={articles[0].image} class="relative w-full h-[400px] object-cover grayscale contrast-125 border-2 border-black z-10" />
              <div class="absolute top-4 left-4 z-20 bg-white border-2 border-black px-3 py-1 -rotate-2 shadow-[2px_2px_0px_black]">
                 <span class="font-black text-xs uppercase">{articles[0].type}</span>
              </div>
           </div>
           
           <div class="space-y-4">
              <h2 class="text-5xl font-black uppercase leading-[0.9] tracking-tighter hover:text-[var(--street-accent)] transition-colors cursor-pointer">
                 {articles[0].title}
              </h2>
              <div class="flex items-center gap-4 text-sm font-bold border-y border-black py-2">
                 <span>POR {articles[0].author}</span>
                 <span>///</span>
                 <span>{articles[0].date}</span>
              </div>
              <p class="text-lg leading-relaxed font-serif">
                 <span class="text-4xl float-left mr-2 font-black">E</span>{articles[0].content}
              </p>
              <button class="bg-black text-white px-6 py-2 font-bold uppercase hover:bg-[var(--street-accent)] hover:text-black border-2 border-transparent hover:border-black transition-colors">
                 LEER ARTÍCULO COMPLETO ->
              </button>
           </div>
        </article>

        <!-- Sidebar (Right Col) -->
        <aside class="md:col-span-4 space-y-12">
           
           <!-- Poetry Corner -->
           <div class="bg-white border-2 border-black p-6 shadow-[8px_8px_0px_black] rotate-1">
              <h3 class="text-2xl font-black uppercase mb-4 border-b-2 border-black pb-2 bg-[var(--street-accent)] inline-block px-2 transform -skew-x-12">
                 {articles[2].title}
              </h3>
              <p class="font-serif italic text-lg leading-relaxed mb-4">
                 "{articles[2].content}"
              </p>
              <div class="text-right font-bold text-sm">— {articles[2].author}</div>
           </div>

           <!-- Opinion Piece -->
           <div class="space-y-4">
              <div class="relative overflow-hidden border-2 border-black h-48">
                 <img src={articles[1].image} class="w-full h-full object-cover grayscale contrast-150" />
                 <div class="absolute inset-0 bg-[var(--street-accent)] mix-blend-multiply opacity-50"></div>
              </div>
              <h3 class="text-3xl font-black uppercase leading-none hover:underline decoration-4 decoration-[var(--street-accent)] cursor-pointer">
                 {articles[1].title}
              </h3>
              <p class="text-sm font-bold leading-tight">
                 {articles[1].content}
              </p>
           </div>

           <!-- Ad / Wanted -->
           <div class="border-4 border-black border-dashed p-4 text-center space-y-4 bg-yellow-100 transform -rotate-1">
              <h4 class="text-4xl font-black uppercase">WANTED</h4>
              <p class="font-bold text-sm">BUSCAMOS ESCRITORES, POETAS Y CRÍTICOS.</p>
              <div class="w-full h-px bg-black"></div>
              <p class="font-mono text-xs">ENVÍA TU PORTAFOLIO A:<br/>WRITE@WILDGVNG.COM</p>
           </div>

        </aside>

      </div>

      <!-- Bottom Grid -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-12 pt-12 border-t-4 border-black">
         {articles.slice(3).map(article => (
            <div class="space-y-4">
               <div class="border-2 border-black p-1">
                  <img src={article.image} class="w-full h-48 object-cover grayscale" />
               </div>
               <h4 class="text-2xl font-black uppercase leading-none">{article.title}</h4>
               <p class="text-sm font-serif">{article.content}</p>
            </div>
         ))}
         
         <div class="col-span-1 md:col-span-2 bg-black text-white p-8 flex flex-col justify-center items-center text-center space-y-4">
            <h3 class="text-4xl font-black uppercase text-[var(--street-accent)]">SUSCRÍBETE AL CAOS</h3>
            <p class="max-w-md text-sm text-gray-400">RECIBE LA EDICIÓN IMPRESA Y ACCESO ANTICIPADO A BATALLAS.</p>
            <div class="flex w-full max-w-sm border-2 border-white">
               <input type="email" placeholder="TU EMAIL" class="flex-1 bg-transparent px-4 py-2 outline-none text-white placeholder-gray-600 font-mono" />
               <button class="bg-white text-black px-6 py-2 font-bold uppercase hover:bg-[var(--street-accent)] transition-colors">ENVIAR</button>
            </div>
         </div>
      </div>

    </div>
  </div>
</Layout>

<style define:vars={{ streetAccent: tenant.primary_color }}>
  :root {
    --street-accent: var(--streetAccent);
  }
</style>
