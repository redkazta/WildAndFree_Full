---
import Layout from '../layouts/Layout.astro';
---

<Layout config={{
  name: "Wild Gvng - Admin Dashboard",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>
  <main class="admin-shell">
    <section id="admin-ok" class="hidden">
      <div class="admin-card">
        <h1 class="admin-title">Admin Dashboard</h1>
        <p class="admin-subtitle">Acceso autorizado.</p>
      </div>
    </section>

    <section id="admin-denied" class="hidden">
      <div class="admin-card admin-card--danger">
        <h1 class="admin-title">Acceso denegado</h1>
        <p class="admin-warning">No eres admin para ver esta página, vete inmediatamente o te voy a banear</p>
        <a class="admin-back" href="/">Regresar</a>
      </div>
    </section>
  </main>
</Layout>

<style>
  .admin-shell {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
    background: #000;
  }

  .admin-card {
    width: 100%;
    max-width: 680px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 28px;
    padding: 48px 40px;
    text-align: center;
    backdrop-filter: blur(18px);
  }

  .admin-card--danger {
    border-color: rgba(255, 0, 0, 0.18);
    box-shadow: 0 30px 80px rgba(255, 0, 0, 0.06);
  }

  .admin-title {
    margin: 0;
    color: #fff;
    font-size: 28px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .admin-subtitle {
    margin: 14px 0 0 0;
    color: rgba(255, 255, 255, 0.55);
    font-size: 12px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.18em;
  }

  .admin-warning {
    margin: 16px 0 0 0;
    color: rgba(255, 120, 120, 0.95);
    font-size: 12px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    line-height: 1.6;
  }

  .admin-back {
    display: inline-block;
    margin-top: 22px;
    padding: 14px 18px;
    border-radius: 16px;
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.12);
    color: #fff;
    font-size: 10px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    transition: background 0.2s ease, border-color 0.2s ease;
  }

  .admin-back:hover {
    background: rgba(201, 131, 0, 0.2);
    border-color: rgba(201, 131, 0, 0.4);
  }
</style>

<script>
  import { getRole } from '../lib/role.js'

  const ok = document.getElementById('admin-ok')
  const denied = document.getElementById('admin-denied')

  const show = (el) => el?.classList.remove('hidden')

  try {
    const { role } = await getRole()
    if (role === 'admin') show(ok)
    else show(denied)
  } catch {
    show(denied)
  }
</script>
