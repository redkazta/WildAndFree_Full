---
import Layout from '../layouts/Layout.astro';

const artists = [
  {
    id: 1,
    name: 'Lil Kiro',
    image: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=400&h=400&fit=crop&crop=face',
    genre: 'Trap',
    followers: '2.1M',
    tracks: 24
  },
  {
    id: 2,
    name: 'Neon Ghost',
    image: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&fit=crop&crop=face',
    genre: 'Drill',
    followers: '1.8M',
    tracks: 18
  },
  {
    id: 3,
    name: 'Tokyo Rose',
    image: 'https://images.unsplash.com/photo-1438761681033-6461ffad8d80?w=400&h=400&fit=crop&crop=face',
    genre: 'R&B',
    followers: '3.2M',
    tracks: 31
  },
  {
    id: 4,
    name: 'Shadow V',
    image: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=400&h=400&fit=crop&crop=face',
    genre: 'Hip Hop',
    followers: '1.5M',
    tracks: 15
  },
  {
    id: 5,
    name: 'Crystal Wave',
    image: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=400&h=400&fit=crop&crop=face',
    genre: 'Electronic',
    followers: '890K',
    tracks: 12
  },
  {
    id: 6,
    name: 'Midnight Rider',
    image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=400&h=400&fit=crop&crop=face',
    genre: 'Trap',
    followers: '2.7M',
    tracks: 28
  }
];
---

<Layout config={{
  name: "Wild Gvng - Artistas",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>
  <main class="artists-page">
    <div class="page-header">
      <div class="container">
        <h1 class="page-title">
          <span class="title-line">NUESTROS</span>
          <span class="title-line">ARTISTAS</span>
        </h1>
        <p class="page-subtitle">El movimiento que redefine la cultura</p>
      </div>
    </div>

    <div class="container">
      <div class="artists-grid">
        {artists.map((artist) => (
          <div class="artist-card">
            <div class="artist-image">
              <img src={artist.image} alt={artist.name} />
              <div class="artist-overlay">
                <button class="play-btn" aria-label={`Reproducir ${artist.name}`}>
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>
              </div>
            </div>
            <div class="artist-info">
              <h3 class="artist-name">{artist.name}</h3>
              <p class="artist-genre">{artist.genre}</p>
              <div class="artist-stats">
                <span class="stat">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M8 8a3 3 0 1 0 0-6 3 3 0 0 0 0 6zm2-3a2 2 0 1 1-4 0 2 2 0 0 1 4 0zm4 8c0 1-1 1-1 1H3s-1 0-1-1 1-4 6-4 6 3 6 4zm-1-.004c-.001-.246-.154-.986-.832-1.664C11.516 10.68 10.289 10 8 10c-2.29 0-3.516.68-4.168 1.332-.678.678-.83 1.418-.832 1.664h10z"/>
                  </svg>
                  {artist.followers}
                </span>
                <span class="stat">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M11 6.64a1 1 0 0 0-1.243-.97l-1 .25A1 1 0 0 0 8 6.89v4.306A2.572 2.572 0 0 0 7 11c-.5 0-.974.134-1.338.377-.36.24-.662.628-.662 1.123s.301.883.662 1.123c.364.243.839.377 1.338.377.5 0 .974-.134 1.338-.377.36-.24.662-.628.662-1.123V8.89l4-1v-.256Z"/>
                  </svg>
                  {artist.tracks} tracks
                </span>
              </div>
              <div class="artist-actions">
                <button class="btn-follow">Seguir</button>
                <button class="btn-play">Escuchar</button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
</Layout>

<style>
  .artists-page {
    min-height: 100vh;
    padding-top: 80px;
  }

  .page-header {
    background: linear-gradient(135deg, #000 0%, #111 100%);
    padding: 120px 0 80px;
    text-align: center;
    border-bottom: 1px solid rgba(201, 131, 0, 0.3);
  }

  .page-title {
    font-size: clamp(60px, 10vw, 120px);
    font-weight: 900;
    margin: 0 0 24px;
    line-height: 0.8;
    letter-spacing: 0.05em;
    font-family: 'Noto Sans JP', sans-serif;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .title-line {
    display: block;
    color: transparent;
    -webkit-text-stroke: 2px rgba(255, 255, 255, 0.9);
  }

  .page-subtitle {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    font-weight: 300;
    letter-spacing: 0.05em;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .artists-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
    padding: 80px 0;
  }

  .artist-card {
    background: linear-gradient(135deg, #111 0%, #000 100%);
    border-radius: 8px;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    border: 1px solid rgba(201, 131, 0, 0.1);
  }

  .artist-card:hover {
    transform: translateY(-8px);
    border-color: rgba(201, 131, 0, 0.3);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
  }

  .artist-image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .artist-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .artist-card:hover .artist-image img {
    transform: scale(1.1);
  }

  .artist-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(201, 131, 0, 0.8) 0%, rgba(138, 3, 3, 0.8) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .artist-card:hover .artist-overlay {
    opacity: 1;
  }

  .play-btn {
    background: rgba(255, 255, 255, 0.9);
    border: none;
    border-radius: 50%;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: #000;
  }

  .play-btn:hover {
    transform: scale(1.1);
    background: #fff;
  }

  .artist-info {
    padding: 24px;
  }

  .artist-name {
    font-size: 24px;
    font-weight: 700;
    margin: 0 0 8px;
    color: #fff;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .artist-genre {
    color: var(--primary-color);
    font-size: 14px;
    margin: 0 0 16px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  .artist-stats {
    display: flex;
    gap: 16px;
    margin-bottom: 20px;
  }

  .stat {
    display: flex;
    align-items: center;
    gap: 6px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
  }

  .stat svg {
    opacity: 0.8;
  }

  .artist-actions {
    display: flex;
    gap: 12px;
  }

  .btn-follow,
  .btn-play {
    flex: 1;
    padding: 12px 16px;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .btn-follow {
    background: transparent;
    color: var(--primary-color);
    border: 1px solid var(--primary-color);
  }

  .btn-follow:hover {
    background: var(--primary-color);
    color: #000;
  }

  .btn-play {
    background: var(--primary-color);
    color: #000;
  }

  .btn-play:hover {
    background: #fff;
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .artists-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 24px;
      padding: 40px 0;
    }

    .page-header {
      padding: 80px 0 60px;
    }

    .artist-actions {
      flex-direction: column;
    }
  }
</style>