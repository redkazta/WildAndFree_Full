---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// Fetch artists from Supabase
let dbArtists = null;
try {
  const { data, error } = await supabase
    .from('artists')
    .select('*')
    .order('nombre');
  if (!error) dbArtists = data;
} catch (e) {
  console.warn('Could not fetch artists from Supabase during build.');
}

// Fallback to static artists if DB is empty or error
const artists = (dbArtists && dbArtists.length > 0) ? dbArtists : [
  {
    nombre: 'Lil Kiro',
    slug: 'lil-kiro',
    imagenes: { profile: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=800&q=80' },
    stats: { seguidores: '2.1M', oyentes: '1.2M' },
    bio: 'El pionero del trap en el desierto.'
  },
  {
    nombre: 'Neon Ghost',
    slug: 'neon-ghost',
    imagenes: { profile: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=800&q=80' },
    stats: { seguidores: '1.8M', oyentes: '900K' },
    bio: 'Misterio y drill futurista.'
  },
  {
    nombre: 'Shadow V',
    slug: 'shadow-v',
    imagenes: { profile: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=800&q=80' },
    stats: { seguidores: '1.5M', oyentes: '750K' },
    bio: 'Lírica consciente sobre ritmos lo-fi.'
  },
  {
    nombre: 'Crystal Wave',
    slug: 'crystal-wave',
    imagenes: { profile: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=800&q=80' },
    stats: { seguidores: '890K', oyentes: '1.1M' },
    bio: 'Fusión de synthwave con reggaetón.'
  },
  {
    nombre: 'Midnight Rider',
    slug: 'midnight-rider',
    imagenes: { profile: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=800&q=80' },
    stats: { seguidores: '2.7M', oyentes: '2.4M' },
    bio: 'Flow vieja escuela con agresividad.'
  },
  {
    nombre: 'Nova K',
    slug: 'nova-k',
    imagenes: { profile: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=800&q=80' },
    stats: { seguidores: '2.4M', oyentes: '1.8M' },
    bio: 'Reina del drill melódico.'
  },
  {
    nombre: 'Sable',
    slug: 'sable',
    imagenes: { profile: 'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=800&q=80' },
    stats: { seguidores: '1.2M', oyentes: '3.5M' },
    bio: 'Arquitecto de sonidos oscuros.'
  },
  {
    nombre: 'Storm Trooper',
    slug: 'storm-trooper',
    imagenes: { profile: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=800&q=80' },
    stats: { seguidores: '950K', oyentes: '600K' },
    bio: 'Energía pura de Gómez Palacio.'
  }
];

import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Artistas",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};
---

<Layout config={config}>
  <main class="min-h-screen bg-[#050505] pt-32 pb-20 px-6 relative overflow-hidden">
    <!-- Background Noise Pattern -->
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 20px 20px;"></div>

    <div class="max-w-[1400px] mx-auto space-y-16 relative z-10">
      
      <!-- Header Brutalista -->
      <div class="flex flex-col md:flex-row items-end gap-6 border-b-4 border-white pb-8">
        <h1 class="text-7xl md:text-9xl font-black tracking-tighter text-white uppercase leading-none" style="text-shadow: 4px 4px 0px var(--street-accent);">
          ROSTER
        </h1>
        <div class="flex flex-col mb-2">
           <span class="text-xl font-bold text-white bg-[var(--street-accent)] px-2 inline-block w-fit text-black">WILD GVNG</span>
           <span class="text-sm font-mono text-[#888] tracking-widest mt-1">EST. 2024 • WORLDWIDE</span>
        </div>
      </div>

      <!-- Grid de Artistas -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
        {artists.map((artist: any) => (
          <a href={`/artista/${artist.slug}`} class="group relative block bg-[#111] border-2 border-white hover:border-[var(--street-accent)] transition-all duration-300 hover:-translate-y-2 hover:shadow-[8px_8px_0px_var(--street-accent)]">
            
            <!-- Imagen -->
            <div class="aspect-[3/4] overflow-hidden relative border-b-2 border-white group-hover:border-[var(--street-accent)] transition-colors">
              <img 
                src={artist.imagenes?.profile || 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=800&q=80'} 
                alt={artist.nombre} 
                loading="lazy" 
                class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500"
              />
              <!-- Overlay Text on Image -->
              <div class="absolute top-4 left-4 bg-black/80 backdrop-blur-sm border border-white/20 px-3 py-1">
                 <span class="text-[10px] font-mono text-[var(--street-accent)] uppercase tracking-widest">VERIFICADO</span>
              </div>
            </div>

            <!-- Info Card -->
            <div class="p-6 relative bg-[#111]">
              <h3 class="text-3xl font-black uppercase tracking-tighter text-white mb-2 leading-none group-hover:text-[var(--street-accent)] transition-colors">
                {artist.nombre}
              </h3>
              
              <div class="w-full h-px bg-white/20 my-4 group-hover:bg-[var(--street-accent)]/50 transition-colors"></div>
              
              <div class="flex justify-between items-end">
                 <div class="flex flex-col">
                    <span class="text-[10px] font-bold text-[#666] uppercase tracking-widest mb-1">Oyentes</span>
                    <span class="text-lg font-black text-white font-mono">{artist.stats?.oyentes || '0'}</span>
                 </div>
                 <div class="w-8 h-8 bg-white text-black flex items-center justify-center group-hover:bg-[var(--street-accent)] transition-colors">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                 </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>

<style define:vars={{ streetAccent: tenant.primary_color }}>
  :root {
    --street-accent: var(--streetAccent);
  }
</style>
