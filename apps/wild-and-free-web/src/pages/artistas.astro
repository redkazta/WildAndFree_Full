const artists = (dbArtists && dbArtists.length > 0) ? dbArtists.map((a: any, i: number) => ({
    ...a,
    estilo: mockArtists[i % mockArtists.length].estilo,
    origen: mockArtists[i % mockArtists.length].origen,
    bio: mockArtists[i % mockArtists.length].bio
})) : mockArtists;

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Artistas",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};
---

<Layout config={config}>
  <div class="min-h-screen bg-black text-white font-sans selection:bg-[var(--wild-orange)] selection:text-black">
    
    <!-- HEADER SECTION -->
    <div class="relative py-20 px-4 overflow-hidden">
        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/dark-matter.png')] opacity-30"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-zinc-900 to-black opacity-90"></div>
        
        <div class="container mx-auto relative z-10 text-center">
            <h1 class="text-5xl md:text-8xl font-black uppercase tracking-tighter mb-4 text-transparent bg-clip-text bg-gradient-to-r from-white via-gray-400 to-gray-800">
                WILD ARTISTS
            </h1>
            <p class="text-sm md:text-lg text-gray-400 font-mono tracking-widest uppercase max-w-2xl mx-auto">
                Descubre el talento que está redefiniendo la escena urbana.
            </p>
        </div>
    </div>

    <!-- ARTIST GRID -->
    <div class="container mx-auto px-4 pb-20">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            {artists.map((artist: any) => (
                <a href={`/artista/${artist.slug}`} class="group relative block aspect-[3/4] overflow-hidden rounded-xl bg-zinc-900 transition-all duration-500 hover:-translate-y-2">
                    <!-- Image -->
                    <img 
                        src={artist.imagenes.profile} 
                        alt={artist.nombre}
                        class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-110"
                        loading="lazy"
                    />
                    
                    <!-- Overlay Gradient -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent opacity-60 group-hover:opacity-80 transition-opacity"></div>
                    
                    <!-- Content -->
                    <div class="absolute inset-0 p-6 flex flex-col justify-end transform translate-y-4 group-hover:translate-y-0 transition-transform duration-300">
                        <div class="w-10 h-1 bg-[var(--primary)] mb-4 w-0 group-hover:w-10 transition-all duration-500"></div>
                        
                        <h2 class="text-3xl font-black uppercase italic leading-none mb-1 text-white group-hover:text-[var(--primary)] transition-colors">
                            {artist.nombre}
                        </h2>
                        
                        <div class="flex items-center gap-2 text-[10px] font-bold tracking-widest uppercase text-gray-400">
                            <span>{artist.estilo}</span>
                            <span class="w-1 h-1 rounded-full bg-gray-600"></span>
                            <span>{artist.origen}</span>
                        </div>
                        
                        <p class="mt-4 text-xs text-gray-300 line-clamp-2 opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">
                            {artist.bio}
                        </p>
                    </div>
                    
                    <!-- Border Effect -->
                    <div class="absolute inset-0 border border-white/10 group-hover:border-[var(--primary)]/50 rounded-xl transition-colors pointer-events-none"></div>
                </a>
            ))}
        </div>
    </div>

  </div>
</Layout>
