---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

// --- DATA FETCHING ---
let dbArtists = null;
try {
  const { data, error } = await supabase
    .from('artists')
    .select('*')
    .order('nombre');
  if (!error) dbArtists = data;
} catch (e) {
  console.warn('Could not fetch artists from Supabase during build.');
}

// Fallback / Mock Data enriched with "Special Moves" (Tracks)
const mockArtists = [
  {
    id: 1,
    nombre: 'Lil Kiro',
    slug: 'lil-kiro',
    imagenes: { profile: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=800&q=80' },
    stats: { seguidores: '2.1M', oyentes: '1.2M', power: 95, speed: 88, technique: 92 },
    bio: 'El pionero del trap en el desierto.',
    tracks: ['Desert Storm', 'Sand King', 'Mirage Flow', 'Oasis Trap']
  },
  {
    id: 2,
    nombre: 'Neon Ghost',
    slug: 'neon-ghost',
    imagenes: { profile: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=800&q=80' },
    stats: { seguidores: '1.8M', oyentes: '900K', power: 85, speed: 98, technique: 90 },
    bio: 'Misterio y drill futurista.',
    tracks: ['Cyber City', 'Neon Nights', 'Digital Shadow', 'Glitch Mode']
  },
  {
    id: 3,
    nombre: 'Shadow V',
    slug: 'shadow-v',
    imagenes: { profile: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=800&q=80' },
    stats: { seguidores: '1.5M', oyentes: '750K', power: 78, speed: 85, technique: 96 },
    bio: 'Lírica consciente sobre ritmos lo-fi.',
    tracks: ['Lo-Fi Dreams', 'Silent Verse', 'Deep Thoughts', 'Vinyl Scratch']
  },
  {
    id: 4,
    nombre: 'Crystal Wave',
    slug: 'crystal-wave',
    imagenes: { profile: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=800&q=80' },
    stats: { seguidores: '890K', oyentes: '1.1M', power: 82, speed: 90, technique: 88 },
    bio: 'Fusión de synthwave con reggaetón.',
    tracks: ['Synth Love', 'Retro Beat', 'Wave Rider', 'Future Past']
  },
  {
    id: 5,
    nombre: 'Midnight Rider',
    slug: 'midnight-rider',
    imagenes: { profile: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=800&q=80' },
    stats: { seguidores: '2.7M', oyentes: '2.4M', power: 98, speed: 80, technique: 85 },
    bio: 'Flow vieja escuela con agresividad.',
    tracks: ['Night Cruise', 'Old School Rules', 'Engine Roar', 'Street Legend']
  },
  {
    id: 6,
    nombre: 'Nova K',
    slug: 'nova-k',
    imagenes: { profile: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=800&q=80' },
    stats: { seguidores: '2.4M', oyentes: '1.8M', power: 90, speed: 92, technique: 94 },
    bio: 'Reina del drill melódico.',
    tracks: ['Queen Flow', 'Drill Princess', 'Melodic Storm', 'Crown Jewel']
  },
  {
    id: 7,
    nombre: 'Sable',
    slug: 'sable',
    imagenes: { profile: 'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=800&q=80' },
    stats: { seguidores: '1.2M', oyentes: '3.5M', power: 88, speed: 95, technique: 98 },
    bio: 'Arquitecto de sonidos oscuros.',
    tracks: ['Dark Matter', 'Void Walker', 'Abyss Call', 'Shadow Realm']
  },
  {
    id: 8,
    nombre: 'Storm Trooper',
    slug: 'storm-trooper',
    imagenes: { profile: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=800&q=80' },
    stats: { seguidores: '950K', oyentes: '600K', power: 92, speed: 88, technique: 80 },
    bio: 'Energía pura de Gómez Palacio.',
    tracks: ['Thunder Strike', 'Lightning Speed', 'Storm Warning', 'Heavy Rain']
  },
  {
    id: 9,
    nombre: 'Viper X',
    slug: 'viper-x',
    imagenes: { profile: 'https://images.unsplash.com/photo-1615109398623-88346a601842?w=800&q=80' },
    stats: { seguidores: '3.1M', oyentes: '2.8M', power: 96, speed: 99, technique: 95 },
    bio: 'El veneno lírico más potente del norte.',
    tracks: ['Venom Bite', 'Snake Eyes', 'Poison Flow', 'Deadly Strike']
  },
  {
    id: 10,
    nombre: 'Luna Negra',
    slug: 'luna-negra',
    imagenes: { profile: 'https://images.unsplash.com/photo-1517423568366-69755581d826?w=800&q=80' },
    stats: { seguidores: '1.9M', oyentes: '2.2M', power: 85, speed: 90, technique: 92 },
    bio: 'Voces etéreas sobre bajos pesados.',
    tracks: ['Moonlight', 'Dark Sky', 'Eclipse', 'Night Whisper']
  },
  {
    id: 11,
    nombre: 'Rojo Fuego',
    slug: 'rojo-fuego',
    imagenes: { profile: 'https://images.unsplash.com/photo-1520342868574-5fa3804e551c?w=800&q=80' },
    stats: { seguidores: '500K', oyentes: '800K', power: 94, speed: 96, technique: 85 },
    bio: 'La nueva promesa del trap duro.',
    tracks: ['Fire Starter', 'Red Hot', 'Burn It Down', 'Inferno']
  },
  {
    id: 12,
    nombre: 'Cyber Punk',
    slug: 'cyber-punk',
    imagenes: { profile: 'https://images.unsplash.com/photo-1618641986557-1ecd23095910?w=800&q=80' },
    stats: { seguidores: '4.5M', oyentes: '5.1M', power: 90, speed: 92, technique: 99 },
    bio: 'Sonidos del futuro hoy.',
    tracks: ['Future City', 'Cyber Soul', 'Tech Beat', 'Neon Rain']
  }
];

// If DB returns data, we might need to map it or merge with mock for "tracks" and "stats" if missing
// For simplicity in this demo, we'll use the rich mock data primarily, or map DB data to it if available
const artists = (dbArtists && dbArtists.length > 0) ? dbArtists.map((a, i) => ({
    ...a,
    // Ensure missing fields have defaults
    stats: a.stats || mockArtists[i % mockArtists.length].stats,
    tracks: mockArtists[i % mockArtists.length].tracks // Mock tracks for DB artists
})) : mockArtists;

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Artistas (Arcade Mode)",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};
---

<Layout config={config}>
  <div class="min-h-screen bg-black text-white font-sans overflow-hidden relative selection:bg-[var(--wild-orange)] selection:text-black">
    
    <!-- ARCADE BACKGROUND -->
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20 pointer-events-none z-0"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black via-transparent to-black pointer-events-none z-0"></div>
    
    <!-- TOP BAR -->
    <div class="relative z-50 bg-black/80 backdrop-blur border-b border-white/10 py-2">
        <div class="container mx-auto px-4 flex justify-between items-center">
            <div class="flex items-center gap-2">
                <div class="w-3 h-3 bg-red-600 animate-pulse rounded-sm"></div>
                <span class="text-xs font-black uppercase tracking-[0.2em] text-white arcade-font">INSERT COIN // PLAY</span>
            </div>
            <div class="text-xs font-mono text-gray-500">STAGE: ARTIST SELECTION</div>
        </div>
    </div>

    <!-- MAIN ARENA CONTAINER -->
    <div class="relative z-10 container mx-auto px-4 py-8 h-[calc(100vh-60px)] flex flex-col gap-8">
      
      <!-- HEADER -->
      <div class="text-center animate-fade-in-down">
          <h1 class="text-4xl md:text-6xl font-black italic uppercase tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 via-orange-500 to-red-600 drop-shadow-[0_5px_5px_rgba(255,0,0,0.5)] arcade-title">
              CHOOSE YOUR FIGHTER
          </h1>
          <p class="text-xs md:text-sm font-bold text-gray-400 uppercase tracking-[0.5em] mt-2">
              DRAG & DROP TO SELECT ARTIST
          </p>
      </div>

      <!-- GAME LAYOUT: GRID + STAGE -->
      <div class="flex-1 flex flex-col lg:flex-row gap-8 overflow-hidden">
          
          <!-- LEFT: CHARACTER SELECT GRID -->
          <div class="w-full lg:w-1/3 flex flex-col gap-4">
              <div class="bg-black/50 border-4 border-white/10 p-2 rounded-lg backdrop-blur-sm shadow-[0_0_20px_rgba(0,0,0,0.8)]">
                  <div class="grid grid-cols-4 gap-2 max-h-[60vh] overflow-y-auto pr-2 custom-scrollbar">
                      {artists.map((artist) => (
                          <div 
                              draggable="true"
                              data-id={artist.id}
                              class="artist-token aspect-square relative group cursor-grab active:cursor-grabbing border-2 border-white/20 hover:border-yellow-400 hover:scale-105 transition-all duration-100 overflow-hidden bg-zinc-800"
                          >
                              <img src={artist.imagenes.profile} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all" />
                              <div class="absolute inset-0 bg-yellow-500/20 opacity-0 group-hover:opacity-100 transition-opacity mix-blend-overlay"></div>
                              <!-- Selection Highlight -->
                              <div class="absolute inset-0 border-2 border-transparent group-hover:border-white transition-colors"></div>
                          </div>
                      ))}
                  </div>
              </div>
              
              <!-- INSTRUCTIONS (Desktop only) -->
              <div class="hidden lg:block bg-zinc-900/80 border border-white/10 p-4 rounded text-[10px] font-mono text-gray-400">
                  <p>> SYSTEM READY...</p>
                  <p>> DRAG PORTRAIT TO CENTER AREA</p>
                  <p>> ANALYZING AUDIO SIGNATURES...</p>
              </div>
          </div>

          <!-- CENTER: BATTLE ARENA (DROP ZONE) -->
          <div 
              id="battle-arena"
              class="flex-1 relative bg-zinc-900/30 border-4 border-dashed border-white/10 rounded-xl flex items-center justify-center overflow-hidden group transition-all duration-300"
          >
              <!-- Placeholder State -->
              <div id="arena-placeholder" class="text-center opacity-50 group-hover:opacity-80 transition-opacity pointer-events-none">
                  <div class="text-6xl mb-4 animate-bounce text-white/20">⇩</div>
                  <h3 class="text-2xl font-black uppercase text-white/30 tracking-widest">DROP ZONE</h3>
              </div>

              <!-- Active Artist State (Hidden by default) -->
              <div id="arena-content" class="hidden absolute inset-0 w-full h-full flex flex-col md:flex-row">
                  <!-- Dynamic Content Injected Here -->
              </div>
              
              <!-- CRT Scanline Effect -->
              <div class="absolute inset-0 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] z-20 bg-[length:100%_2px,3px_100%] pointer-events-none"></div>
          </div>

      </div>
    </div>
  </div>
</Layout>

<!-- CLIENT SIDE LOGIC -->
<script define:vars={{ artists }}>
    const arena = document.getElementById('battle-arena');
    const placeholder = document.getElementById('arena-placeholder');
    const content = document.getElementById('arena-content');
    const tokens = document.querySelectorAll('.artist-token');
    
    let draggedArtistId = null;

    // DRAG EVENTS
    tokens.forEach(token => {
        token.addEventListener('dragstart', (e) => {
            draggedArtistId = token.getAttribute('data-id');
            e.dataTransfer.setData('text/plain', draggedArtistId);
            e.dataTransfer.effectAllowed = 'copy';
            arena.classList.add('border-yellow-500', 'bg-yellow-500/10'); // Highlight arena
        });

        token.addEventListener('dragend', () => {
            arena.classList.remove('border-yellow-500', 'bg-yellow-500/10');
        });

        // Mobile Tap Support (Click instead of drag for mobile)
        token.addEventListener('click', () => {
            const id = token.getAttribute('data-id');
            renderArtist(id);
        });
    });

    // DROP ZONE EVENTS
    arena.addEventListener('dragover', (e) => {
        e.preventDefault(); // Necessary to allow dropping
        e.dataTransfer.dropEffect = 'copy';
    });

    arena.addEventListener('dragenter', () => {
        arena.classList.add('scale-[1.02]', 'border-white');
    });

    arena.addEventListener('dragleave', () => {
        arena.classList.remove('scale-[1.02]', 'border-white');
    });

    arena.addEventListener('drop', (e) => {
        e.preventDefault();
        arena.classList.remove('scale-[1.02]', 'border-white', 'border-yellow-500', 'bg-yellow-500/10');
        const id = e.dataTransfer.getData('text/plain');
        renderArtist(id);
    });

    function renderArtist(id) {
        const artist = artists.find(a => a.id == id); // Loose equality for string/number match
        if (!artist) return;

        // Hide Placeholder
        placeholder.style.display = 'none';
        content.classList.remove('hidden');
        
        // Construct HTML
        content.innerHTML = `
            <!-- BIG PORTRAIT (LEFT) -->
            <div class="w-full md:w-1/2 h-1/2 md:h-full relative overflow-hidden bg-black animate-slide-in-left">
                <img src="${artist.imagenes.profile}" class="w-full h-full object-cover object-top opacity-80" />
                <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-transparent to-transparent"></div>
                <div class="absolute bottom-0 left-0 p-8">
                    <h2 class="text-6xl md:text-7xl font-black text-white italic uppercase tracking-tighter leading-none drop-shadow-lg" style="text-shadow: 4px 4px 0px #C98300;">
                        ${artist.nombre}
                    </h2>
                    <div class="flex gap-4 mt-4">
                        <span class="px-2 py-1 bg-white text-black text-xs font-black uppercase tracking-widest">Lv. ${Math.floor(Math.random() * 50 + 50)}</span>
                        <span class="px-2 py-1 bg-red-600 text-white text-xs font-black uppercase tracking-widest">FIGHTER</span>
                    </div>
                </div>
            </div>

            <!-- STATS & INFO (RIGHT) -->
            <div class="w-full md:w-1/2 h-1/2 md:h-full bg-zinc-900/90 p-8 flex flex-col justify-between border-l-4 border-yellow-500 animate-slide-in-right relative overflow-hidden">
                
                <!-- Background Element -->
                <div class="absolute top-0 right-0 text-[200px] font-black text-white/5 leading-none pointer-events-none select-none -translate-y-10 translate-x-10 overflow-hidden">VS</div>

                <div class="space-y-6 relative z-10">
                    <p class="text-gray-300 font-medium italic text-lg leading-relaxed">"${artist.bio}"</p>
                    
                    <!-- STAT BARS -->
                    <div class="space-y-3 pt-4">
                        <div class="flex items-center gap-4">
                            <span class="w-24 text-xs font-black text-yellow-500 uppercase">Power</span>
                            <div class="flex-1 h-4 bg-black border border-white/20 skew-x-[-12deg]">
                                <div class="h-full bg-gradient-to-r from-red-600 to-yellow-500" style="width: ${artist.stats.power || 80}%"></div>
                            </div>
                            <span class="text-xs font-mono text-white">${artist.stats.power || 80}</span>
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="w-24 text-xs font-black text-blue-500 uppercase">Speed</span>
                            <div class="flex-1 h-4 bg-black border border-white/20 skew-x-[-12deg]">
                                <div class="h-full bg-gradient-to-r from-blue-800 to-cyan-400" style="width: ${artist.stats.speed || 75}%"></div>
                            </div>
                            <span class="text-xs font-mono text-white">${artist.stats.speed || 75}</span>
                        </div>
                        <div class="flex items-center gap-4">
                            <span class="w-24 text-xs font-black text-green-500 uppercase">Technique</span>
                            <div class="flex-1 h-4 bg-black border border-white/20 skew-x-[-12deg]">
                                <div class="h-full bg-gradient-to-r from-green-800 to-lime-400" style="width: ${artist.stats.technique || 85}%"></div>
                            </div>
                            <span class="text-xs font-mono text-white">${artist.stats.technique || 85}</span>
                        </div>
                    </div>
                </div>

                <!-- SPECIAL MOVES (TRACKS) -->
                <div class="mt-8 relative z-10">
                    <h3 class="text-xl font-black text-white uppercase mb-4 border-b border-white/20 pb-2 flex justify-between items-center">
                        <span>Special Moves</span>
                        <span class="text-[10px] text-gray-500 tracking-widest">TOP TRACKS</span>
                    </h3>
                    <ul class="space-y-2">
                        ${(artist.tracks || ['Unknown Track 1', 'Unknown Track 2']).map((track, i) => `
                            <li class="flex items-center justify-between group cursor-pointer hover:bg-white/5 p-2 rounded transition-colors">
                                <div class="flex items-center gap-3">
                                    <span class="text-yellow-500 font-black font-mono">⬇ ↘ ➡ + ${['A', 'B', 'C', 'D'][i]}</span>
                                    <span class="text-white font-bold uppercase text-sm group-hover:text-yellow-400 transition-colors">${track}</span>
                                </div>
                                <span class="opacity-0 group-hover:opacity-100 text-[10px] text-yellow-500 animate-pulse">PLAY</span>
                            </li>
                        `).join('')}
                    </ul>
                </div>

                <!-- ACTION BUTTON -->
                <div class="pt-6 relative z-10">
                    <a href="/artista/${artist.slug}" class="block w-full py-4 bg-red-600 hover:bg-red-500 text-white font-black text-xl uppercase tracking-widest text-center skew-x-[-12deg] shadow-[4px_4px_0px_#000] hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_#000] transition-all">
                        SELECT FIGHTER
                    </a>
                </div>
            </div>
        `;
    }
</script>

<style>
  /* ARCADE FONTS & ANIMATIONS */
  .arcade-font {
    font-family: 'Courier New', Courier, monospace; /* Fallback to mono if no arcade font loaded */
  }
  
  .arcade-title {
    text-shadow: 2px 2px 0px #fff, 4px 4px 0px #000;
  }

  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: #111;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: #333;
    border-radius: 3px;
  }
  .custom-scrollbar::-webkit-scrollbar-thumb:hover {
    background: #555;
  }

  @keyframes slideInLeft {
    from { transform: translateX(-100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }
  @keyframes slideInRight {
    from { transform: translateX(100%); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }
  
  .animate-slide-in-left {
    animation: slideInLeft 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }
  .animate-slide-in-right {
    animation: slideInRight 0.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  /* CRT Scanlines helper */
  .scanlines {
    background: linear-gradient(
      to bottom,
      rgba(255,255,255,0),
      rgba(255,255,255,0) 50%,
      rgba(0,0,0,0.2) 50%,
      rgba(0,0,0,0.2)
    );
    background-size: 100% 4px;
  }
</style>

