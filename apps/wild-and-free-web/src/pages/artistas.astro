];

const artists = (dbArtists && dbArtists.length > 0) ? dbArtists.map((a: any, i: number) => ({
    ...a,
    estilo: mockArtists[i % mockArtists.length].estilo,
    origen: mockArtists[i % mockArtists.length].origen,
    bio: mockArtists[i % mockArtists.length].bio
})) : mockArtists;

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Artistas",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};
---

<Layout config={config}>
  <div class="relative h-screen w-full bg-[#050505] overflow-hidden flex flex-col md:flex-row" id="roster-container">
    
    <!-- BACKGROUND (Full Screen Image) -->
    <div class="absolute inset-0 z-0 transition-all duration-700 ease-out" id="artist-bg">
        <div class="absolute inset-0 bg-gradient-to-r from-[#050505] via-[#050505]/80 to-transparent z-10"></div>
        <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-transparent to-transparent z-10"></div>
        <img 
            id="bg-image" 
            src={artists[0].imagenes.profile} 
            class="w-full h-full object-cover opacity-50 scale-105 transition-transform duration-[2000ms]" 
        />
    </div>

    <!-- NOISE & TEXTURE OVERLAY -->
    <div class="absolute inset-0 z-0 opacity-[0.15] pointer-events-none bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] mix-blend-overlay"></div>
    <div class="absolute inset-0 z-0 opacity-10 pointer-events-none animate-noise bg-repeat"></div>

    <!-- MAIN INTERFACE -->
    <div class="relative z-20 w-full h-full flex flex-col md:flex-row">
        
        <!-- LEFT: ARTIST LIST (The Roster) -->
        <div class="w-full md:w-[40%] h-[30vh] md:h-full flex flex-col justify-center px-6 md:px-12 py-8 relative z-30">
            <!-- Decorative Header -->
            <div class="absolute top-8 left-6 md:left-12 flex items-center gap-3">
                <div class="w-2 h-2 bg-[var(--wild-orange)] rounded-full animate-pulse"></div>
                <span class="text-[10px] font-mono text-gray-500 uppercase tracking-[0.3em]">Select Fighter</span>
            </div>

            <!-- Scrollable List -->
            <div class="h-full max-h-[60vh] overflow-y-auto pr-4 space-y-1 no-scrollbar mask-gradient-y" id="artist-list">
                {artists.map((artist, idx) => (
                    <button 
                        class={`artist-trigger group w-full text-left py-2 md:py-3 transition-all duration-300 focus:outline-none flex items-center justify-between border-b border-white/5 hover:border-[var(--wild-orange)] hover:pl-4 ${idx === 0 ? 'active' : ''}`}
                        data-index={idx}
                        data-image={artist.imagenes.profile}
                        data-name={artist.nombre}
                        data-bio={artist.bio}
                        data-style={artist.estilo}
                        data-origin={artist.origen}
                        data-slug={artist.slug}
                    >
                        <h3 class="text-2xl md:text-4xl font-black uppercase italic text-gray-700 group-hover:text-white transition-colors duration-300 leading-none group-[.active]:text-white">
                            {artist.nombre}
                        </h3>
                        <span class="text-[10px] text-[var(--wild-orange)] opacity-0 group-hover:opacity-100 group-[.active]:opacity-100 transition-opacity font-mono tracking-widest">
                            // {artist.estilo}
                        </span>
                    </button>
                ))}
            </div>
        </div>

        <!-- RIGHT: SELECTED ARTIST DETAILS -->
        <div class="w-full md:w-[60%] h-[70vh] md:h-full flex flex-col justify-end md:justify-center p-6 md:p-20 relative pointer-events-none">
             <div id="artist-details" class="space-y-4 md:space-y-8 pointer-events-auto transform translate-y-0 transition-all duration-500">
                
                <!-- Badge -->
                <div class="overflow-hidden">
                    <span id="detail-style" class="inline-block px-3 py-1 bg-[var(--wild-orange)]/10 border border-[var(--wild-orange)] text-[var(--wild-orange)] text-[9px] md:text-xs font-black uppercase tracking-[0.3em] backdrop-blur-md animate-slide-up">
                        {artists[0].estilo}
                    </span>
                </div>
                
                <!-- Name -->
                <h1 id="detail-name" class="text-5xl md:text-9xl font-black text-white italic uppercase leading-[0.8] tracking-tighter drop-shadow-[0_10px_30px_rgba(0,0,0,0.5)] mix-blend-screen animate-glitch">
                    {artists[0].nombre}
                </h1>
                
                <!-- Origin -->
                <div class="flex items-center gap-4 text-gray-400 text-xs md:text-sm font-mono border-l-2 border-[var(--wild-orange)] pl-4">
                    <span id="detail-origin">{artists[0].origen}</span>
                    <span class="text-[var(--wild-orange)]">•</span>
                    <span>WILD GVNG MEMBER</span>
                </div>

                <!-- Bio -->
                <p id="detail-bio" class="text-sm md:text-xl text-gray-300 font-medium max-w-2xl leading-relaxed drop-shadow-md">
                    {artists[0].bio}
                </p>

                <!-- CTA -->
                <div class="pt-4">
                    <a id="detail-link" href={`/artista/${artists[0].slug}`} class="group inline-flex items-center gap-4 bg-white text-black px-6 md:px-10 py-3 md:py-4 font-black uppercase tracking-widest hover:bg-[var(--wild-orange)] hover:text-white transition-all duration-300 shadow-[4px_4px_0px_var(--wild-orange)] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px]">
                        <span>Ver Perfil</span>
                        <svg class="w-4 h-4 md:w-5 md:h-5 group-hover:translate-x-2 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
                    </a>
                </div>
             </div>
        </div>

    </div>

    <!-- PROGRESS BAR (Bottom) -->
    <div class="absolute bottom-0 left-0 h-1 bg-white/10 w-full z-40">
        <div id="progress-bar" class="h-full bg-[var(--wild-orange)] transition-all duration-300" style={`width: ${100/artists.length}%`}></div>
    </div>

  </div>
</Layout>

<style is:global>
    :root {
        --wild-orange: #FF5500;
    }
    
    .no-scrollbar::-webkit-scrollbar { display: none; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
    
    .mask-gradient-y {
        mask-image: linear-gradient(to bottom, transparent, black 5%, black 95%, transparent);
    }

    @keyframes glitch {
        0% { transform: translate(0); }
        20% { transform: translate(-2px, 2px); }
        40% { transform: translate(-2px, -2px); }
        60% { transform: translate(2px, 2px); }
        80% { transform: translate(2px, -2px); }
        100% { transform: translate(0); }
    }
    .animate-glitch:hover {
        animation: glitch 0.3s cubic-bezier(.25, .46, .45, .94) both infinite;
    }

    @keyframes noise {
        0%, 100% { background-position: 0 0; }
        10% { background-position: -5% -10%; }
        20% { background-position: -15% 5%; }
        30% { background-position: 7% -25%; }
        40% { background-position: 20% 25%; }
        50% { background-position: -25% 10%; }
        60% { background-position: 15% 5%; }
        70% { background-position: 0% 15%; }
        80% { background-position: 25% 35%; }
        90% { background-position: -10% 10%; }
    }
    .animate-noise {
        animation: noise 2s steps(10) infinite;
        background-image: url('data:image/svg+xml,%3Csvg viewBox="0 0 200 200" xmlns="http://www.w3.org/2000/svg"%3E%3Cfilter id="noiseFilter"%3E%3CfeTurbulence type="fractalNoise" baseFrequency="0.65" numOctaves="3" stitchTiles="stitch"/%3E%3C/filter%3E%3Crect width="100%25" height="100%25" filter="url(%23noiseFilter)"/%3E%3C/svg%3E');
    }
</style>

<script>
    // Interaction Logic
    const buttons = document.querySelectorAll('.artist-trigger');
    const bgImage = document.getElementById('bg-image') as HTMLImageElement;
    const detailName = document.getElementById('detail-name');
    const detailStyle = document.getElementById('detail-style');
    const detailBio = document.getElementById('detail-bio');
    const detailOrigin = document.getElementById('detail-origin');
    const detailLink = document.getElementById('detail-link') as HTMLAnchorElement;
    const progressBar = document.getElementById('progress-bar');
    const artistList = document.getElementById('artist-list');
    const artistDetails = document.getElementById('artist-details');

    let currentIndex = 0;
    const totalArtists = buttons.length;

    const updateArtist = (btn: Element) => {
        // Remove active class from all
        buttons.forEach(b => b.classList.remove('active'));
        // Add active to current
        btn.classList.add('active');

        // Get Data
        const data = (btn as HTMLElement).dataset;
        
        // Update Content with animation
        if(artistDetails) {
            artistDetails.style.opacity = '0';
            artistDetails.style.transform = 'translateY(20px)';
        }

        setTimeout(() => {
            if (bgImage) {
                bgImage.style.opacity = '0';
                setTimeout(() => {
                    bgImage.src = data.image || '';
                    bgImage.onload = () => {
                        bgImage.style.opacity = '0.5';
                        bgImage.style.transform = 'scale(1.05)';
                        setTimeout(() => bgImage.style.transform = 'scale(1)', 50);
                    };
                }, 100);
            }

            if (detailName) detailName.textContent = data.name || '';
            if (detailStyle) detailStyle.textContent = data.style || '';
            if (detailBio) detailBio.textContent = data.bio || '';
            if (detailOrigin) detailOrigin.textContent = data.origin || '';
            if (detailLink) detailLink.href = `/artista/${data.slug}`;

            if(artistDetails) {
                artistDetails.style.opacity = '1';
                artistDetails.style.transform = 'translateY(0)';
            }
        }, 300);

        // Update Progress
        if (progressBar) {
            const idx = parseInt(data.index || '0');
            progressBar.style.width = `${((idx + 1) / totalArtists) * 100}%`;
            currentIndex = idx;
        }
    };

    // Event Listeners
    buttons.forEach(btn => {
        btn.addEventListener('mouseenter', () => updateArtist(btn));
        btn.addEventListener('click', (e) => {
            // Mobile tap or click to navigate directly? 
            // For now, click just selects, link button navigates
             updateArtist(btn);
        });
    });

    // Auto-advance on mobile/idle?
    // Maybe just keyboard navigation
    document.addEventListener('keydown', (e) => {
        if (e.key === 'ArrowDown') {
            const next = (currentIndex + 1) % totalArtists;
            const btn = document.querySelector(`.artist-trigger[data-index="${next}"]`);
            if (btn) {
                updateArtist(btn);
                btn.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        } else if (e.key === 'ArrowUp') {
            const prev = (currentIndex - 1 + totalArtists) % totalArtists;
            const btn = document.querySelector(`.artist-trigger[data-index="${prev}"]`);
            if (btn) {
                updateArtist(btn);
                btn.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        }
    });

</script>
