---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// Fetch artists from Supabase
const { data: dbArtists, error } = await supabase
  .from('artists')
  .select('*')
  .order('nombre');

// Fallback to static artists if DB is empty or error
const artists = (dbArtists && dbArtists.length > 0) ? dbArtists : [
  {
    nombre: 'Lil Kiro',
    slug: 'lil-kiro',
    imagenes: { profile: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=800&q=80' },
    stats: { seguidores: '2.1M', oyentes: '1.2M' },
    bio: 'El pionero del trap en el desierto.'
  },
  {
    nombre: 'Neon Ghost',
    slug: 'neon-ghost',
    imagenes: { profile: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=800&q=80' },
    stats: { seguidores: '1.8M', oyentes: '900K' },
    bio: 'Misterio y drill futurista.'
  },
  {
    nombre: 'Shadow V',
    slug: 'shadow-v',
    imagenes: { profile: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=800&q=80' },
    stats: { seguidores: '1.5M', oyentes: '750K' },
    bio: 'Lírica consciente sobre ritmos lo-fi.'
  },
  {
    nombre: 'Crystal Wave',
    slug: 'crystal-wave',
    imagenes: { profile: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=800&q=80' },
    stats: { seguidores: '890K', oyentes: '1.1M' },
    bio: 'Fusión de synthwave con reggaetón.'
  },
  {
    nombre: 'Midnight Rider',
    slug: 'midnight-rider',
    imagenes: { profile: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=800&q=80' },
    stats: { seguidores: '2.7M', oyentes: '2.4M' },
    bio: 'Flow vieja escuela con agresividad.'
  },
  {
    nombre: 'Nova K',
    slug: 'nova-k',
    imagenes: { profile: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=800&q=80' },
    stats: { seguidores: '2.4M', oyentes: '1.8M' },
    bio: 'Reina del drill melódico.'
  },
  {
    nombre: 'Sable',
    slug: 'sable',
    imagenes: { profile: 'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=800&q=80' },
    stats: { seguidores: '1.2M', oyentes: '3.5M' },
    bio: 'Arquitecto de sonidos oscuros.'
  },
  {
    nombre: 'Storm Trooper',
    slug: 'storm-trooper',
    imagenes: { profile: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=800&q=80' },
    stats: { seguidores: '950K', oyentes: '600K' },
    bio: 'Energía pura de Gómez Palacio.'
  }
];

const config = {
  name: "Wild Gvng - Artistas",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
};
---

<Layout config={config}>
  <main class="min-h-screen bg-black pt-32 pb-20 px-6">
    <div class="max-w-[1400px] mx-auto space-y-20">
      <div class="space-y-4 text-center lg:text-left">
        <h1 class="text-6xl md:text-8xl font-black tracking-tighter text-white uppercase leading-none">
          NUESTROS <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-red-600">ARTISTAS</span>
        </h1>
        <p class="text-xl text-white font-bold uppercase tracking-[0.3em]">El movimiento que redefine la cultura</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
        {artists.map((artist) => (
          <a href={`/artista/${artist.slug}`} class="group relative aspect-[3/4] overflow-hidden rounded-3xl bg-[#111] border border-white/5 hover:border-orange-500/50 transition-all duration-500 shadow-2xl">
            <img 
              src={artist.imagenes?.profile || 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=800&q=80'} 
              alt={artist.nombre} 
              loading="lazy" 
              class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent opacity-80 group-hover:opacity-40 transition-opacity duration-500"></div>
            <div class="absolute inset-x-0 bottom-0 p-8 space-y-2 translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
              <p class="text-[10px] font-black uppercase tracking-[0.2em] text-orange-500">Artista Verificado</p>
              <h3 class="text-3xl font-black uppercase tracking-tighter text-white drop-shadow-md">{artist.nombre}</h3>
              <div class="flex items-center gap-4 pt-2 opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">
                <span class="text-[10px] font-black text-white/60 uppercase tracking-widest">{artist.stats?.seguidores || '0'} seguidores</span>
                <span class="text-[10px] font-black text-white/60 uppercase tracking-widest">{artist.stats?.oyentes || '0'} oyentes</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
