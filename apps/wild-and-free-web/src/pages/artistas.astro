---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';

// Fetch artists from Supabase
let dbArtists = null;
try {
  const { data, error } = await supabase
    .from('artists')
    .select('*')
    .order('nombre');
  if (!error) dbArtists = data;
} catch (e) {
  console.warn('Could not fetch artists from Supabase during build.');
}

// Fallback to static artists if DB is empty or error
const artists = (dbArtists && dbArtists.length > 0) ? dbArtists : [
  {
    nombre: 'Lil Kiro',
    slug: 'lil-kiro',
    imagenes: { profile: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=800&q=80' },
    stats: { seguidores: '2.1M', oyentes: '1.2M' },
    bio: 'El pionero del trap en el desierto.'
  },
  {
    nombre: 'Neon Ghost',
    slug: 'neon-ghost',
    imagenes: { profile: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=800&q=80' },
    stats: { seguidores: '1.8M', oyentes: '900K' },
    bio: 'Misterio y drill futurista.'
  },
  {
    nombre: 'Shadow V',
    slug: 'shadow-v',
    imagenes: { profile: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=800&q=80' },
    stats: { seguidores: '1.5M', oyentes: '750K' },
    bio: 'Lírica consciente sobre ritmos lo-fi.'
  },
  {
    nombre: 'Crystal Wave',
    slug: 'crystal-wave',
    imagenes: { profile: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=800&q=80' },
    stats: { seguidores: '890K', oyentes: '1.1M' },
    bio: 'Fusión de synthwave con reggaetón.'
  },
  {
    nombre: 'Midnight Rider',
    slug: 'midnight-rider',
    imagenes: { profile: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=800&q=80' },
    stats: { seguidores: '2.7M', oyentes: '2.4M' },
    bio: 'Flow vieja escuela con agresividad.'
  },
  {
    nombre: 'Nova K',
    slug: 'nova-k',
    imagenes: { profile: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=800&q=80' },
    stats: { seguidores: '2.4M', oyentes: '1.8M' },
    bio: 'Reina del drill melódico.'
  },
  {
    nombre: 'Sable',
    slug: 'sable',
    imagenes: { profile: 'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=800&q=80' },
    stats: { seguidores: '1.2M', oyentes: '3.5M' },
    bio: 'Arquitecto de sonidos oscuros.'
  },
  {
    nombre: 'Storm Trooper',
    slug: 'storm-trooper',
    imagenes: { profile: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=800&q=80' },
    stats: { seguidores: '950K', oyentes: '600K' },
    bio: 'Energía pura de Gómez Palacio.'
  },
  // Nuevos Artistas
  {
    nombre: 'Viper X',
    slug: 'viper-x',
    imagenes: { profile: 'https://images.unsplash.com/photo-1615109398623-88346a601842?w=800&q=80' },
    stats: { seguidores: '3.1M', oyentes: '2.8M' },
    bio: 'El veneno lírico más potente del norte.'
  },
  {
    nombre: 'Luna Negra',
    slug: 'luna-negra',
    imagenes: { profile: 'https://images.unsplash.com/photo-1517423568366-69755581d826?w=800&q=80' },
    stats: { seguidores: '1.9M', oyentes: '2.2M' },
    bio: 'Voces etéreas sobre bajos pesados.'
  },
  {
    nombre: 'Rojo Fuego',
    slug: 'rojo-fuego',
    imagenes: { profile: 'https://images.unsplash.com/photo-1520342868574-5fa3804e551c?w=800&q=80' },
    stats: { seguidores: '500K', oyentes: '800K' },
    bio: 'La nueva promesa del trap duro.'
  },
  {
    nombre: 'Cyber Punk',
    slug: 'cyber-punk',
    imagenes: { profile: 'https://images.unsplash.com/photo-1618641986557-1ecd23095910?w=800&q=80' },
    stats: { seguidores: '4.5M', oyentes: '5.1M' },
    bio: 'Sonidos del futuro hoy.'
  }
];

// Artista Destacado (Random o fijo)
const featuredArtist = artists[8]; // Viper X

import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Artistas",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};
---

<Layout config={config}>
  <div class="min-h-screen bg-[#050505] text-white pb-32 selection:bg-[var(--wild-orange)] selection:text-black font-sans">
    
    <!-- Top Bar Minimal -->
    <div class="bg-black border-b border-white/10 py-2 sticky top-0 z-50">
        <div class="container mx-auto px-4 max-w-[1800px] flex justify-between items-center">
            <div class="flex items-center gap-2">
                <div class="w-2 h-2 bg-[var(--wild-orange)] rounded-full animate-pulse"></div>
                <span class="text-[10px] font-black uppercase tracking-[0.2em] text-white">Wild Music OS v3.2</span>
            </div>
            <div class="flex gap-4 text-[10px] font-mono text-gray-500">
                <span>ESTADO: CONECTADO</span>
                <span>ZONA: GLOBAL</span>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4 py-12 max-w-[1800px] animate-fade-in-up space-y-20">
      
      <!-- GRID ARTISTAS MINIMAL -->
      <section>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-1">
              <!-- Artista Destacado (Top Left - 1/4 width roughly) -->
              <div class="col-span-1 lg:row-span-2 relative group overflow-hidden bg-zinc-900 aspect-[3/5]">
                  <img src={featuredArtist.imagenes.profile} class="absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent opacity-80"></div>
                  
                  <div class="absolute bottom-0 left-0 p-6 w-full">
                      <div class="inline-flex items-center gap-2 mb-4">
                          <span class="w-1.5 h-1.5 bg-[var(--wild-orange)] rounded-full animate-pulse"></span>
                          <span class="text-[9px] font-black uppercase tracking-[0.2em] text-white">Destacado</span>
                      </div>
                      
                      <h2 class="text-4xl lg:text-5xl font-black uppercase tracking-tighter leading-none text-white mb-2">
                          {featuredArtist.nombre}
                      </h2>
                      
                      <p class="text-sm text-gray-400 line-clamp-3 mb-6 font-medium">
                          {featuredArtist.bio}
                      </p>

                      <div class="flex items-center justify-between border-t border-white/10 pt-4">
                           <div class="flex flex-col">
                              <span class="text-2xl font-bold text-white">{featuredArtist.stats.oyentes}</span>
                              <span class="text-[9px] text-gray-500 uppercase tracking-widest">Oyentes</span>
                           </div>
                           <a href={`/artista/${featuredArtist.slug}`} class="w-10 h-10 bg-white text-black flex items-center justify-center hover:bg-[var(--wild-orange)] hover:text-white transition-colors">
                              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                           </a>
                      </div>
                  </div>
              </div>

              <!-- Resto del Crew -->
              {artists.filter((a: any) => a.slug !== featuredArtist.slug).map((artist: any) => (
                  <a href={`/artista/${artist.slug}`} class="col-span-1 relative group overflow-hidden bg-zinc-900 aspect-[3/4]">
                      <img src={artist.imagenes.profile} class="absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700" />
                      <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity"></div>
                      
                      <div class="absolute bottom-0 left-0 p-4 w-full transform translate-y-2 group-hover:translate-y-0 transition-transform">
                          <h3 class="text-2xl font-black uppercase tracking-tighter text-white mb-1">
                              {artist.nombre}
                          </h3>
                          <p class="text-[10px] font-bold text-gray-400 uppercase tracking-widest opacity-0 group-hover:opacity-100 transition-opacity delay-100">
                              Ver Perfil
                          </p>
                      </div>
                  </a>
              ))}
          </div>
      </section>


    </div>
  </div>
</Layout>

<style is:global define:vars={{ streetAccent: tenant.primary_color }}>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
</style>
