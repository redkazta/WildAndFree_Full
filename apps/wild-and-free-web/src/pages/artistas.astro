---
import Layout from '../layouts/Layout.astro';
import { getArtistsFromDB } from '../data/artists';
import type { Artist } from '../data/artists';

const config = {
  name: "Wild Gvng - Roster",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
};

// Fetch artists from Supabase at build time
const artists = await getArtistsFromDB();

// Extract unique genres from all artists
const allGenres = new Set<string>();
artists.forEach(a => a.estilo.split(' / ').forEach(g => allGenres.add(g)));
const genres = ['Todos', ...Array.from(allGenres).sort()];
---

<Layout config={config}>
  <div class="roster-page">

    <!-- HERO -->
    <section class="roster-hero">
      <div class="hero-bg">
        <div class="hero-grid"></div>
        <div class="hero-glow hero-glow-1"></div>
        <div class="hero-glow hero-glow-2"></div>
        <div class="hero-noise"></div>
      </div>
      <div class="hero-content">
        <div class="hero-badge">
          <span class="badge-dot"></span>
          <span class="badge-text">DESDE 2018, TORREÓN, COAHUILA, MÉXICO</span>
        </div>
        <h1 class="hero-title">
          <span class="title-wild">WILD</span>
          <span class="title-gvng">GVNG</span>
          <span class="title-roster">ROSTER</span>
        </h1>
        <p class="hero-subtitle">Los que representan al desierto</p>
      </div>
    </section>

    <!-- FILTERS -->
    <section class="filters-section">
      <div class="container">
        <div class="filters-row">
          {genres.map((g, i) => (
            <button
              class={`filter-chip ${i === 0 ? 'active' : ''}`}
              data-genre={g.toLowerCase()}
              onclick={`filterArtists('${g.toLowerCase()}')`}
            >
              {g}
            </button>
          ))}
        </div>
        <div class="results-count">
          <span id="artist-count">{artists.length}</span> artistas en el roster
        </div>
      </div>
    </section>

    <!-- ROSTER GRID -->
    <section class="roster-grid-section">
      <div class="container">
        <div class="roster-grid" id="roster-grid">
          {artists.map((artist, idx) => (
            <a
              href={`/artista?id=${artist.slug}`}
              class="artist-card"
              data-genre={artist.estilo.toLowerCase()}
              style={`animation-delay: ${idx * 0.08}s`}
            >
              <!-- Photo -->
              <div class="card-photo">
                <img
                  src={artist.imagenes.profile}
                  alt={artist.nombre}
                  width="400"
                  height="400"
                  loading="lazy"
                />
                <div class="card-glow"></div>
              </div>

              <!-- Info -->
              <div class="card-info">
                <h3 class="card-name">{artist.nombre}</h3>
                <span class="card-genre">{artist.estilo}</span>
                <span class="card-origin">📍 {artist.origen}</span>
              </div>

              <!-- Partnear Button -->
              <div class="card-action">
                <button
                  class="partnear-btn"
                  onclick={`event.preventDefault(); togglePartnear('${artist.id}')`}
                  data-artist-id={artist.id}
                >
                  <span class="partnear-icon">🔥</span>
                  <span class="partnear-label">PARTNEAR</span>
                  <span class="partnear-count">{artist.stats.partnean}</span>
                </button>
              </div>

              <!-- Stats Row -->
              <div class="card-stats">
                <span class="stat">🎵 {artist.tracks.length} tracks</span>
                <span class="stat">🔥 {artist.stats.partnean} partnean</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- JOIN CTA -->
    <section class="join-section">
      <div class="container">
        <div class="join-card">
          <div class="join-content">
            <span class="join-label">¿ERES ARTISTA?</span>
            <h2 class="join-title">ÚNETE AL <span class="text-wild-orange">ROSTER</span></h2>
            <p class="join-desc">Crea tu cuenta como artista y forma parte del movimiento urbano de Torreón.</p>
            <a href="/registro" class="join-btn">REGISTRARME COMO ARTISTA</a>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>

<style>
  /* ===== GLOBALS ===== */
  .roster-page {
    min-height: 100vh;
    background: var(--bg);
    overflow-x: hidden;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ===== HERO ===== */
  .roster-hero {
    position: relative;
    height: 50vh;
    min-height: 400px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .hero-bg {
    position: absolute;
    inset: 0;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(var(--border-faint) 1px, transparent 1px),
      linear-gradient(90deg, var(--border-faint) 1px, transparent 1px);
    background-size: 80px 80px;
  }
  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(150px);
    animation: pulse 4s ease-in-out infinite;
  }
  .hero-glow-1 {
    top: 25%;
    left: 25%;
    width: 500px;
    height: 500px;
    background: rgba(201, 131, 0, 0.1);
  }
  .hero-glow-2 {
    bottom: 25%;
    right: 25%;
    width: 500px;
    height: 500px;
    background: rgba(201, 131, 0, 0.05);
    animation-delay: 1s;
  }
  .hero-noise {
    position: absolute;
    inset: 0;
    opacity: 0.1;
    background: url('https://www.transparenttextures.com/patterns/stardust.png');
    mix-blend-mode: overlay;
  }
  .hero-content {
    position: relative;
    z-index: 10;
    text-align: center;
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 8px 20px;
    border-radius: 100px;
    background: var(--bg-card);
    border: 1px solid var(--border-muted);
    backdrop-filter: blur(10px);
    margin-bottom: 24px;
  }
  .badge-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #C98300;
    animation: pulse 2s infinite;
  }
  .badge-text {
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
    font-family: monospace;
  }
  .hero-title {
    font-size: 6rem;
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.03em;
    margin: 0;
  }
  .title-wild {
    display: block;
    color: var(--text);
  }
  .title-gvng {
    display: block;
    background: linear-gradient(135deg, #C98300, #f59e0b, #C98300);
    background-size: 200% auto;
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .title-roster {
    display: block;
    font-size: 1.5rem;
    letter-spacing: 0.3em;
    color: var(--border-soft);
    margin-top: 8px;
  }
  .hero-subtitle {
    margin-top: 16px;
    font-size: 0.8rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-muted);
  }

  @media (max-width: 768px) {
    .roster-hero { height: 35vh; min-height: 280px; }
    .hero-title { font-size: 3rem; }
    .title-roster { font-size: 0.8rem; letter-spacing: 0.2em; }
    .hero-badge { padding: 6px 14px; }
    .badge-text { font-size: 8px; }
  }
  @media (max-width: 480px) {
    .roster-hero { height: 30vh; min-height: 220px; }
    .hero-title { font-size: 2.4rem; }
    .hero-subtitle { font-size: 0.65rem; }
    .roster-grid-section { padding: 24px 0 60px; }
    .join-card { padding: 32px 20px; }
    .join-title { font-size: 1.4rem; }
  }

  /* ===== FILTERS ===== */
  .filters-section {
    padding: 32px 0 16px;
    border-bottom: 1px solid var(--border-faint);
  }
  .filters-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .filter-chip {
    padding: 8px 18px;
    border-radius: 100px;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: var(--bg-card);
    border: 1px solid var(--bg-hover);
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }
  .filter-chip:hover {
    border-color: var(--border-soft);
    color: var(--text);
  }
  .filter-chip.active {
    background: rgba(201,131,0,0.15);
    border-color: rgba(201,131,0,0.5);
    color: #C98300;
  }
  .results-count {
    text-align: center;
    margin-top: 12px;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--border-soft);
  }

  /* ===== ROSTER GRID ===== */
  .roster-grid-section {
    padding: 40px 0 80px;
  }
  .roster-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 900px) {
    .roster-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .roster-grid { grid-template-columns: 1fr; }
  }

  /* ===== ARTIST CARD ===== */
  .artist-card {
    background: var(--bg-card);
    border: 1px solid var(--border-faint);
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    animation: fadeUp 0.6s ease-out backwards;
  }
  .artist-card:hover {
    transform: translateY(-6px);
    border-color: rgba(201,131,0,0.4);
    box-shadow: 0 20px 60px -15px rgba(201,131,0,0.15);
  }
  .artist-card.hidden {
    display: none;
  }

  /* Photo */
  .card-photo {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .artist-card:hover .card-photo img {
    transform: scale(1.05);
  }
  .card-glow {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: radial-gradient(circle at 50% 0%, rgba(201,131,0,0.2) 0%, transparent 70%);
    transition: opacity 0.4s;
  }
  .artist-card:hover .card-glow {
    opacity: 1;
  }

  /* Info */
  .card-info {
    padding: 20px 20px 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }
  .card-name {
    font-size: 1.1rem;
    font-weight: 900;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }
  .card-genre {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #C98300;
    font-family: monospace;
  }
  .card-origin {
    font-size: 0.65rem;
    color: var(--border-soft);
    margin-top: 2px;
  }

  /* Partnear */
  .card-action {
    padding: 16px 20px 0;
  }
  .partnear-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px;
    border-radius: 12px;
    background: var(--bg-card);
    border: 1px solid var(--bg-hover);
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }
  .partnear-btn:hover {
    background: rgba(201,131,0,0.1);
    border-color: rgba(201,131,0,0.3);
    color: #C98300;
  }
  .partnear-btn.active {
    background: rgba(201,131,0,0.15);
    border-color: rgba(201,131,0,0.5);
    color: #C98300;
  }
  .partnear-icon { font-size: 0.8rem; }
  .partnear-label {
    font-size: 0.6rem;
    font-weight: 900;
    letter-spacing: 0.15em;
  }
  .partnear-count {
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--border-soft);
  }

  /* Stats */
  .card-stats {
    padding: 12px 20px 16px;
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--bg-card);
    margin-top: 12px;
  }
  .stat {
    font-size: 0.6rem;
    font-weight: 600;
    color: var(--border-soft);
  }

  /* ===== JOIN CTA ===== */
  .join-section {
    padding: 0 0 80px;
  }
  .join-card {
    background: linear-gradient(135deg, rgba(201,131,0,0.08), rgba(138,3,3,0.05));
    border: 1px solid rgba(201,131,0,0.15);
    border-radius: 24px;
    padding: 48px;
    text-align: center;
  }
  .join-label {
    font-size: 0.6rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--border-soft);
    font-family: monospace;
  }
  .join-title {
    font-size: 2rem;
    font-weight: 900;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 8px 0 12px;
  }
  .join-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    max-width: 400px;
    margin: 0 auto 24px;
    line-height: 1.6;
  }
  .join-btn {
    display: inline-block;
    padding: 14px 32px;
    background: #C98300;
    color: var(--bg);
    font-size: 0.7rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    border-radius: 14px;
    text-decoration: none;
    transition: all 0.3s;
  }
  .join-btn:hover {
    background: #e69500;
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(201,131,0,0.3);
  }

  /* ===== ANIMATIONS ===== */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }
</style>

<script>
  // Genre filter
  // @ts-ignore
  window.filterArtists = function(genre: string) {
    const cards = document.querySelectorAll('.artist-card');
    const chips = document.querySelectorAll('.filter-chip');
    const countEl = document.getElementById('artist-count');

    chips.forEach(c => c.classList.remove('active'));
    document.querySelector(`[data-genre="${genre}"]`)?.classList.add('active');

    let visible = 0;
    cards.forEach(card => {
      const el = card as HTMLElement;
      if (genre === 'todos' || el.dataset.genre?.includes(genre)) {
        el.classList.remove('hidden');
        visible++;
      } else {
        el.classList.add('hidden');
      }
    });
    if (countEl) countEl.textContent = String(visible);
  }

  // Partnear toggle
  const partnearState: Record<string, boolean> = {};
// @ts-ignore
window.togglePartnear = function(artistId: string) {
  const btn = document.querySelector(`[data-artist-id="${artistId}"]`) as HTMLElement;
  if (!btn) return;

  partnearState[artistId] = !partnearState[artistId];
  const countEl = btn.querySelector('.partnear-count');
  const baseCount = parseInt(countEl?.textContent || '0');

  if (partnearState[artistId]) {
    btn.classList.add('active');
    if (countEl) countEl.textContent = String(baseCount + 1);
  } else {
    btn.classList.remove('active');
    if (countEl) countEl.textContent = String(Math.max(0, baseCount - 1));
  }
}


</script>
