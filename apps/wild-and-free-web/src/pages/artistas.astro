---
import Layout from '../layouts/Layout.astro';

const artists = [
  {
    id: '1',
    name: 'Lil Kiro',
    image: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=800&h=800&fit=crop&crop=face',
    genre: 'Trap',
    followers: '2.1M',
    tracks: 24,
    role: 'Rapper'
  },
  {
    id: '2',
    name: 'Neon Ghost',
    image: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=800&h=800&fit=crop&crop=face',
    genre: 'Drill',
    followers: '1.8M',
    tracks: 18,
    role: 'Rapper'
  },
  {
    id: '4',
    name: 'Shadow V',
    image: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=800&h=800&fit=crop&crop=face',
    genre: 'Hip Hop',
    followers: '1.5M',
    tracks: 15,
    role: 'Hip Hop'
  },
  {
    id: '5',
    name: 'Crystal Wave',
    image: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=800&h=800&fit=crop&crop=face',
    genre: 'Electronic',
    followers: '890K',
    tracks: 12,
    role: 'Producer'
  },
  {
    id: '6',
    name: 'Midnight Rider',
    image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=800&h=800&fit=crop&crop=face',
    genre: 'Trap',
    followers: '2.7M',
    tracks: 28,
    role: 'DJ'
  },
  {
    id: 'a1',
    name: 'Nova K',
    role: 'Rapper',
    image: 'https://images.unsplash.com/photo-1520975958221-7f61d4d6df4b?auto=format&fit=crop&w=800&q=80',
    genre: 'Rapper',
    followers: '2.4M',
    tracks: 32
  },
  {
    id: 'a2',
    name: 'Sable',
    role: 'Producer',
    image: 'https://images.unsplash.com/photo-1520975693413-35e0000c0e4e?auto=format&fit=crop&w=800&q=80',
    genre: 'Producer',
    followers: '1.2M',
    tracks: 45
  }
];

const config = {
  name: "Wild Gvng - Artistas",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
};
---

<Layout config={config}>
  <main class="min-h-screen bg-black pt-32 pb-20 px-6">
    <div class="max-w-[1400px] mx-auto space-y-20">
      <div class="space-y-4 text-center lg:text-left">
        <h1 class="text-6xl md:text-8xl font-black tracking-tighter text-white uppercase leading-none">
          NUESTROS <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-red-600">ARTISTAS</span>
        </h1>
        <p class="text-xl text-white font-bold uppercase tracking-[0.3em]">El movimiento que redefine la cultura</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
        {artists.map((artist) => (
          <a href={`/artista/${artist.id}`} class="group relative aspect-[3/4] overflow-hidden rounded-3xl bg-[#111] border border-white/5 hover:border-orange-500/50 transition-all duration-500 shadow-2xl">
            <img 
              src={artist.image} 
              alt={artist.name} 
              loading="lazy" 
              class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-110"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent opacity-80 group-hover:opacity-40 transition-opacity duration-500"></div>
            <div class="absolute inset-x-0 bottom-0 p-8 space-y-2 translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
              <p class="text-[10px] font-black uppercase tracking-[0.2em] text-orange-500">Artist // {artist.role}</p>
              <h3 class="text-3xl font-black uppercase tracking-tighter text-white drop-shadow-md">{artist.name}</h3>
              <div class="flex items-center gap-4 pt-2 opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">
                <span class="text-[10px] font-black text-white/60 uppercase tracking-widest">{artist.followers} fans</span>
                <span class="text-[10px] font-black text-white/60 uppercase tracking-widest">{artist.tracks} tracks</span>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </main>
</Layout>
