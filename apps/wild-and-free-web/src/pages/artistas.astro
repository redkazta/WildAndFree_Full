<script define:vars={{ artists }}>
    // UI ELEMENTS
    const slotReel = document.getElementById('slot-reel');
    const slotLever = document.getElementById('slot-lever');
    const luckyPanel = document.getElementById('artist-lucky-panel');
    const emptyState = document.getElementById('panel-empty-state');
    
    const luckyImg = document.getElementById('lucky-artist-img');
    const luckyName = document.getElementById('lucky-artist-name');
    const luckyRole = document.getElementById('lucky-artist-role');
    const luckyBio = document.getElementById('lucky-artist-bio');
    const luckyOrigin = document.getElementById('lucky-artist-origin');
    const luckyStyle = document.getElementById('lucky-artist-style');
    const luckyRarity = document.getElementById('lucky-artist-rarity');
    const luckyPower = document.getElementById('lucky-artist-power');
    const luckyPowerBar = document.getElementById('lucky-artist-power-bar');
    const luckyStreak = document.getElementById('lucky-artist-streak');
    const luckyStreakCount = document.getElementById('lucky-artist-streak-count');
    const viewProfileLink = document.getElementById('view-profile-link');
    const collectBtn = document.getElementById('collect-artist-btn');
    const jackpotOverlay = document.getElementById('jackpot-overlay');
    const filterAll = document.getElementById('filter-all');
    const filterLegendary = document.getElementById('filter-legendary');
    const quickSelectGrid = document.getElementById('quick-select-grid');
    
    const quickSelects = document.querySelectorAll('.artist-quick-select');

    let isSpinning = false;
    let currentRarity = 'COMÚN';

    // AUDIO SYSTEM (Simple web audio oscillator for retro sounds)
    function playSound(type) {
        try {
            const ctx = new (window.AudioContext || window.webkitAudioContext)();
            const osc = ctx.createOscillator();
            const gain = ctx.createGain();
            osc.connect(gain);
            gain.connect(ctx.destination);

            if (type === 'spin') {
                osc.type = 'square';
                osc.frequency.setValueAtTime(150, ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(40, ctx.currentTime + 0.1);
                gain.gain.setValueAtTime(0.05, ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.1);
            } else if (type === 'stop') {
                osc.type = 'sine';
                osc.frequency.setValueAtTime(440, ctx.currentTime);
                osc.frequency.exponentialRampToValueAtTime(880, ctx.currentTime + 0.1);
                gain.gain.setValueAtTime(0.1, ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.2);
            } else if (type === 'jackpot') {
                osc.type = 'sawtooth';
                [440, 554, 659, 880].forEach((f, i) => {
                    osc.frequency.setValueAtTime(f, ctx.currentTime + (i * 0.1));
                });
                gain.gain.setValueAtTime(0.1, ctx.currentTime);
                gain.gain.linearRampToValueAtTime(0, ctx.currentTime + 0.5);
            }
            
            osc.start();
            osc.stop(ctx.currentTime + 0.5);
        } catch(e) { console.warn('Audio not supported'); }
    }

    // POPULATE REEL
    function initSlotMachine() {
        if (!slotReel) return;
        
        // Add one empty item at the top to center the first real item
        const reelHtml = [`<div class="h-16 w-full flex-shrink-0"></div>`, ...artists, ...artists, ...artists].map((artist, i) => {
            if (typeof artist === 'string') return artist;
            return `
                <div class="h-16 w-full flex-shrink-0 border-b border-white/5 flex items-center px-6 gap-4 bg-zinc-900/50">
                    <div class="w-10 h-10 rounded-lg overflow-hidden border border-white/10">
                        <img src="${artist.imagenes.profile}" class="w-full h-full object-cover grayscale" />
                    </div>
                    <span class="text-xs font-black uppercase tracking-tighter truncate text-white/80">${artist.nombre}</span>
                </div>
            `;
        }).join('');
        
        slotReel.innerHTML = reelHtml;
    }

    // SHOW ARTIST DATA
    function showArtist(artist) {
        if (!artist || !luckyPanel || !emptyState) return;

        // Hide empty state, show panel
        emptyState.classList.add('hidden');
        luckyPanel.classList.remove('hidden');
        
        // Reset animation
        luckyPanel.style.opacity = '0';
        luckyPanel.style.transform = 'translateX(20px)';
        
        // Random Stats for effect
        const rarities = ['COMÚN', 'RARO', 'ÉPICO', 'LEGENDARIO', 'MÍTICO'];
        const rarity = rarities[Math.floor(Math.random() * rarities.length)];
        currentRarity = rarity;
        const power = Math.floor(Math.random() * 30) + 70; // 70-100
        const streak = Math.floor(Math.random() * 8) + 2; // 2-10

        // JACKPOT EFFECT
        if (rarity === 'LEGENDARIO' || rarity === 'MÍTICO') {
            jackpotOverlay.classList.remove('opacity-0');
            playSound('jackpot');
            setTimeout(() => jackpotOverlay.classList.add('opacity-0'), 1500);
        } else {
            playSound('stop');
        }

        setTimeout(() => {
            if (luckyImg) luckyImg.src = artist.imagenes.profile;
            if (luckyName) luckyName.textContent = artist.nombre;
            if (luckyRole) luckyRole.textContent = artist.estilo || 'Artist';
            if (luckyBio) luckyBio.textContent = artist.bio || 'Sin biografía disponible.';
            if (luckyOrigin) luckyOrigin.textContent = artist.origen || 'Desconocido';
            if (luckyStyle) luckyStyle.textContent = artist.estilo || '---';
            if (viewProfileLink) viewProfileLink.href = `/artista/${artist.slug}`;
            
            // New Creative Fields
            if (luckyRarity) {
                luckyRarity.textContent = rarity;
                // Color based on rarity
                const colors = {
                    'COMÚN': 'text-gray-400',
                    'RARO': 'text-blue-400',
                    'ÉPICO': 'text-purple-400',
                    'LEGENDARIO': 'text-yellow-400',
                    'MÍTICO': 'text-red-400'
                };
                luckyRarity.className = `font-black uppercase tracking-tighter text-lg ${colors[rarity]}`;
            }
            if (luckyPower) luckyPower.textContent = power;
            if (luckyPowerBar) luckyPowerBar.style.width = `${power}%`;
            
            if (luckyStreak && luckyStreakCount) {
                if (streak > 5) {
                    luckyStreak.classList.remove('hidden');
                    luckyStreakCount.textContent = `${streak} WIN STREAK`;
                } else {
                    luckyStreak.classList.add('hidden');
                }
            }

            luckyPanel.style.opacity = '1';
            luckyPanel.style.transform = 'translateX(0)';
        }, 50);
    }

    // SPIN LOGIC
    async function spin() {
        if (isSpinning || !slotReel) return;
        isSpinning = true;

        // Lever animation
        slotLever.style.transform = 'translateY(150px)';
        setTimeout(() => slotLever.style.transform = 'translateY(0)', 300);

        // Random pick
        const randomIndex = Math.floor(Math.random() * artists.length);
        const selected = artists[randomIndex];

        // Calculation
        const itemHeight = 64; // h-16
        const targetPos = (artists.length * 2 + randomIndex) * itemHeight;

        // Sound effect during spin
        const spinInterval = setInterval(() => playSound('spin'), 150);

        slotReel.style.transition = 'transform 3s cubic-bezier(0.1, 0, 0.1, 1)';
        slotReel.style.transform = `translateY(-${targetPos}px)`;

        setTimeout(() => {
            clearInterval(spinInterval);
            showArtist(selected);
            isSpinning = false;
            
            // Reset reel position seamlessly
            setTimeout(() => {
                slotReel.style.transition = 'none';
                const resetPos = randomIndex * itemHeight;
                slotReel.style.transform = `translateY(-${resetPos}px)`;
            }, 500);
        }, 3200);
    }

    // EVENTS
    slotLever?.addEventListener('click', spin);
    
    collectBtn?.addEventListener('click', () => {
        const name = luckyName.textContent;
        const collection = JSON.parse(localStorage.getItem('wild_collection') || '[]');
        if (!collection.includes(name)) {
            collection.push(name);
            localStorage.setItem('wild_collection', JSON.stringify(collection));
            alert(`¡${name} añadido a tu colección!`);
            
            // Feedback
            collectBtn.classList.add('bg-green-500');
            setTimeout(() => collectBtn.classList.remove('bg-green-500'), 1000);
        } else {
            alert('Este artista ya está en tu mazo.');
        }
    });

    filterLegendary?.addEventListener('click', () => {
        quickSelects.forEach(btn => {
            const shouldShow = Math.random() > 0.7; // Simulating legendary filter
            btn.style.display = shouldShow ? 'block' : 'none';
        });
        filterLegendary.classList.add('text-[var(--primary)]', 'border-[var(--primary)]/30');
        filterAll.classList.remove('text-[var(--primary)]', 'border-[var(--primary)]/30');
    });

    filterAll?.addEventListener('click', () => {
        quickSelects.forEach(btn => btn.style.display = 'block');
        filterAll.classList.add('text-[var(--primary)]', 'border-[var(--primary)]/30');
        filterLegendary.classList.remove('text-[var(--primary)]', 'border-[var(--primary)]/30');
    });
    
    quickSelects.forEach(btn => {
        btn.addEventListener('click', () => {
            const id = btn.getAttribute('data-id');
            const artist = artists.find(a => a.id == id);
            if (artist) showArtist(artist);
        });
    });

    // INIT
    initSlotMachine();

</script>

