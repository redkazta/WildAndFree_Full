const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Artistas",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};
---

<Layout config={config}>
  <div class="min-h-screen bg-[#0a0a0a] text-white font-sans overflow-hidden relative" id="page-container">
    
    <!-- BACKGROUND TEXTURE -->
    <div class="fixed inset-0 pointer-events-none opacity-20 z-0 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')]"></div>
    <div class="fixed inset-0 bg-gradient-to-b from-black via-transparent to-black pointer-events-none z-0"></div>
    
    <!-- MAIN CONTENT -->
    <div class="relative z-10 container mx-auto px-4 py-16 min-h-screen flex flex-col">
        
        <!-- HEADER -->
        <div class="mb-16 text-center animate-fade-in-down">
            <h1 class="text-xs font-black uppercase tracking-[0.5em] text-[var(--primary)] mb-4">Wild Gvng</h1>
            <h2 class="text-5xl md:text-7xl font-black uppercase tracking-tighter leading-none text-white italic drop-shadow-[0_0_30px_rgba(255,255,255,0.1)]">
                ARTISTAS
            </h2>
            <div class="w-24 h-1 bg-[var(--primary)] mx-auto mt-6 rounded-full"></div>
        </div>

        <!-- FILTERS (Simple) -->
        <div class="flex justify-center mb-12 animate-fade-in gap-4 overflow-x-auto pb-4 mask-fade-edges">
            <button class="filter-btn active px-6 py-2 rounded-full border border-white/10 text-[10px] font-black uppercase tracking-widest hover:bg-white/10 hover:border-white/30 transition-all text-gray-400 [&.active]:bg-[var(--primary)] [&.active]:text-black [&.active]:border-[var(--primary)]" data-filter="all">Todos</button>
            <button class="filter-btn px-6 py-2 rounded-full border border-white/10 text-[10px] font-black uppercase tracking-widest hover:bg-white/10 hover:border-white/30 transition-all text-gray-400 [&.active]:bg-[var(--primary)] [&.active]:text-black [&.active]:border-[var(--primary)]" data-filter="Trap">Trap</button>
            <button class="filter-btn px-6 py-2 rounded-full border border-white/10 text-[10px] font-black uppercase tracking-widest hover:bg-white/10 hover:border-white/30 transition-all text-gray-400 [&.active]:bg-[var(--primary)] [&.active]:text-black [&.active]:border-[var(--primary)]" data-filter="Rap">Rap</button>
            <button class="filter-btn px-6 py-2 rounded-full border border-white/10 text-[10px] font-black uppercase tracking-widest hover:bg-white/10 hover:border-white/30 transition-all text-gray-400 [&.active]:bg-[var(--primary)] [&.active]:text-black [&.active]:border-[var(--primary)]" data-filter="Drill">Drill</button>
        </div>

        <!-- ARTIST GRID -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-8">
            {artists.map((artist: any, index: number) => (
                <a 
                    href={`/artista/${artist.slug}`}
                    class="artist-card group relative aspect-[3/4] rounded-2xl overflow-hidden bg-zinc-900 border border-white/5 hover:border-[var(--primary)]/50 transition-all duration-500 hover:-translate-y-2 hover:shadow-[0_20px_50px_rgba(0,0,0,0.5)]"
                    data-style={artist.estilo}
                    style={`animation-delay: ${index * 50}ms`}
                >
                    <!-- Image -->
                    <img 
                        src={artist.imagenes.profile} 
                        alt={artist.nombre}
                        class="absolute inset-0 w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-110 transition-all duration-700"
                        loading="lazy"
                    />
                    
                    <!-- Gradient Overlay -->
                    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent opacity-80 group-hover:opacity-60 transition-opacity duration-500"></div>
                    
                    <!-- Content -->
                    <div class="absolute inset-0 p-6 flex flex-col justify-end">
                        <div class="transform translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                            <span class="text-[8px] font-bold text-[var(--primary)] uppercase tracking-[0.2em] mb-2 block opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">{artist.estilo}</span>
                            <h3 class="text-3xl font-black italic text-white uppercase tracking-tighter leading-none mb-2 drop-shadow-lg">{artist.nombre}</h3>
                            <p class="text-xs text-gray-300 line-clamp-2 opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-200">{artist.bio}</p>
                            
                            <!-- Arrow Icon -->
                            <div class="mt-4 flex justify-end opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-300">
                                <div class="w-8 h-8 rounded-full border border-white/20 flex items-center justify-center group-hover:bg-white group-hover:text-black transition-colors">
                                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"></path></svg>
                                </div>
                            </div>
                        </div>
                    </div>
                </a>
            ))}
        </div>

        <!-- LOAD MORE (Visual only) -->
        <div class="mt-20 text-center">
            <p class="text-[10px] font-mono text-gray-600 uppercase tracking-widest">Mostrando {artists.length} artistas</p>
        </div>

    </div>

  </div>
</Layout>

<script>
    // Simple Filter Logic
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cards = document.querySelectorAll('.artist-card');

    filterBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            // Active state
            filterBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');

            const filter = btn.getAttribute('data-filter');

            cards.forEach((card) => {
                const style = card.getAttribute('data-style') || '';
                if (filter === 'all' || (style && style.includes(filter))) {
                    (card as HTMLElement).style.display = 'block';
                    setTimeout(() => card.classList.remove('opacity-0', 'scale-95'), 50);
                } else {
                    card.classList.add('opacity-0', 'scale-95');
                    setTimeout(() => (card as HTMLElement).style.display = 'none', 300);
                }
            });
        });
    });
</script>

<style>
    .artist-card {
        animation: fade-in-up 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) backwards;
    }

    @keyframes fade-in-up {
        from { opacity: 0; transform: translateY(20px); }
        to { opacity: 1; transform: translateY(0); }
    }

    .mask-fade-edges {
        mask-image: linear-gradient(to right, transparent, black 10%, black 90%, transparent);
    }
</style>
