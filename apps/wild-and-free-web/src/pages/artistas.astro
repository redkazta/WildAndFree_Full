---
import Layout from '../layouts/Layout.astro';
import { getArtistsFromDB } from '../data/artists';
import type { Artist } from '../data/artists';

const config = {
  name: "Wild Gvng - Roster",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
};

// Fetch artists from Supabase at build time
const artists = await getArtistsFromDB();

// Extract unique genres from all artists
const allGenres = new Set<string>();
artists.forEach(a => a.estilo.split(' / ').forEach(g => allGenres.add(g)));
const genres = ['Todos', ...Array.from(allGenres).sort()];
---

<Layout config={config}>
  <div class="roster-page">

    <!-- HEADER MINIMALISTA -->
    <header class="roster-header">
      <div class="container">
        <p class="roster-eyebrow">WILD GVNG</p>
        <h1 class="roster-title">Roster</h1>
      </div>
    </header>

    <!-- FILTERS -->
    <section class="filters-section">
      <div class="container">
        <div class="filters-row">
          {genres.map((g, i) => (
            <button
              class={`filter-chip ${i === 0 ? 'active' : ''}`}
              data-genre={g.toLowerCase()}
              onclick={`filterArtists('${g.toLowerCase()}')`}
            >
              {g}
            </button>
          ))}
        </div>
        <div class="results-count">
          <span id="artist-count">{artists.length}</span> artistas en el roster
        </div>
      </div>
    </section>

    <!-- ROSTER GRID -->
    <section class="roster-grid-section">
      <div class="container">
        <div class="roster-grid" id="roster-grid">
          {artists.map((artist, idx) => (
            <a
              href={`/artista/${artist.slug}`}
              class="artist-card"
              data-genre={artist.estilo.toLowerCase()}
              style={`animation-delay: ${idx * 0.08}s`}
            >
              <!-- Photo -->
              <div class="card-photo">
                {artist.imagenes.profile ? (
                  <img
                    src={artist.imagenes.profile}
                    alt={artist.nombre}
                    width="400"
                    height="400"
                    loading="lazy"
                  />
                ) : (
                  <div class="card-initials">
                    {artist.nombre.substring(0, 2).toUpperCase()}
                  </div>
                )}
                <div class="card-glow"></div>
              </div>

              <!-- Info -->
              <div class="card-info">
                <h3 class="card-name">{artist.nombre}</h3>
                <span class="card-genre">{artist.estilo}</span>
                <span class="card-origin">📍 {artist.origen}</span>
                {artist.tags && artist.tags.length > 0 && (
                  <div class="card-tags">
                    {artist.tags.slice(0, 3).map(tag => (
                      <span class={`tag-badge tag-sm ${tag.animation && tag.animation !== 'none' ? `tag-anim-${tag.animation}` : ''}`} style={`--tag-c: ${tag.color}`}><span class="tag-badge-dot"></span>{tag.name}</span>
                    ))}
                  </div>
                )}
              </div>

              <!-- Partnear Button -->
              <div class="card-action">
                <button
                  class="partnear-btn"
                  onclick={`event.preventDefault(); togglePartnear('${artist.id}')`}
                  data-artist-id={artist.id}
                >
                  <span class="partnear-icon">🔥</span>
                  <span class="partnear-label">PARTNEAR</span>
                  <span class="partnear-count">{artist.stats.partnean}</span>
                </button>
              </div>

              <!-- Stats Row -->
              <div class="card-stats">
                <span class="stat">🎵 {artist.tracks.length} tracks</span>
                <span class="stat">🔥 {artist.stats.partnean} partnean</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- JOIN CTA -->
    <section class="join-section">
      <div class="container">
        <div class="join-card">
          <div class="join-content">
            <span class="join-label">¿ERES ARTISTA?</span>
            <h2 class="join-title">ÚNETE AL <span class="text-wild-orange">ROSTER</span></h2>
            <p class="join-desc">Crea tu cuenta como artista y forma parte del movimiento urbano de Torreón.</p>
            <a href="/registro" class="join-btn">REGISTRARME COMO ARTISTA</a>
          </div>
        </div>
      </div>
    </section>

  </div>
</Layout>

<style>
  /* ===== GLOBALS ===== */
  .roster-page {
    min-height: 100vh;
    background: var(--bg);
    overflow-x: hidden;
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* ===== HEADER (MINIMALISTA) ===== */
  .roster-header {
    padding: 48px 0 12px;
    border-bottom: 1px solid var(--border-faint);
  }
  .roster-eyebrow {
    margin: 0 0 6px;
    font-size: 0.6rem;
    font-weight: 800;
    letter-spacing: 0.35em;
    text-transform: uppercase;
    color: var(--primary);
    font-family: monospace;
  }
  .roster-title {
    margin: 0;
    font-size: 3rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--text);
    line-height: 1;
  }
  @media (max-width: 768px) {
    .roster-header { padding: 32px 0 12px; }
    .roster-title { font-size: 2.2rem; }
  }

  /* ===== FILTERS ===== */
  .filters-section {
    padding: 32px 0 16px;
    border-bottom: 1px solid var(--border-faint);
  }
  .filters-row {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    justify-content: center;
  }
  .filter-chip {
    padding: 8px 18px;
    border-radius: 100px;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: var(--bg-card);
    border: 1px solid var(--bg-hover);
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }
  .filter-chip:hover {
    border-color: var(--border-soft);
    color: var(--text);
  }
  .filter-chip.active {
    background: rgba(201,131,0,0.15);
    border-color: rgba(201,131,0,0.5);
    color: #C98300;
  }
  .results-count {
    text-align: center;
    margin-top: 12px;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--border-soft);
  }

  /* ===== ROSTER GRID ===== */
  .roster-grid-section {
    padding: 40px 0 80px;
  }
  .roster-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  @media (max-width: 900px) {
    .roster-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .roster-grid { grid-template-columns: 1fr; }
  }

  /* ===== ARTIST CARD ===== */
  .artist-card {
    background: var(--bg-card);
    border: 1px solid var(--border-faint);
    border-radius: 20px;
    overflow: hidden;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    animation: fadeUp 0.6s ease-out backwards;
  }
  .artist-card:hover {
    transform: translateY(-6px);
    border-color: rgba(201,131,0,0.4);
    box-shadow: 0 20px 60px -15px rgba(201,131,0,0.15);
  }
  .artist-card.hidden {
    display: none;
  }

  /* Photo */
  .card-photo {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }
  .card-photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.6s ease;
  }
  .artist-card:hover .card-photo img {
    transform: scale(1.05);
  }
  .card-initials {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 3rem;
    font-weight: 900;
    color: var(--primary);
    background: var(--bg-card);
    border: 1px solid var(--border);
  }
  .card-glow {
    position: absolute;
    inset: 0;
    opacity: 0;
    background: radial-gradient(circle at 50% 0%, rgba(201,131,0,0.2) 0%, transparent 70%);
    transition: opacity 0.4s;
  }
  .artist-card:hover .card-glow {
    opacity: 1;
  }

  /* Info */
  .card-info {
    padding: 20px 20px 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
    flex: 1;
  }
  .card-name {
    font-size: 1.1rem;
    font-weight: 900;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
  }
  .card-genre {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: #C98300;
    font-family: monospace;
  }
  .card-origin {
    font-size: 0.65rem;
    color: var(--border-soft);
    margin-top: 2px;
  }
  .card-tags {
    display: flex;
    gap: 4px;
    margin-top: 6px;
    flex-wrap: wrap;
  }
  .card-tag {
    padding: 2px 8px;
    border-radius: 100px;
    font-size: 0.5rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    border: 1px solid;
    font-family: monospace;
  }

  /* Partnear */
  .card-action {
    padding: 16px 20px 0;
  }
  .partnear-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 10px;
    border-radius: 12px;
    background: var(--bg-card);
    border: 1px solid var(--bg-hover);
    color: var(--text-muted);
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }
  .partnear-btn:hover {
    background: rgba(201,131,0,0.1);
    border-color: rgba(201,131,0,0.3);
    color: #C98300;
  }
  .partnear-btn.active {
    background: rgba(201,131,0,0.15);
    border-color: rgba(201,131,0,0.5);
    color: #C98300;
  }
  .partnear-icon { font-size: 0.8rem; }
  .partnear-label {
    font-size: 0.6rem;
    font-weight: 900;
    letter-spacing: 0.15em;
  }
  .partnear-count {
    font-size: 0.6rem;
    font-weight: 700;
    color: var(--border-soft);
  }

  /* Stats */
  .card-stats {
    padding: 12px 20px 16px;
    display: flex;
    justify-content: space-between;
    border-top: 1px solid var(--bg-card);
    margin-top: 12px;
  }
  .stat {
    font-size: 0.6rem;
    font-weight: 600;
    color: var(--border-soft);
  }

  /* ===== JOIN CTA ===== */
  .join-section {
    padding: 0 0 80px;
  }
  .join-card {
    background: linear-gradient(135deg, rgba(201,131,0,0.08), rgba(138,3,3,0.05));
    border: 1px solid rgba(201,131,0,0.15);
    border-radius: 24px;
    padding: 48px;
    text-align: center;
  }
  .join-label {
    font-size: 0.6rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--border-soft);
    font-family: monospace;
  }
  .join-title {
    font-size: 2rem;
    font-weight: 900;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 8px 0 12px;
  }
  .join-desc {
    font-size: 0.85rem;
    color: var(--text-muted);
    max-width: 400px;
    margin: 0 auto 24px;
    line-height: 1.6;
  }
  .join-btn {
    display: inline-block;
    padding: 14px 32px;
    background: #C98300;
    color: var(--bg);
    font-size: 0.7rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    border-radius: 14px;
    text-decoration: none;
    transition: all 0.3s;
  }
  .join-btn:hover {
    background: #e69500;
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(201,131,0,0.3);
  }

  /* ===== ANIMATIONS ===== */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes pulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }
</style>

<script>
  // Genre filter
  // @ts-ignore
  window.filterArtists = function(genre: string) {
    const cards = document.querySelectorAll('.artist-card');
    const chips = document.querySelectorAll('.filter-chip');
    const countEl = document.getElementById('artist-count');

    chips.forEach(c => c.classList.remove('active'));
    document.querySelector(`[data-genre="${genre}"]`)?.classList.add('active');

    let visible = 0;
    cards.forEach(card => {
      const el = card as HTMLElement;
      if (genre === 'todos' || el.dataset.genre?.includes(genre)) {
        el.classList.remove('hidden');
        visible++;
      } else {
        el.classList.add('hidden');
      }
    });
    if (countEl) countEl.textContent = String(visible);
  }

  // Partnear toggle
  const partnearState: Record<string, boolean> = {};
// @ts-ignore
window.togglePartnear = function(artistId: string) {
  const btn = document.querySelector(`[data-artist-id="${artistId}"]`) as HTMLElement;
  if (!btn) return;

  partnearState[artistId] = !partnearState[artistId];
  const countEl = btn.querySelector('.partnear-count');
  const baseCount = parseInt(countEl?.textContent || '0');

  if (partnearState[artistId]) {
    btn.classList.add('active');
    if (countEl) countEl.textContent = String(baseCount + 1);
  } else {
    btn.classList.remove('active');
    if (countEl) countEl.textContent = String(Math.max(0, baseCount - 1));
  }
}


</script>
