const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Artistas",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};
---

<Layout config={config}>
  <div class="min-h-screen bg-[#050505] overflow-x-hidden">
    
    <!-- SECTION 1: HERO SPOTLIGHT (Sticky) -->
    <section class="relative h-[60vh] md:h-[70vh] w-full overflow-hidden flex flex-col md:flex-row border-b border-white/10" id="roster-hero">
        
        <!-- BACKGROUND (Full Screen Image) -->
        <div class="absolute inset-0 z-0 transition-all duration-700 ease-out" id="artist-bg">
            <div class="absolute inset-0 bg-gradient-to-r from-[#050505] via-[#050505]/80 to-transparent z-10"></div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#050505] via-[#050505]/50 to-transparent z-10"></div>
            <img 
                id="bg-image" 
                src={artists[0].imagenes.profile} 
                class="w-full h-full object-cover opacity-40 scale-105 transition-transform duration-[2000ms]" 
            />
        </div>

        <!-- NOISE & TEXTURE OVERLAY -->
        <div class="absolute inset-0 z-0 opacity-[0.15] pointer-events-none bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] mix-blend-overlay"></div>
        <div class="absolute inset-0 z-0 opacity-10 pointer-events-none animate-noise bg-repeat"></div>

        <!-- MAIN INTERFACE -->
        <div class="relative z-20 w-full h-full flex flex-col md:flex-row container mx-auto px-4 md:px-8">
            
            <!-- LEFT: ARTIST LIST (The Roster) -->
            <div class="w-full md:w-[35%] h-full flex flex-col justify-center py-8 relative z-30">
                <!-- Decorative Header -->
                <div class="flex items-center gap-3 mb-6">
                    <div class="w-2 h-2 bg-[var(--wild-orange)] rounded-full animate-pulse"></div>
                    <span class="text-[10px] font-mono text-gray-500 uppercase tracking-[0.3em]">Featured Artists</span>
                </div>

                <!-- Scrollable List -->
                <div class="h-[200px] md:h-[400px] overflow-y-auto pr-4 space-y-1 no-scrollbar mask-gradient-y" id="artist-list">
                    {artists.map((artist: any, idx: number) => (
                        <button 
                            class={`artist-trigger group w-full text-left py-2 md:py-3 transition-all duration-300 focus:outline-none flex items-center justify-between border-b border-white/5 hover:border-[var(--wild-orange)] hover:pl-4 ${idx === 0 ? 'active' : ''}`}
                            data-index={idx}
                            data-image={artist.imagenes.profile}
                            data-name={artist.nombre}
                            data-bio={artist.bio}
                            data-style={artist.estilo}
                            data-origin={artist.origen}
                            data-slug={artist.slug}
                        >
                            <h3 class="text-xl md:text-2xl font-black uppercase italic text-gray-600 group-hover:text-white transition-colors duration-300 leading-none group-[.active]:text-white">
                                {artist.nombre}
                            </h3>
                            <span class="text-[9px] text-[var(--wild-orange)] opacity-0 group-hover:opacity-100 group-[.active]:opacity-100 transition-opacity font-mono tracking-widest">
                                {artist.estilo}
                            </span>
                        </button>
                    ))}
                </div>
            </div>

            <!-- RIGHT: SELECTED ARTIST DETAILS -->
            <div class="w-full md:w-[65%] h-full flex flex-col justify-end md:justify-center p-6 md:p-12 relative pointer-events-none">
                 <div id="artist-details" class="space-y-4 md:space-y-6 pointer-events-auto transform translate-y-0 transition-all duration-500">
                    
                    <!-- Badge -->
                    <div class="overflow-hidden">
                        <span id="detail-style" class="inline-block px-3 py-1 bg-[var(--wild-orange)]/10 border border-[var(--wild-orange)] text-[var(--wild-orange)] text-[9px] font-black uppercase tracking-[0.3em] backdrop-blur-md animate-slide-up">
                            {artists[0].estilo}
                        </span>
                    </div>
                    
                    <!-- Name -->
