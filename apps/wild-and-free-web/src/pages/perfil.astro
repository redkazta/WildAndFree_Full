---
import Layout from '../layouts/Layout.astro';
---

<Layout config={{
  name: "Wild Gvng - Mi Perfil",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>
  <div class="profile-container opacity-0 transition-opacity duration-500" id="profile-main">
    <!-- Unauthenticated State -->
    <div id="unauth-state" class="hidden flex flex-col items-center justify-center min-h-[60vh] text-center space-y-8">
      <div class="w-24 h-24 bg-white/5 rounded-full flex items-center justify-center mb-4">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-500"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <div class="space-y-2">
        <h2 class="text-3xl font-black text-white uppercase tracking-tighter">Acceso Restringido</h2>
        <p class="text-white/40 text-sm font-bold uppercase tracking-widest">Debes iniciar sesión para ver tu perfil</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 pt-4">
        <a href="/login" class="px-12 py-4 bg-white text-black text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-orange-500 hover:text-white transition-all">Iniciar Sesión</a>
        <a href="/registro" class="px-12 py-4 bg-white/5 border border-white/10 text-white text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-white/10 transition-all">Crear Cuenta</a>
      </div>
    </div>

    <!-- Authenticated Content -->
    <div id="auth-content" class="hidden">
      <div class="profile-header-section">
        <div class="profile-avatar-large">
          <div id="avatar-placeholder" class="w-full h-full bg-gradient-to-br from-orange-500 to-red-600 flex items-center justify-center text-4xl font-black text-white uppercase">
            WG
          </div>
          <img id="profile-avatar-img" src="" alt="Avatar" class="hidden">
          <button class="avatar-edit">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
            </svg>
          </button>
        </div>
        <div class="profile-info-main">
          <h1 id="profile-name">Cargando...</h1>
          <p class="username" id="profile-username">@usuario</p>
          <p class="bio" id="profile-bio">Cargando biografía...</p>
          <div class="profile-stats">
            <div class="stat">
              <span class="stat-number" id="stat-following">0</span>
              <span class="stat-label">Siguiendo</span>
            </div>
            <div class="stat">
              <span class="stat-number" id="stat-followers">0</span>
              <span class="stat-label">Seguidores</span>
            </div>
            <div class="stat">
              <span class="stat-number" id="stat-favorites">0</span>
              <span class="stat-label">Favoritos</span>
            </div>
          </div>
        </div>
        <button class="edit-profile-btn">Editar Perfil</button>
      </div>

      <div class="profile-content">
        <div class="profile-tabs">
          <button class="tab active" data-tab="overview">Resumen</button>
          <button class="tab" data-tab="music">Música</button>
          <button class="tab" data-tab="playlists">Playlists</button>
          <button class="tab" data-tab="following">Siguiendo</button>
        </div>

        <div class="tab-content active" id="overview">
          <div class="content-grid">
            <div class="content-section">
              <h3>Artistas Favoritos</h3>
              <div class="artist-grid">
                <div class="artist-card">
                  <img src="https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=80&h=80&fit=crop" alt="Artista">
                  <span>Artista 1</span>
                </div>
                <div class="artist-card">
                  <img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=80&h=80&fit=crop" alt="Artista">
                  <span>Artista 2</span>
                </div>
                <div class="artist-card">
                  <img src="https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?w=80&h=80&fit=crop" alt="Artista">
                  <span>Artista 3</span>
                </div>
              </div>
            </div>

            <div class="content-section">
              <h3>Actividad Reciente</h3>
              <div class="activity-list">
                <div class="activity-item">
                  <div class="activity-icon">🎵</div>
                  <div class="activity-info">
                    <p>Escuchaste <strong>Track Urbano</strong></p>
                    <span>hace 2 horas</span>
                  </div>
                </div>
                <div class="activity-item">
                  <div class="activity-icon">❤️</div>
                  <div class="activity-info">
                    <p>Agregaste <strong>Album Nueva Era</strong> a favoritos</p>
                    <span>hace 1 día</span>
                  </div>
                </div>
                <div class="activity-item">
                  <div class="activity-icon">🎫</div>
                  <div class="activity-info">
                    <p>Compraste entrada para <strong>Show Wild Gvng</strong></p>
                    <span>hace 3 días</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="tab-content" id="music">
          <div class="music-section">
            <h3>Canciones Más Escuchadas</h3>
            <div class="track-list">
              <div class="track-item">
                <div class="track-number">1</div>
                <img src="https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=50&h=50&fit=crop" alt="Album" class="track-image">
                <div class="track-info">
                  <h4>Urban Flow</h4>
                  <p>Artista Principal</p>
                </div>
                <span class="track-plays">234 reproducciones</span>
              </div>
            </div>
          </div>
        </div>

        <div class="tab-content" id="playlists">
          <div class="playlists-section">
            <h3>Mis Playlists</h3>
            <div class="playlist-grid">
              <div class="playlist-card">
                <img src="https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=120&h=120&fit=crop" alt="Playlist" class="playlist-cover">
                <h4>Urban Essentials</h4>
                <p>45 tracks • 2.3K seguidores</p>
                <button class="play-btn">▶</button>
              </div>
            </div>
          </div>
        </div>

        <div class="tab-content" id="following">
          <div class="following-section">
            <h3>Siguiendo</h3>
            <div class="following-grid">
              <div class="following-card">
                <img src="https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=60&h=60&fit=crop" alt="Artista" class="following-avatar">
                <div class="following-info">
                  <h4>Artista Principal</h4>
                  <p>2.1M seguidores</p>
                </div>
                <button class="following-btn following">Siguiendo</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .profile-container {
    min-height: 100vh;
    padding: 80px 20px 40px;
    background: linear-gradient(135deg, #000 0%, #111 50%, #000 100%);
    position: relative;
  }

  .profile-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 20% 80%, rgba(201, 131, 0, 0.05) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(138, 3, 3, 0.05) 0%, transparent 50%);
    pointer-events: none;
  }

  .profile-header-section {
    max-width: 1200px;
    margin: 0 auto 40px;
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 40px;
    background: rgba(17, 17, 17, 0.8);
    border: 1px solid rgba(201, 131, 0, 0.3);
    border-radius: 16px;
    backdrop-filter: blur(10px);
    position: relative;
    z-index: 1;
  }

  .profile-avatar-large {
    position: relative;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--primary-color);
  }

  .profile-avatar-large img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .avatar-edit {
    position: absolute;
    bottom: 0;
    right: 0;
    background: var(--primary-color);
    border: none;
    border-radius: 50%;
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
  }

  .avatar-edit:hover {
    background: #e69500;
    transform: scale(1.1);
  }

  .profile-info-main h1 {
    margin: 0 0 8px 0;
    font-size: 32px;
    color: #fff;
    font-family: 'Noto Sans JP', sans-serif;
    letter-spacing: 0.02em;
  }

  .username {
    margin: 0 0 8px 0;
    color: var(--primary-color);
    font-size: 18px;
    font-weight: 500;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .bio {
    margin: 0 0 20px 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: 16px;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .profile-stats {
    display: flex;
    gap: 24px;
  }

  .stat {
    text-align: center;
  }

  .stat-number {
    display: block;
    font-size: 24px;
    font-weight: 700;
    color: #fff;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .stat-label {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
    font-family: 'Noto Sans JP', sans-serif;
  }

  .edit-profile-btn {
    margin-left: auto;
    padding: 12px 24px;
    background: var(--primary-color);
    border: none;
    border-radius: 8px;
    color: #000;
    font-size: 14px;
    font-weight: 600;
    font-family: 'Noto Sans JP', sans-serif;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
  }

  .edit-profile-btn:hover {
    background: #e69500;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(201, 131, 0, 0.3);
  }

  .profile-content {
    max-width: 1200px;
    margin: 0 auto;
    position: relative;
    z-index: 1;
  }

  .profile-tabs {
    display: flex;
    gap: 32px;
    margin-bottom: 40px;
    border-bottom: 1px solid rgba(201, 131, 0, 0.2);
    padding-bottom: 0;
  }

  .tab {
    padding: 16px 0;
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    font-size: 16px;
    font-family: 'Noto Sans JP', sans-serif;
    cursor: pointer;
    transition: all 0.2s;
    position: relative;
    letter-spacing: 0.02em;
  }

  .tab:hover {
    color: #fff;
  }

  .tab.active {
    color: var(--primary-color);
  }

  .tab.active::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--primary-color);
  }

  .tab-content {
    display: none;
  }

  .tab-content.active {
    display: block;
  }

  .content-grid {
    display: grid;
    grid-template-columns: 2fr 1fr;
    gap: 40px;
  }

  .content-section {
    background: rgba(17, 17, 17, 0.8);
    border: 1px solid rgba(201, 131, 0, 0.2);
    border-radius: 12px;
    padding: 24px;
  }

  .content-section h3 {
    margin: 0 0 20px 0;
    font-size: 20px;
    color: #fff;
    font-family: 'Noto Sans JP', sans-serif;
    letter-spacing: 0.02em;
  }

  .artist-grid {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .artist-card {
    text-align: center;
    cursor: pointer;
    transition: all 0.2s;
  }

  .artist-card:hover {
    transform: translateY(-4px);
  }

  .artist-card img {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    object-fit: cover;
    margin-bottom: 8px;
    border: 2px solid rgba(201, 131, 0, 0.3);
  }

  .artist-card span {
    display: block;
    font-size: 14px;
    color: #fff;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .activity-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .activity-item {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
  }

  .activity-icon {
    font-size: 20px;
    width: 40px;
    text-align: center;
  }

  .activity-info p {
    margin: 0 0 4px 0;
    color: #fff;
    font-size: 14px;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .activity-info span {
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
    font-family: 'Noto Sans JP', sans-serif;
  }

  .music-section, .playlists-section, .following-section {
    background: rgba(17, 17, 17, 0.8);
    border: 1px solid rgba(201, 131, 0, 0.2);
    border-radius: 12px;
    padding: 24px;
  }

  .music-section h3, .playlists-section h3, .following-section h3 {
    margin: 0 0 20px 0;
    font-size: 20px;
    color: #fff;
    font-family: 'Noto Sans JP', sans-serif;
    letter-spacing: 0.02em;
  }

  .track-list, .playlist-grid, .following-grid {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .track-item, .playlist-card, .following-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 12px;
    background: rgba(255, 255, 255, 0.05);
    border-radius: 8px;
    transition: all 0.2s;
  }

  .track-item:hover, .playlist-card:hover, .following-card:hover {
    background: rgba(201, 131, 0, 0.1);
  }

  .track-number {
    width: 24px;
    text-align: center;
    color: rgba(255, 255, 255, 0.6);
    font-family: 'Noto Sans JP', sans-serif;
  }

  .track-image, .playlist-cover, .following-avatar {
    width: 50px;
    height: 50px;
    object-fit: cover;
    border-radius: 4px;
  }

  .track-info h4, .playlist-info h4, .following-info h4 {
    margin: 0 0 4px 0;
    font-size: 14px;
    color: #fff;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .track-info p, .playlist-info p, .following-info p {
    margin: 0;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
    font-family: 'Noto Sans JP', sans-serif;
  }

  .track-plays {
    margin-left: auto;
    font-size: 12px;
    color: rgba(255, 255, 255, 0.6);
    font-family: 'Noto Sans JP', sans-serif;
  }

  .play-btn {
    margin-left: auto;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--primary-color);
    border: none;
    color: #000;
    font-size: 14px;
    cursor: pointer;
    transition: all 0.2s;
  }

  .play-btn:hover {
    background: #e69500;
    transform: scale(1.1);
  }

  .following-btn {
    margin-left: auto;
    padding: 8px 16px;
    background: none;
    border: 1px solid rgba(201, 131, 0, 0.3);
    border-radius: 6px;
    color: #fff;
    font-size: 12px;
    font-family: 'Noto Sans JP', sans-serif;
    cursor: pointer;
    transition: all 0.2s;
  }

  .following-btn.following {
    background: rgba(201, 131, 0, 0.1);
    border-color: var(--primary-color);
    color: var(--primary-color);
  }

  .following-btn:hover {
    background: rgba(201, 131, 0, 0.2);
  }

  @media (max-width: 768px) {
    .profile-container {
      padding: 60px 12px 40px;
    }

    .profile-header-section {
      flex-direction: column;
      text-align: center;
      gap: 20px;
      padding: 30px 20px;
      margin-bottom: 30px;
    }

    .profile-avatar-large {
      width: 100px;
      height: 100px;
    }

    .profile-info-main h1 {
      font-size: 24px;
    }

    .profile-stats {
      justify-content: center;
      gap: 16px;
    }

    .stat-number {
      font-size: 18px;
    }

    .edit-profile-btn {
      margin-left: 0;
      width: 100%;
    }

    .profile-tabs {
      overflow-x: auto;
      gap: 16px;
      padding-bottom: 4px;
      margin-bottom: 24px;
      scrollbar-width: none;
    }
    
    .profile-tabs::-webkit-scrollbar {
      display: none;
    }

    .tab {
      font-size: 14px;
      white-space: nowrap;
    }

    .content-grid {
      grid-template-columns: 1fr;
      gap: 20px;
    }
    
    .content-section {
      padding: 16px;
    }

    .artist-grid {
      justify-content: center;
      gap: 12px;
    }
    
    .artist-card img {
      width: 60px;
      height: 60px;
    }
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  document.addEventListener('DOMContentLoaded', async () => {
    const profileMain = document.getElementById('profile-main');
    const unauthSection = document.getElementById('unauth-state');
    const authContent = document.getElementById('auth-content');
    
    // 1. Check Session
    const { data: { session } } = await supabase.auth.getSession();
    
    if (!session) {
      unauthSection?.classList.remove('hidden');
      profileMain?.classList.remove('opacity-0');
      return;
    }

    // 2. Fetch Profile Data
    const { data: profile, error } = await supabase
      .from('profiles')
      .select('*')
      .eq('id', session.user.id)
      .single();

    if (error) {
      console.error('Error fetching profile:', error);
      unauthSection?.classList.remove('hidden');
      profileMain?.classList.remove('opacity-0');
      return;
    }

    // 3. Update UI
    authContent?.classList.remove('hidden');
    const nameEl = document.getElementById('profile-name');
    const usernameEl = document.getElementById('profile-username');
    const bioEl = document.getElementById('profile-bio');
    const avatarImg = document.getElementById('profile-avatar-img');
    const avatarPlaceholder = document.getElementById('avatar-placeholder');

    if (nameEl) nameEl.textContent = profile.nombre || 'Usuario Wild';
    if (usernameEl) usernameEl.textContent = `@${profile.nombre?.toLowerCase().replace(/\s/g, '_') || 'usuario'}`;
    if (bioEl) bioEl.textContent = profile.bio || 'Miembro de Wild Gvng • Amante del hip-hop urbano';
    
    if (profile.avatar_url && avatarImg instanceof HTMLImageElement) {
      avatarImg.src = profile.avatar_url;
      avatarImg.classList.remove('hidden');
      avatarPlaceholder?.classList.add('hidden');
    } else if (avatarPlaceholder) {
      avatarPlaceholder.textContent = profile.nombre?.substring(0, 2).toUpperCase() || 'WG';
    }

    // 4. Show Content
    profileMain?.classList.remove('opacity-0');

    // Tab functionality
    const tabs = document.querySelectorAll('.tab');
    const tabContents = document.querySelectorAll('.tab-content');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetTab = tab instanceof HTMLElement ? tab.dataset.tab : null;
        tabs.forEach(t => t.classList.remove('active'));
        tabContents.forEach(content => content.classList.remove('active'));
        tab.classList.add('active');
        const targetContent = targetTab ? document.getElementById(targetTab) : null;
        if (targetContent) targetContent.classList.add('active');
      });
    });

    // Edit profile button
    const editBtn = document.querySelector('.edit-profile-btn');
    if (editBtn) {
      editBtn.addEventListener('click', () => {
        alert('Función de edición de perfil - Próximamente');
      });
    }

    // Avatar edit button
    const avatarEdit = document.querySelector('.avatar-edit');
    if (avatarEdit) {
      avatarEdit.addEventListener('click', () => {
        alert('Función de cambio de avatar - Próximamente');
      });
    }

    // Following buttons
    const followingBtns = document.querySelectorAll('.following-btn');
    followingBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.classList.contains('following')) {
          btn.classList.remove('following');
          btn.textContent = 'Seguir';
        } else {
          btn.classList.add('following');
          btn.textContent = 'Siguiendo';
        }
      });
    });

    // Play buttons
    const playBtns = document.querySelectorAll('.play-btn');
    playBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.textContent === '▶') {
          btn.textContent = '⏸';
        } else {
          btn.textContent = '▶';
        }
      });
    });
  });
</script>
