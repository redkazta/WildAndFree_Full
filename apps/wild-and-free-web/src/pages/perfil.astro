---
import Layout from '../layouts/Layout.astro';
---

<Layout config={{
  name: "Wild Gvng - Mi Perfil",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>
  <div class="pf" id="profile-main">

    <!-- UNAUTHENTICATED STATE -->
    <div id="unauth-state" class="unauth hidden">
      <div class="unauth-icon">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <h2 class="unauth-title">Acceso Restringido</h2>
      <p class="unauth-sub">Debes iniciar sesión para ver tu perfil</p>
      <div class="unauth-actions">
        <a href="/login" class="btn-p btn-gold">Iniciar Sesión</a>
        <a href="/registro" class="btn-p btn-ghost">Crear Cuenta</a>
      </div>
    </div>

    <!-- AUTHENTICATED CONTENT -->
    <div id="auth-content" class="auth hidden">

      <div class="pf-body">
        <div class="pf-grid">

          <!-- LEFT SIDEBAR (25%) -->
          <aside class="pf-side">
            <!-- Avatar Card -->
            <div class="side-card">
              <div class="side-avatar-wrap">
                <div class="side-avatar-box" id="avatar-box">
                  <div id="avatar-placeholder" class="avatar-initials">WG</div>
                  <img id="profile-avatar-img" src="" alt="Avatar" class="avatar-img hidden" />
                </div>
                <button class="avatar-edit-btn" id="avatar-edit-btn" title="Cambiar foto">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/></svg>
                </button>
              </div>
              <h2 class="side-name" id="profile-name">Cargando...</h2>
              <p class="side-username" id="profile-username">@usuario</p>
              <div class="side-tags" id="profile-role-tags"></div>
            </div>

            <!-- Bio Card -->
            <div class="side-card" id="bio-card">
              <h4 class="side-label">SOBRE MÍ</h4>
              <p class="side-bio" id="profile-bio">Cargando biografía...</p>
            </div>

            <!-- Stats Card -->
            <div class="side-card">
              <h4 class="side-label">ESTADÍSTICAS</h4>
              <div class="side-stats">
                <div class="stat-item">
                  <span class="stat-num" id="stat-following">0</span>
                  <span class="stat-label">Siguiendo</span>
                </div>
                <div class="stat-item">
                  <span class="stat-num" id="stat-partnean">0</span>
                  <span class="stat-label">Partnean</span>
                </div>
                <div class="stat-item">
                  <span class="stat-num" id="stat-posts">0</span>
                  <span class="stat-label">Posts</span>
                </div>
              </div>
            </div>

            <!-- Logout -->
            <div class="side-card">
              <button class="logout-btn" id="profile-logout-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Cerrar Sesión
              </button>
            </div>
          </aside>

          <!-- RIGHT FEED (75%) -->
          <div class="pf-feed">

            <!-- Tabs -->
            <div class="feed-tabs">
              <button class="feed-tab active" data-tab="posts">MIS POSTS</button>
              <button class="feed-tab" data-tab="likes">ME GUSTA</button>
              <button class="feed-tab" data-tab="reposts">REPOSTS</button>
            </div>

            <!-- MIS POSTS Tab -->
            <div class="feed-tab-content active" data-tab-content="posts">
              <div class="feed-list" id="my-posts-list">
                <p class="feed-empty" id="my-posts-empty">Cargando posts...</p>
              </div>
            </div>

            <!-- ME GUSTA Tab -->
            <div class="feed-tab-content" data-tab-content="likes">
              <div class="feed-list" id="liked-posts-list"></div>
              <p class="feed-empty" id="liked-posts-empty">Cargando likes...</p>
            </div>

            <!-- REPOSTS Tab -->
            <div class="feed-tab-content" data-tab-content="reposts">
              <div class="feed-list" id="reposted-posts-list"></div>
              <p class="feed-empty" id="reposted-posts-empty">Cargando reposts...</p>
            </div>

          </div>

        </div>
      </div>

    </div>

  </div>
</Layout>

<style>
  /* ============================================
     CSS VARIABLES (from Layout)
     --primary: #c98300
     --secondary: #8a0303
     --bg: #000000
     --bg-card: rgba(255,255,255,0.03)
     --border: rgba(255,255,255,0.12)
     --text: #ffffff
     --text-secondary: rgba(255,255,255,0.6)
     --text-muted: rgba(255,255,255,0.25)
     ============================================ */

  .pf {
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* ── UNAUTH STATE ── */
  .unauth {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    text-align: center;
    gap: 20px;
    padding: 40px 20px;
  }
  .unauth.hidden { display: none; }
  .unauth-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--bg-card);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
  }
  .unauth-title {
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .unauth-sub {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin: 0;
  }
  .unauth-actions {
    display: flex;
    gap: 10px;
    padding-top: 12px;
  }

  /* ── BUTTONS ── */
  .btn-p {
    padding: 10px 28px;
    border-radius: 8px;
    font-size: 0.6rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: all 0.15s;
  }
  .btn-gold {
    background: var(--primary);
    border: none;
    color: #000;
  }
  .btn-gold:hover { background: #e69500; }
  .btn-ghost {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
  }
  .btn-ghost:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  /* ── GRID ── */
  .auth.hidden { display: none; }
  .pf-body {
    max-width: 90%;
    margin: 0 auto;
    padding: 0 0 60px;
  }
  .pf-grid {
    display: grid;
    grid-template-columns: 25% 75%;
    gap: 20px;
    margin-top: 20px;
  }

  /* ── SIDEBAR ── */
  .pf-side {
    position: sticky;
    top: 24px;
  }
  .side-card {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
    margin-bottom: 10px;
  }
  .side-avatar-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 12px;
    position: relative;
  }
  .side-avatar-box {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--border);
    background: var(--bg-card);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .avatar-initials {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--primary);
    user-select: none;
  }
  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .avatar-img.hidden { display: none; }
  .avatar-edit-btn {
    position: absolute;
    bottom: 2px;
    right: -4px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--primary);
    border: 2px solid var(--bg);
    color: #000;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.15s;
    z-index: 2;
  }
  .avatar-edit-btn:hover { transform: scale(1.1); }
  .side-name {
    font-size: 1rem;
    font-weight: 800;
    margin: 0 0 2px;
    text-align: center;
    color: var(--text);
    line-height: 1.2;
  }
  .side-username {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--primary);
    text-align: center;
    margin: 0 0 10px;
    font-family: monospace;
  }
  .side-tags {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 4px;
  }
  .side-label {
    font-size: 0.5rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    margin: 0 0 10px;
    font-family: monospace;
  }
  .side-bio {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Stats */
  .side-stats {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }
  .stat-item {
    flex: 1;
    text-align: center;
  }
  .stat-num {
    display: block;
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text);
    line-height: 1.2;
  }
  .stat-label {
    display: block;
    font-size: 0.45rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    font-family: monospace;
    margin-top: 2px;
  }

  /* Logout */
  .logout-btn {
    width: 100%;
    padding: 8px 12px;
    border-radius: 6px;
    background: transparent;
    border: 1px solid rgba(255, 80, 80, 0.2);
    color: rgba(255, 80, 80, 0.7);
    font-size: 0.6rem;
    font-weight: 700;
    font-family: inherit;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: all 0.15s;
  }
  .logout-btn:hover {
    background: rgba(255, 80, 80, 0.1);
    border-color: rgba(255, 80, 80, 0.4);
    color: #ff5050;
  }

  /* Role tags */
  .role-tag {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: 100px;
    font-size: 0.55rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(201, 131, 0, 0.1);
    border: 1px solid rgba(201, 131, 0, 0.15);
    color: var(--primary);
    font-family: monospace;
    white-space: nowrap;
  }

  /* ── FEED TABS ── */
  .feed-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 16px;
  }
  .feed-tab {
    flex: 1;
    padding: 10px 8px;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    font-size: 0.6rem;
    font-weight: 700;
    font-family: monospace;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.15s;
    text-align: center;
  }
  .feed-tab:hover { color: var(--text-secondary); }
  .feed-tab.active {
    color: var(--primary);
    border-bottom-color: var(--primary);
  }

  /* FEED TAB CONTENT */
  .feed-tab-content { display: none; }
  .feed-tab-content.active { display: block; }

  /* ── FEED / POSTS ── */
  .feed-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .feed-empty {
    text-align: center;
    padding: 24px 0;
    color: var(--text-muted);
    font-size: 0.75rem;
    margin: 0;
  }
  .fp {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
    transition: border-color 0.15s;
  }
  .fp:hover { border-color: rgba(201, 131, 0, 0.25); }
  .fp-top {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
  .fp-av {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .fp-who {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .fp-name {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text);
  }
  .fp-when {
    font-size: 0.5rem;
    color: var(--text-muted);
    font-family: monospace;
  }
  .fp-tag {
    font-size: 0.45rem;
    font-weight: 700;
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 2px 7px;
    border-radius: 100px;
    text-transform: capitalize;
    flex-shrink: 0;
  }
  .fp-txt {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0 0 10px;
  }
  .fp-img {
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 10px;
  }
  .fp-img img {
    width: 100%;
    height: auto;
    display: block;
  }
  .fp-embed { margin-bottom: 10px; }
  .fp-ph {
    padding: 10px 14px;
    border-radius: 8px;
    margin-bottom: 10px;
    font-size: 0.7rem;
    font-weight: 700;
  }
  .fp-music {
    background: rgba(201, 131, 0, 0.08);
    border: 1px solid rgba(201, 131, 0, 0.12);
    color: var(--primary);
  }
  .fp-event {
    background: rgba(138, 3, 3, 0.06);
    border: 1px solid rgba(138, 3, 3, 0.12);
    color: #ff6b6b;
  }

  /* ── ACTIONS ── */
  .fp-acts {
    display: flex;
    gap: 4px;
    border-top: 1px solid var(--border);
    padding-top: 8px;
  }
  .fp-a {
    flex: 1;
    padding: 5px;
    border-radius: 5px;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.55rem;
    font-weight: 600;
    cursor: pointer;
    text-align: center;
    font-family: inherit;
    transition: all 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }
  .fp-a:hover { color: var(--primary); }
  .fp-a.liked { color: var(--primary); }
  .fp-a.liked .like-icon { color: var(--primary); }
  .fp-a.reposted { color: #1da1f2; }
  .fp-a.reposted .repost-icon { color: #1da1f2; }
  .like-icon {
    font-size: 0.7rem;
    transition: transform 0.2s;
  }
  .fp-a.liked .like-icon { transform: scale(1.2); }
  .repost-icon {
    font-size: 0.7rem;
    transition: transform 0.2s;
  }
  .fp-a.reposted .repost-icon { transform: scale(1.15); }

  /* ── COMMENTS ── */
  .comments-section {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--border);
  }
  .comments-section.hidden { display: none; }
  .comments-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 10px;
  }
  .comment-item {
    display: flex;
    gap: 8px;
  }
  .comment-item img {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .comment-body { flex: 1; }
  .comment-author {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text);
  }
  .comment-text {
    font-size: 0.7rem;
    color: var(--text-secondary);
    margin-top: 2px;
  }
  .comment-time {
    font-size: 0.45rem;
    color: var(--text-muted);
    font-family: monospace;
    margin-top: 2px;
  }
  .comment-form {
    display: flex;
    gap: 6px;
  }
  .comment-input {
    flex: 1;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 0.7rem;
    color: var(--text);
    font-family: inherit;
    outline: none;
  }
  .comment-input:focus { border-color: var(--primary); }
  .comment-input::placeholder { color: var(--text-muted); }
  .comment-send {
    padding: 6px 10px;
    border-radius: 6px;
    background: rgba(201, 131, 0, 0.15);
    border: none;
    color: var(--primary);
    font-size: 0.7rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s;
  }
  .comment-send:hover {
    background: var(--primary);
    color: #000;
  }
  .comment-send:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  /* ── TABLET ── */
  @media (max-width: 860px) {
    .pf-grid {
      grid-template-columns: 1fr;
    }
    .pf-side {
      order: -1;
      position: static;
    }
    .side-card:nth-child(n+3) {
      display: none;
    }
    .side-avatar-box {
      width: 80px;
      height: 80px;
    }
  }

  /* ── MOBILE ── */
  @media (max-width: 600px) {
    .pf-body {
      padding: 0 0 40px;
    }
    .pf-grid {
      gap: 12px;
    }
    .side-card:nth-child(n+2) {
      display: none;
    }
    .side-card:first-child {
      text-align: center;
    }
    .side-avatar-box {
      width: 72px;
      height: 72px;
    }
    .avatar-initials { font-size: 1.4rem; }
    .feed-tabs {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .feed-tab {
      font-size: 0.5rem;
      padding: 8px 6px;
      white-space: nowrap;
    }
    .fp { padding: 12px; }
    .fp-av {
      width: 24px;
      height: 24px;
    }
    .fp-txt { font-size: 0.75rem; }
  }
</style>

<script>
  import { supabase } from '../lib/supabase.js';
  import { getRole } from '../lib/role.js';
  import { getUserTags } from '../lib/tags-gateway.js';

  let currentUser: any = null;
  let currentProfile: any = null;
  let myPosts: any[] = [];

  /* ── INIT ── */
  const initProfile = async () => {
    const unauthSection = document.getElementById('unauth-state');
    const authContent = document.getElementById('auth-content');

    const { data: { session } } = await supabase.auth.getSession();
    currentUser = session?.user || null;

    if (!currentUser) {
      unauthSection?.classList.remove('hidden');
      return;
    }

    // Fetch profile
    const { data: profile, error } = await supabase
      .from('profiles')
      .select('*')
      .eq('id', currentUser.id)
      .single();

    if (error || !profile) {
      console.error('Error fetching profile:', error);
      unauthSection?.classList.remove('hidden');
      return;
    }

    currentProfile = profile;
    authContent?.classList.remove('hidden');

    // Update UI
    const nameEl = document.getElementById('profile-name');
    const usernameEl = document.getElementById('profile-username');
    const bioEl = document.getElementById('profile-bio');
    const avatarImg = document.getElementById('profile-avatar-img');
    const avatarPlaceholder = document.getElementById('avatar-placeholder');

    if (nameEl) nameEl.textContent = profile.nombre || 'Usuario Wild';
    if (usernameEl) usernameEl.textContent = `@${profile.nombre?.toLowerCase().replace(/\s/g, '_') || 'usuario'}`;
    if (bioEl) bioEl.textContent = profile.bio || 'Miembro de Wild Gvng • Amante del hip-hop urbano';

    if (profile.avatar_url && avatarImg instanceof HTMLImageElement) {
      avatarImg.src = profile.avatar_url;
      avatarImg.classList.remove('hidden');
      avatarPlaceholder?.classList.add('hidden');
    } else if (avatarPlaceholder) {
      avatarPlaceholder.textContent = profile.nombre?.substring(0, 2).toUpperCase() || 'WG';
    }

    // Load tags
    loadUserTags(profile);

    // Load posts
    loadMyPosts(profile.id);
    loadLikedPosts();
    loadRepostedPosts();
  };

  /* ── TAGS ── */
  async function loadUserTags(profile: any) {
    const roleTagsContainer = document.getElementById('profile-role-tags');
    if (!roleTagsContainer) return;
    roleTagsContainer.innerHTML = '';

    try {
      const { role: resolvedRole } = await getRole();
      const roleRaw = (resolvedRole || profile.role || currentUser?.user_metadata?.role || 'fan');

      const resolvedUserId = profile.id || currentUser.id;
      const gatewayData = await getUserTags(resolvedUserId) as any;
      const gatewayTags = Array.isArray(gatewayData?.tags)
        ? gatewayData.tags
        : Array.isArray(gatewayData?.data?.tags)
          ? gatewayData.data.tags
          : [];

      const allTags: { name: string; isRole: boolean }[] = [];

      if (roleRaw) {
        allTags.push({ name: roleRaw.toUpperCase(), isRole: true });
      }

      gatewayTags.forEach((tag: any) => {
        const rawName = (tag.tag_name || tag.name || '').trim();
        if (!rawName) return;
        allTags.push({ name: rawName.toUpperCase(), isRole: false });
      });

      if (allTags.length === 0) {
        allTags.push({ name: 'FAN', isRole: true });
      }

      allTags.sort((a, b) => (a.isRole === b.isRole ? 0 : a.isRole ? -1 : 1));

      allTags.forEach(tag => {
        const el = document.createElement('span');
        el.className = 'role-tag';
        el.textContent = tag.name;
        roleTagsContainer.appendChild(el);
      });
    } catch (err) {
      console.error('Error loading tags:', err);
      const el = document.createElement('span');
      el.className = 'role-tag';
      el.textContent = 'FAN';
      roleTagsContainer.appendChild(el);
    }
  }

  /* ── POSTS ── */
  function timeAgo(dateStr: string): string {
    const diff = Date.now() - new Date(dateStr).getTime();
    const mins = Math.floor(diff / 60000);
    if (mins < 60) return `${mins}m`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return `${hrs}h`;
    const days = Math.floor(hrs / 24);
    if (days < 7) return `${days}d`;
    return `${Math.floor(days / 7)}sem`;
  }

  function renderPost(post: any, profile: any): HTMLElement {
    const article = document.createElement('article');
    article.className = 'fp';
    article.setAttribute('data-post-id', post.id);

    const avatarUrl = profile.avatar_url || '';
    const displayName = profile.nombre || 'Usuario';
    const initials = displayName.substring(0, 2).toUpperCase();

    let mediaHtml = '';
    if (post.post_type === 'photo' && post.image_url) {
      mediaHtml = `<div class="fp-img"><img src="${post.image_url}" alt="" loading="lazy" /></div>`;
    } else if (post.post_type === 'music' && post.embed_url) {
      mediaHtml = `<div class="fp-embed"><iframe src="${post.embed_url}" width="100%" height="80" frameBorder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy" style="border-radius:12px;"></iframe></div>`;
    } else if (post.post_type === 'music' && !post.embed_url && post.embed_title) {
      mediaHtml = `<div class="fp-ph fp-music">${post.embed_title}</div>`;
    } else if (post.post_type === 'event' && post.embed_title) {
      mediaHtml = `<div class="fp-ph fp-event">${post.embed_title}</div>`;
    }

    article.innerHTML = `
      <div class="fp-top">
        <div class="fp-av" style="background:var(--primary);color:#000;display:flex;align-items:center;justify-content:center;font-size:0.5rem;font-weight:800;border-radius:50%;width:28px;height:28px;flex-shrink:0;">${avatarUrl ? '' : initials}</div>
        ${avatarUrl ? '' : ''}
        <div class="fp-who">
          <span class="fp-name">${displayName}</span>
          <span class="fp-when">${timeAgo(post.created_at)}</span>
        </div>
        <span class="fp-tag">${post.post_type}</span>
      </div>
      ${post.content ? `<p class="fp-txt">${post.content}</p>` : ''}
      ${mediaHtml}
      <div class="fp-acts">
        <button class="fp-a like-btn" data-count="${post.likes_count}">
          <span class="like-icon">♡</span>
          <span class="like-count">${post.likes_count}</span>
        </button>
        <button class="fp-a comment-toggle-btn" data-count="${post.comments_count}">
          <span>💬</span>
          <span class="comment-count">${post.comments_count}</span>
        </button>
        <button class="fp-a repost-btn" data-count="0">
          <span class="repost-icon">🔄</span>
          <span class="repost-count">0</span>
        </button>
        <button class="fp-a share-post-btn">
          <span>↗</span>
        </button>
      </div>
      <div class="comments-section hidden">
        <div class="comments-list"></div>
        <div class="comment-form">
          <input type="text" class="comment-input" placeholder="Escribe un comentario..." maxlength="500" />
          <button class="comment-send" disabled>→</button>
        </div>
      </div>
    `;

    return article;
  }

  async function loadMyPosts(profileId: string) {
    const list = document.getElementById('my-posts-list');
    const empty = document.getElementById('my-posts-empty');
    if (!list || !empty) return;

    const { data: posts, error } = await supabase
      .from('artist_posts')
      .select('*')
      .eq('artist_id', profileId)
      .order('created_at', { ascending: false });

    if (error || !posts || posts.length === 0) {
      empty.textContent = 'Aún no has publicado nada';
      return;
    }

    empty.classList.add('hidden');
    myPosts = posts;

    // Update post count in sidebar
    const postCountEl = document.getElementById('stat-posts');
    if (postCountEl) postCountEl.textContent = String(posts.length);

    posts.forEach(post => {
      list.appendChild(renderPost(post, currentProfile));
    });

    attachPostListeners(list);
  }

  async function loadLikedPosts() {
    const list = document.getElementById('liked-posts-list');
    const empty = document.getElementById('liked-posts-empty');
    if (!list || !empty) return;

    const { data: likedIds, error } = await supabase.rpc('get_user_artist_post_likes', { p_artist_id: currentUser.id });

    if (error || !likedIds || likedIds.length === 0) {
      empty.textContent = 'Aún no tienes likes';
      return;
    }

    empty.classList.add('hidden');

    const { data: posts } = await supabase
      .from('artist_posts')
      .select('*')
      .in('id', likedIds)
      .order('created_at', { ascending: false });

    if (!posts || posts.length === 0) {
      empty.textContent = 'Aún no tienes likes';
      empty.classList.remove('hidden');
      return;
    }

    // Fetch profiles for each post's artist
    const artistIds = [...new Set(posts.map(p => p.artist_id))];
    const { data: profiles } = await supabase
      .from('profiles')
      .select('id, nombre, avatar_url')
      .in('id', artistIds);

    const profileMap: Record<string, any> = {};
    (profiles || []).forEach(p => { profileMap[p.id] = p; });

    posts.forEach(post => {
      const p = profileMap[post.artist_id] || currentProfile;
      const article = renderPost(post, p);
      // Mark as liked
      const likeBtn = article.querySelector('.like-btn');
      if (likeBtn) {
        likeBtn.classList.add('liked');
        const icon = likeBtn.querySelector('.like-icon');
        if (icon) icon.textContent = '♥';
      }
      list.appendChild(article);
    });

    attachPostListeners(list);
  }

  async function loadRepostedPosts() {
    const list = document.getElementById('reposted-posts-list');
    const empty = document.getElementById('reposted-posts-empty');
    if (!list || !empty) return;

    const { data: reposts, error } = await supabase
      .from('artist_post_reposts')
      .select('post_id')
      .eq('user_id', currentUser.id);

    if (error || !reposts || reposts.length === 0) {
      empty.textContent = 'Aún no tienes reposts';
      return;
    }

    empty.classList.add('hidden');

    const repostedIds = reposts.map((r: any) => r.post_id);
    const { data: posts } = await supabase
      .from('artist_posts')
      .select('*')
      .in('id', repostedIds)
      .order('created_at', { ascending: false });

    if (!posts || posts.length === 0) {
      empty.textContent = 'Aún no tienes reposts';
      empty.classList.remove('hidden');
      return;
    }

    const artistIds = [...new Set(posts.map(p => p.artist_id))];
    const { data: profiles } = await supabase
      .from('profiles')
      .select('id, nombre, avatar_url')
      .in('id', artistIds);

    const profileMap: Record<string, any> = {};
    (profiles || []).forEach(p => { profileMap[p.id] = p; });

    posts.forEach(post => {
      const p = profileMap[post.artist_id] || currentProfile;
      const article = renderPost(post, p);
      // Mark as reposted
      const repostBtn = article.querySelector('.repost-btn');
      if (repostBtn) {
        repostBtn.classList.add('reposted');
      }
      list.appendChild(article);
    });

    attachPostListeners(list);
  }

  /* ── POST INTERACTIONS ── */
  function attachPostListeners(container: Element) {
    // Like
    container.querySelectorAll('.like-btn').forEach((btn: Element) => {
      btn.addEventListener('click', async () => {
        const article = (btn as HTMLElement).closest('.fp');
        const postId = article?.getAttribute('data-post-id');
        if (!postId) return;

        const { data, error } = await supabase.rpc('toggle_artist_post_like', { p_post_id: postId });
        if (error || !data) return;

        const icon = btn.querySelector('.like-icon');
        const count = btn.querySelector('.like-count');
        if (icon) icon.textContent = data.liked ? '♥' : '♡';
        if (count) count.textContent = data.count;
        btn.classList.toggle('liked', data.liked);
      });
    });

    // Repost
    container.querySelectorAll('.repost-btn').forEach((btn: Element) => {
      btn.addEventListener('click', async () => {
        const article = (btn as HTMLElement).closest('.fp');
        const postId = article?.getAttribute('data-post-id');
        if (!postId) return;

        const { data, error } = await supabase.rpc('toggle_artist_post_repost', { p_post_id: postId });
        if (error || !data) return;

        const count = btn.querySelector('.repost-count');
        if (count) count.textContent = data.count;
        btn.classList.toggle('reposted', data.reposted);
      });
    });

    // Comment toggle
    container.querySelectorAll('.comment-toggle-btn').forEach((btn: Element) => {
      btn.addEventListener('click', () => {
        const article = (btn as HTMLElement).closest('.fp');
        const section = article?.querySelector('.comments-section');
        section?.classList.toggle('hidden');
      });
    });

    // Comment send
    container.querySelectorAll('.comment-send').forEach((btn: Element) => {
      btn.addEventListener('click', async () => {
        const article = (btn as HTMLElement).closest('.fp');
        const postId = article?.getAttribute('data-post-id');
        const input = article?.querySelector('.comment-input') as HTMLInputElement;
        if (!postId || !input || !input.value.trim()) return;

        const content = input.value.trim();
        input.value = '';
        (btn as HTMLButtonElement).disabled = true;

        const { data, error } = await supabase.rpc('add_artist_post_comment', {
          p_post_id: postId,
          p_content: content
        });

        if (error || !data) return;

        const countEl = article?.querySelector('.comment-count');
        if (countEl) countEl.textContent = data.count;

        const list = article?.querySelector('.comments-list');
        if (list) {
          const div = document.createElement('div');
          div.className = 'comment-item';
          div.innerHTML = `
            <div class="comment-body">
              <span class="comment-author">Tú</span>
              <p class="comment-text">${content}</p>
              <span class="comment-time">ahora</span>
            </div>
          `;
          list.appendChild(div);
        }

        (btn as HTMLButtonElement).disabled = false;
      });
    });

    // Comment input - enable send
    container.querySelectorAll('.comment-input').forEach((input: Element) => {
      input.addEventListener('input', () => {
        const section = (input as HTMLElement).closest('.comments-section');
        const sendBtn = section?.querySelector('.comment-send') as HTMLButtonElement;
        if (sendBtn) {
          sendBtn.disabled = !(input as HTMLInputElement).value.trim();
        }
      });
    });

    // Share
    container.querySelectorAll('.share-post-btn').forEach((btn: Element) => {
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href);
        const span = (btn as HTMLElement).querySelector('span');
        if (span) span.textContent = '✓';
        setTimeout(() => { if (span) span.textContent = '↗'; }, 1500);
      });
    });
  }

  /* ── TABS ── */
  document.querySelectorAll('.feed-tab').forEach((tab: Element) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.feed-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.feed-tab-content').forEach(c => c.classList.remove('active'));
      tab.classList.add('active');
      const tabName = (tab as HTMLElement).getAttribute('data-tab');
      const content = document.querySelector(`[data-tab-content="${tabName}"]`);
      if (content) content.classList.add('active');
    });
  });

  /* ── LOGOUT ── */
  document.getElementById('profile-logout-btn')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/';
  });

  /* ── AVATAR UPLOAD ── */
  const createAvatarInput = () => {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.style.display = 'none';
    input.id = 'avatar-upload-input';
    return input;
  };

  let avatarInput = document.getElementById('avatar-upload-input') as HTMLInputElement | null;
  if (!avatarInput) {
    avatarInput = createAvatarInput();
    document.body.appendChild(avatarInput);
  }

  document.getElementById('avatar-edit-btn')?.addEventListener('click', () => {
    avatarInput?.click();
  });

  avatarInput.addEventListener('change', async () => {
    const file = avatarInput?.files?.[0];
    if (!file) return;

    const formData = new FormData();
    formData.append('avatar', file);

    try {
      const res = await fetch('/api/upload-avatar', {
        method: 'POST',
        body: formData,
      });
      const result = await res.json();

      if (res.ok && result.avatar_url) {
        if (currentProfile) currentProfile.avatar_url = result.avatar_url;

        const img = document.getElementById('profile-avatar-img');
        if (img instanceof HTMLImageElement) {
          img.src = result.avatar_url;
          img.classList.remove('hidden');
          const placeholder = document.getElementById('avatar-placeholder');
          if (placeholder) placeholder.classList.add('hidden');
        }
      } else {
        console.error('Avatar upload failed:', result.error);
      }
    } catch (err) {
      console.error('Avatar upload error:', err);
    }

    avatarInput!.value = '';
  });

  /* ── RUN ── */
  const run = () => { initProfile().catch(e => console.error('Profile init error:', e)); };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run);
  } else {
    run();
  }
  document.addEventListener('astro:after-swap', run);
</script>
