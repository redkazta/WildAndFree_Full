---
import Layout from '../layouts/Layout.astro';
---

<Layout config={{
  name: "Wild Gvng - Mi Perfil",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>
  <div class="profile-container opacity-0 transition-opacity duration-500" id="profile-main">
    <!-- Unauthenticated State -->
    <div id="unauth-state" class="hidden flex flex-col items-center justify-center min-h-[60vh] text-center space-y-8">
      <div class="w-24 h-24 bg-white/5 rounded-full flex items-center justify-center mb-4">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-wild-orange"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <div class="space-y-2">
        <h2 class="text-3xl font-black text-white uppercase tracking-tighter">Acceso Restringido</h2>
        <p class="text-white/40 text-sm font-bold uppercase tracking-widest">Debes iniciar sesión para ver tu perfil</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 pt-4">
        <a href="/login" class="px-12 py-4 bg-white text-black text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-wild-orange hover:text-white transition-all">Iniciar Sesión</a>
        <a href="/registro" class="px-12 py-4 bg-white/5 border border-white/10 text-white text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-white/10 transition-all">Crear Cuenta</a>
      </div>
    </div>

    <!-- Authenticated Content -->
    <div id="auth-content" class="hidden w-full max-w-[1200px] mx-auto">

      <!-- New Clean Vertical Layout -->
      <div class="flex flex-col md:flex-row gap-12 items-start pt-12 mb-20">

        <!-- Left: Identity Column (Sticky) -->
        <div class="w-full md:w-1/3 flex flex-col items-center md:items-start md:sticky md:top-24">
          <div class="relative group mb-8">
            <div class="w-48 h-48 md:w-64 md:h-64 bg-black border-4 border-white shadow-[8px_8px_0px_#FF5500] overflow-hidden">
              <div id="avatar-placeholder" class="w-full h-full flex items-center justify-center text-6xl font-black text-white bg-[#111]">
                WG
              </div>
              <img id="profile-avatar-img" src="" alt="Avatar" width="256" height="256" class="w-full h-full object-cover hidden">
            </div>
            <button class="avatar-edit absolute -bottom-4 -right-4 w-12 h-12 bg-[#FF5500] text-black border-2 border-black flex items-center justify-center hover:scale-110 transition-transform shadow-[4px_4px_0px_#000]">
              <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/></svg>
            </button>
          </div>

          <h1 id="profile-name" class="text-4xl md:text-5xl font-black text-white uppercase tracking-tighter leading-none mb-2 text-center md:text-left">
            Cargando...
          </h1>
          <p id="profile-username" class="text-[#FF5500] font-mono text-lg font-bold mb-6 tracking-wide">
            @usuario
          </p>

          <div class="flex flex-wrap justify-center md:justify-start gap-3 mb-8" id="profile-role-tags">
            <!-- Tags loaded dynamically -->
          </div>

          <button id="profile-logout-btn" class="w-full py-3 px-4 bg-transparent border-2 border-red-500/40 text-red-500 font-black text-xs uppercase tracking-widest hover:bg-red-500 hover:text-white transition-all flex items-center justify-center gap-2">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
            Cerrar Sesión
          </button>

          <div class="w-full border-t border-white/20 pt-6 mt-6">
             <div class="flex justify-between items-center mb-2">
                <span class="text-xs font-bold text-[#666] uppercase tracking-widest">Nivel Actual</span>
                <span class="text-xl font-black text-[#FF5500] uppercase">Rookie</span>
             </div>
             <div class="h-3 w-full bg-[#111] border border-[#333]">
                <div class="h-full bg-[#FF5500] w-[35%] shadow-[0_0_10px_rgba(255,85,0,0.5)]"></div>
             </div>
             <div class="flex justify-between items-center mt-2 text-[10px] font-mono text-[#666]">
                <span>XP: 350 / 1000</span>
                <span>NEXT: STREET LEGEND</span>
             </div>
          </div>
        </div>

        <!-- Right: Content Column -->
        <div class="w-full md:w-2/3">

          <!-- Bio & Stats Row -->
          <div class="bg-[#111] border border-white/10 p-8 mb-12 shadow-[12px_12px_0px_rgba(0,0,0,0.5)]">
            <p id="profile-bio" class="text-xl text-white/90 font-medium leading-relaxed mb-8 border-l-4 border-[#FF5500] pl-6">
              Cargando biografía...
            </p>

            <div class="grid grid-cols-3 gap-8 border-t border-white/10 pt-8">
              <div class="text-center">
                <span id="stat-following" class="block text-4xl font-black text-white mb-1">0</span>
                <span class="text-xs font-bold text-[#666] uppercase tracking-widest">Siguiendo</span>
              </div>
              <div class="text-center border-l border-white/10">
                <span id="stat-followers" class="block text-4xl font-black text-white mb-1">0</span>
                <span class="text-xs font-bold text-[#666] uppercase tracking-widest">Seguidores</span>
              </div>
              <div class="text-center border-l border-white/10">
                <span id="stat-favorites" class="block text-4xl font-black text-white mb-1">0</span>
                <span class="text-xs font-bold text-[#666] uppercase tracking-widest">Favoritos</span>
              </div>
            </div>

            <div class="flex gap-6 mt-8 pt-6 border-t border-white/10 text-xs font-bold text-[#888] uppercase tracking-widest">
              <span id="profile-location" class="hidden flex items-center gap-2"><span class="text-[#FF5500]">📍</span> Ubicación</span>
              <span id="profile-birthdate" class="hidden flex items-center gap-2"><span class="text-[#FF5500]">📅</span> Cumpleaños</span>
            </div>
          </div>

          <!-- Tabs Navigation -->
          <div class="profile-content">
        <div class="profile-tabs flex gap-8 border-b-2 border-[#222] mb-8 pb-0 overflow-x-auto">
          <button class="tab active px-6 py-4 text-sm font-black uppercase tracking-widest text-[#666] hover:text-white transition-colors relative" data-tab="overview">Resumen</button>
          <button class="tab px-6 py-4 text-sm font-black uppercase tracking-widest text-[#666] hover:text-white transition-colors relative" data-tab="music">Música</button>
          <button class="tab px-6 py-4 text-sm font-black uppercase tracking-widest text-[#666] hover:text-white transition-colors relative" data-tab="playlists">Playlists</button>
          <button class="tab px-6 py-4 text-sm font-black uppercase tracking-widest text-[#666] hover:text-white transition-colors relative" data-tab="following">Siguiendo</button>
        </div>

        <div class="tab-content active" id="overview">
          <div class="grid grid-cols-1 gap-8">
            <div class="content-section bg-[#111] border border-white/10 p-6 shadow-[8px_8px_0px_rgba(0,0,0,0.5)]">
              <h3 class="text-xl font-black text-white uppercase border-l-4 border-[#FF5500] pl-4 mb-6">Artistas Favoritos</h3>
              <div class="flex gap-4 flex-wrap">
                <div class="text-center cursor-pointer hover:-translate-y-1 transition-transform">
                  <img src="https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=80&h=80&fit=crop" width="80" height="80" alt="Artista" class="w-20 h-20 rounded-full object-cover border-2 border-[#333] mb-2 mx-auto" loading="lazy" decoding="async">
                  <span class="block text-xs font-bold text-white uppercase">Artista 1</span>
                </div>
                <!-- ... more artists ... -->
              </div>
            </div>

            <div class="content-section bg-[#111] border border-white/10 p-6 shadow-[8px_8px_0px_rgba(0,0,0,0.5)]">
              <h3 class="text-xl font-black text-white uppercase border-l-4 border-[#FF5500] pl-4 mb-6">Actividad Reciente</h3>
              <div class="flex flex-col gap-4">
                <div class="flex items-center gap-4 p-4 bg-black/40 border border-white/5">
                  <div class="text-2xl">🎵</div>
                  <div>
                    <p class="text-sm font-bold text-white mb-1">Escuchaste <strong class="text-[#FF5500]">Track Urbano</strong></p>
                    <span class="text-[10px] text-[#666] uppercase tracking-wider">hace 2 horas</span>
                  </div>
                </div>
                <!-- ... more activity ... -->
              </div>
            </div>
          </div>
        </div>

        <div class="tab-content hidden" id="music">
           <div class="bg-[#111] border border-white/10 p-6 shadow-[8px_8px_0px_rgba(0,0,0,0.5)]">
             <h3 class="text-xl font-black text-white uppercase border-l-4 border-[#FF5500] pl-4 mb-6">Canciones Más Escuchadas</h3>
             <!-- ... -->
           </div>
        </div>

        <div class="tab-content hidden" id="playlists">
           <div class="bg-[#111] border border-white/10 p-6 shadow-[8px_8px_0px_rgba(0,0,0,0.5)]">
             <h3 class="text-xl font-black text-white uppercase border-l-4 border-[#FF5500] pl-4 mb-6">Mis Playlists</h3>
             <!-- ... -->
           </div>
        </div>

        <div class="tab-content hidden" id="following">
           <div class="bg-[#111] border border-white/10 p-6 shadow-[8px_8px_0px_rgba(0,0,0,0.5)]">
             <h3 class="text-xl font-black text-white uppercase border-l-4 border-[#FF5500] pl-4 mb-6">Siguiendo</h3>
             <!-- ... -->
           </div>
        </div>
      </div>
    </div>
  </div>
</div>
</Layout>

<style>
  :root {
    --p-orange: #FF5500;
  }

  .profile-container {
    min-height: 100vh;
    padding: 20px;
    background-color: #050505;
    background-image: radial-gradient(#111 1px, transparent 1px);
    background-size: 20px 20px;
    font-family: 'Noto Sans JP', sans-serif;
  }

  /* Reset and Base Styles */
  .tab.active {
    color: white;
  }

  .tab.active::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 4px;
    background-color: var(--p-orange);
  }

  /* Animation Utilities */
  @keyframes avatar-pulse {
    0%, 100% { box-shadow: 0 0 0 0px rgba(255, 85, 0, 0.4); border-color: white; }
    50% { box-shadow: 0 0 0 10px rgba(255, 85, 0, 0); border-color: #eee; }
  }

  /* Custom Scrollbar for tabs */
  .profile-tabs::-webkit-scrollbar {
    height: 4px;
  }

  .profile-tabs::-webkit-scrollbar-track {
    background: #111;
  }

  .profile-tabs::-webkit-scrollbar-thumb {
    background: #333;
  }

  /* Utility Classes Overrides if needed */
  /* Grid Layout */

  /* Animaciones para Tags */
  @keyframes golden-pulse {
    0% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(255, 215, 0, 0.7);
      filter: brightness(1);
    }
    50% {
      transform: scale(1.05);
      box-shadow: 0 0 20px 10px rgba(255, 215, 0, 0.3);
      filter: brightness(1.2);
    }
    100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgba(255, 215, 0, 0);
      filter: brightness(1);
    }
  }

  @keyframes origins-glow {
    0% {
      box-shadow: 0 0 5px rgba(255, 107, 53, 0.5);
      filter: brightness(1);
    }
    50% {
      box-shadow: 0 0 15px rgba(255, 107, 53, 0.8);
      filter: brightness(1.1);
    }
    100% {
      box-shadow: 0 0 5px rgba(255, 107, 53, 0.5);
      filter: brightness(1);
    }
  }

  @keyframes member-shine {
    0% {
      filter: brightness(1) saturate(1);
    }
    50% {
      filter: brightness(1.2) saturate(1.3);
    }
    100% {
      filter: brightness(1) saturate(1);
    }
  }

  @keyframes artist-sparkle {
    0% {
      filter: brightness(1) hue-rotate(0deg);
    }
    25% {
      filter: brightness(1.3) hue-rotate(90deg);
    }
    50% {
      filter: brightness(1.1) hue-rotate(180deg);
    }
    75% {
      filter: brightness(1.3) hue-rotate(270deg);
    }
    100% {
      filter: brightness(1) hue-rotate(360deg);
    }
  }

  @keyframes media-pulse {
    0% {
      transform: scale(1);
      opacity: 1;
    }
    50% {
      transform: scale(1.02);
      opacity: 0.9;
    }
    100% {
      transform: scale(1);
      opacity: 1;
    }
  }

  @keyframes developer-code {
    0% {
      text-shadow: 0 0 2px rgba(0, 255, 0, 0.5);
    }
    50% {
      text-shadow: 0 0 8px rgba(0, 255, 0, 0.8);
    }
    100% {
      text-shadow: 0 0 2px rgba(0, 255, 0, 0.5);
    }
  }

  @keyframes designer-flow {
    0% {
      transform: translateY(0px) rotate(0deg);
    }
    25% {
      transform: translateY(-2px) rotate(1deg);
    }
    50% {
      transform: translateY(0px) rotate(0deg);
    }
    75% {
      transform: translateY(2px) rotate(-1deg);
    }
    100% {
      transform: translateY(0px) rotate(0deg);
    }
  }

  @keyframes editor-creative {
    0% {
      filter: contrast(1) brightness(1);
    }
    50% {
      filter: contrast(1.2) brightness(1.1);
    }
    100% {
      filter: contrast(1) brightness(1);
    }
  }

  /* Estilos base para tags - PREMIUM CHIDOTOTA */
  /* Reemplazado arriba en profile-name-row */

  .role-tag-separator {
    width: 6px;
    height: 60px;
    background: linear-gradient(180deg, transparent, rgba(255,255,255,0.6), transparent);
    opacity: 0.7;
    margin: 0 6px;
  }

  .role-tag {
    --tag-glow: rgba(255, 255, 255, 0.65);
    --tag-glow-soft: rgba(255, 255, 255, 0.2);
    --tag-bg-1: rgba(255, 255, 255, 0.06);
    --tag-bg-2: rgba(255, 255, 255, 0.01);
    --tag-border: rgba(255,255,255,0);
    --tag-text: #fff;
    --tag-shine: rgba(255,255,255,0.3);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: clamp(6px, 1.2vw, 8px) clamp(16px, 2.5vw, 24px);
    border-radius: 6px;
    font-size: clamp(12px, 1.4vw, 14px);
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    border: 1px solid var(--tag-border);
    backdrop-filter: blur(12px);
    transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
    margin: 0;
    background: linear-gradient(135deg, var(--tag-bg-1), var(--tag-bg-2));
    background-size: 160% 160%;
    background-position: 0% 50%;
    color: var(--tag-text);
    box-shadow: 0 0 18px -14px var(--tag-glow), inset 0 0 0 1px rgba(255, 255, 255, 0.08);
    text-shadow: none;
    position: relative;
    overflow: hidden;
    outline: none !important; /* NO BLUE SELECTION */
    cursor: default;
    user-select: none;
    filter: none;
    will-change: transform, filter, box-shadow;
    text-align: center;
  }

  .role-tag-label {
    position: relative;
    z-index: 4;
    color: inherit;
  }

  .role-tag::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 6px;
    border: 1px solid var(--tag-border);
    box-shadow: 0 0 10px -4px var(--tag-glow);
    opacity: 0.9;
    z-index: 3;
    pointer-events: none;
  }

  .role-tag-lottie {
    position: absolute;
    inset: 6%;
    z-index: 1;
    opacity: 0.38;
    mix-blend-mode: screen;
    filter: drop-shadow(0 0 16px var(--tag-glow)) drop-shadow(0 0 26px var(--tag-glow-soft));
    border-radius: 6px;
    -webkit-mask-image: radial-gradient(circle, rgba(0,0,0,1) 0%, rgba(0,0,0,0.8) 55%, rgba(0,0,0,0) 75%);
    mask-image: radial-gradient(circle, rgba(0,0,0,1) 0%, rgba(0,0,0,0.8) 55%, rgba(0,0,0,0) 75%);
    pointer-events: none;
  }

  .role-tag-lottie svg {
    width: 100%;
    height: 100%;
  }

  .role-tag.is-staff {
    --tag-bg-1: rgba(245,197,66,0.36);
    --tag-bg-2: rgba(255,235,170,0.08);
    --tag-border: #f5c542;
    --tag-text: #fff4cc;
    --tag-shine: rgba(255,219,130,0.65);
  }

  /* Animación Chidotota: Wild Pulse Neon */
  @keyframes wild-pulse {
      0% {
        box-shadow: 0 0 5px rgba(255, 255, 255, 0.1), inset 0 0 0 rgba(255,255,255,0);
        transform: scale(1);
        filter: brightness(1);
      }
      50% {
        box-shadow: 0 0 20px rgba(255, 255, 255, 0.3), inset 0 0 10px rgba(255,255,255,0.1);
        transform: scale(1.05);
        filter: brightness(1.3);
        border-color: rgba(255, 255, 255, 0.9);
      }
      100% {
        box-shadow: 0 0 5px rgba(255, 255, 255, 0.1), inset 0 0 0 rgba(255,255,255,0);
        transform: scale(1);
        filter: brightness(1);
      }
  }

  @keyframes tag-float {
      0% { transform: translateY(0); }
      50% { transform: translateY(-2px); }
      100% { transform: translateY(0); }
  }

  @keyframes neon-shift {
      0% { background-position: 0% 50%; filter: brightness(1); }
      50% { background-position: 100% 50%; filter: brightness(1.2); }
      100% { background-position: 0% 50%; filter: brightness(1); }
  }


  @keyframes neon-flicker {
    0%, 100% { opacity: 1; }
    42% { opacity: 0.92; }
    43% { opacity: 0.75; }
    44% { opacity: 0.98; }
    68% { opacity: 0.9; }
    69% { opacity: 0.78; }
    70% { opacity: 1; }
  }

  /* Roles específicos con gradientes más potentes */
  .role-tag.role-owner {
    background: linear-gradient(135deg, rgba(255, 215, 0, 0.2), rgba(255, 237, 78, 0.1));
    border-color: #ffd700;
    box-shadow: 0 0 15px rgba(255, 215, 0, 0.3);
  }

  .role-tag.role-origins {
    background: linear-gradient(135deg, rgba(255, 107, 53, 0.2), rgba(247, 147, 30, 0.1));
    border-color: #ff6b35;
    box-shadow: 0 0 15px rgba(255, 107, 53, 0.3);
  }

  .role-tag.role-member {
    background: linear-gradient(135deg, rgba(78, 205, 196, 0.2), rgba(68, 160, 141, 0.1));
    border-color: #4ecdc4;
    box-shadow: 0 0 15px rgba(78, 205, 196, 0.3);
  }

  .role-tag.role-artist {
    background: linear-gradient(135deg, rgba(102, 126, 234, 0.2), rgba(118, 75, 162, 0.1));
    border-color: #667eea;
    box-shadow: 0 0 15px rgba(102, 126, 234, 0.3);
  }

  .role-tag.role-media {
    background: linear-gradient(135deg, rgba(240, 147, 251, 0.2), rgba(245, 87, 108, 0.1));
    border-color: #f093fb;
    box-shadow: 0 0 15px rgba(240, 147, 251, 0.3);
  }

  .role-tag.role-developer {
    background: linear-gradient(135deg, rgba(79, 172, 254, 0.2), rgba(0, 242, 254, 0.1));
    border-color: #4facfe;
    box-shadow: 0 0 15px rgba(79, 172, 254, 0.3);
  }

  .role-tag.role-designer {
    background: linear-gradient(135deg, rgba(67, 233, 123, 0.2), rgba(56, 249, 215, 0.1));
    border-color: #43e97b;
    box-shadow: 0 0 15px rgba(67, 233, 123, 0.3);
  }

  .role-tag.role-editor {
    background: linear-gradient(135deg, rgba(250, 112, 154, 0.2), rgba(254, 225, 64, 0.1));
    border-color: #fa709a;
    box-shadow: 0 0 15px rgba(250, 112, 154, 0.3);
  }

  .role-tag.role-fan {
    background: rgba(255, 255, 255, 0.05);
    border-color: rgba(255, 255, 255, 0.2);
    color: #fff !important;
  }

  .role-tag {
    border-color: var(--tag-border) !important;
    box-shadow: 0 0 18px -12px var(--tag-glow) !important;
  }
  </style>

<script>
  import { supabase } from '../lib/supabase.js';
  import { getRole } from '../lib/role.js';
  import { getUserTags } from '../lib/tags-gateway.js';

  document.getElementById('profile-logout-btn')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/';
  });

  const initProfile = async () => {
    const profileMain = document.getElementById('profile-main');
    const unauthSection = document.getElementById('unauth-state');
    const authContent = document.getElementById('auth-content');

    // 1. Check Session
    const { data: { session } } = await supabase.auth.getSession();

    if (!session) {
      unauthSection?.classList.remove('hidden');
      profileMain?.classList.remove('opacity-0');
      return;
    }

    // 2. Fetch Profile Data (Datos básicos, los tags vienen por Gateway)
    const { data: profile, error } = await supabase
      .from('profiles')
      .select('*')
      .eq('id', session.user.id)
      .single();

    if (error) {
      console.error('Error fetching profile:', error);
      unauthSection?.classList.remove('hidden');
      profileMain?.classList.remove('opacity-0');
      return;
    }

    // 3. Update UI
    authContent?.classList.remove('hidden');
    const nameEl = document.getElementById('profile-name');
    const usernameEl = document.getElementById('profile-username');
    const bioEl = document.getElementById('profile-bio');
    // const crownEl = document.getElementById('role-crown'); // Removed
    const avatarImg = document.getElementById('profile-avatar-img');
    const avatarPlaceholder = document.getElementById('avatar-placeholder');

    if (nameEl) nameEl.textContent = profile.nombre || 'Usuario Wild';
    if (usernameEl) usernameEl.textContent = `@${profile.nombre?.toLowerCase().replace(/\s/g, '_') || 'usuario'}`;
    if (bioEl) bioEl.textContent = profile.bio || 'Miembro de Wild Gvng • Amante del hip-hop urbano';

    // Update Location and Birthdate
    const locationEl = document.getElementById('profile-location');
    const birthdateEl = document.getElementById('profile-birthdate');
    // const birthdayBanner = document.getElementById('birthday-banner'); // Removed

    if (profile.ubicacion) {
      if (locationEl) {
        locationEl.textContent = `📍 ${profile.ubicacion}`;
        locationEl.classList.remove('hidden');
      }
    }

    const userBirthdate = profile.birthdate;
    if (userBirthdate) {
      const parts = String(userBirthdate).split('-').map(n => parseInt(n, 10));
      if (parts.length === 3 && !isNaN(parts[0])) {
        const bYear = parts[0];
        const bMonth = parts[1];
        const bDay = parts[2];
        const birthDateObj = new Date(bYear, bMonth - 1, bDay);

        if (birthdateEl) {
          const options = { day: 'numeric', month: 'long' };
          // @ts-ignore
          birthdateEl.textContent = `📅 ${birthDateObj.toLocaleDateString('es-ES', options)}`;
          birthdateEl.classList.remove('hidden');
        }
      }
    }

    // Tags Logic - Force High Contrast Palette
    interface TagDisplay {
      name: string;
      cssClass?: string;
      color?: string;
      animation?: string;
      isRole?: boolean;
      id?: number;
    }

    const displayUserTags = (tags: TagDisplay[]) => {
      const roleTagsContainer = document.getElementById('profile-role-tags');
      if (!roleTagsContainer) return;

      roleTagsContainer.innerHTML = '';

      if (!tags || tags.length === 0) {
        tags = [{ name: 'FAN', cssClass: 'role-fan', isRole: true }];
      }

      tags.forEach(tag => {
        const tagElement = document.createElement('span');
        tagElement.className = 'role-tag';

        const tagLabel = document.createElement('span');
        tagLabel.className = 'role-tag-label';
        tagLabel.textContent = tag.name;
        tagElement.appendChild(tagLabel);

        // High Contrast Styling Override
        tagElement.style.border = '1px solid var(--p-white)';
        tagElement.style.fontWeight = '800';
        tagElement.style.letterSpacing = '1px';
        tagElement.style.padding = '6px 16px';
        tagElement.style.fontSize = '12px';

        if (tag.isRole) {
           // Roles get special orange treatment
           tagElement.style.background = 'var(--p-white)';
           tagElement.style.color = 'var(--p-black)';
           tagElement.style.boxShadow = '4px 4px 0px var(--p-orange)';
           tagElement.style.border = '1px solid var(--p-white)';
        } else {
           // Normal tags get black treatment
           tagElement.style.background = 'var(--p-black)';
           tagElement.style.color = 'var(--p-white)';
           tagElement.style.border = '1px solid var(--p-orange)';
        }

        roleTagsContainer.appendChild(tagElement);
      });
    };

    try {
      const { role: resolvedRole } = await getRole();
      const roleRaw = (resolvedRole || profile.role || session.user?.user_metadata?.role || 'fan');
      const normalizedRole = roleRaw.toLowerCase().trim().replace(/\s+/g, '-');

      const resolvedUserId = profile?.id || session.user.id;
      const gatewayData = await getUserTags(resolvedUserId) as any;
      const gatewayTags = Array.isArray(gatewayData?.tags)
        ? gatewayData.tags
        : Array.isArray(gatewayData?.data?.tags)
          ? gatewayData.data.tags
          : [];

      const allTags: TagDisplay[] = [];

      if (roleRaw) {
        const parsedRoleId = parseInt(String(roleRaw), 10);
        const roleId = Number.isFinite(parsedRoleId) ? parsedRoleId : 0;
        allTags.push({
          name: roleRaw.toUpperCase(),
          cssClass: `role-${normalizedRole}`,
          isRole: true,
          id: roleId
        });
      }

      gatewayTags.forEach((tag: any) => {
        const rawName = (tag.tag_name || tag.name || '').trim();
        if (!rawName) return;
        const normalizedName = rawName.toLowerCase().replace(/\s+/g, '-');
        const cssClass = tag.cssClass || `role-${normalizedName}`;

        allTags.push({
          name: rawName.toUpperCase(),
          cssClass,
          color: tag.color,
          animation: tag.animation,
          isRole: false,
          id: tag.id || tag.tag_id
        });
      });

      if (allTags.length === 0) {
        allTags.push({ name: 'FAN', cssClass: 'role-fan', isRole: true });
      }

      allTags.sort((a, b) => (a.isRole === b.isRole) ? 0 : (a.isRole ? -1 : 1));

      displayUserTags(allTags);
    } catch (error) {
      console.error('Error loading user tags/roles:', error);
      displayUserTags([{ name: 'FAN', cssClass: 'role-fan' }]);
    }

    if (profile.avatar_url && avatarImg instanceof HTMLImageElement) {
      avatarImg.src = profile.avatar_url;
      avatarImg.classList.remove('hidden');
      avatarPlaceholder?.classList.add('hidden');
    } else if (avatarPlaceholder) {
      avatarPlaceholder.textContent = profile.nombre?.substring(0, 2).toUpperCase() || 'WG';
    }

    // 4. Show Content
    profileMain?.classList.remove('opacity-0');

    // Tab functionality
    const tabs = document.querySelectorAll('.tab');
    const tabContents = document.querySelectorAll('.tab-content');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetTab = tab instanceof HTMLElement ? tab.dataset.tab : null;
        tabs.forEach(t => t.classList.remove('active'));
        tabContents.forEach(content => content.classList.remove('active'));
        tab.classList.add('active');
        const targetContent = targetTab ? document.getElementById(targetTab) : null;
        if (targetContent) targetContent.classList.add('active');
      });
    });

    // Avatar upload via Supabase Storage
    const createAvatarInput = () => {
      const input = document.createElement('input');
      input.type = 'file';
      input.accept = 'image/*';
      input.style.display = 'none';
      input.id = 'avatar-upload-input';
      return input;
    };

    let avatarInput = document.getElementById('avatar-upload-input') as HTMLInputElement | null;
    if (!avatarInput) {
      avatarInput = createAvatarInput();
      document.body.appendChild(avatarInput);
    }

    const avatarEdit = document.querySelector('.avatar-edit');
    if (avatarEdit) {
      avatarEdit.addEventListener('click', () => {
        avatarInput?.click();
      });
    }

    avatarInput.addEventListener('change', async () => {
      const file = avatarInput?.files?.[0];
      if (!file) return;

      const formData = new FormData();
      formData.append('avatar', file);

      try {
        const res = await fetch('/api/upload-avatar', {
          method: 'POST',
          body: formData,
        });
        const result = await res.json();

        if (res.ok && result.avatar_url) {
          // Update the cached profile's avatar_url
          if (profile) profile.avatar_url = result.avatar_url;

          // Update header avatar (handled by updateAuthUI on next init)

          // Update page avatar
          const img = document.getElementById('profile-avatar-img');
          if (img instanceof HTMLImageElement) {
            img.src = result.avatar_url;
            img.classList.remove('hidden');
            const placeholder = document.getElementById('avatar-placeholder');
            if (placeholder) placeholder.classList.add('hidden');
          }
        } else {
          console.error('Avatar upload failed:', result.error);
          alert('Error al subir la foto: ' + (result.error || 'Desconocido'));
        }
      } catch (err) {
        console.error('Avatar upload error:', err);
        alert('Error de conexión al subir la foto');
      }

      // Reset input so the same file can be re-selected
      avatarInput!.value = '';
    });

    // Following buttons
    const followingBtns = document.querySelectorAll('.following-btn');
    followingBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.classList.contains('following')) {
          btn.classList.remove('following');
          btn.textContent = 'Seguir';
        } else {
          btn.classList.add('following');
          btn.textContent = 'Siguiendo';
        }
      });
    });

    // Play buttons
    const playBtns = document.querySelectorAll('.play-btn');
    playBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.textContent === 'â–¶') {
          btn.textContent = 'â¸';
        } else {
          btn.textContent = 'â–¶';
        }
      });
    });
  };

  const run = () => {
    console.log('Iniciando initProfile...');
    initProfile().catch((error) => {
      console.error('Error en initProfile:', error);
    });
  };

  // Ejecutar inmediatamente si el DOM está listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run);
  } else {
    run();
  }

  // También ejecutar después de cambios de página en Astro
  document.addEventListener('astro:after-swap', run);

  // Timeout adicional para asegurar que todo esté cargado
  setTimeout(() => {
    console.log('Ejecutando timeout adicional...');
    const birthdayBanner = document.getElementById('birthday-banner');
    if (birthdayBanner) {
      const isHidden = birthdayBanner.classList.contains('hidden');
      const hasActive = birthdayBanner.classList.contains('is-active');
      console.log('Timeout check - hidden:', isHidden, 'active:', hasActive);

      if (!isHidden && !hasActive) {
        console.log('Forzando oculto desde timeout');
        birthdayBanner.classList.add('hidden');
        birthdayBanner.style.setProperty('display', 'none', 'important');
      }
    }
  }, 1000);
</script>
