---
import Layout from '../layouts/Layout.astro';
---

<Layout config={{
  name: "Wild Gvng - Mi Perfil",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>
  <div class="profile-container opacity-0 transition-opacity duration-500" id="profile-main">
    <!-- Unauthenticated State -->
    <div id="unauth-state" class="hidden flex flex-col items-center justify-center min-h-[60vh] text-center space-y-8">
      <div class="w-24 h-24 bg-white/5 rounded-full flex items-center justify-center mb-4">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="text-orange-500"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <div class="space-y-2">
        <h2 class="text-3xl font-black text-white uppercase tracking-tighter">Acceso Restringido</h2>
        <p class="text-white/40 text-sm font-bold uppercase tracking-widest">Debes iniciar sesión para ver tu perfil</p>
      </div>
      <div class="flex flex-col sm:flex-row gap-4 pt-4">
        <a href="/login" class="px-12 py-4 bg-white text-black text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-orange-500 hover:text-white transition-all">Iniciar Sesión</a>
        <a href="/registro" class="px-12 py-4 bg-white/5 border border-white/10 text-white text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-white/10 transition-all">Crear Cuenta</a>
      </div>
    </div>

    <!-- Authenticated Content -->
    <div id="auth-content" class="hidden">
      <div class="profile-header-section">
        <div class="profile-avatar-large">
          <div id="avatar-placeholder" class="w-full h-full bg-gradient-to-br from-orange-500 to-red-600 flex items-center justify-center text-4xl font-black text-white uppercase">
            WG
          </div>
          <img id="profile-avatar-img" src="" alt="Avatar" class="hidden">
          <div id="role-crown" class="role-crown" aria-hidden="true">
            <svg width="96" height="96" viewBox="0 0 24 24" fill="none" class="role-crown__icon">
              <path d="M3 7l4.5 4L12 4l4.5 7L21 7v10a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V7z" fill="currentColor"/>
              <path d="M6 18h12" stroke="currentColor" stroke-width="1.2" opacity="0.35"/>
            </svg>
          </div>
          <button class="avatar-edit">
            <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
              <path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/>
            </svg>
          </button>
        </div>
        <div class="profile-info-main">
          <div id="birthday-banner" class="hidden birthday-banner">
            <div class="birthday-content">
              <span class="birthday-icon">🎂</span>
              <span class="birthday-text">¡Feliz Cumpleaños!</span>
              <span class="birthday-icon">🎉</span>
            </div>
          </div>
          <h1 id="profile-name">Cargando...</h1>
          <p class="username" id="profile-username">@usuario</p>
          <div class="role-tags" id="profile-role-tags">
            <!-- Los tags se cargarán dinámicamente aquí -->
          </div>
          <p class="bio" id="profile-bio">Cargando biografía...</p>
          <div class="profile-details mb-6 flex flex-wrap gap-4 text-xs font-bold uppercase tracking-widest text-white/60">
            <div id="profile-location-container" class="hidden flex items-center gap-2 bg-white/5 px-3 py-1.5 rounded-full border border-white/10">
              <span class="text-orange-500">📍</span>
              <span id="profile-location">Ubicación</span>
            </div>
            <div id="profile-birthdate-container" class="hidden flex items-center gap-2 bg-white/5 px-3 py-1.5 rounded-full border border-white/10">
              <span class="text-orange-500">📅</span>
              <span id="profile-birthdate">Cumpleaños</span>
            </div>
          </div>
          <div class="profile-stats">
            <div class="stat">
              <span class="stat-number" id="stat-following">0</span>
              <span class="stat-label">Siguiendo</span>
            </div>
            <div class="stat">
              <span class="stat-number" id="stat-followers">0</span>
              <span class="stat-label">Seguidores</span>
            </div>
            <div class="stat">
              <span class="stat-number" id="stat-favorites">0</span>
              <span class="stat-label">Favoritos</span>
            </div>
          </div>
        </div>
        <button class="edit-profile-btn">Editar Perfil</button>
      </div>

      <div class="profile-content">
        <div class="profile-tabs">
          <button class="tab active" data-tab="overview">Resumen</button>
          <button class="tab" data-tab="music">Música</button>
          <button class="tab" data-tab="playlists">Playlists</button>
          <button class="tab" data-tab="following">Siguiendo</button>
        </div>

        <div class="tab-content active" id="overview">
          <div class="content-grid">
            <div class="content-section">
              <h3>Artistas Favoritos</h3>
              <div class="artist-grid">
                <div class="artist-card">
                  <img src="https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=80&h=80&fit=crop" alt="Artista">
                  <span>Artista 1</span>
                </div>
                <div class="artist-card">
                  <img src="https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?w=80&h=80&fit=crop" alt="Artista">
                  <span>Artista 2</span>
                </div>
                <div class="artist-card">
                  <img src="https://images.unsplash.com/photo-1571019614242-c5c5dee9f50b?w=80&h=80&fit=crop" alt="Artista">
                  <span>Artista 3</span>
                </div>
              </div>
            </div>

            <div class="content-section">
              <h3>Actividad Reciente</h3>
              <div class="activity-list">
                <div class="activity-item">
                  <div class="activity-icon">🎵</div>
                  <div class="activity-info">
                    <p>Escuchaste <strong>Track Urbano</strong></p>
                    <span>hace 2 horas</span>
                  </div>
                </div>
                <div class="activity-item">
                  <div class="activity-icon">❤️</div>
                  <div class="activity-info">
                    <p>Agregaste <strong>Album Nueva Era</strong> a favoritos</p>
                    <span>hace 1 día</span>
                  </div>
                </div>
                <div class="activity-item">
                  <div class="activity-icon">🎫</div>
                  <div class="activity-info">
                    <p>Compraste entrada para <strong>Show Wild Gvng</strong></p>
                    <span>hace 3 días</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>

        <div class="tab-content" id="music">
          <div class="music-section">
            <h3>Canciones Más Escuchadas</h3>
            <div class="track-list">
              <div class="track-item">
                <div class="track-number">1</div>
                <img src="https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=50&h=50&fit=crop" alt="Album" class="track-image">
                <div class="track-info">
                  <h4>Urban Flow</h4>
                  <p>Artista Principal</p>
                </div>
                <span class="track-plays">234 reproducciones</span>
              </div>
            </div>
          </div>
        </div>

        <div class="tab-content" id="playlists">
          <div class="playlists-section">
            <h3>Mis Playlists</h3>
            <div class="playlist-grid">
              <div class="playlist-card">
                <img src="https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=120&h=120&fit=crop" alt="Playlist" class="playlist-cover">
                <h4>Urban Essentials</h4>
                <p>45 tracks • 2.3K seguidores</p>
                <button class="play-btn">▶</button>
              </div>
            </div>
          </div>
        </div>

        <div class="tab-content" id="following">
          <div class="following-section">
            <h3>Siguiendo</h3>
            <div class="following-grid">
              <div class="following-card">
                <img src="https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=60&h=60&fit=crop" alt="Artista" class="following-avatar">
                <div class="following-info">
                  <h4>Artista Principal</h4>
                  <p>2.1M seguidores</p>
                </div>
                <button class="following-btn following">Siguiendo</button>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style>
  .profile-container {
    min-height: 100vh;
    padding: 80px 20px 40px;
    background: linear-gradient(135deg, #000 0%, #111 50%, #000 100%);
    position: relative;
  }

  .profile-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 20% 80%, rgba(201, 131, 0, 0.05) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(138, 3, 3, 0.05) 0%, transparent 50%);
    pointer-events: none;
  }

  .profile-header-section {
    max-width: 1200px;
    margin: 0 auto 40px;
    display: flex;
    align-items: center;
    gap: 40px;
    padding: 40px;
    background: rgba(17, 17, 17, 0.8);
    border: 1px solid rgba(201, 131, 0, 0.3);
    border-radius: 16px;
    backdrop-filter: blur(10px);
    position: relative;
    z-index: 1;
  }

  .profile-avatar-large {
    position: relative;
    width: 120px;
    height: 120px;
    border-radius: 50%;
    overflow: hidden;
    border: 3px solid var(--primary-color);
  }

  .profile-avatar-large img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .role-tags {
    margin-top: 10px;
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .role-tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 10px 14px;
    border-radius: 999px;
    background: linear-gradient(135deg, rgba(255,255,255,0.08) 0%, rgba(255,255,255,0.03) 100%);
    border: 1px solid rgba(255, 255, 255, 0.10);
    color: rgba(255, 255, 255, 0.92);
    font-size: 11px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    box-shadow: 0 16px 30px rgba(0,0,0,0.35);
    position: relative;
    overflow: hidden;
  }

  .role-tag::before {
    content: '';
    position: absolute;
    top: -30%;
    bottom: -30%;
    width: 60%;
    left: -80%;
    background: linear-gradient(120deg, transparent 30%, rgba(255,255,255,0.22) 50%, transparent 70%);
    animation: roleShine 3.2s ease-in-out infinite;
    opacity: 0.9;
    pointer-events: none;
  }

  @keyframes roleShine {
    0% { transform: translateX(0) rotate(10deg); opacity: 0.0; }
    15% { opacity: 0.9; }
    50% { transform: translateX(260%) rotate(10deg); opacity: 0.7; }
    85% { opacity: 0.0; }
    100% { transform: translateX(260%) rotate(10deg); opacity: 0.0; }
  }

  /* Estilos de Roles por ID */
  .role-tag.role-owner {
    padding: 14px 20px;
    font-size: 15px;
    background: linear-gradient(135deg, rgba(255, 215, 0, 0.25) 0%, rgba(255, 140, 0, 0.2) 55%, rgba(255, 255, 255, 0.08) 100%);
    border-color: rgba(255, 215, 0, 0.35);
    color: rgba(255, 250, 200, 0.98);
    box-shadow: 0 25px 60px rgba(255, 215, 0, 0.2);
    font-weight: 700;
  }

  .role-tag.role-origins {
    background: linear-gradient(135deg, rgba(138, 43, 226, 0.25) 0%, rgba(75, 0, 130, 0.2) 100%);
    border-color: rgba(138, 43, 226, 0.35);
    color: rgba(240, 230, 255, 0.98);
    box-shadow: 0 20px 55px rgba(138, 43, 226, 0.15);
  }

  .role-tag.role-member {
    background: linear-gradient(135deg, rgba(0, 191, 255, 0.25) 0%, rgba(30, 144, 255, 0.2) 100%);
    border-color: rgba(0, 191, 255, 0.3);
    color: rgba(230, 245, 255, 0.98);
    box-shadow: 0 17px 45px rgba(0, 191, 255, 0.12);
  }

  .role-tag.role-artist {
    background: linear-gradient(135deg, rgba(255, 20, 147, 0.25) 0%, rgba(219, 112, 147, 0.2) 100%);
    border-color: rgba(255, 20, 147, 0.35);
    color: rgba(255, 230, 245, 0.98);
    box-shadow: 0 18px 48px rgba(255, 20, 147, 0.15);
  }

  .role-tag.role-media {
    background: linear-gradient(135deg, rgba(255, 69, 0, 0.25) 0%, rgba(255, 140, 0, 0.2) 100%);
    border-color: rgba(255, 69, 0, 0.35);
    color: rgba(255, 240, 230, 0.98);
    box-shadow: 0 19px 50px rgba(255, 69, 0, 0.15);
  }

  .role-tag.role-developer {
    background: linear-gradient(135deg, rgba(0, 255, 0, 0.2) 0%, rgba(50, 205, 50, 0.18) 100%);
    border-color: rgba(0, 255, 0, 0.3);
    color: rgba(230, 255, 230, 0.98);
    box-shadow: 0 16px 42px rgba(0, 255, 0, 0.1);
    font-family: 'Courier New', monospace;
  }

  .role-tag.role-designer {
    background: linear-gradient(135deg, rgba(255, 105, 180, 0.25) 0%, rgba(138, 43, 226, 0.2) 100%);
    border-color: rgba(255, 105, 180, 0.35);
    color: rgba(255, 240, 250, 0.98);
    box-shadow: 0 21px 52px rgba(255, 105, 180, 0.15);
  }

  .role-tag.role-editor {
    background: linear-gradient(135deg, rgba(255, 140, 0, 0.25) 0%, rgba(255, 0, 0, 0.2) 100%);
    border-color: rgba(255, 140, 0, 0.35);
    color: rgba(255, 245, 230, 0.98);
    box-shadow: 0 17px 45px rgba(255, 140, 0, 0.15);
  }

  .role-tag.role-fan {
    background: linear-gradient(135deg, rgba(0, 220, 255, 0.22) 0%, rgba(140, 60, 255, 0.18) 55%, rgba(255, 255, 255, 0.06) 100%);
    border-color: rgba(0, 220, 255, 0.22);
    color: rgba(230, 245, 255, 0.98);
    box-shadow: 0 22px 60px rgba(0, 220, 255, 0.12);
  }

  /* Birthday Banner Specificity Fix */
  #birthday-banner {
    margin-bottom: 20px;
    padding: 12px 24px;
    background: linear-gradient(135deg, rgba(255, 215, 0, 0.2) 0%, rgba(255, 100, 100, 0.2) 100%);
    border: 1px solid rgba(255, 215, 0, 0.4);
    border-radius: 12px;
    display: none !important; /* Forzamos oculto por defecto usando ID */
    align-items: center;
    justify-content: center;
    animation: bounce 2s infinite;
    backdrop-filter: blur(5px);
  }

  #birthday-banner.is-active {
    display: inline-flex !important; /* Forzamos visible solo con esta clase usando ID */
  }

  .birthday-content {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .birthday-text {
    font-family: 'Noto Sans JP', sans-serif;
    font-weight: 700;
    color: #FFD700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    text-shadow: 0 2px 4px rgba(0,0,0,0.5);
  }

  .birthday-icon {
    font-size: 20px;
  }

  @keyframes bounce {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-5px); }
  }

  .role-crown {
    position: absolute;
    top: -46px;
    left: 68%;
    transform: translateX(-50%) rotate(-14deg);
    width: 108px;
    height: 108px;
    border-radius: 40px;
    background: radial-gradient(circle at 30% 30%, rgba(255, 230, 160, 0.9) 0%, rgba(201, 131, 0, 0.9) 45%, rgba(138, 3, 3, 0.65) 100%);
    color: rgba(20, 10, 0, 0.85);
    display: none;
    align-items: center;
    justify-content: center;
    box-shadow: 0 22px 60px rgba(201, 131, 0, 0.18), 0 18px 40px rgba(0,0,0,0.55);
    border: 1px solid rgba(255, 255, 255, 0.16);
    pointer-events: none;
    z-index: 5;
  }

  .role-crown.is-visible {
    display: flex;
  }

  .role-crown__icon {
    filter: drop-shadow(0 10px 16px rgba(0,0,0,0.35));
  }

  /* Animaciones de Roles por ID */
  
  /* Owners (1-11) - Animación dorada perrotota */
  @keyframes golden-pulse {
    0% { 
      transform: scale(1);
      box-shadow: 0 20px 50px rgba(255, 215, 0, 0.3), 0 0 20px rgba(255, 215, 0, 0.2);
      background: linear-gradient(135deg, rgba(255, 215, 0, 0.25) 0%, rgba(255, 140, 0, 0.2) 55%, rgba(255, 255, 255, 0.08) 100%);
    }
    25% { 
      transform: scale(1.05);
      box-shadow: 0 25px 60px rgba(255, 215, 0, 0.4), 0 0 30px rgba(255, 215, 0, 0.3);
      background: linear-gradient(135deg, rgba(255, 215, 0, 0.35) 0%, rgba(255, 140, 0, 0.3) 55%, rgba(255, 255, 255, 0.12) 100%);
    }
    50% { 
      transform: scale(1.1);
      box-shadow: 0 30px 70px rgba(255, 215, 0, 0.5), 0 0 40px rgba(255, 215, 0, 0.4);
      background: linear-gradient(135deg, rgba(255, 215, 0, 0.45) 0%, rgba(255, 140, 0, 0.4) 55%, rgba(255, 255, 255, 0.16) 100%);
    }
    75% { 
      transform: scale(1.05);
      box-shadow: 0 25px 60px rgba(255, 215, 0, 0.4), 0 0 30px rgba(255, 215, 0, 0.3);
      background: linear-gradient(135deg, rgba(255, 215, 0, 0.35) 0%, rgba(255, 140, 0, 0.3) 55%, rgba(255, 255, 255, 0.12) 100%);
    }
    100% { 
      transform: scale(1);
      box-shadow: 0 20px 50px rgba(255, 215, 0, 0.3), 0 0 20px rgba(255, 215, 0, 0.2);
      background: linear-gradient(135deg, rgba(255, 215, 0, 0.25) 0%, rgba(255, 140, 0, 0.2) 55%, rgba(255, 255, 255, 0.08) 100%);
    }
  }
  
  /* Origins (12-13) - Animación de brillo ancestral */
  @keyframes origins-glow {
    0%, 100% { 
      box-shadow: 0 15px 40px rgba(138, 43, 226, 0.25), 0 0 15px rgba(138, 43, 226, 0.15);
      background: linear-gradient(135deg, rgba(138, 43, 226, 0.22) 0%, rgba(75, 0, 130, 0.18) 100%);
    }
    50% { 
      box-shadow: 0 20px 55px rgba(138, 43, 226, 0.35), 0 0 25px rgba(138, 43, 226, 0.25);
      background: linear-gradient(135deg, rgba(138, 43, 226, 0.32) 0%, rgba(75, 0, 130, 0.28) 100%);
    }
  }
  
  /* Members (14) - Animación de brillo de membresía */
  @keyframes member-shine {
    0%, 100% { 
      box-shadow: 0 12px 35px rgba(0, 191, 255, 0.25), 0 0 12px rgba(0, 191, 255, 0.15);
      background: linear-gradient(135deg, rgba(0, 191, 255, 0.22) 0%, rgba(30, 144, 255, 0.18) 100%);
    }
    50% { 
      box-shadow: 0 17px 45px rgba(0, 191, 255, 0.35), 0 0 20px rgba(0, 191, 255, 0.25);
      background: linear-gradient(135deg, rgba(0, 191, 255, 0.32) 0%, rgba(30, 144, 255, 0.28) 100%);
    }
  }
  
  /* Artists (15) - Animación de chispas creativas */
  @keyframes artist-sparkle {
    0%, 100% { 
      box-shadow: 0 15px 40px rgba(255, 20, 147, 0.25), 0 0 15px rgba(255, 20, 147, 0.15);
      background: linear-gradient(135deg, rgba(255, 20, 147, 0.22) 0%, rgba(219, 112, 147, 0.18) 100%);
    }
    25% { 
      box-shadow: 0 18px 48px rgba(255, 105, 180, 0.35), 0 0 22px rgba(255, 105, 180, 0.25);
      background: linear-gradient(135deg, rgba(255, 105, 180, 0.32) 0%, rgba(219, 112, 147, 0.28) 100%);
    }
    75% { 
      box-shadow: 0 22px 52px rgba(255, 69, 0, 0.30), 0 0 18px rgba(255, 69, 0, 0.20);
      background: linear-gradient(135deg, rgba(255, 69, 0, 0.28) 0%, rgba(255, 20, 147, 0.24) 100%);
    }
  }
  
  /* Media (16) - Animación de pulso dinámico */
  @keyframes media-pulse {
    0%, 100% { 
      box-shadow: 0 14px 38px rgba(255, 69, 0, 0.25), 0 0 14px rgba(255, 69, 0, 0.15);
      background: linear-gradient(135deg, rgba(255, 69, 0, 0.22) 0%, rgba(255, 140, 0, 0.18) 100%);
    }
    50% { 
      box-shadow: 0 19px 50px rgba(255, 69, 0, 0.35), 0 0 24px rgba(255, 69, 0, 0.25);
      background: linear-gradient(135deg, rgba(255, 69, 0, 0.32) 0%, rgba(255, 140, 0, 0.28) 100%);
    }
  }
  
  /* Developers (17) - Animación de código matrix */
  @keyframes developer-code {
    0% { 
      box-shadow: 0 13px 36px rgba(0, 255, 0, 0.20), 0 0 12px rgba(0, 255, 0, 0.10);
      background: linear-gradient(135deg, rgba(0, 255, 0, 0.18) 0%, rgba(50, 205, 50, 0.15) 100%);
      transform: translateY(0px);
    }
    25% { 
      box-shadow: 0 16px 42px rgba(0, 255, 0, 0.25), 0 0 16px rgba(0, 255, 0, 0.15);
      background: linear-gradient(135deg, rgba(0, 255, 0, 0.23) 0%, rgba(50, 205, 50, 0.20) 100%);
      transform: translateY(-2px);
    }
    50% { 
      box-shadow: 0 19px 48px rgba(0, 255, 0, 0.30), 0 0 20px rgba(0, 255, 0, 0.20);
      background: linear-gradient(135deg, rgba(0, 255, 0, 0.28) 0%, rgba(50, 205, 50, 0.25) 100%);
      transform: translateY(0px);
    }
    75% { 
      box-shadow: 0 22px 54px rgba(0, 255, 0, 0.35), 0 0 24px rgba(0, 255, 0, 0.25);
      background: linear-gradient(135deg, rgba(0, 255, 0, 0.33) 0%, rgba(50, 205, 50, 0.30) 100%);
      transform: translateY(2px);
    }
    100% { 
      box-shadow: 0 13px 36px rgba(0, 255, 0, 0.20), 0 0 12px rgba(0, 255, 0, 0.10);
