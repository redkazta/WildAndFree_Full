<script>
  import lottie from 'lottie-web';
  import { supabase } from '../lib/supabase.js';
  import { getRole } from '../lib/role.js';
  import { getUserTags } from '../lib/tags-gateway.js';

  const initProfile = async () => {
    const profileMain = document.getElementById('profile-main');
    const unauthSection = document.getElementById('unauth-state');
    const authContent = document.getElementById('auth-content');
    
    // 1. Check Session
    const { data: { session } } = await supabase.auth.getSession();
    
    if (!session) {
      unauthSection?.classList.remove('hidden');
      profileMain?.classList.remove('opacity-0');
      return;
    }

    // 2. Fetch Profile Data (Datos básicos, los tags vienen por Gateway)
    const { data: profile, error } = await supabase
      .from('profiles')
      .select('*')
      .eq('id', session.user.id)
      .single();

    if (error) {
      console.error('Error fetching profile:', error);
      unauthSection?.classList.remove('hidden');
      profileMain?.classList.remove('opacity-0');
      return;
    }

    // 3. Update UI
    authContent?.classList.remove('hidden');
    const nameEl = document.getElementById('profile-name');
    const usernameEl = document.getElementById('profile-username');
    const bioEl = document.getElementById('profile-bio');
    const crownEl = document.getElementById('role-crown');
    const avatarImg = document.getElementById('profile-avatar-img');
    const avatarPlaceholder = document.getElementById('avatar-placeholder');

    if (nameEl) nameEl.textContent = profile.nombre || 'Usuario Wild';
    if (usernameEl) usernameEl.textContent = `@${profile.nombre?.toLowerCase().replace(/\s/g, '_') || 'usuario'}`;
    if (bioEl) bioEl.textContent = profile.bio || 'Miembro de Wild Gvng • Amante del hip-hop urbano';

    // Update Location and Birthdate
    const locationContainer = document.getElementById('profile-location-container');
    const locationEl = document.getElementById('profile-location');
    const birthdateContainer = document.getElementById('profile-birthdate-container');
    const birthdateEl = document.getElementById('profile-birthdate');
    const birthdayBanner = document.getElementById('birthday-banner');

    // Función robusta para ocultar el banner
    const hideBirthdayBanner = (banner: HTMLElement | null) => {
      if (!banner) return;
      banner.classList.remove('is-active');
      banner.classList.add('hidden');
      banner.style.setProperty('display', 'none', 'important');
      banner.style.visibility = 'hidden';
      banner.style.opacity = '0';
      console.log('Banner ocultado con función robusta');
    };

    if (locationContainer) locationContainer.classList.add('hidden');
    if (birthdateContainer) birthdateContainer.classList.add('hidden');
    if (birthdayBanner) {
      hideBirthdayBanner(birthdayBanner);
    }

    if (profile.ubicacion) {
      if (locationEl) locationEl.textContent = profile.ubicacion;
      locationContainer?.classList.remove('hidden');
    }

    // Use strictly the birthdate from the profiles table (database)
    const userBirthdate = profile.birthdate;
    if (userBirthdate) {
      // 1. Update persistent visible component
      // NOTE: Standard Postgres DATE format is YYYY-MM-DD
      const parts = String(userBirthdate).split('-').map(n => parseInt(n, 10));
      
      if (parts.length === 3 && !isNaN(parts[0])) {
        const bYear = parts[0];
        const bMonth = parts[1]; // 2nd part is Month (Standard)
        const bDay = parts[2];   // 3rd part is Day (Standard)

        // Month is 0-indexed in JS Date
        const birthDateObj = new Date(bYear, bMonth - 1, bDay);

        if (birthdateEl) {
          const options = { day: 'numeric', month: 'long' };
          // @ts-ignore
          birthdateEl.textContent = birthDateObj.toLocaleDateString('es-ES', options);
        }
        birthdateContainer?.classList.remove('hidden');

        // 2. Unified Birthday Banner Logic
        try {
          const today = new Date();
          const todayMonth = today.getMonth() + 1;
          const todayDay = today.getDate();
          
          const isBirthday = (todayMonth === bMonth && todayDay === bDay);
          
          // Función robusta para mostrar el banner
          const showBirthdayBanner = (banner: HTMLElement | null) => {
            if (!banner) return;
            banner.classList.add('is-active');
            banner.classList.remove('hidden');
            banner.style.setProperty('display', 'inline-flex', 'important');
            banner.style.visibility = 'visible';
            banner.style.opacity = '1';
            console.log('Banner mostrado con función robusta');
          };
          
          if (birthdayBanner) {
            if (isBirthday) {
              showBirthdayBanner(birthdayBanner);
              console.log('¡CUMPLEAÑOS DETECTADO! Activando banner...', { today: `${todayDay}/${todayMonth}`, birth: `${bDay}/${bMonth}` });
            } else {
              hideBirthdayBanner(birthdayBanner);
              console.log('No es tu cumpleaños. Banner oculto.', { today: `${todayDay}/${todayMonth}`, birth: `${bDay}/${bMonth}` });
            }
          }
          
          console.log('Debug Birthdate Final:', {
            db_value: userBirthdate,
            parsed_month: bMonth,
            parsed_day: bDay,
            today_month: todayMonth,
            today_day: todayDay,
            match: isBirthday,
            element_display: birthdayBanner?.style.display
          });
        } catch (e) {
          console.error('Error in unified birthday check:', e);
        }
      }
    }

    // Añadir observer para detectar cambios externos en el banner
    if (birthdayBanner) {
      const observer = new MutationObserver((mutations) => {
        mutations.forEach((mutation) => {
          if (mutation.type === 'attributes' && mutation.attributeName === 'class') {
            const isHidden = birthdayBanner.classList.contains('hidden');
            const hasActive = birthdayBanner.classList.contains('is-active');
            console.log('Observer: Banner class changed - hidden:', isHidden, 'active:', hasActive);
            
            // Si el banner se volvió visible sin ser el cumpleaños, forzar oculto
            if (!isHidden && !hasActive) {
              console.log('Observer: Forzando oculto - banner visible sin ser activo');
              hideBirthdayBanner(birthdayBanner);
            }
          }
        });
      });
      
      observer.observe(birthdayBanner, { attributes: true, attributeFilter: ['class'] });
      console.log('Observer iniciado para el banner');
    }

    // Sistema de Tags - Mostrar tags visibles del usuario
    // Los roles ahora son invisibles (solo para permisos internos)
    // Los tags son visibles y personalizables
    
    // Función para mostrar tags del usuario
    interface TagDisplay {
      name: string;
      cssClass?: string;
      color?: string;
      animation?: string;
      isRole?: boolean;
      id?: number;
    }

    const GOLD_ROLE_IDS = new Set([1, 2, 3]);
    const RED_ROLE_IDS = new Set([4]);
    const PURPLE_ROLE_IDS = new Set([5, 6]);
    const GREEN_ROLE_IDS = new Set([0, 7, 8, 9, 10, 11]);

    const resolveRgb = (value: string) => {
      const temp = document.createElement('span');
      temp.style.color = value;
      temp.style.display = 'none';
      document.body.appendChild(temp);
      const computed = getComputedStyle(temp).color || 'rgb(255, 255, 255)';
      document.body.removeChild(temp);
      const match = computed.match(/rgba?\((\d+),\s*(\d+),\s*(\d+)/);
      if (!match) return { r: 255, g: 255, b: 255 };
      return { r: Number(match[1]), g: Number(match[2]), b: Number(match[3]) };
    };

    const resolveBorder = (value: string, alpha = 0.85) => {
      const rgb = resolveRgb(value);
      return `rgba(${rgb.r}, ${rgb.g}, ${rgb.b}, ${alpha})`;
    };

    const buildTagGlowLottie = (color: string, intensity: number) => {
      const rgb = resolveRgb(color);
      const fillColor = [rgb.r / 255, rgb.g / 255, rgb.b / 255, 1];
      const softHigh = Math.min(100, Math.max(0, 35 + intensity * 45));
      const softLow = Math.max(0, softHigh - 18);
      const coreHigh = Math.min(100, Math.max(0, 30 + intensity * 55));
      const coreLow = Math.max(0, coreHigh - 14);

      return {
        v: '5.7.4',
        fr: 30,
        ip: 0,
        op: 120,
        w: 200,
        h: 200,
        nm: 'tag-glow',
        ddd: 0,
        assets: [],
        layers: [
          {
            ddd: 0,
            ind: 1,
            ty: 4,
            nm: 'Soft',
            sr: 1,
            ks: {
              o: {
                a: 1,
                k: [
                  { t: 0, s: [softLow], e: [softHigh] },
                  { t: 60, s: [softHigh], e: [softLow] },
                  { t: 120, s: [softLow] }
                ]
              },
              r: { a: 0, k: 0 },
              p: { a: 0, k: [100, 100, 0] },
              a: { a: 0, k: [0, 0, 0] },
              s: {
                a: 1,
                k: [
                  { t: 0, s: [120, 120, 100], e: [150, 150, 100] },
                  { t: 60, s: [150, 150, 100], e: [120, 120, 100] },
                  { t: 120, s: [120, 120, 100] }
                ]
              }
            },
            shapes: [
              { ty: 'el', p: { a: 0, k: [0, 0] }, s: { a: 0, k: [170, 170] }, nm: 'Ellipse' },
              { ty: 'fl', c: { a: 0, k: fillColor }, o: { a: 0, k: 100 }, r: 1, nm: 'Fill' },
              { ty: 'tr', p: { a: 0, k: [0, 0] }, a: { a: 0, k: [0, 0] }, s: { a: 0, k: [100, 100] }, r: { a: 0, k: 0 }, o: { a: 0, k: 100 }, nm: 'Transform' }
            ],
            ip: 0,
            op: 120,
            st: 0,
            bm: 0
          },
          {
            ddd: 0,
            ind: 2,
            ty: 4,
            nm: 'Core',
            sr: 1,
            ks: {
              o: {
                a: 1,
                k: [
                  { t: 0, s: [coreLow], e: [coreHigh] },
                  { t: 60, s: [coreHigh], e: [coreLow] },
                  { t: 120, s: [coreLow] }
                ]
              },
              r: { a: 0, k: 0 },
              p: { a: 0, k: [100, 100, 0] },
              a: { a: 0, k: [0, 0, 0] },
              s: {
                a: 1,
                k: [
                  { t: 0, s: [70, 70, 100], e: [95, 95, 100] },
                  { t: 60, s: [95, 95, 100], e: [70, 70, 100] },
                  { t: 120, s: [70, 70, 100] }
                ]
              }
            },
            shapes: [
              { ty: 'el', p: { a: 0, k: [0, 0] }, s: { a: 0, k: [120, 120] }, nm: 'Ellipse' },
              { ty: 'fl', c: { a: 0, k: fillColor }, o: { a: 0, k: 100 }, r: 1, nm: 'Fill' },
              { ty: 'tr', p: { a: 0, k: [0, 0] }, a: { a: 0, k: [0, 0] }, s: { a: 0, k: [100, 100] }, r: { a: 0, k: 0 }, o: { a: 0, k: 100 }, nm: 'Transform' }
            ],
            ip: 0,
            op: 120,
            st: 0,
            bm: 0
          }
        ]
      };
    };

    const attachLottieGlow = (tagElement: HTMLElement) => {
      const anim = (tagElement.dataset.anim || '').toLowerCase();
      if (anim === 'none') return;
      const existing = tagElement.querySelector('.role-tag-lottie');
      if (existing) return;
      const glowColor = getComputedStyle(tagElement).getPropertyValue('--tag-glow').trim() || '#ffffff';
      const intensity = anim === 'role-pulse' ? 0.9 : anim === 'member-shine' ? 0.65 : 0.75;
      const animationData = buildTagGlowLottie(glowColor, intensity);
      const lottieWrapper = document.createElement('span');
      lottieWrapper.className = 'role-tag-lottie';
      lottieWrapper.style.opacity = anim === 'role-pulse' ? '0.5' : anim === 'member-shine' ? '0.35' : '0.42';
      tagElement.prepend(lottieWrapper);
      lottie.loadAnimation({
        container: lottieWrapper,
        renderer: 'svg',
        loop: true,
        autoplay: true,
        animationData,
        rendererSettings: { preserveAspectRatio: 'xMidYMid meet' }
      });
    };

    const displayUserTags = (tags: TagDisplay[]) => {
      const roleTagsContainer = document.getElementById('profile-role-tags');
      if (!roleTagsContainer) return;

      roleTagsContainer.innerHTML = '';

      if (!tags || tags.length === 0) {
        const defaultTag = document.createElement('span');
        defaultTag.className = 'role-tag role-fan';
        const defaultLabel = document.createElement('span');
        defaultLabel.className = 'role-tag-label';
        defaultLabel.textContent = 'FAN';
        defaultTag.appendChild(defaultLabel);
        roleTagsContainer.appendChild(defaultTag);
        attachLottieGlow(defaultTag);
        return;
      }

      const tagElements: HTMLElement[] = [];

      const appendTag = (tag: TagDisplay) => {
        const tagElement = document.createElement('span');
        // Usar clase CSS si existe, sino solo base
        tagElement.className = `role-tag ${tag.cssClass || ''}`;
        const tagLabel = document.createElement('span');
        tagLabel.className = 'role-tag-label';
        tagLabel.textContent = tag.name;
        
        const rawColor = tag.color ? String(tag.color).trim() : '';
        const normalizedColor = rawColor && !rawColor.startsWith('#') && /^[0-9a-fA-F]{6}$/.test(rawColor) ? `#${rawColor}` : rawColor;

        if (normalizedColor) {
            tagElement.style.setProperty('--tag-bg-1', `${normalizedColor}22`);
            tagElement.style.setProperty('--tag-bg-2', `${normalizedColor}08`);
            tagElement.style.setProperty('--tag-border', resolveBorder(normalizedColor, 0.7));
            tagElement.style.setProperty('--tag-text', '#fff');
            tagElement.style.setProperty('--tag-shine', `${normalizedColor}33`);
            tagElement.style.backgroundSize = '220% 220%';
            tagElement.style.backgroundPosition = '0% 50%';
        } else if (!tag.cssClass || tag.cssClass === 'role-tag') {
            tagElement.style.setProperty('--tag-bg-1', 'rgba(255,255,255,0.1)');
            tagElement.style.setProperty('--tag-bg-2', 'rgba(255,255,255,0.05)');
            tagElement.style.setProperty('--tag-border', 'rgba(255,255,255,0.5)');
            tagElement.style.setProperty('--tag-text', '#fff');
            tagElement.style.backgroundSize = '200% 200%';
            tagElement.style.backgroundPosition = '0% 50%';
        }

        tagElement.style.setProperty('--tag-glow', normalizedColor || '#ffffff');
        tagElement.style.setProperty('--tag-glow-soft', normalizedColor || 'rgba(255,255,255,0.5)');

        if (tag.isRole) {
          const roleId = tag.id ?? 0;
          if (GOLD_ROLE_IDS.has(roleId)) {
            tagElement.style.fontSize = '36px';
            tagElement.style.padding = '24px 52px';
            tagElement.style.letterSpacing = '0.2em';
            tagElement.style.fontWeight = '900';
            tagElement.style.setProperty('--tag-bg-1', 'rgba(245,197,66,0.14)');
            tagElement.style.setProperty('--tag-bg-2', 'rgba(255,235,170,0.04)');
            tagElement.style.setProperty('--tag-border', 'rgba(245,197,66,0.85)');
            tagElement.style.setProperty('--tag-text', '#fff');
            tagElement.style.setProperty('--tag-shine', 'rgba(255,219,130,0.4)');
            tagElement.style.setProperty('--tag-glow', '#f5c542');
            tagElement.style.setProperty('--tag-glow-soft', 'rgba(245,197,66,0.25)');
          } else if (RED_ROLE_IDS.has(roleId)) {
            tagElement.style.fontSize = '34px';
            tagElement.style.padding = '22px 50px';
            tagElement.style.letterSpacing = '0.18em';
            tagElement.style.fontWeight = '900';
            tagElement.style.setProperty('--tag-bg-1', 'rgba(255,78,78,0.14)');
            tagElement.style.setProperty('--tag-bg-2', 'rgba(255,170,170,0.04)');
            tagElement.style.setProperty('--tag-border', 'rgba(255,78,78,0.85)');
            tagElement.style.setProperty('--tag-text', '#fff');
            tagElement.style.setProperty('--tag-shine', 'rgba(255,140,140,0.4)');
            tagElement.style.setProperty('--tag-glow', '#ff4e4e');
            tagElement.style.setProperty('--tag-glow-soft', 'rgba(255,78,78,0.25)');
          } else if (PURPLE_ROLE_IDS.has(roleId)) {
            tagElement.style.fontSize = '34px';
            tagElement.style.padding = '22px 50px';
            tagElement.style.letterSpacing = '0.18em';
            tagElement.style.fontWeight = '900';
            tagElement.style.setProperty('--tag-bg-1', 'rgba(155,89,255,0.14)');
            tagElement.style.setProperty('--tag-bg-2', 'rgba(200,160,255,0.04)');
            tagElement.style.setProperty('--tag-border', 'rgba(155,89,255,0.85)');
            tagElement.style.setProperty('--tag-text', '#fff');
            tagElement.style.setProperty('--tag-shine', 'rgba(187,140,255,0.4)');
            tagElement.style.setProperty('--tag-glow', '#9b59ff');
            tagElement.style.setProperty('--tag-glow-soft', 'rgba(155,89,255,0.25)');
          } else if (GREEN_ROLE_IDS.has(roleId)) {
            tagElement.style.fontSize = '32px';
            tagElement.style.padding = '20px 46px';
            tagElement.style.letterSpacing = '0.16em';
            tagElement.style.fontWeight = '800';
            tagElement.style.setProperty('--tag-bg-1', 'rgba(64,200,120,0.12)');
            tagElement.style.setProperty('--tag-bg-2', 'rgba(140,255,200,0.04)');
            tagElement.style.setProperty('--tag-border', 'rgba(64,200,120,0.85)');
            tagElement.style.setProperty('--tag-text', '#fff');
            tagElement.style.setProperty('--tag-shine', 'rgba(120,255,190,0.4)');
            tagElement.style.setProperty('--tag-glow', '#40c878');
            tagElement.style.setProperty('--tag-glow-soft', 'rgba(64,200,120,0.25)');
          }
        } else if (tag.name.toLowerCase().includes('fan')) {
          tagElement.style.setProperty('--tag-bg-1', 'rgba(64,200,120,0.12)');
          tagElement.style.setProperty('--tag-bg-2', 'rgba(140,255,200,0.04)');
          tagElement.style.setProperty('--tag-border', 'rgba(64,200,120,0.85)');
          tagElement.style.setProperty('--tag-text', '#fff');
          tagElement.style.setProperty('--tag-shine', 'rgba(120,255,190,0.4)');
          tagElement.style.setProperty('--tag-glow', '#40c878');
          tagElement.style.setProperty('--tag-glow-soft', 'rgba(64,200,120,0.25)');
        } else if (tag.name.toLowerCase().includes('origins')) {
          tagElement.style.setProperty('--tag-bg-1', 'rgba(245,197,66,0.14)');
          tagElement.style.setProperty('--tag-bg-2', 'rgba(255,235,170,0.04)');
          tagElement.style.setProperty('--tag-border', 'rgba(245,197,66,0.85)');
          tagElement.style.setProperty('--tag-text', '#fff');
          tagElement.style.setProperty('--tag-shine', 'rgba(255,219,130,0.4)');
          tagElement.style.setProperty('--tag-glow', '#f5c542');
          tagElement.style.setProperty('--tag-glow-soft', 'rgba(245,197,66,0.25)');
        }
        if (!tag.isRole) {
          tagElement.style.fontSize = '33px';
          tagElement.style.fontWeight = '700';
        }
        const normalizedAnimation = (tag.animation || '').toLowerCase().trim();
        tagElement.dataset.anim = normalizedAnimation || (tag.isRole ? 'role-pulse' : 'member-shine');
        tagElement.style.animation = 'none';
        tagElement.style.outline = 'none';
        tagElement.appendChild(tagLabel);

        roleTagsContainer.appendChild(tagElement);
        tagElements.push(tagElement);
      };

      tags.forEach(tag => appendTag(tag));

      tagElements.forEach((tagEl) => attachLottieGlow(tagEl));
    };

    try {
      const { role: resolvedRole } = await getRole();
      const roleRaw = (resolvedRole || profile.role || session.user?.user_metadata?.role || 'fan');
      const normalizedRole = roleRaw.toLowerCase().trim().replace(/\s+/g, '-');

      const gatewayData = await getUserTags(session.user.id) as any;
      const gatewayTags = Array.isArray(gatewayData?.tags)
        ? gatewayData.tags
        : Array.isArray(gatewayData?.data?.tags)
          ? gatewayData.data.tags
          : [];

      const allTags: TagDisplay[] = [];

      if (roleRaw) {
        const parsedRoleId = parseInt(String(roleRaw), 10);
        const roleId = Number.isFinite(parsedRoleId) ? parsedRoleId : 0;
        allTags.push({
          name: roleRaw.toUpperCase(),
          cssClass: `role-${normalizedRole}`,
          isRole: true,
          id: roleId
        });
      }

      gatewayTags.forEach((tag: any) => {
        const rawName = (tag.tag_name || tag.name || '').trim();
        if (!rawName) return;
        const normalizedName = rawName.toLowerCase().replace(/\s+/g, '-');
        const cssClass = tag.cssClass || `role-${normalizedName}`;

        allTags.push({
          name: rawName.toUpperCase(),
          cssClass,
          color: tag.color,
          animation: tag.animation,
          isRole: false,
          id: tag.id || tag.tag_id
        });
      });

      if (allTags.length === 0) {
        allTags.push({ name: 'FAN', cssClass: 'role-fan', isRole: true });
      }

      const uniqueTags: TagDisplay[] = [];
      const seenKeys = new Set<string>();

      allTags.sort((a, b) => (a.isRole === b.isRole) ? 0 : (a.isRole ? -1 : 1));

      allTags.forEach(tag => {
        const stableKey = tag.id != null
          ? String(tag.id)
          : `${tag.name}-${tag.color || ''}-${tag.animation || ''}`;
        const key = `${tag.isRole ? 'role' : 'tag'}-${stableKey}`;
        if (!seenKeys.has(key)) {
          seenKeys.add(key);
          uniqueTags.push(tag);
        }
      });

      displayUserTags(uniqueTags);
    } catch (error) {
      console.error('Error loading user tags/roles:', error);
      displayUserTags([{ name: 'FAN', cssClass: 'role-fan' }]);
    }
    
    // Los roles ahora son invisibles (solo para permisos internos)
    // Mantener la corona solo para referencia interna, pero no mostrar roles
    const { role: resolvedRoleCheck } = await getRole(); 
    const roleRaw = (resolvedRoleCheck || profile.role || session.user?.user_metadata?.role || 'fan');
    
    const roleId = parseInt(roleRaw) || 0;
    
    // La corona se muestra solo para owners (1-11) como referencia interna
    crownEl?.classList.toggle('is-visible', roleId >= 1 && roleId <= 11);
    
    if (profile.avatar_url && avatarImg instanceof HTMLImageElement) {
      avatarImg.src = profile.avatar_url;
      avatarImg.classList.remove('hidden');
      avatarPlaceholder?.classList.add('hidden');
    } else if (avatarPlaceholder) {
      avatarPlaceholder.textContent = profile.nombre?.substring(0, 2).toUpperCase() || 'WG';
    }

    // 4. Show Content
    profileMain?.classList.remove('opacity-0');

    // Tab functionality
    const tabs = document.querySelectorAll('.tab');
    const tabContents = document.querySelectorAll('.tab-content');

    tabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        const targetTab = tab instanceof HTMLElement ? tab.dataset.tab : null;
        tabs.forEach(t => t.classList.remove('active'));
        tabContents.forEach(content => content.classList.remove('active'));
        tab.classList.add('active');
        const targetContent = targetTab ? document.getElementById(targetTab) : null;
        if (targetContent) targetContent.classList.add('active');
      });
    });

    // Avatar edit button
    const avatarEdit = document.querySelector('.avatar-edit');
    if (avatarEdit) {
      avatarEdit.addEventListener('click', () => {
        alert('Función de cambio de avatar - Próximamente');
      });
    }

    // Following buttons
    const followingBtns = document.querySelectorAll('.following-btn');
    followingBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.classList.contains('following')) {
          btn.classList.remove('following');
          btn.textContent = 'Seguir';
        } else {
          btn.classList.add('following');
          btn.textContent = 'Siguiendo';
        }
      });
    });

    // Play buttons
    const playBtns = document.querySelectorAll('.play-btn');
    playBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        if (btn.textContent === '▶') {
          btn.textContent = '⏸';
        } else {
          btn.textContent = '▶';
        }
      });
    });
  };

  const run = () => {
    console.log('Iniciando initProfile...');
    initProfile().catch((error) => {
      console.error('Error en initProfile:', error);
    });
  };
  
  // Ejecutar inmediatamente si el DOM está listo
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run);
  } else {
    run();
  }
  
  // También ejecutar después de cambios de página en Astro
  document.addEventListener('astro:after-swap', run);
  
  // Timeout adicional para asegurar que todo esté cargado
  setTimeout(() => {
    console.log('Ejecutando timeout adicional...');
    const birthdayBanner = document.getElementById('birthday-banner');
    if (birthdayBanner) {
      const isHidden = birthdayBanner.classList.contains('hidden');
      const hasActive = birthdayBanner.classList.contains('is-active');
      console.log('Timeout check - hidden:', isHidden, 'active:', hasActive);
      
      if (!isHidden && !hasActive) {
        console.log('Forzando oculto desde timeout');
        birthdayBanner.classList.add('hidden');
        birthdayBanner.style.setProperty('display', 'none', 'important');
      }
    }
  }, 1000);
</script>
