---
import Layout from '../layouts/Layout.astro';
---

<Layout config={{
  name: "Wild Gvng - Mi Perfil",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>
  <div class="pf" id="profile-main">

    <!-- UNAUTHENTICATED STATE -->
    <div id="unauth-state" class="unauth hidden">
      <div class="unauth-icon">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="color:var(--primary)"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
      </div>
      <h2 class="unauth-title">Acceso Restringido</h2>
      <p class="unauth-sub">Debes iniciar sesión para ver tu perfil</p>
      <div class="unauth-actions">
        <a href="/login" class="btn-p btn-gold">Iniciar Sesión</a>
        <a href="/registro" class="btn-p btn-ghost">Crear Cuenta</a>
      </div>
    </div>

    <!-- AUTHENTICATED CONTENT -->
    <div id="auth-content" class="auth hidden">

      <div class="pf-body">
        <div class="pf-grid">

          <!-- LEFT SIDEBAR (25%) -->
          <aside class="pf-side">
            <!-- Avatar Card -->
            <div class="side-card">
              <div class="side-avatar-wrap">
                <div class="side-avatar-box" id="avatar-box">
                  <div id="avatar-placeholder" class="avatar-initials">WG</div>
                  <img id="profile-avatar-img" src="" alt="Avatar" class="avatar-img hidden" />
                </div>
                <button class="avatar-edit-btn" id="avatar-edit-btn" title="Cambiar foto">
                  <svg width="14" height="14" viewBox="0 0 16 16" fill="currentColor"><path d="M12.146.146a.5.5 0 0 1 .708 0l3 3a.5.5 0 0 1 0 .708l-10 10a.5.5 0 0 1-.168.11l-5 2a.5.5 0 0 1-.65-.65l2-5a.5.5 0 0 1 .11-.168l10-10zM11.207 2.5 13.5 4.793 14.793 3.5 12.5 1.207 11.207 2.5zm1.586 3L10.5 3.207 4 9.707V10h.5a.5.5 0 0 1 .5.5v.5h.5a.5.5 0 0 1 .5.5v.5h.293l6.5-6.5zm-9.761 5.175-.106.106-1.528 3.821 3.821-1.528.106-.106A.5.5 0 0 1 5 12.5V12h-.5a.5.5 0 0 1-.5-.5V11h-.5a.5.5 0 0 1-.468-.325z"/></svg>
                </button>
              </div>
              <h2 class="side-name" id="profile-name">Cargando...</h2>
              <p class="side-username" id="profile-username">@usuario</p>
              <div class="side-tags" id="profile-role-tags"></div>
            </div>

            <!-- Bio Card -->
            <div class="side-card" id="bio-card">
              <h4 class="side-label">SOBRE MÍ</h4>
              <p class="side-bio" id="profile-bio">Cargando biografía...</p>
            </div>

            <!-- Stats Card -->
            <div class="side-card">
              <h4 class="side-label">ESTADÍSTICAS</h4>
              <div class="side-stats">
                <div class="stat-item">
                  <span class="stat-num" id="stat-following">0</span>
                  <span class="stat-label">Siguiendo</span>
                </div>
                <div class="stat-item">
                  <span class="stat-num" id="stat-partnean">0</span>
                  <span class="stat-label">Partnean</span>
                </div>
                <div class="stat-item">
                  <span class="stat-num" id="stat-posts">0</span>
                  <span class="stat-label">Posts</span>
                </div>
              </div>
            </div>

            <!-- Logout -->
            <div class="side-card">
              <button class="logout-btn" id="profile-logout-btn">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
                Cerrar Sesión
              </button>
            </div>
          </aside>

          <!-- RIGHT DASHBOARD (75%) -->
          <div class="pf-feed">

            <!-- Artist Dashboard Actions -->
            <div id="artist-dashboard" class="hidden">
              <div class="dash-grid">

                <!-- Publicar nuevo post -->
                <div class="dash-card dash-card-wide" id="composer-card">
                  <div class="dash-card-header">✍️ Nuevo Post</div>
                  <textarea id="composer-text" rows="3" class="dash-textarea" placeholder="¿Qué estás tramando? (texto + foto opcional)"></textarea>
                  <div class="dash-toolbar">
                    <div class="dash-types">
                      <button class="dash-type-btn active" data-type="text">📝 Texto</button>
                      <button class="dash-type-btn" data-type="photo">📷 Foto</button>
                      <button class="dash-type-btn" data-type="music">🎵 Música</button>
                    </div>
                    <div class="dash-actions">
                      <input type="file" id="composer-file" accept="image/png,image/jpeg,image/webp" style="display:none" />
                      <button id="composer-file-btn" class="dash-btn">📎 Imagen</button>
                      <button id="composer-submit" class="dash-submit">Publicar → Aprobación</button>
                    </div>
                  </div>
                  <div id="composer-msg" class="dash-msg"></div>
                  <div id="composer-preview" class="hidden dash-preview"></div>
                </div>

                <!-- Mis Estadisticas -->
                <div class="dash-card">
                  <div class="dash-card-header">📊 Mis Estadísticas</div>
                  <div style="display:flex;gap:20px;padding:8px 0;flex-wrap:wrap;">
                    <div><span style="font-size:22px;font-weight:800;"><span id="stat-posts">0</span></span><br /><span style="font-size:10px;color:var(--text-muted);text-transform:uppercase;">Posts</span></div>
                    <div><span style="font-size:22px;font-weight:800;"><span id="stat-partnean">0</span></span><br /><span style="font-size:10px;color:var(--text-muted);text-transform:uppercase;">Partnear</span></div>
                  </div>
                </div>

                <!-- Editar perfil -->
                <div class="dash-card">
                  <div class="dash-card-header">📋 Editar Perfil</div>
                  <div class="dash-form">
                    <input id="edit-name" class="dash-input" placeholder="Nombre" />
                    <input id="edit-bio" class="dash-input" placeholder="Bio" />
                    <button id="edit-save" class="dash-submit" style="margin-top:4px;">Guardar Cambios</button>
                    <span id="edit-msg" class="dash-msg"></span>
                  </div>
                </div>

                <!-- Links Sociales -->
                <div class="dash-card">
                  <div class="dash-card-header">🔗 Redes Sociales</div>
                  <div class="dash-form">
                    <input id="edit-instagram" class="dash-input" placeholder="Instagram URL" />
                    <input id="edit-spotify" class="dash-input" placeholder="Spotify URL" />
                    <input id="edit-youtube" class="dash-input" placeholder="YouTube URL" />
                    <button id="edit-social-save" class="dash-submit" style="margin-top:4px;">Guardar Redes</button>
                    <span id="edit-social-msg" class="dash-msg"></span>
                  </div>
                </div>

                <!-- Sección de navegación secundaria -->
                <div class="dash-card dash-nav-card">
                  <div class="dash-card-header">📂 Mi Actividad</div>
                  <div class="dash-nav-links">
                    <a href="#" class="dash-nav-item" data-nav="feed">📰 Ver mi Feed</a>
                    <a href="#" class="dash-nav-item" data-nav="likes">❤️ Ver mis Me Gusta</a>
                    <a href="#" class="dash-nav-item" data-nav="reposts">🔄 Ver mis Reposts</a>
                    <a href="/artista?" id="dash-public-link" class="dash-nav-item">👤 Mi Perfil Público</a>
                    <a href="/configuracion" class="dash-nav-item">⚙️ Configuración</a>
                  </div>
                </div>
              </div>
            </div>

            <!-- View containers -->
            <div id="view-container" class="hidden">
              <button id="view-back" class="dash-back">← Volver al Dashboard</button>
              <div id="view-content"></div>
            </div>

          </div>

        </div>
      </div>

    </div>

  </div>

  <!-- Image Preview Dialog -->
  <dialog id="img-preview-dialog" class="img-dialog">
    <div class="img-dialog-content">
      <div class="img-dialog-header">
        <span class="img-dialog-title">Previsualizar Imagen</span>
        <button class="img-dialog-close" id="img-dialog-cancel">✕</button>
      </div>
      <div class="img-dialog-body">
        <img id="img-preview-img" src="" alt="Preview" class="img-preview-img" />
      </div>
      <div class="img-dialog-footer">
        <button class="dash-btn" id="img-dialog-cancel-btn">Cancelar</button>
        <button class="dash-submit" id="img-dialog-confirm">Confirmar y Subir</button>
      </div>
    </div>
  </dialog>

</Layout>

<style>
  /* ============================================
     CSS VARIABLES (from Layout)
     --primary: #c98300
     --secondary: #8a0303
     --bg: #000000
     --bg-card: var(--bg-card)
     --border: var(--border-muted)
     --text: #ffffff
     --text-secondary: var(--text-secondary)
     --text-muted: var(--border-soft)
     ============================================ */

  .pf { min-height:100vh; background:var(--bg); color:var(--text); font-family:'Outfit',sans-serif; }
  .pf-body { max-width:1200px; margin:0 auto; padding:24px 16px; }
  .pf-grid { display:flex; gap:24px; align-items:flex-start; }
  .pf-side { width:32%; min-width:280px; flex-shrink:0; display:flex; flex-direction:column; gap:12px; }
  .pf-feed { flex:1; min-width:0; }

  /* ── UNAUTH STATE ── */
  .unauth {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    min-height: 60vh;
    text-align: center;
    gap: 20px;
    padding: 40px 20px;
  }
  .unauth.hidden { display: none; }

  /* ── DASHBOARD ── */
  #artist-dashboard.hidden, #view-container.hidden { display:none; }
  .dash-grid { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  .dash-card-wide { grid-column:1/-1; }
  .dash-card { background:var(--bg-card); border:1px solid var(--border); border-radius:12px; padding:16px; display:flex; flex-direction:column; gap:10px; }
  .dash-link { text-decoration:none; color:var(--text); position:relative; cursor:pointer; }
  .dash-link:hover { border-color:var(--primary); }
  .dash-card-header { font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; }
  .dash-desc { font-size:11px; color:var(--text-muted); }
  .dash-arrow { position:absolute; top:16px; right:16px; font-size:18px; color:var(--primary); }
  .dash-textarea { width:100%; background:var(--bg); border:1px solid var(--border); border-radius:8px; padding:10px; color:var(--text); font-size:13px; font-family:inherit; resize:vertical; outline:none; }
  .dash-textarea:focus { border-color:var(--primary); }
  .dash-toolbar { display:flex; justify-content:space-between; align-items:center; flex-wrap:wrap; gap:8px; }
  .dash-types { display:flex; gap:4px; flex-wrap:wrap; }
  .dash-type-btn { padding:3px 10px; font-size:9px; font-weight:700; text-transform:uppercase; border:1px solid var(--border); border-radius:20px; background:none; color:var(--text-muted); cursor:pointer; }
  .dash-type-btn:hover { color:var(--text); }
  .dash-type-btn.active { background:var(--primary); color:var(--bg); border-color:var(--primary); }
  .dash-actions { display:flex; gap:6px; align-items:center; flex-wrap:wrap; }
  .dash-btn { padding:4px 10px; font-size:10px; font-weight:600; border:1px solid var(--border); border-radius:6px; background:none; color:var(--text-muted); cursor:pointer; }
  .dash-btn:hover { color:var(--text); }
  .dash-submit { padding:5px 14px; font-size:9px; font-weight:700; text-transform:uppercase; border:none; border-radius:6px; background:var(--primary); color:var(--bg); cursor:pointer; white-space:nowrap; }
  .dash-submit:hover { background:var(--primary-hover); }
  .dash-msg { font-size:10px; color:var(--text-muted); min-height:16px; }
  .dash-preview img { max-height:120px; border-radius:6px; }
  .dash-form { display:flex; flex-direction:column; gap:6px; }
  .dash-input { width:100%; background:var(--bg); border:1px solid var(--border); border-radius:6px; padding:6px 10px; color:var(--text); font-size:12px; font-family:inherit; outline:none; }
  .dash-input:focus { border-color:var(--primary); }
  .dash-nav-card { grid-column:1/-1; }
  .dash-nav-links { display:flex; gap:4px; flex-wrap:wrap; }
  .dash-nav-item { padding:6px 14px; border:1px solid var(--border); border-radius:8px; text-decoration:none; color:var(--text); font-size:11px; font-weight:600; }
  .dash-nav-item:hover { border-color:var(--primary); color:var(--primary); }
  .dash-back { background:none; border:1px solid var(--border); border-radius:8px; padding:6px 14px; color:var(--text); font-size:11px; cursor:pointer; margin-bottom:12px; }
  .dash-back:hover { border-color:var(--primary); }

  /* ── IMAGE PREVIEW DIALOG ── */
  .img-dialog {
    background:var(--bg); border:1px solid var(--border); border-radius:16px;
    padding:0; max-width:500px; width:90vw; box-shadow:0 20px 60px rgba(0,0,0,0.5);
  }
  .img-dialog::backdrop { background:rgba(0,0,0,0.7); }
  .img-dialog-content { display:flex; flex-direction:column; }
  .img-dialog-header {
    display:flex; justify-content:space-between; align-items:center;
    padding:14px 18px; border-bottom:1px solid var(--border);
  }
  .img-dialog-title { font-size:12px; font-weight:700; text-transform:uppercase; letter-spacing:0.08em; }
  .img-dialog-close { background:none; border:none; color:var(--text); cursor:pointer; font-size:16px; padding:4px; }
  .img-dialog-close:hover { color:var(--primary); }
  .img-dialog-body { padding:18px; display:flex; justify-content:center; }
  .img-preview-img { max-width:100%; max-height:400px; border-radius:8px; object-fit:contain; }
  .img-dialog-footer {
    display:flex; justify-content:flex-end; gap:8px;
    padding:12px 18px; border-top:1px solid var(--border);
  }
  .unauth-icon {
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background: var(--bg-card);
    border: 1px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 8px;
  }
  .unauth-title {
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0;
    text-transform: uppercase;
    letter-spacing: -0.02em;
  }
  .unauth-sub {
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--text-muted);
    margin: 0;
  }
  .unauth-actions {
    display: flex;
    gap: 10px;
    padding-top: 12px;
  }

  /* ── BUTTONS ── */
  .btn-p {
    padding: 10px 28px;
    border-radius: 8px;
    font-size: 0.6rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    text-decoration: none;
    transition: all 0.15s;
  }
  .btn-gold {
    background: var(--primary);
    border: none;
    color: var(--bg);
  }
  .btn-gold:hover { background: var(--primary-hover); }
  .btn-ghost {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
  }
  .btn-ghost:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  /* ── GRID ── */
  .auth.hidden { display: none; }
  .pf-body {
    max-width: 90%;
    margin: 0 auto;
    padding: 0 0 60px;
  }
  .pf-grid {
    display: grid;
    grid-template-columns: 25% 75%;
    gap: 20px;
    margin-top: 20px;
  }

  /* ── SIDEBAR ── */
  .pf-side {
    position: sticky;
    top: 24px;
  }
  .side-card {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
    margin-bottom: 10px;
  }
  .side-avatar-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 12px;
    position: relative;
  }
  .side-avatar-box {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    overflow: hidden;
    border: 2px solid var(--border);
    background: var(--bg-card);
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .avatar-initials {
    font-size: 1.8rem;
    font-weight: 800;
    color: var(--primary);
    user-select: none;
  }
  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .avatar-img.hidden { display: none; }
  .avatar-edit-btn {
    position: absolute;
    bottom: 2px;
    right: -4px;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: var(--primary);
    border: 2px solid var(--bg);
    color: var(--bg);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: transform 0.15s;
    z-index: 2;
  }
  .avatar-edit-btn:hover { transform: scale(1.1); }
  .side-name {
    font-size: 1rem;
    font-weight: 800;
    margin: 0 0 2px;
    text-align: center;
    color: var(--text);
    line-height: 1.2;
  }
  .side-username {
    font-size: 0.65rem;
    font-weight: 600;
    color: var(--primary);
    text-align: center;
    margin: 0 0 10px;
    font-family: monospace;
  }
  .side-tags {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 4px;
  }
  .side-label {
    font-size: 0.5rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    margin: 0 0 10px;
    font-family: monospace;
  }
  .side-bio {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }

  /* Stats */
  .side-stats {
    display: flex;
    justify-content: space-between;
    gap: 8px;
  }
  .stat-item {
    flex: 1;
    text-align: center;
  }
  .stat-num {
    display: block;
    font-size: 1.1rem;
    font-weight: 800;
    color: var(--text);
    line-height: 1.2;
  }
  .stat-label {
    display: block;
    font-size: 0.45rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    font-family: monospace;
    margin-top: 2px;
  }

  /* Logout */
  .logout-btn {
    width: 100%;
    padding: 8px 12px;
    border-radius: 6px;
    background: transparent;
    border: 1px solid rgba(255, 80, 80, 0.2);
    color: var(--event);
    font-size: 0.6rem;
    font-weight: 700;
    font-family: inherit;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 6px;
    transition: all 0.15s;
  }
  .logout-btn:hover {
    background: rgba(255, 80, 80, 0.1);
    border-color: rgba(255, 80, 80, 0.4);
    color: var(--event);
  }

  /* Role tags */
  .role-tag {
    display: inline-flex;
    align-items: center;
    padding: 4px 12px;
    border-radius: 100px;
    font-size: 0.55rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: var(--primary-soft);
    border: 1px solid var(--primary-border);
    color: var(--primary);
    font-family: monospace;
    white-space: nowrap;
  }

  /* ── FEED TABS ── */
  .feed-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 16px;
  }
  .feed-tab {
    flex: 1;
    padding: 10px 8px;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    font-size: 0.6rem;
    font-weight: 700;
    font-family: monospace;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.15s;
    text-align: center;
  }
  .feed-tab:hover { color: var(--text-secondary); }
  .feed-tab.active {
    color: var(--primary);
    border-bottom-color: var(--primary);
  }

  /* FEED TAB CONTENT */
  .feed-tab-content { display: none; }
  .feed-tab-content.active { display: block; }

  /* ── COMPOSER ── */
  .pf-composer { border:1px solid var(--border); border-radius:12px; padding:14px; margin-bottom:16px; background:var(--bg-card); }
  .pf-composer.hidden { display:none; }
  .composer-input {
    width:100%; background:var(--bg); border:1px solid var(--border); border-radius:8px;
    padding:10px 12px; color:var(--text); font-size:14px; font-family:inherit;
    resize:vertical; outline:none;
  }
  .composer-input:focus { border-color:var(--primary); }
  .cp-btn {
    padding:3px 10px; font-size:10px; font-weight:700; text-transform:uppercase;
    border:1px solid var(--border); border-radius:20px; background:none;
    color:var(--text-muted); cursor:pointer; transition:all 0.15s; letter-spacing:0.05em;
  }
  .cp-btn:hover { color:var(--text); border-color:var(--text); }
  .cp-btn.active { background:var(--primary); color:var(--bg); border-color:var(--primary); }
  .cp-action {
    padding:3px 10px; font-size:10px; font-weight:600;
    border:1px solid var(--border); border-radius:6px; background:none;
    color:var(--text-muted); cursor:pointer;
  }
  .cp-action:hover { color:var(--text); }
  .cp-submit {
    padding:3px 16px; font-size:10px; font-weight:700; text-transform:uppercase;
    border:none; border-radius:6px; background:var(--primary); color:var(--bg);
    cursor:pointer;
  }
  .cp-submit:hover { background:var(--primary-hover); }

  /* ── FEED / POSTS ── */
  .feed-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .feed-empty {
    text-align: center;
    padding: 24px 0;
    color: var(--text-muted);
    font-size: 0.75rem;
    margin: 0;
  }
  .fp {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
    transition: border-color 0.15s;
  }
  .fp:hover { border-color: var(--primary); }
  .fp-top {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
  .fp-av {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .fp-who {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .fp-name {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text);
  }
  .fp-when {
    font-size: 0.5rem;
    color: var(--text-muted);
    font-family: monospace;
  }
  .fp-tag {
    font-size: 0.45rem;
    font-weight: 700;
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 2px 7px;
    border-radius: 100px;
    text-transform: capitalize;
    flex-shrink: 0;
  }
  .fp-txt {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0 0 10px;
  }
  .fp-img {
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 10px;
  }
  .fp-img img {
    width: 100%;
    height: auto;
    display: block;
  }
  .fp-embed { margin-bottom: 10px; }
  .fp-ph {
    padding: 10px 14px;
    border-radius: 8px;
    margin-bottom: 10px;
    font-size: 0.7rem;
    font-weight: 700;
  }
  .fp-music {
    background: var(--primary-soft);
    border: 1px solid var(--primary-border);
    color: var(--primary);
  }
  .fp-event {
    background: var(--secondary-soft);
    border: 1px solid var(--secondary-border);
    color: var(--event);
  }

  /* ── ACTIONS ── */
  .fp-acts {
    display: flex;
    gap: 4px;
    border-top: 1px solid var(--border);
    padding-top: 8px;
  }
  .fp-a {
    flex: 1;
    padding: 5px;
    border-radius: 5px;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.55rem;
    font-weight: 600;
    cursor: pointer;
    text-align: center;
    font-family: inherit;
    transition: all 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }
  .fp-a:hover { color: var(--primary); }
  .fp-a.liked { color: var(--primary); }
  .fp-a.liked .like-icon { color: var(--primary); }
  .fp-a.reposted { color: var(--repost); }
  .fp-a.reposted .repost-icon { color: var(--repost); }
  .like-icon {
    font-size: 0.7rem;
    transition: transform 0.2s;
  }
  .fp-a.liked .like-icon { transform: scale(1.2); }
  .repost-icon {
    font-size: 0.7rem;
    transition: transform 0.2s;
  }
  .fp-a.reposted .repost-icon { transform: scale(1.15); }

  /* ── COMMENTS ── */
  .comments-section {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--border);
  }
  .comments-section.hidden { display: none; }
  .comments-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 10px;
  }
  .comment-item {
    display: flex;
    gap: 8px;
  }
  .comment-item img {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .comment-body { flex: 1; }
  .comment-author {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text);
  }
  .comment-text {
    font-size: 0.7rem;
    color: var(--text-secondary);
    margin-top: 2px;
  }
  .comment-time {
    font-size: 0.45rem;
    color: var(--text-muted);
    font-family: monospace;
    margin-top: 2px;
  }
  .comment-form {
    display: flex;
    gap: 6px;
  }
  .comment-input {
    flex: 1;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 0.7rem;
    color: var(--text);
    font-family: inherit;
    outline: none;
  }
  .comment-input:focus { border-color: var(--primary); }
  .comment-input::placeholder { color: var(--text-muted); }
  .comment-send {
    padding: 6px 10px;
    border-radius: 6px;
    background: var(--primary-soft);
    border: none;
    color: var(--primary);
    font-size: 0.7rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s;
  }
  .comment-send:hover {
    background: var(--primary);
    color: var(--bg);
  }
  .comment-send:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  /* ── TABLET ── */
  @media (max-width: 860px) {
    .pf-grid {
      grid-template-columns: 1fr;
    }
    .pf-side {
      order: -1;
      position: static;
    }
    .side-card:nth-child(n+3) {
      display: none;
    }
    .side-avatar-box {
      width: 80px;
      height: 80px;
    }
  }

  /* ── MOBILE ── */
  @media (max-width: 600px) {
    .pf-body {
      padding: 0 0 40px;
    }
    .pf-grid {
      gap: 12px;
    }
    .side-card:nth-child(n+2) {
      display: none;
    }
    .side-card:first-child {
      text-align: center;
    }
    .side-avatar-box {
      width: 72px;
      height: 72px;
    }
    .avatar-initials { font-size: 1.4rem; }
    .feed-tabs {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .feed-tab {
      font-size: 0.5rem;
      padding: 8px 6px;
      white-space: nowrap;
    }
    .fp { padding: 12px; }
    .fp-av {
      width: 24px;
      height: 24px;
    }
    .fp-txt { font-size: 0.75rem; }
  }
</style>

<script>
  import { supabase } from '../lib/supabase.js';
  import { getRole } from '../lib/role.js';
  import { getUserTags } from '../lib/tags-gateway.js';

  let currentUser: any = null;
  let currentProfile: any = null;
  let myPosts: any[] = [];

  /* ── INIT ── */
  const initProfile = async () => {
    const unauthSection = document.getElementById('unauth-state');
    const authContent = document.getElementById('auth-content');

    const { data: { session } } = await supabase.auth.getSession();
    currentUser = session?.user || null;

    if (!currentUser) {
      unauthSection?.classList.remove('hidden');
      return;
    }

    // Fetch profile
    const { data: profile, error } = await supabase
      .from('profiles')
      .select('*')
      .eq('id', currentUser.id)
      .single();

    if (error || !profile) {
      console.error('Error fetching profile:', error);
      unauthSection?.classList.remove('hidden');
      return;
    }

    currentProfile = profile;
    authContent?.classList.remove('hidden');

    // Update UI
    const nameEl = document.getElementById('profile-name');
    const usernameEl = document.getElementById('profile-username');
    const bioEl = document.getElementById('profile-bio');
    const avatarImg = document.getElementById('profile-avatar-img');
    const avatarPlaceholder = document.getElementById('avatar-placeholder');

    if (nameEl) nameEl.textContent = profile.nombre || 'Usuario Wild';
    if (usernameEl) usernameEl.textContent = `@${profile.nombre?.toLowerCase().replace(/\s/g, '_') || 'usuario'}`;
    if (bioEl) bioEl.textContent = profile.bio || 'Miembro de Wild Gvng • Amante del hip-hop urbano';

    if (profile.avatar_url && avatarImg instanceof HTMLImageElement) {
      avatarImg.src = profile.avatar_url;
      avatarImg.classList.remove('hidden');
      avatarPlaceholder?.classList.add('hidden');
    } else if (avatarPlaceholder) {
      avatarPlaceholder.textContent = profile.nombre?.substring(0, 2).toUpperCase() || 'WG';
    }

    // Load tags
    loadUserTags(profile);

    // Check if user is artist and show dashboard
    const { role: userRole } = await getRole();
    if (userRole === 'artist') {
      const dashboard = document.getElementById('artist-dashboard');
      if (dashboard) {
        dashboard.classList.remove('hidden');
        // Set public link
        const slug = profile.username || profile.nombre?.toLowerCase().replace(/\s/g, '_') || profile.id;
        const link = document.getElementById('dash-public-link');
        if (link) link.href = `/artista?id=${slug}`;
        // Load profile fields
        const nEl = document.getElementById('edit-name');
        const bEl = document.getElementById('edit-bio');
        if (nEl) nEl.value = profile.nombre || '';
        if (bEl) bEl.value = profile.bio || '';
        const insta = document.getElementById('edit-instagram');
        const spot = document.getElementById('edit-spotify');
        const yt = document.getElementById('edit-youtube');
        if (insta) insta.value = profile.instagram_url || '';
        if (spot) spot.value = profile.spotify_url || '';
        if (yt) yt.value = profile.youtube_url || '';
      }
    }

    // Fan / other roles: show a simpler version
    if (userRole !== 'artist') {
      // Remove the dash-card from composer and show simple info
    }

    // Load posts
    loadMyPosts(profile.id);
    loadLikedPosts();
    loadRepostedPosts();
  };

  /* ── ARTIST-SPECIFIC ── */
  async function loadArtistPosts(artistId: string) {
    try {
      const { data: posts } = await supabase
        .from('artist_posts')
        .select('*')
        .eq('artist_id', artistId)
        .order('created_at', { ascending: false })
        .limit(10);
      if (posts?.length) {
        const list = document.getElementById('my-posts-list');
        if (list) {
          list.innerHTML = posts.map(p => `
            <div class="feed-item" data-post-id="${p.id}">
              <p class="feed-item-text">${p.content || ''}</p>
              ${p.image_url ? `<img src="${p.image_url}" class="feed-item-img" style="max-height:200px;border-radius:8px;object-fit:cover;" />` : ''}
              <div style="display:flex;justify-content:space-between;align-items:center;">
                <div class="feed-item-meta">
                  <span>❤️ ${p.likes_count || 0}</span>
                  <span>💬 ${p.comments_count || 0}</span>
                  <span class="feed-item-type">${p.post_type || 'text'}</span>
                  <span style="font-size:10px;color:var(--text-faint);">${new Date(p.created_at).toLocaleDateString('es-MX')}</span>
                </div>
                <button class="delete-post-btn" data-id="${p.id}" style="background:none;border:none;color:var(--danger);cursor:pointer;font-size:11px;opacity:0.5;hover:opacity:1;">🗑️</button>
              </div>
            </div>
          `).join('');
        }
      }
    } catch(e) {}
  }

  async function loadArtistStats(artistId: string) {
    try {
      const { count: partnearCount } = await supabase
        .from('partnear')
        .select('*', { count: 'exact', head: true })
        .eq('artist_id', artistId);
      const el = document.getElementById('stat-partnean');
      if (el) el.textContent = String(partnearCount ?? 0);
    } catch(e) {}

    try {
      const { count: postCount } = await supabase
        .from('artist_posts')
        .select('*', { count: 'exact', head: true })
        .eq('artist_id', artistId);
      const el = document.getElementById('stat-posts');
      if (el) el.textContent = String(postCount ?? 0);
    } catch(e) {}
  }

  /* ── TAGS ── */
  async function loadUserTags(profile: any) {
    const roleTagsContainer = document.getElementById('profile-role-tags');
    if (!roleTagsContainer) return;
    roleTagsContainer.innerHTML = '';

    try {
      const { role: resolvedRole } = await getRole();
      const roleRaw = (resolvedRole || profile.role || currentUser?.user_metadata?.role || 'fan');

      const resolvedUserId = profile.id || currentUser.id;
      const gatewayData = await getUserTags(resolvedUserId) as any;
      const gatewayTags = Array.isArray(gatewayData?.tags)
        ? gatewayData.tags
        : Array.isArray(gatewayData?.data?.tags)
          ? gatewayData.data.tags
          : [];

      const allTags: { name: string; isRole: boolean }[] = [];

      if (roleRaw) {
        allTags.push({ name: roleRaw.toUpperCase(), isRole: true });
      }

      gatewayTags.forEach((tag: any) => {
        const rawName = (tag.tag_name || tag.name || '').trim();
        if (!rawName) return;
        allTags.push({ name: rawName.toUpperCase(), isRole: false });
      });

      if (allTags.length === 0) {
        allTags.push({ name: 'FAN', isRole: true });
      }

      allTags.sort((a, b) => (a.isRole === b.isRole ? 0 : a.isRole ? -1 : 1));

      allTags.forEach(tag => {
        const el = document.createElement('span');
        el.className = 'role-tag';
        el.textContent = tag.name;
        roleTagsContainer.appendChild(el);
      });
    } catch (err) {
      console.error('Error loading tags:', err);
      const el = document.createElement('span');
      el.className = 'role-tag';
      el.textContent = 'FAN';
      roleTagsContainer.appendChild(el);
    }
  }

  /* ── POSTS ── */
  function timeAgo(dateStr: string): string {
    const diff = Date.now() - new Date(dateStr).getTime();
    const mins = Math.floor(diff / 60000);
    if (mins < 60) return `${mins}m`;
    const hrs = Math.floor(mins / 60);
    if (hrs < 24) return `${hrs}h`;
    const days = Math.floor(hrs / 24);
    if (days < 7) return `${days}d`;
    return `${Math.floor(days / 7)}sem`;
  }

  function renderPost(post: any, profile: any): HTMLElement {
    const article = document.createElement('article');
    article.className = 'fp';
    article.setAttribute('data-post-id', post.id);

    const avatarUrl = profile.avatar_url || '';
    const displayName = profile.nombre || 'Usuario';
    const initials = displayName.substring(0, 2).toUpperCase();

    let mediaHtml = '';
    if (post.post_type === 'photo' && post.image_url) {
      mediaHtml = `<div class="fp-img"><img src="${post.image_url}" alt="" loading="lazy" /></div>`;
    } else if (post.post_type === 'music' && post.embed_url) {
      mediaHtml = `<div class="fp-embed"><iframe src="${post.embed_url}" width="100%" height="80" frameBorder="0" allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture" loading="lazy" style="border-radius:12px;"></iframe></div>`;
    } else if (post.post_type === 'music' && !post.embed_url && post.embed_title) {
      mediaHtml = `<div class="fp-ph fp-music">${post.embed_title}</div>`;
    } else if (post.post_type === 'event' && post.embed_title) {
      mediaHtml = `<div class="fp-ph fp-event">${post.embed_title}</div>`;
    }

    article.innerHTML = `
      <div class="fp-top">
        <div class="fp-av" style="background:var(--primary);color:#000;display:flex;align-items:center;justify-content:center;font-size:0.5rem;font-weight:800;border-radius:50%;width:28px;height:28px;flex-shrink:0;">${avatarUrl ? '' : initials}</div>
        ${avatarUrl ? '' : ''}
        <div class="fp-who">
          <span class="fp-name">${displayName}</span>
          <span class="fp-when">${timeAgo(post.created_at)}</span>
        </div>
        <span class="fp-tag">${post.post_type}</span>
      </div>
      ${post.content ? `<p class="fp-txt">${post.content}</p>` : ''}
      ${mediaHtml}
      <div class="fp-acts">
        <button class="fp-a like-btn" data-count="${post.likes_count}">
          <span class="like-icon">♡</span>
          <span class="like-count">${post.likes_count}</span>
        </button>
        <button class="fp-a comment-toggle-btn" data-count="${post.comments_count}">
          <span>💬</span>
          <span class="comment-count">${post.comments_count}</span>
        </button>
        <button class="fp-a repost-btn" data-count="0">
          <span class="repost-icon">🔄</span>
          <span class="repost-count">0</span>
        </button>
        <button class="fp-a share-post-btn">
          <span>↗</span>
        </button>
      </div>
      <div class="comments-section hidden">
        <div class="comments-list"></div>
        <div class="comment-form">
          <input type="text" class="comment-input" placeholder="Escribe un comentario..." maxlength="500" />
          <button class="comment-send" disabled>→</button>
        </div>
      </div>
    `;

    return article;
  }

  async function loadMyPosts(profileId: string) {
    const list = document.getElementById('my-posts-list');
    const empty = document.getElementById('my-posts-empty');
    if (!list || !empty) return;

    const { data: posts, error } = await supabase
      .from('artist_posts')
      .select('*')
      .eq('artist_id', profileId)
      .order('created_at', { ascending: false });

    if (error || !posts || posts.length === 0) {
      empty.textContent = 'Aún no has publicado nada';
      return;
    }

    empty.classList.add('hidden');
    myPosts = posts;

    // Update post count in sidebar
    const postCountEl = document.getElementById('stat-posts');
    if (postCountEl) postCountEl.textContent = String(posts.length);

    posts.forEach(post => {
      list.appendChild(renderPost(post, currentProfile));
    });

    attachPostListeners(list);
  }

  async function loadLikedPosts() {
    const list = document.getElementById('liked-posts-list');
    const empty = document.getElementById('liked-posts-empty');
    if (!list || !empty) return;

    const { data: likedIds, error } = await supabase.rpc('get_user_artist_post_likes', { p_artist_id: currentUser.id });

    if (error || !likedIds || likedIds.length === 0) {
      empty.textContent = 'Aún no tienes likes';
      return;
    }

    empty.classList.add('hidden');

    const { data: posts } = await supabase
      .from('artist_posts')
      .select('*')
      .in('id', likedIds)
      .order('created_at', { ascending: false });

    if (!posts || posts.length === 0) {
      empty.textContent = 'Aún no tienes likes';
      empty.classList.remove('hidden');
      return;
    }

    // Fetch profiles for each post's artist
    const artistIds = [...new Set(posts.map(p => p.artist_id))];
    const { data: profiles } = await supabase
      .from('profiles')
      .select('id, nombre, avatar_url')
      .in('id', artistIds);

    const profileMap: Record<string, any> = {};
    (profiles || []).forEach(p => { profileMap[p.id] = p; });

    posts.forEach(post => {
      const p = profileMap[post.artist_id] || currentProfile;
      const article = renderPost(post, p);
      // Mark as liked
      const likeBtn = article.querySelector('.like-btn');
      if (likeBtn) {
        likeBtn.classList.add('liked');
        const icon = likeBtn.querySelector('.like-icon');
        if (icon) icon.textContent = '♥';
      }
      list.appendChild(article);
    });

    attachPostListeners(list);
  }

  async function loadRepostedPosts() {
    const list = document.getElementById('reposted-posts-list');
    const empty = document.getElementById('reposted-posts-empty');
    if (!list || !empty) return;

    const { data: reposts, error } = await supabase
      .from('artist_post_reposts')
      .select('post_id')
      .eq('user_id', currentUser.id);

    if (error || !reposts || reposts.length === 0) {
      empty.textContent = 'Aún no tienes reposts';
      return;
    }

    empty.classList.add('hidden');

    const repostedIds = reposts.map((r: any) => r.post_id);
    const { data: posts } = await supabase
      .from('artist_posts')
      .select('*')
      .in('id', repostedIds)
      .order('created_at', { ascending: false });

    if (!posts || posts.length === 0) {
      empty.textContent = 'Aún no tienes reposts';
      empty.classList.remove('hidden');
      return;
    }

    const artistIds = [...new Set(posts.map(p => p.artist_id))];
    const { data: profiles } = await supabase
      .from('profiles')
      .select('id, nombre, avatar_url')
      .in('id', artistIds);

    const profileMap: Record<string, any> = {};
    (profiles || []).forEach(p => { profileMap[p.id] = p; });

    posts.forEach(post => {
      const p = profileMap[post.artist_id] || currentProfile;
      const article = renderPost(post, p);
      // Mark as reposted
      const repostBtn = article.querySelector('.repost-btn');
      if (repostBtn) {
        repostBtn.classList.add('reposted');
      }
      list.appendChild(article);
    });

    attachPostListeners(list);
  }

  /* ── POST INTERACTIONS ── */
  function attachPostListeners(container: Element) {
    // Like
    container.querySelectorAll('.like-btn').forEach((btn: Element) => {
      btn.addEventListener('click', async () => {
        const article = (btn as HTMLElement).closest('.fp');
        const postId = article?.getAttribute('data-post-id');
        if (!postId) return;

        const { data, error } = await supabase.rpc('toggle_artist_post_like', { p_post_id: postId });
        if (error || !data) return;

        const icon = btn.querySelector('.like-icon');
        const count = btn.querySelector('.like-count');
        if (icon) icon.textContent = data.liked ? '♥' : '♡';
        if (count) count.textContent = data.count;
        btn.classList.toggle('liked', data.liked);
      });
    });

    // Repost
    container.querySelectorAll('.repost-btn').forEach((btn: Element) => {
      btn.addEventListener('click', async () => {
        const article = (btn as HTMLElement).closest('.fp');
        const postId = article?.getAttribute('data-post-id');
        if (!postId) return;

        const { data, error } = await supabase.rpc('toggle_artist_post_repost', { p_post_id: postId });
        if (error || !data) return;

        const count = btn.querySelector('.repost-count');
        if (count) count.textContent = data.count;
        btn.classList.toggle('reposted', data.reposted);
      });
    });

    // Comment toggle
    container.querySelectorAll('.comment-toggle-btn').forEach((btn: Element) => {
      btn.addEventListener('click', () => {
        const article = (btn as HTMLElement).closest('.fp');
        const section = article?.querySelector('.comments-section');
        section?.classList.toggle('hidden');
      });
    });

    // Comment send
    container.querySelectorAll('.comment-send').forEach((btn: Element) => {
      btn.addEventListener('click', async () => {
        const article = (btn as HTMLElement).closest('.fp');
        const postId = article?.getAttribute('data-post-id');
        const input = article?.querySelector('.comment-input') as HTMLInputElement;
        if (!postId || !input || !input.value.trim()) return;

        const content = input.value.trim();
        input.value = '';
        (btn as HTMLButtonElement).disabled = true;

        const { data, error } = await supabase.rpc('add_artist_post_comment', {
          p_post_id: postId,
          p_content: content
        });

        if (error || !data) return;

        const countEl = article?.querySelector('.comment-count');
        if (countEl) countEl.textContent = data.count;

        const list = article?.querySelector('.comments-list');
        if (list) {
          const div = document.createElement('div');
          div.className = 'comment-item';
          div.innerHTML = `
            <div class="comment-body">
              <span class="comment-author">Tú</span>
              <p class="comment-text">${content}</p>
              <span class="comment-time">ahora</span>
            </div>
          `;
          list.appendChild(div);
        }

        (btn as HTMLButtonElement).disabled = false;
      });
    });

    // Comment input - enable send
    container.querySelectorAll('.comment-input').forEach((input: Element) => {
      input.addEventListener('input', () => {
        const section = (input as HTMLElement).closest('.comments-section');
        const sendBtn = section?.querySelector('.comment-send') as HTMLButtonElement;
        if (sendBtn) {
          sendBtn.disabled = !(input as HTMLInputElement).value.trim();
        }
      });
    });

    // Share
    container.querySelectorAll('.share-post-btn').forEach((btn: Element) => {
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href);
        const span = (btn as HTMLElement).querySelector('span');
        if (span) span.textContent = '✓';
        setTimeout(() => { if (span) span.textContent = '↗'; }, 1500);
      });
    });
  }

  /* ── TABS ── */
  document.querySelectorAll('.feed-tab').forEach((tab: Element) => {
    tab.addEventListener('click', () => {
      document.querySelectorAll('.feed-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.feed-tab-content').forEach(c => c.classList.remove('active'));
      tab.classList.add('active');
      const tabName = (tab as HTMLElement).getAttribute('data-tab');
      const content = document.querySelector(`[data-tab-content="${tabName}"]`);
      if (content) content.classList.add('active');
    });
  });

  /* ── LOGOUT ── */
  document.getElementById('profile-logout-btn')?.addEventListener('click', async () => {
    await supabase.auth.signOut();
    window.location.href = '/';
  });

  /* ── AVATAR UPLOAD ── */
  const createAvatarInput = () => {
    const input = document.createElement('input');
    input.type = 'file';
    input.accept = 'image/*';
    input.style.display = 'none';
    input.id = 'avatar-upload-input';
    return input;
  };

  let avatarInput = document.getElementById('avatar-upload-input') as HTMLInputElement | null;
  if (!avatarInput) {
    avatarInput = createAvatarInput();
    document.body.appendChild(avatarInput);
  }

  document.getElementById('avatar-edit-btn')?.addEventListener('click', () => {
    avatarInput?.click();
  });

  avatarInput.addEventListener('change', async () => {
    const file = avatarInput?.files?.[0];
    if (!file) return;

    const formData = new FormData();
    formData.append('avatar', file);

    try {
      const res = await fetch('/api/upload-avatar', {
        method: 'POST',
        body: formData,
      });
      const result = await res.json();

      if (res.ok && result.avatar_url) {
        if (currentProfile) currentProfile.avatar_url = result.avatar_url;

        const img = document.getElementById('profile-avatar-img');
        if (img instanceof HTMLImageElement) {
          img.src = result.avatar_url;
          img.classList.remove('hidden');
          const placeholder = document.getElementById('avatar-placeholder');
          if (placeholder) placeholder.classList.add('hidden');
        }
      } else {
        console.error('Avatar upload failed:', result.error);
      }
    } catch (err) {
      console.error('Avatar upload error:', err);
    }

    avatarInput!.value = '';
  });

  /* ── ARTIST COMPOSER ── */
  // Post type toggle
  document.querySelectorAll('.dash-type-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.dash-type-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
    });
  });

  // File button - open file picker
  document.getElementById('composer-file-btn')?.addEventListener('click', () => {
    document.getElementById('composer-file')?.click();
  });

  // When file selected: show preview dialog
  const pendingUpload = { file: null as File | null, resolve: null as ((confirm: boolean) => void) | null };

  document.getElementById('composer-file')?.addEventListener('change', (e: any) => {
    const file = e.target?.files?.[0];
    if (!file) return;
    pendingUpload.file = file;
    const img = document.getElementById('img-preview-img') as HTMLImageElement;
    if (img) {
      img.src = URL.createObjectURL(file);
      const dialog = document.getElementById('img-preview-dialog') as HTMLDialogElement;
      if (dialog) dialog.showModal();
    }
  });

  // Dialog confirm
  document.getElementById('img-dialog-confirm')?.addEventListener('click', () => {
    (document.getElementById('img-preview-dialog') as HTMLDialogElement)?.close();
    // Show preview inline
    const preview = document.getElementById('composer-preview');
    if (preview && pendingUpload.file) {
      preview.innerHTML = `<img src="${URL.createObjectURL(pendingUpload.file)}" style="max-height:120px;border-radius:6px;" />`;
      preview.classList.remove('hidden');
    }
  });

  // Dialog cancel
  const cancelPreview = () => {
    (document.getElementById('img-preview-dialog') as HTMLDialogElement)?.close();
    pendingUpload.file = null;
    (document.getElementById('composer-file') as HTMLInputElement).value = '';
    document.getElementById('composer-preview')?.classList.add('hidden');
  };
  document.getElementById('img-dialog-cancel')?.addEventListener('click', cancelPreview);
  document.getElementById('img-dialog-cancel-btn')?.addEventListener('click', cancelPreview);

  // Submit post
  document.getElementById('composer-submit')?.addEventListener('click', async () => {
    const text = (document.getElementById('composer-text') as HTMLTextAreaElement)?.value?.trim();
    if (!text) return;
    const msg = document.getElementById('composer-msg');
    const activeType = document.querySelector('.dash-type-btn.active')?.getAttribute('data-type') || 'text';
    const file = pendingUpload.file;
    const submitBtn = document.getElementById('composer-submit') as HTMLButtonElement;
    if (submitBtn) submitBtn.disabled = true;
    if (msg) { msg.textContent = 'Publicando...'; msg.style.color = 'var(--text-muted)'; }

    try {
      let imageUrl: string | null = null;
      if (file) {
        const ext = file.name.split('.').pop() || 'png';
        const { data: { session } } = await supabase.auth.getSession();
        const path = `${session?.user?.id}/${Date.now()}.${ext}`;
        const { error: uploadErr } = await supabase.storage
          .from('artist_posts')
          .upload(path, file, { upsert: true });
        if (!uploadErr) {
          const { data: { publicUrl } } = supabase.storage
            .from('artist_posts')
            .getPublicUrl(path);
          imageUrl = publicUrl;
        }
      }

      await supabase.from('artist_posts').insert({
        artist_id: currentUser.id,
        content: text,
        post_type: activeType,
        image_url: imageUrl,
        likes_count: 0,
        comments_count: 0,
        is_pinned: false
      });

      if (msg) { msg.textContent = '✅ Publicado. Pendiente de aprobación'; msg.style.color = 'var(--success)'; }
      (document.getElementById('composer-text') as HTMLTextAreaElement)!.value = '';
      const preview = document.getElementById('composer-preview');
      if (preview) { preview.innerHTML = ''; preview.classList.add('hidden'); }
      pendingUpload.file = null;
      (document.getElementById('composer-file') as HTMLInputElement).value = '';
      // Auto-hide message
      setTimeout(() => { if (msg) msg.textContent = ''; }, 3500);
    } catch (e: any) {
      if (msg) { msg.textContent = '✗ Error: ' + (e.message || e); msg.style.color = 'var(--danger)'; }
    }
    if (submitBtn) submitBtn.disabled = false;
  });

  // Delete post
  document.addEventListener('click', async (e) => {
    const target = e.target as HTMLElement;
    if (target.classList.contains('delete-post-btn')) {
      const postId = target.getAttribute('data-id');
      if (!postId || !confirm('¿Eliminar esta publicación?')) return;
      await supabase.from('artist_posts').delete().eq('id', postId);
      target.closest('.feed-item')?.remove();
    }
  });

  // Dashboard navigation (feed, likes, reposts)
  document.querySelectorAll('.dash-nav-item').forEach(item => {
    item.addEventListener('click', async (e) => {
      e.preventDefault();
      const nav = item.getAttribute('data-nav');
      if (!nav) return;
      document.getElementById('artist-dashboard')?.classList.add('hidden');
      document.getElementById('view-container')?.classList.remove('hidden');
      const vc = document.getElementById('view-content');
      if (!vc) return;

      if (nav === 'feed') {
        const posts = await loadArtistPosts(currentUser?.id);
        vc.innerHTML = posts?.length
          ? posts.map(p => `
            <div class="feed-item" data-post-id="${p.id}">
              <p>${p.content || ''}</p>
              ${p.image_url ? `<img src="${p.image_url}" style="max-height:200px;border-radius:8px;margin-top:8px;" />` : ''}
              <div style="display:flex;gap:12px;margin-top:6px;font-size:11px;">
                <span>❤️ ${p.likes_count || 0}</span>
                <span>💬 ${p.comments_count || 0}</span>
                <span style="color:var(--text-muted)">${p.post_type}</span>
                <button class="delete-post-btn" data-id="${p.id}" style="margin-left:auto;background:none;border:none;color:var(--danger);cursor:pointer;">🗑️</button>
              </div>
            </div>
          `).join('') : '<p style="color:var(--text-muted);text-align:center;padding:40px;">No tienes publicaciones aún.</p>';
      } else {
        vc.innerHTML = '<p style="color:var(--text-muted);text-align:center;padding:40px;">Próximamente.</p>';
      }
    });
  });

  document.getElementById('view-back')?.addEventListener('click', () => {
    document.getElementById('view-container')?.classList.add('hidden');
    document.getElementById('artist-dashboard')?.classList.remove('hidden');
  });

  // Save profile
  document.getElementById('edit-save')?.addEventListener('click', async () => {
    const nombre = (document.getElementById('edit-name') as HTMLInputElement)?.value?.trim();
    const bio = (document.getElementById('edit-bio') as HTMLInputElement)?.value?.trim();
    if (!nombre) return;
    await supabase.from('profiles').upsert({ id: currentUser.id, nombre, bio }, { onConflict: 'id' });
    const m = document.getElementById('edit-msg');
    if (m) m.textContent = '✅ Guardado';
    const nEl = document.getElementById('profile-name');
    if (nEl) nEl.textContent = nombre;
  });

  // Save social links
  document.getElementById('edit-social-save')?.addEventListener('click', async () => {
    const get = (id: string) => (document.getElementById(id) as HTMLInputElement)?.value?.trim() || null;
    await supabase.from('profiles').upsert({
      id: currentUser.id,
      instagram_url: get('edit-instagram'),
      spotify_url: get('edit-spotify'),
      youtube_url: get('edit-youtube')
    }, { onConflict: 'id' });
    const m = document.getElementById('edit-social-msg');
    if (m) m.textContent = '✅ Redes guardadas';
  });
  const run = () => { initProfile().catch(e => console.error('Profile init error:', e)); };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', run);
  } else {
    run();
  }
  document.addEventListener('astro:after-swap', run);
</script>
