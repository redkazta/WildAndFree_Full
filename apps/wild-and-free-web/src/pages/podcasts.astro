---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Podcasts",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};

const podcasts = [
  { 
    id: 1, 
    title: "El Origen del Flow", 
    host: "MC Nova", 
    description: "Hablamos de cómo inició todo en las calles de Torreón.", 
    duration: "45:00", 
    date: "12 OCT", 
    image: "https://images.unsplash.com/photo-1478737270239-2f02b77ac6d5?w=500&q=80",
    tags: ["Entrevista", "Historia"]
  },
  { 
    id: 2, 
    title: "Producción Musical 101", 
    host: "DJ Beatmaker", 
    description: "Tips esenciales para empezar a producir tus propios beats.", 
    duration: "32:15", 
    date: "10 OCT", 
    image: "https://images.unsplash.com/photo-1598488035139-bdbb2231ce04?w=500&q=80",
    tags: ["Tutorial", "Producción"]
  },
  { 
    id: 3, 
    title: "La Escena Underground", 
    host: "La Jefa", 
    description: "Analizamos el estado actual del rap underground en México.", 
    duration: "58:30", 
    date: "05 OCT", 
    image: "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?w=500&q=80",
    tags: ["Debate", "Escena"]
  },
  { 
    id: 4, 
    title: "Freestyle vs Escrito", 
    host: "Aczino (Invitado)", 
    description: "Diferencias, ventajas y desventajas de cada disciplina.", 
    duration: "1:12:00", 
    date: "01 OCT", 
    image: "https://images.unsplash.com/photo-1514525253361-bee871871771?w=500&q=80",
    tags: ["Freestyle", "Técnica"]
  }
];
---

<Layout config={config}>
  <div class="min-h-screen bg-[#050505] text-white font-mono selection:bg-[var(--wild-orange)] selection:text-black pb-20 relative overflow-hidden">
    
    <!-- Background Noise/Texture -->
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')] opacity-20 pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black via-black/90 to-[var(--secondary)]/20 pointer-events-none"></div>

    <div class="container mx-auto px-4 pt-24 relative z-10">
      
      <!-- HEADER -->
      <div class="flex flex-col md:flex-row justify-between items-end border-b-2 border-white/10 pb-6 mb-12 gap-6">
        <div>
          <h1 class="text-5xl md:text-8xl font-black italic uppercase tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-500">
            WILD <span class="text-[var(--primary)]">TALKS</span>
          </h1>
          <p class="text-xs md:text-sm font-bold text-gray-400 uppercase tracking-[0.4em] mt-2">
            VOCES DEL MOVIMIENTO // PODCAST SERIES
          </p>
        </div>
        
        <div class="flex gap-2">
            <button class="px-4 py-2 bg-[var(--primary)] text-black font-black uppercase tracking-widest text-xs hover:bg-white transition-colors">
                Todos
            </button>
            <button class="px-4 py-2 bg-white/5 text-white font-black uppercase tracking-widest text-xs hover:bg-white/20 transition-colors">
                Entrevistas
            </button>
            <button class="px-4 py-2 bg-white/5 text-white font-black uppercase tracking-widest text-xs hover:bg-white/20 transition-colors">
                Tutoriales
            </button>
        </div>
      </div>

      <!-- FEATURED EPISODE (HERO) -->
      <div class="mb-16 relative group cursor-pointer">
        <div class="absolute inset-0 bg-gradient-to-r from-[var(--primary)] to-[var(--secondary)] opacity-0 group-hover:opacity-20 blur-3xl transition-opacity duration-700"></div>
        <div class="relative bg-[#111] border border-white/10 rounded-3xl overflow-hidden flex flex-col md:flex-row h-auto md:h-[400px]">
            <div class="w-full md:w-1/2 relative h-[300px] md:h-auto overflow-hidden">
                <img src={podcasts[0].image} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
                <div class="absolute inset-0 bg-gradient-to-t from-[#111] to-transparent md:bg-gradient-to-r"></div>
                <div class="absolute top-4 left-4">
                    <span class="px-3 py-1 bg-[var(--primary)] text-black text-[10px] font-black uppercase tracking-widest">Nuevo Episodio</span>
                </div>
            </div>
            <div class="w-full md:w-1/2 p-8 md:p-12 flex flex-col justify-center items-start gap-4">
                <div class="flex items-center gap-2 text-gray-500 text-xs font-mono">
                    <span>{podcasts[0].date}</span>
                    <span>•</span>
                    <span>{podcasts[0].duration}</span>
                </div>
                <h2 class="text-3xl md:text-5xl font-black uppercase leading-none group-hover:text-[var(--primary)] transition-colors">
                    {podcasts[0].title}
                </h2>
                <p class="text-gray-400 font-medium max-w-md">
                    {podcasts[0].description}
                </p>
                <div class="mt-4 flex items-center gap-4">
                    <button class="w-12 h-12 bg-white text-black rounded-full flex items-center justify-center hover:scale-110 transition-transform">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    </button>
                    <span class="text-xs font-black uppercase tracking-widest">Escuchar Ahora</span>
                </div>
            </div>
        </div>
      </div>

      <!-- EPISODES GRID -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {podcasts.slice(1).map((pod) => (
            <div class="group bg-[#111] border border-white/10 rounded-2xl overflow-hidden hover:border-[var(--primary)]/50 transition-colors">
                <div class="relative aspect-video overflow-hidden">
                    <img src={pod.image} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" />
                    <div class="absolute inset-0 bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                        <button class="w-12 h-12 bg-[var(--primary)] text-black rounded-full flex items-center justify-center transform scale-0 group-hover:scale-100 transition-transform duration-300">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                        </button>
                    </div>
                </div>
                <div class="p-6">
                    <div class="flex justify-between items-start mb-4">
                        <div class="flex gap-2">
                            {pod.tags.map(tag => (
                                <span class="text-[9px] font-black uppercase tracking-widest px-2 py-1 bg-white/5 text-gray-400 rounded">{tag}</span>
                            ))}
                        </div>
                        <span class="text-[10px] font-mono text-gray-500">{pod.duration}</span>
                    </div>
                    <h3 class="text-xl font-black uppercase leading-tight mb-2 group-hover:text-[var(--primary)] transition-colors">
                        {pod.title}
                    </h3>
                    <p class="text-sm text-gray-500 mb-4 line-clamp-2">
                        {pod.description}
                    </p>
                    <div class="flex items-center gap-2 pt-4 border-t border-white/5">
                        <div class="w-6 h-6 rounded-full bg-gray-800"></div>
                        <span class="text-xs font-bold text-gray-400 uppercase">{pod.host}</span>
                    </div>
                </div>
            </div>
        ))}
      </div>

    </div>
  </div>
</Layout>