---
import Layout from '../layouts/Layout.astro';

const products = [
  {
    id: 1,
    name: 'Wild Gvng Hoodie',
    price: '¥8,500',
    image: 'https://images.unsplash.com/photo-1556821840-3a63f95609a7?w=400&h=400&fit=crop',
    category: 'Ropa',
    description: 'Hoodie oficial de Wild Gvng con diseño exclusivo',
    sizes: ['S', 'M', 'L', 'XL'],
    inStock: true
  },
  {
    id: 2,
    name: 'Neon Cap',
    price: '¥3,200',
    image: 'https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=400&h=400&fit=crop',
    category: 'Accesorios',
    description: 'Gorra con logo neón de Wild Gvng',
    inStock: true
  },
  {
    id: 3,
    name: 'Tokyo Nights T-Shirt',
    price: '¥4,800',
    image: 'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=400&h=400&fit=crop',
    category: 'Ropa',
    description: 'Camiseta con diseño exclusivo Tokyo Nights',
    sizes: ['S', 'M', 'L', 'XL', 'XXL'],
    inStock: true
  },
  {
    id: 4,
    name: 'Vinyl Collection',
    price: '¥12,000',
    image: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=400&h=400&fit=crop',
    category: 'Música',
    description: 'Colección de vinilos de los artistas de Wild Gvng',
    inStock: false
  },
  {
    id: 5,
    name: 'Street Backpack',
    price: '¥6,500',
    image: 'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=400&h=400&fit=crop',
    category: 'Accesorios',
    description: 'Mochila urbana con detalles reflectantes',
    inStock: true
  },
  {
    id: 6,
    name: 'Neon Poster Set',
    price: '¥2,800',
    image: 'https://images.unsplash.com/photo-1578662996442-48f60103fc96?w=400&h=400&fit=crop',
    category: 'Arte',
    description: 'Set de 3 posters con arte neón de Wild Gvng',
    inStock: true
  }
];

const categories = ['Todos', 'Ropa', 'Accesorios', 'Música', 'Arte'];
---

<Layout config={{
  name: "Wild Gvng - Tienda",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>
  <main class="shop-page">
    <div class="page-header">
      <div class="container">
        <h1 class="page-title">
          <span class="title-line">TIENDA</span>
          <span class="title-line">WILD</span>
        </h1>
        <p class="page-subtitle">Ropa y accesorios exclusivos de la crew</p>
      </div>
    </div>

    <div class="container">
      <!-- Category Filter -->
      <div class="category-filter">
        {categories.map((category) => (
          <button class={`filter-btn ${category === 'Todos' ? 'active' : ''}`} data-category={category}>
            {category}
          </button>
        ))}
      </div>

      <!-- Products Grid -->
      <div class="products-grid">
        {products.map((product) => (
          <div class="product-card" data-category={product.category}>
            <div class="product-image">
              <img src={product.image} alt={product.name} />
              {!product.inStock && (
                <div class="out-of-stock-badge">
                  <span>Agotado</span>
                </div>
              )}
              <div class="product-overlay">
                <button class="quick-view-btn" data-product={JSON.stringify(product)}>
                  <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M16 8s-3-5.5-8-5.5S0 8 0 8s3 5.5 8 5.5S16 8 16 8zM1.173 8a13.133 13.133 0 0 1 1.66-2.043C4.12 4.668 5.88 3.5 8 3.5c2.12 0 3.879 1.168 5.168 2.457A13.133 13.133 0 0 1 14.828 8c-.058.087-.122.183-.195.288-.335.48-.83 1.12-1.465 1.755C11.879 11.332 10.119 12.5 8 12.5c-2.12 0-3.879-1.168-5.168-2.457A13.134 13.134 0 0 1 1.172 8z"/>
                    <path d="M8 5.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5zM4.5 8a3.5 3.5 0 1 1 7 0 3.5 3.5 0 0 1-7 0z"/>
                  </svg>
                  Vista Rápida
                </button>
              </div>
            </div>
            <div class="product-info">
              <div class="product-category">{product.category}</div>
              <h3 class="product-name">{product.name}</h3>
              <p class="product-description">{product.description}</p>
              <div class="product-price">{product.price}</div>
              <div class="product-actions">
                <button class={`add-to-cart ${!product.inStock ? 'disabled' : ''}`} 
                        data-product={JSON.stringify(product)}
                        disabled={!product.inStock}>
                  {product.inStock ? 'Añadir al Carrito' : 'Agotado'}
                </button>
                <button class="add-to-wishlist" data-product={JSON.stringify(product)}>
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314Z"/>
                  </svg>
                </button>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Quick View Modal -->
    <div class="quick-view-modal" id="quick-view-modal">
      <div class="modal-overlay" id="modal-overlay"></div>
      <div class="modal-content">
        <button class="modal-close" id="modal-close">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
            <path d="M18 6L6 18M6 6l12 12"/>
          </svg>
        </button>
        <div class="modal-body">
          <div class="product-image-large">
            <img id="modal-product-image" src="" alt="" />
          </div>
          <div class="product-details">
            <div class="product-category" id="modal-product-category"></div>
            <h2 class="product-name" id="modal-product-name"></h2>
            <p class="product-description" id="modal-product-description"></p>
            <div class="product-price" id="modal-product-price"></div>
            <div class="product-options" id="modal-product-options">
              <div class="size-selector">
                <label>Talla:</label>
                <div class="size-options" id="size-options"></div>
              </div>
            </div>
            <div class="product-actions">
              <button class="add-to-cart primary" id="modal-add-to-cart">
                Añadir al Carrito
              </button>
              <button class="add-to-wishlist" id="modal-add-to-wishlist">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314Z"/>
                </svg>
                Añadir a Wishlist
              </button>
            </div>
            <div class="product-meta">
              <div class="meta-item">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zM2.04 4.326c.325 1.329 2.532 2.54 3.717 3.19.48.263.793.434.743.484-.08.08-.162.158-.242.234-.416.396-.787.749-.758 1.266.035.634.618.934 1.216 1.217.493.258 1.05.5 1.652.554.693.062 1.368-.147 1.767-.596.16-.191.285-.424.362-.659.078-.236.108-.5.108-.773 0-.707-.277-1.176-.498-1.474-.218-.29-.443-.5-.63-.692-.18-.19-.33-.34-.394-.42-.04-.05-.062-.08-.072-.09l-.014-.015c.675-1.423 1.93-2.94 2.904-3.536C12.33 3.223 12.78 3 13.5 3c.5 0 1 .5 1 1 0 .222-.075.43-.206.595-.137.17-.328.34-.552.552-.224.213-.5.474-.79.764-.29.29-.55.566-.764.79-.224.224-.382.415-.552.552-.166.132-.373.206-.595.206-.722 0-1.172-.277-1.652-.552-.425-.247-.93-.56-1.474-.877C9.06 4.43 8.3 4.09 8 4.09c-.3 0-1.06.34-1.474.603-.544.317-1.05.63-1.475.877-.48.275-.93.552-1.652.552z"/>
                </svg>
                <span>Envío gratis a partir de ¥10,000</span>
              </div>
              <div class="meta-item">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                  <path d="M8 0a8 8 0 1 0 0 16A8 8 0 0 0 8 0zM2.04 4.326c.325 1.329 2.532 2.54 3.717 3.19.48.263.793.434.743.484-.08.08-.162.158-.242.234-.416.396-.787.749-.758 1.266.035.634.618.934 1.216 1.217.493.258 1.05.5 1.652.554.693.062 1.368-.147 1.767-.596.16-.191.285-.424.362-.659.078-.236.108-.5.108-.773 0-.707-.277-1.176-.498-1.474-.218-.29-.443-.5-.63-.692-.18-.19-.33-.34-.394-.42-.04-.05-.062-.08-.072-.09l-.014-.015c.675-1.423 1.93-2.94 2.904-3.536C12.33 3.223 12.78 3 13.5 3c.5 0 1 .5 1 1 0 .222-.075.43-.206.595-.137.17-.328.34-.552.552-.224.213-.5.474-.79.764-.29.29-.55.566-.764.79-.224.224-.382.415-.552.552-.166.132-.373.206-.595.206-.722 0-1.172-.277-1.652-.552-.425-.247-.93-.56-1.474-.877C9.06 4.43 8.3 4.09 8 4.09c-.3 0-1.06.34-1.474.603-.544.317-1.05.63-1.475.877-.48.275-.93.552-1.652.552z"/>
                </svg>
                <span>Devoluciones gratuitas en 30 días</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Floating Cart Notification -->
    <div class="cart-notification" id="cart-notification">
      <div class="notification-content">
        <svg width="20" height="20" viewBox="0 0 16 16" fill="currentColor">
          <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .49.598l-1 5a.5.5 0 0 1-.465.401l-9.397.472L4.415 11H13a.5.5 0 0 1 0 1H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM3.102 4l.84 4.479 9.144-.459L13.89 4H3.102zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
        </svg>
        <span id="notification-text">Producto añadido al carrito</span>
      </div>
    </div>
  </main>
</Layout>

<style>
  .shop-page {
    min-height: 100vh;
    padding-top: 80px;
  }

  .page-header {
    background: linear-gradient(135deg, #000 0%, #111 100%);
    padding: 120px 0 80px;
    text-align: center;
    border-bottom: 1px solid rgba(201, 131, 0, 0.3);
  }

  .page-title {
    font-size: clamp(60px, 10vw, 120px);
    font-weight: 900;
    margin: 0 0 24px;
    line-height: 0.8;
    letter-spacing: 0.05em;
    font-family: 'Noto Sans JP', sans-serif;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .title-line {
    display: block;
    color: transparent;
    -webkit-text-stroke: 2px rgba(255, 255, 255, 0.9);
  }

  .page-subtitle {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    font-weight: 300;
    letter-spacing: 0.05em;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .category-filter {
    display: flex;
    justify-content: center;
    gap: 16px;
    padding: 40px 0;
    flex-wrap: wrap;
  }

  .filter-btn {
    background: transparent;
    border: 1px solid rgba(201, 131, 0, 0.3);
    color: #fff;
    padding: 12px 24px;
    border-radius: 25px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 14px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .filter-btn:hover,
  .filter-btn.active {
    background: var(--primary-color);
    color: #000;
    border-color: var(--primary-color);
    transform: translateY(-2px);
  }

  .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 32px;
    padding: 40px 0;
  }

  .product-card {
    background: linear-gradient(135deg, #111 0%, #000 100%);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    border: 1px solid rgba(201, 131, 0, 0.1);
  }

  .product-card:hover {
    transform: translateY(-8px);
    border-color: rgba(201, 131, 0, 0.3);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
  }

  .product-image {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .product-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .product-card:hover .product-image img {
    transform: scale(1.1);
  }

  .out-of-stock-badge {
    position: absolute;
    top: 16px;
    left: 16px;
    background: rgba(239, 68, 68, 0.9);
    color: #fff;
    padding: 8px 12px;
    border-radius: 4px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .product-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(201, 131, 0, 0.8) 0%, rgba(138, 3, 3, 0.8) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .product-card:hover .product-overlay {
    opacity: 1;
  }

  .quick-view-btn {
    background: rgba(255, 255, 255, 0.9);
    border: none;
    border-radius: 25px;
    padding: 12px 24px;
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
    transition: all 0.3s ease;
    color: #000;
    font-size: 14px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .quick-view-btn:hover {
    background: #fff;
    transform: scale(1.05);
  }

  .product-info {
    padding: 24px;
  }

  .product-category {
    color: var(--primary-color);
    font-size: 12px;
    margin: 0 0 8px;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-weight: 500;
  }

  .product-name {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 8px;
    color: #fff;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .product-description {
    color: rgba(255, 255, 255, 0.7);
    font-size: 14px;
    line-height: 1.5;
    margin: 0 0 16px;
  }

  .product-price {
    font-size: 24px;
    font-weight: 700;
    color: #fff;
    margin: 0 0 16px;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .product-actions {
    display: flex;
    gap: 12px;
  }

  .add-to-cart {
    flex: 1;
    padding: 12px 16px;
    border: none;
    border-radius: 4px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .add-to-cart:not(.disabled) {
    background: var(--primary-color);
    color: #000;
  }

  .add-to-cart:not(.disabled):hover {
    background: #fff;
    transform: translateY(-2px);
  }

  .add-to-cart.disabled {
    background: rgba(255, 255, 255, 0.1);
    color: rgba(255, 255, 255, 0.5);
    cursor: not-allowed;
  }

  .add-to-wishlist {
    background: transparent;
    border: 1px solid rgba(201, 131, 0, 0.3);
    color: #fff;
    padding: 12px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .add-to-wishlist:hover {
    color: var(--primary-color);
    border-color: var(--primary-color);
    background: rgba(201, 131, 0, 0.1);
  }

  /* Quick View Modal */
  .quick-view-modal {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2000;
    display: none;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }

  .quick-view-modal.active {
    display: flex;
  }

  .modal-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.8);
    backdrop-filter: blur(10px);
  }

  .modal-content {
    background: linear-gradient(135deg, #111 0%, #000 100%);
    border-radius: 12px;
    border: 1px solid rgba(201, 131, 0, 0.3);
    max-width: 900px;
    width: 100%;
    max-height: 90vh;
    overflow-y: auto;
    position: relative;
    z-index: 1;
  }

  .modal-close {
    position: absolute;
    top: 16px;
    right: 16px;
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    padding: 8px;
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  .modal-close:hover {
    color: var(--primary-color);
    background: rgba(201, 131, 0, 0.1);
  }

  .modal-body {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
    padding: 40px;
  }

  .product-image-large {
    aspect-ratio: 1;
    border-radius: 8px;
    overflow: hidden;
  }

  .product-image-large img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .product-details {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .size-selector label {
    display: block;
    margin: 0 0 12px;
    color: #fff;
    font-size: 14px;
    font-weight: 600;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .size-options {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }

  .size-option {
    background: transparent;
    border: 1px solid rgba(201, 131, 0, 0.3);
    color: #fff;
    padding: 8px 16px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.3s ease;
    font-size: 14px;
    font-weight: 500;
  }

  .size-option:hover,
  .size-option.selected {
    background: var(--primary-color);
    color: #000;
    border-color: var(--primary-color);
  }

  .product-actions {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .add-to-cart.primary {
    background: var(--primary-color);
    color: #000;
    padding: 16px;
    border: none;
    border-radius: 4px;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.3s ease;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .add-to-cart.primary:hover {
    background: #fff;
    transform: translateY(-2px);
  }

  .add-to-wishlist {
    background: transparent;
    border: 1px solid rgba(201, 131, 0, 0.3);
    color: #fff;
    padding: 12px 16px;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 500;
  }

  .add-to-wishlist:hover {
    color: var(--primary-color);
    border-color: var(--primary-color);
    background: rgba(201, 131, 0, 0.1);
  }

  .product-meta {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding-top: 20px;
    border-top: 1px solid rgba(201, 131, 0, 0.1);
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 8px;
    color: rgba(255, 255, 255, 0.7);
    font-size: 12px;
  }

  .meta-item svg {
    color: var(--primary-color);
    opacity: 0.8;
  }

  /* Cart Notification */
  .cart-notification {
    position: fixed;
    top: 100px;
    right: -300px;
    background: linear-gradient(135deg, #000 0%, #111 100%);
    border: 1px solid rgba(201, 131, 0, 0.3);
    border-radius: 8px;
    padding: 16px;
    z-index: 1500;
    transition: right 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    max-width: 300px;
  }

  .cart-notification.show {
    right: 24px;
  }

  .notification-content {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #fff;
    font-size: 14px;
  }

  .notification-content svg {
    color: var(--primary-color);
    flex-shrink: 0;
  }

  @media (max-width: 768px) {
    .modal-body {
      grid-template-columns: 1fr;
      gap: 24px;
      padding: 24px;
    }

    .products-grid {
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 24px;
      padding: 24px 0;
    }

    .category-filter {
      gap: 12px;
    }

    .filter-btn {
      padding: 8px 16px;
      font-size: 12px;
    }

    .page-header {
      padding: 80px 0 60px;
    }
  }
</style>

<script>
  // Shop functionality
  document.addEventListener('DOMContentLoaded', () => {
    const modal = document.getElementById('quick-view-modal');
    const overlay = document.getElementById('modal-overlay');
    const closeBtn = document.getElementById('modal-close');
    const quickViewBtns = document.querySelectorAll('.quick-view-btn');
    const addToCartBtns = document.querySelectorAll('.add-to-cart:not(.disabled)');
    const addToWishlistBtns = document.querySelectorAll('.add-to-wishlist');
    const filterBtns = document.querySelectorAll('.filter-btn');
    const cartNotification = document.getElementById('cart-notification');
    
    let selectedSize = null;
    let currentProduct = null;

    // Filter functionality
    filterBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const category = btn.dataset.category;
        
        // Update active button
        filterBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        
        // Filter products
        const products = document.querySelectorAll('.product-card');
        products.forEach(product => {
          if (category === 'Todos' || product.dataset.category === category) {
            product.style.display = 'block';
          } else {
            product.style.display = 'none';
          }
        });
      });
    });

    // Quick view functionality
    quickViewBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const product = JSON.parse(btn.dataset.product);
        showQuickView(product);
      });
    });

    function showQuickView(product) {
      currentProduct = product;
      
      // Update modal content
      document.getElementById('modal-product-image').src = product.image;
      document.getElementById('modal-product-name').textContent = product.name;
      document.getElementById('modal-product-category').textContent = product.category;
      document.getElementById('modal-product-description').textContent = product.description;
      document.getElementById('modal-product-price').textContent = product.price;
      
      // Handle size options
      const sizeOptions = document.getElementById('size-options');
      if (product.sizes) {
        sizeOptions.innerHTML = product.sizes.map(size => 
          `<button class="size-option" data-size="${size}">${size}</button>`
        ).join('');
        
        // Add size selection functionality
        document.querySelectorAll('.size-option').forEach(option => {
          option.addEventListener('click', () => {
            document.querySelectorAll('.size-option').forEach(o => o.classList.remove('selected'));
            option.classList.add('selected');
            selectedSize = option.dataset.size;
          });
        });
        
        document.getElementById('modal-product-options').style.display = 'block';
      } else {
        document.getElementById('modal-product-options').style.display = 'none';
      }
      
      // Update button states
      const addToCartBtn = document.getElementById('modal-add-to-cart');
      if (product.inStock) {
        addToCartBtn.disabled = false;
        addToCartBtn.textContent = 'Añadir al Carrito';
      } else {
        addToCartBtn.disabled = true;
        addToCartBtn.textContent = 'Agotado';
      }
      
      modal.classList.add('active');
      document.body.style.overflow = 'hidden';
    }

    function closeModal() {
      modal.classList.remove('active');
      document.body.style.overflow = '';
      selectedSize = null;
    }

    // Close modal functionality
    [closeBtn, overlay].forEach(element => {
      element.addEventListener('click', closeModal);
    });

    // Add to cart functionality
    [...addToCartBtns, document.getElementById('modal-add-to-cart')].forEach(btn => {
      btn.addEventListener('click', () => {
        const product = btn.dataset.product ? JSON.parse(btn.dataset.product) : currentProduct;
        
        if (product.sizes && !selectedSize && btn.id === 'modal-add-to-cart') {
          alert('Por favor selecciona una talla');
          return;
        }
        
        if (product.inStock) {
          showCartNotification(`${product.name} añadido al carrito`);
          if (btn.id === 'modal-add-to-cart') {
            closeModal();
          }
        }
      });
    });

    // Add to wishlist functionality
    addToWishlistBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const product = btn.dataset.product ? JSON.parse(btn.dataset.product) : currentProduct;
        showCartNotification(`${product.name} añadido a wishlist`);
        
        // Change button state
        btn.innerHTML = `
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <path d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314Z"/>
          </svg>
        `;
        btn.style.color = 'var(--primary-color)';
        btn.style.borderColor = 'var(--primary-color)';
      });
    });

    // Cart notification
    function showCartNotification(message) {
      const notification = cartNotification;
      document.getElementById('notification-text').textContent = message;
      notification.classList.add('show');
      
      setTimeout(() => {
        notification.classList.remove('show');
      }, 3000);
    }

    // Keyboard support
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal.classList.contains('active')) {
        closeModal();
      }
    });
  });
</script>