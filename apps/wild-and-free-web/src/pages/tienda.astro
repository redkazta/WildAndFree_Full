---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Tienda Oficial",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};

const categories = [
  { id: 'all', name: 'Todo' },
  { id: 'clothing', name: 'Ropa Urbana' },
  { id: 'accessories', name: 'Accesorios' },
  { id: 'music', name: 'Música (Vinilos/CDs)' },
  { id: 'art', name: 'Arte y Pósters' },
  { id: 'tech', name: 'Equipo de Audio' }
];

const carouselOffers = [
  {
    id: 101,
    title: "COLECCIÓN DE VERANO",
    subtitle: "HASTA 30% DE DESCUENTO",
    image: "https://images.unsplash.com/photo-1523398002811-999ca8dec234?w=800&h=400&fit=crop",
    cta: "VER OFERTAS"
  },
  {
    id: 102,
    title: "NUEVOS LANZAMIENTOS",
    subtitle: "EDICIÓN LIMITADA VINILO",
    image: "https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?w=800&h=400&fit=crop",
    cta: "COMPRAR AHORA"
  }
];

const products = [
  {
    id: 1,
    name: 'Sudadera Wild Gvng Oversize',
    price: 1200,
    originalPrice: 1500,
    rating: 4.8,
    reviews: 124,
    image: 'https://images.unsplash.com/photo-1556821840-3a63f95609a7?w=500&h=500&fit=crop',
    category: 'Ropa Urbana',
    inStock: true,
    isNew: false,
    isBestSeller: true
  },
  {
    id: 2,
    name: 'Gorra Neon Táctica',
    price: 450,
    rating: 4.5,
    reviews: 89,
    image: 'https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=500&h=500&fit=crop',
    category: 'Accesorios',
    inStock: true,
    isNew: true
  },
  {
    id: 3,
    name: 'Camiseta Tokyo Nights',
    price: 600,
    rating: 4.9,
    reviews: 210,
    image: 'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=500&h=500&fit=crop',
    category: 'Ropa Urbana',
    inStock: true
  },
  {
    id: 4,
    name: 'Box Set Vinilos 2024',
    price: 2500,
    rating: 5.0,
    reviews: 45,
    image: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=500&h=500&fit=crop',
    category: 'Música (Vinilos/CDs)',
    inStock: false
  },
  {
    id: 5,
    name: 'Mochila Táctica Street',
    price: 1800,
    originalPrice: 2200,
    rating: 4.7,
    reviews: 156,
    image: 'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=500&h=500&fit=crop',
    category: 'Accesorios',
    inStock: true
  },
  {
    id: 6,
    name: 'Set de Pósters Neón',
    price: 350,
    rating: 4.2,
    reviews: 34,
    image: 'https://images.unsplash.com/photo-1578662996442-48f60103fc96?w=500&h=500&fit=crop',
    category: 'Arte y Pósters',
    inStock: true
  },
  {
    id: 7,
    name: 'Audífonos Studio Pro',
    price: 3500,
    rating: 4.9,
    reviews: 82,
    image: 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500&h=500&fit=crop',
    category: 'Equipo de Audio',
    inStock: true,
    isNew: true
  },
  {
    id: 8,
    name: 'Bomber Jacket Edición Limitada',
    price: 2800,
    originalPrice: 3500,
    rating: 4.8,
    reviews: 67,
    image: 'https://images.unsplash.com/photo-1591047139829-d91aecb6caea?w=500&h=500&fit=crop',
    category: 'Ropa Urbana',
    inStock: true
  }
];
---

<Layout config={config}>
  <div class="min-h-screen bg-[#f3f3f3] text-black pb-20">
    
    <!-- Top Bar Promocional -->
    <div class="bg-[var(--street-accent)] text-black text-xs font-bold text-center py-2 uppercase tracking-widest">
      Envío gratis en pedidos superiores a $999 • Devoluciones sin costo
    </div>

    <div class="container mx-auto px-4 py-8 max-w-[1600px]">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Sidebar (Filtros y Navegación) -->
        <aside class="hidden lg:block lg:col-span-3 space-y-8">
          
          <!-- Búsqueda -->
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
            <h3 class="font-black uppercase text-lg mb-4">Buscar</h3>
            <div class="relative">
              <input 
                type="text" 
                placeholder="Buscar productos..." 
                class="w-full bg-gray-100 border border-gray-300 rounded px-4 py-2 text-sm focus:outline-none focus:border-[var(--street-accent)] focus:ring-1 focus:ring-[var(--street-accent)] transition-all"
              />
              <button class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-black">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              </button>
            </div>
          </div>

          <!-- Categorías -->
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
            <h3 class="font-black uppercase text-lg mb-4">Categorías</h3>
            <ul class="space-y-3 text-sm font-medium text-gray-600">
              {categories.map(cat => (
                <li>
                  <a href="#" class="hover:text-[var(--street-accent)] hover:translate-x-1 transition-all block flex items-center gap-2">
                    <span class="w-1 h-1 bg-gray-300 rounded-full"></span>
                    {cat.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Filtro de Precio -->
          <div class="bg-white p-6 rounded-lg shadow-sm border border-gray-200">
            <h3 class="font-black uppercase text-lg mb-4">Precio</h3>
            <div class="space-y-2">
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="checkbox" class="accent-black" />
                <span class="text-sm text-gray-600 group-hover:text-black">Hasta $500</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="checkbox" class="accent-black" />
                <span class="text-sm text-gray-600 group-hover:text-black">$500 - $1,000</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="checkbox" class="accent-black" />
                <span class="text-sm text-gray-600 group-hover:text-black">$1,000 - $2,000</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="checkbox" class="accent-black" />
                <span class="text-sm text-gray-600 group-hover:text-black">Más de $2,000</span>
              </label>
            </div>
          </div>

          <!-- Banner Lateral -->
          <div class="bg-black text-white p-6 rounded-lg text-center space-y-4">
            <p class="font-black text-2xl text-[var(--street-accent)] uppercase">WILD CLUB</p>
            <p class="text-sm text-gray-400">Únete al club y obtén 10% de descuento en tu primera compra.</p>
            <button class="w-full bg-[var(--street-accent)] text-black font-bold py-2 text-xs uppercase tracking-widest hover:bg-white transition-colors">
              Suscribirse
            </button>
          </div>

        </aside>

        <!-- Main Content -->
        <main class="col-span-1 lg:col-span-9 space-y-8">
          
          <!-- Hero Carousel (Ofertas) -->
          <section class="relative h-[300px] md:h-[400px] rounded-2xl overflow-hidden group">
            <div class="absolute inset-0 flex transition-transform duration-500 ease-out" id="hero-slider">
              {carouselOffers.map(offer => (
                <div class="min-w-full h-full relative">
                  <img src={offer.image} class="w-full h-full object-cover" />
                  <div class="absolute inset-0 bg-gradient-to-r from-black/80 to-transparent flex flex-col justify-center p-8 md:p-16">
                    <h2 class="text-4xl md:text-6xl font-black text-white uppercase leading-none mb-2">{offer.title}</h2>
                    <p class="text-xl md:text-2xl font-bold text-[var(--street-accent)] uppercase mb-6">{offer.subtitle}</p>
                    <button class="w-fit bg-white text-black px-8 py-3 font-black uppercase tracking-widest hover:bg-[var(--street-accent)] transition-colors text-sm shadow-lg">
                      {offer.cta}
                    </button>
                  </div>
                </div>
              ))}
            </div>
            <!-- Controles simples -->
            <button class="absolute left-4 top-1/2 -translate-y-1/2 bg-black/50 text-white p-2 rounded-full hover:bg-black transition-colors opacity-0 group-hover:opacity-100">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button class="absolute right-4 top-1/2 -translate-y-1/2 bg-black/50 text-white p-2 rounded-full hover:bg-black transition-colors opacity-0 group-hover:opacity-100">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </section>

          <!-- Sección: Ofertas en Tendencia (Horizontal Scroll) -->
          <section>
            <div class="flex justify-between items-end mb-6">
              <h2 class="text-2xl font-black uppercase tracking-tight">Ofertas en Tendencia</h2>
              <a href="#" class="text-sm font-bold text-[var(--street-accent)] hover:underline uppercase">Ver todo</a>
            </div>
            
            <div class="flex gap-6 overflow-x-auto pb-6 snap-x scrollbar-hide">
              {products.filter(p => p.originalPrice).map(product => (
                <div class="min-w-[280px] snap-start bg-white rounded-lg overflow-hidden border border-gray-200 hover:shadow-xl transition-all duration-300 group">
                  <div class="relative h-[280px] bg-gray-100 overflow-hidden">
                    <img src={product.image} class="w-full h-full object-cover mix-blend-multiply group-hover:scale-105 transition-transform duration-500" />
                    <div class="absolute top-2 left-2 bg-red-600 text-white text-[10px] font-bold px-2 py-1 uppercase rounded">
                      -{Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100)}%
                    </div>
                    <button class="absolute top-2 right-2 w-8 h-8 bg-white/80 rounded-full flex items-center justify-center hover:bg-[var(--street-accent)] hover:text-white transition-colors opacity-0 group-hover:opacity-100 shadow-sm" title="Añadir a Lista de Deseos">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                    </button>
                  </div>
                  <div class="p-4 space-y-2">
                    <p class="text-xs text-gray-500 uppercase font-bold">{product.category}</p>
                    <h3 class="font-bold text-sm leading-tight line-clamp-2 h-10">{product.name}</h3>
                    <div class="flex items-baseline gap-2">
                      <span class="text-lg font-black">${product.price}</span>
                      <span class="text-xs text-gray-400 line-through">${product.originalPrice}</span>
                    </div>
                    <div class="flex items-center gap-1">
                      <div class="flex text-yellow-400 text-xs">
                        {'★'.repeat(Math.floor(product.rating))}
                        {'☆'.repeat(5 - Math.floor(product.rating))}
                      </div>
                      <span class="text-xs text-gray-400">({product.reviews})</span>
                    </div>
                    <button class="w-full mt-2 bg-black text-white py-2 text-xs font-bold uppercase tracking-wider hover:bg-[var(--street-accent)] hover:text-black transition-colors rounded">
                      Agregar
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- Sección: Todos los Productos (Grid) -->
          <section>
            <div class="flex justify-between items-end mb-6">
              <h2 class="text-2xl font-black uppercase tracking-tight">Catálogo Completo</h2>
              <div class="flex gap-2">
                <button class="p-2 bg-white border border-gray-300 rounded hover:border-black">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                </button>
                <button class="p-2 bg-white border border-gray-300 rounded hover:border-black text-gray-400">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                </button>
              </div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-6">
              {products.map(product => (
                <div class="bg-white rounded-lg overflow-hidden border border-gray-200 hover:shadow-xl hover:border-[var(--street-accent)] transition-all duration-300 group flex flex-col h-full">
                  <div class="relative aspect-square bg-gray-100 overflow-hidden">
                    <img src={product.image} class="w-full h-full object-cover mix-blend-multiply group-hover:scale-105 transition-transform duration-500" />
                    
                    {product.isBestSeller && (
                      <div class="absolute top-2 left-2 bg-[var(--street-accent)] text-black text-[10px] font-black px-2 py-1 uppercase rounded shadow-sm">
                        Más Vendido
                      </div>
                    )}
                    {!product.inStock && (
                      <div class="absolute inset-0 bg-white/60 backdrop-blur-[1px] flex items-center justify-center">
                        <span class="bg-gray-800 text-white px-3 py-1 text-xs font-bold uppercase rounded">Agotado</span>
                      </div>
                    )}

                    <button class="absolute top-2 right-2 w-8 h-8 bg-white rounded-full flex items-center justify-center hover:bg-[var(--street-accent)] hover:text-white transition-all opacity-0 group-hover:opacity-100 shadow-md transform translate-y-2 group-hover:translate-y-0" title="Añadir a Lista de Deseos">
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                    </button>
                  </div>
                  
                  <div class="p-4 flex flex-col flex-grow">
                    <p class="text-xs text-gray-500 uppercase font-bold mb-1">{product.category}</p>
                    <h3 class="font-bold text-sm leading-tight line-clamp-2 mb-2 group-hover:text-[var(--street-accent)] transition-colors">{product.name}</h3>
                    
                    <div class="mt-auto space-y-3">
                      <div class="flex items-center justify-between">
                        <div class="flex flex-col">
                          <span class="text-lg font-black">${product.price}</span>
                          {product.originalPrice && <span class="text-xs text-gray-400 line-through">${product.originalPrice}</span>}
                        </div>
                        <div class="flex items-center gap-1 bg-gray-50 px-2 py-1 rounded">
                          <span class="text-yellow-500 text-xs">★</span>
                          <span class="text-xs font-bold">{product.rating}</span>
                        </div>
                      </div>
                      
                      <button 
                        class={`w-full py-2 text-xs font-bold uppercase tracking-wider rounded transition-colors flex items-center justify-center gap-2 ${
                          product.inStock 
                          ? 'bg-black text-white hover:bg-[var(--street-accent)] hover:text-black' 
                          : 'bg-gray-200 text-gray-400 cursor-not-allowed'
                        }`}
                        disabled={!product.inStock}
                      >
                        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="9" cy="21" r="1"></circle><circle cx="20" cy="21" r="1"></circle><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path></svg>
                        {product.inStock ? 'Agregar' : 'Sin Stock'}
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>

        </main>
      </div>
    </div>
  </div>
</Layout>

<style define:vars={{ streetAccent: tenant.primary_color }}>
  :root {
    --street-accent: var(--streetAccent);
  }

  /* Ocultar barra de scroll en navegadores */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
</style>
