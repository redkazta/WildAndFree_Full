---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Tienda Oficial",
  primary_color: tenant.primary_color, // #FF5500 (Orange)
  secondary_color: tenant.secondary_color,
  accent_color: tenant.accent_color || "#00FF9D", // Green
  discount_color: "#FFFFFF"
};

const categories = [
  { id: 'all', name: 'Todo' },
  { id: 'clothing', name: 'Ropa Urbana' },
  { id: 'accessories', name: 'Accesorios' },
  { id: 'music', name: 'Música (Vinilos/CDs)' },
  { id: 'art', name: 'Arte y Pósters' },
  { id: 'tech', name: 'Equipo de Audio' }
];

const carouselOffers = [
  {
    id: 101,
    title: "COLECCIÓN DE VERANO",
    subtitle: "HASTA 30% DE DESCUENTO",
    image: "https://images.unsplash.com/photo-1523398002811-999ca8dec234?w=800&h=400&fit=crop",
    cta: "VER OFERTAS"
  },
  {
    id: 102,
    title: "NUEVOS LANZAMIENTOS",
    subtitle: "EDICIÓN LIMITADA VINILO",
    image: "https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?w=800&h=400&fit=crop",
    cta: "COMPRAR AHORA"
  }
];

const products = [
  {
    id: 1,
    name: 'Sudadera Wild Gvng Oversize',
    price: 1200,
    originalPrice: 1500,
    rating: 4.8,
    reviews: 124,
    image: 'https://images.unsplash.com/photo-1556821840-3a63f95609a7?w=500&h=500&fit=crop',
    category: 'Ropa Urbana',
    inStock: true,
    isNew: false,
    isBestSeller: true
  },
  {
    id: 2,
    name: 'Gorra Neon Táctica',
    price: 450,
    rating: 4.5,
    reviews: 89,
    image: 'https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=500&h=500&fit=crop',
    category: 'Accesorios',
    inStock: true,
    isNew: true
  },
  {
    id: 3,
    name: 'Camiseta Tokyo Nights',
    price: 600,
    rating: 4.9,
    reviews: 210,
    image: 'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=500&h=500&fit=crop',
    category: 'Ropa Urbana',
    inStock: true
  },
  {
    id: 4,
    name: 'Box Set Vinilos 2024',
    price: 2500,
    rating: 5.0,
    reviews: 45,
    image: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=500&h=500&fit=crop',
    category: 'Música (Vinilos/CDs)',
    inStock: false
  },
  {
    id: 5,
    name: 'Mochila Táctica Street',
    price: 1800,
    originalPrice: 2200,
    rating: 4.7,
    reviews: 156,
    image: 'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=500&h=500&fit=crop',
    category: 'Accesorios',
    inStock: true
  },
  {
    id: 6,
    name: 'Set de Pósters Neón',
    price: 350,
    rating: 4.2,
    reviews: 34,
    image: 'https://images.unsplash.com/photo-1578662996442-48f60103fc96?w=500&h=500&fit=crop',
    category: 'Arte y Pósters',
    inStock: true
  },
  {
    id: 7,
    name: 'Audífonos Studio Pro',
    price: 3500,
    rating: 4.9,
    reviews: 82,
    image: 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500&h=500&fit=crop',
    category: 'Equipo de Audio',
    inStock: true,
    isNew: true
  },
  {
    id: 8,
    name: 'Bomber Jacket Edición Limitada',
    price: 2800,
    originalPrice: 3500,
    rating: 4.8,
    reviews: 67,
    image: 'https://images.unsplash.com/photo-1591047139829-d91aecb6caea?w=500&h=500&fit=crop',
    category: 'Ropa Urbana',
    inStock: true
  }
];
---

<Layout config={config}>
  <div class="min-h-screen bg-[#050505] text-white pb-20 selection:bg-[var(--wild-orange)] selection:text-black">
    
    <!-- Top Bar Promocional con Gradiente -->
    <div class="bg-gradient-to-r from-[var(--wild-blood)] via-[var(--wild-orange)] to-[var(--wild-blood)] text-white text-[10px] md:text-xs font-black text-center py-2 uppercase tracking-[0.2em] animate-gradient-x shadow-lg shadow-[var(--wild-crimson)]/20">
      Envío gratis en pedidos superiores a $999 • Devoluciones sin costo
    </div>

    <div class="container mx-auto px-4 py-8 max-w-[1600px]">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 relative">
        
        <!-- Sidebar (Filtros y Navegación) -->
        <aside class="hidden lg:block lg:col-span-3">
            <div class="sticky top-24 space-y-6">
              <!-- Búsqueda -->
              <div class="bg-[#0a0a0a] p-6 rounded-xl shadow-lg border border-[var(--wild-dark-red)]/30 backdrop-blur-sm relative group overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-b from-[var(--wild-crimson)]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
                <h3 class="font-black uppercase text-lg mb-4 text-white flex items-center gap-2">
                   <span class="w-1 h-6 bg-[var(--wild-orange)] rounded-full"></span>
                   Buscar
                </h3>
                <div class="relative">
                  <input 
                    type="text" 
                    placeholder="Buscar productos..." 
                    class="w-full bg-[#151515] border border-white/10 rounded-lg px-4 py-3 text-sm text-white placeholder-gray-600 focus:outline-none focus:border-[var(--wild-orange)] focus:ring-1 focus:ring-[var(--wild-orange)] focus:bg-[#1a1a1a] transition-all"
                  />
                  <button class="absolute right-3 top-1/2 -translate-y-1/2 text-gray-500 hover:text-[var(--wild-orange)] transition-colors">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                  </button>
                </div>
              </div>

              <!-- Categorías -->
              <div class="bg-[#0a0a0a] p-6 rounded-xl shadow-lg border border-[var(--wild-dark-red)]/30 relative group overflow-hidden">
                 <div class="absolute inset-0 bg-gradient-to-b from-[var(--wild-crimson)]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
                <h3 class="font-black uppercase text-lg mb-4 text-white flex items-center gap-2">
                    <span class="w-1 h-6 bg-[var(--wild-crimson)] rounded-full"></span>
                    Categorías
                </h3>
                <ul class="space-y-1">
                  {categories.map(cat => (
                    <li>
                      <a href="#" class="group/link flex items-center gap-3 py-2 px-3 rounded-lg hover:bg-white/5 transition-all relative overflow-hidden">
                        <span class="w-1.5 h-1.5 bg-gray-700 rounded-full group-hover/link:bg-[var(--wild-orange)] group-hover/link:scale-125 transition-all"></span>
                        <span class="text-sm font-medium text-gray-400 group-hover/link:text-white group-hover/link:translate-x-1 transition-all">{cat.name}</span>
                        <div class="absolute bottom-0 left-0 h-[1px] w-0 bg-[var(--wild-orange)] group-hover/link:w-full transition-all duration-300"></div>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>

              <!-- Filtro de Precio -->
              <div class="bg-[#0a0a0a] p-6 rounded-xl shadow-lg border border-[var(--wild-dark-red)]/30 relative group overflow-hidden">
                 <div class="absolute inset-0 bg-gradient-to-b from-[var(--wild-crimson)]/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 pointer-events-none"></div>
                <h3 class="font-black uppercase text-lg mb-4 text-white flex items-center gap-2">
                    <span class="w-1 h-6 bg-[var(--wild-blood)] rounded-full"></span>
                    Precio
                </h3>
                <div class="space-y-3">
                  <label class="flex items-center gap-3 cursor-pointer group/check p-2 hover:bg-white/5 rounded-lg transition-colors">
                    <div class="relative flex items-center">
                        <input type="checkbox" class="peer appearance-none w-5 h-5 border-2 border-gray-600 rounded bg-transparent checked:border-[var(--wild-orange)] checked:bg-[var(--wild-orange)] transition-all" />
                        <svg class="absolute w-3 h-3 text-black pointer-events-none opacity-0 peer-checked:opacity-100 left-1 top-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </div>
                    <span class="text-sm text-gray-400 group-hover/check:text-white transition-colors">Hasta $500</span>
                  </label>
                  <label class="flex items-center gap-3 cursor-pointer group/check p-2 hover:bg-white/5 rounded-lg transition-colors">
                    <div class="relative flex items-center">
                        <input type="checkbox" class="peer appearance-none w-5 h-5 border-2 border-gray-600 rounded bg-transparent checked:border-[var(--wild-orange)] checked:bg-[var(--wild-orange)] transition-all" />
                        <svg class="absolute w-3 h-3 text-black pointer-events-none opacity-0 peer-checked:opacity-100 left-1 top-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </div>
                    <span class="text-sm text-gray-400 group-hover/check:text-white transition-colors">$500 - $1,000</span>
                  </label>
                  <label class="flex items-center gap-3 cursor-pointer group/check p-2 hover:bg-white/5 rounded-lg transition-colors">
                    <div class="relative flex items-center">
                        <input type="checkbox" class="peer appearance-none w-5 h-5 border-2 border-gray-600 rounded bg-transparent checked:border-[var(--wild-orange)] checked:bg-[var(--wild-orange)] transition-all" />
                        <svg class="absolute w-3 h-3 text-black pointer-events-none opacity-0 peer-checked:opacity-100 left-1 top-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </div>
                    <span class="text-sm text-gray-400 group-hover/check:text-white transition-colors">$1,000 - $2,000</span>
                  </label>
                  <label class="flex items-center gap-3 cursor-pointer group/check p-2 hover:bg-white/5 rounded-lg transition-colors">
                    <div class="relative flex items-center">
                        <input type="checkbox" class="peer appearance-none w-5 h-5 border-2 border-gray-600 rounded bg-transparent checked:border-[var(--wild-orange)] checked:bg-[var(--wild-orange)] transition-all" />
                        <svg class="absolute w-3 h-3 text-black pointer-events-none opacity-0 peer-checked:opacity-100 left-1 top-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                    </div>
                    <span class="text-sm text-gray-400 group-hover/check:text-white transition-colors">Más de $2,000</span>
                  </label>
                </div>
              </div>

              <!-- Banner Lateral -->
              <div class="relative overflow-hidden bg-[#0a0a0a] border border-[var(--wild-orange)]/30 text-white p-8 rounded-xl text-center space-y-4 group">
                <div class="absolute inset-0 bg-gradient-to-br from-[var(--wild-orange)]/10 via-transparent to-[var(--wild-crimson)]/10 opacity-50 group-hover:opacity-100 transition-opacity duration-700"></div>
                <div class="relative z-10">
                    <p class="font-black text-3xl text-[var(--wild-orange)] uppercase italic tracking-tighter drop-shadow-md">WILD CLUB</p>
                    <p class="text-xs text-gray-300 font-medium leading-relaxed">Únete al club y obtén <span class="text-white font-bold">10% de descuento</span> en tu primera compra.</p>
                    <button class="mt-4 w-full bg-gradient-to-r from-[var(--wild-orange)] to-[var(--wild-crimson)] text-white font-black py-3 text-[10px] uppercase tracking-[0.2em] hover:brightness-110 transition-all shadow-lg shadow-[var(--wild-orange)]/20 rounded-lg">
                    Suscribirse
                    </button>
                </div>
              </div>
          </div>
        </aside>

        <!-- Main Content -->
        <main class="col-span-1 lg:col-span-9 space-y-12">
          
          <!-- Hero Carousel (Ofertas) -->
          <section class="relative h-[300px] md:h-[450px] rounded-2xl overflow-hidden group border border-white/10 shadow-2xl shadow-black/50">
            <div class="absolute inset-0 flex transition-transform duration-500 ease-out" id="hero-slider">
              {carouselOffers.map(offer => (
                <div class="min-w-full h-full relative">
                  <img src={offer.image} class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-1000 ease-in-out scale-105 hover:scale-100" />
                  <div class="absolute inset-0 bg-gradient-to-r from-black via-black/60 to-transparent flex flex-col justify-center p-8 md:p-16">
                    <div class="border-l-4 border-[var(--wild-orange)] pl-6 md:pl-8">
                        <h2 class="text-4xl md:text-7xl font-black text-white uppercase leading-[0.9] mb-4 drop-shadow-xl" style="text-shadow: 4px 4px 0px rgba(0,0,0,0.8);">{offer.title}</h2>
                        <p class="text-xl md:text-3xl font-bold text-[var(--wild-light-orange)] uppercase mb-8 tracking-wide drop-shadow-md">{offer.subtitle}</p>
                        <button class="w-fit bg-white text-black px-8 py-4 font-black uppercase tracking-[0.2em] hover:bg-[var(--wild-orange)] hover:text-white transition-all duration-300 text-xs md:text-sm shadow-[6px_6px_0px_var(--wild-blood)] hover:shadow-[0px_0px_0px_transparent] hover:translate-x-[2px] hover:translate-y-[2px]">
                        {offer.cta}
                        </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <!-- Controles simples -->
            <button class="absolute left-4 top-1/2 -translate-y-1/2 bg-black/50 backdrop-blur-sm text-white p-3 rounded-full hover:bg-[var(--wild-orange)] hover:text-white transition-all opacity-0 group-hover:opacity-100 border border-white/10 hover:scale-110">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button class="absolute right-4 top-1/2 -translate-y-1/2 bg-black/50 backdrop-blur-sm text-white p-3 rounded-full hover:bg-[var(--wild-orange)] hover:text-white transition-all opacity-0 group-hover:opacity-100 border border-white/10 hover:scale-110">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </section>

          <!-- Sección: Ofertas en Tendencia (Horizontal Scroll) -->
          <section>
            <div class="flex justify-between items-end mb-8 border-b border-white/10 pb-4">
              <h2 class="text-2xl md:text-3xl font-black uppercase tracking-tight text-white flex items-center gap-3">
                <span class="w-2 h-8 bg-gradient-to-b from-[var(--wild-orange)] to-[var(--wild-crimson)]"></span>
                Ofertas en Tendencia
              </h2>
              <a href="#" class="text-xs font-bold text-[var(--wild-light-orange)] hover:text-white hover:underline uppercase tracking-widest transition-colors">Ver todo -></a>
            </div>
            
            <div class="flex gap-6 overflow-x-auto pb-8 snap-x scrollbar-hide">
              {products.filter(p => p.originalPrice).map((product, idx) => (
                <div class="min-w-[280px] snap-start bg-[#0a0a0a] rounded-xl overflow-hidden border border-white/5 hover:border-[var(--wild-orange)]/50 transition-all duration-500 group hover:-translate-y-2 hover:shadow-[0_10px_40px_-15px_rgba(255,85,0,0.3)] flex flex-col">
                  <div class="relative h-[300px] bg-[#151515] overflow-hidden">
                    <img src={product.image} class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-110 transition-all duration-700 ease-out" />
                    
                    <!-- Gradient Overlay on Hover -->
                    <div class="absolute inset-0 bg-gradient-to-t from-[var(--wild-blood)]/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>

                    {product.originalPrice && (
                      <div class={`absolute top-3 left-3 text-[10px] font-black px-3 py-1.5 uppercase rounded shadow-[4px_4px_0px_rgba(0,0,0,0.5)] transform -rotate-2 z-20 border ${idx % 2 === 0 ? 'bg-[var(--wild-crimson)] text-white border-white/20' : 'bg-white text-black border-black'}`}>
                        -{Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100)}% OFF
                      </div>
                    )}
                  </div>
                  <div class="p-5 space-y-3 flex-1 flex flex-col relative bg-gradient-to-b from-[#0a0a0a] to-[#050505]">
                    <!-- Top accent line -->
                    <div class="absolute top-0 left-0 w-full h-[1px] bg-gradient-to-r from-transparent via-[var(--wild-orange)]/50 to-transparent opacity-0 group-hover:opacity-100 transition-opacity"></div>

                    <p class="text-[10px] text-[var(--wild-light-orange)] uppercase font-bold tracking-[0.2em]">{product.category}</p>
                    <h3 class="font-black text-sm text-white leading-tight line-clamp-2 h-10 group-hover:text-[var(--wild-orange)] transition-colors">{product.name}</h3>
                    
                    <div class="flex items-center gap-1 mb-2">
                      <div class="flex text-[var(--wild-orange)] text-xs">
                        {'★'.repeat(Math.floor(product.rating))}
                        <span class="text-gray-700">{'★'.repeat(5 - Math.floor(product.rating))}</span>
                      </div>
                      <span class="text-[10px] text-gray-500 font-medium">({product.reviews})</span>
                    </div>

                    <div class="mt-auto pt-3 border-t border-white/5">
                        <div class="flex items-baseline gap-2 mb-4">
                            <span class="text-xl font-black text-white">${product.price}</span>
                            <span class="text-xs text-gray-500 line-through font-bold decoration-[var(--wild-crimson)] decoration-2">${product.originalPrice}</span>
                        </div>
                        
                        <!-- Botones separados -->
                        <div class="flex gap-2">
                            <button class="flex-1 bg-white text-black py-2.5 text-[10px] font-black uppercase tracking-[0.15em] hover:bg-[var(--wild-orange)] hover:text-white transition-all rounded shadow-[0px_4px_0px_#1a1a1a] active:shadow-none active:translate-y-[4px] add-to-cart-btn cursor-pointer flex items-center justify-center gap-2 group/btn overflow-hidden relative" data-product={JSON.stringify(product)}>
                            <div class="absolute inset-0 bg-gradient-to-r from-[var(--wild-orange)] to-[var(--wild-crimson)] opacity-0 group-hover/btn:opacity-100 transition-opacity z-0"></div>
                            <span class="btn-text relative z-10 flex items-center gap-2">
                                <span>AGREGAR</span>
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                            </span>
                            <span class="btn-spinner hidden animate-spin relative z-10">
                                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                            </span>
                            </button>
                            <button class="w-10 bg-[#1a1a1a] text-gray-400 border border-white/10 rounded flex items-center justify-center hover:border-[var(--wild-crimson)] hover:text-[var(--wild-crimson)] hover:bg-[var(--wild-crimson)]/10 transition-colors toggle-wishlist-btn cursor-pointer" data-product={JSON.stringify(product)} title="Lista de Deseos">
                                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                            </button>
                        </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- Sección: Catálogo Completo (Grid) -->
          <section>
            <div class="flex justify-between items-end mb-8 border-b border-white/10 pb-4">
              <h2 class="text-2xl md:text-3xl font-black uppercase tracking-tight text-white flex items-center gap-3">
                <span class="w-2 h-8 bg-gradient-to-b from-[var(--wild-crimson)] to-[var(--wild-blood)]"></span>
                Catálogo Completo
              </h2>
              <div class="flex gap-2">
                <button class="p-2 bg-[#111] border border-white/20 rounded hover:border-[var(--wild-orange)] text-white transition-colors">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                </button>
                <button class="p-2 bg-[#111] border border-white/20 rounded hover:border-[var(--wild-orange)] text-gray-500 hover:text-white transition-colors">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                </button>
              </div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-6">
              {products.map((product, idx) => (
                <div class="bg-[#0a0a0a] rounded-xl overflow-hidden border border-white/5 hover:border-[var(--wild-crimson)]/40 transition-all duration-300 group flex flex-col h-full hover:-translate-y-2 hover:shadow-[0_15px_50px_-10px_rgba(138,3,3,0.2)] relative">
                  <!-- Efecto de brillo en hover -->
                  <div class="absolute inset-0 bg-gradient-to-tr from-[var(--wild-blood)]/10 via-transparent to-[var(--wild-orange)]/5 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-10"></div>
                  
                  <div class="relative aspect-[4/5] bg-[#151515] overflow-hidden">
                    <img src={product.image} class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-700 ease-out" />
                    
                    <div class="absolute top-0 left-0 p-3 w-full flex justify-between items-start z-20">
                        {product.isBestSeller && (
                          <div class="bg-[var(--wild-orange)] text-white text-[9px] font-black px-2 py-1 uppercase tracking-widest rounded-sm shadow-lg border border-white/20">
                            Top Seller
                          </div>
                        )}
                        {!product.isBestSeller && <div></div>} <!-- Spacer -->
                    </div>

                    {!product.inStock && (
                      <div class="absolute inset-0 bg-black/80 backdrop-blur-[2px] flex items-center justify-center z-20">
                        <div class="border-2 border-[var(--wild-crimson)] text-[var(--wild-crimson)] px-4 py-2 text-sm font-black uppercase tracking-[0.2em] -rotate-12 bg-black shadow-[0_0_20px_rgba(220,20,60,0.5)]">
                            Agotado
                        </div>
                      </div>
                    )}
                  </div>
                  
                  <div class="p-5 flex flex-col flex-grow relative z-20 bg-gradient-to-b from-[#0a0a0a] to-[#050505]">
                    <div class="mb-3">
                        <p class="text-[9px] text-[var(--wild-light-orange)] uppercase font-bold tracking-[0.2em] mb-1.5 opacity-80 group-hover:opacity-100 transition-opacity">{product.category}</p>
                        <h3 class="font-black text-sm text-white leading-tight line-clamp-2 group-hover:text-[var(--wild-orange)] transition-colors">{product.name}</h3>
                    </div>
                    
                    <div class="mt-auto space-y-4">
                      <div class="flex items-end justify-between border-t border-white/5 pt-4">
                        <div class="flex flex-col">
                          <span class="text-[10px] text-gray-500 font-medium mb-0.5 uppercase tracking-wider">Precio</span>
                          <div class="flex items-baseline gap-2">
                              <span class="text-lg font-black text-white tracking-tight">${product.price}</span>
                              {product.originalPrice && <span class="text-xs text-gray-600 line-through font-bold">${product.originalPrice}</span>}
                          </div>
                        </div>
                        <div class="flex items-center gap-1">
                          <span class="text-[var(--wild-orange)] text-xs">★</span>
                          <span class="text-[10px] font-bold text-gray-400 group-hover:text-white transition-colors">{product.rating}</span>
                        </div>
                      </div>
                      
                      <!-- Action Buttons -->
                      <div class="flex gap-2">
                          <button 
                            class={`flex-1 py-3 text-[10px] font-black uppercase tracking-[0.2em] rounded-lg transition-all flex items-center justify-center gap-2 add-to-cart-btn group/btn overflow-hidden relative cursor-pointer ${
                              product.inStock 
                              ? 'bg-white text-black hover:bg-[var(--wild-orange)] hover:text-white hover:shadow-[0_0_25px_rgba(255,85,0,0.4)]' 
                              : 'bg-[#1a1a1a] text-gray-600 cursor-not-allowed border border-white/5'
                            }`}
                            disabled={!product.inStock}
                            data-product={product.inStock ? JSON.stringify(product) : undefined}
                          >
                             {product.inStock && <div class="absolute inset-0 bg-gradient-to-r from-[var(--wild-orange)] to-[var(--wild-crimson)] opacity-0 group-hover/btn:opacity-100 transition-opacity z-0"></div>}
                            <span class="btn-text relative z-10 flex items-center gap-2">
                                {product.inStock ? 'AGREGAR' : 'SIN STOCK'}
                            </span>
                            <span class="btn-spinner hidden animate-spin absolute z-20">
                                <svg class="h-4 w-4" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>
                            </span>
                          </button>
                          
                          <button class="w-12 bg-[#1a1a1a] border border-white/10 rounded-lg flex items-center justify-center hover:border-[var(--wild-crimson)] hover:text-[var(--wild-crimson)] hover:bg-[var(--wild-crimson)]/10 transition-colors toggle-wishlist-btn cursor-pointer group/wish" data-product={JSON.stringify(product)} title="Lista de Deseos">
                               <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="group-hover/wish:scale-110 transition-transform"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                          </button>
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>

        </main>
      </div>
    </div>
  </div>
</Layout>

<style is:global define:vars={{ streetPrimary: tenant.primary_color, streetAccent: tenant.accent_color }}>
  :root {
    --street-primary: var(--streetPrimary);
    --street-accent: var(--streetAccent);
    
    /* New Palette */
    --wild-orange: #FF5500;
    --wild-light-orange: #FF8C00;
    --wild-blood: #8A0303;
    --wild-crimson: #DC143C;
    --wild-dark-red: #4A0404;
  }

  /* Ocultar barra de scroll en navegadores */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  @keyframes gradient-x {
      0%, 100% {
          background-position: 0% 50%;
      }
      50% {
          background-position: 100% 50%;
      }
  }
  .animate-gradient-x {
      background-size: 200% 200%;
      animation: gradient-x 6s ease infinite;
  }
</style>

<!-- Confirmation Modal -->
<dialog id="cart-confirm-dialog" class="bg-transparent p-0 backdrop:bg-black/80 backdrop:backdrop-blur-sm open:animate-fade-in z-50 rounded-xl shadow-2xl">
  <div class="bg-[#0a0a0a] border border-[var(--wild-orange)]/30 text-white p-6 rounded-xl max-w-sm w-full mx-auto relative overflow-hidden shadow-[0_0_50px_rgba(255,85,0,0.15)]">
     <div class="absolute top-0 left-0 w-full h-1 bg-gradient-to-r from-[var(--wild-orange)] to-[var(--wild-crimson)]"></div>
     <div class="absolute -top-10 -right-10 w-32 h-32 bg-[var(--wild-orange)]/10 blur-3xl rounded-full"></div>
     
     <div class="text-center mb-6 relative z-10">
        <div class="w-16 h-16 bg-gradient-to-br from-[var(--wild-orange)]/20 to-[var(--wild-crimson)]/20 rounded-full flex items-center justify-center mx-auto mb-4 text-[var(--wild-orange)] border border-[var(--wild-orange)]/20">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
        </div>
        <h3 class="text-xl font-black uppercase tracking-tight">¡Agregado al Carrito!</h3>
        <p class="text-[var(--wild-light-orange)] text-sm mt-2 font-medium" id="modal-product-name">Producto</p>
     </div>

     <div class="flex gap-3 relative z-10">
        <button id="modal-keep-shopping" class="flex-1 py-3 border border-white/10 rounded-lg font-bold text-[10px] uppercase tracking-widest hover:bg-white/5 hover:text-white hover:border-white/30 transition-all">
            Seguir Comprando
        </button>
        <button id="modal-go-cart" class="flex-1 py-3 bg-gradient-to-r from-[var(--wild-orange)] to-[var(--wild-crimson)] text-white rounded-lg font-bold text-[10px] uppercase tracking-widest hover:brightness-110 transition-all shadow-lg shadow-[var(--wild-orange)]/20">
            Ir al Carrito
        </button>
     </div>
  </div>
</dialog>

<script>
  import { cartStore } from '../lib/cart.js';

  const dialog = document.getElementById('cart-confirm-dialog') as HTMLDialogElement;
  const modalProductName = document.getElementById('modal-product-name');
  const modalKeepShopping = document.getElementById('modal-keep-shopping');
  const modalGoCart = document.getElementById('modal-go-cart');

  // Modal Handlers
  if (modalKeepShopping) {
      modalKeepShopping.addEventListener('click', () => dialog.close());
  }
  if (modalGoCart) {
      modalGoCart.addEventListener('click', () => {
          dialog.close();
          // Navegar al carrito (open drawer or page)
          console.log("Navegar al carrito");
          window.location.href = '/checkout'; // O abrir drawer si existe
      });
  }

  // Click outside to close
  dialog.addEventListener('click', (e) => {
    const rect = dialog.getBoundingClientRect();
    if (e.clientX < rect.left || e.clientX > rect.right || 
        e.clientY < rect.top || e.clientY > rect.bottom) {
      dialog.close();
    }
  });

  const initShop = async () => {
    // Wait for cart store to be ready
    if (!cartStore.initialized) {
        await cartStore.init();
    }

    // Helper to update wishlist icon state
    const updateWishlistIcon = (btn: Element, isActive: boolean) => {
        const icon = btn.querySelector('svg');
        if (icon) {
            if (isActive) {
                icon.style.fill = 'currentColor';
                icon.style.color = 'var(--wild-crimson)';
                btn.classList.add('border-[var(--wild-crimson)]', 'text-[var(--wild-crimson)]', 'bg-[var(--wild-crimson)]/10');
                btn.classList.remove('border-white/10', 'text-gray-400', 'bg-[#1a1a1a]');
                
                // Add pop effect
                btn.classList.add('scale-110');
                setTimeout(() => btn.classList.remove('scale-110'), 200);
            } else {
                icon.style.fill = 'none';
                icon.style.color = 'currentColor';
                btn.classList.remove('border-[var(--wild-crimson)]', 'text-[var(--wild-crimson)]', 'bg-[var(--wild-crimson)]/10', 'scale-110');
                btn.classList.add('border-white/10', 'text-gray-400', 'bg-[#1a1a1a]');
            }
        }
    };

    // Helper to check Cart State for buttons
    const updateCartButtonState = (btn: Element, isInCart: boolean) => {
        // Skip styling updates for disabled (out of stock) buttons unless they are in cart
        if (btn.hasAttribute('disabled') && !isInCart) return;

        const textSpan = btn.querySelector('.btn-text');
        if (isInCart) {
            if(textSpan) textSpan.innerHTML = `<span>EN CARRITO</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>`;
            
            btn.classList.add('border', 'border-[var(--wild-orange)]', 'bg-black', 'text-[var(--wild-orange)]');
            btn.classList.remove('bg-white', 'text-black', 'bg-[#1a1a1a]');
        } else {
            // Reset to default state based on stock
            if (btn.hasAttribute('disabled')) return; 
            
            if(textSpan) textSpan.innerHTML = `<span>AGREGAR</span><svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>`;
            btn.classList.remove('border', 'border-[var(--wild-orange)]', 'bg-black', 'text-[var(--wild-orange)]');
            btn.classList.add('bg-white', 'text-black');
        }
    };

    // Initialize Button States
    const syncButtons = () => {
        document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
            const productData = (btn as HTMLElement).dataset.product;
            if (productData) {
                try {
                    const product = JSON.parse(productData);
                    const isInCart = cartStore.isInCart(product.id);
                    updateCartButtonState(btn, isInCart);
                } catch(e) {}
            }
        });

        document.querySelectorAll('.toggle-wishlist-btn').forEach(btn => {
            const productData = (btn as HTMLElement).dataset.product;
            if (productData) {
                try {
                    const product = JSON.parse(productData);
                    const isInWishlist = cartStore.isInWishlist(product.id);
                    updateWishlistIcon(btn, isInWishlist);
                } catch(e) {}
            }
        });
    };

    syncButtons();

    // Listen for global updates to keep buttons in sync
    window.addEventListener('cart:updated', () => syncButtons());
    window.addEventListener('wishlist:updated', () => syncButtons());

    // --- Event Listeners ---

    // Add to Cart Buttons
    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);
      
      newBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const targetBtn = e.currentTarget as HTMLElement;
        const productData = targetBtn.dataset.product;
        
        if (productData) {
          try {
            const product = JSON.parse(productData);
            
            // Loading State
            const textSpan = targetBtn.querySelector('.btn-text');
            const spinner = targetBtn.querySelector('.btn-spinner');
            
            if(textSpan) textSpan.classList.add('opacity-0');
            if(spinner) spinner.classList.remove('hidden');
            targetBtn.setAttribute('disabled', 'true');

            // Simulate network delay for UX
            await new Promise(r => setTimeout(r, 600));
            
            await cartStore.addToCart(product);

            // Restore State
            if(textSpan) textSpan.classList.remove('opacity-0');
            if(spinner) spinner.classList.add('hidden');
            targetBtn.removeAttribute('disabled');
            
            // Show Confirmation Modal
            if (modalProductName) modalProductName.textContent = product.name;
            dialog.showModal();
            
          } catch (err) {
            console.error('Error adding to cart:', err);
            // Restore state on error
            const textSpan = targetBtn.querySelector('.btn-text');
            const spinner = targetBtn.querySelector('.btn-spinner');
            if(textSpan) textSpan.classList.remove('opacity-0');
            if(spinner) spinner.classList.add('hidden');
            targetBtn.removeAttribute('disabled');
          }
        }
      });
    });

    // Toggle Wishlist Buttons
    document.querySelectorAll('.toggle-wishlist-btn').forEach(btn => {
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const targetBtn = e.currentTarget as HTMLElement;
        const productData = targetBtn.dataset.product;
        
        if (productData) {
          try {
            const product = JSON.parse(productData);
            await cartStore.toggleWishlist(product);
           } catch (err) {
             console.error('Error toggling wishlist:', err);
           }
         }
       });
     });
  };

  // Init on load and after swap
  initShop();
  document.addEventListener('astro:after-swap', initShop);
</script>
