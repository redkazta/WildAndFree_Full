---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Tienda",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};

const products = [
  {
    id: 1,
    name: 'WILD GVNG HOODIE',
    price: 'MXN $1,200',
    image: 'https://images.unsplash.com/photo-1556821840-3a63f95609a7?w=800&h=1000&fit=crop',
    category: 'ROPA',
    description: 'ALGODÓN PESADO. CORTE OVERSIZE. EDICIÓN LIMITADA.',
    sizes: ['S', 'M', 'L', 'XL'],
    inStock: true,
    tag: 'MÁS VENDIDO'
  },
  {
    id: 2,
    name: 'NEON CAP',
    price: 'MXN $450',
    image: 'https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=800&h=1000&fit=crop',
    category: 'ACCESORIOS',
    description: 'LOGO BORDADO. CORREA AJUSTABLE.',
    inStock: true,
    tag: 'NUEVO'
  },
  {
    id: 3,
    name: 'TOKYO NIGHTS TEE',
    price: 'MXN $600',
    image: 'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=800&h=1000&fit=crop',
    category: 'ROPA',
    description: 'GRÁFICO SERIGRAFIADO. LAVADO VINTAGE.',
    sizes: ['S', 'M', 'L', 'XL', 'XXL'],
    inStock: true
  },
  {
    id: 4,
    name: 'VINYL COLLECTION BOX',
    price: 'MXN $2,500',
    image: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=800&h=1000&fit=crop',
    category: 'MÚSICA',
    description: 'DISCOGRAFÍA COMPLETA 2023-2024. SET DE 4 LP.',
    inStock: false,
    tag: 'AGOTADO'
  },
  {
    id: 5,
    name: 'STREET BACKPACK',
    price: 'MXN $1,800',
    image: 'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=800&h=1000&fit=crop',
    category: 'ACCESORIOS',
    description: 'RESISTENTE AL AGUA. COMPARTIMENTO PARA LAPTOP.',
    inStock: true
  },
  {
    id: 6,
    name: 'NEON POSTER SET',
    price: 'MXN $350',
    image: 'https://images.unsplash.com/photo-1578662996442-48f60103fc96?w=800&h=1000&fit=crop',
    category: 'ARTE',
    description: 'TAMAÑO A3. IMPRESIÓN DE ALTA CALIDAD.',
    inStock: true
  }
];

const categories = ['TODO', 'ROPA', 'ACCESORIOS', 'MÚSICA', 'ARTE'];
---

<Layout config={config}>
  <div class="min-h-screen bg-[#050505] pb-20 px-6 relative overflow-hidden">
    <!-- Background Noise Pattern -->
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 20px 20px;"></div>

    <div class="max-w-[1600px] mx-auto space-y-16 relative z-10">
      
      <!-- Header Brutalista -->
      <div class="border-b-4 border-white pb-8 flex flex-col md:flex-row justify-between items-end gap-8">
        <div>
          <h1 class="text-7xl md:text-9xl font-black tracking-tighter text-white uppercase leading-none" style="text-shadow: 4px 4px 0px var(--street-accent);">
            TIENDA
          </h1>
          <div class="flex flex-col mb-2 mt-4">
             <span class="text-xl font-bold text-black bg-[var(--street-accent)] px-2 inline-block w-fit">MERCANCÍA OFICIAL</span>
             <span class="text-sm font-mono text-[#888] tracking-widest mt-1">CANTIDADES LIMITADAS • ENVÍOS A TODO EL MUNDO</span>
          </div>
        </div>

        <!-- Botones de Filtro -->
        <div class="flex flex-wrap gap-4 font-mono text-sm">
          {categories.map((category) => (
            <button class="px-4 py-2 border-2 border-white text-white hover:bg-white hover:text-black hover:border-[var(--street-accent)] transition-all uppercase tracking-widest">
              {category}
            </button>
          ))}
        </div>
      </div>

      <!-- Products Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-x-8 gap-y-16">
        {products.map((product) => (
          <div class="group relative flex flex-col">
            
            <!-- Image Container -->
            <div class="relative aspect-[4/5] bg-[#111] border-2 border-white overflow-hidden mb-6 group-hover:border-[var(--street-accent)] transition-colors">
              <img src={product.image} alt={product.name} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 group-hover:scale-105" />
              
              <!-- Tag Sticker -->
              {product.tag && (
                <div class="absolute top-4 left-4 z-10">
                  <span class={`px-3 py-1 text-xs font-black uppercase tracking-widest border-2 border-black shadow-[2px_2px_0px_black] ${
                    product.tag === 'SOLD OUT' ? 'bg-red-600 text-white' : 'bg-[var(--street-accent)] text-black'
                  }`}>
                    {product.tag}
                  </span>
                </div>
              )}

              <!-- Price Tag Sticker (Bottom Right) -->
              <div class="absolute bottom-4 right-4 z-10 rotate-[-5deg] group-hover:rotate-0 transition-transform">
                <span class="px-4 py-2 bg-white text-black font-black font-mono text-lg border-2 border-black shadow-[4px_4px_0px_var(--street-accent)]">
                  {product.price}
                </span>
              </div>

              <!-- Quick Add Overlay -->
              <div class="absolute inset-0 bg-black/50 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity backdrop-blur-[2px]">
                <button 
                  class={`px-8 py-4 font-black uppercase tracking-widest border-2 shadow-[4px_4px_0px_black] hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_black] transition-all ${
                    product.inStock 
                    ? 'bg-[var(--street-accent)] text-black border-black' 
                    : 'bg-gray-500 text-white border-white cursor-not-allowed'
                  }`}
                  disabled={!product.inStock}
                >
                  {product.inStock ? 'Añadir al Carrito' : 'Agotado'}
                </button>
              </div>
            </div>

            <!-- Info -->
            <div class="space-y-2">
              <div class="flex justify-between items-start">
                <h3 class="text-2xl font-black text-white uppercase leading-none group-hover:text-[var(--street-accent)] transition-colors">
                  {product.name}
                </h3>
              </div>
              <p class="text-xs font-mono text-gray-400 border-l border-[var(--street-accent)] pl-2 uppercase">
                {product.category}
              </p>
              <p class="text-sm font-bold text-gray-500 uppercase tracking-wide">
                {product.description}
              </p>
              
              {product.sizes && (
                <div class="flex gap-2 mt-2">
                  {product.sizes.map(size => (
                    <span class="w-8 h-8 flex items-center justify-center border border-white/20 text-xs font-mono text-white/60 hover:border-white hover:text-white cursor-pointer transition-colors">
                      {size}
                    </span>
                  ))}
                </div>
              )}
            </div>

          </div>
        ))}
      </div>

    </div>
  </main>
</Layout>

<style define:vars={{ streetAccent: tenant.primary_color }}>
  :root {
    --street-accent: var(--streetAccent);
  }
</style>
