---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Tienda Oficial",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};

const categories = [
  { id: 'all', name: 'Todo' },
  { id: 'clothing', name: 'Ropa Urbana' },
  { id: 'accessories', name: 'Accesorios' },
  { id: 'music', name: 'Música (Vinilos/CDs)' },
  { id: 'art', name: 'Arte y Pósters' },
  { id: 'tech', name: 'Equipo de Audio' }
];

const carouselOffers = [
  {
    id: 101,
    title: "COLECCIÓN DE VERANO",
    subtitle: "HASTA 30% DE DESCUENTO",
    image: "https://images.unsplash.com/photo-1523398002811-999ca8dec234?w=800&h=400&fit=crop",
    cta: "VER OFERTAS"
  },
  {
    id: 102,
    title: "NUEVOS LANZAMIENTOS",
    subtitle: "EDICIÓN LIMITADA VINILO",
    image: "https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?w=800&h=400&fit=crop",
    cta: "COMPRAR AHORA"
  }
];

const products = [
  {
    id: 1,
    name: 'Sudadera Wild Gvng Oversize',
    price: 1200,
    originalPrice: 1500,
    rating: 4.8,
    reviews: 124,
    image: 'https://images.unsplash.com/photo-1556821840-3a63f95609a7?w=500&h=500&fit=crop',
    category: 'Ropa Urbana',
    inStock: true,
    isNew: false,
    isBestSeller: true
  },
  {
    id: 2,
    name: 'Gorra Neon Táctica',
    price: 450,
    rating: 4.5,
    reviews: 89,
    image: 'https://images.unsplash.com/photo-1588850561407-ed78c282e89b?w=500&h=500&fit=crop',
    category: 'Accesorios',
    inStock: true,
    isNew: true
  },
  {
    id: 3,
    name: 'Camiseta Tokyo Nights',
    price: 600,
    rating: 4.9,
    reviews: 210,
    image: 'https://images.unsplash.com/photo-1521572163474-6864f9cf17ab?w=500&h=500&fit=crop',
    category: 'Ropa Urbana',
    inStock: true
  },
  {
    id: 4,
    name: 'Box Set Vinilos 2024',
    price: 2500,
    rating: 5.0,
    reviews: 45,
    image: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?w=500&h=500&fit=crop',
    category: 'Música (Vinilos/CDs)',
    inStock: false
  },
  {
    id: 5,
    name: 'Mochila Táctica Street',
    price: 1800,
    originalPrice: 2200,
    rating: 4.7,
    reviews: 156,
    image: 'https://images.unsplash.com/photo-1553062407-98eeb64c6a62?w=500&h=500&fit=crop',
    category: 'Accesorios',
    inStock: true
  },
  {
    id: 6,
    name: 'Set de Pósters Neón',
    price: 350,
    rating: 4.2,
    reviews: 34,
    image: 'https://images.unsplash.com/photo-1578662996442-48f60103fc96?w=500&h=500&fit=crop',
    category: 'Arte y Pósters',
    inStock: true
  },
  {
    id: 7,
    name: 'Audífonos Studio Pro',
    price: 3500,
    rating: 4.9,
    reviews: 82,
    image: 'https://images.unsplash.com/photo-1505740420928-5e560c06d30e?w=500&h=500&fit=crop',
    category: 'Equipo de Audio',
    inStock: true,
    isNew: true
  },
  {
    id: 8,
    name: 'Bomber Jacket Edición Limitada',
    price: 2800,
    originalPrice: 3500,
    rating: 4.8,
    reviews: 67,
    image: 'https://images.unsplash.com/photo-1591047139829-d91aecb6caea?w=500&h=500&fit=crop',
    category: 'Ropa Urbana',
    inStock: true
  }
];
---

<Layout config={config}>
  <div class="min-h-screen bg-[#050505] text-white pb-20">
    
    <!-- Top Bar Promocional -->
    <div class="bg-[var(--street-accent)] text-black text-xs font-bold text-center py-2 uppercase tracking-widest">
      Envío gratis en pedidos superiores a $999 • Devoluciones sin costo
    </div>

    <div class="container mx-auto px-4 py-8 max-w-[1600px]">
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
        
        <!-- Sidebar (Filtros y Navegación) -->
        <aside class="hidden lg:block lg:col-span-3 space-y-8">
          
          <!-- Búsqueda -->
          <div class="bg-[#111] p-6 rounded-lg shadow-sm border border-white/10">
            <h3 class="font-black uppercase text-lg mb-4 text-white">Buscar</h3>
            <div class="relative">
              <input 
                type="text" 
                placeholder="Buscar productos..." 
                class="w-full bg-[#222] border border-white/20 rounded px-4 py-2 text-sm text-white placeholder-gray-500 focus:outline-none focus:border-[var(--street-accent)] focus:ring-1 focus:ring-[var(--street-accent)] transition-all"
              />
              <button class="absolute right-2 top-1/2 -translate-y-1/2 text-gray-400 hover:text-white">
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
              </button>
            </div>
          </div>

          <!-- Categorías -->
          <div class="bg-[#111] p-6 rounded-lg shadow-sm border border-white/10">
            <h3 class="font-black uppercase text-lg mb-4 text-white">Categorías</h3>
            <ul class="space-y-3 text-sm font-medium text-gray-400">
              {categories.map(cat => (
                <li>
                  <a href="#" class="hover:text-[var(--street-accent)] hover:translate-x-1 transition-all block flex items-center gap-2">
                    <span class="w-1 h-1 bg-gray-600 rounded-full"></span>
                    {cat.name}
                  </a>
                </li>
              ))}
            </ul>
          </div>

          <!-- Filtro de Precio -->
          <div class="bg-[#111] p-6 rounded-lg shadow-sm border border-white/10">
            <h3 class="font-black uppercase text-lg mb-4 text-white">Precio</h3>
            <div class="space-y-2">
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="checkbox" class="accent-[var(--street-accent)] bg-[#222] border-white/20" />
                <span class="text-sm text-gray-400 group-hover:text-white">Hasta $500</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="checkbox" class="accent-[var(--street-accent)] bg-[#222] border-white/20" />
                <span class="text-sm text-gray-400 group-hover:text-white">$500 - $1,000</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="checkbox" class="accent-[var(--street-accent)] bg-[#222] border-white/20" />
                <span class="text-sm text-gray-400 group-hover:text-white">$1,000 - $2,000</span>
              </label>
              <label class="flex items-center gap-2 cursor-pointer group">
                <input type="checkbox" class="accent-[var(--street-accent)] bg-[#222] border-white/20" />
                <span class="text-sm text-gray-400 group-hover:text-white">Más de $2,000</span>
              </label>
            </div>
          </div>

          <!-- Banner Lateral -->
          <div class="bg-[#111] border border-white/10 text-white p-6 rounded-lg text-center space-y-4">
            <p class="font-black text-2xl text-[var(--street-accent)] uppercase">WILD CLUB</p>
            <p class="text-sm text-gray-400">Únete al club y obtén 10% de descuento en tu primera compra.</p>
            <button class="w-full bg-[var(--street-accent)] text-black font-bold py-2 text-xs uppercase tracking-widest hover:bg-white transition-colors">
              Suscribirse
            </button>
          </div>

        </aside>

        <!-- Main Content -->
        <main class="col-span-1 lg:col-span-9 space-y-8">
          
          <!-- Hero Carousel (Ofertas) -->
          <section class="relative h-[300px] md:h-[400px] rounded-2xl overflow-hidden group border border-white/10">
            <div class="absolute inset-0 flex transition-transform duration-500 ease-out" id="hero-slider">
              {carouselOffers.map(offer => (
                <div class="min-w-full h-full relative">
                  <img src={offer.image} class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-700" />
                  <div class="absolute inset-0 bg-gradient-to-r from-black via-black/50 to-transparent flex flex-col justify-center p-8 md:p-16">
                    <h2 class="text-4xl md:text-6xl font-black text-white uppercase leading-none mb-2" style="text-shadow: 2px 2px 0px black;">{offer.title}</h2>
                    <p class="text-xl md:text-2xl font-bold text-[var(--street-accent)] uppercase mb-6">{offer.subtitle}</p>
                    <button class="w-fit bg-white text-black px-8 py-3 font-black uppercase tracking-widest hover:bg-[var(--street-accent)] transition-colors text-sm shadow-[4px_4px_0px_black]">
                      {offer.cta}
                    </button>
                  </div>
                </div>
              ))}
            </div>
            <!-- Controles simples -->
            <button class="absolute left-4 top-1/2 -translate-y-1/2 bg-black/50 text-white p-2 rounded-full hover:bg-[var(--street-accent)] hover:text-black transition-colors opacity-0 group-hover:opacity-100 border border-white/20">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"></polyline></svg>
            </button>
            <button class="absolute right-4 top-1/2 -translate-y-1/2 bg-black/50 text-white p-2 rounded-full hover:bg-[var(--street-accent)] hover:text-black transition-colors opacity-0 group-hover:opacity-100 border border-white/20">
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"></polyline></svg>
            </button>
          </section>

          <!-- Sección: Ofertas en Tendencia (Horizontal Scroll) -->
          <section>
            <div class="flex justify-between items-end mb-6">
              <h2 class="text-2xl font-black uppercase tracking-tight text-white">Ofertas en Tendencia</h2>
              <a href="#" class="text-sm font-bold text-[var(--street-accent)] hover:underline uppercase">Ver todo</a>
            </div>
            
            <div class="flex gap-6 overflow-x-auto pb-6 snap-x scrollbar-hide">
              {products.filter(p => p.originalPrice).map(product => (
                <div class="min-w-[280px] snap-start bg-[#111] rounded-lg overflow-hidden border border-white/10 hover:border-[var(--street-accent)] transition-all duration-300 group hover:-translate-y-1">
                  <div class="relative h-[280px] bg-[#222] overflow-hidden">
                    <img src={product.image} class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-110 transition-all duration-500" />
                    {product.originalPrice && (
                      <div class="absolute top-2 left-2 bg-[var(--street-accent)] text-black text-xs font-black px-3 py-1.5 uppercase rounded-sm shadow-[4px_4px_0px_black] transform -rotate-2 z-20 border-2 border-black">
                        -{Math.round(((product.originalPrice - product.price) / product.originalPrice) * 100)}% OFF
                      </div>
                    )}
                    <button class="absolute top-2 right-2 w-8 h-8 bg-black/80 rounded-full flex items-center justify-center text-white hover:bg-[var(--street-accent)] hover:text-black transition-colors opacity-0 group-hover:opacity-100 shadow-lg border border-white/20 toggle-wishlist-btn" title="Añadir a Lista de Deseos" data-product={JSON.stringify(product)}>
                      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                    </button>
                  </div>
                  <div class="p-4 space-y-2">
                    <p class="text-xs text-gray-400 uppercase font-bold tracking-wider">{product.category}</p>
                    <h3 class="font-bold text-sm text-white leading-tight line-clamp-2 h-10 group-hover:text-[var(--street-accent)] transition-colors">{product.name}</h3>
                    <div class="flex items-baseline gap-2">
                      <span class="text-lg font-black text-white">${product.price}</span>
                      <span class="text-xs text-gray-500 line-through">${product.originalPrice}</span>
                    </div>
                    <div class="flex items-center gap-1">
                      <div class="flex text-[var(--street-accent)] text-xs">
                        {'★'.repeat(Math.floor(product.rating))}
                        {'☆'.repeat(5 - Math.floor(product.rating))}
                      </div>
                      <span class="text-xs text-gray-400">({product.reviews})</span>
                    </div>
                    <button class="w-full mt-2 bg-white text-black py-2 text-xs font-bold uppercase tracking-wider hover:bg-[var(--street-accent)] hover:text-black transition-colors rounded shadow-[2px_2px_0px_black] add-to-cart-btn" data-product={JSON.stringify(product)}>
                      Agregar
                    </button>
                  </div>
                </div>
              ))}
            </div>
          </section>

          <!-- Sección: Todos los Productos (Grid) -->
          <section>
            <div class="flex justify-between items-end mb-6">
              <h2 class="text-2xl font-black uppercase tracking-tight text-white">Catálogo Completo</h2>
              <div class="flex gap-2">
                <button class="p-2 bg-[#111] border border-white/20 rounded hover:border-[var(--street-accent)] text-white">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect></svg>
                </button>
                <button class="p-2 bg-[#111] border border-white/20 rounded hover:border-[var(--street-accent)] text-gray-500 hover:text-white">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                </button>
              </div>
            </div>

            <div class="grid grid-cols-2 md:grid-cols-3 xl:grid-cols-4 gap-6">
              {products.map(product => (
                <div class="bg-[#111] rounded-xl overflow-hidden border border-white/5 hover:border-[var(--street-accent)] transition-all duration-300 group flex flex-col h-full hover:-translate-y-2 hover:shadow-[0_10px_40px_-10px_rgba(0,0,0,0.8)] relative">
                  <!-- Efecto de brillo en hover -->
                  <div class="absolute inset-0 bg-gradient-to-tr from-white/0 via-white/0 to-white/5 opacity-0 group-hover:opacity-100 transition-opacity pointer-events-none z-10"></div>
                  
                  <div class="relative aspect-[4/5] bg-[#222] overflow-hidden">
                    <img src={product.image} class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-110 transition-all duration-700 ease-out" />
                    
                    <div class="absolute top-0 left-0 p-3 w-full flex justify-between items-start z-20">
                        {product.isBestSeller && (
                          <div class="bg-[var(--street-accent)] text-black text-[9px] font-black px-2 py-1 uppercase tracking-widest rounded-sm shadow-lg">
                            Top Seller
                          </div>
                        )}
                        {!product.isBestSeller && <div></div>} <!-- Spacer -->
                        
                        <button class="w-9 h-9 bg-black/40 backdrop-blur-md rounded-full flex items-center justify-center text-white hover:bg-[var(--street-accent)] hover:text-black transition-all transform hover:scale-110 border border-white/10 toggle-wishlist-btn" title="Añadir a Lista de Deseos" data-product={JSON.stringify(product)}>
                          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
                        </button>
                    </div>

                    {!product.inStock && (
                      <div class="absolute inset-0 bg-black/80 backdrop-blur-[2px] flex items-center justify-center z-20">
                        <div class="border-2 border-red-600 text-red-600 px-4 py-2 text-sm font-black uppercase tracking-[0.2em] -rotate-12">
                            Agotado
                        </div>
                      </div>
                    )}
                  </div>
                  
                  <div class="p-5 flex flex-col flex-grow relative z-20 bg-[#111]">
                    <div class="mb-3">
                        <p class="text-[10px] text-gray-500 uppercase font-bold tracking-[0.15em] mb-1">{product.category}</p>
                        <h3 class="font-black text-base text-white leading-tight line-clamp-2 group-hover:text-[var(--street-accent)] transition-colors">{product.name}</h3>
                    </div>
                    
                    <div class="mt-auto space-y-4">
                      <div class="flex items-end justify-between border-t border-white/5 pt-4">
                        <div class="flex flex-col">
                          <span class="text-xs text-gray-500 font-medium mb-0.5">Precio</span>
                          <div class="flex items-baseline gap-2">
                              <span class="text-xl font-black text-white tracking-tight">${product.price}</span>
                              {product.originalPrice && <span class="text-xs text-gray-600 line-through font-bold">${product.originalPrice}</span>}
                          </div>
                        </div>
                        <div class="flex items-center gap-1">
                          <span class="text-[var(--street-accent)] text-sm">★</span>
                          <span class="text-xs font-bold text-white">{product.rating}</span>
                        </div>
                      </div>
                      
                      <button 
                        class={`w-full py-3 text-[10px] font-black uppercase tracking-[0.2em] rounded-lg transition-all flex items-center justify-center gap-2 add-to-cart-btn group/btn overflow-hidden relative ${
                          product.inStock 
                          ? 'bg-white text-black hover:bg-[var(--street-accent)] hover:shadow-[0_0_20px_rgba(201,131,0,0.4)]' 
                          : 'bg-[#222] text-gray-600 cursor-not-allowed border border-white/5'
                        }`}
                        disabled={!product.inStock}
                        data-product={product.inStock ? JSON.stringify(product) : undefined}
                      >
                        <span class="relative z-10 flex items-center gap-2">
                            {product.inStock ? (
                                <>
                                    <span>Agregar</span>
                                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transform group-hover/btn:translate-x-1 transition-transform"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                                </>
                            ) : 'Sin Stock'}
                        </span>
                      </button>
                    </div>
                  </div>
                </div>
              ))}
            </div>
          </section>

        </main>
      </div>
    </div>
  </div>
</Layout>

<style define:vars={{ streetAccent: tenant.primary_color }}>
  :root {
    --street-accent: var(--streetAccent);
  }

  /* Ocultar barra de scroll en navegadores */
  .scrollbar-hide::-webkit-scrollbar {
    display: none;
  }
  .scrollbar-hide {
    -ms-overflow-style: none;
    scrollbar-width: none;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
</style>

<!-- Toast Notification -->
<div id="toast-notification" class="fixed top-24 right-4 z-50 transform translate-x-full transition-transform duration-300 ease-out">
  <div class="bg-black border-l-4 border-[var(--street-accent)] p-4 rounded shadow-2xl flex items-center gap-4 min-w-[300px]">
    <div class="w-12 h-12 bg-[#222] flex-shrink-0 overflow-hidden rounded">
      <img id="toast-image" src="" class="w-full h-full object-cover" />
    </div>
    <div class="flex-1">
      <p id="toast-message" class="text-[10px] font-black uppercase text-[var(--street-accent)] tracking-widest mb-1">YA ESTÁ EN TU CARRITO</p>
      <h4 id="toast-title" class="text-xs font-bold text-white line-clamp-1">Producto</h4>
      <p id="toast-price" class="text-xs text-gray-400 font-bold mt-1">$0.00</p>
    </div>
  </div>
</div>

<script>
  import { cartStore } from '../lib/cart.js';

  const showToast = (product: any, message: string) => {
    const toast = document.getElementById('toast-notification');
    const img = document.getElementById('toast-image');
    const msg = document.getElementById('toast-message');
    const title = document.getElementById('toast-title');
    const price = document.getElementById('toast-price');

    if (toast && img && msg && title && price) {
      img.setAttribute('src', product.image);
      msg.textContent = message;
      title.textContent = product.name;
      price.textContent = `$${product.price}`;

      toast.classList.remove('translate-x-full');
      setTimeout(() => {
        toast.classList.add('translate-x-full');
      }, 3000);
    }
  };

  const initShop = async () => {
    // Wait for cart store to be ready
    if (!cartStore.initialized) {
        await cartStore.init();
    }

    // --- 1. Initial State Render ---
    
    // Helper to update wishlist icon state
    const updateWishlistIcon = (btn: Element, isActive: boolean) => {
        const icon = btn.querySelector('svg');
        if (icon) {
            if (isActive) {
                icon.style.fill = 'currentColor';
                icon.style.color = 'var(--street-accent)';
                icon.classList.add('drop-shadow-[0_0_8px_var(--street-accent)]');
            } else {
                icon.style.fill = 'none';
                icon.style.color = 'white';
                icon.classList.remove('drop-shadow-[0_0_8px_var(--street-accent)]');
            }
        }
    };

    // Helper to check Cart State for buttons
    const updateCartButtonState = (btn: Element, isInCart: boolean) => {
        if (isInCart) {
            btn.innerHTML = `
                <span class="relative z-10 flex items-center gap-2 text-[var(--street-accent)]">
                    <span>EN TU CARRITO</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                </span>
            `;
            btn.classList.add('border-[var(--street-accent)]', 'bg-black');
            btn.classList.remove('bg-white', 'text-black');
        } else {
             // Reset to default state
             // Note: We need original logic to check stock, but for now assuming inStock if this runs
             btn.innerHTML = `
                <span class="relative z-10 flex items-center gap-2">
                    <span>AGREGAR</span>
                    <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" class="transform group-hover/btn:translate-x-1 transition-transform"><line x1="12" y1="5" x2="12" y2="19"></line><line x1="5" y1="12" x2="19" y2="12"></line></svg>
                </span>
             `;
             btn.classList.remove('border-[var(--street-accent)]', 'bg-black');
             btn.classList.add('bg-white', 'text-black');
        }
    };

    // Initialize Button States
    const syncButtons = () => {
        document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
            const productData = (btn as HTMLElement).dataset.product;
            if (productData) {
                try {
                    const product = JSON.parse(productData);
                    const isInCart = cartStore.isInCart(product.id);
                    updateCartButtonState(btn, isInCart);
                } catch(e) {}
            }
        });

        document.querySelectorAll('.toggle-wishlist-btn').forEach(btn => {
            const productData = (btn as HTMLElement).dataset.product;
            if (productData) {
                try {
                    const product = JSON.parse(productData);
                    const isInWishlist = cartStore.isInWishlist(product.id);
                    updateWishlistIcon(btn, isInWishlist);
                } catch(e) {}
            }
        });
    };

    syncButtons();

    // Listen for global updates to keep buttons in sync
    window.addEventListener('cart:updated', () => syncButtons());
    window.addEventListener('wishlist:updated', () => syncButtons());

    // --- 2. Event Listeners ---

    // Add to Cart Buttons
    document.querySelectorAll('.add-to-cart-btn').forEach(btn => {
      // Remove old listeners to avoid duplicates if re-running
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);
      
      newBtn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation();
        const targetBtn = e.currentTarget as HTMLElement;
        const productData = targetBtn.dataset.product;
        
        if (productData) {
          try {
            const product = JSON.parse(productData);
            
            // If already in cart, maybe just open cart? For now we just add more or ignore
            // Requirement says: "YA ESTÁ EN TU CARRITO" state.
            // If it is already in cart, the button state logic handles the text.
            // But if user clicks again, we can add +1 or show toast "Updated".
            
            cartStore.addToCart(product);
            showToast(product, "SE AGREGÓ A TU CARRITO");
            
          } catch (err) {
            console.error('Error adding to cart:', err);
          }
        }
      });
    });

    // Toggle Wishlist Buttons
    document.querySelectorAll('.toggle-wishlist-btn').forEach(btn => {
      // Remove old listeners
      const newBtn = btn.cloneNode(true);
      btn.parentNode?.replaceChild(newBtn, btn);

      newBtn.addEventListener('click', async (e) => {
        e.preventDefault();
        e.stopPropagation();
        const targetBtn = e.currentTarget as HTMLElement;
        const productData = targetBtn.dataset.product;
        
        if (productData) {
          try {
            const product = JSON.parse(productData);
            
            // Add bounce animation
            targetBtn.classList.add('scale-125');
            setTimeout(() => targetBtn.classList.remove('scale-125'), 200);

            const isAdded = await cartStore.toggleWishlist(product);
             
            if (isAdded) {
                showToast(product, "SE AGREGÓ A TU WISHLIST");
            } else {
                // Removed
            }

           } catch (err) {
             console.error('Error toggling wishlist:', err);
           }
         }
       });
     });
  };

  // Init on load and after swap
  initShop();
  document.addEventListener('astro:after-swap', initShop);
</script>
