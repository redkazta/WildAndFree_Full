---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Honor & Free",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};

const honorAndFreeData = [
    { 
        name: "MC LÁSER", 
        multiplier: "x1.5", 
        points: 450, 
        history: ["2026-02-15: +50pts (Ganador)", "2026-02-08: +30pts (Finalista)", "2026-02-01: +20pts (Asistencia)"], 
        image: "https://images.unsplash.com/photo-1570295999919-56ceb5ecca61?w=400&h=400&fit=crop",
        bio: "Campeón indiscutible de la temporada 2025. Conocido por su flow agresivo y punchlines directos. Representando a Torreón.",
        fullHistory: [
            { event: "Torneo de Verano '25", result: "Campeón", points: 1000 },
            { event: "Batalla del Desierto", result: "Semifinalista", points: 500 },
            { event: "Liga Invernal", result: "Campeón", points: 1200 }
        ]
    },
    { 
        name: "D-MENTE", 
        multiplier: "x1.2", 
        points: 380, 
        history: ["2026-02-15: +30pts (Finalista)", "2026-02-08: +50pts (Ganador)"], 
        image: "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=400&h=400&fit=crop",
        bio: "El estratega del verso. D-Mente destaca por sus métricas complejas y respuestas al momento. Representando a Gómez Palacio.",
        fullHistory: [
            { event: "Torneo de Verano '25", result: "Subcampeón", points: 800 },
            { event: "Batalla del Desierto", result: "Campeón", points: 1000 }
        ]
    },
    { 
        name: "K-ROAD", 
        multiplier: "x1.0", 
        points: 310, 
        history: ["2026-02-15: +10pts (Semis)", "2026-02-08: +10pts (Semis)"], 
        image: "https://images.unsplash.com/photo-1527980965255-d3b416303d12?w=400&h=400&fit=crop",
        bio: "La nueva sangre. K-Road ha subido rápidamente en los rankings gracias a su carisma y puesta en escena.",
        fullHistory: [
            { event: "Rookie del Año '25", result: "Ganador", points: 500 }
        ]
    },
    { 
        name: "ZIKO", 
        multiplier: "x1.0", 
        points: 290, 
        history: ["2026-02-15: +10pts (Semis)", "2026-02-01: +50pts (Ganador)"], 
        image: "https://images.unsplash.com/photo-1633332755192-727a05c4013d?w=400&h=400&fit=crop",
        bio: "Veterano de mil batallas. Ziko mantiene el estilo clásico del boom bap en sus improvisaciones.",
        fullHistory: [
            { event: "Leyendas Urbanas", result: "Cuartos", points: 300 }
        ]
    },
    // Mock data extra para llenar la tabla
    { name: "SHADOW", multiplier: "x1.0", points: 250, history: [], image: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=400&h=400&fit=crop", bio: "Rising star.", fullHistory: [] },
    { name: "BLAZE", multiplier: "x1.0", points: 200, history: [], image: "https://images.unsplash.com/photo-1531384441138-2736e62e0919?w=400&h=400&fit=crop", bio: "Fuego puro.", fullHistory: [] },
    { name: "VENOM", multiplier: "x1.0", points: 180, history: [], image: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=400&h=400&fit=crop", bio: "Letal.", fullHistory: [] },
    { name: "FROST", multiplier: "x1.0", points: 150, history: [], image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&fit=crop", bio: "Frío como el hielo.", fullHistory: [] },
];
---

<Layout config={config}>
  <div class="min-h-screen bg-[#050505] text-white pb-32 selection:bg-[var(--wild-orange)] selection:text-black font-sans">
    
    <!-- Top Bar Minimal -->
    <div class="bg-black border-b border-white/10 py-2 sticky top-0 z-50">
        <div class="container mx-auto px-4 max-w-[1800px] flex justify-between items-center">
            <div class="flex items-center gap-2">
                <div class="w-2 h-2 bg-[var(--wild-orange)] rounded-full animate-pulse"></div>
                <span class="text-[10px] font-black uppercase tracking-[0.2em] text-white">Wild Music OS v3.2</span>
            </div>
            <div class="flex gap-4 text-[10px] font-mono text-gray-500">
                <span>ESTADO: CONECTADO</span>
                <span>ZONA: GLOBAL</span>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4 py-12 max-w-[1800px] animate-fade-in-up space-y-16">
        
        <!-- Header Page -->
        <div class="flex flex-col md:flex-row justify-between items-end border-b border-white/10 pb-8 gap-6">
            <div>
                <div class="flex items-center gap-3 mb-2">
                    <span class="bg-red-600 text-white text-[10px] font-black px-2 py-1 uppercase tracking-widest animate-pulse">En Vivo</span>
                    <span class="text-[var(--wild-orange)] text-xs font-mono uppercase tracking-widest">Temporada 2026</span>
                </div>
                <h1 class="text-6xl md:text-8xl font-black uppercase tracking-tighter leading-none text-white">Honor <span class="text-transparent bg-clip-text bg-gradient-to-r from-white to-gray-500">&</span> Free</h1>
            </div>
            <div class="text-right">
                <p class="text-gray-400 text-sm max-w-md font-medium">
                    La tabla oficial de puntos de la liga de freestyle más salvaje del norte. Aquí se forjan las leyendas.
                </p>
            </div>
        </div>

        <!-- Tabla Principal -->
        <div class="grid grid-cols-1 gap-4">
            <!-- Header Tabla (Desktop) -->
            <div class="hidden md:grid grid-cols-12 gap-4 px-6 py-3 bg-white/5 text-[10px] font-bold text-gray-400 uppercase tracking-widest rounded-t-xl">
                <div class="col-span-1">#</div>
                <div class="col-span-4">Freestyler</div>
                <div class="col-span-2 text-center">Multiplicador</div>
                <div class="col-span-3">Última Actividad</div>
                <div class="col-span-2 text-right">Puntos Totales</div>
            </div>

            <!-- Filas -->
            <div class="space-y-2">
                {honorAndFreeData.map((mc, i) => (
                    <div class="freestyler-card group bg-[#111] border border-white/10 rounded-xl p-4 md:px-6 md:py-4 hover:border-[var(--wild-orange)] hover:bg-white/5 transition-all cursor-pointer" data-freestyler={JSON.stringify(mc)}>
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-4 items-center">
                            <!-- Rank & Info -->
                            <div class="col-span-1 md:col-span-1 flex items-center gap-2">
                                <span class={`text-2xl font-black font-mono ${i < 3 ? 'text-[var(--wild-orange)]' : 'text-gray-600'}`}>{(i + 1).toString().padStart(2, '0')}</span>
                            </div>
                            
                            <div class="col-span-1 md:col-span-4 flex items-center gap-4">
                                <div class="relative w-12 h-12 md:w-16 md:h-16 rounded-full overflow-hidden border-2 border-transparent group-hover:border-[var(--wild-orange)] transition-colors">
                                    <img src={mc.image} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all" />
                                </div>
                                <div>
                                    <h3 class="text-xl font-black text-white uppercase italic leading-none group-hover:text-[var(--wild-orange)] transition-colors">{mc.name}</h3>
                                    <span class="text-[10px] text-gray-500 font-mono uppercase">Torreón, MX</span>
                                </div>
                            </div>

                            <!-- Stats -->
                            <div class="col-span-1 md:col-span-2 flex md:justify-center items-center gap-2">
                                <span class="md:hidden text-[10px] text-gray-500 uppercase font-bold">Mult:</span>
                                <span class="bg-black/50 border border-white/10 px-3 py-1 rounded text-xs font-mono text-[var(--wild-orange)]">{mc.multiplier}</span>
                            </div>

                            <div class="col-span-1 md:col-span-3">
                                <div class="text-[10px] text-gray-400 uppercase truncate">
                                    {mc.history[0] || "Sin actividad reciente"}
                                </div>
                            </div>

                            <div class="col-span-1 md:col-span-2 text-left md:text-right">
                                <span class="block text-3xl font-black text-white leading-none">{mc.points}</span>
                                <span class="text-[9px] text-gray-500 uppercase tracking-widest">Puntos</span>
                            </div>
                        </div>
                        
                        <!-- Mobile Details (Expander) -->
                        <div class="mt-4 md:hidden border-t border-white/10 pt-4">
                            <details class="group/details">
                                <summary class="cursor-pointer text-[10px] font-black uppercase text-gray-400 hover:text-white flex items-center justify-between p-2 bg-black/50 rounded select-none">
                                    <span>Ver Historial Detallado</span>
                                    <svg class="w-4 h-4 transition-transform group-open/details:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                                </summary>
                                <div class="mt-2 pl-2 border-l border-white/10 space-y-1">
                                    {mc.history.map(entry => (
                                        <p class="text-[9px] font-mono text-gray-500 uppercase">{entry}</p>
                                    ))}
                                </div>
                            </details>
                        </div>
                    </div>
                ))}
            </div>
        </div>

    </div>

    <!-- MODAL DE FREESTYLER -->
    <dialog id="freestyler-modal" class="bg-transparent p-0 backdrop:bg-black/90 w-full max-w-4xl m-auto open:animate-fade-in-up outline-none">
        <div class="bg-[#0a0a0a] border border-white/20 rounded-2xl overflow-hidden shadow-2xl flex flex-col md:flex-row max-h-[90vh]">
            <!-- Sidebar Imagen -->
            <div class="md:w-1/3 relative min-h-[300px]">
                <img id="modal-image" src="" class="absolute inset-0 w-full h-full object-cover" />
                <div class="absolute inset-0 bg-gradient-to-t from-[#0a0a0a] via-transparent to-transparent md:bg-gradient-to-r"></div>
                <div class="absolute bottom-0 left-0 p-6 z-10">
                    <h2 id="modal-name" class="text-5xl font-black text-white uppercase italic tracking-tighter leading-none drop-shadow-lg">NAME</h2>
                    <div class="mt-2 flex gap-2">
                        <span class="bg-[var(--wild-orange)] text-black text-[10px] font-black px-2 py-0.5 uppercase rounded">Pro</span>
                        <span class="bg-white text-black text-[10px] font-black px-2 py-0.5 uppercase rounded">Top 10</span>
                    </div>
                </div>
            </div>
            
            <!-- Contenido -->
            <div class="md:w-2/3 p-8 md:p-12 overflow-y-auto bg-[#0a0a0a]">
                <div class="flex justify-between items-start mb-8">
                    <div>
                        <h3 class="text-xs font-black uppercase text-gray-500 tracking-[0.2em] mb-2">Biografía</h3>
                        <p id="modal-bio" class="text-gray-300 text-sm leading-relaxed font-medium"></p>
                    </div>
                    <button id="close-modal" class="text-gray-500 hover:text-white p-2 hover:bg-white/10 rounded-full transition-colors">
                        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                    </button>
                </div>

                <h3 class="text-xs font-black uppercase text-[var(--wild-orange)] tracking-[0.2em] mb-4 border-b border-white/10 pb-2">Historial de Torneo</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="text-[10px] font-black uppercase text-gray-500">
                                <th class="pb-4">Evento</th>
                                <th class="pb-4">Resultado</th>
                                <th class="pb-4 text-right">Puntos</th>
                            </tr>
                        </thead>
                        <tbody id="modal-history-body" class="divide-y divide-white/5 text-sm">
                            <!-- JS populated -->
                        </tbody>
                    </table>
                </div>
                
                <div class="mt-12 flex gap-4">
                     <button class="flex-1 bg-white text-black font-black uppercase py-4 text-xs rounded hover:bg-[var(--wild-orange)] transition-colors tracking-widest">Ver Perfil Completo</button>
                     <button class="flex-1 border border-white/20 text-white font-black uppercase py-4 text-xs rounded hover:bg-white hover:text-black transition-colors tracking-widest">Seguir</button>
                </div>
            </div>
        </div>
    </dialog>

  </div>
</Layout>

<style is:global define:vars={{ streetAccent: tenant.primary_color }}>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.6s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
  
  /* Scrollbar para modal content */
  .overflow-y-auto::-webkit-scrollbar {
      width: 6px;
  }
  .overflow-y-auto::-webkit-scrollbar-track {
      background: #111;
  }
  .overflow-y-auto::-webkit-scrollbar-thumb {
      background: #333;
      border-radius: 3px;
  }
  .overflow-y-auto::-webkit-scrollbar-thumb:hover {
      background: var(--wild-orange);
  }
</style>

<script>
   // Freestyler Modal Logic
   const modal = document.getElementById('freestyler-modal') as HTMLDialogElement;
   const closeModalBtn = document.getElementById('close-modal');
   const triggers = document.querySelectorAll('.freestyler-card'); // Click en toda la tarjeta en desktop

   if (modal && closeModalBtn) {
       triggers.forEach(trigger => {
           trigger.addEventListener('click', (e) => {
               // Si es click en el details/summary (mobile), no abrir modal
               if ((e.target as HTMLElement).closest('summary') || (e.target as HTMLElement).closest('details')) {
                   return;
               }

               const data = JSON.parse((trigger as HTMLElement).dataset.freestyler || '{}');
               
               // Populate
               const nameEl = document.getElementById('modal-name');
               const bioEl = document.getElementById('modal-bio');
               const imgEl = document.getElementById('modal-image') as HTMLImageElement;
               const historyBody = document.getElementById('modal-history-body');
               
               if (nameEl) nameEl.textContent = data.name;
               if (bioEl) bioEl.textContent = data.bio || 'Sin biografía disponible.';
               if (imgEl) imgEl.src = data.image;
               
               if (historyBody && data.fullHistory) {
                   historyBody.innerHTML = data.fullHistory.map((h: any) => `
                       <tr class="hover:bg-white/5 transition-colors">
                           <td class="py-3 font-bold text-white uppercase">${h.event}</td>
                           <td class="py-3 text-gray-400 uppercase font-mono text-xs">${h.result}</td>
                           <td class="py-3 text-right font-mono text-[var(--wild-orange)] font-bold">+${h.points}</td>
                       </tr>
                   `).join('');
               } else if (historyBody) {
                   historyBody.innerHTML = '<tr><td colspan="3" class="py-8 text-center text-gray-500 text-xs italic">No hay historial disponible para este MC.</td></tr>';
               }
 
               modal.showModal();
           });
       });
 
       closeModalBtn.addEventListener('click', () => {
           modal.close();
       });
 
       modal.addEventListener('click', (e) => {
           const rect = modal.getBoundingClientRect();
           const isInDialog = (rect.top <= e.clientY && e.clientY <= rect.top + rect.height &&
             rect.left <= e.clientX && e.clientX <= rect.left + rect.width);
           // Nota: el dialog ocupa toda la pantalla con backdrop, pero el contenido es el div hijo.
           // Detectar click fuera del contenido interno.
           // Mejor approach para dialog nativo:
           if (e.target === modal) {
               modal.close();
           }
       });
   }
</script>