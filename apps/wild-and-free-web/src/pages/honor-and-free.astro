---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Honor & Free",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};

const honorAndFreeData = [
    { id: 1, name: "MC LÃSER", points: 450, wins: 15, kos: 12, image: "https://images.unsplash.com/photo-1570295999919-56ceb5ecca61?w=200&h=200&fit=crop", origin: "Torreón" },
    { id: 2, name: "D-MENTE", points: 380, wins: 12, kos: 8, image: "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=200&h=200&fit=crop", origin: "Gómez" },
    { id: 3, name: "K-ROAD", points: 310, wins: 10, kos: 5, image: "https://images.unsplash.com/photo-1527980965255-d3b416303d12?w=200&h=200&fit=crop", origin: "Lerdo" },
    { id: 4, name: "ZIKO", points: 290, wins: 9, kos: 20, image: "https://images.unsplash.com/photo-1633332755192-727a05c4013d?w=200&h=200&fit=crop", origin: "Matamoros" },
    { id: 5, name: "SHADOW", points: 250, wins: 8, kos: 3, image: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=200&h=200&fit=crop", origin: "Torreón" },
    { id: 6, name: "BLAZE", points: 200, wins: 6, kos: 4, image: "https://images.unsplash.com/photo-1531384441138-2736e62e0919?w=200&h=200&fit=crop", origin: "San Pedro" },
    { id: 7, name: "VENOM", points: 180, wins: 5, kos: 6, image: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=200&h=200&fit=crop", origin: "Torreón" },
    { id: 8, name: "FROST", points: 150, wins: 4, kos: 1, image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=200&h=200&fit=crop", origin: "Gómez" },
];
---

<Layout config={config}>
  min-h-screen pb-section-lg font-body selection:bg-wild-orange selection:text-black

    <!-- Top Bar -->
    <div class="bg-[var(--bg)] border-b border-[var(--border)] py-2 sticky top-0 z-50">
        <div class="container mx-auto px-4 max-w-content flex justify-between items-center">
            <div class="flex items-center gap-2">
                <div class="w-1.5 h-1.5 bg-wild-orange rounded-full animate-pulse"></div>
                <span class="text-label-sm font-black text-[var(--text)]">Ranking Oficial</span>
            </div>
            <span class="text-label-sm font-mono text-[var(--text-muted)]">SEASON 2026</span>
        </div>
    </div>

    <div class="container mx-auto px-4 py-section max-w-content animate-fade-in-up space-y-section">

        <!-- Header Minimal -->
        <div class="text-center space-y-2">
            <h1 class="text-display-lg font-black uppercase tracking-tighter text-[var(--text)]">
                Honor <span class="text-wild-orange">&</span> Free
            </h1>
            <p class="text-label font-bold text-[var(--text-muted)] uppercase">
                Tabla General de Posiciones
            </p>
        </div>

        <!-- Leaderboard List -->
        <div class="space-y-1">
            {honorAndFreeData.map((mc, i) => (
                <div class="group relative flex items-center justify-between p-4 bg-neutral-950 border-b border-[var(--border)] hover:bg-[var(--bg)] transition-all duration-wild overflow-hidden cursor-pointer">

                    <!-- Hover Accent -->
                    <div class="absolute left-0 top-0 bottom-0 w-1 bg-wild-orange transform -translate-x-full group-hover:translate-x-0 transition-transform duration-wild"></div>

                    <!-- Rank & Avatar -->
                    <div class="flex items-center gap-6 relative z-10">
                        <span class={`text-xl font-mono font-bold w-8 text-center ${i < 3 ? 'text-wild-orange' : 'text-gray-700'}`}>
                            {(i + 1).toString().padStart(2, '0')}
                        </span>

                        <div class="flex items-center gap-4">
                            <img src={mc.image} width="40" height="40" class="w-10 h-10 rounded-full object-cover grayscale group-hover:grayscale-0 transition-all border border-[var(--border)] group-hover:border-wild-orange" />
                            <div>
                                <h3 class="text-lg font-black text-[var(--text)] uppercase tracking-tight leading-none group-hover:tracking-wide transition-all">{mc.name}</h3>
                                <p class="text-label-sm text-[var(--text-muted)] uppercase font-mono">{mc.origin} • {mc.wins}W / {mc.kos}KO</p>
                            </div>
                        </div>
                    </div>

                    <!-- Points -->
                    <div class="text-right relative z-10">
                        <span class="block text-2xl font-black text-[var(--text)] leading-none group-hover:text-wild-orange transition-colors duration-wild">{mc.points}</span>
                        <span class="text-label-sm text-[var(--text-muted)] uppercase tracking-widest">PTS</span>
                    </div>

                    <!-- Background Gradient on Hover -->
                    <div class="absolute inset-0 bg-gradient-to-r from-transparent via-transparent to-wild-orange/5 opacity-0 group-hover:opacity-100 transition-opacity duration-wild-slow"></div>
                </div>
            ))}
        </div>

        <!-- Top 3 Showcase (Bottom) -->
        <div class="pt-8 border-t border-[var(--border)]">
            <h3 class="text-label-sm font-black text-[var(--text-muted)] uppercase tracking-widest mb-6 text-center">Podio Actual</h3>
            <div class="flex justify-center items-end gap-4">
                <!-- 2nd Place -->
                <div class="flex flex-col items-center gap-2 opacity-60 hover:opacity-100 transition-opacity duration-wild">
                    <img src={honorAndFreeData[1].image} width="64" height="64" class="w-16 h-16 rounded-full border-2 border-gray-400 object-cover" />
                    <div class="text-center">
                        <span class="block text-xs font-black text-[var(--text)]">{honorAndFreeData[1].name}</span>
                        <span class="block text-label-sm font-mono text-[var(--text-muted)]">#2</span>
                    </div>
                </div>
                <!-- 1st Place -->
                <div class="flex flex-col items-center gap-2 -translate-y-4">
                    <div class="relative">
                        <img src={honorAndFreeData[0].image} width="96" height="96" class="w-24 h-24 rounded-full border-4 border-wild-orange object-cover shadow-wild-glow" />
                        <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-wild-orange text-black text-label-sm font-black px-2 py-0.5 rounded-full uppercase">King</div>
                    </div>
                    <div class="text-center">
                        <span class="block text-sm font-black text-wild-orange">{honorAndFreeData[0].name}</span>
                        <span class="block text-label-sm font-mono text-[var(--text-muted)]">#1</span>
                    </div>
                </div>
                <!-- 3rd Place -->
                <div class="flex flex-col items-center gap-2 opacity-60 hover:opacity-100 transition-opacity duration-wild">
                    <img src={honorAndFreeData[2].image} width="64" height="64" class="w-16 h-16 rounded-full border-2 border-amber-700 object-cover" />
                    <div class="text-center">
                        <span class="block text-xs font-black text-[var(--text)]">{honorAndFreeData[2].name}</span>
                        <span class="block text-label-sm font-mono text-[var(--text-muted)]">#3</span>
                    </div>
                </div>
            </div>
        </div>

    </div>
  </div>
</Layout>
