---
import Layout from '../layouts/Layout.astro';
import { getArtistsFromDB } from '../data/artists';
import type { Artist } from '../data/artists';

const config = {
  name: "Wild Gvng - Artista",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
};

const url = new URL(Astro.request.url);
const slug = url.searchParams.get('') || '';

const artists = await getArtistsFromDB();
const artist = artists.find(a => a.slug === slug) || artists[0];

const socialIcons: Record<string, string> = {
  instagram: '📸',
  spotify: '🎵',
  youtube: '▶️',
  tiktok: '🎭',
  twitter: '🐦',
  soundcloud: '☁️',
};
---

<Layout config={config}>
  <div class="artist-page">

    <!-- ═══ HERO ═══ -->
    <div class="hero">
      <div class="hero-grid"></div>
      <div class="hero-glow hero-glow-1"></div>
      <div class="hero-glow hero-glow-2"></div>
      <div class="hero-noise"></div>
    </div>

    <!-- ═══ BLOG HEADER ═══ -->
    <div class="blog-container">
      <header class="blog-header">
        <div class="avatar-column">
          <div class="avatar-wrapper">
            <img src={artist.imagenes.profile} alt={artist.nombre} class="avatar-img" />
            <div class="avatar-ring"></div>
            <div class="avatar-glow"></div>
          </div>
        </div>
        <div class="info-column">
          <div class="name-row">
            <h1 class="artist-name">{artist.nombre}</h1>
            <span class="verified-badge">✓</span>
          </div>
          <div class="genre-tags">
            {artist.estilo.split(' / ').map(g => (
              <span class="genre-tag">{g}</span>
            ))}
          </div>
          <span class="origin">📍 {artist.origen}</span>

          <!-- Stats inline -->
          <div class="stats-row">
            <div class="stat">
              <span class="stat-value">{artist.stats.partnean}</span>
              <span class="stat-label">Partnean</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat">
              <span class="stat-value">{artist.stats.oyentes}</span>
              <span class="stat-label">Oyentes</span>
            </div>
            <div class="stat-divider"></div>
            <div class="stat">
              <span class="stat-value">{artist.tracks.length}</span>
              <span class="stat-label">Tracks</span>
            </div>
          </div>

          <!-- Actions -->
          <div class="actions-row">
            <button class="btn-action btn-partnear" id="partnear-btn">
              <span class="btn-icon">🔥</span>
              <span class="btn-text">PARTNEAR</span>
            </button>
            <button class="btn-action btn-share" id="share-btn">
              <span class="btn-icon">🔗</span>
              <span class="btn-text">COMPARTIR</span>
            </button>
          </div>
        </div>
      </header>

      <!-- ═══ BIO ═══ -->
      {artist.bio && (
        <section class="content-block">
          <h2 class="section-label">SOBRE MÍ</h2>
          <p class="bio-text">{artist.bio}</p>
        </section>
      )}

      <!-- ═══ FEED ═══ -->
      <section class="content-block feed-section">
        <h2 class="section-label">FEED</h2>
        <div class="feed-list">
          <article class="feed-post">
            <div class="post-header">
              <img src={artist.imagenes.profile} alt={artist.nombre} class="post-avatar" />
              <div class="post-meta">
                <span class="post-author">{artist.nombre}</span>
                <span class="post-date">Hace 2 horas</span>
              </div>
              <span class="post-type">📝 Texto</span>
            </div>
            <p class="post-body">Nuevo track en proceso 🔥 Estuvo brutal la sesión de grabación ayer. Pronto les llega.</p>
            <div class="post-actions">
              <button class="post-action">🔥 24</button>
              <button class="post-action">💬 8</button>
              <button class="post-action">↗️ Compartir</button>
            </div>
          </article>

          <article class="feed-post">
            <div class="post-header">
              <img src={artist.imagenes.profile} alt={artist.nombre} class="post-avatar" />
              <div class="post-meta">
                <span class="post-author">{artist.nombre}</span>
                <span class="post-date">Hace 1 día</span>
              </div>
              <span class="post-type">📸 Foto</span>
            </div>
            <p class="post-body">Del bosque al escenario. Torreón siempreRepresentando 🏜️</p>
            <div class="post-image">
              <img src="https://images.unsplash.com/photo-1519681393784-d120267933ba?w=600&q=80" alt="Post image" loading="lazy" />
            </div>
            <div class="post-actions">
              <button class="post-action">🔥 67</button>
              <button class="post-action">💬 12</button>
              <button class="post-action">↗️ Compartir</button>
            </div>
          </article>

          <article class="feed-post">
            <div class="post-header">
              <img src={artist.imagenes.profile} alt={artist.nombre} class="post-avatar" />
              <div class="post-meta">
                <span class="post-author">{artist.nombre}</span>
                <span class="post-date">Hace 3 días</span>
              </div>
              <span class="post-type">🎵 Música</span>
            </div>
            <p class="post-body">"Noche de Arena" ya disponible en todas las plataformas 🎧 Link en bio.</p>
            <div class="post-embed">
              <div class="embed-placeholder">
                <span class="embed-icon">🎵</span>
                <span class="embed-text">Noche de Arena - {artist.nombre}</span>
              </div>
            </div>
            <div class="post-actions">
              <button class="post-action">🔥 112</button>
              <button class="post-action">💬 31</button>
              <button class="post-action">↗️ Compartir</button>
            </div>
          </article>
        </div>
      </section>

      <!-- ═══ CONTENT GRID ═══ -->
      <div class="content-grid">

        <!-- MUSIC COLUMN -->
        <div class="content-col">
          {artist.tracks.length > 0 && (
            <section class="content-block">
              <h2 class="section-label">MÚSICA</h2>
              <div class="tracks-list">
                {artist.tracks.map((track, i) => (
                  <div class="track-row">
                    <span class="track-num">{String(i + 1).padStart(2, '0')}</span>
                    <div class="track-info">
                      <span class="track-title">{track.title}</span>
                      <span class="track-dur">{track.duration}</span>
                    </div>
                    {track.spotify_url ? (
                      <a href={track.spotify_url} target="_blank" rel="noopener" class="track-play" title="Escuchar en Spotify">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                      </a>
                    ) : (
                      <button class="track-play" disabled>
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                      </button>
                    )}
                  </div>
                ))}
              </div>
            </section>
          )}

          <!-- SOCIAL LINKS -->
          {artist.redes && Object.keys(artist.redes).length > 0 && (
            <section class="content-block">
              <h2 class="section-label">REDES</h2>
              <div class="social-list">
                {Object.entries(artist.redes).map(([platform, link]) => (
                  <a href={link} target="_blank" rel="noopener" class="social-row">
                    <span class="social-icon">{socialIcons[platform.toLowerCase()] || '🔗'}</span>
                    <span class="social-name">{platform}</span>
                    <span class="social-arrow">→</span>
                  </a>
                ))}
              </div>
            </section>
          )}
        </div>

        <!-- EVENTS + SHARE COLUMN -->
        <div class="content-col">
          <section class="content-block">
            <h2 class="section-label">PRÓXIMOS EVENTOS</h2>
            <div class="event-card">
              <div class="event-date-box">
                <span class="event-day">15</span>
                <span class="event-month">JUL</span>
              </div>
              <div class="event-details">
                <span class="event-name">Freestyle Friday</span>
                <span class="event-loc">📍 Bosque Venustiano Carranza</span>
              </div>
              <a href="https://maps.google.com" target="_blank" class="event-maps">MAPS →</a>
            </div>
            <p class="events-empty">Más eventos próximamente...</p>
          </section>

          <!-- SHARE -->
          <section class="content-block">
            <h2 class="section-label">COMPARTIR PERFIL</h2>
            <div class="share-box">
              <code class="share-url">www.wildgvng.com.mx/artista?={artist.slug}</code>
              <button class="share-copy" id="copy-url-btn">COPIAR</button>
            </div>
          </section>
        </div>
      </div>

      <!-- ═══ BACK LINK ═══ -->
      <div class="back-section">
        <a href="/artistas" class="back-link">← VOLVER AL ROSTER</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ===== PAGE ===== */
  .artist-page {
    min-height: 100vh;
    background: #0a0a0a;
    overflow-x: hidden;
  }
  .blog-container {
    max-width: 1000px;
    margin: 0 auto;
    padding: 0 24px 80px;
  }

  /* ===== HERO ===== */
  .hero {
    position: relative;
    height: 200px;
    overflow: hidden;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(255,255,255,0.02) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.02) 1px, transparent 1px);
    background-size: 60px 60px;
  }
  .hero-glow {
    position: absolute;
    border-radius: 50%;
    filter: blur(120px);
    animation: pulse 4s ease-in-out infinite;
  }
  .hero-glow-1 {
    top: 10%;
    left: 30%;
    width: 400px;
    height: 400px;
    background: rgba(201,131,0,0.08);
  }
  .hero-glow-2 {
    bottom: 0;
    right: 20%;
    width: 300px;
    height: 300px;
    background: rgba(201,131,0,0.04);
    animation-delay: 1s;
  }
  .hero-noise {
    position: absolute;
    inset: 0;
    opacity: 0.08;
    background: url('https://www.transparenttextures.com/patterns/stardust.png');
    mix-blend-mode: overlay;
  }

  /* ===== BLOG HEADER ===== */
  .blog-header {
    display: flex;
    gap: 40px;
    align-items: flex-start;
    margin-top: -60px;
    position: relative;
    z-index: 10;
  }
  .avatar-column {
    flex-shrink: 0;
  }
  .info-column {
    flex: 1;
    padding-top: 8px;
  }

  /* Avatar */
  .avatar-wrapper {
    position: relative;
    width: 180px;
    height: 180px;
    border-radius: 24px;
    overflow: hidden;
  }
  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: relative;
    z-index: 2;
  }
  .avatar-ring {
    position: absolute;
    inset: -3px;
    border-radius: 27px;
    border: 3px solid rgba(201,131,0,0.5);
    z-index: 1;
  }
  .avatar-glow {
    position: absolute;
    inset: -20px;
    border-radius: 40px;
    background: radial-gradient(circle, rgba(201,131,0,0.2) 0%, transparent 70%);
    z-index: 0;
    filter: blur(15px);
  }

  /* Name */
  .name-row {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .artist-name {
    font-size: 2.4rem;
    font-weight: 900;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0;
    line-height: 1;
  }
  .verified-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 30px;
    height: 30px;
    border-radius: 50%;
    background: linear-gradient(135deg, #C98300, #f59e0b);
    color: #000;
    font-size: 0.75rem;
    font-weight: 900;
    flex-shrink: 0;
  }
  .genre-tags {
    display: flex;
    gap: 8px;
    margin-top: 12px;
    flex-wrap: wrap;
  }
  .genre-tag {
    padding: 5px 14px;
    border-radius: 100px;
    font-size: 0.6rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    background: rgba(201,131,0,0.12);
    border: 1px solid rgba(201,131,0,0.25);
    color: #C98300;
    font-family: monospace;
  }
  .origin {
    display: block;
    margin-top: 8px;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.35);
  }

  /* Stats */
  .stats-row {
    display: flex;
    align-items: center;
    gap: 24px;
    margin-top: 20px;
    padding: 16px 24px;
    border-radius: 14px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    width: fit-content;
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .stat-value {
    font-size: 1.3rem;
    font-weight: 900;
    color: #fff;
  }
  .stat-label {
    font-size: 0.55rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.3);
  }
  .stat-divider {
    width: 1px;
    height: 28px;
    background: rgba(255,255,255,0.08);
  }

  /* Actions */
  .actions-row {
    display: flex;
    gap: 10px;
    margin-top: 16px;
  }
  .btn-action {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 20px;
    border-radius: 12px;
    font-size: 0.6rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: inherit;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.04);
    color: rgba(255,255,255,0.5);
  }
  .btn-action:hover {
    border-color: rgba(201,131,0,0.4);
    color: #C98300;
    background: rgba(201,131,0,0.08);
    transform: translateY(-2px);
  }
  .btn-action.active {
    background: rgba(201,131,0,0.15);
    border-color: rgba(201,131,0,0.5);
    color: #C98300;
  }
  .btn-icon { font-size: 0.9rem; }

  /* ===== CONTENT BLOCKS ===== */
  .content-block {
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .section-label {
    font-size: 0.6rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: rgba(255,255,255,0.25);
    font-family: monospace;
    margin: 0 0 16px;
  }
  .bio-text {
    font-size: 1rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.8;
    margin: 0;
  }

  /* ===== FEED ===== */
  .feed-section {
    border-top: none;
    padding-top: 0;
    margin-top: 32px;
  }
  .feed-list {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .feed-post {
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
    border-radius: 16px;
    padding: 20px;
    transition: border-color 0.2s;
  }
  .feed-post:hover {
    border-color: rgba(201,131,0,0.15);
  }
  .post-header {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 14px;
  }
  .post-avatar {
    width: 36px;
    height: 36px;
    border-radius: 10px;
    object-fit: cover;
    flex-shrink: 0;
  }
  .post-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
  }
  .post-author {
    font-size: 0.8rem;
    font-weight: 800;
    color: #fff;
  }
  .post-date {
    font-size: 0.6rem;
    color: rgba(255,255,255,0.3);
    font-family: monospace;
  }
  .post-type {
    font-size: 0.6rem;
    font-weight: 700;
    color: rgba(255,255,255,0.3);
    background: rgba(255,255,255,0.04);
    padding: 4px 10px;
    border-radius: 100px;
  }
  .post-body {
    font-size: 0.9rem;
    color: rgba(255,255,255,0.7);
    line-height: 1.7;
    margin: 0 0 14px;
  }
  .post-image {
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 14px;
  }
  .post-image img {
    width: 100%;
    height: auto;
    display: block;
  }
  .post-embed {
    margin-bottom: 14px;
  }
  .embed-placeholder {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-radius: 12px;
    background: rgba(201,131,0,0.08);
    border: 1px solid rgba(201,131,0,0.15);
  }
  .embed-icon {
    font-size: 1.4rem;
  }
  .embed-text {
    font-size: 0.8rem;
    font-weight: 700;
    color: #C98300;
  }
  .post-actions {
    display: flex;
    gap: 8px;
    border-top: 1px solid rgba(255,255,255,0.04);
    padding-top: 12px;
  }
  .post-action {
    flex: 1;
    padding: 8px;
    border-radius: 10px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.04);
    color: rgba(255,255,255,0.4);
    font-size: 0.7rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
    font-family: inherit;
  }
  .post-action:hover {
    background: rgba(201,131,0,0.08);
    border-color: rgba(201,131,0,0.2);
    color: #C98300;
  }
  @media (max-width: 600px) {
    .feed-post { padding: 16px; }
    .post-actions { gap: 4px; }
  }

  /* ===== CONTENT GRID (2 cols on desktop) ===== */
  .content-grid {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 40px;
    margin-top: 40px;
    padding-top: 40px;
    border-top: 1px solid rgba(255,255,255,0.06);
  }

  /* Tracks */
  .tracks-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .track-row {
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 12px 14px;
    border-radius: 12px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.04);
    transition: all 0.2s;
  }
  .track-row:hover {
    background: rgba(255,255,255,0.05);
    border-color: rgba(201,131,0,0.15);
  }
  .track-num {
    font-size: 0.65rem;
    font-weight: 700;
    color: rgba(255,255,255,0.15);
    font-family: monospace;
    width: 20px;
    text-align: center;
  }
  .track-info {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-width: 0;
  }
  .track-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .track-dur {
    font-size: 0.6rem;
    color: rgba(255,255,255,0.25);
    font-family: monospace;
    flex-shrink: 0;
    margin-left: 12px;
  }
  .track-play {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: rgba(201,131,0,0.12);
    border: none;
    color: #C98300;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    flex-shrink: 0;
    text-decoration: none;
  }
  .track-play:hover {
    background: #C98300;
    color: #000;
    transform: scale(1.1);
  }
  .track-play:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  /* Social */
  .social-list {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .social-row {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: 12px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.04);
    text-decoration: none;
    transition: all 0.2s;
  }
  .social-row:hover {
    border-color: rgba(201,131,0,0.3);
    background: rgba(201,131,0,0.06);
    transform: translateX(4px);
  }
  .social-icon { font-size: 1.1rem; }
  .social-name {
    flex: 1;
    font-size: 0.8rem;
    font-weight: 700;
    color: #fff;
    text-transform: capitalize;
  }
  .social-arrow {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.2);
    transition: color 0.2s;
  }
  .social-row:hover .social-arrow { color: #C98300; }

  /* Event */
  .event-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border-radius: 14px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
  }
  .event-date-box {
    text-align: center;
    min-width: 48px;
  }
  .event-day {
    display: block;
    font-size: 1.6rem;
    font-weight: 900;
    color: #C98300;
    line-height: 1;
  }
  .event-month {
    font-size: 0.5rem;
    font-weight: 700;
    text-transform: uppercase;
    color: rgba(255,255,255,0.3);
    letter-spacing: 0.1em;
  }
  .event-details { flex: 1; }
  .event-name {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: #fff;
  }
  .event-loc {
    font-size: 0.6rem;
    color: rgba(255,255,255,0.3);
  }
  .event-maps {
    padding: 8px 14px;
    border-radius: 10px;
