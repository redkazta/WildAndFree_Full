---
import Layout from '../layouts/Layout.astro';
import { getArtistsFromDB, getArtistPosts } from '../data/artists';
import type { Artist, ArtistPost } from '../data/artists';

const config = {
  name: "Wild Gvng - Artista",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
};

const url = new URL(Astro.request.url);
const slug = url.searchParams.get('id') || '';

const artists = await getArtistsFromDB();
const artist = artists.find(a => a.slug === slug) || artists[0];

let posts: ArtistPost[] = [];
if (artist) {
  posts = await getArtistPosts(artist.id);
}

function timeAgo(dateStr: string): string {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 60) return `${mins}m`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h`;
  const days = Math.floor(hrs / 24);
  if (days < 7) return `${days}d`;
  return `${Math.floor(days / 7)}sem`;
}
---

<Layout config={config}>
  <div class="ap">

    <!-- PROFILE HEADER -->
    <div class="ap-header">
      <div class="ap-header-inner">
        <div class="ap-avatar">
          <img src={artist.imagenes.profile} alt={artist.nombre} />
        </div>
        <div class="ap-info">
          <div class="ap-name-row">
            <h1 class="ap-name">{artist.nombre}</h1>
            <span class="ap-verified">✓</span>
          </div>
          <div class="ap-genres">
            {artist.estilo.split(' / ').map(g => (
              <span class="ap-chip">{g}</span>
            ))}
          </div>
          <div class="ap-meta">
            <span>{artist.origen}</span>
            <span class="dot">·</span>
            <span>{artist.stats.partnean} Partnean</span>
            <span class="dot">·</span>
            <span>{artist.stats.oyentes} oyentes</span>
          </div>
          <div class="ap-actions">
            <button class="btn-p btn-gold" id="partnear-btn">PARTNEAR</button>
            <button class="btn-p btn-ghost" id="share-btn">COMPARTIR</button>
          </div>
        </div>
      </div>
    </div>

    <!-- TWO COLUMNS -->
    <div class="ap-body">
      <div class="ap-grid">

        <!-- LEFT (25%) SIDEBAR -->
        <aside class="ap-side">
          <!-- Avatar -->
          <div class="side-card">
            <div class="side-avatar-wrap">
              <img src={artist.imagenes.profile} alt={artist.nombre} class="side-avatar" />
            </div>
            <h2 class="side-name">{artist.nombre}</h2>
            <div class="side-genres">
              {artist.estilo.split(' / ').map(g => (
                <span class="side-chip">{g}</span>
              ))}
            </div>
          </div>

          <!-- Bio -->
          {artist.bio && (
            <div class="side-card">
              <h4 class="side-label">SOBRE MÍ</h4>
              <p class="side-bio">{artist.bio}</p>
            </div>
          )}

          <!-- Tracks -->
          {artist.tracks.length > 0 && (
            <div class="side-card">
              <h4 class="side-label">MÚSICA</h4>
              <div class="side-tracks">
                {artist.tracks.map((track, i) => (
                  <div class="trk">
                    <span class="trk-n">{String(i + 1).padStart(2, '0')}</span>
                    <div class="trk-info">
                      <span class="trk-name">{track.title}</span>
                      <span class="trk-dur">{track.duration}</span>
                    </div>
                    {track.spotify_url ? (
                      <a href={track.spotify_url} target="_blank" class="trk-go">▶</a>
                    ) : (
                      <button class="trk-go" disabled>▶</button>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Social Links -->
          {artist.redes && Object.keys(artist.redes).length > 0 && (
            <div class="side-card">
              <h4 class="side-label">REDES</h4>
              <div class="side-socials">
                {Object.entries(artist.redes).map(([platform, link]) => (
                  <a href={link} target="_blank" rel="noopener" class="soc-row">
                    <span class="soc-name">{platform}</span>
                    <span class="soc-arr">→</span>
                  </a>
                ))}
              </div>
            </div>
          )}

          <!-- Share URL -->
          <div class="side-card">
            <h4 class="side-label">COMPARTIR</h4>
            <div class="share-row">
              <code class="share-url">wildgvng.com.mx/artista?id={artist.slug}</code>
              <button class="share-cp" id="copy-url-btn">COPIAR</button>
            </div>
          </div>
        </aside>

        <!-- RIGHT (75%) FEED -->
        <div class="ap-feed">

          <!-- TABS -->
          <div class="feed-tabs">
            <button class="feed-tab active" data-tab="publicaciones">PUBLICACIONES</button>
            <button class="feed-tab" data-tab="likes">ME GUSTA</button>
            <button class="feed-tab" data-tab="reposts">REPOSTS</button>
          </div>

          <!-- PUBLICACIONES TAB (default) -->
          <div class="feed-tab-content active" data-tab-content="publicaciones">
            {posts.length > 0 ? (
              <div class="feed-list">
                {posts.map(post => (
                  <article class="fp" data-post-id={post.id}>
                    <div class="fp-top">
                      <img src={artist.imagenes.profile} alt="" class="fp-av" />
                      <div class="fp-who">
                        <span class="fp-name">{artist.nombre}</span>
                        <span class="fp-when">{timeAgo(post.created_at)}</span>
                      </div>
                      <span class="fp-tag">{post.post_type}</span>
                    </div>

                    {post.content && <p class="fp-txt">{post.content}</p>}

                    {post.post_type === 'photo' && post.image_url && (
                      <div class="fp-img">
                        <img src={post.image_url} alt="" loading="lazy" />
                      </div>
                    )}

                    {post.post_type === 'music' && post.embed_url && (
                      <div class="fp-embed">
                        <iframe
                          src={post.embed_url}
                          width="100%"
                          height="80"
                          frameBorder="0"
                          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                          loading="lazy"
                          style="border-radius: 12px;"
                        ></iframe>
                      </div>
                    )}

                    {post.post_type === 'music' && !post.embed_url && post.embed_title && (
                      <div class="fp-ph fp-music">{post.embed_title}</div>
                    )}

                    {post.post_type === 'event' && post.embed_title && (
                      <div class="fp-ph fp-event">{post.embed_title}</div>
                    )}

                    <div class="fp-acts">
                      <button class="fp-a like-btn" data-count={post.likes_count}>
                        <span class="like-icon">♡</span>
                        <span class="like-count">{post.likes_count}</span>
                      </button>
                      <button class="fp-a comment-toggle-btn" data-count={post.comments_count}>
                        <span>💬</span>
                        <span class="comment-count">{post.comments_count}</span>
                      </button>
                      <button class="fp-a repost-btn" data-count="0">
                        <span class="repost-icon">🔄</span>
                        <span class="repost-count">0</span>
                      </button>
                      <button class="fp-a share-post-btn">
                        <span>↗</span>
                      </button>
                    </div>

                    <!-- Comments section (hidden by default) -->
                    <div class="comments-section hidden">
                      <div class="comments-list"></div>
                      <div class="comment-form">
                        <input type="text" class="comment-input" placeholder="Escribe un comentario..." maxlength="500" />
                        <button class="comment-send" disabled>→</button>
                      </div>
                      <p class="comment-login-hint hidden">
                        <a href="/login">Inicia sesión</a> para comentar
                      </p>
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <p class="feed-empty">Sin posts aún</p>
            )}
          </div>

          <!-- ME GUSTA TAB -->
          <div class="feed-tab-content" data-tab-content="likes">
            <p class="feed-empty">Inicia sesión para ver tus likes</p>
          </div>

          <!-- REPOSTS TAB -->
          <div class="feed-tab-content" data-tab-content="reposts">
            <p class="feed-empty">Inicia sesión para ver tus reposts</p>
          </div>

        </div>

      </div>
    </div>

    <!-- LOGIN PROMPT MODAL -->
    <div id="login-modal" class="modal hidden">
      <div class="modal-bg"></div>
      <div class="modal-card">
        <h3>Inicia sesión para interactuar</h3>
        <p>Necesitas una cuenta para dar like, comentar, repostear y seguir a tus artistas favoritos.</p>
        <div class="modal-actions">
          <a href="/login" class="btn-p btn-gold">INICIAR SESIÓN</a>
          <a href="/registro" class="btn-p btn-ghost">CREAR CUENTA</a>
          <button class="btn-p btn-ghost" id="modal-close">CANCELAR</button>
        </div>
      </div>
    </div>

  </div>
</Layout>

<style>
  /* ============================================
     CSS VARIABLES (from Layout)
     --primary: #c98300
     --secondary: #8a0303
     --bg: #000000
     --bg-card: rgba(255,255,255,0.03)
     --border: rgba(255,255,255,0.12)
     --text: #ffffff
     --text-secondary: rgba(255,255,255,0.6)
     --text-muted: rgba(255,255,255,0.25)
     ============================================ */

  .ap {
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family: 'Outfit', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* HEADER */
  .ap-header {
    border-bottom: 1px solid var(--border);
  }
  .ap-header-inner {
    max-width: 90%;
    margin: 0 auto;
    padding: 32px 0 20px;
    display: flex;
    gap: 20px;
    align-items: flex-start;
  }
  .ap-avatar {
    flex-shrink: 0;
  }
  .ap-avatar img {
    width: 120px;
    height: 120px;
    border-radius: 50%;
    object-fit: cover;
    border: 3px solid var(--primary);
  }
  .ap-info {
    flex: 1;
    min-width: 0;
  }
  .ap-name-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .ap-name {
    font-size: 1.6rem;
    font-weight: 800;
    margin: 0;
    line-height: 1.1;
  }
  .ap-verified {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    background: var(--primary);
    color: #000;
    font-size: 0.6rem;
    font-weight: 900;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .ap-genres {
    display: flex;
    gap: 6px;
    margin-top: 6px;
    flex-wrap: wrap;
  }
  .ap-chip {
    padding: 2px 8px;
    border-radius: 100px;
    font-size: 0.5rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(201, 131, 0, 0.12);
    border: 1px solid rgba(201, 131, 0, 0.2);
    color: var(--primary);
    font-family: monospace;
  }
  .ap-meta {
    display: flex;
    gap: 6px;
    margin-top: 8px;
    font-size: 0.7rem;
    color: var(--text-muted);
    flex-wrap: wrap;
    align-items: center;
  }
  .dot {
    color: var(--border);
  }
  .ap-actions {
    display: flex;
    gap: 6px;
    margin-top: 12px;
    flex-wrap: wrap;
  }

  /* BUTTONS */
  .btn-p {
    padding: 6px 14px;
    border-radius: 6px;
    font-size: 0.6rem;
    font-weight: 700;
    cursor: pointer;
    font-family: inherit;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    text-decoration: none;
    transition: all 0.15s;
  }
  .btn-gold {
    background: var(--primary);
    border: none;
    color: #000;
  }
  .btn-gold:hover {
    background: #e69500;
  }
  .btn-ghost {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
  }
  .btn-ghost:hover {
    border-color: var(--primary);
    color: var(--primary);
  }

  /* GRID */
  .ap-body {
    max-width: 90%;
    margin: 0 auto;
    padding: 0 0 60px;
  }
  .ap-grid {
    display: grid;
    grid-template-columns: 25% 75%;
    gap: 20px;
    margin-top: 16px;
  }

  /* SIDEBAR */
  .side-card {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
    margin-bottom: 10px;
  }
  .side-avatar-wrap {
    display: flex;
    justify-content: center;
    margin-bottom: 12px;
  }
  .side-avatar {
    width: 100px;
    height: 100px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--border);
  }
  .side-name {
    font-size: 1rem;
    font-weight: 800;
    margin: 0 0 8px;
    text-align: center;
    color: var(--text);
  }
  .side-genres {
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    justify-content: center;
    margin-bottom: 4px;
  }
  .side-chip {
    padding: 2px 8px;
    border-radius: 100px;
    font-size: 0.45rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(201, 131, 0, 0.1);
    border: 1px solid rgba(201, 131, 0, 0.15);
    color: var(--primary);
    font-family: monospace;
  }
  .side-label {
    font-size: 0.5rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--text-muted);
    margin: 0 0 10px;
    font-family: monospace;
  }
  .side-bio {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.6;
    margin: 0;
  }
  .side-tracks {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .trk {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 7px 8px;
    border-radius: 6px;
    transition: background 0.15s;
  }
  .trk:hover {
    background: var(--bg-card);
  }
  .trk-n {
    font-size: 0.5rem;
    color: var(--text-muted);
    font-family: monospace;
    width: 14px;
    text-align: center;
  }
  .trk-info {
    flex: 1;
    display: flex;
    justify-content: space-between;
    min-width: 0;
  }
  .trk-name {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .trk-dur {
    font-size: 0.45rem;
    color: var(--text-muted);
    font-family: monospace;
    flex-shrink: 0;
    margin-left: 6px;
  }
  .trk-go {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: rgba(201, 131, 0, 0.1);
    border: none;
    color: var(--primary);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    font-size: 0.45rem;
    flex-shrink: 0;
    text-decoration: none;
    transition: all 0.15s;
  }
  .trk-go:hover {
    background: var(--primary);
    color: #000;
  }
  .trk-go:disabled {
    opacity: 0.25;
    cursor: not-allowed;
  }
  .side-socials {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }
  .soc-row {
    display: flex;
    align-items: center;
    padding: 7px 10px;
    border-radius: 6px;
    text-decoration: none;
    transition: all 0.15s;
  }
  .soc-row:hover {
    background: var(--bg-card);
  }
  .soc-name {
    flex: 1;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text);
    text-transform: capitalize;
  }
  .soc-arr {
    font-size: 0.6rem;
    color: var(--text-muted);
  }
  .soc-row:hover .soc-arr {
    color: var(--primary);
  }
  .share-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .share-url {
    flex: 1;
    font-size: 0.5rem;
    color: var(--text-muted);
    font-family: monospace;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .share-cp {
    padding: 4px 10px;
    border-radius: 5px;
    font-size: 0.45rem;
    font-weight: 800;
    text-transform: uppercase;
    background: rgba(201, 131, 0, 0.12);
    border: none;
    color: var(--primary);
    cursor: pointer;
    font-family: inherit;
    flex-shrink: 0;
    transition: all 0.15s;
  }
  .share-cp:hover {
    background: var(--primary);
    color: #000;
  }

  /* FEED TABS */
  .feed-tabs {
    display: flex;
    gap: 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 16px;
  }
  .feed-tab {
    flex: 1;
    padding: 10px 8px;
    background: transparent;
    border: none;
    border-bottom: 2px solid transparent;
    color: var(--text-muted);
    font-size: 0.6rem;
    font-weight: 700;
    font-family: monospace;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.15s;
    text-align: center;
  }
  .feed-tab:hover {
    color: var(--text-secondary);
  }
  .feed-tab.active {
    color: var(--primary);
    border-bottom-color: var(--primary);
  }

  /* FEED TAB CONTENT */
  .feed-tab-content {
    display: none;
  }
  .feed-tab-content.active {
    display: block;
  }

  /* FEED */
  .feed-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }
  .feed-empty {
    text-align: center;
    padding: 24px 0;
    color: var(--text-muted);
    font-size: 0.75rem;
  }
  .fp {
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 14px;
    transition: border-color 0.15s;
  }
  .fp:hover {
    border-color: rgba(201, 131, 0, 0.25);
  }
  .fp-top {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 10px;
  }
  .fp-av {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .fp-who {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .fp-name {
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--text);
  }
  .fp-when {
    font-size: 0.5rem;
    color: var(--text-muted);
    font-family: monospace;
  }
  .fp-tag {
    font-size: 0.45rem;
    font-weight: 700;
    color: var(--text-muted);
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 2px 7px;
    border-radius: 100px;
    text-transform: capitalize;
    flex-shrink: 0;
  }
  .fp-txt {
    font-size: 0.8rem;
    color: var(--text-secondary);
    line-height: 1.5;
    margin: 0 0 10px;
  }
  .fp-img {
    border-radius: 8px;
    overflow: hidden;
    margin-bottom: 10px;
  }
  .fp-img img {
    width: 100%;
    height: auto;
    display: block;
  }
  .fp-embed {
    margin-bottom: 10px;
  }
  .fp-ph {
    padding: 10px 14px;
    border-radius: 8px;
    margin-bottom: 10px;
    font-size: 0.7rem;
    font-weight: 700;
  }
  .fp-music {
    background: rgba(201, 131, 0, 0.08);
    border: 1px solid rgba(201, 131, 0, 0.12);
    color: var(--primary);
  }
  .fp-event {
    background: rgba(138, 3, 3, 0.06);
    border: 1px solid rgba(138, 3, 3, 0.12);
    color: #ff6b6b;
  }

  /* ACTIONS */
  .fp-acts {
    display: flex;
    gap: 4px;
    border-top: 1px solid var(--border);
    padding-top: 8px;
  }
  .fp-a {
    flex: 1;
    padding: 5px;
    border-radius: 5px;
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.55rem;
    font-weight: 600;
    cursor: pointer;
    text-align: center;
    font-family: inherit;
    transition: all 0.15s;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 4px;
  }
  .fp-a:hover {
    color: var(--primary);
  }
  .fp-a.liked {
    color: var(--primary);
  }
  .fp-a.liked .like-icon {
    color: var(--primary);
  }
  .fp-a.reposted {
    color: #1da1f2;
  }
  .fp-a.reposted .repost-icon {
    color: #1da1f2;
  }
  .like-icon {
    font-size: 0.7rem;
    transition: transform 0.2s;
  }
  .fp-a.liked .like-icon {
    transform: scale(1.2);
  }
  .repost-icon {
    font-size: 0.7rem;
    transition: transform 0.2s;
  }
  .fp-a.reposted .repost-icon {
    transform: scale(1.15);
  }

  /* COMMENTS */
  .comments-section {
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid var(--border);
  }
  .comments-section.hidden {
    display: none;
  }
  .comments-list {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-bottom: 10px;
  }
  .comment-item {
    display: flex;
    gap: 8px;
  }
  .comment-item img {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .comment-body {
    flex: 1;
  }
  .comment-author {
    font-size: 0.65rem;
    font-weight: 700;
    color: var(--text);
  }
  .comment-text {
    font-size: 0.7rem;
    color: var(--text-secondary);
    margin-top: 2px;
  }
  .comment-time {
    font-size: 0.45rem;
    color: var(--text-muted);
    font-family: monospace;
    margin-top: 2px;
  }
  .comment-form {
    display: flex;
    gap: 6px;
  }
  .comment-input {
    flex: 1;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 6px 10px;
    font-size: 0.7rem;
    color: var(--text);
    font-family: inherit;
    outline: none;
  }
  .comment-input:focus {
    border-color: var(--primary);
  }
  .comment-input::placeholder {
    color: var(--text-muted);
  }
  .comment-send {
    padding: 6px 10px;
    border-radius: 6px;
    background: rgba(201, 131, 0, 0.15);
    border: none;
    color: var(--primary);
    font-size: 0.7rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s;
  }
  .comment-send:hover {
    background: var(--primary);
    color: #000;
  }
  .comment-send:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }
  .comment-login-hint {
    font-size: 0.6rem;
    color: var(--text-muted);
    margin-top: 6px;
    text-align: center;
  }
  .comment-login-hint.hidden {
    display: none;
  }
  .comment-login-hint a {
    color: var(--primary);
    text-decoration: none;
  }

  /* MODAL */
  .modal {
    position: fixed;
    inset: 0;
    z-index: 10000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .modal.hidden {
    display: none;
  }
  .modal-bg {
    position: absolute;
    inset: 0;
    background: rgba(0, 0, 0, 0.7);
  }
  .modal-card {
    position: relative;
    background: #111;
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 24px;
    max-width: 340px;
    width: 90%;
    text-align: center;
  }
  .modal-card h3 {
    font-size: 1rem;
    font-weight: 800;
    margin: 0 0 8px;
    color: var(--text);
  }
  .modal-card p {
    font-size: 0.75rem;
    color: var(--text-muted);
    line-height: 1.5;
    margin: 0 0 16px;
  }
  .modal-actions {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  /* TABLET */
  @media (max-width: 860px) {
    .ap-grid {
      grid-template-columns: 1fr;
    }
    .ap-side {
      order: -1;
    }
    .side-card {
      display: none;
    }
    .side-card:first-child {
      display: block;
      text-align: center;
    }
    .side-avatar {
      width: 80px;
      height: 80px;
    }
  }

  /* MOBILE */
  @media (max-width: 600px) {
    .ap-header-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 16px 0 12px;
    }
    .ap-avatar img {
      width: 96px;
      height: 96px;
    }
    .ap-name-row {
      justify-content: center;
    }
    .ap-name {
      font-size: 1.3rem;
    }
    .ap-genres {
      justify-content: center;
    }
    .ap-meta {
      justify-content: center;
    }
    .ap-actions {
      justify-content: center;
    }
    .ap-body {
      padding: 0 0 40px;
    }
    .ap-grid {
      gap: 12px;
    }
    .side-card {
      display: none;
    }
    .side-card:first-child {
      display: block;
      text-align: center;
    }
    .side-avatar {
      width: 72px;
      height: 72px;
    }
    .feed-tabs {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
    }
    .feed-tab {
      font-size: 0.5rem;
      padding: 8px 6px;
      white-space: nowrap;
    }
    .fp {
      padding: 12px;
    }
    .fp-av {
      width: 24px;
      height: 24px;
    }
    .fp-txt {
      font-size: 0.75rem;
    }
    .share-row {
      flex-direction: column;
      align-items: stretch;
    }
    .share-url {
      text-align: center;
    }
    .share-cp {
      width: 100%;
      text-align: center;
    }
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  let currentUser: any = null;

  // Store all posts data from server
  const allPostsData: Record<string, HTMLElement[]> = {
    publicaciones: [],
    likes: [],
    reposts: []
  };

  // All post elements (for filtering)
  const allPostElements = document.querySelectorAll('.fp[data-post-id]');

  // Check auth state
  async function checkAuth() {
    const { data: { session } } = await supabase.auth.getSession();
    currentUser = session?.user || null;
    updateUI();
    if (currentUser) {
      loadLikedPosts();
      loadRepostedPosts();
    }
  }

  function updateUI() {
    document.querySelectorAll('.comment-input').forEach((input: Element) => {
      const section = (input as HTMLElement).closest('.comments-section');
      const hint = section?.querySelector('.comment-login-hint');
      const sendBtn = section?.querySelector('.comment-send') as HTMLButtonElement;
      if (hint) hint.classList.toggle('hidden', !!currentUser);
      if (sendBtn) sendBtn.disabled = !currentUser;
    });

    // Update login hints for likes/reposts tabs
    const likesEmpty = document.querySelector('[data-tab-content="likes"] .feed-empty');
    const repostsEmpty = document.querySelector('[data-tab-content="reposts"] .feed-empty');
    if (currentUser) {
      if (likesEmpty) likesEmpty.textContent = 'No tienes likes aún';
      if (repostsEmpty) repostsEmpty.textContent = 'No tienes reposts aún';
    } else {
      if (likesEmpty) likesEmpty.textContent = 'Inicia sesión para ver tus likes';
      if (repostsEmpty) repostsEmpty.textContent = 'Inicia sesión para ver tus reposts';
    }
  }

  function showLoginModal() {
    document.getElementById('login-modal')?.classList.remove('hidden');
  }

  function hideLoginModal() {
    document.getElementById('login-modal')?.classList.add('hidden');
  }

  // Modal close
  document.getElementById('modal-close')?.addEventListener('click', hideLoginModal);
  document.querySelector('.modal-bg')?.addEventListener('click', hideLoginModal);

  // TABS
  document.querySelectorAll('.feed-tab').forEach((tab: Element) => {
    tab.addEventListener('click', () => {
      // Remove active from all tabs
      document.querySelectorAll('.feed-tab').forEach(t => t.classList.remove('active'));
      document.querySelectorAll('.feed-tab-content').forEach(c => c.classList.remove('active'));

      // Activate clicked tab
      tab.classList.add('active');
      const tabName = (tab as HTMLElement).getAttribute('data-tab');
      const content = document.querySelector(`[data-tab-content="${tabName}"]`);
      if (content) content.classList.add('active');
    });
  });

  // Like buttons
  document.querySelectorAll('.like-btn').forEach((btn: Element) => {
    btn.addEventListener('click', async () => {
      if (!currentUser) { showLoginModal(); return; }
      const article = (btn as HTMLElement).closest('.fp');
      const postId = article?.getAttribute('data-post-id');
      if (!postId) return;

      const { data, error } = await supabase.rpc('toggle_artist_post_like', { p_post_id: postId });
      if (error || !data || data.error) {
        if (data?.error === 'not_authenticated') showLoginModal();
        return;
      }

      const icon = btn.querySelector('.like-icon');
      const count = btn.querySelector('.like-count');
      if (icon) icon.textContent = data.liked ? '♥' : '♡';
      if (count) count.textContent = data.count;
      btn.classList.toggle('liked', data.liked);
    });
  });

  // Repost buttons
  document.querySelectorAll('.repost-btn').forEach((btn: Element) => {
    btn.addEventListener('click', async () => {
      if (!currentUser) { showLoginModal(); return; }
      const article = (btn as HTMLElement).closest('.fp');
      const postId = article?.getAttribute('data-post-id');
      if (!postId) return;

      const { data, error } = await supabase.rpc('toggle_artist_post_repost', { p_post_id: postId });
      if (error || !data || data.error) {
        if (data?.error === 'not_authenticated') showLoginModal();
        return;
      }

      const count = btn.querySelector('.repost-count');
      if (count) count.textContent = data.count;
      btn.classList.toggle('reposted', data.reposted);
    });
  });

  // Comment toggle
  document.querySelectorAll('.comment-toggle-btn').forEach((btn: Element) => {
    btn.addEventListener('click', () => {
      const article = (btn as HTMLElement).closest('.fp');
      const section = article?.querySelector('.comments-section');
      section?.classList.toggle('hidden');
    });
  });

  // Comment send
  document.querySelectorAll('.comment-send').forEach((btn: Element) => {
    btn.addEventListener('click', async () => {
      if (!currentUser) { showLoginModal(); return; }
      const article = (btn as HTMLElement).closest('.fp');
      const postId = article?.getAttribute('data-post-id');
      const input = article?.querySelector('.comment-input') as HTMLInputElement;
      if (!postId || !input || !input.value.trim()) return;

      const content = input.value.trim();
      input.value = '';
      (btn as HTMLButtonElement).disabled = true;

      const { data, error } = await supabase.rpc('add_artist_post_comment', {
        p_post_id: postId,
        p_content: content
      });

      if (error || !data || data.error) {
        if (data?.error === 'not_authenticated') showLoginModal();
        return;
      }

      // Update count
      const countEl = article?.querySelector('.comment-count');
      if (countEl) countEl.textContent = data.count;

      // Add comment to list
      const list = article?.querySelector('.comments-list');
      if (list && currentUser) {
        const div = document.createElement('div');
        div.className = 'comment-item';
        div.innerHTML = `
          <div class="comment-body">
            <span class="comment-author">Tú</span>
            <p class="comment-text">${content}</p>
            <span class="comment-time">ahora</span>
          </div>
        `;
        list.appendChild(div);
      }

      (btn as HTMLButtonElement).disabled = false;
    });
  });

  // Comment input - enable send on typing
  document.querySelectorAll('.comment-input').forEach((input: Element) => {
    input.addEventListener('input', () => {
      const section = (input as HTMLElement).closest('.comments-section');
      const sendBtn = section?.querySelector('.comment-send') as HTMLButtonElement;
      if (sendBtn && currentUser) {
        sendBtn.disabled = !(input as HTMLInputElement).value.trim();
      }
    });
  });

  // Share post
  document.querySelectorAll('.share-post-btn').forEach((btn: Element) => {
    btn.addEventListener('click', () => {
      navigator.clipboard.writeText(window.location.href);
      const span = (btn as HTMLElement).querySelector('span');
      if (span) span.textContent = '✓';
      setTimeout(() => { if (span) span.textContent = '↗'; }, 1500);
    });
  });

  // Partnear
  const partnearBtn = document.getElementById('partnear-btn');
  let isPartnear = false;
  if (partnearBtn) {
    partnearBtn.addEventListener('click', () => {
      if (!currentUser) { showLoginModal(); return; }
      isPartnear = !isPartnear;
      partnearBtn.classList.toggle('active', isPartnear);
      partnearBtn.textContent = isPartnear ? 'PARTEANDO' : 'PARTNEAR';
    });
  }

  // Share profile
  const shareBtn = document.getElementById('share-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', () => {
      const slug = new URL(window.location.href).searchParams.get('id') || '';
      navigator.clipboard.writeText(`https://www.wildgvng.com.mx/artista?id=${slug}`).then(() => {
        shareBtn.classList.add('active');
        shareBtn.textContent = '¡COPIADO!';
        setTimeout(() => { shareBtn.classList.remove('active'); shareBtn.textContent = 'COMPARTIR'; }, 2000);
      });
    });
  }

  // Copy URL
  const copyBtn = document.getElementById('copy-url-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const slug = new URL(window.location.href).searchParams.get('id') || '';
      navigator.clipboard.writeText(`https://www.wildgvng.com.mx/artista?id=${slug}`).then(() => {
        copyBtn.textContent = '¡COPIADO!';
        setTimeout(() => { copyBtn.textContent = 'COPIAR'; }, 2000);
      });
    });
  }

  // Load user's liked posts for the "ME GUSTA" tab
  async function loadLikedPosts() {
    if (!currentUser) return;

    // Get artist ID from URL
    const slug = new URL(window.location.href).searchParams.get('id') || '';
    const { data: artistId } = await supabase.rpc('get_user_artist_post_likes', { p_artist_id: slug });

    const likesContent = document.querySelector('[data-tab-content="likes"]');
    if (!likesContent) return;

    // Get all post IDs from the page
    const likedPostIds: string[] = artistId || [];
    if (likedPostIds.length === 0) {
      likesContent.innerHTML = '<p class="feed-empty">No tienes likes en este artista</p>';
      return;
    }

    // Clone liked posts from the publicaciones tab
    const publicacionesFeed = document.querySelector('[data-tab-content="publicaciones"] .feed-list');
    if (!publicacionesFeed) return;

    likesContent.innerHTML = '';
    const feedList = document.createElement('div');
    feedList.className = 'feed-list';

    allPostElements.forEach(post => {
      const postId = post.getAttribute('data-post-id');
      if (likedPostIds.includes(postId || '')) {
        feedList.appendChild(post.cloneNode(true));
      }
    });

    if (feedList.children.length === 0) {
      likesContent.innerHTML = '<p class="feed-empty">No tienes likes en este artista</p>';
    } else {
      likesContent.appendChild(feedList);
    }

    // Re-attach event listeners for cloned posts
    reattachListeners(likesContent);
  }

  // Load user's reposted posts for the "REPOSTS" tab
  async function loadRepostedPosts() {
    if (!currentUser) return;

    const repostsContent = document.querySelector('[data-tab-content="reposts"]');
    if (!repostsContent) return;

    // Query reposts table
    const { data: reposts, error } = await supabase
      .from('artist_post_reposts')
      .select('post_id')
      .eq('user_id', currentUser.id);

    if (error || !reposts || reposts.length === 0) {
      repostsContent.innerHTML = '<p class="feed-empty">No tienes reposts en este artista</p>';
      return;
    }

    const repostedPostIds = reposts.map((r: any) => r.post_id);

    repostsContent.innerHTML = '';
    const feedList = document.createElement('div');
    feedList.className = 'feed-list';

    allPostElements.forEach(post => {
      const postId = post.getAttribute('data-post-id');
      if (repostedPostIds.includes(postId || '')) {
        feedList.appendChild(post.cloneNode(true));
      }
    });

    if (feedList.children.length === 0) {
      repostsContent.innerHTML = '<p class="feed-empty">No tienes reposts en este artista</p>';
    } else {
      repostsContent.appendChild(feedList);
    }

    // Re-attach event listeners for cloned posts
    reattachListeners(repostsContent);
  }

  // Re-attach event listeners to cloned posts in other tabs
  function reattachListeners(container: Element) {
    container.querySelectorAll('.like-btn').forEach((btn: Element) => {
      btn.addEventListener('click', async () => {
        if (!currentUser) { showLoginModal(); return; }
        const article = (btn as HTMLElement).closest('.fp');
        const postId = article?.getAttribute('data-post-id');
        if (!postId) return;

        const { data, error } = await supabase.rpc('toggle_artist_post_like', { p_post_id: postId });
        if (error || !data || data.error) {
          if (data?.error === 'not_authenticated') showLoginModal();
          return;
        }

        const icon = btn.querySelector('.like-icon');
        const count = btn.querySelector('.like-count');
        if (icon) icon.textContent = data.liked ? '♥' : '♡';
        if (count) count.textContent = data.count;
        btn.classList.toggle('liked', data.liked);
      });
    });

    container.querySelectorAll('.repost-btn').forEach((btn: Element) => {
      btn.addEventListener('click', async () => {
        if (!currentUser) { showLoginModal(); return; }
        const article = (btn as HTMLElement).closest('.fp');
        const postId = article?.getAttribute('data-post-id');
        if (!postId) return;

        const { data, error } = await supabase.rpc('toggle_artist_post_repost', { p_post_id: postId });
        if (error || !data || data.error) {
          if (data?.error === 'not_authenticated') showLoginModal();
          return;
        }

        const count = btn.querySelector('.repost-count');
        if (count) count.textContent = data.count;
        btn.classList.toggle('reposted', data.reposted);
      });
    });

    container.querySelectorAll('.comment-toggle-btn').forEach((btn: Element) => {
      btn.addEventListener('click', () => {
        const article = (btn as HTMLElement).closest('.fp');
        const section = article?.querySelector('.comments-section');
        section?.classList.toggle('hidden');
      });
    });

    container.querySelectorAll('.comment-send').forEach((btn: Element) => {
      btn.addEventListener('click', async () => {
        if (!currentUser) { showLoginModal(); return; }
        const article = (btn as HTMLElement).closest('.fp');
        const postId = article?.getAttribute('data-post-id');
        const input = article?.querySelector('.comment-input') as HTMLInputElement;
        if (!postId || !input || !input.value.trim()) return;

        const content = input.value.trim();
        input.value = '';
        (btn as HTMLButtonElement).disabled = true;

        const { data, error } = await supabase.rpc('add_artist_post_comment', {
          p_post_id: postId,
          p_content: content
        });

        if (error || !data || data.error) {
          if (data?.error === 'not_authenticated') showLoginModal();
          return;
        }

        const countEl = article?.querySelector('.comment-count');
        if (countEl) countEl.textContent = data.count;

        const list = article?.querySelector('.comments-list');
        if (list && currentUser) {
          const div = document.createElement('div');
          div.className = 'comment-item';
          div.innerHTML = `
            <div class="comment-body">
              <span class="comment-author">Tú</span>
              <p class="comment-text">${content}</p>
              <span class="comment-time">ahora</span>
            </div>
          `;
          list.appendChild(div);
        }

        (btn as HTMLButtonElement).disabled = false;
      });
    });

    container.querySelectorAll('.comment-input').forEach((input: Element) => {
      input.addEventListener('input', () => {
        const section = (input as HTMLElement).closest('.comments-section');
        const sendBtn = section?.querySelector('.comment-send') as HTMLButtonElement;
        if (sendBtn && currentUser) {
          sendBtn.disabled = !(input as HTMLInputElement).value.trim();
        }
      });
    });

    container.querySelectorAll('.share-post-btn').forEach((btn: Element) => {
      btn.addEventListener('click', () => {
        navigator.clipboard.writeText(window.location.href);
        const span = (btn as HTMLElement).querySelector('span');
        if (span) span.textContent = '✓';
        setTimeout(() => { if (span) span.textContent = '↗'; }, 1500);
      });
    });
  }

  // Init
  checkAuth();
  supabase.auth.onAuthStateChange(() => checkAuth());
</script>
