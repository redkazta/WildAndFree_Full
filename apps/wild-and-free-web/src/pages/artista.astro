---
import Layout from '../layouts/Layout.astro';
import { getArtistsFromDB, getArtistPosts } from '../data/artists';
import type { Artist, ArtistPost } from '../data/artists';

const config = {
  name: "Wild Gvng - Artista",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
};

const url = new URL(Astro.request.url);
const slug = url.searchParams.get('id') || '';

const artists = await getArtistsFromDB();
const artist = artists.find(a => a.slug === slug) || artists[0];

let posts: ArtistPost[] = [];
if (artist) {
  posts = await getArtistPosts(artist.id);
}

function timeAgo(dateStr: string): string {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 60) return `${mins}m`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h`;
  const days = Math.floor(hrs / 24);
  if (days < 7) return `${days}d`;
  return `${Math.floor(days / 7)}sem`;
}
---

<Layout config={config}>
  <div class="fb-page">

    <!-- TOP BAR -->
    <div class="top-bar">
      <div class="top-bar-inner">
        <a href="/artistas" class="top-back">← ROSTER</a>
        <span class="top-title">WILD GVNG</span>
        <div style="width:60px"></div>
      </div>
    </div>

    <!-- PROFILE HEADER -->
    <div class="profile-header">
      <div class="profile-header-bg"></div>
      <div class="profile-header-inner">
        <div class="avatar-wrap">
          <img src={artist.imagenes.profile} alt={artist.nombre} class="avatar-img" />
          <div class="avatar-ring"></div>
        </div>
        <div class="profile-info">
          <div class="profile-name-row">
            <h1 class="profile-name">{artist.nombre}</h1>
            <span class="verified">✓</span>
          </div>
          <div class="profile-genres">
            {artist.estilo.split(' / ').map(g => (
              <span class="genre-chip">{g}</span>
            ))}
          </div>
          <div class="profile-meta">
            <span>{artist.origen}</span>
            <span class="meta-dot">·</span>
            <span>{artist.stats.partnean} Partnean</span>
            <span class="meta-dot">·</span>
            <span>{artist.stats.oyentes} oyentes</span>
          </div>
          <div class="profile-actions">
            <button class="fb-btn fb-btn-primary" id="partnear-btn">
              PARTNEAR
            </button>
            <button class="fb-btn fb-btn-secondary" id="share-btn">
              COMPARTIR
            </button>
          </div>
        </div>
      </div>
    </div>

    <!-- TWO COLUMN LAYOUT -->
    <div class="fb-container">
      <div class="fb-grid">

        <!-- LEFT: Profile Sidebar (25%) -->
        <div class="col-left">

          {artist.bio && (
            <section class="fb-card">
              <h3 class="card-title">SOBRE MÍ</h3>
              <p class="bio-text">{artist.bio}</p>
            </section>
          )}

          {artist.tracks.length > 0 && (
            <section class="fb-card">
              <h3 class="card-title">MÚSICA</h3>
              <div class="tracks">
                {artist.tracks.map((track, i) => (
                  <div class="track-item">
                    <span class="track-num">{String(i + 1).padStart(2, '0')}</span>
                    <div class="track-info">
                      <span class="track-name">{track.title}</span>
                      <span class="track-dur">{track.duration}</span>
                    </div>
                    {track.spotify_url ? (
                      <a href={track.spotify_url} target="_blank" class="track-play">
                        ▶
                      </a>
                    ) : (
                      <button class="track-play" disabled>▶</button>
                    )}
                  </div>
                ))}
              </div>
            </section>
          )}

          {artist.redes && Object.keys(artist.redes).length > 0 && (
            <section class="fb-card">
              <h3 class="card-title">REDES</h3>
              <div class="social-list">
                {Object.entries(artist.redes).map(([platform, link]) => (
                  <a href={link} target="_blank" rel="noopener" class="social-row">
                    <span class="social-name">{platform}</span>
                    <span class="social-arrow">→</span>
                  </a>
                ))}
              </div>
            </section>
          )}

          <section class="fb-card">
            <h3 class="card-title">COMPARTIR</h3>
            <div class="share-row">
              <code class="share-url">wildgvng.com.mx/artista?id={artist.slug}</code>
              <button class="share-copy" id="copy-url-btn">COPIAR</button>
            </div>
          </section>

        </div>

        <!-- RIGHT: Feed (75%) -->
        <div class="col-right">
          <div class="fb-card feed-card">
            <h3 class="card-title">FEED</h3>
            {posts.length > 0 ? (
              <div class="feed-list">
                {posts.map(post => (
                  <article class="feed-post">
                    <div class="fp-header">
                      <img src={artist.imagenes.profile} alt={artist.nombre} class="fp-avatar" />
                      <div class="fp-meta">
                        <span class="fp-name">{artist.nombre}</span>
                        <span class="fp-time">{timeAgo(post.created_at)}</span>
                      </div>
                      <span class="fp-type">{post.post_type}</span>
                    </div>

                    {post.content && (
                      <p class="fp-body">{post.content}</p>
                    )}

                    {post.post_type === 'photo' && post.image_url && (
                      <div class="fp-image">
                        <img src={post.image_url} alt="Post" loading="lazy" />
                      </div>
                    )}

                    {post.post_type === 'music' && post.embed_url && (
                      <div class="fp-embed">
                        <iframe
                          src={post.embed_url}
                          width="100%"
                          height="80"
                          frameBorder="0"
                          allow="autoplay; clipboard-write; encrypted-media; fullscreen; picture-in-picture"
                          loading="lazy"
                          style="border-radius: 12px;"
                        ></iframe>
                      </div>
                    )}

                    {post.post_type === 'music' && !post.embed_url && post.embed_title && (
                      <div class="fp-music-ph">
                        <span>{post.embed_title}</span>
                      </div>
                    )}

                    {post.post_type === 'event' && post.embed_title && (
                      <div class="fp-event-ph">
                        <span>{post.embed_title}</span>
                      </div>
                    )}

                    <div class="fp-actions">
                      <button class="fp-action">{post.likes_count} fuego</button>
                      <button class="fp-action">{post.comments_count} comments</button>
                      <button class="fp-action">share</button>
                    </div>
                  </article>
                ))}
              </div>
            ) : (
              <div class="feed-empty">Sin posts aún</div>
            )}
          </div>
        </div>

      </div>
    </div>

  </div>
</Layout>

<style>
  .fb-page {
    min-height: 100vh;
    background: #0a0a0a;
    color: #fff;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  /* TOP BAR */
  .top-bar {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(10,10,10,0.85);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255,255,255,0.06);
  }
  .top-bar-inner {
    max-width: 940px;
    margin: 0 auto;
    padding: 12px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .top-back {
    font-size: 0.7rem;
    font-weight: 700;
    color: #C98300;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.1em;
  }
  .top-title {
    font-size: 0.65rem;
    font-weight: 900;
    letter-spacing: 0.3em;
    color: rgba(255,255,255,0.25);
    font-family: monospace;
  }

  /* PROFILE HEADER */
  .profile-header {
    position: relative;
  }
  .profile-header-bg {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 200px;
    background:
      linear-gradient(180deg, rgba(201,131,0,0.06) 0%, transparent 100%),
      linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
    background-size: 100% 100%, 40px 40px, 40px 40px;
  }
  .profile-header-inner {
    position: relative;
    max-width: 940px;
    margin: 0 auto;
    padding: 80px 20px 24px;
    display: flex;
    gap: 24px;
    align-items: flex-end;
  }
  .avatar-wrap {
    position: relative;
    flex-shrink: 0;
  }
  .avatar-img {
    width: 168px;
    height: 168px;
    border-radius: 50%;
    object-fit: cover;
    border: 4px solid #0a0a0a;
    display: block;
  }
  .avatar-ring {
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    border: 3px solid rgba(201,131,0,0.4);
  }
  .profile-info {
    flex: 1;
    min-width: 0;
    padding-bottom: 8px;
  }
  .profile-name-row {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .profile-name {
    font-size: 2rem;
    font-weight: 800;
    margin: 0;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }
  .verified {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: linear-gradient(135deg, #C98300, #f59e0b);
    color: #000;
    font-size: 0.65rem;
    font-weight: 900;
    flex-shrink: 0;
  }
  .profile-genres {
    display: flex;
    gap: 6px;
    margin-top: 8px;
    flex-wrap: wrap;
  }
  .genre-chip {
    padding: 3px 10px;
    border-radius: 100px;
    font-size: 0.55rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: rgba(201,131,0,0.1);
    border: 1px solid rgba(201,131,0,0.2);
    color: #C98300;
    font-family: monospace;
  }
  .profile-meta {
    display: flex;
    gap: 8px;
    margin-top: 10px;
    font-size: 0.75rem;
    color: rgba(255,255,255,0.4);
    flex-wrap: wrap;
    align-items: center;
  }
  .meta-dot { color: rgba(255,255,255,0.15); }
  .profile-actions {
    display: flex;
    gap: 8px;
    margin-top: 14px;
  }

  /* BUTTONS */
  .fb-btn {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 8px 18px;
    border-radius: 8px;
    font-size: 0.7rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
    border: none;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .fb-btn-primary {
    background: rgba(201,131,0,0.15);
    border: 1px solid rgba(201,131,0,0.3);
    color: #C98300;
  }
  .fb-btn-primary:hover,
  .fb-btn-primary.active {
    background: #C98300;
    color: #000;
  }
  .fb-btn-secondary {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.1);
    color: rgba(255,255,255,0.5);
  }
  .fb-btn-secondary:hover {
    border-color: rgba(201,131,0,0.3);
    color: #C98300;
  }
  .fb-btn-secondary.active {
    background: rgba(201,131,0,0.1);
    border-color: rgba(201,131,0,0.3);
    color: #C98300;
  }

  /* CONTAINER & GRID */
  .fb-container {
    max-width: 940px;
    margin: 0 auto;
    padding: 0 20px 80px;
  }
  .fb-grid {
    display: grid;
    grid-template-columns: 25% 75%;
    gap: 20px;
    margin-top: 20px;
  }

  /* CARDS */
  .fb-card {
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    border-radius: 12px;
    padding: 20px;
    margin-bottom: 16px;
  }
  .card-title {
    font-size: 0.6rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: rgba(255,255,255,0.3);
    margin: 0 0 14px;
    font-family: monospace;
  }
  .bio-text {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.55);
    line-height: 1.7;
    margin: 0;
  }

  /* TRACKS */
  .tracks {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .track-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 8px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.04);
    transition: all 0.2s;
  }
  .track-item:hover {
    background: rgba(255,255,255,0.05);
    border-color: rgba(201,131,0,0.15);
  }
  .track-num {
    font-size: 0.55rem;
    font-weight: 700;
    color: rgba(255,255,255,0.15);
    font-family: monospace;
    width: 16px;
    text-align: center;
  }
  .track-info {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-width: 0;
  }
  .track-name {
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .track-dur {
    font-size: 0.5rem;
    color: rgba(255,255,255,0.25);
    font-family: monospace;
    flex-shrink: 0;
    margin-left: 8px;
  }
  .track-play {
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: rgba(201,131,0,0.1);
    border: none;
    color: #C98300;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    flex-shrink: 0;
    text-decoration: none;
    font-size: 0.5rem;
  }
  .track-play:hover {
    background: #C98300;
    color: #000;
  }
  .track-play:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  /* SOCIAL */
  .social-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .social-row {
    display: flex;
    align-items: center;
    padding: 8px 12px;
    border-radius: 8px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.04);
    text-decoration: none;
    transition: all 0.2s;
  }
  .social-row:hover {
    border-color: rgba(201,131,0,0.25);
    background: rgba(201,131,0,0.05);
    transform: translateX(3px);
  }
  .social-name {
    flex: 1;
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
    text-transform: capitalize;
  }
  .social-arrow {
    font-size: 0.65rem;
    color: rgba(255,255,255,0.2);
  }
  .social-row:hover .social-arrow { color: #C98300; }

  /* SHARE */
  .share-row {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .share-url {
    flex: 1;
    font-size: 0.55rem;
    color: rgba(255,255,255,0.3);
    font-family: monospace;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .share-copy {
    padding: 5px 12px;
    border-radius: 6px;
    font-size: 0.5rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    background: rgba(201,131,0,0.12);
    border: none;
    color: #C98300;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
    flex-shrink: 0;
  }
  .share-copy:hover {
    background: #C98300;
    color: #000;
  }

  /* FEED */
  .feed-card { margin-bottom: 0; }
  .feed-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }
  .feed-empty {
    text-align: center;
    padding: 30px 0;
    color: rgba(255,255,255,0.2);
    font-size: 0.8rem;
  }
  .feed-post {
    background: rgba(255,255,255,0.015);
    border: 1px solid rgba(255,255,255,0.04);
    border-radius: 12px;
    padding: 16px;
    transition: border-color 0.2s;
  }
  .feed-post:hover {
    border-color: rgba(201,131,0,0.12);
  }
  .fp-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 12px;
  }
  .fp-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    flex-shrink: 0;
  }
  .fp-meta {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .fp-name {
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
  }
  .fp-time {
    font-size: 0.55rem;
    color: rgba(255,255,255,0.25);
    font-family: monospace;
  }
  .fp-type {
    font-size: 0.5rem;
    font-weight: 700;
    color: rgba(255,255,255,0.25);
    background: rgba(255,255,255,0.04);
    padding: 3px 8px;
    border-radius: 100px;
    text-transform: capitalize;
    flex-shrink: 0;
  }
  .fp-body {
    font-size: 0.85rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.6;
    margin: 0 0 12px;
  }
  .fp-image {
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 12px;
  }
  .fp-image img {
    width: 100%;
    height: auto;
    display: block;
  }
  .fp-embed { margin-bottom: 12px; }
  .fp-music-ph {
    padding: 12px 16px;
    border-radius: 10px;
    background: rgba(201,131,0,0.06);
    border: 1px solid rgba(201,131,0,0.12);
    margin-bottom: 12px;
    font-size: 0.75rem;
    font-weight: 700;
    color: #C98300;
  }
  .fp-event-ph {
    padding: 12px 16px;
    border-radius: 10px;
    background: rgba(138,3,3,0.06);
    border: 1px solid rgba(138,3,3,0.12);
    margin-bottom: 12px;
    font-size: 0.75rem;
    font-weight: 700;
    color: #ff6b6b;
  }
  .fp-actions {
    display: flex;
    gap: 6px;
    border-top: 1px solid rgba(255,255,255,0.04);
    padding-top: 10px;
  }
  .fp-action {
    flex: 1;
    padding: 6px;
    border-radius: 6px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.03);
    color: rgba(255,255,255,0.3);
    font-size: 0.6rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s;
    text-align: center;
    font-family: inherit;
  }
  .fp-action:hover {
    background: rgba(201,131,0,0.06);
    border-color: rgba(201,131,0,0.15);
    color: #C98300;
  }

  /* RESPONSIVE TABLET */
  @media (max-width: 860px) {
    .fb-grid {
      grid-template-columns: 1fr;
    }
    .profile-header-inner {
      padding-top: 60px;
    }
  }

  /* RESPONSIVE MOBILE */
  @media (max-width: 600px) {
    .profile-header-inner {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding-top: 50px;
      gap: 16px;
    }
    .avatar-img { width: 120px; height: 120px; }
    .profile-name-row { justify-content: center; }
    .profile-name { font-size: 1.5rem; }
    .profile-genres { justify-content: center; }
    .profile-meta { justify-content: center; }
    .profile-actions { justify-content: center; }
    .fb-container { padding: 0 12px 60px; }
    .fb-card { padding: 16px; }
    .share-row {
      flex-direction: column;
      align-items: stretch;
    }
    .share-url { text-align: center; }
    .share-copy { width: 100%; text-align: center; }
  }
</style>

<script>
  const partnearBtn = document.getElementById('partnear-btn');
  let isPartnear = false;
  if (partnearBtn) {
    partnearBtn.addEventListener('click', () => {
      isPartnear = !isPartnear;
      partnearBtn.classList.toggle('active', isPartnear);
      partnearBtn.textContent = isPartnear ? 'PARTEANDO' : 'PARTNEAR';
    });
  }

  const shareBtn = document.getElementById('share-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', () => {
      const slug = new URL(window.location.href).searchParams.get('id') || '';
      const url = `https://www.wildgvng.com.mx/artista?id=${slug}`;
      navigator.clipboard.writeText(url).then(() => {
        shareBtn.classList.add('active');
        shareBtn.textContent = '¡COPIADO!';
        setTimeout(() => {
          shareBtn.classList.remove('active');
          shareBtn.textContent = 'COMPARTIR';
        }, 2000);
      });
    });
  }

  const copyBtn = document.getElementById('copy-url-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const slug = new URL(window.location.href).searchParams.get('id') || '';
      const url = `https://www.wildgvng.com.mx/artista?id=${slug}`;
      navigator.clipboard.writeText(url).then(() => {
        copyBtn.textContent = '¡COPIADO!';
        setTimeout(() => { copyBtn.textContent = 'COPIAR'; }, 2000);
      });
    });
  }
</script>
