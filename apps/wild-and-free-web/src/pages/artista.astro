<script>
  const partnearBtn = document.getElementById('partnear-btn');
  let isPartnear = false;
  if (partnearBtn) {
    partnearBtn.addEventListener('click', () => {
      isPartnear = !isPartnear;
      partnearBtn.classList.toggle('active', isPartnear);
      const textEl = partnearBtn.querySelector('.btn-text');
      if (textEl) textEl.textContent = isPartnear ? 'PARTEANDO' : 'PARTNEAR';
    });
  }

  const shareBtn = document.getElementById('share-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', () => {
      const slug = new URL(window.location.href).searchParams.get('') || '';
      const url = `www.wildgvng.com.mx/artista?=${slug}`;
      navigator.clipboard.writeText(url).then(() => {
        const textEl = shareBtn.querySelector('.btn-text');
        if (textEl) textEl.textContent = '¡COPIADO!';
        shareBtn.classList.add('active');
        setTimeout(() => {
          if (textEl) textEl.textContent = 'COMPARTIR';
          shareBtn.classList.remove('active');
        }, 2000);
      });
    });
  }

  const copyBtn = document.getElementById('copy-url-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const slug = new URL(window.location.href).searchParams.get('') || '';
      const url = `www.wildgvng.com.mx/artista?=${slug}`;
      navigator.clipboard.writeText(url).then(() => {
        copyBtn.textContent = '¡COPIADO!';
        setTimeout(() => { copyBtn.textContent = 'COPIAR'; }, 2000);
      });
    });
  }
</script>
