---
import Layout from '../layouts/Layout.astro';
import { getArtistsFromDB } from '../data/artists';
import type { Artist } from '../data/artists';

const config = {
  name: "Wild Gvng - Artista",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
};

const url = new URL(Astro.request.url);
const slug = url.searchParams.get('') || '';

const artists = await getArtistsFromDB();
const artist = artists.find(a => a.slug === slug) || artists[0];

// Social icon map
const socialIcons: Record<string, string> = {
  instagram: '📸',
  spotify: '🎵',
  youtube: '▶️',
  tiktok: '🎭',
  twitter: '🐦',
  soundcloud: '☁️',
};
---

<Layout config={config}>
  <div class="artist-page">

    <!-- ═══ HERO BANNER ═══ -->
    <div class="hero">
      <img src={artist.imagenes.banner} alt="" class="hero-img" />
      <div class="hero-gradient"></div>
      <div class="hero-noise"></div>
      <div class="hero-grid"></div>
    </div>

    <!-- ═══ PROFILE CARD ═══ -->
    <div class="container">
      <div class="profile-card">
        <!-- Avatar -->
        <div class="avatar-wrapper">
          <img src={artist.imagenes.profile} alt={artist.nombre} class="avatar-img" />
          <div class="avatar-ring"></div>
          <div class="avatar-glow"></div>
        </div>

        <!-- Info -->
        <div class="profile-main">
          <div class="name-row">
            <h1 class="artist-name">{artist.nombre}</h1>
            <span class="verified-badge">✓</span>
          </div>
          <div class="genre-tags">
            {artist.estilo.split(' / ').map(g => (
              <span class="genre-tag">{g}</span>
            ))}
          </div>
          <span class="origin">📍 {artist.origen}</span>
        </div>

        <!-- Stats -->
        <div class="stats-row">
          <div class="stat">
            <span class="stat-value">{artist.stats.partnean}</span>
            <span class="stat-label">Partnean</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-value">{artist.stats.oyentes}</span>
            <span class="stat-label">Oyentes</span>
          </div>
          <div class="stat-divider"></div>
          <div class="stat">
            <span class="stat-value">{artist.tracks.length}</span>
            <span class="stat-label">Tracks</span>
          </div>
        </div>

        <!-- Actions -->
        <div class="actions-row">
          <button class="btn-action btn-partnear" id="partnear-btn">
            <span class="btn-icon">🔥</span>
            <span class="btn-text">PARTNEAR</span>
          </button>
          <button class="btn-action btn-share" id="share-btn">
            <span class="btn-icon">🔗</span>
            <span class="btn-text">COMPARTIR</span>
          </button>
        </div>
      </div>

      <!-- ═══ BIO ═══ -->
      {artist.bio && (
        <div class="section">
          <h2 class="section-label">SOBRE MÍ</h2>
          <p class="bio-text">{artist.bio}</p>
        </div>
      )}

      <!-- ═══ MUSIC ═══ -->
      {artist.tracks.length > 0 && (
        <div class="section">
          <h2 class="section-label">MÚSICA</h2>
          <div class="tracks-list">
            {artist.tracks.map((track, i) => (
              <div class="track-row">
                <span class="track-num">{String(i + 1).padStart(2, '0')}</span>
                <div class="track-info">
                  <span class="track-title">{track.title}</span>
                  <span class="track-dur">{track.duration}</span>
                </div>
                {track.spotify_url ? (
                  <a href={track.spotify_url} target="_blank" rel="noopener" class="track-play" title="Escuchar en Spotify">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </a>
                ) : (
                  <button class="track-play" disabled>
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </button>
                )}
              </div>
            ))}
          </div>
        </div>
      )}

      <!-- ═══ EVENTS ═══ -->
      <div class="section">
        <h2 class="section-label">PRÓXIMOS EVENTOS</h2>
        <div class="event-card">
          <div class="event-date-box">
            <span class="event-day">15</span>
            <span class="event-month">JUL</span>
          </div>
          <div class="event-details">
            <span class="event-name">Freestyle Friday</span>
            <span class="event-loc">📍 Bosque Venustiano Carranza</span>
          </div>
          <a href="https://maps.google.com" target="_blank" class="event-maps">MAPS →</a>
        </div>
        <p class="events-empty">Más eventos próximamente...</p>
      </div>

      <!-- ═══ SOCIAL LINKS ═══ -->
      {artist.redes && Object.keys(artist.redes).length > 0 && (
        <div class="section">
          <h2 class="section-label">REDES</h2>
          <div class="social-grid">
            {Object.entries(artist.redes).map(([platform, link]) => (
              <a href={link} target="_blank" rel="noopener" class="social-card">
                <span class="social-icon">{socialIcons[platform.toLowerCase()] || '🔗'}</span>
                <span class="social-name">{platform}</span>
                <span class="social-arrow">→</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <!-- ═══ SHARE PROFILE ═══ -->
      <div class="section share-section">
        <p class="share-label">Comparte el perfil de {artist.nombre}</p>
        <div class="share-box">
          <code class="share-url">www.wildgvng.com.mx/artista?={artist.slug}</code>
          <button class="share-copy" id="copy-url-btn">COPIAR</button>
        </div>
      </div>

      <!-- ═══ BACK LINK ═══ -->
      <div class="back-section">
        <a href="/artistas" class="back-link">← VOLVER AL ROSTER</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  /* ===== PAGE ===== */
  .artist-page {
    min-height: 100vh;
    background: #0a0a0a;
    overflow-x: hidden;
  }
  .container {
    max-width: 860px;
    margin: 0 auto;
    padding: 0 20px 80px;
  }

  /* ===== HERO ===== */
  .hero {
    position: relative;
    height: 340px;
    overflow: hidden;
  }
  .hero-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: brightness(0.5) saturate(1.2);
  }
  .hero-gradient {
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, #0a0a0a 0%, rgba(10,10,10,0.6) 40%, transparent 100%);
  }
  .hero-noise {
    position: absolute;
    inset: 0;
    opacity: 0.08;
    background: url('https://www.transparenttextures.com/patterns/stardust.png');
    mix-blend-mode: overlay;
  }
  .hero-grid {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(rgba(255,255,255,0.015) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.015) 1px, transparent 1px);
    background-size: 60px 60px;
  }

  /* ===== PROFILE CARD ===== */
  .profile-card {
    margin-top: -80px;
    position: relative;
    z-index: 20;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* Avatar */
  .avatar-wrapper {
    position: relative;
    width: 160px;
    height: 160px;
    border-radius: 24px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .avatar-img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    position: relative;
    z-index: 2;
  }
  .avatar-ring {
    position: absolute;
    inset: -3px;
    border-radius: 27px;
    border: 3px solid rgba(201,131,0,0.5);
    z-index: 1;
  }
  .avatar-glow {
    position: absolute;
    inset: -20px;
    border-radius: 40px;
    background: radial-gradient(circle, rgba(201,131,0,0.2) 0%, transparent 70%);
    z-index: 0;
    filter: blur(15px);
  }

  /* Name */
  .profile-main {
    margin-top: 20px;
  }
  .name-row {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
  }
  .artist-name {
    font-size: 2.2rem;
    font-weight: 900;
    color: #fff;
    text-transform: uppercase;
    letter-spacing: -0.02em;
    margin: 0;
  }
  .verified-badge {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    border-radius: 50%;
    background: linear-gradient(135deg, #C98300, #f59e0b);
    color: #000;
    font-size: 0.7rem;
    font-weight: 900;
    flex-shrink: 0;
  }
  .genre-tags {
    display: flex;
    gap: 8px;
    justify-content: center;
    margin-top: 10px;
    flex-wrap: wrap;
  }
  .genre-tag {
    padding: 5px 14px;
    border-radius: 100px;
    font-size: 0.6rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    background: rgba(201,131,0,0.12);
    border: 1px solid rgba(201,131,0,0.25);
    color: #C98300;
    font-family: monospace;
  }
  .origin {
    display: block;
    margin-top: 8px;
    font-size: 0.7rem;
    color: rgba(255,255,255,0.35);
  }

  /* Stats */
  .stats-row {
    display: flex;
    align-items: center;
    gap: 32px;
    margin-top: 24px;
    padding: 20px 32px;
    border-radius: 16px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
  }
  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
  .stat-value {
    font-size: 1.4rem;
    font-weight: 900;
    color: #fff;
  }
  .stat-label {
    font-size: 0.55rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: rgba(255,255,255,0.3);
  }
  .stat-divider {
    width: 1px;
    height: 32px;
    background: rgba(255,255,255,0.08);
  }

  /* Actions */
  .actions-row {
    display: flex;
    gap: 10px;
    margin-top: 20px;
  }
  .btn-action {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 12px 24px;
    border-radius: 14px;
    font-size: 0.65rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    font-family: inherit;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.04);
    color: rgba(255,255,255,0.5);
  }
  .btn-action:hover {
    border-color: rgba(201,131,0,0.4);
    color: #C98300;
    background: rgba(201,131,0,0.08);
    transform: translateY(-2px);
  }
  .btn-action.active {
    background: rgba(201,131,0,0.15);
    border-color: rgba(201,131,0,0.5);
    color: #C98300;
  }
  .btn-icon { font-size: 1rem; }

  /* ===== SECTIONS ===== */
  .section {
    margin-top: 48px;
    padding-top: 32px;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  .section-label {
    font-size: 0.6rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.25em;
    color: rgba(255,255,255,0.25);
    font-family: monospace;
    margin: 0 0 20px;
  }

  /* Bio */
  .bio-text {
    font-size: 0.95rem;
    color: rgba(255,255,255,0.6);
    line-height: 1.8;
    margin: 0;
  }

  /* Tracks */
  .tracks-list {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  .track-row {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 14px 16px;
    border-radius: 12px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.04);
    transition: all 0.2s;
  }
  .track-row:hover {
    background: rgba(255,255,255,0.05);
    border-color: rgba(201,131,0,0.15);
  }
  .track-num {
    font-size: 0.7rem;
    font-weight: 700;
    color: rgba(255,255,255,0.15);
    font-family: monospace;
    width: 24px;
    text-align: center;
  }
  .track-info {
    flex: 1;
    display: flex;
    justify-content: space-between;
    align-items: center;
    min-width: 0;
  }
  .track-title {
    font-size: 0.85rem;
    font-weight: 700;
    color: #fff;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .track-dur {
    font-size: 0.65rem;
    color: rgba(255,255,255,0.25);
    font-family: monospace;
    flex-shrink: 0;
    margin-left: 12px;
  }
  .track-play {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: rgba(201,131,0,0.12);
    border: none;
    color: #C98300;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.2s;
    flex-shrink: 0;
    text-decoration: none;
  }
  .track-play:hover {
    background: #C98300;
    color: #000;
    transform: scale(1.1);
  }
  .track-play:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  /* Event */
  .event-card {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 20px;
    border-radius: 16px;
    background: rgba(255,255,255,0.02);
    border: 1px solid rgba(255,255,255,0.05);
  }
  .event-date-box {
    text-align: center;
    min-width: 50px;
  }
  .event-day {
    display: block;
    font-size: 1.8rem;
    font-weight: 900;
    color: #C98300;
    line-height: 1;
  }
  .event-month {
    font-size: 0.55rem;
    font-weight: 700;
    text-transform: uppercase;
    color: rgba(255,255,255,0.3);
    letter-spacing: 0.1em;
  }
  .event-details { flex: 1; }
  .event-name {
    display: block;
    font-size: 0.9rem;
    font-weight: 700;
    color: #fff;
  }
  .event-loc {
    font-size: 0.65rem;
    color: rgba(255,255,255,0.3);
  }
  .event-maps {
    padding: 8px 16px;
    border-radius: 10px;
    font-size: 0.6rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: rgba(255,255,255,0.04);
    border: 1px solid rgba(255,255,255,0.08);
    color: rgba(255,255,255,0.5);
    text-decoration: none;
    transition: all 0.2s;
    flex-shrink: 0;
  }
  .event-maps:hover {
    border-color: rgba(201,131,0,0.4);
    color: #C98300;
  }
  .events-empty {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.15);
    margin-top: 12px;
  }

  /* Social */
  .social-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 10px;
  }
  .social-card {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 18px;
    border-radius: 14px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
    text-decoration: none;
    transition: all 0.2s;
  }
  .social-card:hover {
    border-color: rgba(201,131,0,0.3);
    background: rgba(201,131,0,0.06);
    transform: translateY(-2px);
  }
  .social-icon { font-size: 1.2rem; }
  .social-name {
    flex: 1;
    font-size: 0.75rem;
    font-weight: 700;
    color: #fff;
    text-transform: capitalize;
  }
  .social-arrow {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.2);
    transition: color 0.2s;
  }
  .social-card:hover .social-arrow { color: #C98300; }

  /* Share */
  .share-section { text-align: center; }
  .share-label {
    font-size: 0.7rem;
    color: rgba(255,255,255,0.25);
    margin: 0 0 14px;
  }
  .share-box {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 12px 20px;
    border-radius: 14px;
    background: rgba(255,255,255,0.03);
    border: 1px solid rgba(255,255,255,0.06);
  }
  .share-url {
    font-size: 0.65rem;
    color: rgba(255,255,255,0.4);
    font-family: monospace;
  }
  .share-copy {
    padding: 8px 16px;
    border-radius: 10px;
    font-size: 0.55rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: rgba(201,131,0,0.15);
    border: none;
    color: #C98300;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }
  .share-copy:hover {
    background: #C98300;
    color: #000;
  }

  /* Back */
  .back-section {
    margin-top: 48px;
    text-align: center;
  }
  .back-link {
    font-size: 0.6rem;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: rgba(255,255,255,0.25);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: #C98300; }

  /* ===== RESPONSIVE ===== */
  @media (max-width: 640px) {
    .hero { height: 220px; }
    .avatar-wrapper { width: 120px; height: 120px; }
    .artist-name { font-size: 1.6rem; }
    .stats-row { gap: 20px; padding: 16px 20px; }
    .stat-value { font-size: 1.1rem; }
    .actions-row { width: 100%; }
    .btn-action { flex: 1; justify-content: center; }
    .social-grid { grid-template-columns: 1fr; }
    .event-card { flex-direction: column; text-align: center; }
    .event-maps { width: 100%; text-align: center; }
  }

  /* ===== ANIMATIONS ===== */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
</style>

<script>
  // Partnear toggle
  const partnearBtn = document.getElementById('partnear-btn');
  let isPartnear = false;
  if (partnearBtn) {
    partnearBtn.addEventListener('click', () => {
      isPartnear = !isPartnear;
      partnearBtn.classList.toggle('active', isPartnear);
      const textEl = partnearBtn.querySelector('.btn-text');
      if (textEl) textEl.textContent = isPartnear ? 'PARTEANDO' : 'PARTNEAR';
    });
  }

  // Share URL
  const shareBtn = document.getElementById('share-btn');
  if (shareBtn) {
    shareBtn.addEventListener('click', () => {
      const slug = new URL(window.location.href).searchParams.get('') || '';
      const url = `www.wildgvng.com.mx/artista?=${slug}`;
      navigator.clipboard.writeText(url).then(() => {
        const textEl = shareBtn.querySelector('.btn-text');
        if (textEl) textEl.textContent = '¡COPIADO!';
        shareBtn.classList.add('active');
        setTimeout(() => {
          if (textEl) textEl.textContent = 'COMPARTIR';
          shareBtn.classList.remove('active');
        }, 2000);
      });
    });
  }

  // Copy URL button
  const copyBtn = document.getElementById('copy-url-btn');
  if (copyBtn) {
    copyBtn.addEventListener('click', () => {
      const slug = new URL(window.location.href).searchParams.get('') || '';
      const url = `www.wildgvng.com.mx/artista?=${slug}`;
      navigator.clipboard.writeText(url).then(() => {
        copyBtn.textContent = '¡COPIADO!';
        setTimeout(() => { copyBtn.textContent = 'COPIAR'; }, 2000);
      });
    });
  }
</script>
