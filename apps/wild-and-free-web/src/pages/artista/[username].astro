---
import Layout from '../../layouts/Layout.astro';
import { getArtistsFromDB, getArtistPosts } from '../../data/artists';
import type { Artist, ArtistPost } from '../../data/artists';

export async function getStaticPaths() {
  const artists = await getArtistsFromDB();
  return artists.map((a: Artist) => ({
    params: { username: a.slug },
    props: { artist: a, posts: [] as ArtistPost[] },
  }));
}

const { username } = Astro.params;
// Fetch artists from Supabase at build time
const artists = await getArtistsFromDB();
const artist = artists.find((a: Artist) => a.slug === username) || artists[0];

let posts: ArtistPost[] = [];
if (artist) {
  posts = await getArtistPosts(artist.id);
}

// Fetch real reaction counts for crew posts
let postsWithCounts: ArtistPost[] = [];
try {
  const { data: feedPosts } = await supabase
    .rpc('get_crew_feed', {
      p_author_id: artist?.id || '',
      p_limit: 20,
      p_offset: 0,
      p_user_id: null,
    });
  
  if (feedPosts && feedPosts.length > 0) {
    postsWithCounts = feedPosts.map((p: any) => ({
      id: p.id,
      artist_id: p.author_id,
      content: p.content || '',
      post_type: p.post_type || 'general',
      image_url: p.image_url,
      embed_url: null,
      embed_title: p.title || null,
      likes_count: Number(p.likes_count) || 0,
      comments_count: Number(p.comments_count) || 0,
      reposts_count: Number(p.reposts_count) || 0,
      is_pinned: false,
      created_at: p.published_at || p.created_at,
    }));
  }
} catch (e) {
  console.warn('[artist] Could not fetch feed counts, using defaults');
}

// Use real counts if available, otherwise fallback to posts from getArtistPosts
if (postsWithCounts.length > 0) {
  posts = postsWithCounts;
}

function timeAgo(dateStr: string): string {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 60) return `${mins}m`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h`;
  const days = Math.floor(hrs / 24);
  if (days < 7) return `${days}d`;
  return `${Math.floor(days / 7)}sem`;
}
---

<Layout config={{ name: `Wild Gvng - ${artist.nombre}`, primary_color: "#C98300", secondary_color: "#8A0303" }}>
  <div class="ap" data-artist-id="{artist.id}">

    <!-- PROFILE HEADER -->
    <div class="ap-header">
      <div class="ap-header-inner">
        <div class="ap-avatar">
          {artist.imagenes.profile ? (
            <img src={artist.imagenes.profile} alt={artist.nombre} />
          ) : (
            <div class="ap-avatar-initials">{artist.nombre.substring(0, 2).toUpperCase()}</div>
          )}
        </div>
        <div class="ap-info">
          <div class="ap-name-row">
            <h1 class="ap-name">{artist.nombre}</h1>
            <span class="ap-verified">✓</span>
          </div>
          <div class="ap-genres">
            {artist.estilo.split(' / ').map((g: string) => (
              <span class="ap-chip">{g}</span>
            ))}
          </div>
          <div class="ap-meta">
            <span>{artist.origen}</span>
            <span class="dot">·</span>
            <span>{artist.stats.partnean} Partnean</span>
            <span class="dot">·</span>
            <span>{artist.stats.oyentes} oyentes</span>
          </div>
          {artist.tags && artist.tags.length > 0 && (
            <div class="ap-tags">
              {artist.tags.map((tag: any) => (
                <span class={`tag-badge tag-sm ${tag.animation && tag.animation !== 'none' ? `tag-anim-${tag.animation}` : ''}`} style={`--tag-c: ${tag.color}`}><span class="tag-badge-dot"></span>{tag.name}</span>
              ))}
            </div>
          )}
          <div class="ap-actions">
            <button class="btn-p btn-gold" id="partnear-btn">PARTNEAR</button>
            <button class="btn-p btn-ghost" id="share-btn">COMPARTIR</button>
          </div>
        </div>
      </div>
    </div>

    <!-- TWO COLUMNS -->
    <div class="ap-body">
      <div class="ap-grid">

        <!-- LEFT (25%) SIDEBAR -->
        <aside class="ap-side">
          <div class="side-card">
            <div class="side-avatar-wrap">
              {artist.imagenes.profile ? (
                <img src={artist.imagenes.profile} alt={artist.nombre} class="side-avatar" />
              ) : (
                <div class="side-avatar side-avatar-initials">{artist.nombre.substring(0, 2).toUpperCase()}</div>
              )}
            </div>
            <h2 class="side-name">{artist.nombre}</h2>
            <div class="side-genres">
              {artist.estilo.split(' / ').map((g: string) => (
                <span class="side-chip">{g}</span>
              ))}
            </div>
            <div class="side-bio">{artist.bio}</div>

            {artist.tags && artist.tags.length > 0 && (
              <div class="side-tags">
                {artist.tags.map((tag: any) => (
                  <span class={`tag-badge ${tag.animation && tag.animation !== 'none' ? `tag-anim-${tag.animation}` : ''}`} style={`--tag-c: ${tag.color}`}><span class="tag-badge-dot"></span>{tag.name}</span>
                ))}
              </div>
            )}

            <div class="side-stats">
              <div class="side-stat"><span class="num">{artist.stats.partnean}</span> Partnean</div>
              <div class="side-stat"><span class="num">{artist.stats.seguidores}</span> Seguidores</div>
              <div class="side-stat"><span class="num">{artist.stats.oyentes}</span> Oyentes</div>
              <div class="side-stat"><span class="num">{artist.tracks.length}</span> Tracks</div>
            </div>

            {artist.redes && Object.keys(artist.redes).length > 0 && (
              <div class="side-links">
                {Object.entries(artist.redes).map(([name, url]: [string, string]) => (
                  <a href={url} target="_blank" class="side-link">{name}</a>
                ))}
              </div>
            )}
          </div>
        </aside>

        <!-- RIGHT (75%) FEED -->
        <main class="ap-feed">

          <!-- TABS -->
          <div class="feed-tabs">
            <button class="feed-tab active" data-tab="feed">Feed</button>
            <button class="feed-tab" data-tab="music">Música</button>
            <button class="feed-tab" data-tab="exclusive">Exclusivo</button>
          </div>

          <!-- Feed Tab -->
          <div class="feed-content active" id="tab-feed">
            {posts.length === 0 && artist.tracks.length === 0 ? (
              <div class="feed-empty">
                <div class="empty-icon">📝</div>
                <p class="empty-title">Aún no hay publicaciones</p>
                <p class="empty-sub">Este artista no ha compartido contenido aún.</p>
              </div>
            ) : (
              <>
                {posts.map(p => (
                  <article class="feed-post" key={p.id}>
                    <div class="post-header">
                      <div class="post-avatar-sm">
                        {artist.imagenes.profile ? (
                          <img src={artist.imagenes.profile} alt={artist.nombre} />
                        ) : (
                          <span>{artist.nombre.substring(0, 2).toUpperCase()}</span>
                        )}
                      </div>
                      <div class="post-author">
                        <strong>{artist.nombre}</strong>
                        <span class="post-time">{timeAgo(p.created_at)}</span>
                      </div>
                    </div>
                    <div class="post-body">
                      <p>{p.content}</p>
                      {p.image_url && (
                        <div class="post-img-wrap">
                          <img src={p.image_url} alt="" loading="lazy" />
                        </div>
                      )}
                      {p.embed_url && (
                        <div class="post-embed">
                          <div class="embed-placeholder">
                            <span class="embed-icon">🎵</span>
                            <span class="embed-title">{p.embed_title || 'Escuchar'}</span>
                          </div>
                        </div>
                      )}
                    </div>
                    <div class="post-actions-bar">
                      <button class="post-action like-btn" data-post-id={p.id}>
                        <span class="action-icon">❤️</span>
                        <span class="action-count">{p.likes_count}</span>
                      </button>
                      <button class="post-action comment-btn" data-post-id={p.id}>
                        <span class="action-icon">💬</span>
                        <span class="action-count">{p.comments_count}</span>
                      </button>
                      <button class="post-action repost-btn" data-post-id={p.id}>
                        <span class="action-icon">🔄</span>
                        <span class="action-count">0</span>
                      </button>
                      <button class="post-action share-btn" data-post-id={p.id}>
                        <span class="action-icon">📤</span>
                      </button>
                    </div>
                  </article>
                ))}
                {artist.tracks.map(t => (
                  <article class="feed-post" key={t.title}>
                    <div class="post-header">
                      <div class="post-avatar-sm">
                        {artist.imagenes.profile ? (
                          <img src={artist.imagenes.profile} alt={artist.nombre} />
                        ) : (
                          <span>{artist.nombre.substring(0, 2).toUpperCase()}</span>
                        )}
                      </div>
                      <div class="post-author">
                        <strong>{artist.nombre}</strong>
                        <span class="post-time">Track</span>
                      </div>
                    </div>
                    <div class="post-body">
                      <p>Nuevo track: <strong>{t.title}</strong></p>
                      <div class="post-embed">
                        <div class="embed-placeholder">
                          <span class="embed-icon">🎵</span>
                          <span class="embed-title">{t.title} · {t.duration}</span>
                        </div>
                      </div>
                    </div>
                  </article>
                ))}
              </>
            )}
          </div>

          <!-- Exclusive Content Tab -->
          <div class="feed-content" id="tab-exclusive">
            <div id="exclusive-content-root">
              <div class="feed-empty">
                <div class="empty-icon">🔒</div>
                <p class="empty-title">Contenido Exclusivo</p>
                <p class="empty-sub">Cargando contenido exclusivo...</p>
              </div>
            </div>
          </div>

          <!-- Music Tab -->
          <div class="feed-content" id="tab-music">
            {artist.tracks.length === 0 ? (
              <div class="feed-empty">
                <div class="empty-icon">🎵</div>
                <p class="empty-title">Sin tracks</p>
                <p class="empty-sub">Este artista no ha subido música aún.</p>
              </div>
            ) : (
              <div class="music-list">
                {artist.tracks.map(t => (
                  <div class="music-item">
                    <div class="music-cover">
                      <span>🎵</span>
                    </div>
                    <div class="music-info">
                      <strong>{t.title}</strong>
                      <span>{t.duration}</span>
                    </div>
                    {t.spotify_url && (
                      <a href={t.spotify_url} target="_blank" class="music-play">▶</a>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>

        </main>
      </div>
    </div>
  </div>
</Layout>

<style>
  .ap { min-height: 100vh; background: var(--bg); }
  .ap-header {
    background: linear-gradient(135deg, rgba(201,131,0,0.12), rgba(0,0,0,0.4));
    border-bottom: 1px solid var(--border);
    padding: 48px 24px 32px;
  }
  .ap-header-inner { max-width: 1200px; margin: 0 auto; display: flex; gap: 28px; align-items: center; }
  .ap-avatar { width: 100px; height: 100px; border-radius: 50%; overflow: hidden; border: 3px solid var(--primary); flex-shrink: 0; }
  .ap-avatar img { width: 100%; height: 100%; object-fit: cover; }
  .ap-avatar-initials { width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: var(--bg-card); font-size: 1.8rem; font-weight: 900; color: var(--primary); }
  .ap-info { display: flex; flex-direction: column; gap: 6px; }
  .ap-name-row { display: flex; align-items: center; gap: 8px; }
  .ap-name { font-size: 1.8rem; font-weight: 900; color: var(--text); margin: 0; text-transform: uppercase; }
  .ap-verified { color: var(--primary); font-size: 1.2rem; }
  .ap-genres { display: flex; gap: 6px; flex-wrap: wrap; }
  .ap-chip { padding: 3px 10px; border-radius: 100px; font-size: 0.55rem; font-weight: 800; letter-spacing: 0.1em; text-transform: uppercase; background: var(--primary-soft); color: var(--primary); border: 1px solid var(--primary-border); }
  .ap-meta { font-size: 0.65rem; color: var(--text-secondary); display: flex; gap: 6px; flex-wrap: wrap; align-items: center; }
  .dot { color: var(--text-muted); }
  .ap-tags { display: flex; gap: 4px; flex-wrap: wrap; }
  .ap-actions { display: flex; gap: 8px; margin-top: 4px; }
  .btn-p { padding: 8px 20px; border-radius: 100px; font-size: 0.6rem; font-weight: 900; letter-spacing: 0.15em; text-transform: uppercase; border: none; cursor: pointer; transition: all 0.2s; font-family: inherit; }
  .btn-gold { background: var(--primary); color: var(--bg); }
  .btn-gold:hover { background: var(--primary-hover); }
  .btn-ghost { background: transparent; border: 1px solid var(--border); color: var(--text); }
  .btn-ghost:hover { border-color: var(--primary); color: var(--primary); }

  .ap-body { max-width: 1200px; margin: 0 auto; padding: 0 24px 60px; margin-top: -20px; position: relative; z-index: 2; }
  .ap-grid { display: grid; grid-template-columns: 1fr 2.5fr; gap: 24px; align-items: start; }

  .ap-side { position: sticky; top: 90px; }
  .side-card { background: var(--bg-card); border: 1px solid var(--border); border-radius: 20px; padding: 24px; display: flex; flex-direction: column; align-items: center; gap: 10px; text-align: center; }
  .side-avatar-wrap { width: 120px; height: 120px; border-radius: 50%; overflow: hidden; border: 3px solid var(--primary); }
  .side-avatar { width: 100%; height: 100%; object-fit: cover; }
  .side-avatar-initials { display: flex; align-items: center; justify-content: center; background: var(--bg-card); font-size: 2rem; font-weight: 900; color: var(--primary); }
  .side-name { font-size: 1.2rem; font-weight: 900; color: var(--text); text-transform: uppercase; margin: 0; }
  .side-genres { display: flex; gap: 4px; flex-wrap: wrap; justify-content: center; }
  .side-chip { padding: 2px 8px; border-radius: 100px; font-size: 0.5rem; font-weight: 700; text-transform: uppercase; background: var(--primary-soft); color: var(--primary); }
  .side-bio { font-size: 0.75rem; color: var(--text-secondary); line-height: 1.5; }
  .side-tags { display: flex; gap: 4px; flex-wrap: wrap; justify-content: center; }
  .side-stats { display: grid; grid-template-columns: 1fr 1fr; gap: 8px; width: 100%; margin-top: 8px; }
  .side-stat { background: var(--bg); border: 1px solid var(--border-faint); border-radius: 10px; padding: 10px; font-size: 0.55rem; font-weight: 700; text-transform: uppercase; color: var(--text-muted); }
  .side-stat .num { font-size: 1rem; font-weight: 900; color: var(--text); display: block; }
  .side-links { display: flex; flex-wrap: wrap; gap: 6px; justify-content: center; }
  .side-link { font-size: 0.55rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.1em; padding: 4px 10px; border-radius: 100px; background: var(--bg); border: 1px solid var(--border-faint); color: var(--text); text-decoration: none; }
  .side-link:hover { border-color: var(--primary); color: var(--primary); }

  .ap-feed { display: flex; flex-direction: column; gap: 16px; }
  .feed-tabs { display: flex; gap: 4px; background: var(--bg-card); border: 1px solid var(--border); border-radius: 14px; padding: 4px; }
  .feed-tab { flex: 1; padding: 10px; border: none; background: transparent; color: var(--text-muted); font-size: 0.6rem; font-weight: 900; text-transform: uppercase; letter-spacing: 0.12em; border-radius: 10px; cursor: pointer; transition: all 0.15s; font-family: inherit; }
  .feed-tab.active { background: var(--bg); color: var(--text); }
  .feed-content { display: none; flex-direction: column; gap: 12px; }
  .feed-content.active { display: flex; }

  .feed-empty { text-align: center; padding: 40px 20px; border: 1px solid var(--border); border-radius: 16px; background: var(--bg-card); }
  .empty-icon { font-size: 2rem; margin-bottom: 8px; }
  .empty-title { font-size: 0.85rem; font-weight: 900; color: var(--text); margin: 0; }
  .empty-sub { font-size: 0.7rem; color: var(--text-muted); margin: 4px 0 0; }

  .feed-post { background: var(--bg-card); border: 1px solid var(--border); border-radius: 16px; padding: 20px; }
  .post-header { display: flex; gap: 10px; align-items: center; margin-bottom: 12px; }
  .post-avatar-sm { width: 36px; height: 36px; border-radius: 50%; overflow: hidden; border: 2px solid var(--primary); flex-shrink: 0; display: flex; align-items: center; justify-content: center; background: var(--bg-card); font-weight: 900; font-size: 0.65rem; color: var(--primary); }
  .post-avatar-sm img { width: 100%; height: 100%; object-fit: cover; }
  .post-author { display: flex; flex-direction: column; }
  .post-author strong { font-size: 0.75rem; color: var(--text); }
  .post-time { font-size: 0.55rem; color: var(--text-muted); }
  .post-body p { font-size: 0.85rem; color: var(--text); line-height: 1.6; margin: 0 0 12px; }
  .post-img-wrap { border-radius: 12px; overflow: hidden; margin-bottom: 8px; }
  .post-img-wrap img { width: 100%; height: auto; max-height: 400px; object-fit: cover; }
  .post-embed { border: 1px solid var(--border-faint); border-radius: 12px; overflow: hidden; }
  .embed-placeholder { display: flex; align-items: center; gap: 12px; padding: 16px; background: var(--bg); }
  .embed-icon { font-size: 1.4rem; }
  .embed-title { font-weight: 700; font-size: 0.75rem; color: var(--text); }

  .post-actions-bar { display: flex; gap: 16px; margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border-faint); }
  .post-action { display: flex; align-items: center; gap: 4px; background: none; border: 1px solid var(--border-faint); border-radius: 8px; padding: 6px 10px; font-size: 0.6rem; font-weight: 700; color: var(--text-secondary); cursor: pointer; transition: all 0.15s; font-family: inherit; }
  .post-action:hover { border-color: var(--border); color: var(--text); background: var(--bg-hover); }
  .action-icon { font-size: 0.8rem; }
  .action-count { font-size: 0.6rem; }

  .music-list { display: flex; flex-direction: column; gap: 6px; }
  .music-item { display: flex; align-items: center; gap: 12px; padding: 12px; background: var(--bg-card); border: 1px solid var(--border-faint); border-radius: 12px; }
  .music-cover { width: 40px; height: 40px; border-radius: 8px; background: var(--bg); display: flex; align-items: center; justify-content: center; font-size: 1.2rem; }
  .music-info { flex: 1; }
  .music-info strong { display: block; font-size: 0.75rem; color: var(--text); }
  .music-info span { font-size: 0.6rem; color: var(--text-muted); }
  .music-play { width: 36px; height: 36px; border-radius: 50%; background: var(--primary); color: var(--bg); display: flex; align-items: center; justify-content: center; font-size: 0.7rem; text-decoration: none; }

  .post-action.liked { border-color: var(--danger); color: var(--danger); background: rgba(255,68,68,0.08); }
  .post-action.reposted { border-color: var(--success); color: var(--success); background: rgba(0,255,136,0.08); }

  .comment-section { margin-top: 12px; padding-top: 12px; border-top: 1px solid var(--border-faint); }
  .comment-list { max-height: 300px; overflow-y: auto; margin-bottom: 12px; }
  .comment-loading, .comment-empty { font-size: 0.65rem; color: var(--text-muted); padding: 12px; text-align: center; }
  .comment-item { display: flex; gap: 8px; padding: 8px 0; border-bottom: 1px solid var(--border-faint); }
  .comment-item:last-child { border-bottom: none; }
  .comment-avatar { width: 28px; height: 28px; border-radius: 50%; background: var(--bg-card); display: flex; align-items: center; justify-content: center; font-size: 0.5rem; font-weight: 900; color: var(--primary); flex-shrink: 0; background-size: cover; background-position: center; }
  .comment-body { flex: 1; }
  .comment-author { font-size: 0.6rem; font-weight: 800; color: var(--text); }
  .comment-time { font-size: 0.5rem; color: var(--text-muted); font-weight: 400; }
  .comment-text { font-size: 0.7rem; color: var(--text-secondary); margin-top: 2px; }
  .comment-form { display: flex; gap: 8px; }
  .comment-input { flex: 1; padding: 8px 12px; border-radius: 8px; border: 1px solid var(--border-faint); background: var(--bg); color: var(--text); font-size: 0.7rem; font-family: inherit; outline: none; }
  .comment-input:focus { border-color: var(--primary); }
  .comment-send { padding: 8px 16px; border-radius: 8px; border: none; background: var(--primary); color: var(--bg); font-size: 0.6rem; font-weight: 900; text-transform: uppercase; cursor: pointer; font-family: inherit; }
  .comment-send:hover { background: var(--primary-hover); }

  .exclusive-header {
    display: flex;
    justify-content: flex-end;
    margin-bottom: 16px;
  }
  .exclusive-balance {
    font-size: 0.7rem;
    color: var(--text-secondary);
    background: var(--bg-card);
    padding: 6px 14px;
    border-radius: 100px;
    border: 1px solid var(--border-faint);
  }
  .exclusive-balance strong {
    color: var(--primary);
  }
  .exclusive-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 12px;
  }
  .exclusive-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    display: flex;
    flex-direction: column;
  }
  .exclusive-preview {
    width: 100%;
    height: 180px;
    overflow: hidden;
  }
  .exclusive-preview img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .exclusive-info {
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .exclusive-title {
    font-size: 0.85rem;
    font-weight: 900;
    color: var(--text);
    text-transform: uppercase;
    margin: 0;
  }
  .exclusive-desc {
    font-size: 0.7rem;
    color: var(--text-secondary);
    line-height: 1.5;
  }
  .exclusive-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .exclusive-type {
    color: var(--primary);
    background: var(--primary-soft);
    padding: 2px 8px;
    border-radius: 100px;
  }
  .exclusive-price {
    color: var(--text-muted);
  }
  .exclusive-btn {
    width: 100%;
    padding: 10px;
    border: none;
    border-radius: 100px;
    font-size: 0.65rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
    text-align: center;
    text-decoration: none;
  }
  .exclusive-btn--unlocked {
    background: var(--success);
    color: #000;
    display: block;
  }
  .exclusive-btn--unlocked:hover {
    opacity: 0.8;
  }
  .exclusive-btn--buy {
    background: var(--primary);
    color: var(--bg);
  }
  .exclusive-btn--buy:hover {
    background: var(--primary-hover);
  }
  .exclusive-btn--locked {
    background: var(--bg-card);
    color: var(--text-muted);
    cursor: not-allowed;
    border: 1px solid var(--border-faint);
  }

  @media (max-width: 768px) {
    .ap-grid { grid-template-columns: 1fr; }
    .ap-side { position: static; }
    .ap-header-inner { flex-direction: column; text-align: center; }
    .ap-actions { justify-content: center; }
    .ap-body { margin-top: 0; }
    .ap-header { padding: 24px 16px; }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  (async function() {
    const { data: { session } } = await supabase.auth.getSession();
    const currentUserId = session?.user?.id;

    // Tabs
    document.querySelectorAll('.feed-tab').forEach(tab => {
      tab.addEventListener('click', function() {
        document.querySelectorAll('.feed-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.feed-content').forEach(c => c.classList.remove('active'));
        this.classList.add('active');
        const target = document.getElementById('tab-' + this.dataset.tab);
        if (target) target.classList.add('active');
      });
    });

    // Partnear button
    const partnearBtn = document.getElementById('partnear-btn');
    if (partnearBtn) {
      partnearBtn.addEventListener('click', async () => {
        if (!currentUserId) {
          window.location.href = '/login';
          return;
        }
        const active = partnearBtn.classList.toggle('active');
        partnearBtn.textContent = active ? 'PARTNEANDO' : 'PARTNEAR';
        partnearBtn.classList.toggle('btn-gold', !active);
        partnearBtn.classList.toggle('btn-ghost', active);
      });
    }

    // Share
    document.getElementById('share-btn')?.addEventListener('click', () => {
      if (navigator.share) {
        navigator.share({ url: window.location.href, title: document.title });
      } else {
        navigator.clipboard?.writeText(window.location.href);
        const btn = document.getElementById('share-btn');
        const orig = btn?.textContent;
        if (btn) btn.textContent = 'COPIADO';
        setTimeout(() => { if (btn) btn.textContent = orig; }, 2000);
      }
    });

    // --- FEED INTERACTIONS (Likes, Comments, Reposts) ---
    async function toggleLike(postId: string, btn: HTMLElement) {
      if (!currentUserId) { window.location.href = '/login'; return; }

      const countEl = btn.querySelector('.action-count');
      const isLiked = btn.classList.contains('liked');

      const { data: liked } = await supabase.rpc('toggle_like', {
        p_post_id: postId,
        p_user_id: currentUserId,
      });

      if (liked) {
        btn.classList.add('liked');
        btn.style.borderColor = 'var(--danger)';
        btn.style.color = 'var(--danger)';
        if (countEl) countEl.textContent = String(parseInt(countEl.textContent || '0') + 1);
      } else {
        btn.classList.remove('liked');
        btn.style.borderColor = '';
        btn.style.color = '';
        if (countEl) countEl.textContent = String(Math.max(0, parseInt(countEl.textContent || '0') - 1));
      }
    }

    async function toggleRepost(postId: string, btn: HTMLElement) {
      if (!currentUserId) { window.location.href = '/login'; return; }

      const countEl = btn.querySelector('.action-count');
      const isReposted = btn.classList.contains('reposted');

      const { data: reposted } = await supabase.rpc('toggle_repost', {
        p_post_id: postId,
        p_user_id: currentUserId,
      });

      if (reposted) {
        btn.classList.add('reposted');
        btn.style.borderColor = 'var(--success)';
        btn.style.color = 'var(--success)';
        if (countEl) countEl.textContent = String(parseInt(countEl.textContent || '0') + 1);
      } else {
        btn.classList.remove('reposted');
        btn.style.borderColor = '';
        btn.style.color = '';
        if (countEl) countEl.textContent = String(Math.max(0, parseInt(countEl.textContent || '0') - 1));
      }
    }

    async function openComments(postId: string) {
      if (!currentUserId) { window.location.href = '/login'; return; }

      // Toggle comment section below the post
      let commentSection = document.getElementById(`comments-${postId}`);
      if (commentSection) {
        commentSection.style.display = commentSection.style.display === 'none' ? 'block' : 'none';
        return;
      }

      // Create comment section
      const postEl = document.querySelector(`[data-post-id="${postId}"]`)?.closest('.feed-post');
      if (!postEl) return;

      commentSection = document.createElement('div');
      commentSection.id = `comments-${postId}`;
      commentSection.className = 'comment-section';
      commentSection.innerHTML = `
        <div class="comment-list" id="comment-list-${postId}">
          <div class="comment-loading">Cargando comentarios...</div>
        </div>
        <div class="comment-form">
          <input type="text" id="comment-input-${postId}" placeholder="Escribe un comentario..." class="comment-input" />
          <button class="comment-send" data-post-id="${postId}">Enviar</button>
        </div>
      `;
      postEl.appendChild(commentSection);

      // Load comments
      const { data: comments } = await supabase
        .from('wall_comments')
        .select('id, content, created_at, user_id')
        .eq('post_id', postId)
        .is('deleted_at', null)
        .order('created_at', { ascending: true });

      // Load profiles for comment authors
      const userIds = [...new Set(comments?.map(c => c.user_id) || [])];
      let profiles: any[] = [];
      if (userIds.length > 0) {
        const { data: p } = await supabase.from('profiles').select('id, nombre, username, avatar_url').in('id', userIds);
        profiles = p || [];
      }

      const list = document.getElementById(`comment-list-${postId}`);
      if (list) {
        if (!comments || comments.length === 0) {
          list.innerHTML = '<div class="comment-empty">Sin comentarios aún. Sé el primero.</div>';
        } else {
          list.innerHTML = comments.map(c => {
            const profile = profiles.find(p => p.id === c.user_id);
            const name = profile?.nombre || profile?.username || 'Anónimo';
            const initials = name.substring(0, 2).toUpperCase();
            const avatar = profile?.avatar_url;
            const timeAgo = getTimeAgo(c.created_at);
            return `
              <div class="comment-item">
                <div class="comment-avatar" style="${avatar ? `background-image:url(${avatar})` : ''}">${avatar ? '' : initials}</div>
                <div class="comment-body">
                  <div class="comment-author">${name} <span class="comment-time">${timeAgo}</span></div>
                  <div class="comment-text">${c.content}</div>
                </div>
              </div>
            `;
          }).join('');
        }
      }

      // Send comment
      const sendBtn = commentSection.querySelector('.comment-send');
      const input = document.getElementById(`comment-input-${postId}`) as HTMLInputElement;
      sendBtn?.addEventListener('click', async () => {
        const text = input?.value?.trim();
        if (!text) return;
        const { error } = await supabase.from('wall_comments').insert({
          post_id: postId,
          user_id: currentUserId,
          content: text,
        });
        if (!error) {
          input.value = '';
          // Reload comments
          openComments(postId);
          // Update count
          const commentBtn = document.querySelector(`[data-post-id="${postId}"]`);
          const countEl = commentBtn?.closest('.post-actions-bar')?.querySelector('.comment-btn .action-count');
          if (countEl) countEl.textContent = String(parseInt(countEl.textContent || '0') + 1);
        }
      });
    }

    function getTimeAgo(dateStr: string): string {
      const diff = Date.now() - new Date(dateStr).getTime();
      const mins = Math.floor(diff / 60000);
      if (mins < 60) return `${mins}m`;
      const hrs = Math.floor(mins / 60);
      if (hrs < 24) return `${hrs}h`;
      const days = Math.floor(hrs / 24);
      return `${days}d`;
    }

    // Attach event listeners to post action buttons
    document.querySelectorAll('.like-btn').forEach(btn => {
      const postId = btn.getAttribute('data-post-id');
      if (postId) btn.addEventListener('click', () => toggleLike(postId, btn as HTMLElement));
    });

    document.querySelectorAll('.repost-btn').forEach(btn => {
      const postId = btn.getAttribute('data-post-id');
      if (postId) btn.addEventListener('click', () => toggleRepost(postId, btn as HTMLElement));
    });

    document.querySelectorAll('.comment-btn').forEach(btn => {
      const postId = btn.getAttribute('data-post-id');
      if (postId) btn.addEventListener('click', () => openComments(postId));
    });

    // Follow button - check if user already follows this artist
    const artistId = document.querySelector('[data-artist-id]')?.getAttribute('data-artist-id');
    if (currentUserId && artistId && artistId !== currentUserId) {
      const { data: existingFollow } = await supabase
        .from('follows')
        .select('id')
        .eq('follower_id', currentUserId)
        .eq('following_id', artistId)
        .single();

      const partnearBtn = document.getElementById('partnear-btn');
      if (partnearBtn && existingFollow) {
        partnearBtn.classList.add('active');
        partnearBtn.textContent = 'PARTNEANDO';
        partnearBtn.classList.remove('btn-gold');
        partnearBtn.classList.add('btn-ghost');
      }

      if (partnearBtn) {
        partnearBtn.addEventListener('click', async () => {
          const isActive = partnearBtn.classList.contains('active');
          if (isActive) {
            await supabase.from('follows').delete().eq('follower_id', currentUserId).eq('following_id', artistId);
            partnearBtn.classList.remove('active');
            partnearBtn.textContent = 'PARTNEAR';
            partnearBtn.classList.add('btn-gold');
            partnearBtn.classList.remove('btn-ghost');
          } else {
            await supabase.from('follows').insert({ follower_id: currentUserId, following_id: artistId });
            partnearBtn.classList.add('active');
            partnearBtn.textContent = 'PARTNEANDO';
            partnearBtn.classList.remove('btn-gold');
            partnearBtn.classList.add('btn-ghost');
          }
        });
      }
    }

    // ── EXCLUSIVE CONTENT ──
    async function loadExclusiveContent() {
      const root = document.getElementById('exclusive-content-root');
      if (!root || !artistId) return;

      const { data: content, error } = await supabase
        .from('exclusive_content')
        .select('*')
        .eq('user_id', artistId)
        .eq('status', 'published')
        .order('created_at', { ascending: false });

      if (error || !content || content.length === 0) {
        root.innerHTML = `
          <div class="feed-empty">
            <div class="empty-icon">🔒</div>
            <p class="empty-title">Sin contenido exclusivo aún</p>
            <p class="empty-sub">Este artista no ha publicado contenido exclusivo.</p>
          </div>`;
        return;
      }

      // Get user's token balance
      let userBalance = 0;
      if (currentUserId) {
        const { data: tokens } = await supabase
          .from('user_tokens')
          .select('balance')
          .eq('user_id', currentUserId)
          .single();
        userBalance = tokens?.balance || 0;
      }

      // Get user's purchases
      let purchasedIds: string[] = [];
      if (currentUserId) {
        const { data: purchases } = await supabase
          .from('content_purchases')
          .select('content_id')
          .eq('user_id', currentUserId);
        purchasedIds = purchases?.map(p => p.content_id) || [];
      }

      root.innerHTML = `
        <div class="exclusive-header">
          <span class="exclusive-balance">💰 Tu saldo: <strong>${userBalance} tokens</strong></span>
        </div>
        <div class="exclusive-grid">
          ${content.map(item => {
            const isPurchased = purchasedIds.includes(item.id);
            const canAfford = userBalance >= (item.token_price || 0);
            return `
              <div class="exclusive-card" data-content-id="${item.id}">
                ${item.preview_url ? `<div class="exclusive-preview"><img src="${item.preview_url}" alt="${item.title}" loading="lazy" /></div>` : ''}
                <div class="exclusive-info">
                  <h4 class="exclusive-title">${item.title}</h4>
                  <p class="exclusive-desc">${item.description || ''}</p>
                  <div class="exclusive-meta">
                    <span class="exclusive-type">${item.content_type.toUpperCase()}</span>
                    <span class="exclusive-price">${item.token_price || 0} tokens</span>
                  </div>
                  ${isPurchased
                    ? `<a href="${item.file_url || '#'}" target="_blank" class="exclusive-btn exclusive-btn--unlocked">🔓 Acceder</a>`
                    : `<button class="exclusive-btn ${canAfford ? 'exclusive-btn--buy' : 'exclusive-btn--locked'}" onclick="unlockContent('${item.id}', ${item.token_price || 0})" ${canAfford ? '' : 'disabled'}>
                        ${canAfford ? '🔑 Desbloquear' : '🔒 Sin saldo'}
                      </button>`
                  }
                </div>
              </div>
            `;
          }).join('')}
        </div>`;
    }

    (window as any).unlockContent = async (contentId: string, price: number) => {
      if (!currentUserId) { window.location.href = '/login'; return; }
      if (!artistId) return;

      const btn = document.querySelector(`[data-content-id="${contentId}"] .exclusive-btn`) as HTMLButtonElement;
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Procesando...';
      }

      // Deduct tokens & create purchase record
      const { error: tokenError } = await supabase
        .from('token_transactions')
        .insert({
          user_id: currentUserId,
          type: 'spend',
          amount: -price,
          reference: 'content_purchase',
          reference_id: contentId,
          description: 'Compra de contenido exclusivo',
        });

      if (tokenError) {
        console.error('Token error:', tokenError);
        if (btn) {
          btn.disabled = false;
          btn.textContent = '🔑 Desbloquear';
        }
        return;
      }

      // Deduct tokens
      await supabase.rpc('decrement_tokens', {
        p_user_id: currentUserId,
        p_amount: price,
      }).catch(async () => {
        // Fallback: direct update
        const { data: current } = await supabase
          .from('user_tokens')
          .select('balance')
          .eq('user_id', currentUserId)
          .single();
        const newBalance = Math.max((current?.balance || 0) - price, 0);
        await supabase
          .from('user_tokens')
          .update({ balance: newBalance, updated_at: new Date().toISOString() })
          .eq('user_id', currentUserId);
      });

      // Create purchase
      await supabase.from('content_purchases').insert({
        user_id: currentUserId,
        content_id: contentId,
        payment_type: 'token',
        tokens_spent: price,
      });

      // Reload to show unlocked state
      loadExclusiveContent();
    };

    // Load exclusive content if tab exists
    if (document.getElementById('exclusive-content-root')) {
      loadExclusiveContent();
    }
  })();
</script>
