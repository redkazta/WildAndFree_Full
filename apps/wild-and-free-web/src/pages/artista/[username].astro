---
import Layout from '../../layouts/Layout.astro';
import { getAllPublicProfiles, getArtistPosts } from '../../data/artists';
import type { Artist, ArtistPost } from '../../data/artists';
import { createClient } from '@supabase/supabase-js';

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL as string,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string
);

export async function getStaticPaths() {
  const profiles = await getAllPublicProfiles();
  return profiles.map((a: Artist) => ({
    params: { username: a.slug },
    props: { artist: a, posts: [] as ArtistPost[] },
  }));
}

const { username } = Astro.params;
const profiles = await getAllPublicProfiles();
const artist = profiles.find((a: Artist) => a.slug === username) || null;
const notFound = !artist;
// Normaliza roles de staff (staff, staff_manager, staff_marketing) a "staff"
const ownerRole = ((artist?.role || 'fan') + '').toLowerCase();
const ownerRoleKey = ownerRole.startsWith('staff') ? 'staff' : ownerRole;

let posts: ArtistPost[] = [];
if (artist) {
  posts = await getArtistPosts(artist.id);
}

// Fetch real reaction counts for crew posts
let postsWithCounts: ArtistPost[] = [];
try {
  const { data: feedPosts } = await supabase
    .rpc('get_crew_feed', {
      p_author_id: artist?.id || '',
      p_limit: 20,
      p_offset: 0,
      p_user_id: null,
    });
  
  if (feedPosts && feedPosts.length > 0) {
    postsWithCounts = feedPosts.map((p: any) => ({
      id: p.id,
      artist_id: p.author_id,
      content: p.content || '',
      post_type: p.post_type || 'general',
      image_url: p.image_url,
      embed_url: null,
      embed_title: p.title || null,
      likes_count: Number(p.likes_count) || 0,
      comments_count: Number(p.comments_count) || 0,
      reposts_count: Number(p.reposts_count) || 0,
      is_pinned: false,
      created_at: p.published_at || p.created_at,
    }));
  }
} catch (e) {
  console.warn('[artist] Could not fetch feed counts, using defaults');
}

// Use real counts if available, otherwise fallback to posts from getArtistPosts
if (postsWithCounts.length > 0) {
  posts = postsWithCounts;
}

function timeAgo(dateStr: string): string {
  const diff = Date.now() - new Date(dateStr).getTime();
  const mins = Math.floor(diff / 60000);
  if (mins < 60) return `${mins}m`;
  const hrs = Math.floor(mins / 60);
  if (hrs < 24) return `${hrs}h`;
  const days = Math.floor(hrs / 24);
  if (days < 7) return `${days}d`;
  return `${Math.floor(days / 7)}sem`;
}
---

<Layout config={{ name: `Wild Gvng - ${artist.nombre}`, primary_color: "#C98300", secondary_color: "#8A0303" }}>
  {notFound ? (
  <div class="ap min-h-screen bg-[var(--bg)] flex items-center justify-center">
      <div class="text-center px-6">
        <div class="text-[5rem] font-black text-[var(--primary)]">404</div>
        <h1 class="text-2xl font-black uppercase tracking-tight text-[var(--text)] mb-2">Perfil no encontrado</h1>
        <p class="text-sm text-[var(--text-muted)] mb-6">Este usuario no existe o no tiene perfil público.</p>
        <a href="/artistas" class="inline-block px-6 py-3 rounded-xl bg-[var(--primary)] text-[var(--bg)] font-black uppercase tracking-wider text-xs">Ver roster</a>
      </div>
    </div>
  ) : (
  <div class="ap" data-artist-id={artist.id} data-artist-role={ownerRoleKey}>

    <!-- PROFILE HEADER: horizontal split, large photo -->
    <div class="ap-header">
      <div class="ap-header-bg"></div>
      <div class="ap-header-content">
        <div class="ap-header-photo">
          {artist.imagenes.profile ? (
            <img src={artist.imagenes.profile} alt={artist.nombre} />
          ) : (
            <div class="ap-header-photo-initials">{artist.nombre.substring(0, 2).toUpperCase()}</div>
          )}
        </div>
        <div class="ap-header-info">
          <div class="ap-header-name-row">
            <h1 class="ap-header-name">{artist.nombre}</h1>
            <span class="ap-header-verified">✓</span>
          </div>
          <div class="ap-header-meta">
            <span>📍 {artist.origen}</span>
            <span class="dot">·</span>
            <span>🔥 {artist.stats.partnean} Partnean</span>
            <span class="dot">·</span>
            <span>🎵 {artist.tracks.length} tracks</span>
          </div>
          {artist.tags && artist.tags.length > 0 && (
            <div class="ap-header-tags">
              {artist.tags.map((tag: any) => (
                <span class={`tag-badge ${tag.animation && tag.animation !== 'none' ? `tag-anim-${tag.animation}` : ''}`} style={`--tag-c: ${tag.color}`}><span class="tag-badge-dot"></span>{tag.name}</span>
              ))}
            </div>
          )}
          <div class="ap-header-actions">
            <button class="btn-p btn-gold" id="partnear-btn">PARTNEAR</button>
            <button class="btn-p btn-ghost" id="share-btn">COMPARTIR</button>
          </div>
        </div>
      </div>
    </div>

    <!-- BODY: 80% width, sidebar left + feed right -->
    <div class="ap-body">
      <div class="ap-body-inner">

        <!-- SIDEBAR (left) -->
        <aside class="ap-side">
          <div class="ap-side-bio">
            <p>{artist.bio || 'Sin biografía aún.'}</p>
          </div>
          <div class="ap-side-section">
            <h4 class="ap-side-title">Estadísticas</h4>
            <div class="ap-side-stats">
              <div class="ap-side-stat"><span class="num">{artist.stats.partnean}</span>Partnean</div>
              <div class="ap-side-stat"><span class="num">{artist.stats.seguidores}</span>Seguidores</div>
              <div class="ap-side-stat"><span class="num">{artist.stats.oyentes}</span>Oyentes</div>
              <div class="ap-side-stat"><span class="num">{artist.tracks.length}</span>Tracks</div>
            </div>
          </div>
          {artist.redes && Object.keys(artist.redes).length > 0 && (
            <div class="ap-side-section">
              <h4 class="ap-side-title">Redes</h4>
              <div class="ap-side-links">
                {Object.entries(artist.redes).map(([name, url]: [string, string]) => (
                  <a href={url} target="_blank" class="ap-side-link">{name}</a>
                ))}
              </div>
            </div>
          )}
          {artist.tags && artist.tags.length > 0 && (
            <div class="ap-side-section">
              <h4 class="ap-side-title">Tags</h4>
              <div class="ap-side-tags">
                {artist.tags.map((tag: any) => (
                  <span class={`tag-badge ${tag.animation && tag.animation !== 'none' ? `tag-anim-${tag.animation}` : ''}`} style={`--tag-c: ${tag.color}`}><span class="tag-badge-dot"></span>{tag.name}</span>
                ))}
              </div>
            </div>
          )}
        </aside>

        <!-- FEED (right) -->
        <main class="ap-feed">
          <div class="feed-tabs">
            <button class="feed-tab active" data-tab="feed">Feed</button>
            <button class="feed-tab" data-tab="music">Música</button>
            <button class="feed-tab exclusive-tab" data-tab="exclusive">Exclusivo</button>
          </div>

          <!-- Feed Tab -->
          <div class="feed-content active" id="tab-feed">
            {posts.length === 0 && artist.tracks.length === 0 ? (
              <div class="feed-empty">
                <div class="empty-icon">📝</div>
                <p class="empty-title">Aún no hay publicaciones</p>
                <p class="empty-sub">Este artista no ha compartido contenido aún.</p>
              </div>
            ) : (
              <>
                {posts.map(p => (
                  <article class="feed-post" key={p.id}>
                    <div class="post-header">
                      <div class="post-avatar-sm">
                        {artist.imagenes.profile ? (
                          <img src={artist.imagenes.profile} alt={artist.nombre} />
                        ) : (
                          <span>{artist.nombre.substring(0, 2).toUpperCase()}</span>
                        )}
                      </div>
                      <div class="post-author">
                        <strong>{artist.nombre}</strong>
                        <span class="post-time">{timeAgo(p.created_at)}</span>
                      </div>
                    </div>
                    <div class="post-body">
                      <p>{p.content}</p>
                      {p.image_url && (
                        <div class="post-img-wrap">
                          <img src={p.image_url} alt="" loading="lazy" />
                        </div>
                      )}
                      {p.embed_url && (
                        <div class="post-embed">
                          <div class="embed-placeholder">
                            <span class="embed-icon">🎵</span>
                            <span class="embed-title">{p.embed_title || 'Escuchar'}</span>
                          </div>
                        </div>
                      )}
                    </div>
                    <div class="post-actions-bar">
                      <button class="post-action like-btn" data-post-id={p.id}>
                        <span class="action-icon">❤️</span>
                        <span class="action-count">{p.likes_count}</span>
                      </button>
                      <button class="post-action comment-btn" data-post-id={p.id}>
                        <span class="action-icon">💬</span>
                        <span class="action-count">{p.comments_count}</span>
                      </button>
                      <button class="post-action repost-btn" data-post-id={p.id}>
                        <span class="action-icon">🔄</span>
                        <span class="action-count">0</span>
                      </button>
                      <button class="post-action share-btn" data-post-id={p.id}>
                        <span class="action-icon">📤</span>
                      </button>
                    </div>
                  </article>
                ))}
                {artist.tracks.map(t => (
                  <article class="feed-post" key={t.title}>
                    <div class="post-header">
                      <div class="post-avatar-sm">
                        {artist.imagenes.profile ? (
                          <img src={artist.imagenes.profile} alt={artist.nombre} />
                        ) : (
                          <span>{artist.nombre.substring(0, 2).toUpperCase()}</span>
                        )}
                      </div>
                      <div class="post-author">
                        <strong>{artist.nombre}</strong>
                        <span class="post-time">Track</span>
                      </div>
                    </div>
                    <div class="post-body">
                      <p>Nuevo track: <strong>{t.title}</strong></p>
                      <div class="post-embed">
                        <div class="embed-placeholder">
                          <span class="embed-icon">🎵</span>
                          <span class="embed-title">{t.title} · {t.duration}</span>
                        </div>
                      </div>
                    </div>
                  </article>
                ))}
              </>
            )}
          </div>

          <!-- Exclusive Content Tab -->
          <div class="feed-content" id="tab-exclusive">
            <div id="exclusive-content-root">
              <div class="feed-empty">
                <div class="empty-icon">🔒</div>
                <p class="empty-title">Contenido Exclusivo</p>
                <p class="empty-sub">Cargando contenido exclusivo...</p>
              </div>
            </div>
          </div>

          <!-- Music Tab -->
          <div class="feed-content" id="tab-music">
            {artist.tracks.length === 0 ? (
              <div class="feed-empty">
                <div class="empty-icon">🎵</div>
                <p class="empty-title">Sin tracks</p>
                <p class="empty-sub">Este artista no ha subido música aún.</p>
              </div>
            ) : (
              <div class="music-list">
                {artist.tracks.map(t => (
                  <div class="music-item">
                    <div class="music-cover">
                      <span>🎵</span>
                    </div>
                    <div class="music-info">
                      <strong>{t.title}</strong>
                      <span>{t.duration}</span>
                    </div>
                    {t.spotify_url && (
                      <a href={t.spotify_url} target="_blank" class="music-play">▶</a>
                    )}
                  </div>
                ))}
              </div>
            )}
          </div>

        </main>
      </div>
    </div>
  </div>
  )}
</Layout>

<style>
  /* ─── PAGE CONTAINER ─── */
  .ap { min-height: 100vh; background: var(--bg); }

  /* ─── HEADER (minimalista) ─── */
  .ap-header {
    position: relative;
    border-bottom: 1px solid var(--border-faint);
  }
  .ap-header-bg {
    display: none;
  }
  .ap-header-content {
    position: relative; z-index: 1;
    max-width: 1400px; margin: 0 auto;
    display: flex; align-items: center; gap: 36px;
    padding: 48px 32px;
  }
  /* Retrato: mediano, no protagonista */
  .ap-header-photo {
    width: 180px;
    height: 180px;
    border-radius: 50%;
    overflow: hidden;
    flex-shrink: 0;
    position: relative;
    border: 3px solid var(--border);
  }
  .ap-header-photo img {
    width: 100%; height: 100%;
    object-fit: cover;
  }
  .ap-header-photo-initials {
    width: 100%; height: 100%;
    display: flex; align-items: center; justify-content: center;
    background: var(--bg-card);
    font-size: 3rem; font-weight: 900; color: var(--primary);
  }
  /* Info panel */
  .ap-header-info {
    display: flex; flex-direction: column; justify-content: center;
    gap: 12px;
    flex: 1;
    min-width: 0;
  }
  .ap-header-name-row { display: flex; align-items: center; gap: 10px; }
  .ap-header-name {
    font-size: 2.4rem; font-weight: 900; color: var(--text);
    margin: 0; text-transform: uppercase;
    letter-spacing: -0.02em; line-height: 1;
  }
  .ap-header-verified {
    color: var(--primary); font-size: 1.1rem;
    background: var(--primary-soft);
    width: 28px; height: 28px; border-radius: 50%;
    display: inline-flex; align-items: center; justify-content: center;
  }
  .ap-header-meta {
    font-size: 0.7rem; color: var(--text-secondary);
    display: flex; gap: 10px; flex-wrap: wrap; align-items: center;
  }
  .dot { color: var(--text-muted); }
  .ap-header-tags { display: flex; gap: 4px; flex-wrap: wrap; }
  .ap-header-actions { display: flex; gap: 10px; margin-top: 8px; flex-wrap: wrap; }
  .btn-p {
    padding: 10px 24px; border-radius: 100px;
    font-size: 0.6rem; font-weight: 900;
    letter-spacing: 0.15em; text-transform: uppercase;
    border: none; cursor: pointer; transition: all 0.2s;
    font-family: inherit;
  }
  .btn-gold { background: var(--primary); color: var(--bg); }
  .btn-gold:hover { background: var(--primary-hover); }
  .btn-ghost { background: transparent; border: 1px solid var(--border); color: var(--text); }
  .btn-ghost:hover { border-color: var(--primary); color: var(--primary); }
  .ap-header-erp-btn {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 10px 24px; border-radius: 100px;
    background: transparent; border: 1px solid var(--primary); color: var(--primary);
    font-size: 10px; font-weight: 900; text-transform: uppercase; letter-spacing: 0.1em;
    text-decoration: none; cursor: pointer; font-family: inherit;
    transition: all 0.2s ease;
  }
  .ap-header-erp-btn:hover {
    background: var(--primary); color: var(--bg);
  }
  @media (max-width: 768px) {
    .ap-header-content { padding: 28px 20px; gap: 20px; flex-direction: column; text-align: center; }
    .ap-header-photo { width: 130px; height: 130px; }
    .ap-header-name { font-size: 1.7rem; }
    .ap-header-meta, .ap-header-actions { justify-content: center; }
    .ap-header-name-row { justify-content: center; }
  }

  /* ─── BODY: 80% width container ─── */
  .ap-body {
    max-width: 1400px; margin: 0 auto;
    padding: 0 32px 60px;
    margin-top: 40px;
    position: relative; z-index: 2;
  }
  .ap-body-inner {
    display: grid;
    grid-template-columns: 240px 1fr;
    gap: 32px;
    align-items: start;
  }

  /* ─── SIDEBAR ─── */
  .ap-side { position: sticky; top: 90px; }
  .ap-side-bio {
    font-size: 0.8rem; line-height: 1.7;
    color: var(--text-secondary);
    padding: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-faint);
    border-radius: 12px;
    margin-bottom: 16px;
  }
  .ap-side-bio p { margin: 0; }
  .ap-side-section { margin-bottom: 20px; padding: 0 4px; }
  .ap-side-title {
    font-size: 0.5rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.15em;
    color: var(--text-muted);
    margin: 0 0 10px;
  }
  .ap-side-stats {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }
  .ap-side-stat {
    background: var(--bg-card);
    border: 1px solid var(--border-faint);
    border-radius: 10px;
    padding: 12px;
    text-align: center;
  }
  .ap-side-stat .num {
    display: block;
    font-size: 1.1rem; font-weight: 900; color: var(--text);
    margin-bottom: 2px;
  }
  .ap-side-stat {
    font-size: 0.5rem; font-weight: 700;
    text-transform: uppercase; color: var(--text-muted);
  }
  .ap-side-links { display: flex; flex-wrap: wrap; gap: 6px; }
  .ap-side-link {
    font-size: 0.5rem; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.1em;
    padding: 4px 10px; border-radius: 100px;
    background: var(--bg); border: 1px solid var(--border-faint);
    color: var(--text); text-decoration: none;
  }
  .ap-side-link:hover { border-color: var(--primary); color: var(--primary); }
  .ap-side-tags { display: flex; flex-wrap: wrap; gap: 4px; }

  /* ─── FEED ─── */
  .ap-feed { display: flex; flex-direction: column; gap: 20px; }
  .feed-tabs {
    display: flex; gap: 4px;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 14px; padding: 4px;
  }
  .feed-tab {
    flex: 1; padding: 12px;
    border: none; background: transparent;
    color: var(--text-muted);
    font-size: 0.65rem; font-weight: 900;
    text-transform: uppercase; letter-spacing: 0.12em;
    border-radius: 10px;
    cursor: pointer; transition: all 0.15s;
    font-family: inherit;
  }
  .feed-tab.active { background: var(--bg); color: var(--text); }
  .feed-tab.hidden-tab { display: none; }
  .feed-content { display: none; flex-direction: column; gap: 16px; }
  .feed-content.active { display: flex; }

  .feed-empty {
    text-align: center; padding: 60px 20px;
    border: 1px solid var(--border);
    border-radius: 16px; background: var(--bg-card);
  }
  .empty-icon { font-size: 2.5rem; margin-bottom: 12px; }
  .empty-title { font-size: 1rem; font-weight: 900; color: var(--text); margin: 0; }
  .empty-sub { font-size: 0.75rem; color: var(--text-muted); margin: 6px 0 0; }

  /* Feed post cards */
  .feed-post {
    background: var(--bg-card);
    border: 1px solid var(--border-faint);
    border-radius: 16px; padding: 24px;
    transition: border-color 0.2s;
  }
  .feed-post:hover { border-color: var(--primary-border); }
  .post-header { display: flex; gap: 12px; align-items: center; margin-bottom: 14px; }
  .post-avatar-sm {
    width: 40px; height: 40px; border-radius: 50%;
    overflow: hidden; border: 2px solid var(--primary);
    flex-shrink: 0; display: flex; align-items: center;
    justify-content: center; background: var(--bg-card);
    font-weight: 900; font-size: 0.7rem; color: var(--primary);
  }
  .post-avatar-sm img { width: 100%; height: 100%; object-fit: cover; }
  .post-author { display: flex; flex-direction: column; }
  .post-author strong { font-size: 0.8rem; color: var(--text); }
  .post-time { font-size: 0.6rem; color: var(--text-muted); }
  .post-body p {
    font-size: 0.9rem; color: var(--text);
    line-height: 1.7; margin: 0 0 14px;
  }
  .post-img-wrap { border-radius: 12px; overflow: hidden; margin-bottom: 8px; }
  .post-img-wrap img { width: 100%; height: auto; max-height: 420px; object-fit: cover; }
  .post-embed { border: 1px solid var(--border-faint); border-radius: 12px; overflow: hidden; }
  .embed-placeholder {
    display: flex; align-items: center; gap: 12px;
    padding: 16px; background: var(--bg);
  }
  .embed-icon { font-size: 1.5rem; }
  .embed-title { font-weight: 700; font-size: 0.8rem; color: var(--text); }

  .post-actions-bar {
    display: flex; gap: 8px;
    margin-top: 14px; padding-top: 14px;
    border-top: 1px solid var(--border-faint);
  }
  .post-action {
    display: flex; align-items: center; gap: 6px;
    background: none; border: 1px solid var(--border-faint);
    border-radius: 8px; padding: 7px 12px;
    font-size: 0.65rem; font-weight: 700;
    color: var(--text-secondary); cursor: pointer;
    transition: all 0.15s; font-family: inherit;
  }
  .post-action:hover { border-color: var(--border); color: var(--text); background: var(--bg-hover); }
  .action-icon { font-size: 0.85rem; }
  .action-count { font-size: 0.65rem; }
  .post-action.liked { border-color: var(--danger); color: var(--danger); background: rgba(255,68,68,0.08); }
  .post-action.reposted { border-color: var(--success); color: var(--success); background: rgba(0,255,136,0.08); }

  /* Music tab */
  .music-list { display: flex; flex-direction: column; gap: 8px; }
  .music-item {
    display: flex; align-items: center; gap: 14px;
    padding: 14px; background: var(--bg-card);
    border: 1px solid var(--border-faint); border-radius: 12px;
  }
  .music-cover {
    width: 44px; height: 44px; border-radius: 10px;
    background: var(--bg); display: flex;
    align-items: center; justify-content: center;
    font-size: 1.3rem; flex-shrink: 0;
  }
  .music-info { flex: 1; }
  .music-info strong { display: block; font-size: 0.8rem; color: var(--text); }
  .music-info span { font-size: 0.65rem; color: var(--text-muted); }
  .music-play {
    width: 38px; height: 38px; border-radius: 50%;
    background: var(--primary); color: var(--bg);
    display: flex; align-items: center; justify-content: center;
    font-size: 0.75rem; text-decoration: none;
  }

  /* ─── COMMENTS ─── */
  .comment-section { margin-top: 14px; padding-top: 14px; border-top: 1px solid var(--border-faint); }
  .comment-list { max-height: 300px; overflow-y: auto; margin-bottom: 14px; }
  .comment-loading, .comment-empty { font-size: 0.7rem; color: var(--text-muted); padding: 12px; text-align: center; }
  .comment-item { display: flex; gap: 10px; padding: 10px 0; border-bottom: 1px solid var(--border-faint); }
  .comment-item:last-child { border-bottom: none; }
  .comment-avatar {
    width: 30px; height: 30px; border-radius: 50%;
    background: var(--bg-card); display: flex;
    align-items: center; justify-content: center;
    font-size: 0.55rem; font-weight: 900; color: var(--primary);
    flex-shrink: 0; background-size: cover; background-position: center;
  }
  .comment-body { flex: 1; }
  .comment-author { font-size: 0.65rem; font-weight: 800; color: var(--text); }
  .comment-time { font-size: 0.55rem; color: var(--text-muted); font-weight: 400; }
  .comment-text { font-size: 0.75rem; color: var(--text-secondary); margin-top: 3px; }
  .comment-form { display: flex; gap: 8px; }
  .comment-input {
    flex: 1; padding: 10px 14px; border-radius: 8px;
    border: 1px solid var(--border-faint);
    background: var(--bg); color: var(--text);
    font-size: 0.75rem; font-family: inherit; outline: none;
  }
  .comment-input:focus { border-color: var(--primary); }
  .comment-send {
    padding: 10px 18px; border-radius: 8px; border: none;
    background: var(--primary); color: var(--bg);
    font-size: 0.65rem; font-weight: 900;
    text-transform: uppercase; cursor: pointer; font-family: inherit;
  }
  .comment-send:hover { background: var(--primary-hover); }

  /* ─── EXCLUSIVE CONTENT ─── */
  .exclusive-header {
    display: flex; justify-content: space-between; align-items: center;
    margin-bottom: 16px; flex-wrap: wrap; gap: 8px;
  }
  .exclusive-balance {
    font-size: 0.7rem; color: var(--text-secondary);
    background: var(--bg-card); padding: 6px 14px;
    border-radius: 100px; border: 1px solid var(--border-faint);
  }
  .exclusive-balance strong { color: var(--primary); }
  .exclusive-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 16px;
  }
  .exclusive-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px; overflow: hidden;
    transition: border-color 0.2s;
  }
  .exclusive-card:hover {
    border-color: var(--primary-border);
  }
  .exclusive-card-img {
    width: 100%; height: 180px; overflow: hidden;
  }
  .exclusive-card-img img {
    width: 100%; height: 100%; object-fit: cover;
  }
  .exclusive-card-body {
    padding: 16px;
    display: flex; flex-direction: column; gap: 8px;
  }
  .exclusive-card-type {
    display: inline-block;
    font-size: 8px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--primary);
    background: var(--primary-soft);
    padding: 2px 10px; border-radius: 100px;
    width: fit-content;
  }
  .exclusive-card-title {
    font-size: 0.85rem; font-weight: 900;
    color: var(--text); text-transform: uppercase;
    margin: 0; line-height: 1.2;
  }
  .exclusive-card-desc {
    font-size: 0.7rem; color: var(--text-secondary);
    line-height: 1.5;
  }
  .exclusive-card-footer {
    display: flex; justify-content: space-between;
    align-items: center;
    padding-top: 8px; border-top: 1px solid var(--border-faint);
  }
  .exclusive-card-price {
    font-size: 0.6rem; font-weight: 700;
    color: var(--text-muted); text-transform: uppercase;
  }
  .exclusive-btn {
    padding: 8px 16px; border: none; border-radius: 100px;
    font-size: 0.6rem; font-weight: 900;
    text-transform: uppercase; letter-spacing: 0.08em;
    cursor: pointer; transition: all 0.2s;
    font-family: inherit; text-align: center;
    text-decoration: none; display: inline-block;
  }
  .exclusive-btn--unlocked {
    background: var(--success); color: #000;
  }
  .exclusive-btn--unlocked:hover { opacity: 0.8; }
  .exclusive-btn--buy {
    background: var(--primary); color: var(--bg);
  }
  .exclusive-btn--buy:hover { background: var(--primary-hover); }
  .exclusive-btn--locked {
    background: var(--bg-card); color: var(--text-muted);
    cursor: not-allowed; border: 1px solid var(--border-faint);
  }

  @media (max-width: 768px) {
    .ap-header-content { flex-direction: column; }
    .ap-header-photo { width: 100%; min-height: 40vh; max-height: 50vh; }
    .ap-header-info { padding: 24px; }
    .ap-header-name { font-size: 2rem; }
    .ap-body-inner { grid-template-columns: 1fr; }
    .ap-side { position: static; }
    .exclusive-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  (async function() {
    const { data: { session } } = await supabase.auth.getSession();
    const currentUserId = session?.user?.id;

    // Rol real del dueño del perfil (se resuelve en build y viaja por data-)
    const root = document.querySelector('.ap') as HTMLElement | null;
    const profileOwnerRole = (root?.dataset.artistRole || 'fan').toLowerCase();
    const profileOwnerId = root?.dataset.artistId;

    // Si es tu propio perfil y eres admin/staff, atajo al ERP
    if (currentUserId && profileOwnerId === currentUserId && ['admin', 'staff'].includes(profileOwnerRole)) {
      const erpShortcut = document.createElement('a');
      erpShortcut.href = '/erp';
      erpShortcut.className = 'ap-header-erp-btn';
      erpShortcut.textContent = '⚙️ Ir al ERP';
      document.querySelector('.ap-header-actions')?.appendChild(erpShortcut);
    }

    // Tabs
    document.querySelectorAll('.feed-tab').forEach(tab => {
      tab.addEventListener('click', function() {
        document.querySelectorAll('.feed-tab').forEach(t => t.classList.remove('active'));
        document.querySelectorAll('.feed-content').forEach(c => c.classList.remove('active'));
        this.classList.add('active');
        const target = document.getElementById('tab-' + this.dataset.tab);
        if (target) target.classList.add('active');
      });
    });

    // Partnear button
    const partnearBtn = document.getElementById('partnear-btn');
    if (partnearBtn) {
      partnearBtn.addEventListener('click', async () => {
        if (!currentUserId) {
          window.location.href = '/login';
          return;
        }
        const active = partnearBtn.classList.toggle('active');
        partnearBtn.textContent = active ? 'PARTNEANDO' : 'PARTNEAR';
        partnearBtn.classList.toggle('btn-gold', !active);
        partnearBtn.classList.toggle('btn-ghost', active);
      });
    }

    // Share
    document.getElementById('share-btn')?.addEventListener('click', () => {
      if (navigator.share) {
        navigator.share({ url: window.location.href, title: document.title });
      } else {
        navigator.clipboard?.writeText(window.location.href);
        const btn = document.getElementById('share-btn');
        const orig = btn?.textContent;
        if (btn) btn.textContent = 'COPIADO';
        setTimeout(() => { if (btn) btn.textContent = orig; }, 2000);
      }
    });

    // --- FEED INTERACTIONS (Likes, Comments, Reposts) ---
    async function toggleLike(postId: string, btn: HTMLElement) {
      if (!currentUserId) { window.location.href = '/login'; return; }

      const countEl = btn.querySelector('.action-count');
      const isLiked = btn.classList.contains('liked');

      const { data: liked } = await supabase.rpc('toggle_like', {
        p_post_id: postId,
        p_user_id: currentUserId,
      });

      if (liked) {
        btn.classList.add('liked');
        btn.style.borderColor = 'var(--danger)';
        btn.style.color = 'var(--danger)';
        if (countEl) countEl.textContent = String(parseInt(countEl.textContent || '0') + 1);
      } else {
        btn.classList.remove('liked');
        btn.style.borderColor = '';
        btn.style.color = '';
        if (countEl) countEl.textContent = String(Math.max(0, parseInt(countEl.textContent || '0') - 1));
      }
    }

    async function toggleRepost(postId: string, btn: HTMLElement) {
      if (!currentUserId) { window.location.href = '/login'; return; }

      const countEl = btn.querySelector('.action-count');
      const isReposted = btn.classList.contains('reposted');

      const { data: reposted } = await supabase.rpc('toggle_repost', {
        p_post_id: postId,
        p_user_id: currentUserId,
      });

      if (reposted) {
        btn.classList.add('reposted');
        btn.style.borderColor = 'var(--success)';
        btn.style.color = 'var(--success)';
        if (countEl) countEl.textContent = String(parseInt(countEl.textContent || '0') + 1);
      } else {
        btn.classList.remove('reposted');
        btn.style.borderColor = '';
        btn.style.color = '';
        if (countEl) countEl.textContent = String(Math.max(0, parseInt(countEl.textContent || '0') - 1));
      }
    }

    async function openComments(postId: string) {
      if (!currentUserId) { window.location.href = '/login'; return; }

      // Toggle comment section below the post
      let commentSection = document.getElementById(`comments-${postId}`);
      if (commentSection) {
        commentSection.style.display = commentSection.style.display === 'none' ? 'block' : 'none';
        return;
      }

      // Create comment section
      const postEl = document.querySelector(`[data-post-id="${postId}"]`)?.closest('.feed-post');
      if (!postEl) return;

      commentSection = document.createElement('div');
      commentSection.id = `comments-${postId}`;
      commentSection.className = 'comment-section';
      commentSection.innerHTML = `
        <div class="comment-list" id="comment-list-${postId}">
          <div class="comment-loading">Cargando comentarios...</div>
        </div>
        <div class="comment-form">
          <input type="text" id="comment-input-${postId}" placeholder="Escribe un comentario..." class="comment-input" />
          <button class="comment-send" data-post-id="${postId}">Enviar</button>
        </div>
      `;
      postEl.appendChild(commentSection);

      // Load comments
      const { data: comments } = await supabase
        .from('wall_comments')
        .select('id, content, created_at, user_id')
        .eq('post_id', postId)
        .is('deleted_at', null)
        .order('created_at', { ascending: true });

      // Load profiles for comment authors
      const userIds = [...new Set(comments?.map(c => c.user_id) || [])];
      let profiles: any[] = [];
      if (userIds.length > 0) {
        const { data: p } = await supabase.from('profiles').select('id, nombre, username, avatar_url').in('id', userIds);
        profiles = p || [];
      }

      const list = document.getElementById(`comment-list-${postId}`);
      if (list) {
        if (!comments || comments.length === 0) {
          list.innerHTML = '<div class="comment-empty">Sin comentarios aún. Sé el primero.</div>';
        } else {
          list.innerHTML = comments.map(c => {
            const profile = profiles.find(p => p.id === c.user_id);
            const name = profile?.nombre || profile?.username || 'Anónimo';
            const initials = name.substring(0, 2).toUpperCase();
            const avatar = profile?.avatar_url;
            const timeAgo = getTimeAgo(c.created_at);
            return `
              <div class="comment-item">
                <div class="comment-avatar" style="${avatar ? `background-image:url(${avatar})` : ''}">${avatar ? '' : initials}</div>
                <div class="comment-body">
                  <div class="comment-author">${name} <span class="comment-time">${timeAgo}</span></div>
                  <div class="comment-text">${c.content}</div>
                </div>
              </div>
            `;
          }).join('');
        }
      }

      // Send comment
      const sendBtn = commentSection.querySelector('.comment-send');
      const input = document.getElementById(`comment-input-${postId}`) as HTMLInputElement;
      sendBtn?.addEventListener('click', async () => {
        const text = input?.value?.trim();
        if (!text) return;
        const { error } = await supabase.from('wall_comments').insert({
          post_id: postId,
          user_id: currentUserId,
          content: text,
        });
        if (!error) {
          input.value = '';
          // Reload comments
          openComments(postId);
          // Update count
          const commentBtn = document.querySelector(`[data-post-id="${postId}"]`);
          const countEl = commentBtn?.closest('.post-actions-bar')?.querySelector('.comment-btn .action-count');
          if (countEl) countEl.textContent = String(parseInt(countEl.textContent || '0') + 1);
        }
      });
    }

    function getTimeAgo(dateStr: string): string {
      const diff = Date.now() - new Date(dateStr).getTime();
      const mins = Math.floor(diff / 60000);
      if (mins < 60) return `${mins}m`;
      const hrs = Math.floor(mins / 60);
      if (hrs < 24) return `${hrs}h`;
      const days = Math.floor(hrs / 24);
      return `${days}d`;
    }

    // Attach event listeners to post action buttons
    document.querySelectorAll('.like-btn').forEach(btn => {
      const postId = btn.getAttribute('data-post-id');
      if (postId) btn.addEventListener('click', () => toggleLike(postId, btn as HTMLElement));
    });

    document.querySelectorAll('.repost-btn').forEach(btn => {
      const postId = btn.getAttribute('data-post-id');
      if (postId) btn.addEventListener('click', () => toggleRepost(postId, btn as HTMLElement));
    });

    document.querySelectorAll('.comment-btn').forEach(btn => {
      const postId = btn.getAttribute('data-post-id');
      if (postId) btn.addEventListener('click', () => openComments(postId));
    });

    // Follow button - check if user already follows this artist
    const artistId = document.querySelector('[data-artist-id]')?.getAttribute('data-artist-id');
    if (currentUserId && artistId && artistId !== currentUserId) {
      const { data: existingFollow } = await supabase
        .from('follows')
        .select('id')
        .eq('follower_id', currentUserId)
        .eq('following_id', artistId)
        .single();

      const partnearBtn = document.getElementById('partnear-btn');
      if (partnearBtn && existingFollow) {
        partnearBtn.classList.add('active');
        partnearBtn.textContent = 'PARTNEANDO';
        partnearBtn.classList.remove('btn-gold');
        partnearBtn.classList.add('btn-ghost');
      }

      if (partnearBtn) {
        partnearBtn.addEventListener('click', async () => {
          const isActive = partnearBtn.classList.contains('active');
          if (isActive) {
            await supabase.from('follows').delete().eq('follower_id', currentUserId).eq('following_id', artistId);
            partnearBtn.classList.remove('active');
            partnearBtn.textContent = 'PARTNEAR';
            partnearBtn.classList.add('btn-gold');
            partnearBtn.classList.remove('btn-ghost');
          } else {
            await supabase.from('follows').insert({ follower_id: currentUserId, following_id: artistId });
            partnearBtn.classList.add('active');
            partnearBtn.textContent = 'PARTNEANDO';
            partnearBtn.classList.remove('btn-gold');
            partnearBtn.classList.add('btn-ghost');
          }
        });
      }
    }

    // ── GET USER ROLE ──
    let userRole: string | null = null;
    if (currentUserId) {
      try {
        const { data: roleRows } = await supabase
          .from('user_roles')
          .select('role_id')
          .eq('user_id', currentUserId);
        if (roleRows && roleRows.length > 0) {
          const roleIds = roleRows.map((r: any) => r.role_id);
          const { data: roles } = await supabase
            .from('roles')
            .select('name')
            .in('id', roleIds);
          if (roles) {
            const names = roles.map((r: any) => r.name);
            if (names.includes('admin')) userRole = 'admin';
            else if (names.includes('staff')) userRole = 'staff';
            else if (names.includes('artist')) userRole = 'artist';
            else userRole = 'fan';
          }
        }
      } catch (e) {
        console.warn('Could not fetch role:', e);
      }
    }

    // Show exclusive tab only when the OWNER can publish exclusive content
    // (artist/admin/staff), and the visitor has permission OR is the owner.
    const exclusiveTab = document.querySelector('.exclusive-tab');
    if (exclusiveTab) {
      const ownerCanPublishExclusive = ['admin', 'staff', 'artist'].includes(profileOwnerRole);
      const allowedRoles = ['admin', 'staff', 'artist'];
      const canViewExclusive =
        currentUserId && artistId &&
        (allowedRoles.includes(userRole || '') || currentUserId === artistId);
      if (ownerCanPublishExclusive && canViewExclusive) {
        exclusiveTab.classList.remove('hidden-tab');
      } else {
        exclusiveTab.classList.add('hidden-tab');
      }
    }

    // ── EXCLUSIVE CONTENT ──
    async function loadExclusiveContent() {
      const root = document.getElementById('exclusive-content-root');
      if (!root || !artistId) return;

      const { data: content, error } = await supabase
        .from('exclusive_content')
        .select('*')
        .eq('user_id', artistId)
        .eq('status', 'published')
        .order('created_at', { ascending: false });

      if (error || !content || content.length === 0) {
        root.innerHTML = `
          <div class="feed-empty">
            <div class="empty-icon">🔒</div>
            <p class="empty-title">Sin contenido exclusivo aún</p>
            <p class="empty-sub">Este artista no ha publicado contenido exclusivo.</p>
          </div>`;
        return;
      }

      // Get user's token balance
      let userBalance = 0;
      if (currentUserId) {
        const { data: tokens } = await supabase
          .from('user_tokens')
          .select('balance')
          .eq('user_id', currentUserId)
          .single();
        userBalance = tokens?.balance || 0;
      }

      // Get user's purchases
      let purchasedIds: string[] = [];
      if (currentUserId) {
        const { data: purchases } = await supabase
          .from('content_purchases')
          .select('content_id')
          .eq('user_id', currentUserId);
        purchasedIds = purchases?.map(p => p.content_id) || [];
      }

      const typeLabels: Record<string, string> = {
        video: '🎬 Video', audio: '🎵 Audio', download: '📦 Download'
      };

      root.innerHTML = `
        <div class="exclusive-header">
          <span class="exclusive-balance">💰 <strong>${userBalance}</strong> tokens disponibles</span>
          <span class="exclusive-balance">📦 <strong>${content.length}</strong> items</span>
        </div>
        <div class="exclusive-grid">
          ${content.map((item: any) => {
            const isPurchased = purchasedIds.includes(item.id);
            const canAfford = userBalance >= (item.token_price || 0);
            return `
              <div class="exclusive-card" data-content-id="${item.id}">
                ${item.preview_url ? `<div class="exclusive-card-img"><img src="${item.preview_url}" alt="${item.title}" loading="lazy" /></div>` : ''}
                <div class="exclusive-card-body">
                  <span class="exclusive-card-type">${typeLabels[item.content_type] || item.content_type.toUpperCase()}</span>
                  <h4 class="exclusive-card-title">${item.title}</h4>
                  <p class="exclusive-card-desc">${item.description || ''}</p>
                  <div class="exclusive-card-footer">
                    <span class="exclusive-card-price">${item.token_price || 0} tokens</span>
                    ${isPurchased
                      ? `<a href="${item.file_url || '#'}" target="_blank" class="exclusive-btn exclusive-btn--unlocked">🔓 Acceder</a>`
                      : `<button class="exclusive-btn ${canAfford ? 'exclusive-btn--buy' : 'exclusive-btn--locked'}" onclick="unlockContent('${item.id}', ${item.token_price || 0})" ${canAfford ? '' : 'disabled'}>
                          ${canAfford ? '🔑 Desbloquear' : '🔒 Sin saldo'}
                        </button>`
                    }
                  </div>
                </div>
              </div>
            `;
          }).join('')}
        </div>`;
    }

    // Override unlockContent to use new class names
    (window as any).unlockContent = async (contentId: string, price: number) => {
      if (!currentUserId) { window.location.href = '/login'; return; }
      if (!artistId) return;

      const btn = document.querySelector(`[data-content-id="${contentId}"] .exclusive-btn`) as HTMLButtonElement;
      if (btn) {
        btn.disabled = true;
        btn.textContent = 'Procesando...';
      }

      const { error: tokenError } = await supabase
        .from('token_transactions')
        .insert({
          user_id: currentUserId,
          type: 'spend',
          amount: -price,
          reference: 'content_purchase',
          reference_id: contentId,
          description: 'Compra de contenido exclusivo',
        });

      if (tokenError) {
        console.error('Token error:', tokenError);
        if (btn) {
          btn.disabled = false;
          btn.textContent = '🔑 Desbloquear';
        }
        return;
      }

      await supabase.rpc('decrement_tokens', {
        p_user_id: currentUserId,
        p_amount: price,
      }).catch(async () => {
        const { data: current } = await supabase
          .from('user_tokens')
          .select('balance')
          .eq('user_id', currentUserId)
          .single();
        const newBalance = Math.max((current?.balance || 0) - price, 0);
        await supabase
          .from('user_tokens')
          .update({ balance: newBalance, updated_at: new Date().toISOString() })
          .eq('user_id', currentUserId);
      });

      await supabase.from('content_purchases').insert({
        user_id: currentUserId,
        content_id: contentId,
        payment_type: 'token',
        tokens_spent: price,
      });

      loadExclusiveContent();
    };

    // Load exclusive content if tab exists
    if (document.getElementById('exclusive-content-root')) {
      loadExclusiveContent();
    }
  })();
</script>
