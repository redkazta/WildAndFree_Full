---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const artists = [
    { 
      id: 'a1', 
      nombre: 'Nova K', 
      rol: 'Rapero', 
      imagenes: {
        perfil: 'https://images.unsplash.com/photo-1520975958221-7f61d4d6df4b?auto=format&fit=crop&w=800&q=80',
        hero: 'https://images.unsplash.com/photo-1493225255756-d9584f8606e9?auto=format&fit=crop&w=1920&q=80'
      },
      bio: 'Nova K es una de las voces más disruptivas de la escena actual. Con líricas crudas y un flow inigualable, redefine lo que significa ser libre en la ciudad. Desde sus inicios en el underground de la CDMX, ha mantenido una visión clara: la música es la única salida.',
      redes: { ig: '@novak_oficial', sp: 'Nova K', yt: 'NovaKVEVO' },
      stats: { seguidores: '2.4M', oyentes: '850K', canciones: '32' },
      eventos: [
        { id: 'e1', titulo: 'Wild Night CDMX', fecha: '15 MAR 2024', lugar: 'Foro Indie Rocks', imagen: 'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=800&q=80' },
        { id: 'e2', titulo: 'Urban Fest GDL', fecha: '22 MAR 2024', lugar: 'C3 Stage', imagen: 'https://images.unsplash.com/photo-1459749411177-042180ce673c?auto=format&fit=crop&w=800&q=80' }
      ],
      lanzamientos: [
        { id: 'l1', titulo: 'Sin Reglas', tipo: 'Álbum', fecha: '2024', imagen: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?auto=format&fit=crop&w=400&q=80' },
        { id: 'l2', titulo: 'Noches Frías', tipo: 'Sencillo', fecha: '2023', imagen: 'https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?auto=format&fit=crop&w=400&q=80' },
        { id: 'l3', titulo: 'Asfalto', tipo: 'EP', fecha: '2023', imagen: 'https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?auto=format&fit=crop&w=400&q=80' },
        { id: 'l4', titulo: 'Vértigo', tipo: 'Sencillo', fecha: '2022', imagen: 'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=400&q=80' }
      ]
    },
    { 
      id: 'a2', 
      nombre: 'Sable', 
      rol: 'Productor', 
      imagenes: {
        perfil: 'https://images.unsplash.com/photo-1520975693413-35e0000c0e4e?auto=format&fit=crop&w=800&q=80',
        hero: 'https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?auto=format&fit=crop&w=1920&q=80'
      },
      bio: 'El arquitecto sonoro detrás de los beats más pesados. Sable fusiona lo industrial con lo orgánico para crear paisajes sonoros únicos que han definido el sonido de la última década.',
      redes: { ig: '@sable_beats', sp: 'Sable', yt: 'SableTV' },
      stats: { seguidores: '1.2M', oyentes: '400K', canciones: '150' },
      eventos: [
        { id: 'e3', titulo: 'Beatmaker Sessions', fecha: '10 ABR 2024', lugar: 'Estudio 404', imagen: 'https://images.unsplash.com/photo-1589578236639-5381345b6687?auto=format&fit=crop&w=800&q=80' }
      ],
      lanzamientos: [
        { id: 'l5', titulo: 'Industrial Soul', tipo: 'Álbum', fecha: '2024', imagen: 'https://images.unsplash.com/photo-1520975693413-35e0000c0e4e?auto=format&fit=crop&w=400&q=80' },
        { id: 'l6', titulo: 'Echoes', tipo: 'EP', fecha: '2023', imagen: 'https://images.unsplash.com/photo-1589578236639-5381345b6687?auto=format&fit=crop&w=400&q=80' }
      ]
    }
  ];

  return artists.map(artist => ({
    params: { id: artist.id },
    props: { artist }
  }));
}

const { artist } = Astro.props;

const config = {
  name: `Wild Gvng - ${artist.nombre}`,
  primary_color: "#C98300",
  secondary_color: "#8A0303"
};
---

<Layout config={config}>
  <main class="min-h-screen bg-black">
    <!-- Hero Section -->
    <div class="relative h-[70vh] w-full overflow-hidden">
      <img src={artist.imagenes.hero} class="w-full h-full object-cover opacity-40 scale-105" alt="" />
      <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>
      
      <div class="absolute bottom-0 left-0 w-full p-6 md:p-20">
        <div class="max-w-6xl mx-auto flex flex-col md:flex-row items-end gap-10">
          <div class="w-48 h-48 md:w-64 md:h-64 rounded-3xl overflow-hidden shadow-2xl border-4 border-white/5 shrink-0">
            <img src={artist.imagenes.perfil} class="w-full h-full object-cover" alt={artist.nombre} />
          </div>
          <div class="space-y-6 pb-4">
            <div class="space-y-2 text-center md:text-left">
              <span class="inline-block px-4 py-1.5 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-500 text-[10px] font-black uppercase tracking-[0.3em]">
                {artist.rol} // Artista Oficial
              </span>
              <h1 class="text-6xl md:text-9xl font-black tracking-tighter text-white uppercase leading-none">
                {artist.nombre}
              </h1>
            </div>
            <div class="flex flex-wrap justify-center md:justify-start gap-6">
              {Object.entries(artist.redes).map(([key, val]) => (
                <a href="#" class="text-white/40 hover:text-orange-500 transition-colors text-[10px] font-black uppercase tracking-widest">{key}: {val}</a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-6 py-20 space-y-32">
      <!-- Bio & Radio en Vivo -->
      <section class="grid md:grid-cols-3 gap-20">
        <div class="md:col-span-2 space-y-12">
          <div class="space-y-8">
            <h2 class="text-3xl font-black uppercase tracking-tighter text-white">Sobre el Artista</h2>
            <p class="text-xl text-white/80 font-bold leading-relaxed">
              {artist.bio}
            </p>
            <div class="flex gap-4 pt-4">
              <button class="px-10 py-5 bg-white text-black text-xs font-black uppercase tracking-[0.3em] rounded-2xl hover:bg-orange-500 hover:text-white transition-all transform hover:-translate-y-1">Seguir</button>
              <button class="px-10 py-5 bg-white/5 border border-white/10 text-white text-xs font-black uppercase tracking-[0.3em] rounded-2xl hover:bg-white/10 transition-all transform hover:-translate-y-1">Mensaje</button>
            </div>
          </div>

          <!-- Radio en Vivo (Mock) -->
          <div class="p-8 rounded-[40px] bg-gradient-to-br from-orange-500/20 to-red-600/20 border border-white/10 space-y-8 relative overflow-hidden group">
            <div class="absolute top-0 right-0 p-8">
              <div class="flex items-center gap-2">
                <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                <span class="text-[10px] font-black uppercase tracking-[0.2em] text-red-500">En Vivo</span>
              </div>
            </div>
            
            <div class="flex flex-col md:flex-row items-center gap-8 relative z-10">
              <div class="w-32 h-32 rounded-2xl bg-black/40 flex items-center justify-center border border-white/10 shrink-0 overflow-hidden">
                <img src={artist.imagenes.perfil} class="w-full h-full object-cover opacity-50 group-hover:scale-110 transition-transform duration-700" alt="" />
                <div class="absolute inset-0 flex items-center justify-center">
                   <svg width="40" height="40" viewBox="0 0 24 24" fill="white"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-1 14H9V8h2v8zm4 0h-2V8h2v8z"/></svg>
                </div>
              </div>
              <div class="flex-1 space-y-2 text-center md:text-left">
                <p class="text-[10px] font-black uppercase tracking-[0.3em] text-orange-500">Radio Wild Gvng // {artist.nombre} Mix</p>
                <h3 class="text-3xl font-black uppercase tracking-tighter text-white">Sintonizando la calle</h3>
                <p class="text-sm font-bold text-white/40 uppercase tracking-widest">Conectado con Spotify</p>
              </div>
              <button class="px-8 py-4 bg-orange-500 text-white text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-white hover:text-black transition-all">Escuchar Ahora</button>
            </div>
          </div>
        </div>

        <div class="space-y-8">
          <h2 class="text-3xl font-black uppercase tracking-tighter text-white">Estadísticas</h2>
          <div class="grid gap-4">
            {Object.entries(artist.stats).map(([label, value]) => (
              <div class="p-6 rounded-3xl bg-white/[0.03] border border-white/5 space-y-1">
                <p class="text-[10px] font-black uppercase tracking-[0.2em] text-white/40">{label}</p>
                <p class="text-3xl font-black text-white tracking-tighter">{value}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- Próximos Eventos -->
      <section class="space-y-12">
        <div class="flex items-end justify-between border-b border-white/10 pb-8">
          <div class="space-y-2">
            <h2 class="text-4xl font-black tracking-tighter text-white uppercase">Próximos Eventos</h2>
            <p class="text-orange-500 font-black uppercase tracking-[0.3em] text-xs">No te pierdas a {artist.nombre} en vivo</p>
          </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {artist.eventos.map(evento => (
            <div class="group relative flex items-center gap-8 p-6 rounded-3xl bg-white/[0.02] border border-white/5 hover:bg-white/[0.05] transition-all duration-500">
              <div class="w-32 h-32 rounded-2xl overflow-hidden shrink-0">
                <img src={evento.imagen} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700" alt="" />
              </div>
              <div class="flex-1 space-y-4">
                <div>
                  <p class="text-[10px] font-black uppercase tracking-[0.2em] text-orange-500">{evento.fecha}</p>
                  <h3 class="text-2xl font-black uppercase tracking-tighter text-white">{evento.titulo}</h3>
                  <p class="text-xs font-bold text-white/40 uppercase tracking-widest">{evento.lugar}</p>
                </div>
                <a href={`/evento/${evento.id}`} class="inline-block text-[10px] font-black uppercase tracking-[0.3em] text-white border-b border-white/20 pb-1 hover:border-orange-500 hover:text-orange-500 transition-all">Ver Detalles</a>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Últimos Lanzamientos -->
      <section class="space-y-12">
        <div class="flex items-end justify-between border-b border-white/10 pb-8">
          <div class="space-y-2">
            <h2 class="text-4xl font-black tracking-tighter text-white uppercase">Últimos Lanzamientos</h2>
            <p class="text-orange-500 font-black uppercase tracking-[0.3em] text-xs">Lo más nuevo en las calles</p>
          </div>
        </div>
        
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          {artist.lanzamientos.map(item => (
            <div class="group space-y-4">
              <div class="relative aspect-square rounded-3xl overflow-hidden bg-white/5 border border-white/10 group-hover:border-orange-500/50 transition-all">
                <img src={item.imagen} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700" alt={item.titulo} />
                <div class="absolute inset-0 bg-black/40 opacity-0 group-hover:opacity-100 transition-opacity flex items-center justify-center">
                  <button class="w-12 h-12 rounded-full bg-orange-500 text-black flex items-center justify-center transform scale-90 group-hover:scale-100 transition-all shadow-xl shadow-orange-500/20">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                  </button>
                </div>
              </div>
              <div class="px-2">
                <h4 class="text-lg font-black uppercase text-white tracking-tight">{item.titulo}</h4>
                <p class="text-[10px] font-black text-orange-500 tracking-[0.2em] uppercase">{item.fecha} • {item.tipo}</p>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>
  </main>
</Layout>
