---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Música",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};

// Generar más datos de prueba para mostrar "muchas rolas"
const baseTracks = [
  {
    title: 'NOCHES DE NEÓN',
    artist: 'LIL KIRO',
    album: 'LUCES DE CIUDAD',
    duration: '3:24',
    cover: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=300&h=300&fit=crop&crop=face',
    plays: '2.1M'
  },
  {
    title: 'TOKYO DRIFT',
    artist: 'NEON GHOST',
    album: 'SESIONES DE MEDIANOCHE',
    duration: '4:12',
    cover: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=300&h=300&fit=crop&crop=face',
    plays: '1.8M'
  },
  {
    title: 'REINO DE SOMBRAS',
    artist: 'SHADOW V',
    album: 'MATERIA OSCURA',
    duration: '3:58',
    cover: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=300&h=300&fit=crop&crop=face',
    plays: '1.5M'
  },
  {
    title: 'CRISTALINO',
    artist: 'CRYSTAL WAVE',
    album: 'ONDAS',
    duration: '3:33',
    cover: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=300&h=300&fit=crop&crop=face',
    plays: '890K'
  },
  {
    title: 'PASEO DE MEDIANOCHE',
    artist: 'MIDNIGHT RIDER',
    album: 'JINETE NOCTURNO',
    duration: '4:01',
    cover: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=300&h=300&fit=crop&crop=face',
    plays: '2.7M'
  },
  {
    title: 'FUEGO FATUO',
    artist: 'LIL KIRO',
    album: 'LUCES DE CIUDAD',
    duration: '2:55',
    cover: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300&h=300&fit=crop&crop=face',
    plays: '3.2M'
  },
  {
    title: 'VAPORWAVE DREAMS',
    artist: 'NEON GHOST',
    album: 'SESIONES DE MEDIANOCHE',
    duration: '3:45',
    cover: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=300&h=300&fit=crop&crop=face',
    plays: '1.1M'
  },
  {
    title: 'URBAN JUNGLE',
    artist: 'WILD SQUAD',
    album: 'MIXTAPE VOL.1',
    duration: '3:10',
    cover: 'https://images.unsplash.com/photo-1531384441138-2736e62e0919?w=300&h=300&fit=crop&crop=face',
    plays: '950K'
  },
  {
    title: 'GRAFFITI SOUL',
    artist: 'STREET ARTIST',
    album: 'WALLS',
    duration: '4:20',
    cover: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=300&h=300&fit=crop&crop=face',
    plays: '1.4M'
  },
  {
    title: 'CONCRETO Y ACERO',
    artist: 'HEAVY HITTERS',
    album: 'CONSTRUCCIÓN',
    duration: '3:50',
    cover: 'https://images.unsplash.com/photo-1529626455594-4ff0802cfb7e?w=300&h=300&fit=crop&crop=face',
    plays: '2.0M'
  }
];

// Duplicar para tener una lista larga
const tracks = [
  ...baseTracks.map((t, i) => ({ ...t, id: i + 1 })),
  ...baseTracks.map((t, i) => ({ ...t, id: i + 11, title: t.title + ' (REMIX)', duration: '4:30' })),
  ...baseTracks.map((t, i) => ({ ...t, id: i + 21, title: t.title + ' (INSTRUMENTAL)', duration: '3:15' }))
];

---

<Layout config={config}>
  <div class="min-h-screen bg-[#050505] text-white pb-32 selection:bg-[var(--wild-orange)] selection:text-black">
    
    <!-- Top Bar -->
    <div class="bg-black border-b border-white/10 py-3">
        <div class="container mx-auto px-4 max-w-[1600px] flex justify-between items-center">
            <span class="text-[10px] font-black uppercase tracking-[0.2em] text-[var(--wild-orange)]">Wild Music Library</span>
            <div class="flex gap-4">
                <span class="text-[10px] font-bold uppercase tracking-widest text-gray-500">Vol. 2026</span>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4 py-8 max-w-[1600px] space-y-12 relative z-10 animate-fade-in-up">
      
      <!-- Header Brutalista con Marquee -->
      <div class="border-b border-white/10 pb-8 mt-4 relative overflow-hidden rounded-2xl bg-[#0a0a0a] border border-white/5 p-8 lg:p-12">
        <div class="absolute inset-0 bg-gradient-to-br from-[var(--wild-crimson)]/10 to-transparent pointer-events-none"></div>
        <div class="absolute top-0 right-0 w-64 h-64 bg-[var(--wild-orange)]/10 blur-[80px] rounded-full pointer-events-none"></div>

        <div class="flex flex-col md:flex-row items-end gap-6 mb-12 relative z-10">
          <h1 class="text-6xl md:text-9xl font-black tracking-tighter text-white uppercase leading-none hover:text-[var(--wild-orange)] transition-colors duration-500 drop-shadow-2xl">
            SONIDOS
          </h1>
          <div class="flex flex-col mb-2">
             <span class="text-xl font-bold text-black bg-[var(--wild-orange)] px-3 py-1 inline-block w-fit transform -skew-x-12">WILD RECORDS</span>
             <span class="text-sm font-mono text-gray-400 tracking-widest mt-2 pl-2 border-l-2 border-[var(--wild-orange)]">CATÁLOGO COMPLETO</span>
          </div>
        </div>
        
        <!-- Marquee -->
        <div class="relative overflow-hidden bg-white/5 border-y border-white/10 py-3 backdrop-blur-sm">
          <div class="whitespace-nowrap animate-marquee inline-block">
            <span class="text-white font-mono font-bold text-lg mx-8">NOW PLAYING: NOCHES DE NEÓN - LIL KIRO</span>
            <span class="text-[var(--wild-orange)] font-black mx-4">///</span>
            <span class="text-white font-mono font-bold text-lg mx-8">NEW RELEASE: SESIONES DE MEDIANOCHE</span>
            <span class="text-[var(--wild-orange)] font-black mx-4">///</span>
            <span class="text-white font-mono font-bold text-lg mx-8">TOP CHARTS: WILD GVNG GLOBAL</span>
            <span class="text-[var(--wild-orange)] font-black mx-4">///</span>
             <span class="text-white font-mono font-bold text-lg mx-8">NOW PLAYING: NOCHES DE NEÓN - LIL KIRO</span>
            <span class="text-[var(--wild-orange)] font-black mx-4">///</span>
            <span class="text-white font-mono font-bold text-lg mx-8">NEW RELEASE: SESIONES DE MEDIANOCHE</span>
            <span class="text-[var(--wild-orange)] font-black mx-4">///</span>
            <span class="text-white font-mono font-bold text-lg mx-8">TOP CHARTS: WILD GVNG GLOBAL</span>
            <span class="text-[var(--wild-orange)] font-black mx-4">///</span>
          </div>
        </div>
      </div>

      <!-- Lista de Tracks Compacta y Densa -->
      <section>
        <div class="flex items-center justify-between mb-8">
          <div class="flex items-center gap-4">
            <div class="w-12 h-12 bg-[var(--wild-orange)] text-white flex items-center justify-center font-black text-xl rounded-lg shadow-[0_0_20px_rgba(255,85,0,0.3)]">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M9 18V5l12-2v13"></path><circle cx="6" cy="18" r="3"></circle><circle cx="18" cy="16" r="3"></circle></svg>
            </div>
            <h2 class="text-3xl md:text-4xl font-black uppercase tracking-tighter text-white">Todas las Rolas ({tracks.length})</h2>
          </div>
          
          <!-- Filtros simples -->
          <div class="hidden md:flex gap-2 p-1 bg-white/5 rounded-lg border border-white/10">
            <button class="px-4 py-2 bg-[var(--wild-orange)] text-white font-bold rounded-md shadow-lg transition-all text-xs uppercase tracking-wider">POPULAR</button>
            <button class="px-4 py-2 hover:bg-white/10 text-gray-400 hover:text-white font-bold rounded-md transition-all text-xs uppercase tracking-wider">NUEVO</button>
            <button class="px-4 py-2 hover:bg-white/10 text-gray-400 hover:text-white font-bold rounded-md transition-all text-xs uppercase tracking-wider">REMIXES</button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {tracks.map((track, index) => (
            <div class="group relative flex items-center gap-4 bg-[#0a0a0a] border border-white/5 p-3 rounded-xl hover:bg-[#151515] hover:border-[var(--wild-orange)]/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-[var(--wild-orange)]/5">
              
              <!-- Cover Tiny -->
              <div class="relative w-16 h-16 flex-shrink-0 rounded-lg overflow-hidden border border-white/10 group-hover:border-[var(--wild-orange)] transition-colors">
                <img src={track.cover} alt={track.title} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" />
                
                <!-- Play Overlay on Cover -->
                <button 
                  class="play-track-btn absolute inset-0 flex items-center justify-center bg-black/60 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer backdrop-blur-[2px]"
                  data-title={track.title}
                  data-artist={track.artist}
                  data-cover={track.cover}
                  data-duration={track.duration}
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="white" class="drop-shadow-lg"><path d="M8 5v14l11-7z"/></svg>
                </button>
              </div>

              <!-- Info -->
              <div class="flex-1 min-w-0">
                <div class="flex items-baseline justify-between">
                    <h4 class="text-base font-bold text-white uppercase truncate group-hover:text-[var(--wild-orange)] transition-colors pr-2">{track.title}</h4>
                    <span class="text-xs font-mono text-gray-500 group-hover:text-white transition-colors">{track.duration}</span>
                </div>
                <p class="text-xs font-mono text-gray-400 truncate">{track.artist}</p>
                <div class="flex items-center gap-2 mt-1">
                    <span class="text-[9px] font-black bg-white/10 text-gray-400 px-1.5 py-0.5 rounded uppercase tracking-wider group-hover:bg-[var(--wild-orange)]/20 group-hover:text-[var(--wild-orange)] transition-colors">{track.album}</span>
                </div>
              </div>

              <!-- Play Count (Desktop only) -->
              <div class="hidden xl:block text-xs font-mono text-gray-600 text-right min-w-[60px]">
                 <div class="flex items-center justify-end gap-1">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                    {track.plays}
                 </div>
              </div>
              
            </div>
          ))}
        </div>
      </section>

    </div>

    <!-- Floating Player (Walkman Style) -->
    <div id="floating-player" class="fixed bottom-8 right-8 z-50 translate-y-[150%] transition-transform duration-500">
      <div class="bg-[#0a0a0a] border border-white/20 p-4 w-[320px] shadow-[0_0_50px_rgba(0,0,0,0.8)] rounded-xl backdrop-blur-xl relative">
        <div class="absolute inset-0 bg-gradient-to-b from-white/5 to-transparent rounded-xl pointer-events-none"></div>
        
        <!-- Player Screen -->
        <div class="bg-[#111] border border-white/10 p-4 mb-4 rounded-lg relative overflow-hidden group">
           <div class="absolute inset-0 bg-[var(--wild-orange)]/5 opacity-50 animate-pulse"></div>
           <div class="relative z-10">
              <div class="flex justify-between items-center mb-2">
                 <p class="text-[10px] font-black text-[var(--wild-orange)] uppercase tracking-widest animate-pulse">Now Playing</p>
                 <div class="flex gap-0.5">
                    <div class="w-1 h-3 bg-[var(--wild-orange)] animate-bounce"></div>
                    <div class="w-1 h-2 bg-[var(--wild-orange)] animate-bounce" style="animation-delay: 0.1s"></div>
                    <div class="w-1 h-4 bg-[var(--wild-orange)] animate-bounce" style="animation-delay: 0.2s"></div>
                 </div>
              </div>
              <h4 id="player-title" class="text-lg font-black text-white truncate leading-none mb-1">SELECCIONA TRACK</h4>
              <p id="player-artist" class="text-xs font-bold text-gray-400 truncate">WILD GVNG</p>
              <div class="flex justify-between mt-3 text-[10px] font-mono text-gray-500">
                 <span id="current-time">0:00</span>
                 <span id="total-time">0:00</span>
              </div>
           </div>
        </div>

        <!-- Controls -->
        <div class="flex justify-between items-center gap-3">
           <button id="prev-btn" class="flex-1 bg-[#222] hover:bg-[#333] text-white p-3 rounded-lg transition-all hover:scale-105 active:scale-95">
              <svg class="w-4 h-4 mx-auto" fill="currentColor" viewBox="0 0 24 24"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
           </button>
           <button id="play-pause-btn" class="flex-[2] bg-gradient-to-r from-[var(--wild-orange)] to-[var(--wild-crimson)] text-white p-4 rounded-xl shadow-lg shadow-[var(--wild-orange)]/20 hover:shadow-[var(--wild-orange)]/40 transition-all hover:scale-105 active:scale-95 group">
              <svg id="play-icon" class="w-6 h-6 mx-auto fill-white" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <svg id="pause-icon" class="w-6 h-6 mx-auto hidden fill-white" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
           </button>
           <button id="next-btn" class="flex-1 bg-[#222] hover:bg-[#333] text-white p-3 rounded-lg transition-all hover:scale-105 active:scale-95">
              <svg class="w-4 h-4 mx-auto" fill="currentColor" viewBox="0 0 24 24"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
           </button>
        </div>
        
        <!-- Progress Bar -->
        <div class="mt-4 h-1.5 bg-[#222] rounded-full overflow-hidden cursor-pointer group">
           <div id="progress-fill" class="h-full bg-[var(--wild-orange)] w-0 transition-all duration-100 group-hover:bg-white"></div>
        </div>
        
        <button id="close-player" class="absolute -top-3 -right-3 bg-[#222] text-white w-8 h-8 flex items-center justify-center rounded-full border border-white/10 shadow-lg hover:bg-red-600 transition-colors cursor-pointer z-20">
           <svg width="12" height="12" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 1l12 12M13 1L1 13"/></svg>
        </button>
      </div>
    </div>
  </div>
</Layout>

<style is:global define:vars={{ streetAccent: tenant.primary_color }}>
  :root {
    --street-accent: var(--streetAccent);

    /* Wild Palette Shared */
    --wild-orange: #FF5500;
    --wild-light-orange: #FF8C00;
    --wild-blood: #8A0303;
    --wild-crimson: #DC143C;
    --wild-dark-red: #4A0404;
  }
  
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  
  .animate-marquee {
    animation: marquee 20s linear infinite;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
</style>

<script>
  // Player Logic
  const player = document.getElementById('floating-player');
  const playBtns = document.querySelectorAll('.play-track-btn');
  const closeBtn = document.getElementById('close-player');
  const playPauseBtn = document.getElementById('play-pause-btn');
  const playIcon = document.getElementById('play-icon');
  const pauseIcon = document.getElementById('pause-icon');
  const progressFill = document.getElementById('progress-fill');
  
  // Elementos de texto
  const titleEl = document.getElementById('player-title');
  const artistEl = document.getElementById('player-artist');
  const totalTimeEl = document.getElementById('total-time');
  const currentTimeEl = document.getElementById('current-time');
  
  let isPlaying = false;
  let progress = 0;
  let interval: number | undefined;

  if (player && closeBtn && playPauseBtn && playIcon && pauseIcon && progressFill && titleEl && artistEl && totalTimeEl && currentTimeEl) {
    
    playBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        // Stop bubbling
        e.stopPropagation();
        
        const target = e.currentTarget as HTMLElement;
        const title = target.dataset.title || '';
        const artist = target.dataset.artist || '';
        const duration = target.dataset.duration || '0:00';
        
        // Update UI
        titleEl.textContent = title;
        artistEl.textContent = artist;
        totalTimeEl.textContent = duration;
        
        // Show Player
        player.classList.remove('translate-y-[150%]');
        
        // Simulate Play
        isPlaying = true;
        updatePlayBtn();
        startProgress();
      });
    });

    closeBtn.addEventListener('click', () => {
      player.classList.add('translate-y-[150%]');
      isPlaying = false;
      updatePlayBtn();
      stopProgress();
    });

    playPauseBtn.addEventListener('click', () => {
        isPlaying = !isPlaying;
        updatePlayBtn();
        if (isPlaying) startProgress();
        else stopProgress();
    });

    function updatePlayBtn() {
        if (isPlaying) {
            playIcon?.classList.add('hidden');
            pauseIcon?.classList.remove('hidden');
        } else {
            playIcon?.classList.remove('hidden');
            pauseIcon?.classList.add('hidden');
        }
    }

    function startProgress() {
        stopProgress();
        interval = window.setInterval(() => {
            progress += 0.5;
            if (progress > 100) progress = 0;
            if (progressFill) progressFill.style.width = `${progress}%`;
        }, 100);
    }

    function stopProgress() {
        if (interval) clearInterval(interval);
    }
  }
</script>
