---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Música",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};

// --- DATA MOCK ---

const featuredAlbum = {
  title: "CRÓNICAS DEL ASFALTO",
  artist: "LIL KIRO x NEON GHOST",
  year: "2026",
  cover: "https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?w=800&h=800&fit=crop",
  description: "Un viaje sonoro por las calles de la metrópolis. Bajos pesados, sintetizadores oscuros y líricas que cortan como navaja.",
  tracks: [
    { title: "INTRO: LUCES", duration: "1:45" },
    { title: "VELOCIDAD LUZ", duration: "3:12" },
    { title: "DISTRITO 9", duration: "2:58" },
    { title: "SIN RETORNO", duration: "4:20" }
  ]
};

const topCharts = [
  { rank: "01", title: "NOCHES DE NEÓN", artist: "LIL KIRO", plays: "2.1M", trend: "up" },
  { rank: "02", title: "TOKYO DRIFT", artist: "NEON GHOST", plays: "1.8M", trend: "same" },
  { rank: "03", title: "FUEGO FATUO", artist: "LIL KIRO", plays: "1.5M", trend: "up" },
  { rank: "04", title: "VAPORWAVE DREAMS", artist: "NEON GHOST", plays: "1.1M", trend: "down" },
  { rank: "05", title: "URBAN JUNGLE", artist: "WILD SQUAD", plays: "950K", trend: "up" }
];

const playlists = [
  { title: "NIGHT DRIVE", desc: "Para quemar llanta a medianoche.", color: "from-blue-900 to-purple-900", icon: "🚗" },
  { title: "GYM RAGE", desc: "Energía pura para romper tus PRs.", color: "from-red-900 to-orange-900", icon: "💪" },
  { title: "CODE MODE", desc: "Focus total. Sin letras, solo beats.", color: "from-green-900 to-emerald-900", icon: "💻" },
  { title: "CHILL & SMOKE", desc: "Vibras relajadas para el after.", color: "from-gray-800 to-gray-900", icon: "💨" }
];

const allTracks = [
  { id: 1, title: 'NOCHES DE NEÓN', artist: 'LIL KIRO', album: 'LUCES DE CIUDAD', duration: '3:24', bpm: 128, key: 'Am', cover: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=300&h=300&fit=crop' },
  { id: 2, title: 'TOKYO DRIFT', artist: 'NEON GHOST', album: 'SESIONES DE MEDIANOCHE', duration: '4:12', bpm: 140, key: 'F#', cover: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=300&h=300&fit=crop' },
  { id: 3, title: 'REINO DE SOMBRAS', artist: 'SHADOW V', album: 'MATERIA OSCURA', duration: '3:58', bpm: 95, key: 'Cm', cover: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=300&h=300&fit=crop' },
  { id: 4, title: 'CRISTALINO', artist: 'CRYSTAL WAVE', album: 'ONDAS', duration: '3:33', bpm: 110, key: 'G', cover: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=300&h=300&fit=crop' },
  { id: 5, title: 'PASEO DE MEDIANOCHE', artist: 'MIDNIGHT RIDER', album: 'JINETE NOCTURNO', duration: '4:01', bpm: 124, key: 'Dm', cover: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=300&h=300&fit=crop' },
  { id: 6, title: 'FUEGO FATUO', artist: 'LIL KIRO', album: 'LUCES DE CIUDAD', duration: '2:55', bpm: 130, key: 'Em', cover: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300&h=300&fit=crop' },
  { id: 7, title: 'VAPORWAVE DREAMS', artist: 'NEON GHOST', album: 'SESIONES DE MEDIANOCHE', duration: '3:45', bpm: 100, key: 'Bm', cover: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=300&h=300&fit=crop' },
  { id: 8, title: 'URBAN JUNGLE', artist: 'WILD SQUAD', album: 'MIXTAPE VOL.1', duration: '3:10', bpm: 145, key: 'Am', cover: 'https://images.unsplash.com/photo-1531384441138-2736e62e0919?w=300&h=300&fit=crop' },
  { id: 9, title: 'GRAFFITI SOUL', artist: 'STREET ARTIST', album: 'WALLS', duration: '4:20', bpm: 90, key: 'C#m', cover: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=300&h=300&fit=crop' },
  { id: 10, title: 'CONCRETO Y ACERO', artist: 'HEAVY HITTERS', album: 'CONSTRUCCIÓN', duration: '3:50', bpm: 135, key: 'Fm', cover: 'https://images.unsplash.com/photo-1529626455594-4ff0802cfb7e?w=300&h=300&fit=crop' }
];

---

<Layout config={config}>
  <div class="min-h-screen bg-[#050505] text-white pb-32 selection:bg-[var(--wild-orange)] selection:text-black font-sans">
    
    <!-- Top Bar -->
    <div class="bg-black border-b border-white/10 py-2 sticky top-0 z-40 backdrop-blur-md bg-black/80">
        <div class="container mx-auto px-4 max-w-[1600px] flex justify-between items-center">
            <div class="flex items-center gap-2">
                <div class="w-2 h-2 bg-[var(--wild-orange)] rounded-full animate-pulse"></div>
                <span class="text-[10px] font-black uppercase tracking-[0.2em] text-white">Wild Music OS v2.0</span>
            </div>
            <div class="flex gap-4 text-[10px] font-mono text-gray-500">
                <span>BITRATE: 320KBPS</span>
                <span>SERVER: ONLINE</span>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4 py-8 max-w-[1600px] space-y-24 relative z-10 animate-fade-in-up">
      
      <!-- HERO: FEATURED ALBUM -->
      <section class="relative">
        <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 items-center">
            
            <!-- Cover Art Area -->
            <div class="lg:col-span-5 relative group perspective-1000">
                <div class="relative transform transition-transform duration-700 group-hover:rotate-y-6 group-hover:rotate-x-6 preserve-3d">
                    <!-- Glow -->
                    <div class="absolute inset-0 bg-[var(--wild-orange)]/20 blur-[100px] rounded-full"></div>
                    
                    <!-- Vinyl Record (Behind) -->
                    <div class="absolute top-2 right-2 w-[95%] h-[95%] bg-black rounded-full border-[10px] border-[#111] shadow-2xl flex items-center justify-center transform translate-x-12 group-hover:translate-x-24 transition-transform duration-700 ease-out z-0">
                        <div class="w-1/3 h-1/3 bg-[var(--wild-orange)] rounded-full border-[20px] border-[#1a1a1a] flex items-center justify-center">
                            <div class="w-2 h-2 bg-black rounded-full"></div>
                        </div>
                        <!-- Grooves -->
                        <div class="absolute inset-0 rounded-full border border-white/5 opacity-20" style="width: 90%; height: 90%; margin: auto;"></div>
                        <div class="absolute inset-0 rounded-full border border-white/5 opacity-20" style="width: 80%; height: 80%; margin: auto;"></div>
                        <div class="absolute inset-0 rounded-full border border-white/5 opacity-20" style="width: 70%; height: 70%; margin: auto;"></div>
                    </div>

                    <!-- Album Cover -->
                    <div class="relative z-10 bg-black border border-white/10 p-2 shadow-2xl rounded-sm">
                         <img src={featuredAlbum.cover} alt={featuredAlbum.title} class="w-full aspect-square object-cover grayscale contrast-125 group-hover:grayscale-0 transition-all duration-700" />
                         <!-- Sticker -->
                         <div class="absolute top-4 right-4 bg-white text-black p-2 transform rotate-12 shadow-lg">
                            <p class="text-[8px] font-black uppercase leading-tight text-center">Wild Gvng<br>Approved<br>2026</p>
                         </div>
                    </div>
                </div>
            </div>

            <!-- Info Area -->
            <div class="lg:col-span-7 space-y-8">
                <div>
                    <div class="flex items-center gap-4 mb-4">
                        <span class="bg-[var(--wild-orange)] text-white text-xs font-black uppercase px-3 py-1 tracking-wider">Featured Album</span>
                        <span class="text-xs font-mono text-gray-500 border border-gray-800 px-2 py-0.5">REL: {featuredAlbum.year}</span>
                    </div>
                    <h1 class="text-6xl md:text-8xl font-black uppercase italic tracking-tighter leading-[0.85] text-white mb-2">
                        {featuredAlbum.title}
                    </h1>
                    <h2 class="text-2xl md:text-3xl font-bold text-gray-400 uppercase tracking-widest mb-6">{featuredAlbum.artist}</h2>
                    <p class="text-gray-400 max-w-xl text-lg font-medium border-l-4 border-[var(--wild-orange)] pl-6 italic">
                        "{featuredAlbum.description}"
                    </p>
                </div>

                <!-- Tracklist Preview -->
                <div class="bg-white/5 border border-white/10 rounded-xl p-6 backdrop-blur-sm max-w-2xl">
                    <h3 class="text-xs font-bold text-gray-500 uppercase tracking-widest mb-4 border-b border-white/10 pb-2">Tracklist Preview</h3>
                    <ul class="space-y-3">
                        {featuredAlbum.tracks.map((track, i) => (
                            <li class="flex justify-between items-center text-sm group cursor-default">
                                <span class="text-gray-500 font-mono w-6">0{i+1}</span>
                                <span class="text-white font-bold uppercase group-hover:text-[var(--wild-orange)] transition-colors">{track.title}</span>
                                <span class="text-gray-600 font-mono border-b border-gray-800 flex-grow mx-4 group-hover:border-[var(--wild-orange)]/30 transition-colors"></span>
                                <span class="text-gray-500 font-mono">{track.duration}</span>
                            </li>
                        ))}
                    </ul>
                </div>

                <div class="flex gap-4">
                    <button class="bg-white text-black px-8 py-4 text-sm font-black uppercase tracking-[0.2em] hover:bg-[var(--wild-orange)] hover:text-white transition-all shadow-[4px_4px_0px_rgba(255,255,255,0.2)] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px] flex items-center gap-3">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                        Listen Now
                    </button>
                    <button class="border border-white/20 text-white px-8 py-4 text-sm font-black uppercase tracking-[0.2em] hover:bg-white hover:text-black transition-all">
                        Save to Library
                    </button>
                </div>
            </div>
        </div>
      </section>

      <!-- SECCIÓN 2: CHARTS & MOODS -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
          
          <!-- TOP CHARTS -->
          <div class="lg:col-span-4 space-y-6">
              <div class="flex items-center justify-between border-b border-white/10 pb-4">
                  <h3 class="text-2xl font-black uppercase tracking-tighter text-white">Top Charts</h3>
                  <span class="text-[10px] font-mono text-[var(--wild-orange)] animate-pulse">● LIVE UPDATES</span>
              </div>
              
              <div class="space-y-2">
                  {topCharts.map((track) => (
                      <div class="group flex items-center gap-4 p-3 hover:bg-white/5 rounded-lg transition-colors border border-transparent hover:border-white/10 cursor-pointer">
                          <span class="text-4xl font-black text-white/10 group-hover:text-[var(--wild-orange)] transition-colors font-mono">{track.rank}</span>
                          <div class="flex-1">
                              <h4 class="text-white font-bold uppercase text-sm leading-tight">{track.title}</h4>
                              <p class="text-gray-500 text-xs uppercase">{track.artist}</p>
                          </div>
                          <div class="text-right">
                              <span class="block text-white font-mono text-xs font-bold">{track.plays}</span>
                              <span class={`text-[10px] uppercase font-black ${track.trend === 'up' ? 'text-green-500' : track.trend === 'down' ? 'text-red-500' : 'text-gray-600'}`}>
                                  {track.trend === 'up' ? '▲ UP' : track.trend === 'down' ? '▼ DOWN' : '-'}
                              </span>
                          </div>
                      </div>
                  ))}
              </div>
          </div>

          <!-- MOODS / PLAYLISTS -->
          <div class="lg:col-span-8 space-y-6">
              <div class="flex items-center justify-between border-b border-white/10 pb-4">
                  <h3 class="text-2xl font-black uppercase tracking-tighter text-white">Curated Moods</h3>
                  <button class="text-xs font-bold uppercase text-gray-500 hover:text-white transition-colors">View All</button>
              </div>

              <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {playlists.map((playlist) => (
                      <div class={`relative h-40 rounded-xl overflow-hidden group cursor-pointer border border-white/10`}>
                          <div class={`absolute inset-0 bg-gradient-to-br ${playlist.color} opacity-80 group-hover:opacity-100 transition-opacity`}></div>
                          <!-- Noise Texture -->
                          <div class="absolute inset-0 opacity-20 bg-[url('https://www.transparenttextures.com/patterns/stardust.png')]"></div>
                          
                          <div class="absolute inset-0 p-6 flex flex-col justify-between z-10">
                              <div class="flex justify-between items-start">
                                  <span class="text-4xl">{playlist.icon}</span>
                                  <div class="w-8 h-8 rounded-full bg-white/10 backdrop-blur flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity transform translate-y-2 group-hover:translate-y-0">
                                      <svg width="12" height="12" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg>
                                  </div>
                              </div>
                              <div>
                                  <h4 class="text-2xl font-black uppercase text-white tracking-tight">{playlist.title}</h4>
                                  <p class="text-white/60 text-xs font-medium max-w-[80%]">{playlist.desc}</p>
                              </div>
                          </div>
                      </div>
                  ))}
              </div>
          </div>
      </div>

      <!-- SECCIÓN 3: ALL TRACKS (DATA TABLE STYLE) -->
      <section>
        <div class="flex items-end justify-between mb-8 border-b-2 border-white/10 pb-4">
            <div>
                <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter text-white mb-2">Database</h2>
                <p class="text-gray-500 font-mono text-xs uppercase tracking-widest">Full Library Access /// {allTracks.length} Entries Found</p>
            </div>
            
            <div class="hidden md:flex gap-4">
                <input type="text" placeholder="SEARCH DATABASE..." class="bg-[#111] border border-white/20 text-white px-4 py-2 text-xs font-mono w-64 focus:outline-none focus:border-[var(--wild-orange)] uppercase placeholder:text-gray-700" />
            </div>
        </div>

        <!-- Table Header -->
        <div class="grid grid-cols-12 gap-4 text-[10px] font-bold text-gray-500 uppercase tracking-widest border-b border-white/10 pb-2 mb-2 px-4">
            <div class="col-span-1">#</div>
            <div class="col-span-5 md:col-span-4">Track</div>
            <div class="col-span-2 hidden md:block">Album</div>
            <div class="col-span-2 hidden md:block text-center">BPM / Key</div>
            <div class="col-span-2 hidden md:block text-right">Duration</div>
            <div class="col-span-2 md:col-span-1 text-right">Action</div>
        </div>

        <!-- Table Rows -->
        <div class="space-y-1">
            {allTracks.map((track) => (
                <div class="group grid grid-cols-12 gap-4 items-center p-3 hover:bg-white/5 rounded-lg border border-transparent hover:border-white/10 transition-all cursor-pointer">
                    <div class="col-span-1 text-gray-600 font-mono text-xs group-hover:text-[var(--wild-orange)]">{track.id.toString().padStart(2, '0')}</div>
                    
                    <div class="col-span-5 md:col-span-4 flex items-center gap-3">
                        <img src={track.cover} class="w-10 h-10 rounded object-cover grayscale group-hover:grayscale-0 transition-all" />
                        <div class="min-w-0">
                            <h4 class="text-white font-bold uppercase text-sm truncate group-hover:text-[var(--wild-orange)] transition-colors">{track.title}</h4>
                            <p class="text-gray-500 text-xs truncate">{track.artist}</p>
                        </div>
                    </div>
                    
                    <div class="col-span-2 hidden md:block text-gray-400 text-xs font-medium uppercase truncate">{track.album}</div>
                    
                    <div class="col-span-2 hidden md:block text-center">
                        <span class="bg-white/5 border border-white/10 text-gray-400 text-[10px] font-mono px-2 py-0.5 rounded">{track.bpm} / {track.key}</span>
                    </div>
                    
                    <div class="col-span-2 hidden md:block text-right text-gray-500 font-mono text-xs">{track.duration}</div>
                    
                    <div class="col-span-2 md:col-span-1 flex justify-end">
                        <button 
                            class="play-track-btn w-8 h-8 rounded-full bg-white/10 hover:bg-[var(--wild-orange)] text-white flex items-center justify-center transition-colors"
                            data-title={track.title}
                            data-artist={track.artist}
                            data-cover={track.cover}
                            data-duration={track.duration}
                        >
                            <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                        </button>
                    </div>
                </div>
            ))}
        </div>
      </section>

    </div>

    <!-- Floating Player (Updated Design) -->
    <div id="floating-player" class="fixed bottom-6 right-6 z-50 translate-y-[150%] transition-transform duration-500">
      <div class="bg-[#0a0a0a] border border-white/20 w-[350px] shadow-[0_20px_50px_rgba(0,0,0,0.9)] rounded-sm overflow-hidden relative backdrop-blur-xl">
        
        <!-- LCD Display Area -->
        <div class="bg-[#1a1a1a] p-4 border-b border-white/10 relative overflow-hidden">
           <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20"></div>
           <div class="flex gap-4 items-center relative z-10">
               <div class="w-16 h-16 bg-black border border-white/10 shadow-inner overflow-hidden relative">
                   <img id="player-cover" src="" class="w-full h-full object-cover opacity-80" />
                   <div class="absolute inset-0 bg-[var(--wild-orange)]/20 mix-blend-overlay"></div>
               </div>
               <div class="flex-1 min-w-0">
                   <div class="flex items-center gap-2 mb-1">
                       <div class="w-1.5 h-1.5 bg-red-500 rounded-full animate-pulse"></div>
                       <span class="text-[8px] font-mono text-red-500 uppercase tracking-widest">Broadcasting</span>
                   </div>
                   <h4 id="player-title" class="text-white font-black uppercase truncate text-lg leading-none mb-0.5">TRACK TITLE</h4>
                   <p id="player-artist" class="text-gray-400 font-mono text-xs truncate uppercase">ARTIST NAME</p>
               </div>
           </div>
           
           <!-- Waveform Visualizer Mock -->
           <div class="flex items-end gap-0.5 h-6 mt-3 opacity-50">
               {Array(30).fill(0).map((_, i) => (
                   <div class="w-1 bg-[var(--wild-orange)] animate-pulse" style={`height: ${Math.random() * 100}%; animation-delay: ${i * 0.05}s`}></div>
               ))}
           </div>
        </div>

        <!-- Controls Area -->
        <div class="bg-[#111] p-4">
            <!-- Progress -->
            <div class="flex items-center gap-3 text-[10px] font-mono text-gray-500 mb-4">
                <span id="current-time">0:00</span>
                <div class="flex-1 h-1 bg-[#333] rounded-full overflow-hidden cursor-pointer group">
                    <div id="progress-fill" class="h-full bg-white w-0 group-hover:bg-[var(--wild-orange)] transition-colors"></div>
                </div>
                <span id="total-time">0:00</span>
            </div>

            <!-- Buttons -->
            <div class="flex justify-between items-center">
                <button class="text-gray-500 hover:text-white transition-colors"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 8l-4 4 4 4"/></svg></button>
                
                <div class="flex items-center gap-4">
                    <button id="prev-btn" class="text-white hover:text-[var(--wild-orange)] transition-colors"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg></button>
                    
                    <button id="play-pause-btn" class="w-12 h-12 bg-white text-black hover:bg-[var(--wild-orange)] hover:text-white rounded-full flex items-center justify-center transition-all shadow-lg hover:scale-105">
                        <svg id="play-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                        <svg id="pause-icon" width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="hidden"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
                    </button>
                    
                    <button id="next-btn" class="text-white hover:text-[var(--wild-orange)] transition-colors"><svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg></button>
                </div>
                
                <button id="close-player" class="text-gray-500 hover:text-red-500 transition-colors"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
            </div>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style is:global define:vars={{ streetAccent: tenant.primary_color }}>
  .preserve-3d {
    transform-style: preserve-3d;
  }
  .perspective-1000 {
    perspective: 1000px;
  }
  .rotate-y-6 {
    transform: rotateY(10deg) rotateX(5deg);
  }
  
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
</style>

<script>
  // Player Logic Refined
  const player = document.getElementById('floating-player');
  const playBtns = document.querySelectorAll('.play-track-btn');
  const closeBtn = document.getElementById('close-player');
  const playPauseBtn = document.getElementById('play-pause-btn');
  const playIcon = document.getElementById('play-icon');
  const pauseIcon = document.getElementById('pause-icon');
  const progressFill = document.getElementById('progress-fill');
  
  const titleEl = document.getElementById('player-title');
  const artistEl = document.getElementById('player-artist');
  const coverEl = document.getElementById('player-cover') as HTMLImageElement;
  const totalTimeEl = document.getElementById('total-time');
  
  let isPlaying = false;
  let progress = 0;
  let interval: number | undefined;

  if (player && closeBtn && playPauseBtn && playIcon && pauseIcon && progressFill) {
    
    playBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const target = e.currentTarget as HTMLElement;
        
        // Update UI
        if (titleEl) titleEl.textContent = target.dataset.title || '';
        if (artistEl) artistEl.textContent = target.dataset.artist || '';
        if (totalTimeEl) totalTimeEl.textContent = target.dataset.duration || '0:00';
        if (coverEl) coverEl.src = target.dataset.cover || '';
        
        // Show Player
        player.classList.remove('translate-y-[150%]');
        
        // Simulate Play
        isPlaying = true;
        updatePlayBtn();
        startProgress();
      });
    });

    closeBtn.addEventListener('click', () => {
      player.classList.add('translate-y-[150%]');
      isPlaying = false;
      updatePlayBtn();
      stopProgress();
    });

    playPauseBtn.addEventListener('click', () => {
        isPlaying = !isPlaying;
        updatePlayBtn();
        if (isPlaying) startProgress();
        else stopProgress();
    });

    function updatePlayBtn() {
        if (isPlaying) {
            playIcon?.classList.add('hidden');
            pauseIcon?.classList.remove('hidden');
        } else {
            playIcon?.classList.remove('hidden');
            pauseIcon?.classList.add('hidden');
        }
    }

    function startProgress() {
        stopProgress();
        interval = window.setInterval(() => {
            progress += 0.5;
            if (progress > 100) progress = 0;
            if (progressFill) progressFill.style.width = `${progress}%`;
        }, 100);
    }

    function stopProgress() {
        if (interval) clearInterval(interval);
    }
  }
</script>
