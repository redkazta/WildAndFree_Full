      <!-- 4. ASCENSIÓN (FREESTYLE TOURNAMENT) -->
      <section>
          <div class="flex items-center gap-4 mb-8">
              <h2 class="text-3xl font-black uppercase tracking-tighter text-white">Ascensión</h2>
              <span class="bg-red-600 text-white text-[10px] font-black uppercase px-2 py-0.5 rounded animate-pulse">En Vivo</span>
              <div class="h-px bg-white/10 flex-1"></div>
          </div>

          <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
              <!-- Clasificados -->
              <div class="lg:col-span-4 bg-[#0a0a0a] border border-white/10 rounded-xl p-6">
                  <h3 class="text-xl font-black uppercase mb-6 text-white">Clasificación</h3>
                  <div class="space-y-4">
                      {ascensionData.standings.map((mc, i) => (
