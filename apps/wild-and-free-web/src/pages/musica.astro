---
import Layout from '../layouts/Layout.astro';

const tracks = [
  {
    id: 1,
    title: 'Noches de Neón',
    artist: 'Lil Kiro',
    album: 'Luces de Ciudad',
    duration: '3:24',
    cover: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=300&h=300&fit=crop&crop=face',
    plays: '2.1M'
  },
  {
    id: 2,
    title: 'Tokyo Drift',
    artist: 'Neon Ghost',
    album: 'Sesiones de Medianoche',
    duration: '4:12',
    cover: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=300&h=300&fit=crop&crop=face',
    plays: '1.8M'
  },
  {
    id: 4,
    title: 'Reino de Sombras',
    artist: 'Shadow V',
    album: 'Materia Oscura',
    duration: '3:58',
    cover: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=300&h=300&fit=crop&crop=face',
    plays: '1.5M'
  },
  {
    id: 5,
    title: 'Cristalino',
    artist: 'Crystal Wave',
    album: 'Ondas',
    duration: '3:33',
    cover: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=300&h=300&fit=crop&crop=face',
    plays: '890K'
  },
  {
    id: 6,
    title: 'Paseo de Medianoche',
    artist: 'Midnight Rider',
    album: 'Jinete Nocturno',
    duration: '4:01',
    cover: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=300&h=300&fit=crop&crop=face',
    plays: '2.7M'
  }
];

const albums = [
  {
    id: 1,
    title: 'Luces de Ciudad',
    artist: 'Lil Kiro',
    cover: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=400&h=400&fit=crop&crop=face',
    year: '2024',
    tracks: 12
  },
  {
    id: 2,
    title: 'Sesiones de Medianoche',
    artist: 'Neon Ghost',
    cover: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&fit=crop&crop=face',
    year: '2024',
    tracks: 15
  }
];
---

<Layout config={{
  name: "Wild Gvng - Música",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>
  <main class="music-page">
    <div class="page-header">
      <div class="container">
        <h1 class="page-title">
          <span class="title-line">MÚSICA</span>
          <span class="title-line">WILD</span>
        </h1>
        <p class="page-subtitle">Los sonidos que definen una generación</p>
      </div>
    </div>

    <div class="container">
      <!-- Featured Albums -->
      <section class="featured-albums">
        <h2 class="section-title">Álbumes Destacados</h2>
        <div class="albums-grid">
          {albums.map((album) => (
            <div class="album-card">
              <div class="album-cover">
                <img src={album.cover} alt={album.title} />
                <div class="album-overlay">
                  <button class="play-btn" aria-label={`Reproducir ${album.title}`}>
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor">
                      <path d="M8 5v14l11-7z"/>
                    </svg>
                  </button>
                </div>
              </div>
              <div class="album-info">
                <h3 class="album-title">{album.title}</h3>
                <p class="album-artist">{album.artist}</p>
                <p class="album-meta">{album.year} • {album.tracks} canciones</p>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Popular Tracks -->
      <section class="popular-tracks">
        <h2 class="section-title">Canciones Populares</h2>
        <div class="tracks-list">
          {tracks.map((track, index) => (
            <div class="track-item">
              <div class="track-number">{String(index + 1).padStart(2, '0')}</div>
              <div class="track-cover">
                <img src={track.cover} alt={track.title} />
              </div>
              <div class="track-info">
                <h4 class="track-title">{track.title}</h4>
                <p class="track-artist">{track.artist}</p>
                <p class="track-album">{track.album}</p>
              </div>
              <div class="track-stats">
                <span class="track-plays">{track.plays}</span>
                <span class="track-duration">{track.duration}</span>
              </div>
              <div class="track-actions">
                <button class="action-btn" aria-label="Añadir a lista">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M8 2a.5.5 0 0 1 .5.5v5h5a.5.5 0 0 1 0 1h-5v5a.5.5 0 0 1-1 0v-5h-5a.5.5 0 0 1 0-1h5v-5A.5.5 0 0 1 8 2Z"/>
                  </svg>
                </button>
                <button class="action-btn" aria-label="Me gusta">
                  <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M8 1.314C12.438-3.248 23.534 4.735 8 15-7.534 4.736 3.562-3.248 8 1.314Z"/>
                  </svg>
                </button>
                <button class="play-track-btn" aria-label="Reproducir">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
                    <path d="M8 5v14l11-7z"/>
                  </svg>
                </button>
              </div>
            </div>
          ))}
        </div>
      </section>
    </div>

    <!-- Floating Player -->
    <div class="floating-player" id="floating-player">
      <div class="player-content">
        <div class="player-track">
          <img id="player-cover" src="" alt="" />
          <div class="player-info">
            <h4 id="player-title">Selecciona una canción</h4>
            <p id="player-artist">Wild Gvng</p>
          </div>
        </div>
        <div class="player-controls">
          <button class="player-btn" id="prev-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/>
            </svg>
          </button>
          <button class="player-btn play-pause" id="play-pause-btn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
              <path d="M8 5v14l11-7z"/>
            </svg>
          </button>
          <button class="player-btn" id="next-btn">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/>
            </svg>
          </button>
        </div>
        <div class="player-progress">
          <span id="current-time">0:00</span>
          <div class="progress-bar">
            <div class="progress-fill" id="progress-fill"></div>
          </div>
          <span id="total-time">0:00</span>
        </div>
        <button class="player-btn close-player" id="close-player">
          <svg width="16" height="16" viewBox="0 0 16 16" fill="currentColor">
            <path d="M2.146 2.854a.5.5 0 1 1 .708-.708L8 7.293l5.146-5.147a.5.5 0 0 1 .708.708L8.707 8l5.147 5.146a.5.5 0 0 1-.708.708L8 8.707l-5.146 5.147a.5.5 0 0 1-.708-.708L7.293 8 2.146 2.854Z"/>
          </svg>
        </button>
      </div>
    </div>
  </main>
</Layout>

<style>
  .music-page {
    min-height: 100vh;
    padding-top: 80px;
  }

  .page-header {
    background: linear-gradient(135deg, #000 0%, #111 100%);
    padding: 120px 0 80px;
    text-align: center;
    border-bottom: 1px solid rgba(201, 131, 0, 0.3);
  }

  .page-title {
    font-size: clamp(60px, 10vw, 120px);
    font-weight: 900;
    margin: 0 0 24px;
    line-height: 0.8;
    letter-spacing: 0.05em;
    font-family: 'Noto Sans JP', sans-serif;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .title-line {
    display: block;
    color: transparent;
    -webkit-text-stroke: 2px rgba(255, 255, 255, 0.9);
  }

  .page-subtitle {
    font-size: 18px;
    color: rgba(255, 255, 255, 0.7);
    margin: 0;
    font-weight: 300;
    letter-spacing: 0.05em;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .featured-albums {
    padding: 80px 0;
  }

  .section-title {
    font-size: 32px;
    font-weight: 700;
    margin: 0 0 40px;
    color: #fff;
    font-family: 'Noto Sans JP', sans-serif;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .albums-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 32px;
  }

  .album-card {
    background: linear-gradient(135deg, #111 0%, #000 100%);
    border-radius: 12px;
    overflow: hidden;
    transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    border: 1px solid rgba(201, 131, 0, 0.1);
  }

  .album-card:hover {
    transform: translateY(-8px);
    border-color: rgba(201, 131, 0, 0.3);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
  }

  .album-cover {
    position: relative;
    aspect-ratio: 1;
    overflow: hidden;
  }

  .album-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .album-card:hover .album-cover img {
    transform: scale(1.1);
  }

  .album-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: linear-gradient(135deg, rgba(201, 131, 0, 0.8) 0%, rgba(138, 3, 3, 0.8) 100%);
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .album-card:hover .album-overlay {
    opacity: 1;
  }

  .play-btn {
    background: rgba(255, 255, 255, 0.9);
    border: none;
    border-radius: 50%;
    width: 60px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
    color: #000;
  }

  .play-btn:hover {
    transform: scale(1.1);
    background: #fff;
  }

  .album-info {
    padding: 24px;
  }

  .album-title {
    font-size: 20px;
    font-weight: 700;
    margin: 0 0 8px;
    color: #fff;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .album-artist {
    color: var(--primary-color);
    font-size: 14px;
    margin: 0 0 4px;
    font-weight: 500;
  }

  .album-meta {
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    margin: 0;
  }

  .popular-tracks {
    padding: 80px 0;
    border-top: 1px solid rgba(201, 131, 0, 0.1);
  }

  .tracks-list {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .track-item {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px;
    background: linear-gradient(135deg, #111 0%, #000 100%);
    border-radius: 8px;
    transition: all 0.3s ease;
    border: 1px solid rgba(201, 131, 0, 0.1);
  }

  .track-item:hover {
    border-color: rgba(201, 131, 0, 0.3);
    transform: translateX(8px);
  }

  .track-number {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.5);
    font-weight: 600;
    width: 30px;
    text-align: center;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .track-cover {
    width: 50px;
    height: 50px;
    border-radius: 4px;
    overflow: hidden;
  }

  .track-cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .track-info {
    flex: 1;
    min-width: 0;
  }

  .track-title {
    font-size: 16px;
    font-weight: 600;
    margin: 0 0 4px;
    color: #fff;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .track-artist {
    color: var(--primary-color);
    font-size: 14px;
    margin: 0 0 2px;
    font-weight: 500;
  }

  .track-album {
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    margin: 0;
  }

  .track-stats {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-right: 16px;
  }

  .track-plays,
  .track-duration {
    color: rgba(255, 255, 255, 0.6);
    font-size: 14px;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .track-actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .action-btn {
    background: none;
    border: none;
    color: rgba(255, 255, 255, 0.6);
    cursor: pointer;
    padding: 8px;
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  .action-btn:hover {
    color: var(--primary-color);
    background: rgba(201, 131, 0, 0.1);
  }

  .play-track-btn {
    background: var(--primary-color);
    border: none;
    color: #000;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .play-track-btn:hover {
    transform: scale(1.1);
    background: #fff;
  }

  /* Floating Player */
  .floating-player {
    position: fixed;
    bottom: -100px;
    left: 0;
    right: 0;
    background: linear-gradient(135deg, #000 0%, #111 100%);
    border-top: 1px solid rgba(201, 131, 0, 0.3);
    padding: 16px 24px;
    z-index: 1000;
    transition: bottom 0.3s cubic-bezier(0.23, 1, 0.32, 1);
    backdrop-filter: blur(10px);
  }

  .floating-player.active {
    bottom: 0;
  }

  .player-content {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    gap: 24px;
  }

  .player-track {
    display: flex;
    align-items: center;
    gap: 16px;
    flex: 1;
  }

  .player-track img {
    width: 50px;
    height: 50px;
    border-radius: 4px;
    object-fit: cover;
  }

  .player-info h4 {
    margin: 0 0 4px;
    color: #fff;
    font-size: 14px;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .player-info p {
    margin: 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
  }

  .player-controls {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .player-btn {
    background: none;
    border: none;
    color: #fff;
    cursor: pointer;
    padding: 8px;
    border-radius: 4px;
    transition: all 0.3s ease;
  }

  .player-btn:hover {
    color: var(--primary-color);
    background: rgba(201, 131, 0, 0.1);
  }

  .play-pause {
    background: var(--primary-color);
    color: #000;
    border-radius: 50%;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .play-pause:hover {
    background: #fff;
    transform: scale(1.1);
  }

  .player-progress {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 2;
  }

  .progress-bar {
    flex: 1;
    height: 4px;
    background: rgba(255, 255, 255, 0.2);
    border-radius: 2px;
    overflow: hidden;
  }

  .progress-fill {
    height: 100%;
    background: var(--primary-color);
    width: 0%;
    transition: width 0.3s ease;
  }

  .player-progress span {
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    font-family: 'Noto Sans JP', sans-serif;
    min-width: 35px;
  }

  .close-player {
    margin-left: auto;
  }

  @media (max-width: 768px) {
    .albums-grid {
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 24px;
    }

    .track-item {
      flex-wrap: wrap;
      gap: 12px;
    }

    .track-actions {
      width: 100%;
      justify-content: flex-end;
    }

    .player-content {
      flex-direction: column;
      gap: 16px;
    }

    .player-progress {
      width: 100%;
    }

    .page-header {
      padding: 80px 0 60px;
    }
  }
</style>

<script>
  // Music player functionality
  let currentTrack = null;
  let isPlaying = false;
  let currentTrackIndex = 0;
  let tracks = [];

  document.addEventListener('DOMContentLoaded', () => {
    const playButtons = document.querySelectorAll('.play-track-btn, .play-btn');
    const floatingPlayer = document.getElementById('floating-player');
    const playPauseBtn = document.getElementById('play-pause-btn');
    const closePlayerBtn = document.getElementById('close-player');
    const prevBtn = document.getElementById('prev-btn');
    const nextBtn = document.getElementById('next-btn');

    // Initialize tracks data
    tracks = Array.from(document.querySelectorAll('.track-item')).map(item => ({
      title: item.querySelector('.track-title').textContent,
      artist: item.querySelector('.track-artist').textContent,
      cover: item.querySelector('.track-cover img').src,
      duration: item.querySelector('.track-duration').textContent
    }));

    // Play button functionality
    playButtons.forEach((btn, index) => {
      btn.addEventListener('click', () => {
        const trackItem = btn.closest('.track-item') || btn.closest('.album-card');
        if (trackItem) {
          const trackInfo = trackItem.querySelector('.track-info') || trackItem.querySelector('.album-info');
          const title = trackInfo.querySelector('.track-title, .album-title').textContent;
          const artist = trackInfo.querySelector('.track-artist, .album-artist').textContent;
          const cover = trackItem.querySelector('img').src;
          
          playTrack({ title, artist, cover }, index);
        }
      });
    });

    // Play/Pause functionality
    playPauseBtn.addEventListener('click', () => {
      if (currentTrack) {
        togglePlayPause();
      }
    });

    // Close player
    closePlayerBtn.addEventListener('click', () => {
      floatingPlayer.classList.remove('active');
      stopTrack();
    });

    // Previous/Next buttons
    prevBtn.addEventListener('click', () => {
      if (currentTrackIndex > 0) {
        playTrack(tracks[currentTrackIndex - 1], currentTrackIndex - 1);
      }
    });

    nextBtn.addEventListener('click', () => {
      if (currentTrackIndex < tracks.length - 1) {
        playTrack(tracks[currentTrackIndex + 1], currentTrackIndex + 1);
      }
    });

    function playTrack(track, index) {
      currentTrack = track;
      currentTrackIndex = index;
      isPlaying = true;

      // Update player UI
      document.getElementById('player-title').textContent = track.title;
      document.getElementById('player-artist').textContent = track.artist;
      document.getElementById('player-cover').src = track.cover;
      document.getElementById('total-time').textContent = track.duration;

      // Show floating player
      floatingPlayer.classList.add('active');

      // Update play/pause button
      updatePlayPauseButton();

      // Simulate progress
      simulateProgress();
    }

    function togglePlayPause() {
      isPlaying = !isPlaying;
      updatePlayPauseButton();
    }

    function stopTrack() {
      currentTrack = null;
      isPlaying = false;
      document.getElementById('progress-fill').style.width = '0%';
      document.getElementById('current-time').textContent = '0:00';
    }

    function updatePlayPauseButton() {
      const icon = playPauseBtn.querySelector('svg path');
      if (isPlaying) {
        icon.setAttribute('d', 'M6 4h4v16H6V4zm8 0h4v16h-4V4z'); // Pause icon
      } else {
        icon.setAttribute('d', 'M8 5v14l11-7z'); // Play icon
      }
    }

    function simulateProgress() {
      if (!currentTrack || !isPlaying) return;

      const progressFill = document.getElementById('progress-fill');
      const currentTimeEl = document.getElementById('current-time');
      let progress = 0;

      const interval = setInterval(() => {
        if (!isPlaying || !currentTrack) {
          clearInterval(interval);
          return;
        }

        progress += 1;
        progressFill.style.width = progress + '%';
        
        // Simulate time (for demo purposes)
        const totalSeconds = parseDuration(currentTrack.duration);
        const currentSeconds = Math.floor((progress / 100) * totalSeconds);
        currentTimeEl.textContent = formatTime(currentSeconds);

        if (progress >= 100) {
          clearInterval(interval);
          // Auto play next track
          if (currentTrackIndex < tracks.length - 1) {
            playTrack(tracks[currentTrackIndex + 1], currentTrackIndex + 1);
          } else {
            stopTrack();
          }
        }
      }, 1000);
    }

    function parseDuration(duration) {
      const [minutes, seconds] = duration.split(':').map(Number);
      return minutes * 60 + seconds;
    }

    function formatTime(seconds) {
      const mins = Math.floor(seconds / 60);
      const secs = seconds % 60;
      return `${mins}:${String(secs).padStart(2, '0')}`;
    }
  });
</script>