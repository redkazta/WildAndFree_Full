                              <div class="flex items-center gap-3">
                                  <span class="text-lg font-black text-gray-500 w-6">#{mc.rank}</span>
                                  <div>
                                      <h4 class="text-sm font-black text-white uppercase">{mc.name}</h4>
                                      <p class="text-[9px] text-gray-400 uppercase">{mc.lastBattle}</p>
                                  </div>
                              </div>
                              <div class="text-right">
                                  <span class="block text-lg font-black text-[var(--wild-orange)]">{mc.points}</span>
                                  <span class="text-[9px] text-gray-500 font-mono">PTS • {mc.record}</span>
                              </div>
                          </div>
                      ))}
                  </div>
              </div>

              <!-- Historial & Videos -->
              <div class="lg:col-span-8 space-y-8">
                  <!-- Videos -->
                  <div>
                      <h3 class="text-lg font-black uppercase mb-4 text-white">Últimas Batallas</h3>
                      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                          {ascensionData.videos.map(video => (
                              <div class="group relative aspect-video bg-black rounded-xl overflow-hidden cursor-pointer border border-white/10">
                                  <img src={video.thumbnail} class="w-full h-full object-cover opacity-60 group-hover:opacity-80 transition-opacity" />
                                  <div class="absolute inset-0 flex items-center justify-center">
                                      <div class="w-12 h-12 rounded-full bg-red-600/80 text-white flex items-center justify-center backdrop-blur group-hover:scale-110 transition-transform">
                                          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                                      </div>
                                  </div>
                                  <div class="absolute bottom-0 left-0 right-0 p-4 bg-gradient-to-t from-black to-transparent">
                                      <h4 class="text-sm font-black text-white uppercase truncate">{video.title}</h4>
                                      <p class="text-[10px] text-gray-400 font-mono uppercase">{video.views} Vistas</p>
                                  </div>
                              </div>
                          ))}
                      </div>
                  </div>

                  <!-- Rolas del Artista (Tracks Destacados) -->
                  <div>
                      <h3 class="text-lg font-black uppercase mb-4 text-white">Tracks Destacados</h3>
                      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                          {ascensionData.topTracks.map(track => (
                              <div class="flex items-center gap-3 p-3 bg-white/5 rounded-lg border border-white/5 hover:border-[var(--wild-orange)] transition-colors group cursor-pointer">
                                  <div class="w-8 h-8 bg-white/10 flex items-center justify-center rounded text-[var(--wild-orange)]">
                                      <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M9 18V5l12-2v13"/></svg>
                                  </div>
                                  <div>
                                      <h4 class="text-xs font-black text-white uppercase">{track.title}</h4>
                                      <p class="text-[9px] text-gray-400 uppercase">{track.artist}</p>
                                  </div>
                              </div>
                          ))}
                      </div>
                  </div>
              </div>
          </div>
      </section>

      <!-- 5. HONOR AND FREE (TABLA DE PUNTOS) -->
      <section>
          <div class="flex items-center gap-4 mb-8">
              <h2 class="text-3xl font-black uppercase tracking-tighter text-white">Honor & Free</h2>
              <div class="h-px bg-white/10 flex-1"></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
              {honorAndFreeData.map(mc => (
                  <div class="freestyler-card bg-[#0a0a0a] border border-white/10 rounded-xl overflow-hidden group hover:border-[var(--wild-orange)] transition-colors" data-freestyler={JSON.stringify(mc)}>
                      <div class="relative h-48 overflow-hidden cursor-pointer freestyler-trigger">
                          <img src={mc.image} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500 group-hover:scale-105" />
                          <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                          <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity z-10">
                              <span class="bg-black/80 text-[var(--wild-orange)] text-[10px] font-black uppercase px-3 py-1 rounded backdrop-blur border border-[var(--wild-orange)] transform translate-y-2 group-hover:translate-y-0 transition-transform">Ver Perfil</span>
                          </div>
                          <div class="absolute bottom-4 left-4 z-20 pointer-events-none">
                              <h3 class="text-2xl font-black text-white uppercase italic leading-none">{mc.name}</h3>
                              <span class="text-[10px] font-mono text-[var(--wild-orange)] bg-black/50 px-2 py-0.5 rounded backdrop-blur">MULT: {mc.multiplier}</span>
                          </div>
                      </div>
                      
                      <div class="p-4 bg-[#111]">
                          <div class="flex justify-between items-end mb-4">
                              <span class="text-[10px] text-gray-500 font-black uppercase tracking-widest">Puntos Totales</span>
                              <span class="text-3xl font-black text-white leading-none">{mc.points}</span>
                          </div>
                          
                          <details class="group/details">
                              <summary class="cursor-pointer text-[10px] font-black uppercase text-gray-400 hover:text-white flex items-center justify-between p-2 bg-black rounded select-none">
                                  <span>Ver Historial</span>
                                  <svg class="w-4 h-4 transition-transform group-open/details:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M6 9l6 6 6-6"/></svg>
                              </summary>
                              <div class="mt-2 pl-2 border-l border-white/10 space-y-1">
                                  {mc.history.map(entry => (
                                      <p class="text-[9px] font-mono text-gray-500 uppercase">{entry}</p>
                                  ))}
                              </div>
                          </details>
                      </div>
                  </div>
              ))}
          </div>
      </section>

    </div>

    <!-- MODAL DE FREESTYLER -->
    <dialog id="freestyler-modal" class="bg-transparent p-0 backdrop:bg-black/80 w-full max-w-2xl m-auto open:animate-fade-in-up">
        <div class="bg-[#111] border border-white/20 rounded-xl overflow-hidden shadow-2xl">
            <!-- Header con Imagen de fondo -->
            <div class="relative h-48">
                <img id="modal-image" src="" class="w-full h-full object-cover opacity-50" />
                <div class="absolute inset-0 bg-gradient-to-t from-[#111] via-transparent to-transparent"></div>
                <div class="absolute bottom-6 left-6">
                    <h2 id="modal-name" class="text-5xl font-black text-white uppercase italic tracking-tighter leading-none">NAME</h2>
                    <p id="modal-bio" class="text-sm text-gray-300 max-w-lg mt-2 font-medium"></p>
                </div>
                <button id="close-modal" class="absolute top-4 right-4 text-white hover:text-[var(--wild-orange)] bg-black/50 p-2 rounded-full backdrop-blur transition-colors">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>
                </button>
            </div>
            
            <!-- Contenido -->
            <div class="p-8">
                <h3 class="text-xl font-black uppercase text-[var(--wild-orange)] mb-4">Historial Completo de Torneo</h3>
                <div class="overflow-x-auto">
                    <table class="w-full text-left">
                        <thead>
                            <tr class="text-[10px] font-black uppercase text-gray-500 border-b border-white/10">
                                <th class="pb-2">Evento</th>
                                <th class="pb-2">Resultado</th>
                                <th class="pb-2 text-right">Puntos</th>
                            </tr>
                        </thead>
                        <tbody id="modal-history-body" class="divide-y divide-white/5">
                            <!-- JS populated -->
                        </tbody>
                    </table>
                </div>
                
                <div class="mt-8 flex gap-4">
                     <button class="flex-1 bg-[var(--wild-orange)] text-black font-black uppercase py-3 text-xs rounded hover:bg-white transition-colors">Ver Perfil Completo</button>
                     <button class="flex-1 border border-white/20 text-white font-black uppercase py-3 text-xs rounded hover:bg-white hover:text-black transition-colors">Seguir Freestyler</button>
                </div>
            </div>
        </div>
    </dialog>

    <!-- Floating Player Removed (Replaced by Global Spotify Player) -->
  </div>
</Layout>

<style is:global define:vars={{ streetAccent: tenant.primary_color }}>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  
  .scrollbar-hide::-webkit-scrollbar {
      display: none;
  }
  .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
  }
</style>

<script>
    const searchInput = document.getElementById('spotify-search') as HTMLInputElement;
    const searchResults = document.getElementById('search-results');
    let debounceTimer: any;

    searchInput?.addEventListener('input', (e) => {
        const query = (e.target as HTMLInputElement).value;
        
        clearTimeout(debounceTimer);
        
        if (query.length < 2) {
            searchResults?.classList.add('hidden');
            return;
        }

        debounceTimer = setTimeout(async () => {
            try {
                // Connect to Core Engine (Go)
                // Use PUBLIC_CORE_API_URL or fallback to localhost
                const API_URL = import.meta.env.PUBLIC_CORE_API_URL || 'http://localhost:8080';
                
                const res = await fetch(`${API_URL}/api/v1/spotify/search?q=${encodeURIComponent(query)}`);
                const data = await res.json();
                
                if (data.tracks && data.tracks.items.length > 0) {
                    renderResults(data.tracks.items);
                } else {
                    if (searchResults) {
                        searchResults.innerHTML = '<div class="p-4 text-center text-gray-500 text-xs font-bold uppercase">No se encontraron resultados</div>';
                        searchResults.classList.remove('hidden');
                    }
                }
            } catch (err) {
                console.error('Error searching:', err);
            }
        }, 500);
    });

    function renderResults(tracks: any[]) {
        if (!searchResults) return;
        
        const html = tracks.map(track => {
            const image = track.album.images[2]?.url || track.album.images[0]?.url;
            const artist = track.artists.map((a: any) => a.name).join(', ');
            return `
            <div class="flex items-center gap-4 p-3 hover:bg-white/10 cursor-pointer border-b border-white/5 last:border-0 transition-colors group" onclick="window.playSpotifyTrack('${track.id}')">
                <div class="w-10 h-10 rounded overflow-hidden relative">
                    <img src="${image}" class="w-full h-full object-cover" />
                    <div class="absolute inset-0 bg-black/50 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg>
                    </div>
                </div>
                <div class="flex-1 min-w-0">
                    <h4 class="text-xs font-black text-white uppercase truncate">${track.name}</h4>
                    <p class="text-[10px] text-gray-400 font-bold truncate">${artist}</p>
                </div>
            </div>
            `;
        }).join('');
        
        searchResults.innerHTML = html;
        searchResults.classList.remove('hidden');
    }

    (window as any).playSpotifyTrack = (id: string) => {
        window.dispatchEvent(new CustomEvent('play-spotify-track', { detail: { id } }));
        if (searchResults) searchResults.classList.add('hidden');
        if (searchInput) searchInput.value = '';
    };

    document.addEventListener('click', (e) => {
        if (searchInput && searchResults && !searchInput.contains(e.target as Node) && !searchResults.contains(e.target as Node)) {
            searchResults.classList.add('hidden');
        }
    });

  // Player Logic (Replaced by Global Spotify Player)
  const playBtns = document.querySelectorAll('.play-track-btn');
  
  if (playBtns) {
    playBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        // Play default track or random one since we don't have IDs for mock data
        // Ideally we would map mock titles to Spotify IDs
        (window as any).playSpotifyTrack('4cOdK2wGLETKBW3PvgPWqT'); 
      });
    });
  }

  // Freestyler Modal Logic
  const modal = document.getElementById('freestyler-modal') as HTMLDialogElement;
  const closeModalBtn = document.getElementById('close-modal');
  const triggers = document.querySelectorAll('.freestyler-trigger');

  if (modal && closeModalBtn) {
      triggers.forEach(trigger => {
          trigger.addEventListener('click', (e) => {
              e.stopPropagation(); // Prevent details/summary conflict if any
              const card = trigger.closest('.freestyler-card') as HTMLElement;
              const data = JSON.parse(card.dataset.freestyler || '{}');
              
              // Populate
              const nameEl = document.getElementById('modal-name');
              const bioEl = document.getElementById('modal-bio');
              const imgEl = document.getElementById('modal-image') as HTMLImageElement;
              const historyBody = document.getElementById('modal-history-body');
              
              if (nameEl) nameEl.textContent = data.name;
              if (bioEl) bioEl.textContent = data.bio || 'Sin biografía disponible.';
              if (imgEl) imgEl.src = data.image;
              
              if (historyBody && data.fullHistory) {
                  historyBody.innerHTML = data.fullHistory.map((h: any) => `
                      <tr class="text-xs hover:bg-white/5 transition-colors">
                          <td class="py-3 font-bold text-white uppercase">${h.event}</td>
                          <td class="py-3 text-gray-400 uppercase">${h.result}</td>
                          <td class="py-3 text-right font-mono text-[var(--wild-orange)]">${h.points} PTS</td>
                      </tr>
                  `).join('');
              } else if (historyBody) {
                  historyBody.innerHTML = '<tr><td colspan="3" class="py-4 text-center text-gray-500 text-xs">No hay historial disponible</td></tr>';
              }

              modal.showModal();
          });
      });

      closeModalBtn.addEventListener('click', () => {
          modal.close();
      });

      modal.addEventListener('click', (e) => {
          const rect = modal.getBoundingClientRect();
          // Check if click is outside
          const isOutside = (
              e.clientY < rect.top ||
              e.clientY > rect.bottom ||
              e.clientX < rect.left ||
              e.clientX > rect.right
          );
          if (isOutside) {
              modal.close();
          }
      });
  }
</script>