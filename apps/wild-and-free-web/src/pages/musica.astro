---

<Layout config={config}>
  <div class="min-h-screen bg-[#050505] text-white pb-32 selection:bg-[var(--wild-orange)] selection:text-black font-sans">
    
    <!-- Top Bar -->
    <div class="bg-black border-b border-white/10 py-2 sticky top-0 z-50">
        <div class="container mx-auto px-4 max-w-[1800px] flex justify-between items-center">
            <div class="flex items-center gap-2">
                <div class="w-2 h-2 bg-[var(--wild-orange)] rounded-full animate-pulse"></div>
                <span class="text-[10px] font-black uppercase tracking-[0.2em] text-white">Wild Music OS v3.2</span>
            </div>
            <div class="flex gap-4 text-[10px] font-mono text-gray-500">
                <span>ESTADO: CONECTADO</span>
                <span>ZONA: GLOBAL</span>
            </div>
        </div>
    </div>

    <!-- SEARCH BAR (STICKY) -->
    <div class="sticky top-[33px] z-40 bg-black/90 backdrop-blur-md border-b border-white/10 py-4 shadow-2xl">
        <div class="container mx-auto px-4 max-w-[1800px] flex flex-col md:flex-row gap-4 justify-between items-center">
            <div class="relative w-full max-w-xl group">
                <input 
                    type="text" 
                    id="spotify-search" 
                    placeholder="BUSCAR ARTISTA O CANCIÓN EN SPOTIFY..." 
                    class="w-full bg-[#111] border border-white/20 text-white text-xs font-black uppercase tracking-widest py-3 pl-10 pr-4 rounded-full focus:outline-none focus:border-[var(--wild-orange)] focus:ring-1 focus:ring-[var(--wild-orange)] transition-all placeholder:text-gray-600"
                />
                <svg class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-500 group-focus-within:text-[var(--wild-orange)] transition-colors" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line></svg>
                
                <!-- Search Results Dropdown -->
                <div id="search-results" class="absolute top-full left-0 right-0 mt-2 bg-[#0a0a0a] border border-white/10 rounded-xl shadow-2xl overflow-hidden hidden max-h-[60vh] overflow-y-auto z-50">
                    <!-- Results injected here -->
                </div>
            </div>

            <!-- Filtros Rápidos -->
            <div class="flex items-center gap-2 overflow-x-auto no-scrollbar">
                <button class="px-4 py-1.5 text-[10px] font-black uppercase rounded bg-white text-black border border-white hover:bg-white transition-colors whitespace-nowrap">Todo</button>
                <button class="px-4 py-1.5 text-[10px] font-black uppercase rounded text-gray-400 border border-white/20 hover:border-white hover:text-white transition-colors whitespace-nowrap">Hip Hop</button>
                <button class="px-4 py-1.5 text-[10px] font-black uppercase rounded text-gray-400 border border-white/20 hover:border-white hover:text-white transition-colors whitespace-nowrap">Trap</button>
                <button class="px-4 py-1.5 text-[10px] font-black uppercase rounded text-gray-400 border border-white/20 hover:border-white hover:text-white transition-colors whitespace-nowrap">Drill</button>
            </div>
        </div>
    </div>

    <!-- MAIN LAYOUT -->
    <div class="container mx-auto px-4 py-8 max-w-[1800px] animate-fade-in-up space-y-16">
      
      <!-- 1. AGREGADOS RECIENTEMENTE (Horizontal List) - AHORA ARRIBA -->
      <section>
          <div class="flex items-center gap-4 mb-6">
              <h3 class="text-xl font-black uppercase tracking-tighter text-white">Agregados Recientemente a tu Playlist</h3>
              <div class="h-px bg-white/10 flex-1"></div>
              <a href="#" class="text-[10px] font-black text-[var(--wild-orange)] uppercase hover:underline">Ver Historial</a>
          </div>

          <div class="flex gap-6 overflow-x-auto pb-4 scrollbar-hide">
              {recentlyAdded.map(artist => (
                  <div class="flex-shrink-0 flex items-center gap-3 bg-[#111] border border-white/10 pr-6 pl-2 py-2 rounded-full hover:border-[var(--wild-orange)] transition-colors cursor-pointer group min-w-[200px]">
                      <img src={artist.image} class="w-10 h-10 rounded-full object-cover border border-white/20 group-hover:border-[var(--wild-orange)]" />
                      <div>
                          <h4 class="text-xs font-black text-white uppercase leading-none mb-1">{artist.name}</h4>
                          <span class="text-[9px] font-mono text-gray-500 uppercase block">{artist.date}</span>
                      </div>
                  </div>
              ))}
          </div>
      </section>

      <!-- 2. SECCIÓN DESTACADOS: GRID 3 COLUMNAS -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          
          <!-- COL 1: ÁLBUM DE LA SEMANA -->
          <div class="relative group overflow-hidden rounded-xl border border-white/10 bg-[#0a0a0a] min-h-[400px]">
                <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20 mix-blend-overlay"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-transparent z-10"></div>
                <img src={featuredAlbum.cover} class="absolute inset-0 w-full h-full object-cover opacity-60 group-hover:opacity-80 transition-opacity duration-700" />
                
                <div class="absolute inset-0 p-6 z-20 flex flex-col justify-end items-start">
                    <span class="inline-block bg-[var(--wild-orange)] text-white text-[9px] font-black uppercase px-2 py-1 mb-2">Álbum de la Semana</span>
                    <h2 class="text-3xl font-black uppercase italic tracking-tighter leading-none mb-1 text-white drop-shadow-lg">{featuredAlbum.title}</h2>
                    <h3 class="text-lg text-gray-300 font-bold uppercase mb-4 tracking-widest">{featuredAlbum.artist}</h3>
                    
                    <button class="bg-white text-black px-4 py-2 text-[10px] font-black uppercase hover:bg-[var(--wild-orange)] hover:text-white transition-colors flex items-center gap-2">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg> Escuchar
                    </button>
                </div>
          </div>

          <!-- COL 2: ARTISTA DE LA SEMANA -->
          <div class="bg-[#0a0a0a] border border-white/10 rounded-xl p-6 flex flex-col">
              <div class="flex justify-between items-center mb-6 border-b border-white/10 pb-4">
                  <h3 class="text-lg font-black uppercase tracking-tighter text-white">Artistas Semana</h3>
                  <span class="text-[9px] font-mono text-[var(--wild-orange)] uppercase">Top 3</span>
              </div>
              
              <div class="flex-1 flex flex-col gap-3 justify-center">
                  {artistsOfTheWeek.map((artist, i) => (
                      <div class="group flex items-center gap-4 p-3 bg-white/5 hover:bg-white/10 rounded-lg transition-all cursor-pointer border border-transparent hover:border-[var(--wild-orange)]/30">
                          <span class="text-xl font-black text-white/20 font-mono w-6 text-center group-hover:text-[var(--wild-orange)] transition-colors">0{i+1}</span>
                          <img src={artist.image} class="w-10 h-10 rounded-full object-cover grayscale group-hover:grayscale-0 ring-1 ring-transparent group-hover:ring-[var(--wild-orange)] transition-all" />
                          <div class="flex-1 min-w-0">
                              <h4 class="text-sm font-black text-white uppercase leading-none mb-1 group-hover:text-[var(--wild-orange)] transition-colors truncate">{artist.name}</h4>
                              <p class="text-[9px] font-mono text-gray-500 uppercase tracking-wider truncate">{artist.role}</p>
                          </div>
                      </div>
                  ))}
              </div>
          </div>

          <!-- COL 3: TOP 5 LAGUNA (PEQUEÑO) -->
          <div class="bg-[#0a0a0a] border border-white/10 rounded-xl p-6 flex flex-col">
              <div class="flex justify-between items-center mb-6 border-b border-white/10 pb-4">
                  <h3 class="text-lg font-black uppercase tracking-tighter text-white">Top 5 Laguna</h3>
                  <span class="text-[9px] font-mono text-green-500 uppercase animate-pulse">● En Vivo</span>
              </div>
              
              <div class="flex-1 flex flex-col gap-2 overflow-y-auto">
                  {topCharts.map((track, i) => (
                      <div class="flex items-center gap-3 p-2 hover:bg-white/5 rounded transition-colors group cursor-pointer">
                          <div class="w-6 h-6 flex items-center justify-center bg-white/10 rounded text-[10px] font-black text-white group-hover:bg-[var(--wild-orange)] group-hover:text-black transition-colors">
                              {track.rank}
                          </div>
                          <div class="flex-1 min-w-0">
                              <h4 class="text-xs font-bold text-white uppercase truncate">{track.title}</h4>
                              <p class="text-[9px] text-gray-500 uppercase truncate">{track.artist}</p>
                          </div>
                          <span class={`text-[9px] font-black ${track.trend === 'up' ? 'text-green-500' : 'text-gray-600'}`}>
                              {track.trend === 'up' ? '▲' : '-'}
                          </span>
                      </div>
                  ))}
              </div>
          </div>
      </div>

      <!-- 3. CATÁLOGO MAESTRO (ANCHO COMPLETO) -->
      <div class="bg-[#0a0a0a] border border-white/10 rounded-xl overflow-hidden shadow-2xl">
         <div class="p-6 border-b border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 bg-gradient-to-r from-white/5 to-transparent">
             <div class="flex items-center gap-4">
                 <div class="p-2 bg-[var(--wild-orange)] rounded text-black">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="3"></circle></svg>
                 </div>
                 <div>
                    <h2 class="text-2xl font-black uppercase tracking-tight text-white leading-none">Catálogo Maestro</h2>
                    <span class="text-[10px] font-mono text-gray-400 uppercase tracking-widest">Base de Datos Completa /// {allTracks.length} Entradas</span>
                 </div>
             </div>
             <div class="flex gap-2 w-full md:w-auto">
                 <input type="text" placeholder="BUSCAR..." class="bg-black border border-white/20 text-white px-4 py-2 text-xs font-mono w-full md:w-64 focus:outline-none focus:border-[var(--wild-orange)] uppercase rounded" />
                 <button class="bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded border border-white/10 transition-colors">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                 </button>
             </div>
         </div>

         <!-- Header Tabla -->
         <div class="grid grid-cols-12 gap-4 px-6 py-3 bg-black text-[10px] font-bold text-gray-500 uppercase tracking-widest border-b border-white/5">
             <div class="col-span-1">#</div>
             <div class="col-span-5 md:col-span-4">Título / Artista</div>
             <div class="col-span-2 hidden md:block">Álbum</div>
             <div class="col-span-2 hidden md:block text-center">Datos</div>
             <div class="col-span-2 hidden md:block text-right">Duración</div>
             <div class="col-span-2 md:col-span-1 text-right"></div>
         </div>

         <!-- Filas -->
         <div class="divide-y divide-white/5 bg-[#080808]">
             {allTracks.map((track) => (
                 <div class="grid grid-cols-12 gap-4 px-6 py-3 items-center hover:bg-white/5 transition-colors group cursor-pointer text-xs">
                     <div class="col-span-1 font-mono text-gray-600 group-hover:text-[var(--wild-orange)]">{track.id.toString().padStart(3, '0')}</div>
                     
                     <div class="col-span-5 md:col-span-4 flex items-center gap-3">
                         <div class="w-10 h-10 bg-white/10 rounded overflow-hidden flex-shrink-0 relative">
                             <img src={track.cover} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all" />
                             <div class="absolute inset-0 bg-black/50 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg>
                             </div>
                         </div>
                         <div class="min-w-0">
                             <div class="font-bold text-white uppercase truncate group-hover:text-[var(--wild-orange)] transition-colors">{track.title}</div>
                             <div class="text-[10px] text-gray-500 truncate uppercase">{track.artist}</div>
                         </div>
                     </div>
                     
                     <div class="col-span-2 hidden md:block text-gray-400 text-[10px] uppercase truncate">{track.album}</div>
                     
                     <div class="col-span-2 hidden md:block text-center font-mono text-gray-600 text-[10px]">
                         <span class="bg-white/5 px-2 py-1 rounded border border-white/5">{track.bpm} BPM</span>
                     </div>
                     
                     <div class="col-span-2 hidden md:block text-right font-mono text-gray-500 text-[10px]">{track.duration}</div>
                     
                     <div class="col-span-2 md:col-span-1 flex justify-end">
