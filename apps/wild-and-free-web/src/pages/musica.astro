---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Música",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};

// Generar más datos de prueba para mostrar "muchas rolas"
const baseTracks = [
  {
    title: 'NOCHES DE NEÓN',
    artist: 'LIL KIRO',
    album: 'LUCES DE CIUDAD',
    duration: '3:24',
    cover: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=300&h=300&fit=crop&crop=face',
    plays: '2.1M'
  },
  {
    title: 'TOKYO DRIFT',
    artist: 'NEON GHOST',
    album: 'SESIONES DE MEDIANOCHE',
    duration: '4:12',
    cover: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=300&h=300&fit=crop&crop=face',
    plays: '1.8M'
  },
  {
    title: 'REINO DE SOMBRAS',
    artist: 'SHADOW V',
    album: 'MATERIA OSCURA',
    duration: '3:58',
    cover: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=300&h=300&fit=crop&crop=face',
    plays: '1.5M'
  },
  {
    title: 'CRISTALINO',
    artist: 'CRYSTAL WAVE',
    album: 'ONDAS',
    duration: '3:33',
    cover: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=300&h=300&fit=crop&crop=face',
    plays: '890K'
  },
  {
    title: 'PASEO DE MEDIANOCHE',
    artist: 'MIDNIGHT RIDER',
    album: 'JINETE NOCTURNO',
    duration: '4:01',
    cover: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=300&h=300&fit=crop&crop=face',
    plays: '2.7M'
  },
  {
    title: 'FUEGO FATUO',
    artist: 'LIL KIRO',
    album: 'LUCES DE CIUDAD',
    duration: '2:55',
    cover: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300&h=300&fit=crop&crop=face',
    plays: '3.2M'
  },
  {
    title: 'VAPORWAVE DREAMS',
    artist: 'NEON GHOST',
    album: 'SESIONES DE MEDIANOCHE',
    duration: '3:45',
    cover: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=300&h=300&fit=crop&crop=face',
    plays: '1.1M'
  },
  {
    title: 'URBAN JUNGLE',
    artist: 'WILD SQUAD',
    album: 'MIXTAPE VOL.1',
    duration: '3:10',
    cover: 'https://images.unsplash.com/photo-1531384441138-2736e62e0919?w=300&h=300&fit=crop&crop=face',
    plays: '950K'
  },
  {
    title: 'GRAFFITI SOUL',
    artist: 'STREET ARTIST',
    album: 'WALLS',
    duration: '4:20',
    cover: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=300&h=300&fit=crop&crop=face',
    plays: '1.4M'
  },
  {
    title: 'CONCRETO Y ACERO',
    artist: 'HEAVY HITTERS',
    album: 'CONSTRUCCIÓN',
    duration: '3:50',
    cover: 'https://images.unsplash.com/photo-1529626455594-4ff0802cfb7e?w=300&h=300&fit=crop&crop=face',
    plays: '2.0M'
  }
];

// Duplicar para tener una lista larga
const tracks = [
  ...baseTracks.map((t, i) => ({ ...t, id: i + 1 })),
  ...baseTracks.map((t, i) => ({ ...t, id: i + 11, title: t.title + ' (REMIX)', duration: '4:30' })),
  ...baseTracks.map((t, i) => ({ ...t, id: i + 21, title: t.title + ' (INSTRUMENTAL)', duration: '3:15' }))
];

---

<Layout config={config}>
  <div class="min-h-screen bg-[#050505] pb-32 px-4 md:px-6 relative overflow-hidden">
    <!-- Background Noise Pattern -->
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 20px 20px;"></div>

    <div class="max-w-[1400px] mx-auto space-y-12 relative z-10 animate-fade-in-up">
      
      <!-- Header Brutalista con Marquee -->
      <div class="border-b-4 border-white pb-8 mt-8">
        <div class="flex flex-col md:flex-row items-end gap-6 mb-8">
          <h1 class="text-7xl md:text-9xl font-black tracking-tighter text-white uppercase leading-none hover:text-[var(--street-accent)] transition-colors duration-500" style="text-shadow: 4px 4px 0px var(--street-accent);">
            SONIDOS
          </h1>
          <div class="flex flex-col mb-2">
             <span class="text-xl font-bold text-black bg-[var(--street-accent)] px-2 inline-block w-fit">WILD RECORDS</span>
             <span class="text-sm font-mono text-[#888] tracking-widest mt-1">CATÁLOGO COMPLETO</span>
          </div>
        </div>
        
        <!-- Marquee -->
        <div class="relative overflow-hidden bg-white py-2 border-y-2 border-black">
          <div class="whitespace-nowrap animate-marquee inline-block">
            <span class="text-black font-mono font-bold text-lg mx-4">NOW PLAYING: NOCHES DE NEÓN - LIL KIRO</span>
            <span class="text-[var(--street-accent)] font-black mx-2">///</span>
            <span class="text-black font-mono font-bold text-lg mx-4">NEW RELEASE: SESIONES DE MEDIANOCHE</span>
            <span class="text-[var(--street-accent)] font-black mx-2">///</span>
            <span class="text-black font-mono font-bold text-lg mx-4">TOP CHARTS: WILD GVNG GLOBAL</span>
            <span class="text-[var(--street-accent)] font-black mx-2">///</span>
             <span class="text-black font-mono font-bold text-lg mx-4">NOW PLAYING: NOCHES DE NEÓN - LIL KIRO</span>
            <span class="text-[var(--street-accent)] font-black mx-2">///</span>
            <span class="text-black font-mono font-bold text-lg mx-4">NEW RELEASE: SESIONES DE MEDIANOCHE</span>
            <span class="text-[var(--street-accent)] font-black mx-2">///</span>
            <span class="text-black font-mono font-bold text-lg mx-4">TOP CHARTS: WILD GVNG GLOBAL</span>
            <span class="text-[var(--street-accent)] font-black mx-2">///</span>
          </div>
        </div>
      </div>

      <!-- Lista de Tracks Compacta y Densa -->
      <section>
        <div class="flex items-center justify-between mb-8">
          <div class="flex items-center gap-4">
            <div class="w-10 h-10 bg-[var(--street-accent)] text-black flex items-center justify-center font-black text-xl border border-black shadow-[4px_4px_0px_white]">ALL</div>
            <h2 class="text-2xl md:text-4xl font-black uppercase tracking-tighter text-white">Todas las Rolas ({tracks.length})</h2>
          </div>
          
          <!-- Filtros simples (visuales por ahora) -->
          <div class="hidden md:flex gap-2">
            <button class="px-4 py-1 bg-white text-black font-mono text-sm font-bold border border-black hover:bg-[var(--street-accent)] transition-colors">POPULAR</button>
            <button class="px-4 py-1 bg-black text-white font-mono text-sm font-bold border border-white hover:bg-white hover:text-black transition-colors">NUEVO</button>
          </div>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
          {tracks.map((track, index) => (
            <div class="group relative flex items-center gap-4 bg-[#111] border border-white/10 p-3 hover:bg-[#1a1a1a] hover:border-[var(--street-accent)] transition-all duration-300 hover:-translate-y-1">
              
              <!-- Cover Tiny -->
              <div class="relative w-16 h-16 flex-shrink-0 border border-white/20 group-hover:border-[var(--street-accent)] transition-colors overflow-hidden">
                <img src={track.cover} alt={track.title} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" />
                
                <!-- Play Overlay on Cover -->
                <button 
                  class="play-track-btn absolute inset-0 flex items-center justify-center bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity cursor-pointer"
                  data-title={track.title}
                  data-artist={track.artist}
                  data-cover={track.cover}
                  data-duration={track.duration}
                >
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg>
                </button>
              </div>

              <!-- Info -->
              <div class="flex-1 min-w-0">
                <div class="flex items-baseline justify-between">
                    <h4 class="text-base font-bold text-white uppercase truncate group-hover:text-[var(--street-accent)] transition-colors pr-2">{track.title}</h4>
                    <span class="text-xs font-mono text-gray-500 group-hover:text-white transition-colors">{track.duration}</span>
                </div>
                <p class="text-xs font-mono text-gray-400 truncate">{track.artist}</p>
                <p class="text-[10px] font-mono text-gray-600 mt-1 uppercase tracking-wider">{track.album}</p>
              </div>

              <!-- Play Count (Desktop only) -->
              <div class="hidden xl:block text-xs font-mono text-gray-600 text-right min-w-[60px]">
                 <div class="flex items-center justify-end gap-1">
                    <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                    {track.plays}
                 </div>
              </div>
              
            </div>
          ))}
        </div>
      </section>

    </div>

    <!-- Floating Player (Walkman Style) -->
    <div id="floating-player" class="fixed bottom-8 right-8 z-50 translate-y-[150%] transition-transform duration-500">
      <div class="bg-[#1a1a1a] border-2 border-white p-4 w-[320px] shadow-[8px_8px_0px_var(--street-accent)]">
        <!-- Player Screen -->
        <div class="bg-[#9ea792] border-2 border-black/20 p-3 mb-4 font-mono text-black relative overflow-hidden shadow-inner">
           <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 2px, #000 3px);"></div>
           <div class="relative z-10">
              <p class="text-xs font-bold mb-1">NOW PLAYING ▶</p>
              <h4 id="player-title" class="text-lg font-black truncate leading-none">SELECCIONA TRACK</h4>
              <p id="player-artist" class="text-xs truncate mt-1">WILD GVNG</p>
              <div class="flex justify-between mt-2 text-xs font-bold">
                 <span id="current-time">0:00</span>
                 <span id="total-time">0:00</span>
              </div>
           </div>
        </div>

        <!-- Controls -->
        <div class="flex justify-between items-center gap-2">
           <button id="prev-btn" class="flex-1 bg-[#333] hover:bg-[#444] text-white p-2 border border-black shadow-[2px_2px_0px_black] active:translate-y-[2px] active:shadow-none transition-all">
              <svg class="w-4 h-4 mx-auto" fill="currentColor" viewBox="0 0 24 24"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
           </button>
           <button id="play-pause-btn" class="flex-[2] bg-[var(--street-accent)] hover:bg-white text-black p-3 border border-black shadow-[2px_2px_0px_black] active:translate-y-[2px] active:shadow-none transition-all">
              <svg id="play-icon" class="w-6 h-6 mx-auto" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <svg id="pause-icon" class="w-6 h-6 mx-auto hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
           </button>
           <button id="next-btn" class="flex-1 bg-[#333] hover:bg-[#444] text-white p-2 border border-black shadow-[2px_2px_0px_black] active:translate-y-[2px] active:shadow-none transition-all">
              <svg class="w-4 h-4 mx-auto" fill="currentColor" viewBox="0 0 24 24"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
           </button>
        </div>
        
        <!-- Progress Bar -->
        <div class="mt-4 h-2 bg-[#000] border border-white/20 rounded-full overflow-hidden">
           <div id="progress-fill" class="h-full bg-[var(--street-accent)] w-0 transition-all duration-100"></div>
        </div>
        
        <button id="close-player" class="absolute -top-4 -right-4 bg-red-500 text-white w-8 h-8 flex items-center justify-center border-2 border-white shadow-lg hover:scale-110 transition-transform cursor-pointer">
           <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 1l12 12M13 1L1 13"/></svg>
        </button>
      </div>
    </div>
  </div>
</Layout>

<style define:vars={{ streetAccent: tenant.primary_color }}>
  :root {
    --street-accent: var(--streetAccent);
  }
  
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }

  .animate-marquee {
    animation: marquee 20s linear infinite;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
</style>

<script>
  // Player Logic
  const player = document.getElementById('floating-player');
  const playBtns = document.querySelectorAll('.play-track-btn');
  const closeBtn = document.getElementById('close-player');
  const playPauseBtn = document.getElementById('play-pause-btn');
  const playIcon = document.getElementById('play-icon');
  const pauseIcon = document.getElementById('pause-icon');
  const progressFill = document.getElementById('progress-fill');
  
  // Elementos de texto
  const titleEl = document.getElementById('player-title');
  const artistEl = document.getElementById('player-artist');
  const totalTimeEl = document.getElementById('total-time');
  const currentTimeEl = document.getElementById('current-time');
  
  let isPlaying = false;
  let progress = 0;
  let interval: number | undefined;

  if (player && closeBtn && playPauseBtn && playIcon && pauseIcon && progressFill && titleEl && artistEl && totalTimeEl && currentTimeEl) {
    
    playBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        e.stopPropagation(); // Stop bubbling to prevent other clicks if any
        
        const title = btn.getAttribute('data-title') || 'Unknown Track';
        const artist = btn.getAttribute('data-artist') || 'Unknown Artist';
        const duration = btn.getAttribute('data-duration') || '3:00';
        
        // Update Player Info
        titleEl.textContent = title;
        artistEl.textContent = artist;
        totalTimeEl.textContent = duration;
        
        // Show Player
        player.style.transform = 'translateY(0)';
        
        // Auto Play
        isPlaying = true;
        updatePlayButton();
        startProgress();
      });
    });

    closeBtn.addEventListener('click', () => {
      player.style.transform = 'translateY(150%)';
      isPlaying = false;
      updatePlayButton();
      clearInterval(interval);
    });

    playPauseBtn.addEventListener('click', () => {
      isPlaying = !isPlaying;
      updatePlayButton();
      if (isPlaying) startProgress();
      else clearInterval(interval);
    });

    function updatePlayButton() {
      if (!playIcon || !pauseIcon) return;
      
      if (isPlaying) {
        playIcon.classList.add('hidden');
        pauseIcon.classList.remove('hidden');
      } else {
        playIcon.classList.remove('hidden');
        pauseIcon.classList.add('hidden');
      }
    }

    function startProgress() {
      clearInterval(interval);
      interval = window.setInterval(() => {
        if (!progressFill || !currentTimeEl) return;
        
        progress += 1;
        if (progress > 100) progress = 0;
        progressFill.style.width = `${progress}%`;
        
        // Simple time update simulation
        const totalSeconds = 180; // 3 mins approx
        const currentSeconds = Math.floor((progress / 100) * totalSeconds);
        const mins = Math.floor(currentSeconds / 60);
        const secs = currentSeconds % 60;
        currentTimeEl.textContent = `${mins}:${secs.toString().padStart(2, '0')}`;
      }, 1000);
    }
  }
</script>
