---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Música",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};

// --- DATA MOCK (TODO EN ESPAÑOL) ---

const featuredAlbum = {
  title: "CRÓNICAS DEL ASFALTO",
  artist: "LIL KIRO x NEON GHOST",
  year: "2026",
  cover: "https://images.unsplash.com/photo-1614613535308-eb5fbd3d2c17?w=800&h=800&fit=crop",
  description: "Un viaje sonoro por las calles de la metrópolis.",
  tracks: [
    { title: "INTRO: LUCES", duration: "1:45" },
    { title: "VELOCIDAD LUZ", duration: "3:12" },
    { title: "DISTRITO 9", duration: "2:58" }
  ]
};

const artistsOfTheWeek = [
    { name: "LIL KIRO", role: "TRAP KING", image: "https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=300&h=300&fit=crop" },
    { name: "NEON GHOST", role: "DRILL MASTER", image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=300&h=300&fit=crop" },
    { name: "NOVA K", role: "R&B QUEEN", image: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300&h=300&fit=crop" }
];

const topCharts = [
  { rank: "01", title: "NOCHES DE NEÓN", artist: "LIL KIRO", plays: "2.1M", trend: "up", cover: "https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=100&h=100&fit=crop" },
  { rank: "02", title: "TOKYO DRIFT", artist: "NEON GHOST", plays: "1.8M", trend: "same", cover: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=100&h=100&fit=crop" },
  { rank: "03", title: "FUEGO FATUO", artist: "LIL KIRO", plays: "1.5M", trend: "up", cover: "https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=100&h=100&fit=crop" },
  { rank: "04", title: "SUEÑOS VAPOR", artist: "NEON GHOST", plays: "1.1M", trend: "down", cover: "https://images.unsplash.com/photo-1517841905240-472988babdf9?w=100&h=100&fit=crop" },
  { rank: "05", title: "JUNGLA URBANA", artist: "WILD SQUAD", plays: "950K", trend: "up", cover: "https://images.unsplash.com/photo-1531384441138-2736e62e0919?w=100&h=100&fit=crop" }
];

const recentlyAdded = [
    { name: "SHADOW V", date: "Hace 2h", image: "https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=100&h=100&fit=crop" },
    { name: "CRYSTAL WAVE", date: "Hace 5h", image: "https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=100&h=100&fit=crop" },
    { name: "MIDNIGHT RIDER", date: "Ayer", image: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=100&h=100&fit=crop" },
    { name: "STORM TROOPER", date: "Ayer", image: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=100&h=100&fit=crop" },
    { name: "VIPER X", date: "Hace 2d", image: "https://images.unsplash.com/photo-1615109398623-88346a601842?w=100&h=100&fit=crop" },
    { name: "LUNA NEGRA", date: "Hace 3d", image: "https://images.unsplash.com/photo-1517423568366-69755581d826?w=100&h=100&fit=crop" }
];

const allTracks = [
  { id: 1, title: 'NOCHES DE NEÓN', artist: 'LIL KIRO', album: 'LUCES DE CIUDAD', duration: '3:24', bpm: 128, key: 'Am', cover: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=300&h=300&fit=crop' },
  { id: 2, title: 'TOKYO DRIFT', artist: 'NEON GHOST', album: 'SESIONES DE MEDIANOCHE', duration: '4:12', bpm: 140, key: 'F#', cover: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=300&h=300&fit=crop' },
  { id: 3, title: 'REINO DE SOMBRAS', artist: 'SHADOW V', album: 'MATERIA OSCURA', duration: '3:58', bpm: 95, key: 'Cm', cover: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=300&h=300&fit=crop' },
  { id: 4, title: 'CRISTALINO', artist: 'CRYSTAL WAVE', album: 'ONDAS', duration: '3:33', bpm: 110, key: 'G', cover: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=300&h=300&fit=crop' },
  { id: 5, title: 'PASEO DE MEDIANOCHE', artist: 'MIDNIGHT RIDER', album: 'JINETE NOCTURNO', duration: '4:01', bpm: 124, key: 'Dm', cover: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=300&h=300&fit=crop' },
  { id: 6, title: 'FUEGO FATUO', artist: 'LIL KIRO', album: 'LUCES DE CIUDAD', duration: '2:55', bpm: 130, key: 'Em', cover: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=300&h=300&fit=crop' },
  { id: 7, title: 'SUEÑOS VAPOR', artist: 'NEON GHOST', album: 'SESIONES DE MEDIANOCHE', duration: '3:45', bpm: 100, key: 'Bm', cover: 'https://images.unsplash.com/photo-1517841905240-472988babdf9?w=300&h=300&fit=crop' },
  { id: 8, title: 'JUNGLA URBANA', artist: 'WILD SQUAD', album: 'MIXTAPE VOL.1', duration: '3:10', bpm: 145, key: 'Am', cover: 'https://images.unsplash.com/photo-1531384441138-2736e62e0919?w=300&h=300&fit=crop' },
  { id: 9, title: 'ALMA DE GRAFFITI', artist: 'STREET ARTIST', album: 'MUROS', duration: '4:20', bpm: 90, key: 'C#m', cover: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=300&h=300&fit=crop' },
  { id: 10, title: 'CONCRETO Y ACERO', artist: 'HEAVY HITTERS', album: 'CONSTRUCCIÓN', duration: '3:50', bpm: 135, key: 'Fm', cover: 'https://images.unsplash.com/photo-1529626455594-4ff0802cfb7e?w=300&h=300&fit=crop' }
];

---

<Layout config={config}>
  <div class="min-h-screen bg-[#050505] text-white pb-32 selection:bg-[var(--wild-orange)] selection:text-black font-sans">
    
    <!-- Top Bar -->
    <div class="bg-black border-b border-white/10 py-2 sticky top-0 z-40 backdrop-blur-md bg-black/80">
        <div class="container mx-auto px-4 max-w-[1800px] flex justify-between items-center">
            <div class="flex items-center gap-2">
                <div class="w-2 h-2 bg-[var(--wild-orange)] rounded-full animate-pulse"></div>
                <span class="text-[10px] font-black uppercase tracking-[0.2em] text-white">Wild Music OS v3.1</span>
            </div>
            <div class="flex gap-4 text-[10px] font-mono text-gray-500">
                <span>ESTADO: CONECTADO</span>
                <span>ZONA: GLOBAL</span>
            </div>
        </div>
    </div>

    <!-- MAIN LAYOUT -->
    <div class="container mx-auto px-4 py-8 max-w-[1800px] animate-fade-in-up space-y-12">
      
      <!-- SECCIÓN SUPERIOR: HERO + ARTISTAS SEMANA -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8">
          
          <!-- 1. ÁLBUM DE LA SEMANA (Izquierda, más estrecho) -->
          <div class="lg:col-span-7 relative group overflow-hidden rounded-xl border border-white/10 bg-[#0a0a0a] min-h-[400px]">
                <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20 mix-blend-overlay"></div>
                <div class="absolute inset-0 bg-gradient-to-r from-black via-black/80 to-transparent z-10"></div>
                
                <img src={featuredAlbum.cover} class="absolute top-0 right-0 w-3/4 h-full object-cover opacity-60 group-hover:opacity-80 transition-opacity duration-700 mask-image-gradient" style="-webkit-mask-image: linear-gradient(to right, transparent, black);" />
                
                <div class="absolute inset-0 p-8 z-20 flex flex-col justify-center items-start">
                    <span class="inline-block bg-[var(--wild-orange)] text-white text-[10px] font-black uppercase px-2 py-1 mb-4">Álbum de la Semana</span>
                    <h2 class="text-5xl md:text-7xl font-black uppercase italic tracking-tighter leading-[0.8] mb-2 text-white drop-shadow-lg">{featuredAlbum.title}</h2>
                    <h3 class="text-2xl text-gray-300 font-bold uppercase mb-6 tracking-widest">{featuredAlbum.artist}</h3>
                    <p class="text-gray-400 max-w-md text-sm mb-8 font-medium border-l-2 border-[var(--wild-orange)] pl-4">
                        {featuredAlbum.description}
                    </p>
                    
                    <div class="flex gap-4">
                        <button class="bg-white text-black px-6 py-3 text-xs font-black uppercase hover:bg-[var(--wild-orange)] hover:text-white transition-colors flex items-center gap-2 shadow-[4px_4px_0px_rgba(255,255,255,0.2)] hover:shadow-none hover:translate-x-[2px] hover:translate-y-[2px]">
                            <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg> Escuchar Ahora
                        </button>
                        <button class="border border-white/30 text-white px-6 py-3 text-xs font-black uppercase hover:bg-white hover:text-black transition-colors">
                            + Mi Biblioteca
                        </button>
                    </div>
                </div>
          </div>

          <!-- 2. ARTISTAS DE LA SEMANA (Derecha) -->
          <div class="lg:col-span-5 bg-[#0a0a0a] border border-white/10 rounded-xl p-6 flex flex-col">
              <div class="flex justify-between items-center mb-6 border-b border-white/10 pb-4">
                  <h3 class="text-xl font-black uppercase tracking-tighter text-white">Artistas de la Semana</h3>
                  <span class="text-[10px] font-mono text-[var(--wild-orange)] uppercase">Selección Oficial</span>
              </div>
              
              <div class="flex-1 flex flex-col gap-4 justify-center">
                  {artistsOfTheWeek.map((artist, i) => (
                      <div class="group flex items-center gap-4 p-3 bg-white/5 hover:bg-white/10 rounded-lg transition-all cursor-pointer border border-transparent hover:border-[var(--wild-orange)]/30">
                          <span class="text-2xl font-black text-white/20 font-mono w-8 text-center group-hover:text-[var(--wild-orange)] transition-colors">0{i+1}</span>
                          <img src={artist.image} class="w-12 h-12 rounded-full object-cover grayscale group-hover:grayscale-0 ring-2 ring-transparent group-hover:ring-[var(--wild-orange)] transition-all" />
                          <div class="flex-1">
                              <h4 class="text-base font-black text-white uppercase leading-none mb-1 group-hover:text-[var(--wild-orange)] transition-colors">{artist.name}</h4>
                              <p class="text-[10px] font-mono text-gray-500 uppercase tracking-wider">{artist.role}</p>
                          </div>
                          <button class="w-8 h-8 rounded-full bg-black text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
                          </button>
                      </div>
                  ))}
              </div>
          </div>
      </div>

      <!-- SECCIÓN MEDIA: TOP 5 HORIZONTAL (Con Portadas) -->
      <section>
          <div class="flex items-center gap-4 mb-6">
              <h3 class="text-2xl font-black uppercase tracking-tighter text-white">Top 5 Global</h3>
              <div class="h-px bg-white/10 flex-1"></div>
          </div>
          
          <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4">
              {topCharts.map((track, i) => (
                  <div class="group relative bg-[#111] border border-white/10 rounded-xl overflow-hidden hover:-translate-y-2 transition-transform duration-300">
                      <!-- Rank Badge -->
                      <div class="absolute top-2 left-2 z-20 w-8 h-8 bg-black/80 backdrop-blur flex items-center justify-center rounded font-black text-white border border-white/20 group-hover:border-[var(--wild-orange)] group-hover:text-[var(--wild-orange)]">
                          {track.rank}
                      </div>
                      
                      <!-- Image -->
                      <div class="aspect-square overflow-hidden relative">
                          <img src={track.cover} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" />
                          <div class="absolute inset-0 bg-black/40 group-hover:bg-transparent transition-colors"></div>
                          
                          <!-- Play Button Overlay -->
                          <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                              <button class="w-12 h-12 bg-[var(--wild-orange)] text-white rounded-full flex items-center justify-center shadow-lg transform scale-90 group-hover:scale-100 transition-transform">
                                  <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                              </button>
                          </div>
                      </div>

                      <!-- Info -->
                      <div class="p-4">
                          <h4 class="text-sm font-black text-white uppercase truncate mb-1">{track.title}</h4>
                          <p class="text-[10px] font-mono text-gray-500 uppercase truncate">{track.artist}</p>
                          <div class="mt-2 flex justify-between items-center border-t border-white/10 pt-2">
                              <span class="text-[10px] font-mono text-gray-400">{track.plays}</span>
                              <span class={`text-[10px] font-black ${track.trend === 'up' ? 'text-green-500' : 'text-gray-600'}`}>
                                  {track.trend === 'up' ? '▲' : '-'}
                              </span>
                          </div>
                      </div>
                  </div>
              ))}
          </div>
      </section>

      <!-- SECCIÓN CATÁLOGO (ANCHO COMPLETO - MITAD DE PÁGINA) -->
      <div class="bg-[#0a0a0a] border border-white/10 rounded-xl overflow-hidden shadow-2xl">
         <div class="p-6 border-b border-white/10 flex flex-col md:flex-row justify-between items-center gap-4 bg-gradient-to-r from-white/5 to-transparent">
             <div class="flex items-center gap-4">
                 <div class="p-2 bg-[var(--wild-orange)] rounded text-black">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"></circle><circle cx="12" cy="12" r="3"></circle></svg>
                 </div>
                 <div>
                    <h2 class="text-2xl font-black uppercase tracking-tight text-white leading-none">Catálogo Maestro</h2>
                    <span class="text-[10px] font-mono text-gray-400 uppercase tracking-widest">Base de Datos Completa /// {allTracks.length} Entradas</span>
                 </div>
             </div>
             <div class="flex gap-2 w-full md:w-auto">
                 <input type="text" placeholder="BUSCAR..." class="bg-black border border-white/20 text-white px-4 py-2 text-xs font-mono w-full md:w-64 focus:outline-none focus:border-[var(--wild-orange)] uppercase rounded" />
                 <button class="bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded border border-white/10 transition-colors">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="8" y1="6" x2="21" y2="6"></line><line x1="8" y1="12" x2="21" y2="12"></line><line x1="8" y1="18" x2="21" y2="18"></line><line x1="3" y1="6" x2="3.01" y2="6"></line><line x1="3" y1="12" x2="3.01" y2="12"></line><line x1="3" y1="18" x2="3.01" y2="18"></line></svg>
                 </button>
             </div>
         </div>

         <!-- Header Tabla -->
         <div class="grid grid-cols-12 gap-4 px-6 py-3 bg-black text-[10px] font-bold text-gray-500 uppercase tracking-widest border-b border-white/5">
             <div class="col-span-1">#</div>
             <div class="col-span-5 md:col-span-4">Título / Artista</div>
             <div class="col-span-2 hidden md:block">Álbum</div>
             <div class="col-span-2 hidden md:block text-center">Datos</div>
             <div class="col-span-2 hidden md:block text-right">Duración</div>
             <div class="col-span-2 md:col-span-1 text-right"></div>
         </div>

         <!-- Filas -->
         <div class="divide-y divide-white/5 bg-[#080808]">
             {allTracks.map((track) => (
                 <div class="grid grid-cols-12 gap-4 px-6 py-3 items-center hover:bg-white/5 transition-colors group cursor-pointer text-xs">
                     <div class="col-span-1 font-mono text-gray-600 group-hover:text-[var(--wild-orange)]">{track.id.toString().padStart(3, '0')}</div>
                     
                     <div class="col-span-5 md:col-span-4 flex items-center gap-3">
                         <div class="w-10 h-10 bg-white/10 rounded overflow-hidden flex-shrink-0 relative">
                             <img src={track.cover} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all" />
                             <div class="absolute inset-0 bg-black/50 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity">
                                <svg width="12" height="12" viewBox="0 0 24 24" fill="white"><path d="M8 5v14l11-7z"/></svg>
                             </div>
                         </div>
                         <div class="min-w-0">
                             <div class="font-bold text-white uppercase truncate group-hover:text-[var(--wild-orange)] transition-colors">{track.title}</div>
                             <div class="text-[10px] text-gray-500 truncate uppercase">{track.artist}</div>
                         </div>
                     </div>
                     
                     <div class="col-span-2 hidden md:block text-gray-400 text-[10px] uppercase truncate">{track.album}</div>
                     
                     <div class="col-span-2 hidden md:block text-center font-mono text-gray-600 text-[10px]">
                         <span class="bg-white/5 px-2 py-1 rounded border border-white/5">{track.bpm} BPM</span>
                     </div>
                     
                     <div class="col-span-2 hidden md:block text-right font-mono text-gray-500 text-[10px]">{track.duration}</div>
                     
                     <div class="col-span-2 md:col-span-1 flex justify-end">
                         <button 
                             class="play-track-btn w-8 h-8 hover:bg-[var(--wild-orange)] text-gray-400 hover:text-white rounded-full flex items-center justify-center transition-colors"
                             data-title={track.title}
                             data-artist={track.artist}
                             data-cover={track.cover}
                             data-duration={track.duration}
                         >
                             <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                         </button>
                     </div>
                 </div>
             ))}
         </div>
         
         <div class="p-3 bg-black/50 border-t border-white/5 text-center">
             <button class="text-[10px] font-bold uppercase text-gray-500 hover:text-white transition-colors">Cargar Más Entradas</button>
         </div>
      </div>

      <!-- SECCIÓN: AGREGADOS RECIENTEMENTE (Horizontal List) -->
      <section class="pb-12">
          <div class="flex items-center gap-4 mb-6">
              <h3 class="text-xl font-black uppercase tracking-tighter text-white">Agregados Recientemente a tu Playlist</h3>
              <div class="h-px bg-white/10 flex-1"></div>
          </div>

          <div class="flex gap-6 overflow-x-auto pb-4 scrollbar-hide">
              {recentlyAdded.map(artist => (
                  <div class="flex-shrink-0 flex items-center gap-3 bg-[#111] border border-white/10 pr-6 pl-2 py-2 rounded-full hover:border-[var(--wild-orange)] transition-colors cursor-pointer group min-w-[200px]">
                      <img src={artist.image} class="w-10 h-10 rounded-full object-cover border border-white/20 group-hover:border-[var(--wild-orange)]" />
                      <div>
                          <h4 class="text-xs font-black text-white uppercase leading-none mb-1">{artist.name}</h4>
                          <span class="text-[9px] font-mono text-gray-500 uppercase block">{artist.date}</span>
                      </div>
                  </div>
              ))}
          </div>
      </section>

    </div>

    <!-- Floating Player (Estilo Walkman Compacto) -->
    <div id="floating-player" class="fixed bottom-6 right-6 z-50 translate-y-[150%] transition-transform duration-500">
      <div class="bg-[#111] border border-white/20 w-[300px] shadow-2xl rounded-lg overflow-hidden flex flex-col">
          <div class="h-1 bg-gradient-to-r from-[var(--wild-orange)] to-red-600"></div>
          
          <div class="p-3 flex gap-3 items-center bg-[#1a1a1a]">
              <img id="player-cover" src="" class="w-10 h-10 rounded object-cover border border-white/10" />
              <div class="min-w-0 flex-1">
                  <h4 id="player-title" class="text-xs font-black text-white uppercase truncate">TRACK</h4>
                  <p id="player-artist" class="text-[9px] font-mono text-gray-400 uppercase truncate">ARTIST</p>
              </div>
              <button id="close-player" class="text-gray-500 hover:text-white"><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 6L6 18M6 6l12 12"/></svg></button>
          </div>

          <div class="p-2 bg-black flex justify-center items-center gap-4">
               <button id="prev-btn" class="text-gray-400 hover:text-white"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg></button>
               <button id="play-pause-btn" class="w-8 h-8 bg-white text-black rounded-full flex items-center justify-center hover:bg-[var(--wild-orange)] transition-colors">
                    <svg id="play-icon" width="12" height="12" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                    <svg id="pause-icon" width="12" height="12" viewBox="0 0 24 24" fill="currentColor" class="hidden"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
               </button>
               <button id="next-btn" class="text-gray-400 hover:text-white"><svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg></button>
          </div>
          
          <div class="h-0.5 bg-gray-800 w-full cursor-pointer group relative">
              <div id="progress-fill" class="h-full bg-[var(--wild-orange)] w-0 group-hover:h-1 transition-all"></div>
          </div>
      </div>
    </div>

  </div>
</Layout>

<style is:global define:vars={{ streetAccent: tenant.primary_color }}>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(10px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.5s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
  
  .scrollbar-hide::-webkit-scrollbar {
      display: none;
  }
  .scrollbar-hide {
      -ms-overflow-style: none;
      scrollbar-width: none;
  }
</style>

<script>
  // Player Logic
  const player = document.getElementById('floating-player');
  const playBtns = document.querySelectorAll('.play-track-btn');
  const closeBtn = document.getElementById('close-player');
  const playPauseBtn = document.getElementById('play-pause-btn');
  const playIcon = document.getElementById('play-icon');
  const pauseIcon = document.getElementById('pause-icon');
  const progressFill = document.getElementById('progress-fill');
  
  const titleEl = document.getElementById('player-title');
  const artistEl = document.getElementById('player-artist');
  const coverEl = document.getElementById('player-cover') as HTMLImageElement;
  
  let isPlaying = false;
  let progress = 0;
  let interval: number | undefined;

  if (player && closeBtn && playPauseBtn && playIcon && pauseIcon && progressFill) {
    
    playBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.stopPropagation();
        const target = e.currentTarget as HTMLElement;
        
        if (titleEl) titleEl.textContent = target.dataset.title || '';
        if (artistEl) artistEl.textContent = target.dataset.artist || '';
        if (coverEl) coverEl.src = target.dataset.cover || '';
        
        player.classList.remove('translate-y-[150%]');
        isPlaying = true;
        updatePlayBtn();
        startProgress();
      });
    });

    closeBtn.addEventListener('click', () => {
      player.classList.add('translate-y-[150%]');
      isPlaying = false;
      updatePlayBtn();
      stopProgress();
    });

    playPauseBtn.addEventListener('click', () => {
        isPlaying = !isPlaying;
        updatePlayBtn();
        if (isPlaying) startProgress();
        else stopProgress();
    });

    function updatePlayBtn() {
        if (isPlaying) {
            playIcon?.classList.add('hidden');
            pauseIcon?.classList.remove('hidden');
        } else {
            playIcon?.classList.remove('hidden');
            pauseIcon?.classList.add('hidden');
        }
    }

    function startProgress() {
        stopProgress();
        interval = window.setInterval(() => {
            progress += 0.5;
            if (progress > 100) progress = 0;
            if (progressFill) progressFill.style.width = `${progress}%`;
        }, 100);
    }

    function stopProgress() {
        if (interval) clearInterval(interval);
    }
  }
</script>
