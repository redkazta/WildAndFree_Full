---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Música",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};

const tracks = [
  {
    id: 1,
    title: 'NOCHES DE NEÓN',
    artist: 'LIL KIRO',
    album: 'LUCES DE CIUDAD',
    duration: '3:24',
    cover: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=300&h=300&fit=crop&crop=face',
    plays: '2.1M'
  },
  {
    id: 2,
    title: 'TOKYO DRIFT',
    artist: 'NEON GHOST',
    album: 'SESIONES DE MEDIANOCHE',
    duration: '4:12',
    cover: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=300&h=300&fit=crop&crop=face',
    plays: '1.8M'
  },
  {
    id: 4,
    title: 'REINO DE SOMBRAS',
    artist: 'SHADOW V',
    album: 'MATERIA OSCURA',
    duration: '3:58',
    cover: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=300&h=300&fit=crop&crop=face',
    plays: '1.5M'
  },
  {
    id: 5,
    title: 'CRISTALINO',
    artist: 'CRYSTAL WAVE',
    album: 'ONDAS',
    duration: '3:33',
    cover: 'https://images.unsplash.com/photo-1544005313-94ddf0286df2?w=300&h=300&fit=crop&crop=face',
    plays: '890K'
  },
  {
    id: 6,
    title: 'PASEO DE MEDIANOCHE',
    artist: 'MIDNIGHT RIDER',
    album: 'JINETE NOCTURNO',
    duration: '4:01',
    cover: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=300&h=300&fit=crop&crop=face',
    plays: '2.7M'
  }
];

const albums = [
  {
    id: 1,
    title: 'LUCES DE CIUDAD',
    artist: 'LIL KIRO',
    cover: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?w=400&h=400&fit=crop&crop=face',
    year: '2024',
    tracks: 12,
    type: 'LP'
  },
  {
    id: 2,
    title: 'SESIONES DE MEDIANOCHE',
    artist: 'NEON GHOST',
    cover: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&fit=crop&crop=face',
    year: '2024',
    tracks: 15,
    type: 'EP'
  }
];
---

<Layout config={config}>
  <main class="min-h-screen bg-[#050505] pt-32 pb-20 px-6 relative overflow-hidden">
    <!-- Background Noise Pattern -->
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 20px 20px;"></div>

    <div class="max-w-[1400px] mx-auto space-y-24 relative z-10">
      
      <!-- Header Brutalista con Marquee -->
      <div class="border-b-4 border-white pb-8">
        <div class="flex flex-col md:flex-row items-end gap-6 mb-8">
          <h1 class="text-7xl md:text-9xl font-black tracking-tighter text-white uppercase leading-none" style="text-shadow: 4px 4px 0px var(--street-accent);">
            SONIDOS
          </h1>
          <div class="flex flex-col mb-2">
             <span class="text-xl font-bold text-black bg-[var(--street-accent)] px-2 inline-block w-fit">WILD RECORDS</span>
             <span class="text-sm font-mono text-[#888] tracking-widest mt-1">HIFI • LOFI • NOFI</span>
          </div>
        </div>
        
        <!-- Marquee -->
        <div class="relative overflow-hidden bg-white py-2 border-y-2 border-black">
          <div class="whitespace-nowrap animate-marquee inline-block">
            <span class="text-black font-mono font-bold text-lg mx-4">NOW PLAYING: NOCHES DE NEÓN - LIL KIRO</span>
            <span class="text-[var(--street-accent)] font-black mx-2">///</span>
            <span class="text-black font-mono font-bold text-lg mx-4">NEW RELEASE: SESIONES DE MEDIANOCHE</span>
            <span class="text-[var(--street-accent)] font-black mx-2">///</span>
            <span class="text-black font-mono font-bold text-lg mx-4">TOP CHARTS: WILD GVNG GLOBAL</span>
            <span class="text-[var(--street-accent)] font-black mx-2">///</span>
             <span class="text-black font-mono font-bold text-lg mx-4">NOW PLAYING: NOCHES DE NEÓN - LIL KIRO</span>
            <span class="text-[var(--street-accent)] font-black mx-2">///</span>
            <span class="text-black font-mono font-bold text-lg mx-4">NEW RELEASE: SESIONES DE MEDIANOCHE</span>
            <span class="text-[var(--street-accent)] font-black mx-2">///</span>
            <span class="text-black font-mono font-bold text-lg mx-4">TOP CHARTS: WILD GVNG GLOBAL</span>
            <span class="text-[var(--street-accent)] font-black mx-2">///</span>
          </div>
        </div>
      </div>

      <!-- Featured Albums (Vinyl Style) -->
      <section>
        <div class="flex items-center gap-4 mb-12">
          <div class="w-12 h-12 bg-white text-black flex items-center justify-center font-black text-xl">01</div>
          <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter text-white">Lanzamientos</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-16">
          {albums.map((album) => (
            <div class="group relative">
              <!-- Vinyl Sleeve Container -->
              <div class="relative z-10 bg-[#111] border-2 border-white aspect-square p-2 hover:translate-y-[-10px] transition-transform duration-300">
                <img src={album.cover} alt={album.title} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" />
                
                <!-- Sticker -->
                <div class="absolute top-6 right-6 w-24 h-24 bg-[var(--street-accent)] rounded-full flex items-center justify-center rotate-12 group-hover:rotate-0 transition-transform shadow-lg z-20">
                  <div class="text-center">
                    <span class="block text-black font-black text-xs">STEREO</span>
                    <span class="block text-white font-bold text-lg leading-none">{album.year}</span>
                  </div>
                </div>

                <!-- OBI Strip / Banner -->
                <div class="absolute bottom-6 left-[-10px] bg-white text-black py-1 px-4 shadow-[4px_4px_0px_var(--street-accent)] z-20">
                   <span class="font-mono font-bold text-sm tracking-widest">{album.type}</span>
                </div>
                
                <!-- Play Overlay -->
                <button 
                  class="play-album-btn absolute inset-0 flex items-center justify-center bg-black/50 opacity-0 group-hover:opacity-100 transition-opacity z-30 cursor-pointer"
                  data-title={album.title}
                  data-artist={album.artist}
                  data-cover={album.cover}
                >
                  <div class="w-20 h-20 bg-[var(--street-accent)] rounded-full flex items-center justify-center shadow-[4px_4px_0px_black] hover:scale-110 transition-transform">
                     <svg width="32" height="32" viewBox="0 0 24 24" fill="black"><path d="M8 5v14l11-7z"/></svg>
                  </div>
                </button>
              </div>

              <!-- Vinyl Disc (Slides out on hover) -->
              <div class="absolute top-2 right-2 w-[95%] h-[95%] bg-black rounded-full border-[10px] border-[#1a1a1a] flex items-center justify-center z-0 group-hover:translate-x-[40%] transition-transform duration-500 ease-out shadow-2xl">
                 <div class="w-[40%] h-[40%] bg-[var(--street-accent)] rounded-full flex items-center justify-center">
                    <div class="w-2 h-2 bg-black rounded-full"></div>
                 </div>
                 <!-- Grooves -->
                 <div class="absolute inset-0 rounded-full border border-white/5 pointer-events-none"></div>
                 <div class="absolute inset-4 rounded-full border border-white/5 pointer-events-none"></div>
                 <div class="absolute inset-8 rounded-full border border-white/5 pointer-events-none"></div>
              </div>

              <!-- Info -->
              <div class="mt-8 relative z-20 bg-[#050505]/80 backdrop-blur">
                <h3 class="text-3xl font-black text-white uppercase">{album.title}</h3>
                <p class="text-[var(--street-accent)] font-mono text-lg">{album.artist}</p>
                <div class="flex gap-4 mt-2 text-sm text-gray-400 font-mono">
                  <span>{album.tracks} TRACKS</span>
                  <span>•</span>
                  <span>HIGH FIDELITY</span>
                </div>
              </div>
            </div>
          ))}
        </div>
      </section>

      <!-- Popular Tracks (Cassette/List Style) -->
      <section>
        <div class="flex items-center gap-4 mb-12">
          <div class="w-12 h-12 bg-white text-black flex items-center justify-center font-black text-xl">02</div>
          <h2 class="text-4xl md:text-6xl font-black uppercase tracking-tighter text-white">Top Tracks</h2>
        </div>

        <div class="space-y-4">
          {tracks.map((track, index) => (
            <div class="group relative flex items-center gap-6 bg-[#111] border border-white/20 p-4 hover:bg-white hover:border-[var(--street-accent)] transition-colors duration-300">
              
              <!-- Index Box -->
              <div class="w-12 h-12 border border-white/20 flex items-center justify-center group-hover:border-black group-hover:bg-black transition-colors">
                <span class="font-mono font-bold text-white group-hover:text-[var(--street-accent)]">
                  {String(index + 1).padStart(2, '0')}
                </span>
              </div>

              <!-- Track Info -->
              <div class="flex-1">
                <h4 class="text-xl font-bold text-white uppercase group-hover:text-black">{track.title}</h4>
                <p class="text-sm font-mono text-gray-400 group-hover:text-black/60">{track.artist} • {track.album}</p>
              </div>

              <!-- Stats -->
              <div class="hidden md:flex items-center gap-8 font-mono text-sm text-gray-500 group-hover:text-black/60">
                <span class="flex items-center gap-2">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
                  {track.plays}
                </span>
                <span class="flex items-center gap-2">
                  <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                  {track.duration}
                </span>
              </div>

              <!-- Play Button -->
              <button 
                class="play-track-btn w-12 h-12 bg-[var(--street-accent)] text-black flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity shadow-[4px_4px_0px_black] hover:scale-110"
                data-title={track.title}
                data-artist={track.artist}
                data-cover={track.cover}
                data-duration={track.duration}
              >
                <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"></polygon></svg>
              </button>
            </div>
          ))}
        </div>
      </section>

    </div>

    <!-- Floating Player (Walkman Style) -->
    <div id="floating-player" class="fixed bottom-8 right-8 z-50 translate-y-[150%] transition-transform duration-500">
      <div class="bg-[#1a1a1a] border-2 border-white p-4 w-[320px] shadow-[8px_8px_0px_var(--street-accent)]">
        <!-- Player Screen -->
        <div class="bg-[#9ea792] border-2 border-black/20 p-3 mb-4 font-mono text-black relative overflow-hidden shadow-inner">
           <div class="absolute inset-0 opacity-10 pointer-events-none" style="background-image: repeating-linear-gradient(0deg, transparent, transparent 2px, #000 3px);"></div>
           <div class="relative z-10">
              <p class="text-xs font-bold mb-1">NOW PLAYING ▶</p>
              <h4 id="player-title" class="text-lg font-black truncate leading-none">SELECCIONA TRACK</h4>
              <p id="player-artist" class="text-xs truncate mt-1">WILD GVNG</p>
              <div class="flex justify-between mt-2 text-xs font-bold">
                 <span id="current-time">0:00</span>
                 <span id="total-time">0:00</span>
              </div>
           </div>
        </div>

        <!-- Controls -->
        <div class="flex justify-between items-center gap-2">
           <button id="prev-btn" class="flex-1 bg-[#333] hover:bg-[#444] text-white p-2 border border-black shadow-[2px_2px_0px_black] active:translate-y-[2px] active:shadow-none transition-all">
              <svg class="w-4 h-4 mx-auto" fill="currentColor" viewBox="0 0 24 24"><path d="M6 6h2v12H6zm3.5 6l8.5 6V6z"/></svg>
           </button>
           <button id="play-pause-btn" class="flex-[2] bg-[var(--street-accent)] hover:bg-white text-black p-3 border border-black shadow-[2px_2px_0px_black] active:translate-y-[2px] active:shadow-none transition-all">
              <svg id="play-icon" class="w-6 h-6 mx-auto" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
              <svg id="pause-icon" class="w-6 h-6 mx-auto hidden" fill="currentColor" viewBox="0 0 24 24"><path d="M6 19h4V5H6v14zm8-14v14h4V5h-4z"/></svg>
           </button>
           <button id="next-btn" class="flex-1 bg-[#333] hover:bg-[#444] text-white p-2 border border-black shadow-[2px_2px_0px_black] active:translate-y-[2px] active:shadow-none transition-all">
              <svg class="w-4 h-4 mx-auto" fill="currentColor" viewBox="0 0 24 24"><path d="M6 18l8.5-6L6 6v12zM16 6v12h2V6h-2z"/></svg>
           </button>
        </div>
        
        <!-- Progress Bar -->
        <div class="mt-4 h-2 bg-[#000] border border-white/20 rounded-full overflow-hidden">
           <div id="progress-fill" class="h-full bg-[var(--street-accent)] w-0 transition-all duration-100"></div>
        </div>
        
        <button id="close-player" class="absolute -top-4 -right-4 bg-red-500 text-white w-8 h-8 flex items-center justify-center border-2 border-white shadow-lg hover:scale-110 transition-transform">
           <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 1l12 12M13 1L1 13"/></svg>
        </button>
      </div>
    </div>

  </main>
</Layout>

<style define:vars={{ streetAccent: tenant.primary_color }}>
  :root {
    --street-accent: var(--streetAccent);
  }
  
  @keyframes marquee {
    0% { transform: translateX(0); }
    100% { transform: translateX(-50%); }
  }
  
  .animate-marquee {
    animation: marquee 20s linear infinite;
  }
</style>

<script>
  // Player Logic
  const player = document.getElementById('floating-player');
  const playBtns = document.querySelectorAll('.play-track-btn, .play-album-btn');
  const closeBtn = document.getElementById('close-player');
  const playPauseBtn = document.getElementById('play-pause-btn');
  const playIcon = document.getElementById('play-icon');
  const pauseIcon = document.getElementById('pause-icon');
  const progressFill = document.getElementById('progress-fill');
  
  // Elementos de texto
  const titleEl = document.getElementById('player-title');
  const artistEl = document.getElementById('player-artist');
  const totalTimeEl = document.getElementById('total-time');
  const currentTimeEl = document.getElementById('current-time');
  
  let isPlaying = false;
  let progress = 0;
  let interval: number | undefined;

  if (player && closeBtn && playPauseBtn && playIcon && pauseIcon && progressFill && titleEl && artistEl && totalTimeEl && currentTimeEl) {
    
    playBtns.forEach(btn => {
      btn.addEventListener('click', (e) => {
        e.preventDefault();
        
        const title = btn.getAttribute('data-title') || 'Unknown Track';
        const artist = btn.getAttribute('data-artist') || 'Unknown Artist';
        const duration = btn.getAttribute('data-duration') || '3:00';
        
        // Update Player Info
        titleEl.textContent = title;
        artistEl.textContent = artist;
        totalTimeEl.textContent = duration;
        
        // Show Player
        player.style.transform = 'translateY(0)';
        
        // Auto Play
        isPlaying = true;
        updatePlayButton();
        startProgress();
      });
    });

    closeBtn.addEventListener('click', () => {
      player.style.transform = 'translateY(150%)';
      isPlaying = false;
      updatePlayButton();
      clearInterval(interval);
    });

    playPauseBtn.addEventListener('click', () => {
      isPlaying = !isPlaying;
      updatePlayButton();
      if (isPlaying) startProgress();
      else clearInterval(interval);
    });

    function updatePlayButton() {
      if (!playIcon || !pauseIcon) return;
      
      if (isPlaying) {
        playIcon.classList.add('hidden');
        pauseIcon.classList.remove('hidden');
      } else {
        playIcon.classList.remove('hidden');
        pauseIcon.classList.add('hidden');
      }
    }

    function startProgress() {
      clearInterval(interval);
      interval = window.setInterval(() => {
        if (!progressFill || !currentTimeEl) return;
        
        progress += 1;
        if (progress > 100) progress = 0;
        progressFill.style.width = `${progress}%`;
        
        // Simple time update simulation
        const totalSeconds = 180; // 3 mins approx
        const currentSeconds = Math.floor((progress / 100) * totalSeconds);
        const mins = Math.floor(currentSeconds / 60);
        const secs = currentSeconds % 60;
        currentTimeEl.textContent = `${mins}:${secs.toString().padStart(2, '0')}`;
      }, 1000);
    }
  }
</script>
