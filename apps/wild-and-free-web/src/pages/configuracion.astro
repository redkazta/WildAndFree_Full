---
import Layout from '../layouts/Layout.astro';
---

<Layout config={{
  name: "Wild Gvng - Configuración",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>
  <div class="cfg">
    <div class="cfg-inner">

      <!-- LEFT MENU -->
      <aside class="cfg-side">
        <h2 class="cfg-side-title">CONFIGURACIÓN</h2>
        <nav class="cfg-nav">
          <button class="cfg-nav-btn active" data-section="apariencia">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg>
            Apariencia
          </button>
          <button class="cfg-nav-btn" data-section="cuenta">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
            Cuenta
          </button>
          <button class="cfg-nav-btn" data-section="notificaciones">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 006 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 01-3.46 0"/></svg>
            Notificaciones
          </button>
          <button class="cfg-nav-btn" data-section="privacidad">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0110 0v4"/></svg>
            Privacidad
          </button>
          <button class="cfg-nav-btn" data-section="reproduccion">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="5 3 19 12 5 21 5 3"/></svg>
            Reproducción
          </button>
          <button class="cfg-nav-btn" data-section="idioma">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
            Idioma
          </button>
          <div class="cfg-nav-divider"></div>
          <button class="cfg-nav-btn danger" data-section="peligro">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
            Zona de Peligro
          </button>
        </nav>
      </aside>

      <!-- RIGHT CONTENT -->
      <div class="cfg-content">

        <!-- APARIENCIA -->
        <div class="cfg-section active" data-section="apariencia">
          <h3 class="cfg-section-title">Apariencia</h3>
          <p class="cfg-section-desc">Personaliza cómo se ve Wild Gvng para ti.</p>

          <div class="cfg-card">
            <h4 class="cfg-card-label">TEMA</h4>
            <div class="cfg-theme-grid">
              <button class="cfg-theme-card active" data-theme-choice="dark">
                <div class="cfg-theme-preview dark-preview">
                  <div class="tp-bar"></div>
                  <div class="tp-sides">
                    <div class="tp-side"></div>
                    <div class="tp-main"><div class="tp-line"></div><div class="tp-line short"></div></div>
                  </div>
                </div>
                <span>Oscuro</span>
              </button>
              <button class="cfg-theme-card" data-theme-choice="light">
                <div class="cfg-theme-preview light-preview">
                  <div class="tp-bar"></div>
                  <div class="tp-sides">
                    <div class="tp-side"></div>
                    <div class="tp-main"><div class="tp-line"></div><div class="tp-line short"></div></div>
                  </div>
                </div>
                <span>Claro</span>
              </button>
            </div>
          </div>

          <div class="cfg-card">
            <h4 class="cfg-card-label">FUENTE</h4>
            <div class="cfg-row">
              <span class="cfg-label">Tamaño de texto</span>
              <select class="cfg-select" data-setting="font_size">
                <option value="small">Pequeño</option>
                <option value="medium" selected>Mediano</option>
                <option value="large">Grande</option>
              </select>
            </div>
          </div>

          <div class="cfg-card">
            <h4 class="cfg-card-label">ANIMACIONES</h4>
            <div class="cfg-row">
              <span class="cfg-label">Efectos de movimiento</span>
              <button class="cfg-toggle active" data-cfg-toggle="animations" data-setting="animations">
                <span class="cfg-toggle-dot"></span>
              </button>
            </div>
          </div>
        </div>

        <!-- CUENTA -->
        <div class="cfg-section" data-section="cuenta">
          <h3 class="cfg-section-title">Cuenta</h3>
          <p class="cfg-section-desc">Administra tu información personal.</p>

          <div class="cfg-card">
            <h4 class="cfg-card-label">INFORMACIÓN PERSONAL</h4>
            <div class="cfg-row">
              <div class="cfg-field">
                <span class="cfg-label">Nombre completo</span>
                <span class="cfg-value" id="cfg-name">Cargando...</span>
              </div>
              <button class="cfg-btn-small">Editar</button>
            </div>
            <div class="cfg-row">
              <div class="cfg-field">
                <span class="cfg-label">Correo electrónico</span>
                <span class="cfg-value" id="cfg-email">Cargando...</span>
              </div>
              <button class="cfg-btn-small">Cambiar</button>
            </div>
            <div class="cfg-row">
              <div class="cfg-field">
                <span class="cfg-label">Nombre de usuario</span>
                <span class="cfg-value" id="cfg-username">@cargando</span>
              </div>
              <button class="cfg-btn-small">Editar</button>
            </div>
          </div>

          <div class="cfg-card">
            <h4 class="cfg-card-label">SEGURIDAD</h4>
            <div class="cfg-row">
              <div class="cfg-field">
                <span class="cfg-label">Contraseña</span>
                <span class="cfg-value">••••••••</span>
              </div>
              <button class="cfg-btn-small">Cambiar</button>
            </div>
          </div>
        </div>

        <!-- NOTIFICACIONES -->
        <div class="cfg-section" data-section="notificaciones">
          <h3 class="cfg-section-title">Notificaciones</h3>
          <p class="cfg-section-desc">Controla qué notificaciones recibes.</p>

          <div class="cfg-card">
            <h4 class="cfg-card-label">NOTIFICACIONES PUSH</h4>
            <div class="cfg-row">
              <span class="cfg-label">Nuevos eventos</span>
              <button class="cfg-toggle active" data-cfg-toggle="push_events" data-setting="push_events"><span class="cfg-toggle-dot"></span></button>
            </div>
            <div class="cfg-row">
              <span class="cfg-label">Nuevos posts de artistas</span>
              <button class="cfg-toggle active" data-cfg-toggle="push_posts" data-setting="push_posts"><span class="cfg-toggle-dot"></span></button>
            </div>
            <div class="cfg-row">
              <span class="cfg-label">Comentarios en tus posts</span>
              <button class="cfg-toggle active" data-cfg-toggle="push_comments" data-setting="push_comments"><span class="cfg-toggle-dot"></span></button>
            </div>
            <div class="cfg-row">
              <span class="cfg-label">Nuevos seguidores</span>
              <button class="cfg-toggle" data-cfg-toggle="push_followers" data-setting="push_followers"><span class="cfg-toggle-dot"></span></button>
            </div>
          </div>

          <div class="cfg-card">
            <h4 class="cfg-card-label">CORREO ELECTRÓNICO</h4>
            <div class="cfg-row">
              <span class="cfg-label">Resumen semanal</span>
              <button class="cfg-toggle" data-cfg-toggle="email_weekly" data-setting="email_weekly"><span class="cfg-toggle-dot"></span></button>
            </div>
            <div class="cfg-row">
              <span class="cfg-label">Ofertas de la tienda</span>
              <button class="cfg-toggle" data-cfg-toggle="email_promos" data-setting="email_promos"><span class="cfg-toggle-dot"></span></button>
            </div>
          </div>
        </div>

        <!-- PRIVACIDAD -->
        <div class="cfg-section" data-section="privacidad">
          <h3 class="cfg-section-title">Privacidad</h3>
          <p class="cfg-section-desc">Controla quién puede ver tu información.</p>

          <div class="cfg-card">
            <h4 class="cfg-card-label">VISIBILIDAD</h4>
            <div class="cfg-row">
              <div class="cfg-field">
                <span class="cfg-label">Perfil público</span>
                <span class="cfg-value cfg-muted">Cualquiera puede ver tu perfil</span>
              </div>
              <button class="cfg-toggle active" data-cfg-toggle="profile_public" data-setting="profile_public"><span class="cfg-toggle-dot"></span></button>
            </div>
            <div class="cfg-row">
              <div class="cfg-field">
                <span class="cfg-label">Mostrar en rankings</span>
                <span class="cfg-value cfg-muted">Aparecer en listas de Wild Ones</span>
              </div>
              <button class="cfg-toggle active" data-cfg-toggle="show_ranking" data-setting="show_ranking"><span class="cfg-toggle-dot"></span></button>
            </div>
          </div>

          <div class="cfg-card">
            <h4 class="cfg-card-label">DATOS</h4>
            <div class="cfg-row">
              <div class="cfg-field">
                <span class="cfg-label">Historial de reproducción</span>
                <span class="cfg-value cfg-muted">Guardar lo que escuchas</span>
              </div>
              <button class="cfg-toggle active" data-cfg-toggle="history_enabled" data-setting="history_enabled"><span class="cfg-toggle-dot"></span></button>
            </div>
            <div class="cfg-row">
              <div class="cfg-field">
                <span class="cfg-label">Compartir datos de uso</span>
                <span class="cfg-value cfg-muted">Ayudar a mejorar la plataforma</span>
              </div>
              <button class="cfg-toggle" data-cfg-toggle="share_data" data-setting="share_data"><span class="cfg-toggle-dot"></span></button>
            </div>
          </div>
        </div>

        <!-- REPRODUCCIÓN -->
        <div class="cfg-section" data-section="reproduccion">
          <h3 class="cfg-section-title">Reproducción</h3>
          <p class="cfg-section-desc">Configura cómo se reproduce la música.</p>

          <div class="cfg-card">
            <h4 class="cfg-card-label">AUDIO</h4>
            <div class="cfg-row">
              <span class="cfg-label">Calidad de streaming</span>
              <select class="cfg-select" data-setting="streaming_quality">
                <option value="low">Baja (128 kbps)</option>
                <option value="medium" selected>Media (256 kbps)</option>
                <option value="high">Alta (320 kbps)</option>
              </select>
            </div>
            <div class="cfg-row">
              <span class="cfg-label">Reproducción automática</span>
              <button class="cfg-toggle active" data-cfg-toggle="autoplay" data-setting="autoplay"><span class="cfg-toggle-dot"></span></button>
            </div>
            <div class="cfg-row">
              <span class="cfg-label">Crossfade entre canciones</span>
              <button class="cfg-toggle" data-cfg-toggle="crossfade" data-setting="crossfade"><span class="cfg-toggle-dot"></span></button>
            </div>
          </div>

          <div class="cfg-card">
            <h4 class="cfg-card-label">RADIO</h4>
            <div class="cfg-row">
              <div class="cfg-field">
                <span class="cfg-label">Auto Radio predeterminado</span>
                <span class="cfg-value cfg-muted">La playlist de Spotify que se reproduce automáticamente</span>
              </div>
              <button class="cfg-btn-small">Configurar</button>
            </div>
            <div class="cfg-row">
              <span class="cfg-label">Modo sin conexión</span>
              <button class="cfg-toggle" data-cfg-toggle="offline_mode" data-setting="offline_mode"><span class="cfg-toggle-dot"></span></button>
            </div>
          </div>
        </div>

        <!-- IDIOMA -->
        <div class="cfg-section" data-section="idioma">
          <h3 class="cfg-section-title">Idioma</h3>
          <p class="cfg-section-desc">Selecciona el idioma de la plataforma.</p>

          <div class="cfg-card">
            <h4 class="cfg-card-label">IDIOMA DE LA INTERFAZ</h4>
            <div class="cfg-lang-grid">
              <button class="cfg-lang-btn active" data-locale="es">
                <span class="cfg-lang-flag">🇲🇽</span>
                <span>Español</span>
              </button>
              <button class="cfg-lang-btn" data-locale="en">
                <span class="cfg-lang-flag">🇺🇸</span>
                <span>English</span>
              </button>
            </div>
          </div>

          <div class="cfg-card">
            <h4 class="cfg-card-label">UBICACIÓN</h4>
            <div class="cfg-row">
              <span class="cfg-label">Zona</span>
              <select class="cfg-select" data-setting="ubicacion">
                <option value="Torreón" selected>Torreón</option>
                <option value="Gómez Palacio">Gómez Palacio</option>
                <option value="Lerdo">Lerdo</option>
                <option value="Monterrey">Monterrey</option>
                <option value="Otro">Otro</option>
              </select>
            </div>
          </div>
        </div>

        <!-- ZONA DE PELIGRO -->
        <div class="cfg-section" data-section="peligro">
          <h3 class="cfg-section-title cfg-danger-title">Zona de Peligro</h3>
          <p class="cfg-section-desc">Estas acciones son permanentes e irreversibles.</p>

          <div class="cfg-card cfg-danger-card">
            <h4 class="cfg-card-label cfg-danger-label">ELIMINAR CUENTA</h4>
            <div class="cfg-row">
              <div class="cfg-field">
                <span class="cfg-label">Eliminar mi cuenta permanentemente</span>
                <span class="cfg-value cfg-muted">Se enviará una solicitud al equipo de Wild Gvng para revisión. Tu cuenta será desactivada mientras se procesa.</span>
              </div>
              <button class="cfg-btn-danger cfg-btn-red" id="cfg-request-deletion">Solicitar</button>
            </div>
          </div>

          <!-- Deletion request status -->
          <div class="cfg-card cfg-danger-card" id="deletion-status-card" style="display:none;">
            <h4 class="cfg-card-label cfg-danger-label">ESTADO DE SOLICITUD</h4>
            <div class="cfg-row">
              <div class="cfg-field">
                <span class="cfg-label">Estado</span>
                <span class="cfg-value" id="deletion-status">Pendiente</span>
              </div>
            </div>
            <div class="cfg-row">
              <div class="cfg-field">
                <span class="cfg-label">Fecha de solicitud</span>
                <span class="cfg-value" id="deletion-date">—</span>
              </div>
            </div>
          </div>
        </div>

      </div>
    </div>

    <!-- Deletion confirmation modal -->
    <div class="cfg-modal-overlay" id="deletion-modal" style="display:none;">
      <div class="cfg-modal">
        <h3 class="cfg-modal-title">¿Eliminar tu cuenta?</h3>
        <p class="cfg-modal-desc">Esta acción enviará una solicitud al equipo de Wild Gvng. Tu cuenta será desactivada mientras se procesa. No se puede deshacer.</p>
        <div class="cfg-modal-field">
          <label class="cfg-modal-label">¿Por qué quieres eliminar tu cuenta?</label>
          <textarea class="cfg-modal-textarea" id="deletion-reason" placeholder="Opcional: cuéntanos tu motivo..." rows="3"></textarea>
        </div>
        <div class="cfg-modal-actions">
          <button class="cfg-btn-small" id="deletion-cancel">Cancelar</button>
          <button class="cfg-btn-danger cfg-btn-red" id="deletion-confirm">Solicitar eliminación</button>
        </div>
      </div>
    </div>

    <!-- Toast notification -->
    <div class="cfg-toast" id="cfg-toast" style="display:none;">
      <span id="cfg-toast-msg"></span>
    </div>
  </div>

  <style>
    .cfg {
      min-height: 100vh;
      background: var(--bg);
      color: var(--text);
      font-family: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
    }
    .cfg-inner {
      max-width: 95%;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 220px 1fr;
      gap: 24px;
      padding: 24px 0 60px;
    }

    /* ── SIDEBAR MENU ── */
    .cfg-side {
      position: sticky;
      top: 100px;
      align-self: start;
    }
    .cfg-side-title {
      font-size: 0.55rem;
      font-weight: 900;
      letter-spacing: 0.2em;
      color: var(--text-muted);
      margin: 0 0 16px 12px;
      font-family: monospace;
    }
    .cfg-nav {
      display: flex;
      flex-direction: column;
      gap: 2px;
    }
    .cfg-nav-btn {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 12px;
      border: none;
      border-radius: 8px;
      background: transparent;
      color: var(--text-secondary);
      font-size: 0.75rem;
      font-weight: 600;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.15s;
      text-align: left;
      width: 100%;
    }
    .cfg-nav-btn:hover {
      background: var(--bg-hover);
      color: var(--text);
    }
    .cfg-nav-btn.active {
      background: var(--primary-soft);
      color: var(--primary);
    }
    .cfg-nav-btn.danger {
      color: var(--event);
    }
    .cfg-nav-btn.danger:hover {
      background: rgba(255, 107, 107, 0.08);
    }
    .cfg-nav-divider {
      height: 1px;
      background: var(--border);
      margin: 8px 12px;
    }

    /* ── CONTENT ── */
    .cfg-content {
      min-width: 0;
    }
    .cfg-section {
      display: none;
    }
    .cfg-section.active {
      display: block;
    }
    .cfg-section-title {
      font-size: 1.5rem;
      font-weight: 800;
      margin: 0 0 4px;
      color: var(--text);
    }
    .cfg-section-desc {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin: 0 0 24px;
    }
    .cfg-danger-title {
      color: var(--event);
    }

    /* ── CARDS ── */
    .cfg-card {
      background: var(--bg-card);
      border: 1px solid var(--border);
      border-radius: 10px;
      padding: 16px;
      margin-bottom: 12px;
    }
    .cfg-danger-card {
      border-color: rgba(255, 107, 107, 0.2);
    }
    .cfg-card-label {
      font-size: 0.5rem;
      font-weight: 900;
      letter-spacing: 0.15em;
      color: var(--text-muted);
      margin: 0 0 12px;
      font-family: monospace;
    }
    .cfg-danger-label {
      color: var(--event);
    }

    /* ── ROW ── */
    .cfg-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 10px 0;
      border-bottom: 1px solid var(--border);
      gap: 12px;
    }
    .cfg-row:last-child {
      border-bottom: none;
    }
    .cfg-field {
      flex: 1;
      min-width: 0;
    }
    .cfg-label {
      font-size: 0.8rem;
      font-weight: 600;
      color: var(--text);
      display: block;
    }
    .cfg-value {
      font-size: 0.7rem;
      color: var(--text-secondary);
      display: block;
      margin-top: 2px;
    }
    .cfg-muted {
      color: var(--text-muted);
    }

    /* ── TOGGLE ── */
    .cfg-toggle {
      position: relative;
      width: 40px;
      height: 22px;
      border-radius: 11px;
      background: var(--border);
      border: none;
      cursor: pointer;
      transition: background 0.25s;
      flex-shrink: 0;
    }
    .cfg-toggle-dot {
      position: absolute;
      top: 3px;
      left: 3px;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: var(--text-muted);
      transition: all 0.25s;
    }
    .cfg-toggle.active {
      background: var(--primary);
    }
    .cfg-toggle.active .cfg-toggle-dot {
      transform: translateX(18px);
      background: var(--bg);
    }

    /* ── SELECT ── */
    .cfg-select {
      padding: 6px 10px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: var(--bg-card);
      color: var(--text);
      font-size: 0.75rem;
      font-family: inherit;
      font-weight: 600;
      cursor: pointer;
      outline: none;
      min-width: 140px;
    }
    .cfg-select:focus {
      border-color: var(--primary);
    }

    /* ── SMALL BUTTON ── */
    .cfg-btn-small {
      padding: 5px 12px;
      border-radius: 6px;
      border: 1px solid var(--border);
      background: transparent;
      color: var(--text-secondary);
      font-size: 0.65rem;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.15s;
      flex-shrink: 0;
    }
    .cfg-btn-small:hover {
      border-color: var(--primary);
      color: var(--primary);
    }

    /* ── DANGER BUTTONS ── */
    .cfg-btn-danger {
      padding: 5px 12px;
      border-radius: 6px;
      border: 1px solid rgba(255, 107, 107, 0.3);
      background: transparent;
      color: var(--event);
      font-size: 0.65rem;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.15s;
      flex-shrink: 0;
    }
    .cfg-btn-danger:hover {
      background: rgba(255, 107, 107, 0.1);
      border-color: var(--event);
    }
    .cfg-btn-red {
      border-color: var(--event);
      color: var(--event);
    }

    /* ── THEME GRID ── */
    .cfg-theme-grid {
      display: flex;
      gap: 12px;
    }
    .cfg-theme-card {
      flex: 1;
      padding: 12px;
      border-radius: 10px;
      border: 2px solid var(--border);
      background: transparent;
      cursor: pointer;
      transition: all 0.2s;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--text-secondary);
      font-family: inherit;
    }
    .cfg-theme-card.active {
      border-color: var(--primary);
      color: var(--primary);
    }
    .cfg-theme-preview {
      width: 100%;
      height: 60px;
      border-radius: 6px;
      overflow: hidden;
      padding: 6px;
    }
    .dark-preview {
      background: var(--bg);
    }
    .light-preview {
      background: var(--bg-card);
    }
    .tp-bar {
      height: 6px;
      border-radius: 2px;
      margin-bottom: 6px;
    }
    .dark-preview .tp-bar { background: var(--primary); }
    .light-preview .tp-bar { background: var(--primary-hover); }
    .tp-sides {
      display: flex;
      gap: 4px;
      height: 32px;
    }
    .tp-side {
      width: 20%;
      border-radius: 3px;
    }
    .dark-preview .tp-side { background: var(--bg-card); }
    .light-preview .tp-side { background: var(--bg-card); }
    .tp-main {
      flex: 1;
      border-radius: 3px;
      padding: 4px;
      display: flex;
      flex-direction: column;
      gap: 3px;
    }
    .dark-preview .tp-main { background: var(--bg); }
    .light-preview .tp-main { background: var(--bg); }
    .tp-line {
      height: 4px;
      border-radius: 2px;
    }
    .dark-preview .tp-line { background: var(--border-muted); }
    .light-preview .tp-line { background: var(--border-muted); }
    .tp-line.short { width: 60%; }

    /* ── LANGUAGE GRID ── */
    .cfg-lang-grid {
      display: flex;
      gap: 8px;
    }
    .cfg-lang-btn {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 10px 16px;
      border-radius: 8px;
      border: 2px solid var(--border);
      background: transparent;
      color: var(--text-secondary);
      font-size: 0.75rem;
      font-weight: 700;
      font-family: inherit;
      cursor: pointer;
      transition: all 0.2s;
    }
    .cfg-lang-btn.active {
      border-color: var(--primary);
      color: var(--primary);
    }
    .cfg-lang-flag {
      font-size: 1.2rem;
    }

    /* ── MODAL ── */
    .cfg-modal-overlay {
      position: fixed;
      inset: 0;
      background: rgba(0, 0, 0, 0.7);
      backdrop-filter: blur(8px);
      z-index: 9999;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }
    .cfg-modal {
      background: var(--bg);
      border: 1px solid var(--border);
      border-radius: 16px;
      padding: 32px;
      max-width: 480px;
      width: 100%;
    }
    .cfg-modal-title {
      font-size: 1.2rem;
      font-weight: 800;
      color: var(--event);
      margin: 0 0 8px;
    }
    .cfg-modal-desc {
      font-size: 0.8rem;
      color: var(--text-muted);
      margin: 0 0 20px;
      line-height: 1.5;
    }
    .cfg-modal-field {
      margin-bottom: 20px;
    }
    .cfg-modal-label {
      font-size: 0.75rem;
      font-weight: 600;
      color: var(--text);
      display: block;
      margin-bottom: 8px;
    }
    .cfg-modal-textarea {
      width: 100%;
      padding: 10px 12px;
      border-radius: 8px;
      border: 1px solid var(--border);
      background: var(--bg-card);
      color: var(--text);
      font-size: 0.8rem;
      font-family: inherit;
      resize: vertical;
      outline: none;
    }
    .cfg-modal-textarea:focus {
      border-color: var(--primary);
    }
    .cfg-modal-actions {
      display: flex;
      gap: 8px;
      justify-content: flex-end;
    }

    /* ── TOAST ── */
    .cfg-toast {
      position: fixed;
      bottom: 24px;
      left: 50%;
      transform: translateX(-50%);
      background: var(--primary);
      color: var(--bg);
      padding: 10px 24px;
      border-radius: 8px;
      font-size: 0.75rem;
      font-weight: 700;
      z-index: 10000;
      box-shadow: 0 8px 30px rgba(0, 0, 0, 0.4);
    }

    /* ── MOBILE ── */
    @media (max-width: 768px) {
      .cfg-inner {
        grid-template-columns: 1fr;
        gap: 16px;
        max-width: 100%;
        padding: 16px 4px 40px;
      }
      .cfg-side {
        position: static;
      }
      .cfg-nav {
        flex-direction: row;
        overflow-x: auto;
        gap: 4px;
        padding-bottom: 4px;
      }
      .cfg-nav-btn {
        white-space: nowrap;
        padding: 8px 12px;
        font-size: 0.65rem;
      }
      .cfg-nav-divider {
        display: none;
      }
      .cfg-theme-grid {
        flex-direction: column;
      }
      .cfg-row {
        flex-wrap: wrap;
      }
    }
  </style>

  <script>
    const SUPABASE_URL = import.meta.env.PUBLIC_SUPABASE_URL || 'https://cfsqhbisrkqhbupyjrwz.supabase.co';
    const SUPABASE_KEY = import.meta.env.PUBLIC_SUPABASE_ANON_KEY || 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNmc3FoYmlzcmtxaGJ1cHlqcnd6Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc4MjYwMTA0OSwiZXhwIjoyMDk4MTc3MDQ5fQ.neLLjRHAkZ8yBS0LulP7M5qa2Vh2IA2KycD6t5x7-dM';

    let supabaseClient: any = null;
    let currentUser: any = null;
    let userSettings: Record<string, any> = {};

    // Default settings
    const defaults = {
      theme: 'dark', font_size: 'medium', animations: true,
      locale: 'es', ubicacion: 'Torreón',
      autoplay: true, crossfade: false, streaming_quality: 'medium', offline_mode: false,
      push_events: true, push_posts: true, push_comments: true, push_followers: false,
      email_weekly: false, email_promos: false,
      profile_public: true, show_ranking: true, history_enabled: true, share_data: false
    };

    function showToast(msg: string) {
      const toast = document.getElementById('cfg-toast');
      const toastMsg = document.getElementById('cfg-toast-msg');
      if (toast && toastMsg) {
        toastMsg.textContent = msg;
        toast.style.display = 'block';
        setTimeout(() => { toast.style.display = 'none'; }, 2500);
      }
    }

    async function initSupabase() {
      try {
        const { createClient } = await import('@supabase/supabase-js');
        supabaseClient = createClient(SUPABASE_URL, SUPABASE_KEY);
        const { data: { session } } = await supabaseClient.auth.getSession();
        if (session?.user) {
          currentUser = session.user;
          document.body.setAttribute('data-auth-loaded', 'true');
          return true;
        }
      } catch (e) { console.error('Supabase init error:', e); }
      document.body.setAttribute('data-auth-loaded', 'true');
      return false;
    }

    async function loadSettings() {
      if (!supabaseClient || !currentUser) return defaults;
      try {
        const { data } = await supabaseClient
          .from('user_settings')
          .select('*')
          .eq('user_id', currentUser.id)
          .single();
        if (data) {
          userSettings = { ...defaults, ...data };
        } else {
          // Create default settings
          const { error } = await supabaseClient
            .from('user_settings')
            .insert({ user_id: currentUser.id, ...defaults });
          if (!error) userSettings = { ...defaults };
        }
      } catch (e) { console.error('Load settings error:', e); userSettings = { ...defaults }; }
      return userSettings;
    }

    async function saveSetting(key: string, value: any) {
      userSettings[key] = value;
      // Save to localStorage as backup
      localStorage.setItem('wg-settings', JSON.stringify(userSettings));
      // Save to Supabase
      if (supabaseClient && currentUser) {
        try {
          await supabaseClient
            .from('user_settings')
            .upsert({ user_id: currentUser.id, [key]: value }, { onConflict: 'user_id' });
        } catch (e) { console.error('Save setting error:', e); }
      }
    }

    function applySettings(settings: Record<string, any>) {
      // Theme - use same mechanism as SidebarLeft
      if (settings.theme === 'light' || settings.theme === 'dark') {
        document.documentElement.classList.add('theme-transition');
        document.documentElement.setAttribute('data-theme', settings.theme);
        localStorage.setItem('wg-theme', settings.theme);
        setTimeout(() => document.documentElement.classList.remove('theme-transition'), 400);
      }

      // Sync theme cards based on current theme
      const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
      document.querySelectorAll('.cfg-theme-card').forEach(card => {
        card.classList.toggle('active', card.getAttribute('data-theme-choice') === currentTheme);
      });

      // Font size via CSS variable tokens (no zoom, no layout breaking)
      document.documentElement.setAttribute('data-font-size', settings.font_size || 'medium');

      // Animations
      if (!settings.animations) {
        document.documentElement.style.setProperty('--transition-speed', '0s');
      } else {
        document.documentElement.style.removeProperty('--transition-speed');
      }

      // Sync toggles
      document.querySelectorAll('.cfg-toggle[data-setting]').forEach(toggle => {
        const key = toggle.getAttribute('data-setting');
        if (key && key in settings) {
          toggle.classList.toggle('active', !!settings[key]);
        }
      });

      // Sync selects
      document.querySelectorAll('.cfg-select[data-setting]').forEach(select => {
        const key = select.getAttribute('data-setting');
        if (key && key in settings) {
          (select as HTMLSelectElement).value = settings[key];
        }
      });

      // Sync locale buttons
      document.querySelectorAll('.cfg-lang-btn').forEach(btn => {
        btn.classList.toggle('active', btn.getAttribute('data-locale') === (settings.locale || 'es'));
      });
    }

    function loadUserInfo() {
      if (!currentUser) return;
      const nameEl = document.getElementById('cfg-name');
      const emailEl = document.getElementById('cfg-email');
      const usernameEl = document.getElementById('cfg-username');
      if (nameEl) nameEl.textContent = currentUser.user_metadata?.full_name || currentUser.email?.split('@')[0] || 'Wild One';
      if (emailEl) emailEl.textContent = currentUser.email || 'sin correo';
      if (usernameEl) usernameEl.textContent = '@' + (currentUser.user_metadata?.username || currentUser.email?.split('@')[0] || 'wildone');
    }

    async function checkDeletionRequest() {
      if (!supabaseClient || !currentUser) return;
      try {
        const { data } = await supabaseClient
          .from('account_deletion_requests')
          .select('*')
          .eq('user_id', currentUser.id)
          .order('requested_at', { ascending: false })
          .limit(1)
          .maybeSingle();
        if (data) {
          const card = document.getElementById('deletion-status-card');
          const statusEl = document.getElementById('deletion-status');
          const dateEl = document.getElementById('deletion-date');
          if (card) card.style.display = 'block';
          if (statusEl) {
            const statusMap: Record<string, string> = { pending: 'Pendiente de revisión', approved: 'Aprobada', rejected: 'Rechazada' };
            statusEl.textContent = statusMap[data.status] || data.status;
            statusEl.style.color = data.status === 'pending' ? 'var(--primary)' : data.status === 'approved' ? 'var(--event)' : 'var(--text-muted)';
          }
          if (dateEl) dateEl.textContent = new Date(data.requested_at).toLocaleDateString('es-MX', { year: 'numeric', month: 'long', day: 'numeric' });
        }
      } catch (e) { console.error('Check deletion error:', e); }
    }

    async function requestDeletion() {
      if (!supabaseClient || !currentUser) {
        showToast('Inicia sesión para continuar');
        return;
      }
      const reason = (document.getElementById('deletion-reason') as HTMLTextAreaElement)?.value || '';
      try {
        const { error } = await supabaseClient
          .from('account_deletion_requests')
          .insert({ user_id: currentUser.id, reason });
        if (error) throw error;
        document.getElementById('deletion-modal')!.style.display = 'none';
        showToast('Solicitude enviada al equipo de Wild Gvng');
        checkDeletionRequest();
      } catch (e) {
        console.error('Deletion request error:', e);
        showToast('Error al enviar solicitud');
      }
    }

    // ── INIT ──
    (async () => {
      const isLoggedIn = await initSupabase();
      const settings = await loadSettings();
      applySettings(settings);
      if (isLoggedIn) {
        loadUserInfo();
        checkDeletionRequest();
      }

      // Section navigation
      document.querySelectorAll('.cfg-nav-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.cfg-nav-btn').forEach(b => b.classList.remove('active'));
          document.querySelectorAll('.cfg-section').forEach(s => s.classList.remove('active'));
          btn.classList.add('active');
          const section = btn.getAttribute('data-section');
          document.querySelector(`.cfg-section[data-section="${section}"]`)?.classList.add('active');
        });
      });

      // Toggle switches — save to DB
      document.querySelectorAll('.cfg-toggle[data-setting]').forEach(toggle => {
        toggle.addEventListener('click', () => {
          toggle.classList.toggle('active');
          const key = toggle.getAttribute('data-setting')!;
          const value = toggle.classList.contains('active');
          saveSetting(key, value);
          // Apply theme immediately if it's the theme toggle
          if (key === 'animations') applySettings(userSettings);
        });
      });

      // Selects — save to DB
      document.querySelectorAll('.cfg-select[data-setting]').forEach(select => {
        select.addEventListener('change', () => {
          const key = select.getAttribute('data-setting')!;
          const value = (select as HTMLSelectElement).value;
          saveSetting(key, value);
          if (key === 'font_size') applySettings(userSettings);
        });
      });

      // Theme cards
      document.querySelectorAll('.cfg-theme-card').forEach(card => {
        card.addEventListener('click', () => {
          document.querySelectorAll('.cfg-theme-card').forEach(c => c.classList.remove('active'));
          card.classList.add('active');
          const theme = card.getAttribute('data-theme-choice')!;
          saveSetting('theme', theme);
          document.documentElement.classList.add('theme-transition');
          document.documentElement.setAttribute('data-theme', theme);
          localStorage.setItem('wg-theme', theme);
          setTimeout(() => document.documentElement.classList.remove('theme-transition'), 400);
        });
      });

      // Language buttons
      document.querySelectorAll('.cfg-lang-btn').forEach(btn => {
        btn.addEventListener('click', () => {
          document.querySelectorAll('.cfg-lang-btn').forEach(b => b.classList.remove('active'));
          btn.classList.add('active');
          const locale = btn.getAttribute('data-locale')!;
          saveSetting('locale', locale);
        });
      });

      // Deletion modal
      document.getElementById('cfg-request-deletion')?.addEventListener('click', () => {
        document.getElementById('deletion-modal')!.style.display = 'flex';
      });
      document.getElementById('deletion-cancel')?.addEventListener('click', () => {
        document.getElementById('deletion-modal')!.style.display = 'none';
      });
      document.getElementById('deletion-confirm')?.addEventListener('click', requestDeletion);

      // Close modal on overlay click
      document.getElementById('deletion-modal')?.addEventListener('click', (e) => {
        if (e.target === e.currentTarget) {
          (e.currentTarget as HTMLElement).style.display = 'none';
        }
      });
    })();
  </script>
</Layout>
