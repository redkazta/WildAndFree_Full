---
import Layout from '../layouts/Layout.astro';

const config = {
  name: "Wild Gvng - Wishlist",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
};
---

<Layout config={config}>
  <div class="wishlist-page">
    <div class="wishlist-hero">
      <div class="hero-content">
        <div class="hero-badge">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="text-[var(--primary)]"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
          <span class="badge-text">TUS FAVORITOS</span>
        </div>
        <h1 class="hero-title">
          <span class="title-main">WISHLIST</span>
        </h1>
        <p class="hero-subtitle">Productos que te han gustado</p>
      </div>
    </div>

    <div class="container">
      <div id="wishlist-grid" class="wishlist-grid">
        <div class="loading-state">
          <div class="spinner"></div>
          <p>Cargando tus favoritos...</p>
        </div>
      </div>

      <div id="wishlist-empty" class="empty-state hidden">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <h2 class="empty-title">Tu lista está vacía</h2>
        <p class="empty-sub">Explora la tienda y agrega productos que te gusten</p>
        <a href="/tienda" class="empty-cta">Ir a la Tienda</a>
      </div>

      <div id="wishlist-login-prompt" class="empty-state hidden">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
        <h2 class="empty-title">Inicia sesión</h2>
        <p class="empty-sub">Guarda tus productos favoritos y accede a ellos desde cualquier dispositivo</p>
        <a href="/login" class="empty-cta">Iniciar Sesión</a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .wishlist-page {
    min-height: 100vh;
    background: var(--bg);
  }
  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px 80px;
  }

  /* HERO */
  .wishlist-hero {
    padding: 60px 24px 40px;
    text-align: center;
    border-bottom: 1px solid var(--border-faint);
  }
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 6px 16px;
    border-radius: 100px;
    background: var(--bg-card);
    border: 1px solid var(--border-muted);
    margin-bottom: 16px;
  }
  .badge-text {
    font-size: 10px;
    font-weight: 900;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .hero-title {
    margin: 0;
  }
  .title-main {
    font-size: 3rem;
    font-weight: 900;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    color: var(--text);
    background: linear-gradient(135deg, var(--primary), var(--text));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .hero-subtitle {
    margin-top: 8px;
    font-size: 0.8rem;
    color: var(--text-muted);
    font-weight: 600;
  }

  /* GRID */
  .wishlist-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 20px;
    padding: 40px 0;
  }

  /* CARD */
  .wishlist-card {
    background: var(--bg-card);
    border: 1px solid var(--border-faint);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s ease;
    display: flex;
    flex-direction: column;
  }
  .wishlist-card:hover {
    border-color: var(--primary);
    box-shadow: 0 8px 30px rgba(201, 131, 0, 0.1);
    transform: translateY(-2px);
  }
  .card-image {
    aspect-ratio: 1;
    position: relative;
    overflow: hidden;
    background: var(--bg-card);
  }
  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }
  .wishlist-card:hover .card-image img {
    transform: scale(1.05);
  }
  .card-image .fallback {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
  }
  .card-info {
    padding: 16px;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .card-name {
    font-size: 0.85rem;
    font-weight: 800;
    color: var(--text);
    text-transform: uppercase;
    letter-spacing: 0.03em;
    line-height: 1.3;
    margin: 0;
  }
  .card-price {
    font-size: 1.1rem;
    font-weight: 900;
    color: var(--primary);
  }
  .card-actions {
    display: flex;
    gap: 8px;
    margin-top: auto;
    padding-top: 12px;
    border-top: 1px solid var(--border-faint);
  }
  .card-add {
    flex: 1;
    padding: 10px;
    border: none;
    border-radius: 10px;
    background: var(--primary);
    color: var(--bg);
    font-size: 0.6rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    cursor: pointer;
    transition: background 0.2s;
    font-family: inherit;
  }
  .card-add:hover {
    background: var(--primary-hover);
  }
  .card-add.added {
    background: #00c853;
  }
  .card-remove {
    width: 40px;
    height: 40px;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: transparent;
    color: var(--text-muted);
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s;
    flex-shrink: 0;
  }
  .card-remove:hover {
    border-color: #ff4444;
    color: #ff4444;
    background: rgba(255, 68, 68, 0.1);
  }

  /* STATES */
  .loading-state {
    grid-column: 1 / -1;
    text-align: center;
    padding: 80px 20px;
    color: var(--text-muted);
  }
  .spinner {
    width: 32px;
    height: 32px;
    border: 3px solid var(--bg-card);
    border-top-color: var(--primary);
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
    margin: 0 auto 16px;
  }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .empty-state {
    text-align: center;
    padding: 80px 20px;
  }
  .empty-state svg {
    margin-bottom: 16px;
  }
  .empty-title {
    font-size: 1.5rem;
    font-weight: 900;
    color: var(--text);
    text-transform: uppercase;
    margin: 0 0 8px;
  }
  .empty-sub {
    font-size: 0.85rem;
    color: var(--text-muted);
    margin: 0 0 24px;
  }
  .empty-cta {
    display: inline-block;
    padding: 14px 32px;
    background: var(--primary);
    color: var(--bg);
    font-size: 0.7rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    border-radius: 12px;
    text-decoration: none;
    transition: all 0.2s;
  }
  .empty-cta:hover {
    background: var(--primary-hover);
    transform: translateY(-2px);
  }

  @media (max-width: 768px) {
    .wishlist-hero { padding: 40px 16px 24px; }
    .title-main { font-size: 2rem; }
    .wishlist-grid { grid-template-columns: repeat(2, 1fr); gap: 12px; padding: 24px 0; }
    .card-info { padding: 12px; }
    .card-name { font-size: 0.75rem; }
    .card-price { font-size: 0.95rem; }
  }
  @media (max-width: 480px) {
    .wishlist-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  import { cartStore, CartEvents } from '../lib/cart.js';
  import { supabase } from '../lib/supabase.js';

  (function() {
    var grid = document.getElementById('wishlist-grid');
    var emptyEl = document.getElementById('wishlist-empty');
    var loginPrompt = document.getElementById('wishlist-login-prompt');

    function renderWishlist() {
      var items = cartStore.wishlist;
      var user = cartStore.user;

      // Show login prompt for guests with no items
      if (!user && items.length === 0) {
        grid.classList.add('hidden');
        emptyEl.classList.add('hidden');
        loginPrompt.classList.remove('hidden');
        return;
      }

      // Show empty state for logged-in users with no items, or guests with cleared items
      if (items.length === 0) {
        grid.classList.add('hidden');
        emptyEl.classList.remove('hidden');
        loginPrompt.classList.add('hidden');
        return;
      }

      // Show items
      grid.classList.remove('hidden');
      emptyEl.classList.add('hidden');
      loginPrompt.classList.add('hidden');
      grid.classList.remove('loading-state');

      grid.innerHTML = items.map(function(item) {
        var imgHtml = item.image
          ? '<img src="' + item.image + '" alt="' + (item.name || 'Producto') + '" loading="lazy" />'
          : '<div class="fallback"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg></div>';

        return '<div class="wishlist-card" data-id="' + item.id + '">' +
          '<a href="/tienda/' + (item.slug || item.id) + '" class="card-image">' + imgHtml + '</a>' +
          '<div class="card-info">' +
            '<a href="/tienda/' + (item.slug || item.id) + '" style="text-decoration:none;"><h3 class="card-name">' + (item.name || 'Producto') + '</h3></a>' +
            '<p class="card-price">$' + (Number(item.price) || 0).toFixed(2) + '</p>' +
            '<div class="card-actions">' +
              '<button class="card-add wishlist-add-cart" data-id="' + item.id + '">Agregar al Carrito</button>' +
              '<button class="card-remove wishlist-remove" data-id="' + item.id + '" title="Eliminar">' +
                '<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"></line><line x1="6" y1="6" x2="18" y2="18"></line></svg>' +
              '</button>' +
            '</div>' +
          '</div>' +
        '</div>';
      }).join('');

      // Event listeners
      grid.querySelectorAll('.wishlist-add-cart').forEach(function(btn) {
        btn.addEventListener('click', async function() {
          var id = this.dataset.id;
          var item = cartStore.wishlist.find(function(i) { return i.id == id; });
          if (!item) return;
          await cartStore.addToCart(item);
          this.textContent = '✓ Agregado';
          this.classList.add('added');
          setTimeout(function() {
            if (btn) { btn.textContent = 'Agregar al Carrito'; btn.classList.remove('added'); }
          }, 2000);
        });
      });

      grid.querySelectorAll('.wishlist-remove').forEach(function(btn) {
        btn.addEventListener('click', async function() {
          var id = this.dataset.id;
          await cartStore.toggleWishlist({ id: id });
          renderWishlist();
        });
      });
    }

    // Init
    (async function() {
      if (!cartStore.initialized) await cartStore.init();
      renderWishlist();
    })();

    window.addEventListener(CartEvents.WISHLIST_UPDATED, renderWishlist);
  })();
</script>
