---
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const events = [
    { 
      id: 'e1', 
      titulo: 'Wild Night CDMX', 
      fecha: '15 MAR 2024', 
      lugar: 'Foro Indie Rocks', 
      ciudad: 'CDMX',
      imagen: 'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=1200&q=80',
      descripcion: 'Una noche épica en el corazón de la CDMX. Nova K presenta su nuevo álbum "Sin Reglas" con invitados especiales del colectivo Wild Gvng. Beats pesados, líricas crudas y la energía inigualable del underground.',
      precio: '$450 - $950',
      artista: 'Nova K'
    },
    { 
      id: 'e2', 
      titulo: 'Urban Fest GDL', 
      fecha: '22 MAR 2024', 
      lugar: 'C3 Stage', 
      ciudad: 'Guadalajara',
      imagen: 'https://images.unsplash.com/photo-1459749411177-042180ce673c?auto=format&fit=crop&w=1200&q=80',
      descripcion: 'El festival urbano más importante de Guadalajara. Una jornada dedicada a la cultura callejera con los mejores exponentes del trap y drill nacional.',
      precio: 'Desde $350',
      artista: 'Nova K'
    },
    { 
      id: 'e3', 
      titulo: 'Beatmaker Sessions', 
      fecha: '10 ABR 2024', 
      lugar: 'Estudio 404', 
      ciudad: 'CDMX',
      imagen: 'https://images.unsplash.com/photo-1589578236639-5381345b6687?auto=format&fit=crop&w=1200&q=80',
      descripcion: 'Sesión intensiva de creación de ritmos. Sable muestra su proceso creativo desde el sampling hasta la mezcla final. Un evento imperdible para productores emergentes.',
      precio: 'Entrada Libre (Registro previo)',
      artista: 'Sable'
    }
  ];

  return events.map(event => ({
    params: { id: event.id },
    props: { event }
  }));
}

const { event } = Astro.props;

const config = {
  name: `Wild Gvng - ${event.titulo}`,
  primary_color: "#C98300",
  secondary_color: "#8A0303"
};
---

<Layout config={config}>
  <main class="min-h-screen bg-black pt-32 pb-20 px-6">
    <div class="max-w-4xl mx-auto space-y-12">
      <!-- Event Hero -->
      <div class="relative aspect-video rounded-[40px] overflow-hidden border border-white/10 shadow-2xl">
        <img src={event.imagen} class="w-full h-full object-cover" alt={event.titulo} />
        <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-8 md:p-12">
           <span class="inline-block px-4 py-1.5 rounded-full bg-orange-500 text-white text-[10px] font-black uppercase tracking-[0.3em] mb-4">
            {event.fecha}
          </span>
          <h1 class="text-4xl md:text-6xl font-black tracking-tighter text-white uppercase leading-tight">
            {event.titulo}
          </h1>
        </div>
      </div>

      <!-- Event Details -->
      <div class="grid md:grid-cols-3 gap-12">
        <div class="md:col-span-2 space-y-8">
          <div class="space-y-4">
            <h2 class="text-2xl font-black uppercase tracking-tighter text-white">Descripción del Evento</h2>
            <p class="text-lg text-white/60 font-bold leading-relaxed">
              {event.descripcion}
            </p>
          </div>
          
          <div class="p-8 rounded-3xl bg-white/[0.02] border border-white/5 space-y-4">
            <h3 class="text-sm font-black uppercase tracking-widest text-orange-500">Lineup</h3>
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-orange-500 flex items-center justify-center text-black font-black">W</div>
              <p class="text-xl font-black text-white uppercase">{event.artista} <span class="text-white/20 ml-2">+ Invitados Especiales</span></p>
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <div class="p-8 rounded-3xl bg-white/[0.03] border border-white/10 space-y-6">
            <div class="space-y-1">
              <p class="text-[10px] font-black uppercase tracking-widest text-white/40">Ubicación</p>
              <p class="text-xl font-black text-white uppercase">{event.lugar}</p>
              <p class="text-sm font-bold text-white/60">{event.ciudad}</p>
            </div>
            
            <div class="space-y-1">
              <p class="text-[10px] font-black uppercase tracking-widest text-white/40">Precio</p>
              <p class="text-2xl font-black text-orange-500">{event.precio}</p>
            </div>

            <button class="w-full py-5 bg-white text-black text-[10px] font-black uppercase tracking-[0.3em] rounded-2xl hover:bg-orange-500 hover:text-white transition-all transform hover:-translate-y-1 shadow-2xl shadow-white/5">
              Comprar Boletos
            </button>
          </div>
          
          <button class="w-full py-4 bg-white/5 border border-white/10 text-white text-[10px] font-black uppercase tracking-widest rounded-2xl hover:bg-white/10 transition-all">
            Añadir al Calendario
          </button>
        </div>
      </div>
    </div>
  </main>
</Layout>
