---
import Layout from '../../layouts/Layout.astro';
import tenantConfig from '../../../../../packages/shared-types/tenant-config.json';

export async function getStaticPaths() {
  const events = [
    { 
      id: 'e1', 
      titulo: 'Wild Night CDMX', 
      fecha: '15 MAR 2024', 
      lugar: 'Foro Indie Rocks', 
      ciudad: 'CDMX',
      imagen: 'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=1200&q=80',
      descripcion: 'Una noche épica en el corazón de la CDMX. Nova K presenta su nuevo álbum "Sin Reglas" con invitados especiales del colectivo Wild Gvng. Beats pesados, líricas crudas y la energía inigualable del underground.',
      precio: '$450 - $950',
      artista: 'Nova K'
    },
    { 
      id: 'e2', 
      titulo: 'Urban Fest GDL', 
      fecha: '22 MAR 2024', 
      lugar: 'C3 Stage', 
      ciudad: 'Guadalajara',
      imagen: 'https://images.unsplash.com/photo-1459749411177-042180ce673c?auto=format&fit=crop&w=1200&q=80',
      descripcion: 'El festival urbano más importante de Guadalajara. Una jornada dedicada a la cultura callejera con los mejores exponentes del trap y drill nacional.',
      precio: 'Desde $350',
      artista: 'Nova K'
    },
    { 
      id: 'e3', 
      titulo: 'Beatmaker Sessions', 
      fecha: '10 ABR 2024', 
      lugar: 'Estudio 404', 
      ciudad: 'CDMX',
      imagen: 'https://images.unsplash.com/photo-1589578236639-5381345b6687?auto=format&fit=crop&w=1200&q=80',
      descripcion: 'Sesión intensiva de creación de ritmos. Sable muestra su proceso creativo desde el sampling hasta la mezcla final. Un evento imperdible para productores emergentes.',
      precio: 'Entrada Libre (Registro previo)',
      artista: 'Sable'
    }
  ];

  return events.map(event => ({
    params: { id: event.id },
    props: { event }
  }));
}

const { event } = Astro.props;
const tenant = tenantConfig['wild-and-free'];

const config = {
  name: `Wild Gvng - ${event.titulo}`,
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};
---

<Layout config={config}>
  <div class="min-h-screen bg-[#050505] pb-20 px-6">
    <div class="max-w-4xl mx-auto space-y-12 animate-fade-in-up">
      <!-- Héroe del Evento -->
      <div class="relative aspect-video rounded-[40px] overflow-hidden border border-white/10 shadow-2xl">
        <img src={event.imagen} class="w-full h-full object-cover grayscale hover:grayscale-0 transition-all duration-500" alt={event.titulo} />
        <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
        <div class="absolute bottom-0 left-0 p-8 md:p-12">
           <span class="inline-block px-4 py-1.5 rounded-full bg-[var(--street-accent)] text-black text-[10px] font-black uppercase tracking-[0.3em] mb-4">
            {event.fecha}
          </span>
          <h1 class="text-4xl md:text-6xl font-black tracking-tighter text-white uppercase leading-tight" style="text-shadow: 2px 2px 0px black;">
            {event.titulo}
          </h1>
        </div>
      </div>

      <!-- Detalles del Evento -->
      <div class="grid md:grid-cols-3 gap-12">
        <div class="md:col-span-2 space-y-8">
          <div class="space-y-4">
            <h2 class="text-2xl font-black uppercase tracking-tighter text-white">Descripción del Evento</h2>
            <p class="text-lg text-white/80 font-bold leading-relaxed">
              {event.descripcion}
            </p>
          </div>
          
          <div class="p-8 rounded-3xl bg-white/[0.02] border border-white/5 space-y-4 hover:border-[var(--street-accent)] transition-colors duration-300">
            <h3 class="text-sm font-black uppercase tracking-widest text-[var(--street-accent)]">Alineación</h3>
            <div class="flex items-center gap-4">
              <div class="w-12 h-12 rounded-full bg-[var(--street-accent)] flex items-center justify-center text-black font-black shadow-[0_0_10px_var(--street-accent)]">W</div>
              <p class="text-xl font-black text-white uppercase">{event.artista} <span class="text-white/40 ml-2 font-mono text-sm">+ Invitados Especiales</span></p>
            </div>
          </div>
        </div>

        <div class="space-y-6">
          <div class="p-8 rounded-3xl bg-white/[0.03] border border-white/10 space-y-6 hover:shadow-[0_0_20px_rgba(255,255,255,0.05)] transition-shadow duration-300">
            <div class="space-y-1">
              <p class="text-[10px] font-black uppercase tracking-widest text-white/40">Ubicación</p>
              <p class="text-xl font-black text-white uppercase">{event.lugar}</p>
              <p class="text-sm font-bold text-white/60">{event.ciudad}</p>
            </div>
            
            <div class="space-y-1">
              <p class="text-[10px] font-black uppercase tracking-widest text-white/40">Precio</p>
              <p class="text-2xl font-black text-[var(--street-accent)]">{event.precio}</p>
            </div>

            <button class="w-full py-5 bg-white text-black text-[10px] font-black uppercase tracking-[0.3em] rounded-2xl hover:bg-[var(--street-accent)] hover:text-black transition-all transform hover:-translate-y-1 shadow-lg hover:shadow-[var(--street-accent)]/20">
              Comprar Boletos
            </button>
          </div>
          
          <button class="w-full py-4 bg-white/5 border border-white/10 text-white text-[10px] font-black uppercase tracking-widest rounded-2xl hover:bg-white/10 hover:text-[var(--street-accent)] hover:border-[var(--street-accent)] transition-all">
            Añadir al Calendario
          </button>
        </div>
      </div>
    </div>
  </div>
</Layout>

<style define:vars={{ streetAccent: tenant.primary_color }}>
  :root {
    --street-accent: var(--streetAccent);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
</style>
