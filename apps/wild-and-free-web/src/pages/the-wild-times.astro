---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - THE WILD TIMES",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};
---

<Layout config={config}>
  <div class="min-h-screen bg-[var(--bg)] text-[var(--text)] font-sans pb-20">

    <!-- MASTHEAD -->
    <header class="border-b-2 border-[var(--border)] py-6 px-4 md:px-8">
      <div class="max-w-[1400px] mx-auto">
        <div class="flex justify-between items-end border-b border-[var(--border)] pb-2 mb-2 text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--text-muted)]">
          <span>Vol. 1 — Edición Digital</span>
          <span>Torreón, Coahuila, MX</span>
          <span class="text-[var(--primary)]">GRATIS</span>
        </div>
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-black tracking-tighter uppercase leading-[0.85] text-[var(--text)]">
          THE WILD <span class="text-[var(--primary)]">TIMES</span>
        </h1>
        <div class="flex items-center gap-4 mt-2 border-t border-[var(--border)] pt-2">
          <span class="bg-[var(--primary)] text-[var(--bg)] px-3 py-0.5 text-[10px] font-black uppercase tracking-wider">Fanzine Oficial</span>
          <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--text-muted)]">Noticias · Cultura · Música · Calle</span>
        </div>
      </div>
    </header>

    <!-- MAIN LAYOUT: Left (25%) News + Right (75%) Feed -->
    <div class="max-w-[1400px] mx-auto px-4 md:px-8 py-8">
      <div class="flex flex-col lg:flex-row gap-8">

        <!-- LEFT: SIDEBAR NOTICIAS (solo announcements, 25%) -->
        <aside class="lg:w-[25%] flex-shrink-0" id="news-feed">
          <div class="sticky top-24 space-y-6">
            <div class="flex items-center justify-between border-b border-[var(--border)] pb-3">
              <h2 class="text-xs font-black uppercase tracking-[0.3em] text-[var(--text-muted)]">📰 Anuncios</h2>
              <span class="text-[8px] text-[var(--primary)] font-black" id="news-count"></span>
            </div>
            <div id="news-list" class="space-y-3">
              <p class="text-xs text-[var(--text-muted)] italic">Cargando...</p>
            </div>
          </div>
        </aside>

        <!-- RIGHT: FEED AREA (75%) -->
        <main class="lg:w-[75%]" id="feed-area">

          <!-- Featured Article (shown when clicking a news item) -->
          <div id="featured-article" class="hidden mb-10"></div>

          <!-- Feed Section -->
          <div id="crew-feed-section">
            <div class="flex items-center justify-between mb-6 border-b border-[var(--border)] pb-3">
              <h2 class="text-xs font-black uppercase tracking-[0.3em] text-[var(--text-muted)]">🎤 Feed de la Crew</h2>
              <div class="flex gap-2" id="feed-filters">
                <button class="filter-btn active px-3 py-1 text-[10px] font-black uppercase tracking-wider border border-[var(--primary)] bg-[var(--primary)] text-[var(--bg)] rounded-full" data-filter="all">Todo</button>
                <button class="filter-btn px-3 py-1 text-[10px] font-black uppercase tracking-wider border border-[var(--border)] text-[var(--text-secondary)] rounded-full hover:border-[var(--primary)] hover:text-[var(--primary)] transition-colors" data-filter="announcement">Anuncios</button>
                <button class="filter-btn px-3 py-1 text-[10px] font-black uppercase tracking-wider border border-[var(--border)] text-[var(--text-secondary)] rounded-full hover:border-[var(--primary)] hover:text-[var(--primary)] transition-colors" data-filter="event">Eventos</button>
                <button class="filter-btn px-3 py-1 text-[10px] font-black uppercase tracking-wider border border-[var(--border)] text-[var(--text-secondary)] rounded-full hover:border-[var(--primary)] hover:text-[var(--primary)] transition-colors" data-filter="general">General</button>
              </div>
            </div>
            <div id="posts-container" class="space-y-8">
              <p class="text-sm text-[var(--text-muted)] italic text-center py-12">Cargando feed...</p>
            </div>
          </div>

        </main>

      </div>
    </div>
  </div>
</Layout>

<script>
  import { loadNewsSidebar, loadCrewFeed, initFilters, initRealtime } from '../lib/wild-times-feed';

  initFilters();
  initRealtime();
  loadNewsSidebar();
  loadCrewFeed();
  document.addEventListener('astro:after-swap', () => {
    loadNewsSidebar();
    loadCrewFeed();
  });
</script>

<style is:global>
  /* ─── FILTERS ─── */
  .filter-btn.active {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--bg);
  }
  .filter-btn {
    transition: all 0.2s ease;
    font-family: inherit;
  }

  /* ─── SIDEBAR NEWS ITEMS ─── */
  .news-item {
    position: relative;
    overflow: hidden;
  }
  .news-item::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--primary) 0%, transparent 100%);
    opacity: 0;
    transition: opacity 0.3s ease;
    pointer-events: none;
  }
  .news-item:hover::after {
    opacity: 0.03;
  }
  .news-item-avatar {
    width: 36px; height: 36px; border-radius: 10px;
    background: linear-gradient(135deg, var(--primary), var(--primary-hover));
    color: #000;
    display: flex; align-items: center; justify-content: center;
    font-size: 10px; font-weight: 900; flex-shrink: 0;
    box-shadow: 0 2px 8px rgba(201, 131, 0, 0.2);
  }

  /* ─── FEATURED ARTICLE ─── */
  .featured-card {
    animation: slideDown 0.5s cubic-bezier(0.16, 1, 0.3, 1);
    position: relative;
  }
  .featured-card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(135deg, var(--primary) 0%, transparent 50%);
    opacity: 0.03;
    pointer-events: none;
    border-radius: inherit;
  }
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-30px) scale(0.98); }
    to { opacity: 1; transform: translateY(0) scale(1); }
  }
  .featured-img-wrap {
    width: 100%; max-height: 400px; overflow: hidden;
    position: relative;
  }
  .featured-img-wrap::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0; height: 60%;
    background: linear-gradient(transparent, var(--bg));
    pointer-events: none;
  }
  .featured-img {
    width: 100%; height: 100%; object-fit: cover;
    transition: transform 0.5s ease;
  }
  .featured-card:hover .featured-img {
    transform: scale(1.02);
  }
  .featured-body { padding: 32px 36px; }
  .featured-badge {
    display: inline-block; font-size: 9px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.12em;
    padding: 4px 16px; border-radius: 100px;
  }
  .featured-title {
    font-size: 2.2rem; font-weight: 900; text-transform: uppercase;
    line-height: 1.05; margin: 0 0 16px;
    letter-spacing: -0.02em;
  }
  .featured-author-row {
    display: flex; align-items: center; gap: 12px; margin-bottom: 24px;
    padding-bottom: 24px;
    border-bottom: 1px solid var(--border);
  }
  .featured-author-avatar {
    width: 42px; height: 42px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary), var(--primary-hover));
    color: #000; font-weight: 900;
    font-size: 13px; display: flex; align-items: center;
    justify-content: center; flex-shrink: 0;
    box-shadow: 0 2px 12px rgba(201, 131, 0, 0.3);
  }
  .featured-author-name { font-size: 14px; font-weight: 800; }
  .featured-author-role { font-size: 10px; color: var(--text-muted); }
  .featured-content {
    font-size: 15px; line-height: 2; color: var(--text-secondary);
    white-space: pre-wrap;
  }
  .featured-content::first-letter {
    font-size: 3em;
    font-weight: 900;
    color: var(--primary);
    float: left;
    line-height: 0.8;
    margin-right: 8px;
  }
  .featured-close {
    width: 36px; height: 36px; border-radius: 50%; border: none;
    background: var(--bg-card); color: var(--text); cursor: pointer;
    font-size: 15px; display: flex; align-items: center;
    justify-content: center; flex-shrink: 0; font-family: inherit;
    backdrop-filter: blur(8px);
    transition: all 0.2s ease;
  }
  .featured-close:hover {
    background: var(--bg-hover);
    transform: rotate(90deg);
  }

  /* ─── CREW FEED CARDS ─── */
  .feed-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s ease;
    position: relative;
  }
  .feed-card::before {
    content: '';
    position: absolute;
    top: 0; left: 0; right: 0; height: 3px;
    background: linear-gradient(90deg, var(--primary), var(--primary-hover), transparent);
    opacity: 0;
    transition: opacity 0.3s ease;
  }
  .feed-card:hover {
    border-color: var(--primary-border);
    transform: translateY(-2px);
    box-shadow: 0 8px 32px rgba(201, 131, 0, 0.08);
  }
  .feed-card:hover::before {
    opacity: 1;
  }
  .feed-card-header { padding: 20px 20px 0; }
  .feed-card-author { display: flex; align-items: center; gap: 12px; margin-bottom: 12px; }
  .feed-card-avatar {
    width: 42px; height: 42px; border-radius: 50%;
    background: linear-gradient(135deg, var(--primary-soft), var(--primary));
    color: #000;
    font-size: 12px; font-weight: 900; display: flex; align-items: center;
    justify-content: center; flex-shrink: 0; background-size: cover;
    background-position: center; border: 2px solid var(--primary);
    box-shadow: 0 2px 8px rgba(201, 131, 0, 0.15);
  }
  .author-name-link {
    color: inherit;
    text-decoration: none;
    transition: color 0.2s ease;
  }
  .author-name-link:hover {
    color: var(--primary);
  }
  .feed-card-name {
    font-size: 14px; font-weight: 800; line-height: 1.2;
    letter-spacing: -0.01em;
  }
  .feed-card-meta {
    display: flex; align-items: center; gap: 8px;
    font-size: 10px; color: var(--text-muted); margin-top: 2px;
  }
  .feed-card-type {
    padding: 2px 10px; border-radius: 100px;
    font-weight: 800; font-size: 8px;
    text-transform: uppercase; letter-spacing: 0.08em;
  }
  .feed-card-title {
    font-size: 1.15rem; font-weight: 900; text-transform: uppercase;
    margin: 0 0 10px; line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--text);
  }
  .feed-card-body { padding: 0 20px; }
  .feed-card-text {
    font-size: 14px; line-height: 1.8;
    color: var(--text-secondary);
    white-space: pre-wrap; margin: 0 0 14px;
  }
  .feed-img-wrap {
    border-radius: 12px;
    overflow: hidden;
    margin-bottom: 4px;
    position: relative;
  }
  .feed-img-wrap::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.1), transparent 30%);
    pointer-events: none;
  }
  .feed-img {
    width: 100%; max-height: 420px;
    object-fit: cover; display: block;
    transition: transform 0.4s ease;
  }
  .feed-card:hover .feed-img {
    transform: scale(1.03);
  }
  .feed-card-actions {
    display: flex; align-items: center; gap: 4px;
    padding: 14px 20px;
    border-top: 1px solid var(--border-faint);
    margin-top: 14px;
  }
  .action-btn {
    display: flex; align-items: center; gap: 6px;
    background: none; border: none; color: var(--text-muted);
    font-size: 12px; font-weight: 700; cursor: pointer;
    padding: 7px 12px; border-radius: 10px; font-family: inherit;
    transition: all 0.2s ease;
  }
  .action-btn:hover {
    background: var(--bg-hover);
    color: var(--text);
  }
  .action-btn:active {
    transform: scale(0.92);
  }
  .action-btn svg {
    transition: transform 0.2s ease;
  }
  .action-btn:hover svg {
    transform: scale(1.15);
  }
  .action-btn--active {
    color: var(--primary);
  }
  .action-btn--active svg {
    fill: currentColor;
  }

  /* ─── COMMENTS ─── */
  .comments-section {
    border-top: 1px solid var(--border-faint);
    padding: 16px 20px;
    background: rgba(0,0,0,0.02);
  }
  .comments-list {
    display: flex; flex-direction: column;
    gap: 12px; margin-bottom: 14px;
    max-height: 300px; overflow-y: auto;
  }
  .comment-item {
    display: flex; gap: 10px;
    padding: 8px 10px;
    border-radius: 10px;
    transition: background 0.2s;
  }
  .comment-item:hover {
    background: var(--bg-card);
  }
  .comment-avatar {
    width: 30px; height: 30px; border-radius: 50%; flex-shrink: 0;
    background: var(--primary-soft); color: var(--primary);
    font-size: 10px; font-weight: 900; display: flex;
    align-items: center; justify-content: center;
    background-size: cover; background-position: center;
    margin-top: 2px;
  }
  .comment-author {
    font-size: 11px; font-weight: 800; color: var(--text);
  }
  .comment-time {
    font-size: 9px; color: var(--text-muted); font-weight: 400;
    margin-left: 4px;
  }
  .comment-text {
    font-size: 12px; color: var(--text-secondary);
    margin-top: 2px; line-height: 1.5;
  }
  .comment-form-row {
    display: flex; gap: 8px;
  }
  .comment-input {
    flex: 1; padding: 10px 14px; border-radius: 10px;
    border: 1px solid var(--border-faint);
    background: var(--bg); color: var(--text);
    font-size: 12px; font-family: inherit; outline: none;
    transition: border-color 0.2s ease;
  }
  .comment-input:focus {
    border-color: var(--primary);
    box-shadow: 0 0 0 3px rgba(201, 131, 0, 0.1);
  }
  .comment-send {
    padding: 10px 18px; border-radius: 10px; border: none;
    background: linear-gradient(135deg, var(--primary), var(--primary-hover));
    color: #000; font-size: 10px;
    font-weight: 900; text-transform: uppercase;
    cursor: pointer; font-family: inherit;
    transition: all 0.2s ease;
    letter-spacing: 0.05em;
  }
  .comment-send:hover {
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(201, 131, 0, 0.3);
  }
  .comment-send:active {
    transform: scale(0.95);
  }

  /* ─── RICH CONTENT (linkify) ─── */
  .content-link {
    color: var(--primary);
    text-decoration: underline;
    word-break: break-word;
  }
  .content-embed {
    display: block;
    margin: 12px 0;
    border-radius: 12px;
    overflow: hidden;
  }
  .content-embed--video iframe {
    width: 100%;
    aspect-ratio: 16/9;
    border: 0;
    border-radius: 12px;
  }
  .content-embed-img {
    width: 100%;
    border-radius: 12px;
    display: block;
  }
  .content-embed--giphy {
    max-width: 480px;
  }

  /* ─── REACTIONS DIALOG (ojito, admin/staff) ─── */
  .reactions-dialog {
    border: none;
    border-radius: 20px;
    background: var(--bg-card);
    color: var(--text);
    width: min(520px, 92vw);
    max-width: 520px;
    max-height: 80vh;
    padding: 0;
    overflow: hidden;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.5);
  }
  .reactions-dialog::backdrop {
    background: rgba(0, 0, 0, 0.6);
    backdrop-filter: blur(2px);
  }
  .reactions-dialog-inner {
    display: flex;
    flex-direction: column;
    max-height: 80vh;
  }
  .reactions-dialog-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 20px;
    border-bottom: 1px solid var(--border);
  }
  .reactions-dialog-title {
    font-size: 13px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }
  .reactions-dialog-close {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    border: none;
    background: var(--bg-hover);
    color: var(--text);
    cursor: pointer;
    font-size: 14px;
    font-family: inherit;
    flex-shrink: 0;
    transition: all 0.2s ease;
  }
  .reactions-dialog-close:hover {
    background: var(--primary);
    color: #000;
    transform: rotate(90deg);
  }
  .reactions-tabs {
    display: flex;
    gap: 4px;
    padding: 10px 14px;
    border-bottom: 1px solid var(--border);
    background: rgba(0, 0, 0, 0.06);
  }
  .reactions-tab {
    flex: 1;
    padding: 8px 10px;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: transparent;
    color: var(--text-secondary);
    font-size: 11px;
    font-weight: 800;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s ease;
  }
  .reactions-tab.active {
    background: var(--primary);
    border-color: var(--primary);
    color: #000;
  }
  .reactions-body {
    overflow-y: auto;
    padding: 14px 16px;
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-height: 120px;
    max-height: 50vh;
  }
  .reactions-loading,
  .reactions-empty {
    color: var(--text-muted);
    font-size: 12px;
    font-style: italic;
    text-align: center;
    padding: 24px 0;
  }
  .reaction-user {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 10px;
    border-radius: 10px;
  }
  .reaction-user:hover {
    background: var(--bg-hover);
  }
  .reaction-user-avatar {
    width: 38px;
    height: 38px;
    border-radius: 50%;
    flex-shrink: 0;
    background: linear-gradient(135deg, var(--primary-soft), var(--primary));
    background-size: cover;
    background-position: center;
    color: #000;
    font-size: 11px;
    font-weight: 900;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .reaction-user-info {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }
  .reaction-user-name {
    color: var(--text);
    font-size: 13px;
    font-weight: 800;
    text-decoration: none;
  }
  .reaction-user-name:hover {
    color: var(--primary);
  }
  .reaction-user-meta {
    font-size: 10px;
    color: var(--text-muted);
  }
  .reaction-comment {
    margin: -4px 0 10px 60px;
    padding: 8px 12px;
    border-radius: 10px;
    background: var(--bg);
    border: 1px solid var(--border-faint);
    font-size: 12px;
    color: var(--text-secondary);
    line-height: 1.5;
  }
</style>