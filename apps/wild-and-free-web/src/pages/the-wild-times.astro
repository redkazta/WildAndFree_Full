---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - THE WILD TIMES",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};
---

<Layout config={config}>
  <div class="min-h-screen bg-[var(--bg)] text-[var(--text)] font-sans pb-20">

    <!-- MASTHEAD -->
    <header class="border-b-2 border-[var(--border)] py-6 px-4 md:px-8">
      <div class="max-w-[1400px] mx-auto">
        <div class="flex justify-between items-end border-b border-[var(--border)] pb-2 mb-2 text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--text-muted)]">
          <span>Vol. 1 — Edición Digital</span>
          <span>Torreón, Coahuila, MX</span>
          <span class="text-[var(--primary)]">GRATIS</span>
        </div>
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-black tracking-tighter uppercase leading-[0.85] text-[var(--text)]">
          THE WILD <span class="text-[var(--primary)]">TIMES</span>
        </h1>
        <div class="flex items-center gap-4 mt-2 border-t border-[var(--border)] pt-2">
          <span class="bg-[var(--primary)] text-[var(--bg)] px-3 py-0.5 text-[10px] font-black uppercase tracking-wider">Fanzine Oficial</span>
          <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--text-muted)]">Noticias · Cultura · Música · Calle</span>
        </div>
      </div>
    </header>

    <!-- MAIN LAYOUT: Left (25%) News + Right (75%) Feed -->
    <div class="max-w-[1400px] mx-auto px-4 md:px-8 py-8">
      <div class="flex flex-col lg:flex-row gap-8">

        <!-- LEFT: SIDEBAR NOTICIAS (solo announcements, 25%) -->
        <aside class="lg:w-[25%] flex-shrink-0" id="news-feed">
          <div class="sticky top-24 space-y-6">
            <div class="flex items-center justify-between border-b border-[var(--border)] pb-3">
              <h2 class="text-xs font-black uppercase tracking-[0.3em] text-[var(--text-muted)]">📰 Anuncios</h2>
              <span class="text-[8px] text-[var(--primary)] font-black" id="news-count"></span>
            </div>
            <div id="news-list" class="space-y-3">
              <p class="text-xs text-[var(--text-muted)] italic">Cargando...</p>
            </div>
          </div>
        </aside>

        <!-- RIGHT: FEED AREA (75%) -->
        <main class="lg:w-[75%]" id="feed-area">

          <!-- Featured Article (shown when clicking a news item) -->
          <div id="featured-article" class="hidden mb-10"></div>

          <!-- Feed Section -->
          <div id="crew-feed-section">
            <div class="flex items-center justify-between mb-6 border-b border-[var(--border)] pb-3">
              <h2 class="text-xs font-black uppercase tracking-[0.3em] text-[var(--text-muted)]">🎤 Feed de la Crew</h2>
              <div class="flex gap-2" id="feed-filters">
                <button class="filter-btn active px-3 py-1 text-[10px] font-black uppercase tracking-wider border border-[var(--primary)] bg-[var(--primary)] text-[var(--bg)] rounded-full" data-filter="all">Todo</button>
                <button class="filter-btn px-3 py-1 text-[10px] font-black uppercase tracking-wider border border-[var(--border)] text-[var(--text-secondary)] rounded-full hover:border-[var(--primary)] hover:text-[var(--primary)] transition-colors" data-filter="announcement">Anuncios</button>
                <button class="filter-btn px-3 py-1 text-[10px] font-black uppercase tracking-wider border border-[var(--border)] text-[var(--text-secondary)] rounded-full hover:border-[var(--primary)] hover:text-[var(--primary)] transition-colors" data-filter="event">Eventos</button>
                <button class="filter-btn px-3 py-1 text-[10px] font-black uppercase tracking-wider border border-[var(--border)] text-[var(--text-secondary)] rounded-full hover:border-[var(--primary)] hover:text-[var(--primary)] transition-colors" data-filter="general">General</button>
              </div>
            </div>
            <div id="posts-container" class="space-y-8">
              <p class="text-sm text-[var(--text-muted)] italic text-center py-12">Cargando feed...</p>
            </div>
          </div>

        </main>

      </div>
    </div>
  </div>
</Layout>

<script>
  import { loadNewsSidebar, loadCrewFeed, initFilters } from '../lib/wild-times-feed';

  initFilters();
  loadNewsSidebar();
  loadCrewFeed();
  document.addEventListener('astro:after-swap', () => {
    loadNewsSidebar();
    loadCrewFeed();
  });
</script>

<style>
  .filter-btn.active {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--bg);
  }

  /* ─── SIDEBAR NEWS ITEMS ─── */
  .news-item-avatar {
    width: 36px; height: 36px; border-radius: 10px;
    background: var(--primary-soft); color: var(--primary);
    display: flex; align-items: center; justify-content: center;
    font-size: 10px; font-weight: 900; flex-shrink: 0;
  }

  /* ─── FEATURED ARTICLE ─── */
  .featured-card { animation: slideDown 0.4s ease; }
  @keyframes slideDown {
    from { opacity: 0; transform: translateY(-20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .featured-img-wrap { width: 100%; max-height: 400px; overflow: hidden; }
  .featured-img { width: 100%; height: 100%; object-fit: cover; }
  .featured-body { padding: 32px; }
  .featured-badge {
    display: inline-block; font-size: 9px; font-weight: 800;
    text-transform: uppercase; letter-spacing: 0.1em;
    padding: 4px 14px; border-radius: 100px;
  }
  .featured-title {
    font-size: 2rem; font-weight: 900; text-transform: uppercase;
    line-height: 1.1; margin: 0 0 16px;
  }
  .featured-author-row {
    display: flex; align-items: center; gap: 12px; margin-bottom: 20px;
  }
  .featured-author-avatar {
    width: 40px; height: 40px; border-radius: 50%;
    background: var(--primary); color: #000; font-weight: 900;
    font-size: 12px; display: flex; align-items: center;
    justify-content: center; flex-shrink: 0;
  }
  .featured-author-name { font-size: 13px; font-weight: 800; }
  .featured-author-role { font-size: 10px; color: var(--text-muted); }
  .featured-divider { height: 1px; background: var(--border); margin-bottom: 20px; }
  .featured-content { font-size: 15px; line-height: 1.9; color: var(--text-secondary); white-space: pre-wrap; }
  .featured-close {
    width: 32px; height: 32px; border-radius: 50%; border: none;
    background: var(--bg-card); color: var(--text); cursor: pointer;
    font-size: 14px; display: flex; align-items: center;
    justify-content: center; flex-shrink: 0; font-family: inherit;
  }
  .featured-close:hover { background: var(--bg-hover); }

  /* ─── CREW FEED CARDS ─── */
  .feed-card {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: 16px; overflow: hidden;
    transition: border-color 0.2s;
  }
  .feed-card:hover { border-color: var(--primary-border); }
  .feed-card-header { padding: 20px 20px 0; }
  .feed-card-author { display: flex; align-items: center; gap: 10px; margin-bottom: 10px; }
  .feed-card-avatar {
    width: 38px; height: 38px; border-radius: 50%;
    background: var(--primary-soft); color: var(--primary);
    font-size: 11px; font-weight: 900; display: flex; align-items: center;
    justify-content: center; flex-shrink: 0; background-size: cover;
    background-position: center; border: 2px solid var(--primary);
  }
  .feed-card-name { font-size: 13px; font-weight: 800; line-height: 1.2; }
  .feed-card-meta { display: flex; align-items: center; gap: 6px; font-size: 9px; color: var(--text-muted); margin-top: 1px; }
  .feed-card-type { padding: 1px 8px; border-radius: 100px; font-weight: 800; font-size: 8px; text-transform: uppercase; letter-spacing: 0.05em; }
  .feed-card-title { font-size: 1.1rem; font-weight: 900; text-transform: uppercase; margin: 0 0 8px; line-height: 1.2; }
  .feed-card-body { padding: 0 20px; }
  .feed-card-text { font-size: 14px; line-height: 1.7; color: var(--text-secondary); white-space: pre-wrap; margin: 0 0 12px; }
  .feed-img-wrap { border-radius: 12px; overflow: hidden; margin-bottom: 4px; }
  .feed-img { width: 100%; max-height: 400px; object-fit: cover; display: block; }
  .feed-card-actions {
    display: flex; align-items: center; gap: 8px;
    padding: 12px 20px; border-top: 1px solid var(--border-faint);
    margin-top: 12px;
  }
  .action-btn {
    display: flex; align-items: center; gap: 4px;
    background: none; border: none; color: var(--text-muted);
    font-size: 11px; font-weight: 700; cursor: pointer;
    padding: 6px 10px; border-radius: 8px; font-family: inherit;
    transition: all 0.15s;
  }
  .action-btn:hover { background: var(--bg-hover); color: var(--text); }
  .action-btn--active { color: var(--primary); }
  .action-btn--active svg { fill: currentColor; }

  /* ─── COMMENTS ─── */
  .comments-section { border-top: 1px solid var(--border-faint); padding: 16px 20px; }
  .comments-list { display: flex; flex-direction: column; gap: 10px; margin-bottom: 12px; max-height: 250px; overflow-y: auto; }
  .comment-item { display: flex; gap: 8px; }
  .comment-avatar {
    width: 28px; height: 28px; border-radius: 50%; flex-shrink: 0;
    background: var(--bg); color: var(--primary); font-size: 9px;
    font-weight: 900; display: flex; align-items: center;
    justify-content: center; background-size: cover;
    background-position: center; margin-top: 2px;
  }
  .comment-author { font-size: 11px; font-weight: 800; color: var(--text); }
  .comment-time { font-size: 9px; color: var(--text-muted); font-weight: 400; }
  .comment-text { font-size: 12px; color: var(--text-secondary); margin-top: 1px; }
  .comment-form-row { display: flex; gap: 8px; }
  .comment-input {
    flex: 1; padding: 8px 12px; border-radius: 8px; border: 1px solid var(--border-faint);
    background: var(--bg); color: var(--text); font-size: 12px;
    font-family: inherit; outline: none;
  }
  .comment-input:focus { border-color: var(--primary); }
  .comment-send {
    padding: 8px 16px; border-radius: 8px; border: none;
    background: var(--primary); color: #000; font-size: 10px;
    font-weight: 900; text-transform: uppercase; cursor: pointer;
    font-family: inherit;
  }
  .comment-send:hover { background: var(--primary-hover); }
</style>
