---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - THE WILD TIMES",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};

import '../styles/wild-times-feed.css';
---

<Layout config={config}>
  <div class="min-h-screen bg-[var(--bg)] text-[var(--text)] font-sans pb-20">

    <!-- MASTHEAD -->
    <header class="border-b-2 border-[var(--border)] py-6 px-4 md:px-8">
      <div class="max-w-[1400px] mx-auto">
        <div class="flex justify-between items-end border-b border-[var(--border)] pb-2 mb-2 text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--text-muted)]">
          <span>Vol. 1 — Edición Digital</span>
          <span>Torreón, Coahuila, MX</span>
          <span class="text-[var(--primary)]">GRATIS</span>
        </div>
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-black tracking-tighter uppercase leading-[0.85] text-[var(--text)]">
          THE WILD <span class="text-[var(--primary)]">TIMES</span>
        </h1>
        <div class="flex items-center gap-4 mt-2 border-t border-[var(--border)] pt-2">
          <span class="bg-[var(--primary)] text-[var(--bg)] px-3 py-0.5 text-[10px] font-black uppercase tracking-wider">Fanzine Oficial</span>
          <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--text-muted)]">Noticias · Cultura · Música · Calle</span>
        </div>
      </div>
    </header>

    <!-- MAIN LAYOUT: Left (25%) News + Right (75%) Feed -->
    <div class="max-w-[1400px] mx-auto px-4 md:px-8 py-8">
      <div class="flex flex-col lg:flex-row gap-8">

        <!-- LEFT: SIDEBAR NOTICIAS (solo announcements, 25%) -->
        <aside class="lg:w-[25%] flex-shrink-0" id="news-feed">
          <div class="sticky top-24 space-y-6">
            <div class="flex items-center justify-between border-b border-[var(--border)] pb-3">
              <h2 class="text-xs font-black uppercase tracking-[0.3em] text-[var(--text-muted)]">📰 Anuncios</h2>
              <span class="text-[8px] text-[var(--primary)] font-black" id="news-count"></span>
            </div>
            <div id="news-list" class="space-y-3">
              <div class="sk sk-news"><div class="sk-fill sk-avatar sk-avatar--sm"></div><div class="sk-lines"><div class="sk-fill sk-line sk-line--news"></div><div class="sk-fill sk-line sk-line--news-sm"></div></div></div>
              <div class="sk sk-news"><div class="sk-fill sk-avatar sk-avatar--sm"></div><div class="sk-lines"><div class="sk-fill sk-line sk-line--news"></div><div class="sk-fill sk-line sk-line--news-sm"></div></div></div>
              <div class="sk sk-news"><div class="sk-fill sk-avatar sk-avatar--sm"></div><div class="sk-lines"><div class="sk-fill sk-line sk-line--news"></div><div class="sk-fill sk-line sk-line--news-sm"></div></div></div>
              <div class="sk sk-news"><div class="sk-fill sk-avatar sk-avatar--sm"></div><div class="sk-lines"><div class="sk-fill sk-line sk-line--news"></div><div class="sk-fill sk-line sk-line--news-sm"></div></div></div>
            </div>
          </div>
        </aside>

        <!-- RIGHT: FEED AREA (75%) -->
        <main class="lg:w-[75%]" id="feed-area">

          <!-- Featured Article (shown when clicking a news item) -->
          <div id="featured-article" class="hidden mb-10"></div>

          <!-- Feed Section -->
          <div id="crew-feed-section">
            <div class="flex items-center justify-between mb-6 border-b border-[var(--border)] pb-3">
              <h2 class="text-xs font-black uppercase tracking-[0.3em] text-[var(--text-muted)]">🎤 Feed de la Crew</h2>
              <div class="flex gap-2" id="feed-filters">
                <button class="filter-btn active px-3 py-1 text-[10px] font-black uppercase tracking-wider border border-[var(--primary)] bg-[var(--primary)] text-[var(--bg)] rounded-full" data-filter="all">Todo</button>
                <button class="filter-btn px-3 py-1 text-[10px] font-black uppercase tracking-wider border border-[var(--border)] text-[var(--text-secondary)] rounded-full hover:border-[var(--primary)] hover:text-[var(--primary)] transition-colors" data-filter="announcement">Anuncios</button>
                <button class="filter-btn px-3 py-1 text-[10px] font-black uppercase tracking-wider border border-[var(--border)] text-[var(--text-secondary)] rounded-full hover:border-[var(--primary)] hover:text-[var(--primary)] transition-colors" data-filter="event">Eventos</button>
                <button class="filter-btn px-3 py-1 text-[10px] font-black uppercase tracking-wider border border-[var(--border)] text-[var(--text-secondary)] rounded-full hover:border-[var(--primary)] hover:text-[var(--primary)] transition-colors" data-filter="general">General</button>
              </div>
            </div>
            <div id="posts-container" class="space-y-8">
              <div class="sk sk-feed"><div class="sk-feed-row"><div class="sk-fill sk-avatar"></div><div class="sk-lines"><div class="sk-fill sk-line sk-line--name"></div><div class="sk-fill sk-line sk-line--meta"></div></div></div><div class="sk-fill sk-line sk-line--title"></div><div class="sk-fill sk-line sk-line--lg"></div><div class="sk-fill sk-line sk-line--md"></div><div class="sk-fill sk-line sk-line--sm"></div><div class="sk-fill sk-block"></div><div class="sk-actions"><div class="sk-fill sk-chip"></div><div class="sk-fill sk-chip"></div><div class="sk-fill sk-chip sk-chip--w"></div><div class="sk-spacer"></div><div class="sk-fill sk-chip"></div></div></div>
            </div>
          </div>

        </main>

      </div>
    </div>
  </div>
</Layout>

<script>
  import { loadNewsSidebar, loadCrewFeed, initFilters, initRealtime, initFeedInteractions } from '../lib/wild-times-feed';

  initFilters();
  initRealtime();
  initFeedInteractions();
  loadNewsSidebar();
  loadCrewFeed();
  document.addEventListener('astro:after-swap', () => {
    loadNewsSidebar();
    loadCrewFeed();
  });
</script>

