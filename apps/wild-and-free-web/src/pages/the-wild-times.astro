---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - THE WILD TIMES",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};
---

<Layout config={config}>
  <div class="min-h-screen bg-[var(--bg)] text-[var(--text)] font-sans pb-20">

    <!-- MASTHEAD -->
    <header class="border-b-2 border-[var(--border)] py-6 px-4 md:px-8">
      <div class="max-w-[1400px] mx-auto">
        <div class="flex justify-between items-end border-b border-[var(--border)] pb-2 mb-2 text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--text-muted)]">
          <span>Vol. 1 — Edición Digital</span>
          <span>Torreón, Coahuila, MX</span>
          <span class="text-[var(--primary)]">GRATIS</span>
        </div>
        <h1 class="text-5xl md:text-7xl lg:text-8xl font-black tracking-tighter uppercase leading-[0.85] text-[var(--text)]">
          THE WILD <span class="text-[var(--primary)]">TIMES</span>
        </h1>
        <div class="flex items-center gap-4 mt-2 border-t border-[var(--border)] pt-2">
          <span class="bg-[var(--primary)] text-[var(--bg)] px-3 py-0.5 text-[10px] font-black uppercase tracking-wider">Fanzine Oficial</span>
          <span class="text-[10px] font-bold uppercase tracking-[0.2em] text-[var(--text-muted)]">Noticias · Cultura · Música · Calle</span>
        </div>
      </div>
    </header>

    <!-- MAIN LAYOUT: Left (25%) News Feed + Right (75%) Artist Feed -->
    <div class="max-w-[1400px] mx-auto px-4 md:px-8 py-8">
      <div class="flex flex-col lg:flex-row gap-8">

        <!-- LEFT: THE WILD TIMES News Feed (25%) -->
        <aside class="lg:w-[25%] flex-shrink-0" id="news-feed">
          <div class="sticky top-24 space-y-6">
            <h2 class="text-xs font-black uppercase tracking-[0.3em] text-[var(--text-muted)] border-b border-[var(--border)] pb-3">📰 Últimas Noticias</h2>
            <div id="news-list" class="space-y-4">
              <!-- Populated by JS -->
            </div>
          </div>
        </aside>

        <!-- RIGHT: Artist Feed (75%) -->
        <main class="lg:w-[75%]" id="artist-feed">
          <div class="flex items-center justify-between mb-6 border-b border-[var(--border)] pb-3">
            <h2 class="text-xs font-black uppercase tracking-[0.3em] text-[var(--text-muted)]">🎤 Feed de la Crew</h2>
            <div class="flex gap-2" id="feed-filters">
              <button class="filter-btn active px-3 py-1 text-[10px] font-black uppercase tracking-wider border border-[var(--primary)] bg-[var(--primary)] text-[var(--bg)] rounded-full" data-filter="all">Todo</button>
              <button class="filter-btn px-3 py-1 text-[10px] font-black uppercase tracking-wider border border-[var(--border)] text-[var(--text-secondary)] rounded-full hover:border-[var(--primary)] hover:text-[var(--primary)] transition-colors" data-filter="text">Textos</button>
              <button class="filter-btn px-3 py-1 text-[10px] font-black uppercase tracking-wider border border-[var(--border)] text-[var(--text-secondary)] rounded-full hover:border-[var(--primary)] hover:text-[var(--primary)] transition-colors" data-filter="photo">Fotos</button>
              <button class="filter-btn px-3 py-1 text-[10px] font-black uppercase tracking-wider border border-[var(--border)] text-[var(--text-secondary)] rounded-full hover:border-[var(--primary)] hover:text-[var(--primary)] transition-colors" data-filter="music">Música</button>
            </div>
          </div>
          <div id="posts-container" class="space-y-6">
            <!-- Populated by JS -->
          </div>
        </main>

      </div>
    </div>
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  // ============ NEWS FEED ============
  async function loadNewsFeed() {
    const container = document.getElementById('news-list');
    if (!container) return;

    try {
      const { data: posts, error } = await supabase
        .from('crew_posts')
        .select('*')
        .eq('status', 'published')
        .order('published_at', { ascending: false })
        .limit(8);

      if (error || !posts?.length) {
        container.innerHTML = '<p class="text-xs text-[var(--text-muted)] italic">Próximamente noticias de la crew.</p>';
        return;
      }

      container.innerHTML = posts.map((p: any) => `
        <article class="group border-l-2 border-[var(--border)] pl-4 hover:border-[var(--primary)] transition-colors">
          <span class="text-[9px] font-black uppercase tracking-wider text-[var(--primary)]">${p.post_type || 'Noticia'}</span>
          <h4 class="text-sm font-black uppercase leading-tight mt-1 group-hover:text-[var(--primary)] transition-colors cursor-pointer">${p.title || 'Sin título'}</h4>
          <p class="text-[11px] text-[var(--text-muted)] mt-1 line-clamp-2">${p.content?.slice(0, 100) || ''}</p>
          <time class="text-[9px] text-[var(--text-faint)] mt-2 block">${new Date(p.published_at).toLocaleDateString('es-MX')}</time>
        </article>
      `).join('');
    } catch (e) {
      container.innerHTML = '<p class="text-xs text-[var(--text-muted)] italic">Error al cargar noticias.</p>';
    }
  }

  // ============ ARTIST FEED ============
  let currentFilter = 'all';

  async function loadArtistFeed(filter = 'all') {
    currentFilter = filter;
    const container = document.getElementById('posts-container');
    if (!container) return;

    try {
      let query = supabase
        .from('artist_posts')
        .select('*, profiles:artist_id(nombre, username, avatar_url)')
        .order('created_at', { ascending: false })
        .limit(20);

      if (filter !== 'all') {
        query = query.eq('post_type', filter);
      }

      const { data: posts, error } = await query;

      if (error || !posts?.length) {
        container.innerHTML = '<p class="text-sm text-[var(--text-muted)] italic text-center py-12">No hay publicaciones aún.</p>';
        return;
      }

      container.innerHTML = posts.map((p: any) => renderPost(p)).join('');

      // Attach reaction handlers
      attachReactionHandlers();
    } catch (e) {
      container.innerHTML = '<p class="text-sm text-[var(--text-muted)] italic text-center py-12">Error al cargar feed.</p>';
    }
  }

  function renderPost(p: any) {
    const profile = p.profiles || {};
    const avatar = profile.avatar_url || '/wg_logo.png';
    const name = profile.nombre || profile.username || 'Artista WG';
    const timeAgo = getTimeAgo(new Date(p.created_at));

    let mediaHtml = '';
    if (p.post_type === 'photo' && p.image_url) {
      mediaHtml = `<img src="${p.image_url}" class="w-full rounded-lg mt-3 border border-[var(--border)]" loading="lazy" />`;
    } else if (p.post_type === 'music' && p.embed_url) {
      mediaHtml = `<iframe src="${p.embed_url}" width="100%" height="80" frameborder="0" allowfullscreen class="rounded-lg mt-3"></iframe>`;
    }

    return `
      <article class="bg-[var(--bg)] border border-[var(--border)] rounded-xl p-4 md:p-6 hover:border-[var(--primary-border)] transition-colors">
        <!-- Header -->
        <div class="flex items-center gap-3 mb-3">
          <img src="${avatar}" class="w-10 h-10 rounded-full object-cover border border-[var(--border)]" />
          <div>
            <h4 class="text-sm font-black uppercase tracking-wider text-[var(--text)]">${name}</h4>
            <span class="text-[10px] text-[var(--text-muted)]">${timeAgo}</span>
          </div>
          ${p.is_pinned ? '<span class="ml-auto text-[9px] font-black uppercase text-[var(--primary)] border border-[var(--primary)] px-2 py-0.5 rounded-full">📌 Fijado</span>' : ''}
        </div>

        <!-- Content -->
        <p class="text-sm text-[var(--text)] leading-relaxed whitespace-pre-wrap">${p.content || ''}</p>
        ${mediaHtml}

        <!-- Reactions Bar -->
        <div class="flex items-center gap-4 mt-4 pt-3 border-t border-[var(--border-faint)]">
          <button class="reaction-btn flex items-center gap-1.5 text-[11px] font-bold text-[var(--text-muted)] hover:text-[var(--primary)] transition-colors" data-post-id="${p.id}" data-action="like">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
            <span class="like-count">${p.likes_count || 0}</span>
          </button>
          <button class="reaction-btn flex items-center gap-1.5 text-[11px] font-bold text-[var(--text-muted)] hover:text-[var(--text)] transition-colors" data-post-id="${p.id}" data-action="comment">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
            <span class="comment-count">${p.comments_count || 0}</span>
          </button>
          <button class="reaction-btn flex items-center gap-1.5 text-[11px] font-bold text-[var(--text-muted)] hover:text-[var(--repost)] transition-colors" data-post-id="${p.id}" data-action="repost">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg>
            <span>${p.reposts_count || 0}</span>
          </button>
          <button class="reaction-btn flex items-center gap-1.5 text-[11px] font-bold text-[var(--text-muted)] hover:text-[var(--text)] transition-colors ml-auto" data-post-id="${p.id}" data-action="share">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          </button>
        </div>

        <!-- Comments Section (hidden by default) -->
        <div class="comments-section hidden mt-3 pt-3 border-t border-[var(--border-faint)]" data-post-id="${p.id}">
          <div class="comments-list space-y-2 mb-3"></div>
          <div class="flex gap-2">
            <input type="text" placeholder="Escribe un comentario..." class="comment-input flex-1 bg-[var(--bg-card)] border border-[var(--border)] rounded-lg px-3 py-2 text-xs text-[var(--text)] placeholder:text-[var(--text-muted)] outline-none focus:border-[var(--primary)]" />
            <button class="comment-submit px-3 py-2 bg-[var(--primary)] text-[var(--bg)] text-[10px] font-black uppercase rounded-lg hover:bg-[var(--primary-hover)] transition-colors">Enviar</button>
          </div>
        </div>
      </article>
    `;
  }

  function getTimeAgo(date: Date) {
    const seconds = Math.floor((Date.now() - date.getTime()) / 1000);
    if (seconds < 60) return 'Ahora';
    const minutes = Math.floor(seconds / 60);
    if (minutes < 60) return `Hace ${minutes}m`;
    const hours = Math.floor(minutes / 60);
    if (hours < 24) return `Hace ${hours}h`;
    const days = Math.floor(hours / 24);
    if (days < 7) return `Hace ${days}d`;
    return date.toLocaleDateString('es-MX');
  }

  // ============ REACTIONS ============
  function attachReactionHandlers() {
    document.querySelectorAll('.reaction-btn').forEach(btn => {
      btn.removeEventListener('click', handleReaction);
      btn.addEventListener('click', handleReaction);
    });

    document.querySelectorAll('.comment-submit').forEach(btn => {
      btn.removeEventListener('click', handleCommentSubmit);
      btn.addEventListener('click', handleCommentSubmit);
    });

    document.querySelectorAll('.filter-btn').forEach(btn => {
      btn.removeEventListener('click', handleFilter);
      btn.addEventListener('click', handleFilter);
    });
  }

  async function handleReaction(this: HTMLElement, e: Event) {
    e.preventDefault();
    const btn = this as HTMLElement;
    const postId = btn.dataset.postId;
    const action = btn.dataset.action;
    if (!postId || !action) return;

    // Check auth
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user) {
      alert('Inicia sesión para interactuar');
      return;
    }

    if (action === 'like') {
      await toggleLike(postId, session.user.id, btn);
    } else if (action === 'comment') {
      // Toggle comments section
      const postEl = btn.closest('article');
      const commentsSection = postEl?.querySelector('.comments-section') as HTMLElement;
      if (commentsSection) {
        commentsSection.classList.toggle('hidden');
        if (!commentsSection.classList.contains('hidden')) {
          loadComments(postId, commentsSection);
        }
      }
    } else if (action === 'repost') {
      await toggleRepost(postId, session.user.id, btn);
    } else if (action === 'share') {
      const url = `${window.location.origin}/wild-writings?post=${postId}`;
      await navigator.clipboard.writeText(url);
      btn.style.color = 'var(--primary)';
      setTimeout(() => btn.style.color = '', 1500);
    }
  }

  async function toggleLike(postId: string, userId: string, btn: HTMLElement) {
    try {
      const { data: existing } = await supabase
        .from('wall_likes')
        .select('id')
        .eq('post_id', postId)
        .eq('user_id', userId)
        .maybeSingle();

      if (existing) {
        await supabase.from('wall_likes').delete().eq('id', existing.id);
        btn.classList.remove('text-[var(--primary)]');
      } else {
        await supabase.from('wall_likes').insert({ post_id: postId, user_id: userId });
        btn.classList.add('text-[var(--primary)]');
      }
      // Refresh count
      await refreshLikeCount(postId, btn);
    } catch (e) {}
  }

  async function toggleRepost(postId: string, userId: string, btn: HTMLElement) {
    try {
      const { data: existing } = await supabase
        .from('wall_reposts')
        .select('id')
        .eq('post_id', postId)
        .eq('user_id', userId)
        .maybeSingle();

      if (existing) {
        await supabase.from('wall_reposts').delete().eq('id', existing.id);
        btn.classList.remove('text-[var(--repost)]');
      } else {
        await supabase.from('wall_reposts').insert({ post_id: postId, user_id: userId });
        btn.classList.add('text-[var(--repost)]');
      }
    } catch (e) {}
  }

  async function refreshLikeCount(postId: string, btn: HTMLElement) {
    try {
      const { count } = await supabase
        .from('wall_likes')
        .select('*', { count: 'exact', head: true })
        .eq('post_id', postId);
      const countEl = btn.querySelector('.like-count');
      if (countEl) countEl.textContent = String(count || 0);
    } catch (e) {}
  }

  async function loadComments(postId: string, section: HTMLElement) {
    const list = section.querySelector('.comments-list');
    if (!list) return;
    try {
      const { data: comments } = await supabase
        .from('wall_comments')
        .select('id, content, created_at, profiles:user_id(nombre, username, avatar_url)')
        .eq('post_id', postId)
        .is('deleted_at', null)
        .order('created_at', { ascending: true });

      if (!comments?.length) {
        list.innerHTML = '<p class="text-[10px] text-[var(--text-muted)] italic">Sin comentarios aún.</p>';
        return;
      }

      list.innerHTML = comments.map((c: any) => {
        const p = c.profiles || {};
        return `
          <div class="flex gap-2">
            <img src="${p.avatar_url || '/wg_logo.png'}" class="w-6 h-6 rounded-full object-cover flex-shrink-0 mt-0.5" />
            <div>
              <span class="text-[10px] font-black text-[var(--text)]">${p.nombre || p.username || 'Anónimo'}</span>
              <p class="text-[11px] text-[var(--text-secondary)]">${c.content}</p>
            </div>
          </div>
        `;
      }).join('');
    } catch (e) {
      list.innerHTML = '<p class="text-[10px] text-[var(--text-muted)] italic">Error al cargar comentarios.</p>';
    }
  }

  async function handleCommentSubmit(this: HTMLElement, e: Event) {
    const btn = this as HTMLElement;
    const section = btn.closest('.comments-section') as HTMLElement;
    const input = section?.querySelector('.comment-input') as HTMLInputElement;
    const postId = section?.dataset.postId;
    if (!input || !postId || !input.value.trim()) return;

    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user) {
      alert('Inicia sesión para comentar');
      return;
    }

    try {
      await supabase.from('wall_comments').insert({
        post_id: postId,
        user_id: session.user.id,
        content: input.value.trim()
      });
      input.value = '';
      loadComments(postId, section);
      
      // Update comment count
      const commentBtn = document.querySelector(`.reaction-btn[data-post-id="${postId}"][data-action="comment"] .comment-count`);
      if (commentBtn) {
        const val = parseInt(commentBtn.textContent || '0') + 1;
        commentBtn.textContent = String(val);
      }
    } catch (e) {}
  }

  function handleFilter(this: HTMLElement, e: Event) {
    document.querySelectorAll('.filter-btn').forEach(b => {
      b.classList.remove('active', 'bg-[var(--primary)]', 'text-[var(--bg)]');
      b.classList.add('text-[var(--text-secondary)]', 'border-[var(--border)]');
    });
    const btn = this as HTMLElement;
    btn.classList.add('active', 'bg-[var(--primary)]', 'text-[var(--bg)]');
    btn.classList.remove('text-[var(--text-secondary)]', 'border-[var(--border)]');
    loadArtistFeed(btn.dataset.filter || 'all');
  }

  // ============ INIT ============
  loadNewsFeed();
  loadArtistFeed();
  document.addEventListener('astro:after-swap', () => {
    loadNewsFeed();
    loadArtistFeed();
  });
</script>

<style>
  .filter-btn.active {
    border-color: var(--primary);
    background: var(--primary);
    color: var(--bg);
  }
  .reaction-btn.text-\[var\(--primary\)\] svg {
    fill: var(--primary);
  }
  .reaction-btn.text-\[var\(--repost\)\] svg {
    fill: var(--repost);
  }
</style>
