// If DB returns data, we might need to map it or merge with mock for "tracks" and "stats" if missing
const artists = (dbArtists && dbArtists.length > 0) ? dbArtists.map((a: any, i: number) => ({
    ...a,
    // Ensure missing fields have defaults
    stats: a.stats || mockArtists[i % mockArtists.length].stats,
    tracks: mockArtists[i % mockArtists.length].tracks,
    estilo: mockArtists[i % mockArtists.length].estilo,
    origen: mockArtists[i % mockArtists.length].origen
})) : mockArtists;

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Versus Mode",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};
---

<Layout config={config}>
  <div id="page-container" class="min-h-screen bg-neutral-950 text-white font-sans overflow-x-hidden relative selection:bg-wild-orange selection:text-black pb-48">
    
    <!-- ARCADE BACKGROUND -->
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20 pointer-events-none z-0"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black via-black/90 to-black pointer-events-none z-0"></div>
    
    <!-- TOP BAR -->
    <div class="relative z-50 bg-black/90 backdrop-blur-md border-b border-white/10 py-3">
        <div class="container mx-auto px-4 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-2 h-2 bg-[var(--primary)] animate-pulse rounded-full shadow-[0_0_10px_var(--primary)]"></div>
                <span class="text-label-sm font-black uppercase tracking-widest text-white arcade-font">VERSUS MODE // SYSTEM V2.0</span>
            </div>
            <div class="text-label-sm font-mono text-gray-500 font-bold uppercase hidden md:block">BATTLE ARENA ONLINE</div>
        </div>
    </div>

    <!-- MAIN ARENA CONTAINER -->
    <div class="relative z-10 container mx-auto px-4 py-8 flex flex-col items-center">
      
      <!-- HEADER & MODE SELECTOR -->
      <div class="text-center animate-fade-in-down mb-10 w-full max-w-4xl flex flex-col items-center gap-6">
          <h1 class="text-display-lg font-black italic uppercase tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-white via-tenant-primary to-white drop-shadow-[0_0_30px_rgba(255,255,255,0.2)] arcade-title">
              VERSUS
          </h1>
          
          <!-- MODE SELECTOR (Compact) -->
          <div class="flex flex-col md:flex-row items-center gap-4">
              <div class="flex gap-2 p-1 bg-white/5 rounded-full border border-white/10 backdrop-blur-sm shadow-wild-glow">
                  <button class="mode-btn px-6 py-2 rounded-full text-label-sm font-black uppercase tracking-widest transition-all hover:bg-white/10 text-gray-500 active" data-mode="1v1">1 VS 1</button>
                  <button class="mode-btn px-6 py-2 rounded-full text-label-sm font-black uppercase tracking-widest transition-all hover:bg-white/10 text-gray-500" data-mode="2v2">2 VS 2</button>
                  <button class="mode-btn px-6 py-2 rounded-full text-label-sm font-black uppercase tracking-widest transition-all hover:bg-white/10 text-gray-500" data-mode="3v3">3 VS 3</button>
              </div>
              
              <button id="auto-fill-btn" class="px-4 py-2 bg-tenant-primary/10 border border-tenant-primary/30 text-tenant-primary rounded-full text-label-sm font-black uppercase tracking-widest hover:bg-tenant-primary hover:text-black transition-all flex items-center gap-2 group">
                  <svg class="w-3 h-3 group-hover:rotate-180 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path></svg>
                  AUTO-FILL
              </button>
          </div>
      </div>

      <!-- BATTLE RING LAYOUT (SYMMETRICAL) -->
      <div class="w-full max-w-6xl grid grid-cols-1 md:grid-cols-3 gap-8 items-center justify-center relative">
          
          <!-- LEFT: TEAM ALPHA -->
          <div class="flex flex-col items-center gap-6 order-2 md:order-1">
              <div class="text-2xl font-black text-white/10 uppercase tracking-tighter italic border-b-2 border-[var(--primary)] px-8 pb-1 transform -skew-x-12">TEAM ALPHA</div>
              <div id="team-alpha-slots" class="flex flex-col gap-4">
                  <!-- Slots injected via JS -->
              </div>
          </div>

          <!-- CENTER: VS & ACTION -->
          <div class="flex flex-col items-center justify-center gap-8 order-1 md:order-2 py-10 relative">
              <!-- VS CIRCLE -->
              <div class="relative group cursor-default z-10">
                  <div class="absolute inset-0 bg-[var(--primary)] rounded-full blur-[50px] opacity-20 group-hover:opacity-40 transition-opacity animate-pulse"></div>
                  <div class="w-32 h-32 md:w-40 md:h-40 bg-black border-4 border-[var(--primary)] rounded-full flex items-center justify-center relative z-10 shadow-[0_0_30px_rgba(0,0,0,0.5)]">
                      <span class="text-6xl md:text-7xl font-black italic text-white tracking-tighter transform -rotate-12 drop-shadow-[4px_4px_0px_var(--primary)]">VS</span>
                  </div>
              </div>

              <!-- FIGHT BUTTON -->
              <button id="fight-btn" class="group relative px-12 py-4 bg-white text-black font-black uppercase tracking-[0.2em] italic rounded-wild-lg overflow-hidden transition-all hover:scale-105 active:scale-95 shadow-wild-glow hover:shadow-tenant-glow z-10">
                  <span class="relative z-10 text-xl">FIGHT!</span>
                  <div class="absolute inset-0 bg-gradient-to-r from-[var(--primary)] via-white to-[var(--primary)] opacity-0 group-hover:opacity-100 transition-opacity"></div>
              </button>

              <!-- INFO DISPLAY (BATTLE COMPUTER) -->
              <div id="center-info" class="w-full max-w-[200px] h-32 flex flex-col justify-center items-center text-center opacity-50 transition-opacity z-10">
                  <div class="flex flex-col items-center gap-2">
                      <svg class="w-6 h-6 text-white/20 animate-bounce" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 15l-2 5L9 9l11 4-5 2zm0 0l5 5M7.188 2.239l.777 2.897M5.136 7.965l-2.898-.777M13.95 4.05l-2.122 2.122m-5.657 5.656l-2.12 2.122"></path></svg>
                      <p class="text-label-sm font-mono uppercase tracking-widest text-gray-500">Selecciona un artista<br>para ver análisis</p>
                  </div>
              </div>
          </div>

          <!-- RIGHT: TEAM OMEGA -->
          <div class="flex flex-col items-center gap-6 order-3">
              <div class="text-2xl font-black text-white/10 uppercase tracking-tighter italic border-b-2 border-red-600 px-8 pb-1 transform skew-x-12">TEAM OMEGA</div>
              <div id="team-omega-slots" class="flex flex-col gap-4">
                  <!-- Slots injected via JS -->
              </div>
          </div>

      </div>

      <!-- BRACKETS SECTION (Moved down) -->
      <div class="mt-24 w-full max-w-5xl border-t border-white/5 pt-12">
          <div class="flex items-center justify-between mb-8">
              <h3 class="text-xl font-black uppercase tracking-widest text-white/40">Torneo Generado</h3>
              <button id="regenerate-brackets" class="text-label-sm font-bold text-tenant-primary uppercase tracking-widest hover:text-white transition-colors flex items-center gap-2">
                  <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                  Recalcular
              </button>
          </div>
          <div id="brackets-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4">
              <!-- Brackets injected via JS -->
          </div>
      </div>

      <!-- BATTLE OVERLAY (Hidden by default) -->
      <div id="battle-overlay" class="fixed inset-0 z-[200] bg-black/90 backdrop-blur-xl hidden flex-col items-center justify-center">
          <div class="relative w-full max-w-4xl h-[60vh] flex items-center justify-center">
              <!-- BACKGROUND FX -->
              <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20 animate-pulse"></div>
              
              <!-- CLASH ANIMATION CONTAINER -->
              <div id="clash-container" class="relative w-full h-full flex items-center justify-center overflow-hidden">
                  <div id="team-alpha-clash" class="absolute left-0 top-0 bottom-0 w-1/2 bg-gradient-to-r from-black to-[var(--primary)] transform -translate-x-full transition-transform duration-1000 flex items-center justify-end pr-10">
                      <h2 class="text-6xl md:text-9xl font-black italic text-white uppercase tracking-tighter mix-blend-overlay opacity-50">ALPHA</h2>
                  </div>
                  <div id="team-omega-clash" class="absolute right-0 top-0 bottom-0 w-1/2 bg-gradient-to-l from-black to-red-600 transform translate-x-full transition-transform duration-1000 flex items-center justify-start pl-10">
                      <h2 class="text-6xl md:text-9xl font-black italic text-white uppercase tracking-tighter mix-blend-overlay opacity-50">OMEGA</h2>
                  </div>
                  
                  <!-- VS FLASH -->
                  <div id="vs-flash" class="absolute z-10 text-9xl font-black text-white italic scale-0 transition-transform duration-300 drop-shadow-[0_0_50px_white]">VS</div>
              </div>

              <!-- WINNER REVEAL -->
              <div id="winner-reveal" class="absolute inset-0 flex flex-col items-center justify-center hidden">
                  <h3 class="text-2xl font-black text-[var(--primary)] uppercase tracking-[1em] mb-4 animate-fade-in-down">VICTORIA PARA</h3>
                  <h1 id="winner-name" class="text-6xl md:text-9xl font-black italic text-white uppercase tracking-tighter drop-shadow-[0_0_30px_var(--primary)] scale-150 animate-bounce-in">TEAM ALPHA</h1>
                  <button id="close-overlay" class="mt-12 px-8 py-3 bg-white text-black font-black uppercase tracking-widest hover:bg-[var(--primary)] transition-colors animate-fade-in-up">
                      VOLVER A LA ARENA
                  </button>
              </div>
          </div>
      </div>

    </div>

    <!-- ARTIST PICKER DOCK (Floating Bottom) -->
    <div id="artist-dock" class="fixed bottom-0 left-0 right-0 z-[100] bg-black/90 backdrop-blur-xl border-t border-white/10 p-4 transform transition-transform duration-500 shadow-[0_-20px_50px_rgba(0,0,0,0.5)]">
        <div class="container mx-auto">
            <div class="flex items-center justify-between mb-3 px-2">
                <div class="flex items-center gap-3">
                    <div class="w-1.5 h-1.5 bg-[var(--primary)] rounded-full animate-ping"></div>
                    <h3 class="text-label-sm font-black text-white uppercase tracking-[0.3em] arcade-font">Crew Disponible</h3>
                </div>
                <div class="flex items-center gap-4">
                    <span class="text-label-sm font-bold text-white/30 uppercase tracking-[0.2em] hidden md:block">Arrastra artistas a los slots de combate</span>
                    <button id="toggle-dock" class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center text-white/50 hover:text-white hover:bg-white/10 transition-all border border-white/10">
                        <svg id="dock-icon" class="w-4 h-4 transition-transform duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path></svg>
                    </button>
                </div>
            </div>
            
            <div id="dock-content" class="flex gap-4 overflow-x-auto pb-4 pt-2 px-2 custom-scrollbar mask-fade-edges justify-center md:justify-start">
                 {artists.map((artist: any) => (
                     <div 
                       class="artist-token flex-shrink-0 w-20 h-20 md:w-24 md:h-24 relative group cursor-grab active:cursor-grabbing border-2 border-white/5 hover:border-tenant-primary hover:scale-110 transition-all duration-300 overflow-hidden bg-[#111] rounded-wild-lg shadow-2xl"
                       draggable="true"
                       data-id={artist.id}
                       data-name={artist.nombre}
                       data-role={artist.estilo}
                       data-stats={JSON.stringify(artist.stats)}
                     >
                         <img src={artist.imagenes.profile} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" loading="lazy" width="96" height="96" />
                         <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end justify-center p-2">
                             <span class="text-[7px] font-black text-white uppercase text-center leading-none truncate w-full tracking-tighter">{artist.nombre}</span>
                         </div>
                         <div class="absolute top-1 right-1 w-2 h-2 bg-[var(--primary)] rounded-full opacity-0 group-hover:opacity-100 transition-opacity shadow-[0_0_10px_var(--primary)]"></div>
                     </div>
                 ))}
             </div>
        </div>
    </div>

  </div>
</Layout>

<!-- CLIENT SIDE LOGIC -->
<script is:inline define:vars={{ artists }}>
    const centerInfo = document.getElementById('center-info');

    // DOCK TOGGLE LOGIC
    const dock = document.getElementById('artist-dock');
    const toggleBtn = document.getElementById('toggle-dock');
    const dockIcon = document.getElementById('dock-icon');
    let isDockOpen = true;

    if (toggleBtn && dock) {
        toggleBtn.addEventListener('click', () => {
            isDockOpen = !isDockOpen;
            if (isDockOpen) {
                dock.style.transform = 'translateY(0)';
                dockIcon.style.transform = 'rotate(0)';
            } else {
                dock.style.transform = 'translateY(calc(100% - 50px))';
                dockIcon.style.transform = 'rotate(180deg)';
            }
        });
    }

    // DRAG & INFO LOGIC

    function showArtistInfo(name, role, stats) {
        if (!centerInfo) return;
        
        // Calculate percentages for bars
        const pwr = stats.power;
        const spd = stats.speed;
        const tec = stats.technique;
        
        centerInfo.innerHTML = `
            <div class="animate-fade-in-up w-full bg-black/80 backdrop-blur-md p-3 rounded-xl border border-white/10 shadow-2xl relative overflow-hidden">
                <div class="absolute inset-0 bg-[var(--primary)]/5"></div>
                
                <h4 class="text-sm font-black italic uppercase text-white tracking-tighter leading-none mb-1 truncate">${name}</h4>
                <p class="text-[8px] font-bold text-[var(--primary)] uppercase tracking-[0.2em] mb-2 truncate">${role}</p>
                
                <div class="flex flex-col gap-1 w-full">
                    <!-- POWER -->
                    <div class="flex items-center gap-1">
                        <span class="text-[6px] font-black text-gray-400 w-6">PWR</span>
                        <div class="flex-1 h-1 bg-white/10 rounded-full overflow-hidden">
                            <div class="h-full bg-gradient-to-r from-wild-orange to-red-600 w-0 animate-fill-bar" style="width: ${pwr}%"></div>
                        </div>
                        <span class="text-[6px] font-mono text-white">${pwr}</span>
                    </div>
                    
                    <!-- SPEED -->
                    <div class="flex items-center gap-1">
                        <span class="text-[6px] font-black text-gray-400 w-6">SPD</span>
                        <div class="flex-1 h-1 bg-white/10 rounded-full overflow-hidden">
                            <div class="h-full bg-gradient-to-r from-blue-400 to-cyan-500 w-0 animate-fill-bar" style="width: ${spd}%"></div>
                        </div>
                        <span class="text-[6px] font-mono text-white">${spd}</span>
                    </div>

                    <!-- TECH -->
                    <div class="flex items-center gap-1">
                        <span class="text-[6px] font-black text-gray-400 w-6">TEC</span>
                        <div class="flex-1 h-1 bg-white/10 rounded-full overflow-hidden">
                            <div class="h-full bg-gradient-to-r from-purple-500 to-pink-500 w-0 animate-fill-bar" style="width: ${tec}%"></div>
                        </div>
                        <span class="text-[6px] font-mono text-white">${tec}</span>
                    </div>
                </div>
            </div>
        `;
        centerInfo.classList.remove('opacity-50');
    }

    function initDragEvents() {
        const tokens = document.querySelectorAll('.artist-token');
        tokens.forEach(token => {
            token.addEventListener('dragstart', (e) => {
                const id = token.getAttribute('data-id');
                e.dataTransfer.setData('text/plain', id);
                e.dataTransfer.effectAllowed = 'copy';
                
                // Highlight empty slots
                document.querySelectorAll('.team-slot:not(.filled)').forEach(s => {
                    s.classList.add('border-[var(--primary)]/50', 'animate-pulse');
                });
            });

            token.addEventListener('dragend', () => {
                document.querySelectorAll('.team-slot').forEach(s => {
                    s.classList.remove('border-[var(--primary)]/50', 'animate-pulse');
                });
            });

            token.addEventListener('click', () => {
                const name = token.getAttribute('data-name');
                const role = token.getAttribute('data-role');
                const stats = JSON.parse(token.getAttribute('data-stats'));
                showArtistInfo(name, role, stats);
                
                // Visual feedback
                tokens.forEach(t => t.classList.remove('ring-2', 'ring-[var(--primary)]'));
                token.classList.add('ring-2', 'ring-[var(--primary)]');
            });
        });
    }

    initDragEvents();

    // TEAM SLOTS LOGIC
    function fillTeamSlot(slot, artistId) {
        // Check duplicate across all slots
        const isAlreadySelected = Array.from(document.querySelectorAll('.team-slot')).some(s => s.getAttribute('data-artist-id') == artistId);
        if (isAlreadySelected) return;

        const artist = window['artists'].find(a => a.id == artistId);
        if (!artist) return;

        const contentDiv = slot.querySelector('.slot-content');
        slot.querySelector('.placeholder-content').classList.add('hidden');
        contentDiv.classList.remove('hidden');
        
        // Use the same square size and style as the dock tokens
        contentDiv.innerHTML = `
            <div class="w-full h-full relative group overflow-hidden bg-zinc-900 animate-fade-in">
                <img src="${artist.imagenes.profile}" width="200" height="200" loading="lazy" decoding="async" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-500" />
                <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-80"></div>
                <div class="absolute bottom-0 left-0 right-0 p-1 text-center bg-black/60 backdrop-blur-sm">
                    <span class="text-[7px] font-black text-white uppercase tracking-tighter leading-none block truncate">${artist.nombre}</span>
                </div>
                <button class="remove-btn absolute top-1 right-1 w-4 h-4 bg-red-600 rounded-full text-white flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity hover:scale-110">
                    <svg class="w-2 h-2" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M6 18L18 6M6 6l12 12"></path></svg>
                </button>
            </div>
        `;
        
        slot.classList.add('filled', 'border-[var(--primary)]');
        slot.setAttribute('data-artist-id', artistId);

        // Remove listener
        const removeBtn = contentDiv.querySelector('.remove-btn');
        if (removeBtn) {
            removeBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                clearSlot(slot);
            });
        }
        
        // Show info on click
        slot.addEventListener('click', () => {
             showArtistInfo(artist.nombre, artist.estilo, artist.stats);
        });

        checkTeamStatus();
    }

    function clearSlot(slot) {
        slot.removeAttribute('data-artist-id');
        slot.classList.remove('filled', 'border-[var(--primary)]');
        slot.querySelector('.slot-content').innerHTML = '';
        slot.querySelector('.slot-content').classList.add('hidden');
        slot.querySelector('.placeholder-content').classList.remove('hidden');
        checkTeamStatus();
    }

    function checkTeamStatus() {
        const filledSlots = document.querySelectorAll('.team-slot[data-artist-id]').length;
        const totalNeeded = document.querySelectorAll('.team-slot').length;
        const fightBtn = document.getElementById('fight-btn');
        
        if (filledSlots === totalNeeded && totalNeeded > 0) {
            fightBtn.classList.remove('grayscale', 'pointer-events-none', 'opacity-50');
            fightBtn.classList.add('animate-pulse');
        } else {
            // fightBtn.classList.add('grayscale', 'pointer-events-none', 'opacity-50');
            // fightBtn.classList.remove('animate-pulse');
            // Optional: Disable fight button until full
        }
    }

    // MODE SELECTION
    const modeBtns = document.querySelectorAll('.mode-btn');
    modeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            modeBtns.forEach(b => {
                b.classList.remove('active', 'bg-[var(--primary)]', 'text-black');
                b.classList.add('text-gray-500');
            });
            btn.classList.add('active', 'bg-[var(--primary)]', 'text-black');
            btn.classList.remove('text-gray-500');
            
            const mode = btn.getAttribute('data-mode');
            initSlots(mode);
            generateBrackets(mode);
        });
    });

    function initSlots(mode = '1v1') {
        const containers = {
            alpha: document.getElementById('team-alpha-slots'),
            omega: document.getElementById('team-omega-slots')
        };
        if (!containers.alpha || !containers.omega) return;

        const count = mode === '3v3' ? 3 : mode === '2v2' ? 2 : 1;
        
        ['alpha', 'omega'].forEach(team => {
            containers[team].innerHTML = '';
            for (let i = 0; i < count; i++) {
                const slot = createSlotElement(i + 1, team);
                containers[team].appendChild(slot);
                setupSlotEvents(slot);
            }
        });
        checkTeamStatus();
    }

    function createSlotElement(index, team) {
        const slot = document.createElement('div');
        // Square slots matching dock token size: w-20 h-20 md:w-24 md:h-24
        slot.className = `team-slot group/slot relative w-20 h-20 md:w-24 md:h-24 bg-[#111]/50 border-2 border-white/10 rounded-wild-lg flex items-center justify-center cursor-pointer transition-all hover:border-tenant-primary/50 overflow-hidden`;
        slot.innerHTML = `
            <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-10 pointer-events-none"></div>
            <div class="absolute inset-0 border border-white/5 rounded-wild-lg pointer-events-none"></div>
            
            <!-- Holographic Corner Accents -->
            <div class="absolute top-0 left-0 w-2 h-2 border-t-2 border-l-2 border-white/20 rounded-tl-sm group-hover/slot:border-[var(--primary)] transition-colors"></div>
            <div class="absolute top-0 right-0 w-2 h-2 border-t-2 border-r-2 border-white/20 rounded-tr-sm group-hover/slot:border-[var(--primary)] transition-colors"></div>
            <div class="absolute bottom-0 left-0 w-2 h-2 border-b-2 border-l-2 border-white/20 rounded-bl-sm group-hover/slot:border-[var(--primary)] transition-colors"></div>
            <div class="absolute bottom-0 right-0 w-2 h-2 border-b-2 border-r-2 border-white/20 rounded-br-sm group-hover/slot:border-[var(--primary)] transition-colors"></div>

            <div class="flex flex-col items-center gap-1 opacity-50 group-hover/slot:opacity-100 transition-opacity placeholder-content">
                <svg class="w-4 h-4 text-white/30" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4v16m8-8H4"></path></svg>
                <span class="text-[6px] font-black text-white/30 uppercase tracking-widest pointer-events-none select-none">${team} ${index}</span>
            </div>
            
            <div class="slot-content absolute inset-0 hidden w-full h-full z-20"></div>
        `;
        return slot;
    }

    function setupSlotEvents(slot) {
        slot.addEventListener('dragover', (e) => e.preventDefault());
        slot.addEventListener('dragenter', () => slot.classList.add('bg-[var(--primary)]/10', 'border-[var(--primary)]/50'));
        slot.addEventListener('dragleave', () => slot.classList.remove('bg-[var(--primary)]/10', 'border-[var(--primary)]/50'));
        slot.addEventListener('drop', (e) => {
            e.preventDefault();
            slot.classList.remove('bg-[var(--primary)]/10', 'border-[var(--primary)]/50');
            const id = e.dataTransfer.getData('text/plain');
            if (id) fillTeamSlot(slot, id);
        });
    }

    // BRACKETS
    const bracketsContainer = document.getElementById('brackets-container');
    const regenerateBtn = document.getElementById('regenerate-brackets');

    function generateBrackets(mode = '1v1') {
        if (!bracketsContainer) return;
        bracketsContainer.innerHTML = '';
        const shuffled = [...artists].sort(() => 0.5 - Math.random());
        const participants = mode === '3v3' ? 3 : mode === '2v2' ? 2 : 1;
        
        for (let i = 0; i < 4; i++) {
            const tA = shuffled.slice(i * participants * 2, i * participants * 2 + participants);
            const tB = shuffled.slice(i * participants * 2 + participants, i * participants * 2 + participants * 2);
            if (tA.length === participants && tB.length === participants) {
                bracketsContainer.insertAdjacentHTML('beforeend', createMatchHtml(tA, tB, i + 1, mode));
            }
        }
    }

    function createMatchHtml(teamA, teamB, index, mode) {
        return `
            <div class="match-card bg-[#111]/40 border border-white/5 rounded-wild-lg overflow-hidden backdrop-blur-sm hover:border-tenant-primary/30 transition-all duration-500 animate-fade-in" style="animation-delay: ${index * 0.1}s">
                <div class="bg-white/5 px-3 py-1.5 flex justify-between items-center border-b border-white/5">
                    <span class="text-label-sm font-black text-tenant-primary tracking-widest uppercase">MATCH #${index}</span>
                    <span class="text-label-sm font-bold text-gray-500 uppercase">${mode}</span>
                </div>
                <div class="p-3 flex items-center justify-between gap-2 relative">
                    <div class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-4 h-4 bg-black rounded-full border border-white/10 flex items-center justify-center text-label-sm text-white font-bold z-10">VS</div>
                    
                    <!-- Team A -->
                    <div class="flex-1 flex flex-col items-center gap-1">
                        <div class="flex -space-x-2">
                             ${teamA.map(a => `<img src="${a.imagenes.profile}" width="24" height="24" class="w-6 h-6 rounded-full border border-black grayscale object-cover" />`).join('')}
                        </div>
                        <span class="text-label-sm font-bold text-gray-400 uppercase truncate max-w-[60px]">${teamA[0].nombre}</span>
                    </div>

                    <!-- Team B -->
                    <div class="flex-1 flex flex-col items-center gap-1">
                        <div class="flex -space-x-2">
                             ${teamB.map(a => `<img src="${a.imagenes.profile}" width="24" height="24" class="w-6 h-6 rounded-full border border-black grayscale object-cover" />`).join('')}
                        </div>
                        <span class="text-label-sm font-bold text-gray-400 uppercase truncate max-w-[60px]">${teamB[0].nombre}</span>
                    </div>
                </div>
            </div>
        `;
    }

    if (regenerateBtn) {
        regenerateBtn.addEventListener('click', () => {
            const activeMode = document.querySelector('.mode-btn.active')?.getAttribute('data-mode') || '1v1';
            generateBrackets(activeMode);
        });
    }

    // AUTO-FILL
    const autoFillBtn = document.getElementById('auto-fill-btn');
    if (autoFillBtn) {
        autoFillBtn.addEventListener('click', () => {
            const emptySlots = Array.from(document.querySelectorAll('.team-slot:not(.filled)'));
            if (emptySlots.length === 0) return;

            // Get available artist IDs (not already in a slot)
            const usedIds = Array.from(document.querySelectorAll('.team-slot[data-artist-id]'))
                                .map(s => parseInt(s.getAttribute('data-artist-id')));
            
            const availableArtists = artists.filter(a => !usedIds.includes(a.id));
            
            // Shuffle available
            const shuffled = availableArtists.sort(() => 0.5 - Math.random());
            
            emptySlots.forEach((slot, i) => {
                if (shuffled[i]) {
                    setTimeout(() => {
                        fillTeamSlot(slot, shuffled[i].id);
                    }, i * 100); // Stagger effect
                }
            });
        });
    }

    // FIGHT BUTTON
    const fightBtn = document.getElementById('fight-btn');
    const battleOverlay = document.getElementById('battle-overlay');
    const closeOverlayBtn = document.getElementById('close-overlay');
    const winnerName = document.getElementById('winner-name');
    const teamAlphaClash = document.getElementById('team-alpha-clash');
    const teamOmegaClash = document.getElementById('team-omega-clash');
    const vsFlash = document.getElementById('vs-flash');
    const winnerReveal = document.getElementById('winner-reveal');
    const clashContainer = document.getElementById('clash-container');

    fightBtn?.addEventListener('click', () => {
        const filledSlots = document.querySelectorAll('.team-slot[data-artist-id]').length;
        const totalNeeded = document.querySelectorAll('.team-slot').length;
        
        if (filledSlots < totalNeeded) {
            alert('¡Completa ambos equipos antes de la batalla!');
            return;
        }

        // START BATTLE SEQUENCE
        battleOverlay.classList.remove('hidden');
        battleOverlay.classList.add('flex');
        
        // Reset animations
        teamAlphaClash.style.transform = 'translateX(-100%)';
        teamOmegaClash.style.transform = 'translateX(100%)';
        vsFlash.classList.remove('scale-100');
        vsFlash.classList.add('scale-0');
        winnerReveal.classList.add('hidden');
        clashContainer.classList.remove('hidden');

        // 1. Clash In
        setTimeout(() => {
            teamAlphaClash.style.transform = 'translateX(0)';
            teamOmegaClash.style.transform = 'translateX(0)';
        }, 100);

        // 2. VS Flash
        setTimeout(() => {
            vsFlash.classList.remove('scale-0');
            vsFlash.classList.add('scale-150', 'rotate-12');
        }, 800);

        // 3. Reveal Winner
        setTimeout(() => {
            clashContainer.classList.add('hidden');
            winnerReveal.classList.remove('hidden');
            
            // Random Winner Logic
            const winner = Math.random() > 0.5 ? 'TEAM ALPHA' : 'TEAM OMEGA';
            winnerName.innerText = winner;
            winnerName.className = `text-6xl md:text-9xl font-black italic uppercase tracking-tighter drop-shadow-[0_0_30px_var(--primary)] scale-150 animate-bounce-in ${winner === 'TEAM ALPHA' ? 'text-[var(--primary)]' : 'text-red-600'}`;
            
        }, 2000);
    });

    closeOverlayBtn?.addEventListener('click', () => {
        battleOverlay.classList.add('hidden');
        battleOverlay.classList.remove('flex');
    });

    // Init
    generateBrackets('1v1');
    initSlots('1v1');

</script>

<style>
  /* UTILS */
  .mask-fade-edges {
    mask-image: linear-gradient(to right, transparent, black 5%, black 95%, transparent);
  }

  .custom-scrollbar::-webkit-scrollbar {
    height: 4px;
  }
  
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(255,255,255,0.05);
  }
  
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: var(--primary);
    border-radius: 10px;
  }

  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    10%, 30%, 50%, 70%, 90% { transform: translateX(-5px); }
    20%, 40%, 60%, 80% { transform: translateX(5px); }
  }

  .animate-shake {
    animation: shake 0.5s cubic-bezier(.36,.07,.19,.97) both;
  }
  
  .arcade-font {
    font-family: 'Courier New', Courier, monospace; /* Fallback if no custom font */
  }
</style>
