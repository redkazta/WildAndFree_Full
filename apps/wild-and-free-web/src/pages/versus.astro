---

<Layout config={config}>
  <div class="min-h-screen bg-[#0a0a0a] text-white font-sans overflow-hidden relative selection:bg-[var(--wild-orange)] selection:text-black">
    
    <!-- ARCADE BACKGROUND -->
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-30 pointer-events-none z-0"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black via-transparent to-black pointer-events-none z-0"></div>
    
    <!-- TOP BAR -->
    <div class="relative z-50 bg-black/90 backdrop-blur-md border-b border-white/10 py-3">
        <div class="container mx-auto px-4 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-3 h-3 bg-[var(--primary)] animate-pulse rounded-full shadow-[0_0_10px_var(--primary)]"></div>
                <span class="text-xs font-black uppercase tracking-[0.2em] text-white arcade-font">VERSUS MODE // CARD BATTLE</span>
            </div>
            <div class="text-xs font-mono text-gray-500 font-bold">FASE: SELECCIÓN DE MAZO</div>
        </div>
    </div>

    <!-- MAIN ARENA CONTAINER -->
    <div class="relative z-10 container mx-auto px-4 py-8 h-[calc(100vh-60px)] flex flex-col gap-6">
      
      <!-- HEADER -->
      <div class="text-center animate-fade-in-down mb-4">
          <h1 class="text-4xl md:text-7xl font-black italic uppercase tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 via-[var(--primary)] to-red-600 drop-shadow-[0_5px_5px_rgba(255,0,0,0.5)] arcade-title">
              VERSUS: CARD BATTLE
          </h1>
          <p class="text-[10px] md:text-xs font-bold text-gray-400 uppercase tracking-[0.5em] mt-2 animate-pulse">
              CONSTRUYE TU MAZO
          </p>
      </div>

      <!-- GAME LAYOUT: GRID + STAGE -->
      <div class="flex-1 flex flex-col lg:flex-row gap-8 overflow-hidden min-h-0">
          
          <!-- LEFT: CHARACTER SELECT GRID (Expanded width) -->
          <div class="w-full lg:w-5/12 flex flex-col h-full min-h-0">
              <div class="bg-black/80 border-4 border-[var(--primary)] p-4 rounded-xl backdrop-blur-sm shadow-[0_0_30px_rgba(201,131,0,0.2)] flex-1 flex flex-col min-h-0">
                  <div class="grid grid-cols-4 sm:grid-cols-5 gap-2 overflow-y-auto pr-2 custom-scrollbar content-start">
                      {artists.map((artist: any) => (
                          <div 
                              draggable="true"
                              data-id={artist.id}
                              class="artist-token aspect-square relative group cursor-pointer active:cursor-grabbing border-2 border-white/20 hover:border-[var(--primary)] hover:scale-105 hover:z-10 transition-all duration-150 overflow-hidden bg-zinc-800 rounded-md shadow-lg"
                          >
                              <img src={artist.imagenes.profile} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-300" loading="lazy" />
                              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end justify-center p-1">
                                  <span class="text-[8px] font-black text-white uppercase text-center leading-none truncate w-full">{artist.nombre}</span>
                              </div>
                              <!-- Selection Highlight -->
                              <div class="absolute inset-0 border-2 border-transparent group-hover:border-[var(--primary)] transition-colors"></div>
                          </div>
                      ))}
                  </div>
                  
                  <!-- TEAM SLOTS (Deck Style) -->
                  <div id="team-slots" class="mt-4 pt-4 border-t border-white/10 grid grid-cols-3 gap-2">
                      <div class="team-slot h-20 bg-white/5 border border-white/10 rounded-lg flex items-center justify-center text-[10px] text-gray-600 font-black uppercase transition-colors relative overflow-hidden cursor-pointer hover:bg-white/10" data-role="leader">
                          <span class="pointer-events-none z-10 text-center">CARTA<br>LÍDER</span>
                          <div class="slot-content absolute inset-0 w-full h-full hidden"></div>
                      </div>
                      <div class="team-slot h-20 bg-white/5 border border-white/10 rounded-lg flex items-center justify-center text-[10px] text-gray-600 font-black uppercase transition-colors relative overflow-hidden cursor-pointer hover:bg-white/10" data-role="support">
                          <span class="pointer-events-none z-10 text-center">CARTA<br>SOPORTE</span>
                          <div class="slot-content absolute inset-0 w-full h-full hidden"></div>
                      </div>
                      <div class="team-slot h-20 bg-white/5 border border-white/10 rounded-lg flex items-center justify-center text-[10px] text-gray-600 font-black uppercase transition-colors relative overflow-hidden cursor-pointer hover:bg-white/10" data-role="anchor">
                          <span class="pointer-events-none z-10 text-center">CARTA<br>ANCLA</span>
                          <div class="slot-content absolute inset-0 w-full h-full hidden"></div>
                      </div>
                  </div>
              </div>
          </div>

          <!-- CENTER: BATTLE ARENA (DROP ZONE) -->
          <div 
              id="battle-arena"
              class="w-full lg:w-7/12 relative bg-black/40 border-4 border-dashed border-white/10 rounded-xl flex items-center justify-center overflow-hidden group transition-all duration-300 backdrop-blur-md min-h-[400px] lg:min-h-0"
          >
              <!-- Placeholder State (NOW LIVE VIDEO) -->
              <div id="arena-placeholder" class="absolute inset-0 w-full h-full flex flex-col items-center justify-center bg-black transition-opacity duration-500 z-10 overflow-hidden">
                  <!-- Video Background (Simulated Live Feed) -->
                  <div class="absolute inset-0 opacity-40 mix-blend-screen pointer-events-none">
                       <!-- This would be an iframe or video tag for the live stream -->
                       <video autoplay loop muted playsinline class="w-full h-full object-cover grayscale contrast-125 brightness-75">
                           <source src="https://videos.pexels.com/video-files/3121459/3121459-hd_1920_1080_25fps.mp4" type="video/mp4">
                       </video>
                  </div>
                  
                  <div class="relative z-10 text-center p-8 backdrop-blur-sm bg-black/30 w-full h-full flex flex-col items-center justify-center border-4 border-dashed border-white/10 rounded-xl group-hover:border-[var(--primary)]/50 transition-colors">
                      <div class="flex items-center gap-2 mb-6 animate-pulse">
                          <div class="w-2 h-2 bg-red-500 rounded-full"></div>
                          <span class="text-[10px] font-black text-red-500 uppercase tracking-widest">LIVE FEED // ARENA CAM 1</span>
                      </div>
                      
                      <div class="text-6xl mb-4 animate-bounce text-white/80 drop-shadow-[0_0_10px_rgba(255,255,255,0.5)]">⇩</div>
                      <h3 class="text-3xl font-black uppercase text-white tracking-widest mb-2 glitch-text" data-text="ZONA DE CARTAS">ZONA DE CARTAS</h3>
                      <p class="text-xs font-mono text-gray-400 uppercase tracking-wider bg-black/50 px-2 py-1">Arrastra una carta para ver sus stats</p>
                  </div>
              </div>

              <!-- Active Artist State (Hidden by default) -->
              <div id="arena-content" class="hidden absolute inset-0 w-full h-full flex flex-col md:flex-row">
                  <!-- Dynamic Content Injected Here -->
              </div>
              
              <!-- CRT Scanline Effect -->
              <div class="absolute inset-0 bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.25)_50%),linear-gradient(90deg,rgba(255,0,0,0.06),rgba(0,255,0,0.02),rgba(0,0,255,0.06))] z-20 bg-[length:100%_2px,3px_100%] pointer-events-none"></div>
              
              <!-- Corner Decorations -->
              <div class="absolute top-0 left-0 w-8 h-8 border-t-4 border-l-4 border-[var(--primary)] rounded-tl-lg"></div>
              <div class="absolute top-0 right-0 w-8 h-8 border-t-4 border-r-4 border-[var(--primary)] rounded-tr-lg"></div>
              <div class="absolute bottom-0 left-0 w-8 h-8 border-b-4 border-l-4 border-[var(--primary)] rounded-bl-lg"></div>
              <div class="absolute bottom-0 right-0 w-8 h-8 border-b-4 border-r-4 border-[var(--primary)] rounded-br-lg"></div>
          </div>

      </div>
    </div>
  </div>
</Layout>

<!-- CLIENT SIDE LOGIC -->
<script define:vars={{ artists }}>
    const arena = document.getElementById('battle-arena');
    const placeholder = document.getElementById('arena-placeholder');
    const content = document.getElementById('arena-content');
    const tokens = document.querySelectorAll('.artist-token');
    const teamSlots = document.querySelectorAll('.team-slot');
    
    // Auto-select first artist on load for visual impact
    setTimeout(() => {
        // renderArtist(artists[0].id); // Optional: Auto-load
    }, 500);

    // DRAG EVENTS
    tokens.forEach(token => {
        token.addEventListener('dragstart', (e) => {
            const id = token.getAttribute('data-id');
            e.dataTransfer.setData('text/plain', id);
            e.dataTransfer.effectAllowed = 'copy';
            arena.classList.add('border-[var(--primary)]', 'bg-[var(--primary)]/10'); // Highlight arena
            
            // Highlight team slots
            teamSlots.forEach(s => {
                if (!s.querySelector('.slot-content').innerHTML) {
                     s.classList.add('border-dashed', 'border-white/50');
                }
            });
        });

        token.addEventListener('dragend', () => {
            arena.classList.remove('border-[var(--primary)]', 'bg-[var(--primary)]/10');
            
            // Remove highlight from team slots
            teamSlots.forEach(s => s.classList.remove('border-dashed', 'border-white/50'));
        });

        // Click support
        token.addEventListener('click', () => {
            const id = token.getAttribute('data-id');
            renderArtist(id);
            
            // Remove active class from all
            tokens.forEach(t => t.classList.remove('border-[var(--primary)]', 'scale-105', 'z-20', 'grayscale-0'));
            // Add to current
            token.classList.add('border-[var(--primary)]', 'scale-105', 'z-20', 'grayscale-0');
            token.classList.remove('border-white/20');
            token.querySelector('img').classList.remove('grayscale');
        });
    });

    // DROP ZONE EVENTS (MAIN ARENA)
    arena.addEventListener('dragover', (e) => {
        e.preventDefault();
        e.dataTransfer.dropEffect = 'copy';
    });

    arena.addEventListener('dragenter', () => {
        arena.classList.add('scale-[1.01]', 'border-white');
    });

    arena.addEventListener('dragleave', () => {
        arena.classList.remove('scale-[1.01]', 'border-white');
    });

    arena.addEventListener('drop', (e) => {
        e.preventDefault();
        arena.classList.remove('scale-[1.01]', 'border-white', 'border-[var(--primary)]', 'bg-[var(--primary)]/10');
        const id = e.dataTransfer.getData('text/plain');
        if (id) renderArtist(id);
    });

    // TEAM SLOTS LOGIC
    teamSlots.forEach(slot => {
        slot.addEventListener('dragover', (e) => {
            e.preventDefault();
            e.dataTransfer.dropEffect = 'copy';
        });

        slot.addEventListener('dragenter', () => {
            slot.classList.add('border-[var(--primary)]', 'bg-[var(--primary)]/20');
        });

        slot.addEventListener('dragleave', () => {
            slot.classList.remove('border-[var(--primary)]', 'bg-[var(--primary)]/20');
        });

        slot.addEventListener('drop', (e) => {
            e.preventDefault();
            slot.classList.remove('border-[var(--primary)]', 'bg-[var(--primary)]/20', 'border-dashed', 'border-white/50');
            const id = e.dataTransfer.getData('text/plain');
            if (id) fillTeamSlot(slot, id);
        });

        // Click to clear slot if filled
        slot.addEventListener('click', () => {
            const contentDiv = slot.querySelector('.slot-content');
            if (!contentDiv.classList.contains('hidden')) {
                // Clear slot
                contentDiv.innerHTML = '';
                contentDiv.classList.add('hidden');
                slot.querySelector('span').classList.remove('opacity-0');
                slot.classList.remove('border-[var(--primary)]');
                slot.removeAttribute('data-artist-id');
                checkTeamStatus();
            }
        });
    });

    function checkTeamStatus() {
        const filledSlots = document.querySelectorAll('.slot-content:not(.hidden)').length;
        const statusText = document.querySelector('.arcade-font');
        
        if (filledSlots === 3) {
            statusText.innerText = "MAZO LISTO // PRESIONA START";
            statusText.classList.add('text-[var(--primary)]', 'animate-pulse');
            statusText.classList.remove('text-white');
        } else {
            statusText.innerText = "VERSUS MODE // CARD BATTLE";
            statusText.classList.remove('text-[var(--primary)]', 'animate-pulse');
            statusText.classList.add('text-white');
        }
    }

    function fillTeamSlot(slot, artistId) {
        // Check if artist is already in another slot
        const isAlreadySelected = Array.from(teamSlots).some(s => s.getAttribute('data-artist-id') === artistId && s !== slot);
        if (isAlreadySelected) return;

        const artist = artists.find(a => a.id == artistId);
        if (!artist) return;

        const contentDiv = slot.querySelector('.slot-content');
        const label = slot.querySelector('span');
        
        // Hide label
        label.classList.add('opacity-0');

        // Show content
        contentDiv.classList.remove('hidden');
        contentDiv.innerHTML = `
            <img src="${artist.imagenes.profile}" class="w-full h-full object-cover grayscale group-hover/slot:grayscale-0 transition-all duration-300" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 to-transparent flex items-end justify-center pb-1 pointer-events-none">
                <span class="text-[8px] font-black text-white uppercase truncate px-1 w-full text-center leading-none drop-shadow-md">${artist.nombre}</span>
            </div>
            <div class="absolute top-0 right-0 p-1 pointer-events-none">
                <div class="w-1.5 h-1.5 rounded-full bg-[var(--primary)] animate-pulse shadow-[0_0_5px_var(--primary)]"></div>
            </div>
        `;
        
        slot.classList.add('border-[var(--primary)]');
        slot.setAttribute('data-artist-id', artistId);
        checkTeamStatus();
    }

    function renderArtist(id) {
        const artist = artists.find(a => a.id == id);
        if (!artist) return;

        // Hide Placeholder
        placeholder.style.display = 'none';
        content.classList.remove('hidden');
        
        // Construct HTML
        content.innerHTML = `
            <!-- BIG PORTRAIT (LEFT) -->
            <div class="w-full md:w-5/12 h-1/2 md:h-full relative overflow-hidden bg-black animate-slide-in-left border-r-4 border-[var(--primary)]/50 group-inner">
                <img src="${artist.imagenes.profile}" class="w-full h-full object-cover object-top opacity-90 contrast-125 transition-transform duration-[5s] hover:scale-110" />
                <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-transparent to-transparent"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                
                <!-- Character Name Plate -->
                <div class="absolute bottom-8 left-0 bg-gradient-to-r from-[var(--secondary)] to-transparent py-3 px-8 w-full transform -skew-x-12 -translate-x-4 border-t border-white/20 border-b border-white/20">
                    <h2 class="text-4xl md:text-5xl font-black text-white italic uppercase tracking-tighter leading-none drop-shadow-md transform skew-x-12 pl-4" style="text-shadow: 3px 3px 0px #000;">
                        ${artist.nombre}
                    </h2>
                    <p class="text-[10px] font-black uppercase tracking-[0.4em] text-white/80 transform skew-x-12 pl-4 mt-1">${artist.estilo} • ${artist.origen}</p>
                </div>
            </div>

            <!-- STATS & INFO (RIGHT) -->
            <div class="w-full md:w-7/12 h-1/2 md:h-full bg-zinc-900/95 p-6 md:p-8 flex flex-col justify-between animate-slide-in-right relative overflow-hidden">
                
                <!-- Background Element -->
                <div class="absolute top-0 right-0 text-[150px] font-black text-white/5 leading-none pointer-events-none select-none -translate-y-4 translate-x-4 overflow-hidden">VS</div>

                <div class="space-y-6 relative z-10">
                    <!-- Bio Section -->
                    <div class="border-l-4 border-[var(--primary)] pl-4 py-2 bg-white/5 rounded-r-lg backdrop-blur-sm">
                        <h4 class="text-[10px] font-black uppercase text-[var(--primary)] tracking-widest mb-1 flex items-center gap-2">
                            <span class="w-2 h-2 bg-[var(--primary)] rounded-full"></span>
                            Perfil de Carta
                        </h4>
                        <p class="text-gray-300 font-medium text-sm leading-relaxed line-clamp-3 italic">"${artist.bio}"</p>
                    </div>
                    
                    <!-- STAT BARS (Hexagon Mock via Bars) -->
                    <div class="space-y-3 pt-2">
                        <!-- Power -->
                        <div class="flex items-center gap-3 group/stat">
                            <span class="w-16 text-[10px] font-black text-red-500 uppercase tracking-wider group-hover/stat:scale-110 transition-transform">Poder</span>
                            <div class="flex-1 h-4 bg-black border border-white/20 skew-x-[-12deg] overflow-hidden relative">
                                <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/diagonal-stripes.png')] opacity-20"></div>
                                <div class="h-full bg-gradient-to-r from-red-900 via-red-600 to-red-400 w-0 animate-fill-bar" style="width: ${artist.stats.power || 80}%; animation-delay: 0.1s"></div>
                            </div>
                            <span class="text-[12px] font-black font-mono text-white w-8 text-right">${artist.stats.power || 80}</span>
                        </div>
                        <!-- Speed -->
                        <div class="flex items-center gap-3 group/stat">
                            <span class="w-16 text-[10px] font-black text-blue-400 uppercase tracking-wider group-hover/stat:scale-110 transition-transform">Velocidad</span>
                            <div class="flex-1 h-4 bg-black border border-white/20 skew-x-[-12deg] overflow-hidden relative">
                                <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/diagonal-stripes.png')] opacity-20"></div>
                                <div class="h-full bg-gradient-to-r from-blue-900 via-blue-600 to-cyan-400 w-0 animate-fill-bar" style="width: ${artist.stats.speed || 75}%; animation-delay: 0.2s"></div>
                            </div>
                            <span class="text-[12px] font-black font-mono text-white w-8 text-right">${artist.stats.speed || 75}</span>
                        </div>
                        <!-- Tech -->
                        <div class="flex items-center gap-3 group/stat">
                            <span class="w-16 text-[10px] font-black text-green-500 uppercase tracking-wider group-hover/stat:scale-110 transition-transform">Técnica</span>
                            <div class="flex-1 h-4 bg-black border border-white/20 skew-x-[-12deg] overflow-hidden relative">
                                <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/diagonal-stripes.png')] opacity-20"></div>
                                <div class="h-full bg-gradient-to-r from-green-900 via-green-600 to-lime-400 w-0 animate-fill-bar" style="width: ${artist.stats.technique || 85}%; animation-delay: 0.3s"></div>
                            </div>
                            <span class="text-[12px] font-black font-mono text-white w-8 text-right">${artist.stats.technique || 85}</span>
                        </div>
                    </div>
                </div>

                <!-- SPECIAL MOVES (TRACKS) -->
                <div class="mt-6 relative z-10 flex-1 overflow-y-auto custom-scrollbar pr-2 min-h-0">
                    <h3 class="text-xs font-black text-white uppercase mb-3 border-b border-white/20 pb-2 flex justify-between items-center bg-white/5 px-3 py-2 rounded">
                        <span class="text-[var(--primary)]">Habilidades</span>
                        <span class="text-[9px] text-gray-400 tracking-widest">SKILLS</span>
                    </h3>
                    <ul class="space-y-2">
                        ${(artist.tracks || ['Pista Desconocida 1', 'Pista Desconocida 2']).map((track, i) => `
                            <li class="flex items-center justify-between group cursor-pointer hover:bg-white/10 p-2 rounded transition-all border border-transparent hover:border-[var(--primary)]/30">
                                <div class="flex items-center gap-3">
                                    <span class="text-[var(--primary)] font-black font-mono text-[10px] w-28 text-right opacity-70 group-hover:opacity-100 transition-opacity">LVL ${[1, 2, 3, 5][i]}</span>
                                    <span class="text-white font-bold uppercase text-[10px] md:text-xs group-hover:text-[var(--primary)] transition-colors tracking-wide">${track}</span>
                                </div>
                                <span class="opacity-0 group-hover:opacity-100 text-[8px] text-red-500 font-black animate-pulse bg-red-900/20 px-2 py-0.5 rounded border border-red-500/50">ACTIVE</span>
                            </li>
                        `).join('')}
                    </ul>
                </div>

                <!-- ACTION BUTTON -->
                <div class="pt-6 relative z-10 mt-auto">
                    <a href="/artista/${artist.slug}" class="relative overflow-hidden block w-full py-4 bg-gradient-to-r from-[var(--primary)] to-yellow-600 hover:from-white hover:to-white text-black font-black text-xl uppercase tracking-[0.2em] text-center skew-x-[-12deg] shadow-[4px_4px_0px_rgba(255,255,255,0.2)] hover:translate-y-[-2px] hover:shadow-[6px_6px_0px_rgba(255,255,255,0.4)] transition-all group">
                        <span class="relative z-10 group-hover:text-black transition-colors">SELECCIONAR CARTA</span>
                        <div class="absolute inset-0 bg-white transform -translate-x-full group-hover:translate-x-0 transition-transform duration-300 skew-x-12"></div>
                    </a>
                </div>
            </div>
        `;
    }
</script>

<style>
