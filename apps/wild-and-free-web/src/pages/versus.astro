const mockFreestylerEstilos = [
  'Rap Eléctrico','Trap Oscuro','Freestyle','Luxury Rap','Synth Trap',
  'Speed Flow','Hardcore Rap','Hardcore Rap','Fast Flow','Dark R&B',
  'Trap Metal','Glitch Hop','Horrorcore','Boom Bap','Soul Trap',
  'Acid Rap','Reggaetón','Drill','Hardcore','Consciente'
