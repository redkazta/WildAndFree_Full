---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

// --- DATA FETCHING ---
let dbArtists = null;
try {
  const { data, error } = await supabase
    .from('artists')
    .select('*')
    .order('nombre');
  if (!error) dbArtists = data;
} catch (e) {
  console.warn('Could not fetch artists from Supabase during build.');
}

