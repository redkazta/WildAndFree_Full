// If DB returns data, we might need to map it or merge with mock for "tracks" and "stats" if missing
const artists = (dbArtists && dbArtists.length > 0) ? dbArtists.map((a: any, i: number) => ({
    ...a,
    // Ensure missing fields have defaults
    stats: a.stats || mockArtists[i % mockArtists.length].stats,
    tracks: mockArtists[i % mockArtists.length].tracks,
    estilo: mockArtists[i % mockArtists.length].estilo,
    origen: mockArtists[i % mockArtists.length].origen
})) : mockArtists;

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Versus Mode",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};
---

<Layout config={config}>
  <div id="page-container" class="min-h-screen bg-[#0a0a0a] text-white font-sans overflow-hidden relative selection:bg-[var(--wild-orange)] selection:text-black">
    
    <!-- ARCADE BACKGROUND -->
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-30 pointer-events-none z-0"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black via-transparent to-black pointer-events-none z-0"></div>
    
    <!-- TOP BAR -->
    <div class="relative z-50 bg-black/90 backdrop-blur-md border-b border-white/10 py-3">
        <div class="container mx-auto px-4 flex justify-between items-center">
            <div class="flex items-center gap-3">
                <div class="w-3 h-3 bg-[var(--primary)] animate-pulse rounded-full shadow-[0_0_10px_var(--primary)]"></div>
                <span class="text-xs font-black uppercase tracking-[0.2em] text-white arcade-font">VERSUS MODE // CARD BATTLE</span>
            </div>
            
            <div class="text-xs font-mono text-gray-500 font-bold uppercase">SISTEMA DE COMBATE V1.0</div>
        </div>
    </div>

    <!-- MAIN ARENA CONTAINER -->
    <div class="relative z-10 container mx-auto px-4 py-8 h-auto flex flex-col gap-6">
      
      <!-- HEADER -->
      <div class="text-center animate-fade-in-down mb-4">
          <h1 class="text-4xl md:text-7xl font-black italic uppercase tracking-tighter text-transparent bg-clip-text bg-gradient-to-r from-yellow-400 via-[var(--primary)] to-red-600 drop-shadow-[0_5px_5px_rgba(255,0,0,0.5)] arcade-title">
              VERSUS: CARD BATTLE
          </h1>
          <p class="text-[10px] md:text-xs font-bold text-gray-400 uppercase tracking-[0.5em] mt-2 animate-pulse">
              CONSTRUYE TU MAZO Y DOMINA EL ASFALTO
          </p>
      </div>

      <!-- GAME LAYOUT: GRID + STAGE -->
      <div class="flex flex-col gap-8">
          
          <!-- ARTIST PICKER GRID (Top Row) -->
          <div class="bg-black/40 border border-white/10 rounded-3xl p-6 backdrop-blur-sm relative overflow-hidden">
              <div class="flex items-center justify-between mb-4 px-2">
                  <div class="flex items-center gap-2">
                      <div class="w-1 h-4 bg-[var(--primary)]"></div>
                      <h3 class="text-xs font-black text-white uppercase tracking-widest">Crew Disponible</h3>
                  </div>
                  <span class="text-[8px] font-bold text-gray-500 uppercase tracking-widest">Arrastra o haz click</span>
              </div>
              
              <div class="grid grid-cols-5 sm:grid-cols-8 md:grid-cols-10 lg:grid-cols-12 gap-3 max-h-[250px] overflow-y-auto custom-scrollbar pr-2">
                   {artists.map((artist: any) => (
                       <div 
                         class="artist-token aspect-square relative group cursor-grab active:cursor-grabbing border border-white/10 hover:border-[var(--primary)] hover:scale-105 transition-all duration-150 overflow-hidden bg-zinc-800 rounded-md shadow-lg"
                         draggable="true"
                         data-id={artist.id}
                         data-name={artist.nombre}
                       >
                           <img src={artist.imagenes.profile} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-300" loading="lazy" />
                           <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end justify-center p-1">
                               <span class="text-[7px] font-black text-white uppercase text-center leading-none truncate w-full">{artist.nombre}</span>
                           </div>
                       </div>
                   ))}
               </div>
          </div>

          <!-- BATTLE STAGE (VERTICAL LAYOUT) -->
          <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 items-start">
              
              <!-- LEFT: ARTIST PREVIEW PANEL -->
              <div class="lg:col-span-4 flex flex-col gap-4">
                  <div id="artist-preview-panel" class="bg-black/60 border-2 border-white/5 rounded-3xl p-6 backdrop-blur-md min-h-[500px] flex flex-col items-center justify-center text-center relative overflow-hidden group">
                      <!-- Background Glow -->
                      <div class="absolute inset-0 bg-[var(--primary)]/5 opacity-0 group-hover:opacity-100 transition-opacity duration-700"></div>
                      
                      <div id="preview-empty-state" class="flex flex-col items-center gap-6">
                          <div class="w-24 h-24 rounded-full border-2 border-dashed border-white/10 flex items-center justify-center animate-pulse">
                              <svg class="w-10 h-10 text-white/10" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
                          </div>
                          <div>
                              <h4 class="text-xl font-black text-white/30 uppercase italic tracking-tighter">Selecciona un Artista</h4>
                              <p class="text-[10px] text-white/10 uppercase tracking-[0.3em] mt-2">Haz click en la crew para ver detalles</p>
                          </div>
                      </div>

                      <div id="preview-content" class="hidden w-full h-full flex flex-col gap-6 animate-fade-in">
                          <div class="w-full aspect-[3/4] rounded-2xl overflow-hidden border-4 border-white/10 relative shadow-2xl">
                              <img id="preview-img" src="" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700" />
                              <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                              <div class="absolute bottom-6 left-6 text-left">
                                  <h4 id="preview-name" class="text-4xl font-black italic text-white uppercase tracking-tighter leading-none drop-shadow-2xl">---</h4>
                                  <span id="preview-role" class="text-xs font-bold text-[var(--primary)] uppercase tracking-[0.3em]">---</span>
                              </div>
                          </div>

                          <div class="space-y-4 text-left">
                              <div>
                                  <h5 class="text-[10px] font-black text-gray-500 uppercase tracking-[0.4em] mb-2 border-b border-white/5 pb-2">Habilidades Especiales</h5>
                                  <div id="preview-tracks" class="flex flex-wrap gap-2">
                                      <!-- Tracks will be injected here -->
                                  </div>
                              </div>
                              
                              <div class="grid grid-cols-3 gap-2">
                                  <div class="bg-white/5 p-2 rounded-lg border border-white/5">
                                      <span class="block text-[8px] font-black text-gray-500 uppercase">Power</span>
                                      <span id="stat-power" class="text-lg font-black text-white italic">00</span>
                                  </div>
                                  <div class="bg-white/5 p-2 rounded-lg border border-white/5">
                                      <span class="block text-[8px] font-black text-gray-500 uppercase">Speed</span>
                                      <span id="stat-speed" class="text-lg font-black text-white italic">00</span>
                                  </div>
                                  <div class="bg-white/5 p-2 rounded-lg border border-white/5">
                                      <span class="block text-[8px] font-black text-gray-500 uppercase">Tech</span>
                                      <span id="stat-tech" class="text-lg font-black text-white italic">00</span>
                                  </div>
                              </div>
                          </div>
                      </div>
                  </div>
              </div>

              <!-- CENTER: VERTICAL BATTLE SLOTS -->
              <div class="lg:col-span-8 flex flex-col items-center justify-center py-10 bg-black/40 border-x border-white/5 rounded-3xl relative">
                  
                  <div class="flex items-center gap-12 md:gap-24 relative">
                      <!-- TEAM ALPHA (Left) -->
                      <div class="flex items-center gap-4">
                          <div class="vertical-text text-xl md:text-4xl font-black text-white/10 uppercase tracking-tighter leading-none select-none team-name-label" data-team="alpha">ALPHA</div>
                          <div id="team-alpha-slots" class="flex flex-col gap-4">
                              <!-- Slots will be injected here -->
                          </div>
                      </div>

                      <!-- VS MIDDLE -->
                      <div class="flex flex-col items-center gap-4">
                          <div class="w-px h-20 bg-gradient-to-b from-transparent via-[var(--primary)] to-transparent opacity-30"></div>
                          <div class="w-16 h-16 bg-[var(--primary)] text-black rounded-full flex items-center justify-center font-black text-2xl italic shadow-[0_0_30px_var(--primary)] border-4 border-black z-10 animate-pulse">VS</div>
                          <div class="w-px h-20 bg-gradient-to-b from-transparent via-[var(--primary)] to-transparent opacity-30"></div>
                      </div>

                      <!-- TEAM OMEGA (Right) -->
                      <div class="flex items-center gap-4">
                          <div id="team-omega-slots" class="flex flex-col gap-4">
                              <!-- Slots will be injected here -->
                          </div>
                          <div class="vertical-text text-xl md:text-4xl font-black text-white/10 uppercase tracking-tighter leading-none select-none team-name-label" data-team="omega">OMEGA</div>
                      </div>
                  </div>

                  <!-- MODE SELECTOR (Moved Down & Bigger) -->
                  <div class="mt-16 w-full max-w-2xl px-8">
                      <div class="text-center mb-6">
                          <span class="text-xs font-black text-[var(--primary)] uppercase tracking-[0.3em] animate-pulse">1.- Selecciona tu modo de juego</span>
                      </div>
                      <div class="grid grid-cols-3 gap-4">
                          <button class="mode-btn group relative py-6 rounded-2xl overflow-hidden border-2 border-white/10 transition-all hover:border-[var(--primary)]/50 active" data-mode="3v3">
                              <div class="absolute inset-0 bg-gradient-to-br from-[var(--primary)] to-yellow-600 opacity-0 group-[.active]:opacity-100 transition-opacity"></div>
                              <div class="relative z-10 flex flex-col items-center">
                                  <span class="text-2xl font-black italic text-white group-[.active]:text-black transition-colors">3 VS 3</span>
                                  <span class="text-[8px] font-bold text-gray-500 group-[.active]:text-black/60 uppercase tracking-widest mt-1">TRIO BATTLE</span>
                              </div>
                          </button>
                          <button class="mode-btn group relative py-6 rounded-2xl overflow-hidden border-2 border-white/10 transition-all hover:border-[var(--primary)]/50" data-mode="2v2">
                              <div class="absolute inset-0 bg-gradient-to-br from-[var(--primary)] to-yellow-600 opacity-0 group-[.active]:opacity-100 transition-opacity"></div>
                              <div class="relative z-10 flex flex-col items-center">
                                  <span class="text-2xl font-black italic text-white group-[.active]:text-black transition-colors">2 VS 2</span>
                                  <span class="text-[8px] font-bold text-gray-500 group-[.active]:text-black/60 uppercase tracking-widest mt-1">DUO BATTLE</span>
                              </div>
                          </button>
                          <button class="mode-btn group relative py-6 rounded-2xl overflow-hidden border-2 border-white/10 transition-all hover:border-[var(--primary)]/50" data-mode="1v1">
                              <div class="absolute inset-0 bg-gradient-to-br from-[var(--primary)] to-yellow-600 opacity-0 group-[.active]:opacity-100 transition-opacity"></div>
                              <div class="relative z-10 flex flex-col items-center">
                                  <span class="text-2xl font-black italic text-white group-[.active]:text-black transition-colors">1 VS 1</span>
                                  <span class="text-[8px] font-bold text-gray-500 group-[.active]:text-black/60 uppercase tracking-widest mt-1">SOLO DUEL</span>
                              </div>
                          </button>
                      </div>
                  </div>
              </div>
      </div>

      <!-- NEW SECTION: BATTLE LOGIC & BRACKETS -->
      <div class="relative z-10 mt-12 mb-20 animate-fade-in-up">
          <div class="flex items-center justify-between mb-8 border-b border-white/10 pb-4">
              <div>
                  <h2 class="text-3xl font-black uppercase italic tracking-tighter text-white">Próximos Enfrentamientos</h2>
                  <p class="text-xs font-mono text-gray-500 uppercase tracking-widest mt-1">Generación aleatoria de brackets por IA</p>
              </div>
              <button id="regenerate-brackets" class="px-6 py-2 bg-white/5 border border-white/20 rounded-lg text-[10px] font-black uppercase tracking-widest hover:bg-[var(--primary)] hover:text-black hover:border-[var(--primary)] transition-all flex items-center gap-2 group">
                  <svg class="w-3 h-3 group-hover:rotate-180 transition-transform duration-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="3" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"></path></svg>
                  RE-CALCULAR LLAVES
              </button>
          </div>

          <!-- BRACKETS GRID -->
          <div id="brackets-container" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
              <!-- Brackets will be injected here -->
          </div>
      </div>
    </div>
  </div>
</Layout>

<!-- CLIENT SIDE LOGIC -->
<script define:vars={{ artists }}>
    const arena = document.getElementById('page-container');
    const previewPanel = document.getElementById('preview-content');
    const emptyPreview = document.getElementById('preview-empty-state');
    
    const previewImg = document.getElementById('preview-img');
    const previewName = document.getElementById('preview-name');
    const previewRole = document.getElementById('preview-role');
    const previewTracks = document.getElementById('preview-tracks');
    
    const statPower = document.getElementById('stat-power');
    const statSpeed = document.getElementById('stat-speed');
    const statTech = document.getElementById('stat-tech');

    const tokens = document.querySelectorAll('.artist-token');

    function renderArtist(id) {
        const artist = artists.find(a => a.id == id);
        if (!artist) return;

        // Update Preview Panel (Left)
        if (previewPanel && emptyPreview) {
            emptyPreview.classList.add('hidden');
            previewPanel.classList.remove('hidden');

            if (previewImg) {
                previewImg.classList.add('opacity-0');
                setTimeout(() => {
                    previewImg.src = artist.imagenes.profile;
                    previewImg.classList.remove('opacity-0');
                }, 150);
            }
            if (previewName) previewName.textContent = artist.nombre;
            if (previewRole) previewRole.textContent = artist.estilo;
            
            // Stats with mini-animation
            if (statPower) animateStat(statPower, artist.stats?.power || 85);
            if (statSpeed) animateStat(statSpeed, artist.stats?.speed || 80);
            if (statTech) animateStat(statTech, artist.stats?.technique || 90);

            // Tracks
            if (previewTracks) {
                previewTracks.innerHTML = (artist.tracks || []).map(track => `
                    <span class="text-[7px] font-black bg-white/5 text-white/70 px-2 py-1 rounded uppercase tracking-widest border border-white/5 hover:border-[var(--primary)]/30 transition-all cursor-default">
                        ${track}
                    </span>
                `).join('');
            }
        }
    }

    function animateStat(el, value) {
        let current = 0;
        const duration = 500;
        const step = value / (duration / 16);
        const interval = setInterval(() => {
            current += step;
            if (current >= value) {
                el.textContent = value;
                clearInterval(interval);
            } else {
                el.textContent = Math.floor(current).toString().padStart(2, '0');
            }
        }, 16);
    }

    // DRAG EVENTS
    function initDragEvents() {
        const tokens = document.querySelectorAll('.artist-token');
        tokens.forEach(token => {
            token.addEventListener('dragstart', (e) => {
                const id = token.getAttribute('data-id');
                e.dataTransfer.setData('text/plain', id);
                e.dataTransfer.effectAllowed = 'copy';
                arena.classList.add('border-[var(--primary)]', 'bg-[var(--primary)]/5');
                
                document.querySelectorAll('.team-slot').forEach(s => {
                    if (!s.getAttribute('data-artist-id')) {
                        s.classList.add('border-dashed', 'border-[var(--primary)]/30', 'animate-pulse');
                    }
                });
            });

            token.addEventListener('dragend', () => {
                arena.classList.remove('border-[var(--primary)]', 'bg-[var(--primary)]/5');
                document.querySelectorAll('.team-slot').forEach(s => {
                    s.classList.remove('border-dashed', 'border-[var(--primary)]/30', 'animate-pulse');
                });
            });

            token.addEventListener('click', () => {
                const id = token.getAttribute('data-id');
                renderArtist(id);
                tokens.forEach(t => t.classList.remove('border-[var(--primary)]', 'scale-105', 'z-20', 'grayscale-0'));
                token.classList.add('border-[var(--primary)]', 'scale-105', 'z-20', 'grayscale-0');
            });
        });
    }

    initDragEvents();

    // ARENA DROP ZONE
    arena.addEventListener('dragover', (e) => e.preventDefault());
    arena.addEventListener('drop', (e) => {
        e.preventDefault();
        const id = e.dataTransfer.getData('text/plain');
        if (id) renderArtist(id);
    });

    // TEAM SLOTS LOGIC
    function fillTeamSlot(slot, artistId) {
        // Cross-team duplicate check
        const isAlreadySelected = Array.from(document.querySelectorAll('.team-slot')).some(s => s.getAttribute('data-artist-id') == artistId);
        if (isAlreadySelected) return;

        const artist = artists.find(a => a.id == artistId);
        if (!artist) return;

        const contentDiv = slot.querySelector('.slot-content');
        const label = slot.querySelector('span');
        
        label.classList.add('opacity-0');
        contentDiv.classList.remove('hidden');
        
        contentDiv.innerHTML = `
            <div class="perspective-1000 w-full h-full">
                <div class="card-inner w-full h-full relative preserve-3d transition-transform duration-700">
                    <!-- FRONT: COVER -->
                    <div class="card-front absolute inset-0 w-full h-full backface-hidden bg-black border border-white/20 flex flex-col items-center justify-center overflow-hidden">
                        <div class="absolute inset-0 bg-gradient-to-br from-zinc-800 to-black"></div>
                        <div class="relative z-10 flex flex-col items-center">
                            <div class="text-[var(--primary)] font-black text-[10px] tracking-[0.2em] leading-none uppercase">WILD</div>
                            <div class="text-white font-black text-[10px] tracking-[0.2em] leading-none uppercase mt-0.5">GVNG</div>
                        </div>
                    </div>
                    <!-- BACK: ARTIST -->
                    <div class="card-back absolute inset-0 w-full h-full backface-hidden rotate-y-180 bg-zinc-900">
                        <img src="${artist.imagenes.profile}" class="w-full h-full object-cover" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent opacity-60"></div>
                        <div class="absolute bottom-0 left-0 right-0 p-2 text-center">
                            <span class="text-[7px] font-black text-white uppercase tracking-tighter leading-none block truncate">${artist.nombre}</span>
                        </div>
                    </div>
                </div>
            </div>
        `;
        
        slot.classList.add('border-[var(--primary)]');
        slot.setAttribute('data-artist-id', artistId);
        
        // Auto-flip
        setTimeout(() => {
            const inner = contentDiv.querySelector('.card-inner');
            if (inner) inner.classList.add('rotate-y-180');
        }, 50);

        checkTeamStatus();
    }

    function checkTeamStatus() {
        const filledSlots = document.querySelectorAll('.team-slot[data-artist-id]').length;
        const totalNeeded = document.querySelectorAll('.team-slot').length;
        const statusText = document.querySelector('.arcade-font');
        
        if (filledSlots === totalNeeded && totalNeeded > 0) {
            statusText.innerText = "MAZO COMPLETO // READY TO FIGHT";
            statusText.classList.add('text-[var(--primary)]', 'animate-pulse');
        } else {
            statusText.innerText = "VERSUS MODE // CARD BATTLE";
            statusText.classList.remove('text-[var(--primary)]', 'animate-pulse');
        }
    }

    // MODE SELECTION
    const modeBtns = document.querySelectorAll('.mode-btn');
    modeBtns.forEach(btn => {
        btn.addEventListener('click', () => {
            modeBtns.forEach(b => b.classList.remove('active'));
            btn.classList.add('active');
            const mode = btn.getAttribute('data-mode');
            initSlots(mode);
            generateBrackets(mode);
        });
    });

    function initSlots(mode = '3v3') {
        const containers = {
            alpha: document.getElementById('team-alpha-slots'),
            omega: document.getElementById('team-omega-slots')
        };
        if (!containers.alpha || !containers.omega) return;

        const count = mode === '3v3' ? 3 : mode === '2v2' ? 2 : 1;
        
        ['alpha', 'omega'].forEach(team => {
            containers[team].innerHTML = '';
            for (let i = 0; i < count; i++) {
                const slot = createSlotElement(i + 1, team);
                containers[team].appendChild(slot);
                setupSlotEvents(slot);
            }
        });
        checkTeamStatus();
    }

    function createSlotElement(index, team) {
        const slot = document.createElement('div');
        slot.className = `team-slot group/slot relative w-20 h-28 md:w-24 md:h-32 border-2 border-white/5 rounded-xl flex items-center justify-center cursor-pointer transition-all hover:border-[var(--primary)]/30 overflow-hidden bg-white/5`;
        slot.innerHTML = `
            <span class="text-[8px] font-black text-white/10 uppercase tracking-widest z-10 transition-opacity">${team} ${index}</span>
            <div class="slot-content absolute inset-0 hidden"></div>
        `;
        return slot;
    }

    function setupSlotEvents(slot) {
        slot.addEventListener('dragover', (e) => e.preventDefault());
        slot.addEventListener('dragenter', () => slot.classList.add('bg-[var(--primary)]/10', 'border-[var(--primary)]/30'));
        slot.addEventListener('dragleave', () => slot.classList.remove('bg-[var(--primary)]/10', 'border-[var(--primary)]/30'));
        slot.addEventListener('drop', (e) => {
            e.preventDefault();
            slot.classList.remove('bg-[var(--primary)]/10', 'border-[var(--primary)]/30');
            const id = e.dataTransfer.getData('text/plain');
            if (id) fillTeamSlot(slot, id);
        });
        slot.addEventListener('click', () => {
            if (slot.getAttribute('data-artist-id')) {
                slot.removeAttribute('data-artist-id');
                slot.querySelector('.slot-content').innerHTML = '';
                slot.querySelector('.slot-content').classList.add('hidden');
                slot.querySelector('span').classList.remove('opacity-0');
                slot.classList.remove('border-[var(--primary)]');
                checkTeamStatus();
            }
        });
    }

    // BRACKETS
    const bracketsContainer = document.getElementById('brackets-container');
    const regenerateBtn = document.getElementById('regenerate-brackets');

    function generateBrackets(mode = '3v3') {
        if (!bracketsContainer) return;
        bracketsContainer.innerHTML = '';
        const shuffled = [...artists].sort(() => 0.5 - Math.random());
        const participants = mode === '3v3' ? 3 : mode === '2v2' ? 2 : 1;
        
        for (let i = 0; i < 4; i++) {
            const tA = shuffled.slice(i * participants * 2, i * participants * 2 + participants);
            const tB = shuffled.slice(i * participants * 2 + participants, i * participants * 2 + participants * 2);
            if (tA.length === participants && tB.length === participants) {
                bracketsContainer.insertAdjacentHTML('beforeend', createMatchHtml(tA, tB, i + 1, mode));
            }
        }
    }

    function createMatchHtml(teamA, teamB, index, mode) {
        return `
            <div class="match-card bg-black/40 border border-white/5 rounded-xl overflow-hidden backdrop-blur-sm hover:border-[var(--primary)]/30 transition-all duration-500 animate-fade-in" style="animation-delay: ${index * 0.1}s">
                <div class="bg-white/5 px-3 py-1.5 flex justify-between items-center border-b border-white/5">
                    <span class="text-[8px] font-black text-[var(--primary)] tracking-widest uppercase">MATCH #${index}</span>
                    <span class="text-[8px] font-bold text-gray-500 uppercase">${mode}</span>
                </div>
                <div class="p-4 flex flex-col gap-2 relative">
                    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-10 w-6 h-6 bg-black border border-white/10 rounded-full flex items-center justify-center text-[8px] font-black italic text-[var(--primary)]">VS</div>
                    ${[teamA, teamB].map((team, i) => `
                        <div class="team-container flex items-center gap-2 p-1.5 rounded-lg border border-transparent hover:border-white/10 transition-all cursor-pointer" onclick="setWinner(this)">
                            <div class="flex -space-x-2">
                                ${team.map(a => `<img src="${a.imagenes.profile}" class="w-6 h-6 rounded-full border border-black object-cover grayscale" />`).join('')}
                            </div>
                            <div class="flex-1 min-w-0">
                                <p class="text-[9px] font-black text-white truncate uppercase">${team.map(a => a.nombre.split(' ')[0]).join(' & ')}</p>
                                <div class="flex items-center gap-1">
                                    <div class="win-indicator w-1 h-1 rounded-full bg-[var(--primary)] opacity-0"></div>
                                    <span class="text-[7px] font-bold text-gray-500 uppercase tracking-widest">${i === 0 ? 'ALPHA' : 'OMEGA'}</span>
                                </div>
                            </div>
                        </div>
                    `).join('')}
                </div>
            </div>
        `;
    }

    window.setWinner = function(el) {
        const match = el.closest('.p-4');
        match.querySelectorAll('.team-container').forEach(t => {
            t.classList.remove('bg-[var(--primary)]/5', 'border-[var(--primary)]/20');
            t.querySelector('.win-indicator').classList.add('opacity-0');
        });
        el.classList.add('bg-[var(--primary)]/5', 'border-[var(--primary)]/20');
        el.querySelector('.win-indicator').classList.remove('opacity-0');
    }

    if (regenerateBtn) {
        regenerateBtn.addEventListener('click', () => {
            generateBrackets(document.querySelector('.mode-btn.active')?.getAttribute('data-mode') || '3v3');
        });
    }

    // Init
    generateBrackets();
    initSlots('3v3');

</script>

