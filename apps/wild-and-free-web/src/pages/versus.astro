---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

// --- DATA FETCHING from freestylers + freestyler_stats ---
interface VersusFreestyler {
  id: string;
  nombre: string;
  slug: string;
  imagenes: { profile: string };
  stats: { power: number; speed: number; technique: number; seguidores: string; oyentes: string };
  tracks: string[];
  bio: string;
  estilo: string;
  origen: string;
}

let dbFreestylers: VersusFreestyler[] = [];
try {
  // Fetch freestylers
  const { data: freestylers, error: fError } = await supabase
    .from('freestylers')
    .select('*')
    .eq('is_active', true);

  if (!fError && freestylers && freestylers.length > 0) {
    // Fetch stats for all freestylers
    const freestylerIds = freestylers.map(f => f.id);
    const { data: statsData } = await supabase
      .from('freestyler_stats')
      .select('*')
      .in('freestyler_id', freestylerIds);

    // Group stats by freestyler_id
    const statsByFreestyler: Record<string, Record<string, number>> = {};
    if (statsData) {
      for (const s of statsData) {
        if (!statsByFreestyler[s.freestyler_id]) statsByFreestyler[s.freestyler_id] = {};
        statsByFreestyler[s.freestyler_id][s.stat_name] = s.stat_value;
      }
    }

    // Map to the format the frontend expects
    const avatarUrl = 'https://images.unsplash.com/photo-1516280440614-37939bbacd81?w=400&q=80';
    dbFreestylers = freestylers.map((f: any, i: number) => {
      const s = statsByFreestyler[f.id] || {};
      return {
        id: f.id,
        nombre: f.name.toUpperCase(),
        slug: f.slug,
        imagenes: { 
          profile: f.avatar_url || `https://images.unsplash.com/photo-${1516280440614 + i}?w=400&q=80` 
        },
        stats: {
          power: s.power || s.puesta_en_escena || 80,
          speed: s.speed || s.doble_tempo || s.flow || 80,
          technique: s.technique || s.punchline || s.figuras_literarias || 75,
          seguidores: '0',
          oyentes: '0',
        },
        tracks: [],
        bio: f.bio || '',
        estilo: 'Freestyle',
        origen: '',
      };
    });
  }
} catch (e) {
  console.warn('Could not fetch freestylers from Supabase during build.');
}

// Fallback mock data (20 freestylers con stats variadas)
const unsplashIds = [
  '1516280440614-37939bbacd81','1521119989659-a83eee488004','1492562080023-ab3db95bfbce',
  '1500648767791-00dcc994a43e','1539571696357-5a69c17a67c6','1507003211169-0a1dd7228f2d',
  '1534030347209-7147fd9e791a','1504257432389-52343af06ae3','1500917293891-ef795e70e1f6',
  '1531123897727-8f129e16fd3c','1506794778202-cad84cf45f1d','1519085360753-af0119f7cbe7',
  '1507003211169-0a1dd7228f2d','1500648767791-00dcc994a43e','1494790108377-be9c29b29330',
  '1521119989659-a83eee488004','1492562080023-ab3db95bfbce','1506794778202-cad84cf45f1d',
  '1539571696357-5a69c17a67c6','1524504388940-b1c1722653e1'
];

const mockFreestylerNames = [
  'RAYOS X', 'SOMBRA 47', 'FUEGO LÍRICO', 'DIAMANTE NEGRO', 'NEON KID',
  'RELÁMPAGO', 'GARRAS', 'TORMENTA', 'VÍBORA X', 'LUNA NEGRA',
  'ROJO FUEGO', 'CIBER PUNK', 'FANTASMA G', 'MICRÓFONO DE HIERRO', 'ROSA DE TERCIOPELO',
  'TÓXICO B', 'LLAMARADA SOLAR', 'HIELO SECO', 'LA BESTIA', 'KARMMA'
];

const mockFreestylerSlugs = [
  'rayos-x','sombra-47','fuego-lirico','diamante-negro','neon-kid',
  'relampago','garras','tormenta','vibora-x','luna-negra',
  'rojo-fuego','ciber-punk','fantasma-g','microfono-de-hierro','rosa-de-terciopelo',
  'toxico-b','llamarada-solar','hielo-seco','la-bestia','karmma'
];

const mockFreestylerBios = [
  'El relámpago del norte. Sus rimas cortan como el cristal.',
  'Directo de los callejones más oscuros de la CDMX.',
  'Incendiando cada escenario que pisa.',
  'Brillante bajo presión. La joya del hip-hop nacional.',
  'La luz que nunca se apaga. Ritmos futuristas.',
  'Más rápido que el sonido. Te gana antes de que lo veas.',
  'Desgarrando el beat con cada verso.',
  'Energía pura. Imparable como un huracán.',
  'El veneno lírico más potente del norte.',
  'Voces etéreas sobre bajos pesados.',
  'La nueva promesa del trap duro.',
  'Sonidos del futuro hoy. Hackeando el sistema.',
  'El espectro del beat. Aparece donde menos lo esperas.',
  'Barras de acero. Peso pesado del freestyle.',
  'Suavidad que mata. R&B con espinas.',
