---
import Layout from '../layouts/Layout.astro';
import Sponsors from '../components/Sponsors.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Evento",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};
---

<Layout config={config}>
  <div class="min-h-screen bg-[var(--bg)] text-[var(--text)] pb-24">
    <div class="max-w-5xl mx-auto px-4 md:px-8 py-10">
      <a href="/eventos" class="inline-flex items-center gap-2 text-[10px] font-black uppercase tracking-[0.2em] text-[var(--text-muted)] hover:text-[var(--primary)] transition-colors">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M19 12H5"></path>
          <path d="m12 19-7-7 7-7"></path>
        </svg>
        Volver a eventos
      </a>

      <div id="event-root" class="mt-8">
        <div class="border border-[var(--border)] rounded-2xl p-8 bg-[var(--bg-card)] animate-pulse">
          <div class="h-6 w-40 bg-white/10 rounded mb-4"></div>
          <div class="h-3 w-64 bg-white/10 rounded"></div>
        </div>
      </div>

      <div id="ticket-notice" class="hidden mt-6 rounded-xl border border-[var(--primary)]/40 bg-[var(--primary)]/10 px-4 py-3 text-xs font-bold text-[var(--text)]" role="status" aria-live="polite"></div>

      <section id="my-tickets-section" class="hidden mt-10">
        <h2 class="text-lg font-black uppercase tracking-[0.2em] text-[var(--text)] mb-4">Mis boletos</h2>
        <div id="my-tickets" class="grid grid-cols-1 sm:grid-cols-2 gap-4"></div>
      </section>
    </div>

    <Sponsors />
  </div>
</Layout>

<script>
  import { supabase } from '../lib/supabase';

  interface PublicEvent {
    id: string
    name: string
    description?: string | null
    event_type?: string | null
    event_date: string
    location?: string | null
    venue_address?: string | null
    image_url?: string | null
    lineup?: any[]
    ticket_price?: number | null
    ticket_currency?: string | null
    capacity?: number | null
    is_mock?: boolean
  }

  const MOCK_EVENTS: Record<string, PublicEvent> = {
    e1: {
      id: 'e1',
      name: 'Wild Battle Vol. 12',
      description: 'Batalla de freestyle 1v1. 16 competidores. Premio: $5,000 MXN + tokens.',
      event_type: 'battle',
      event_date: '2026-07-15T20:00:00',
      location: 'Foro Wild Gvng, Torreón',
      image_url: 'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=1200&q=80',
      lineup: ['KAZTA', 'Ralf Díaz', 'MC invitado'],
      ticket_price: 200,
      ticket_currency: 'MXN',
      is_mock: true,
    },
    e2: {
      id: 'e2',
      name: 'Noche Underground',
      description: 'Concierto con artistas de la crew. Invitados especiales del norte.',
      event_type: 'concert',
      event_date: '2026-08-02T21:00:00',
      location: 'Salón Caribe, Torreón',
      image_url: 'https://images.unsplash.com/photo-1459749411177-042180ce673c?auto=format&fit=crop&w=1200&q=80',
      lineup: ['Wild Gvng Crew'],
      ticket_price: 350,
      ticket_currency: 'MXN',
      is_mock: true,
    },
    e3: {
      id: 'e3',
      name: 'Meet & Greet Crew',
      description: 'Conoce a los artistas de Wild Gvng. Fotos, autógrafos y merch exclusivo.',
      event_type: 'meet_greet',
      event_date: '2026-08-20T17:00:00',
      location: 'Casa Bosque, Torreón',
      image_url: 'https://images.unsplash.com/photo-1589578236639-5381345b6687?auto=format&fit=crop&w=1200&q=80',
      lineup: [],
      ticket_price: 0,
      ticket_currency: 'MXN',
      is_mock: true,
    },
  };

  const eventId = new URLSearchParams(window.location.search).get('id');
  const root = document.getElementById('event-root');
  const notice = document.getElementById('ticket-notice');
  const ticketsSection = document.getElementById('my-tickets-section');
  const ticketsGrid = document.getElementById('my-tickets');
  let currentEvent: PublicEvent | null = null;

  function escapeHtml(value: unknown): string {
    return String(value ?? '')
      .replace(/&/g, '&amp;')
      .replace(/</g, '&lt;')
      .replace(/>/g, '&gt;')
      .replace(/"/g, '&quot;')
      .replace(/'/g, '&#39;');
  }

  function showNotice(message: string, type: 'ok' | 'error' = 'ok'): void {
    if (!notice) return;
    notice.textContent = message;
    notice.classList.remove('hidden');
    notice.classList.toggle('border-red-500/40', type === 'error');
    notice.classList.toggle('bg-red-500/10', type === 'error');
    notice.classList.toggle('border-[var(--primary)]/40', type !== 'error');
    notice.classList.toggle('bg-[var(--primary)]/10', type !== 'error');
  }

  function formatDate(value: string): string {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return 'Fecha por confirmar';
    return date.toLocaleDateString('es-MX', {
      weekday: 'long',
      day: 'numeric',
      month: 'long',
      year: 'numeric',
    });
  }

  function formatTime(value: string): string {
    const date = new Date(value);
    if (Number.isNaN(date.getTime())) return '';
    return date.toLocaleTimeString('es-MX', { hour: '2-digit', minute: '2-digit' });
  }

  function lineupHtml(event: PublicEvent): string {
    const lineup = Array.isArray(event.lineup) ? event.lineup : [];
    if (lineup.length === 0) return '';
    const items = lineup.map((artist: any) => {
      const name = typeof artist === 'string' ? artist : artist?.name;
      if (!name) return '';
      return `<span class="px-3 py-1 text-[10px] font-black uppercase tracking-wider border border-[var(--primary)]/40 text-[var(--text)] rounded-full bg-[var(--bg-card)]">${escapeHtml(name)}</span>`;
    }).join('');
    return `
      <div class="pt-4">
        <span class="block text-[10px] font-black uppercase tracking-[0.25em] text-[var(--primary)] mb-2">Line-up</span>
        <div class="flex flex-wrap gap-2">${items}</div>
      </div>`;
  }

  function renderEvent(event: PublicEvent): void {
    if (!root) return;
    currentEvent = event;
    const price = Number(event.ticket_price ?? 0);
    const currency = event.ticket_currency || 'MXN';
    const priceLabel = price > 0 ? `$${price.toFixed(2)} ${currency}` : 'Entrada gratuita';
    const dateLabel = formatDate(event.event_date);
    const timeLabel = formatTime(event.event_date);

    root.innerHTML = `
      <article class="border border-[var(--border)] rounded-3xl overflow-hidden bg-[var(--bg)]">
        <div class="relative h-64 md:h-80 bg-[var(--bg-card)]">
          ${event.image_url ? `<img src="${escapeHtml(event.image_url)}" alt="${escapeHtml(event.name)}" class="w-full h-full object-cover opacity-60" loading="lazy" />` : ''}
          <div class="absolute inset-0 bg-gradient-to-t from-[var(--bg)] via-[var(--bg)]/40 to-transparent"></div>
          <div class="absolute bottom-0 left-0 right-0 p-6 md:p-10">
            <div class="flex flex-wrap items-center gap-3 mb-3">
              <span class="px-3 py-1 bg-[var(--primary)] text-black text-[10px] font-black uppercase tracking-[0.2em] rounded-full">${escapeHtml(event.event_type || 'evento')}</span>
              ${event.venue_address ? `<span class="text-[10px] font-bold uppercase tracking-wider text-white/60">${escapeHtml(event.venue_address)}</span>` : ''}
            </div>
            <h1 class="text-4xl md:text-6xl font-black uppercase tracking-tighter leading-none text-white">${escapeHtml(event.name)}</h1>
            <p class="mt-3 text-sm font-bold uppercase tracking-wider text-[var(--primary)]">${escapeHtml(event.location || 'Ubicación por confirmar')}</p>
          </div>
        </div>

        <div class="p-6 md:p-10 grid grid-cols-1 lg:grid-cols-[1fr_320px] gap-8">
          <div class="space-y-6">
            <div class="flex flex-wrap gap-6 text-xs font-black uppercase tracking-wider text-[var(--text-muted)]">
              <span class="flex items-center gap-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><rect x="3" y="4" width="18" height="18" rx="2"></rect><line x1="16" y1="2" x2="16" y2="6"></line><line x1="8" y1="2" x2="8" y2="6"></line><line x1="3" y1="10" x2="21" y2="10"></line></svg>
                ${escapeHtml(dateLabel)}
              </span>
              <span class="flex items-center gap-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="9"></circle><path d="M12 7v5l3 2"></path></svg>
                ${escapeHtml(timeLabel)}
              </span>
            </div>

            <p class="text-sm md:text-base leading-relaxed text-white/70 whitespace-pre-line">${escapeHtml(event.description || '')}</p>
            ${lineupHtml(event)}
          </div>

          <aside class="border border-[var(--border)] rounded-2xl p-6 bg-[var(--bg-card)] h-fit">
            <span class="block text-[10px] font-black uppercase tracking-[0.25em] text-[var(--text-muted)] mb-2">Boleto general</span>
            <span class="block text-3xl font-black text-[var(--text)] mb-4">${escapeHtml(priceLabel)}</span>
            ${event.capacity ? `<span class="block text-[10px] font-bold uppercase tracking-wider text-[var(--text-muted)] mb-4">Aforo: ${event.capacity} personas</span>` : ''}
            <button id="buy-ticket" class="w-full py-4 bg-[var(--primary)] text-black text-xs font-black uppercase tracking-[0.2em] rounded-xl hover:brightness-110 transition-all disabled:opacity-40 disabled:cursor-not-allowed">
              ${event.is_mock ? 'Evento de demostración' : price > 0 ? 'Comprar boleto' : 'Reservar boleto gratis'}
            </button>
            <p class="mt-3 text-[10px] leading-relaxed text-white/40">
              Recibirás un código QR único para validar tu acceso en la entrada.
            </p>
          </aside>
        </div>
      </article>`;

    if (event.is_mock) {
      const btn = document.getElementById('buy-ticket') as HTMLButtonElement | null;
      if (btn) {
        btn.disabled = true;
        btn.addEventListener('click', () => showNotice('Este evento es de demostración; la compra se habilitará con eventos reales.', 'error'));
      }
    } else {
      document.getElementById('buy-ticket')?.addEventListener('click', buyTicket);
    }
  }

  async function loadEvent(): Promise<void> {
    if (!eventId) {
      if (root) root.innerHTML = '<p class="text-center text-sm text-[var(--text-muted)] py-16">Selecciona un evento desde la cartelera.</p>';
      return;
    }

    try {
      const { data, error } = await supabase
        .from('events')
        .select('*')
        .eq('id', eventId)
        .single();

      if (!error && data) {
        renderEvent(data as PublicEvent);
        return;
      }
    } catch {
      /* fallback */
    }

    const mock = MOCK_EVENTS[eventId];
    if (mock) {
      renderEvent(mock);
    } else if (root) {
      root.innerHTML = '<p class="text-center text-sm text-[var(--text-muted)] py-16">No encontramos este evento.</p>';
    }
  }

  async function getSession() {
    const { data } = await supabase.auth.getSession();
    return data?.session || null;
  }

  async function buyTicket(): Promise<void> {
    if (!currentEvent || currentEvent.is_mock) return;
    const session = await getSession();
    if (!session) {
      window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname + window.location.search)}`;
      return;
    }

    const btn = document.getElementById('buy-ticket') as HTMLButtonElement | null;
    if (btn) {
      btn.disabled = true;
      btn.textContent = 'Procesando...';
    }

    try {
      const response = await fetch('/api/ticket-checkout', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${session.access_token}`,
        },
        body: JSON.stringify({ event_id: currentEvent.id }),
      });
      const payload = await response.json();

      if (payload?.url) {
        window.location.href = payload.url;
        return;
      }

      if (payload?.ticket) {
        showNotice('Boleto reservado. Guárdalo, lo verás abajo.');
        await loadMyTickets();
        return;
      }

      if (payload?.error === 'stripe_not_configured') {
        showNotice('Los pagos aún no están configurados. El equipo ya puede activarlos con las llaves de Stripe.', 'error');
      } else {
        showNotice(payload?.error || 'No pudimos iniciar la compra. Intenta de nuevo.', 'error');
      }
    } catch {
      showNotice('Sin conexión con la pasarela de pago. Intenta más tarde.', 'error');
    } finally {
      if (btn) {
        btn.disabled = false;
        btn.textContent = currentEvent.is_mock ? 'Evento de demostración' : Number(currentEvent.ticket_price ?? 0) > 0 ? 'Comprar boleto' : 'Reservar boleto gratis';
      }
    }
  }

  function ticketStatusLabel(status: string): string {
    if (status === 'paid') return 'Válido';
    if (status === 'used') return 'Usado';
    if (status === 'pending') return 'Pendiente';
    if (status === 'refunded') return 'Reembolsado';
    if (status === 'cancelled') return 'Cancelado';
    return status;
  }

  async function loadMyTickets(): Promise<void> {
    if (!currentEvent || currentEvent.is_mock) return;
    const session = await getSession();
    if (!session || !ticketsSection || !ticketsGrid) return;

    const { data, error } = await supabase
      .from('tickets')
      .select('*')
      .eq('event_id', currentEvent.id)
      .eq('user_id', session.user.id)
      .order('created_at', { ascending: false });

    if (error || !data || data.length === 0) {
      ticketsSection.classList.add('hidden');
      return;
    }

    ticketsSection.classList.remove('hidden');
    ticketsGrid.innerHTML = data.map((ticket: any) => {
      const qr = `https://api.qrserver.com/v1/create-qr-code/?size=200x200&data=${encodeURIComponent(ticket.qr_code)}`;
      return `
        <div class="border border-[var(--border)] rounded-2xl bg-[var(--bg)] p-5 flex gap-4">
          <img src="${qr}" alt="Código QR del boleto" width="120" height="120" class="w-[120px] h-[120px] rounded-lg bg-white p-1" loading="lazy" />
          <div class="min-w-0">
            <span class="block text-[10px] font-black uppercase tracking-[0.2em] text-[var(--primary)]">${escapeHtml(ticketStatusLabel(ticket.status))}</span>
            <span class="block mt-2 text-sm font-black uppercase text-white">${escapeHtml(ticket.ticket_type || 'General')}</span>
            <span class="block mt-1 text-[10px] font-mono text-white/50 break-all">${escapeHtml(ticket.qr_code)}</span>
            <span class="block mt-2 text-[10px] text-white/40">Presenta este QR en la entrada.</span>
          </div>
        </div>`;
    }).join('');
  }

  async function confirmCheckout(): Promise<void> {
    const params = new URLSearchParams(window.location.search);
    if (params.get('success') !== '1') return;
    const sessionId = params.get('session_id');
    if (!sessionId) return;

    const session = await getSession();
    if (!session) {
      showNotice('Inicia sesión para recuperar tu boleto.', 'error');
      return;
    }

    try {
      const response = await fetch('/api/ticket-confirm', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Authorization: `Bearer ${session.access_token}`,
        },
        body: JSON.stringify({ session_id: sessionId }),
      });
      const payload = await response.json();
      if (payload?.ticket) {
        showNotice('¡Pago confirmado! Tu boleto ya está listo.');
        await loadMyTickets();
      } else {
        showNotice(payload?.error || 'No pudimos confirmar el pago.', 'error');
      }
    } catch {
      showNotice('No pudimos confirmar el pago. Revisa tu correo o contacta soporte.', 'error');
    }
  }

  (async () => {
    await loadEvent();
    await confirmCheckout();
    await loadMyTickets();
  })();
</script>
