---
import Layout from '../layouts/Layout.astro';
---

<Layout config={{
  name: "Wild Gvng - Recuperar Contraseña",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <a href="/" class="auth-logo">
          <span class="text-3xl font-black tracking-tighter italic"><span class="text-orange-500">WILD</span> <span class="text-white">GVNG</span></span>
        </a>
        <h1 class="text-2xl font-black text-white uppercase tracking-wider mt-6">Recuperar Acceso</h1>
        <p class="text-white/40 text-[10px] uppercase font-bold tracking-widest mt-2">Ingresa tu correo para recibir un enlace de recuperación</p>
      </div>

      <form class="recovery-form space-y-6 mt-8">
        <div class="form-group">
          <label for="email" class="block text-[10px] font-black uppercase tracking-widest text-white/60 mb-2">Correo Electrónico</label>
          <input 
            type="email" 
            id="email" 
            placeholder="tu@email.com"
            required
            class="w-full bg-white/5 border border-white/10 rounded-xl px-5 py-4 text-white text-sm focus:border-orange-500 transition-all outline-none"
          >
        </div>

        <button type="submit" class="w-full py-4 bg-white text-black text-xs font-black uppercase tracking-[0.2em] rounded-xl hover:bg-orange-500 hover:text-white transition-all transform active:scale-95">
          Enviar Enlace
        </button>

        <div class="text-center mt-6">
          <a href="/login" class="text-[10px] text-white/40 hover:text-orange-500 font-bold uppercase tracking-widest transition-colors">Volver al inicio de sesión</a>
        </div>
      </form>

      <div id="success-message" class="hidden mt-8 p-6 bg-orange-500/10 border border-orange-500/20 rounded-2xl text-center">
        <p class="text-orange-500 text-xs font-bold uppercase tracking-widest leading-relaxed">
          ¡Listo! Revisa tu bandeja de entrada. Te hemos enviado las instrucciones para restablecer tu contraseña.
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .auth-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: #000;
    position: relative;
    overflow: hidden;
  }

  .auth-container::before {
    content: '';
    position: absolute;
    width: 150%;
    height: 150%;
    background: radial-gradient(circle at center, rgba(201, 131, 0, 0.05) 0%, transparent 50%);
    top: -25%;
    left: -25%;
    pointer-events: none;
  }

  .auth-card {
    width: 100%;
    max-width: 450px;
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 32px;
    padding: 60px 40px;
    position: relative;
    z-index: 1;
  }

  .auth-header {
    text-align: center;
  }

  .auth-logo {
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .auth-logo:hover {
    transform: scale(1.05) rotate(-2deg);
  }

  @media (max-width: 480px) {
    .auth-card {
      padding: 40px 24px;
    }
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  const form = document.querySelector('.recovery-form');
  const successMessage = document.getElementById('success-message');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('email');
      const email = emailInput && 'value' in emailInput ? emailInput.value : '';
      const submitBtn = form.querySelector('button[type="submit"]');
      
      if (submitBtn) {
        submitBtn.disabled = true;
        submitBtn.textContent = 'Enviando...';
        submitBtn.style.opacity = '0.5';
      }

      const { error } = await supabase.auth.resetPasswordForEmail(email, {
        redirectTo: `${window.location.origin}/actualizar-contrasena`,
      });

      if (error) {
        alert(error.message);
        if (submitBtn) {
          submitBtn.disabled = false;
          submitBtn.textContent = 'Enviar Enlace';
          submitBtn.style.opacity = '1';
        }
        return;
      }

      form.classList.add('hidden');
      successMessage?.classList.remove('hidden');
    });
  }
</script>
