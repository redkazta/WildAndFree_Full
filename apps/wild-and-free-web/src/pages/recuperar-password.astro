---
import Layout from '../layouts/Layout.astro';
---

<Layout config={{
  name: "Wild Gvng - Recuperar Contraseña",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>
  <div class="auth-container">
    <div class="auth-card">
      <div class="auth-header">
        <a href="/" class="auth-logo">
          <span class="text-3xl font-black tracking-tighter italic"><span class="text-wild-orange">WILD</span> <span class="text-[var(--text)]">GVNG</span></span>
        </a>
        <h1 class="text-2xl font-black text-[var(--text)] uppercase tracking-wider mt-6">Recuperar Acceso</h1>
        <p class="text-[var(--text-faint)] text-[10px] uppercase font-bold tracking-widest mt-2">Ingresa tu correo para recibir un enlace de recuperación</p>
      </div>

      <form class="recovery-form space-y-6 mt-8">
        <div class="form-group">
          <label for="email" class="block text-[10px] font-black uppercase tracking-widest text-[var(--text-muted)] mb-2">Correo Electrónico</label>
          <input 
            type="email" 
            id="email" 
            placeholder="tu@email.com"
            required
            class="w-full bg-[var(--bg-card)] border border-[var(--border)] rounded-xl px-5 py-4 text-[var(--text)] text-sm focus:border-wild-orange transition-all outline-none"
          >
        </div>

        <button type="submit" class="w-full py-4 bg-white text-black text-xs font-black uppercase tracking-[0.2em] rounded-xl hover:bg-wild-orange hover:text-[var(--text)] transition-all transform active:scale-95">
          Enviar Enlace
        </button>

        <div class="text-center mt-6">
          <a href="/login" class="text-[10px] text-[var(--text-faint)] hover:text-wild-orange font-bold uppercase tracking-widest transition-colors">Volver al inicio de sesión</a>
        </div>
      </form>

      <div id="success-message" class="hidden mt-8 p-6 bg-wild-orange/10 border border-wild-orange/20 rounded-2xl text-center">
        <p class="text-wild-orange text-xs font-bold uppercase tracking-widest leading-relaxed">
          ¡Listo! Revisa tu bandeja de entrada. Te hemos enviado las instrucciones para restablecer tu contraseña.
        </p>
      </div>
    </div>
  </div>
</Layout>

<style>
  .auth-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    background: #000;
    position: relative;
    overflow: hidden;
  }

  .auth-container::before {
    content: '';
    position: absolute;
    width: 150%;
    height: 150%;
    background: radial-gradient(circle at center, rgba(201, 131, 0, 0.05) 0%, transparent 50%);
    top: -25%;
    left: -25%;
    pointer-events: none;
  }

  .auth-card {
    width: 100%;
    max-width: 450px;
    background: rgba(255, 255, 255, 0.02);
    backdrop-filter: blur(20px);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 32px;
    padding: 60px 40px;
    position: relative;
    z-index: 1;
  }

  .auth-header {
    text-align: center;
  }

  .auth-logo {
    display: inline-block;
    transition: transform 0.3s cubic-bezier(0.23, 1, 0.32, 1);
  }

  .auth-logo:hover {
    transform: scale(1.05) rotate(-2deg);
  }

  @media (max-width: 480px) {
    .auth-card {
      padding: 40px 24px;
    }
  }
</style>

<script>
  import { supabase } from '../lib/supabase';
  import { withLoadingState } from '../lib/form-helpers';

  const form = document.querySelector('.recovery-form');
  const successMessage = document.getElementById('success-message');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const emailInput = document.getElementById('email');
      const email = emailInput && 'value' in emailInput ? emailInput.value : '';
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null;

      await withLoadingState(submitBtn, 'Enviando...', async () => {
        const { error } = await supabase.auth.resetPasswordForEmail(email, {
          redirectTo: `${window.location.origin}/actualizar-contrasena`,
        });

        if (error) {
          alert(error.message);
          return;
        }

        form.classList.add('hidden');
        successMessage?.classList.remove('hidden');
      });
    });
  }
</script>
