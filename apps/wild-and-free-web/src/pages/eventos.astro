---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Eventos",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};

const events = [
  { 
    id: 'e1', 
    titulo: 'WILD NIGHT CDMX', 
    fecha: '15 MAR 2024',
    hora: '21:00 HRS', 
    lugar: 'FORO INDIE ROCKS', 
    ciudad: 'CDMX',
    imagen: 'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=800&q=80',
    descripcion: 'NOVA K PRESENTA "SIN REGLAS" + INVITADOS ESPECIALES',
    precio_min: 450,
    status: 'disponible'
  },
  { 
    id: 'e2', 
    titulo: 'URBAN FEST GDL', 
    fecha: '22 MAR 2024',
    hora: '16:00 HRS', 
    lugar: 'C3 STAGE', 
    ciudad: 'GUADALAJARA',
    imagen: 'https://images.unsplash.com/photo-1459749411177-042180ce673c?auto=format&fit=crop&w=800&q=80',
    descripcion: 'EL FESTIVAL URBANO MÁS IMPORTANTE DE OCCIDENTE',
    precio_min: 350,
    status: 'proximo'
  },
  { 
    id: 'e3', 
    titulo: 'BEAT SESSIONS', 
    fecha: '10 ABR 2024',
    hora: '19:00 HRS', 
    lugar: 'ESTUDIO 404', 
    ciudad: 'CDMX',
    imagen: 'https://images.unsplash.com/photo-1589578236639-5381345b6687?auto=format&fit=crop&w=800&q=80',
    descripcion: 'MASTERCLASS DE PRODUCCIÓN CON SABLE + NETWORKING',
    precio_min: 0,
    status: 'sold_out'
  }
];
---

<Layout config={config}>
  <div class="min-h-screen bg-[#050505] pb-20 px-6 relative overflow-hidden">
    <!-- Background Noise Pattern -->
    <div class="absolute inset-0 opacity-[0.03] pointer-events-none" style="background-image: radial-gradient(#fff 1px, transparent 1px); background-size: 20px 20px;"></div>

    <div class="max-w-[1400px] mx-auto space-y-24 relative z-10 animate-fade-in-up">
      
      <!-- Header Brutalista -->
      <div class="border-b-4 border-white pb-8">
        <div class="flex flex-col md:flex-row items-end gap-6 mb-8">
          <h1 class="text-7xl md:text-9xl font-black tracking-tighter text-white uppercase leading-none hover:text-[var(--street-accent)] transition-colors duration-500" style="text-shadow: 4px 4px 0px var(--street-accent);">
            TOUR
          </h1>
          <div class="flex flex-col mb-2">
             <span class="text-xl font-bold text-black bg-[var(--street-accent)] px-2 inline-block w-fit">SHOWS EN VIVO</span>
             <span class="text-sm font-mono text-[#888] tracking-widest mt-1">MUNDIAL • 2024-2025</span>
          </div>
        </div>
      </div>

      <!-- Lista de Eventos (Estilo Ticket) -->
      <div class="space-y-12">
        {events.map((event, index) => (
          <div class="group relative flex flex-col lg:flex-row bg-[#111] border-2 border-white hover:border-[var(--street-accent)] transition-all duration-300 hover:shadow-[8px_8px_0px_var(--street-accent)] hover:-translate-y-1 animate-stagger" style={`animation-delay: ${index * 100}ms`}>
            
            <!-- Caja de Fecha (Talón Izquierdo) -->
            <div class="lg:w-48 bg-white text-black p-6 flex flex-col justify-between border-b-2 lg:border-b-0 lg:border-r-2 border-dashed border-black relative">
               <!-- Puntos de perforación visual -->
               <div class="absolute -right-[6px] top-0 bottom-0 w-[10px] hidden lg:flex flex-col justify-between z-10 pointer-events-none">
                  {Array.from({ length: 12 }).map(() => <div class="w-3 h-3 rounded-full bg-[#050505] -ml-[6px]"></div>)}
               </div>

               <div class="font-mono font-bold text-xl leading-none">
                 N.º<span class="text-[var(--street-accent)]">{String(index + 1).padStart(3, '0')}</span>
               </div>
               <div class="text-center my-4 lg:my-0">
                 <span class="block text-4xl font-black tracking-tighter">{event.fecha.split(' ')[0]}</span>
                 <span class="block text-xl font-bold uppercase">{event.fecha.split(' ')[1]}</span>
               </div>
               <div class="font-mono text-sm font-bold text-center border-2 border-black px-1">
                 {event.hora}
               </div>
            </div>

            <!-- Main Info (Center) -->
            <div class="flex-1 p-6 lg:p-10 relative overflow-hidden">
               <!-- Background Image Faded -->
               <div class="absolute inset-0 opacity-20 group-hover:opacity-40 transition-opacity grayscale group-hover:grayscale-0">
                  <img src={event.imagen} class="w-full h-full object-cover" />
               </div>
               <div class="absolute inset-0 bg-gradient-to-r from-[#111] via-[#111]/80 to-transparent"></div>

               <div class="relative z-10 flex flex-col justify-between h-full space-y-6">
                  <div>
                    <div class="flex items-center gap-3 mb-2">
                       <div class="text-[10px] font-mono font-bold uppercase tracking-widest">
                         {event.status === 'sold_out' ? (
                           <span class="text-red-500 line-through decoration-2">AGOTADO</span>
                         ) : event.status === 'proximo' ? (
                           <span class="text-white/60">PRÓXIMAMENTE</span>
                         ) : (
                           <span class="text-[var(--street-accent)] animate-pulse border border-[var(--street-accent)] px-2 py-0.5 bg-black">DISPONIBLE</span>
                         )}
                       </div>
                       <span class="text-white/50 text-sm font-mono tracking-widest uppercase">{event.ciudad}</span>
                    </div>
                    <h2 class="text-4xl md:text-6xl font-black text-white uppercase tracking-tighter leading-none group-hover:text-white transition-colors">
                      {event.titulo}
                    </h2>
                    <p class="text-[var(--street-accent)] font-mono text-lg mt-2 uppercase">{event.lugar}</p>
                  </div>

                  <p class="text-gray-400 font-bold max-w-xl text-sm md:text-base uppercase tracking-wide border-l-2 border-[var(--street-accent)] pl-4">
                     {event.descripcion}
                  </p>
               </div>
            </div>

            <!-- Action / Barcode (Right Stub) -->
            <div class="lg:w-64 bg-[#0a0a0a] border-t-2 lg:border-t-0 lg:border-l-2 border-dashed border-white p-6 flex flex-col justify-between items-center relative">
               <!-- Perforation dots visual -->
               <div class="absolute -left-[6px] top-0 bottom-0 w-[10px] hidden lg:flex flex-col justify-between z-10 pointer-events-none">
                  {Array.from({ length: 12 }).map(() => <div class="w-3 h-3 rounded-full bg-[#050505] -ml-[6px]"></div>)}
               </div>

               <div class="w-full text-right">
                  <span class="block text-white/50 text-[10px] font-mono uppercase tracking-widest">ADMIT ONE</span>
                  <span class="block text-3xl font-black text-white">${event.precio_min}</span>
               </div>

               <!-- Barcode Visual -->
               <div class="w-full h-12 bg-white flex items-end justify-between px-2 pb-1 my-4 opacity-50 group-hover:opacity-100 transition-opacity">
                  {Array.from({ length: 20 }).map(() => (
                     <div class="bg-black w-[2px] h-[80%]"></div>
                  ))}
                  {Array.from({ length: 10 }).map(() => (
                     <div class="bg-black w-[4px] h-[100%]"></div>
                  ))}
               </div>

               <a href={`/evento/${event.id}`} class={`w-full py-3 px-4 font-black uppercase text-center text-sm tracking-widest border-2 transition-all duration-300 ${
                  event.status === 'sold_out' 
                  ? 'border-gray-700 text-gray-700 cursor-not-allowed bg-transparent'
                  : 'border-white text-white bg-transparent hover:bg-[var(--street-accent)] hover:border-[var(--street-accent)] hover:text-black hover:shadow-[4px_4px_0px_white]'
               }`}>
                  {event.status === 'sold_out' ? 'AGOTADO' : 'COMPRAR'}
               </a>
            </div>

          </div>
        ))}
      </div>

    </div>
  </div>
</Layout>

<style is:global define:vars={{ streetAccent: tenant.primary_color }}>
  :root {
    --street-accent: var(--streetAccent);
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .animate-stagger {
    opacity: 0;
    animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
</style>
