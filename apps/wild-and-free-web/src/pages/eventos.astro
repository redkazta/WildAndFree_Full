---
import Layout from '../layouts/Layout.astro';

const events = [
  { 
    id: 'e1', 
    titulo: 'Wild Night CDMX', 
    fecha: '15 MAR 2024', 
    lugar: 'Foro Indie Rocks', 
    ciudad: 'CDMX',
    imagen: 'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=800&q=80',
    descripcion: 'Nova K presenta su nuevo álbum "Sin Reglas" con invitados especiales.',
    precio_min: 450,
    status: 'disponible'
  },
  { 
    id: 'e2', 
    titulo: 'Urban Fest GDL', 
    fecha: '22 MAR 2024', 
    lugar: 'C3 Stage', 
    ciudad: 'Guadalajara',
    imagen: 'https://images.unsplash.com/photo-1459749411177-042180ce673c?auto=format&fit=crop&w=800&q=80',
    descripcion: 'El festival urbano más importante de Guadalajara.',
    precio_min: 350,
    status: 'proximo'
  },
  { 
    id: 'e3', 
    titulo: 'Beatmaker Sessions', 
    fecha: '10 ABR 2024', 
    lugar: 'Estudio 404', 
    ciudad: 'CDMX',
    imagen: 'https://images.unsplash.com/photo-1589578236639-5381345b6687?auto=format&fit=crop&w=800&q=80',
    descripcion: 'Sesión intensiva de creación de ritmos con Sable.',
    precio_min: 0,
    status: 'proximo'
  }
];

const config = {
  name: "Wild Gvng - Eventos",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
};
---

<Layout config={config}>
  <main class="min-h-screen bg-black pt-32 pb-20 px-6">
    <div class="max-w-6xl mx-auto space-y-20">
      <div class="space-y-4 text-center lg:text-left">
        <h1 class="text-6xl md:text-8xl font-black tracking-tighter text-white uppercase leading-none">
          PRÓXIMOS <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-red-600">EVENTOS</span>
        </h1>
        <p class="text-xl text-white font-bold uppercase tracking-[0.3em]">Vive la cultura Wild Gvng en vivo</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {events.map((event) => (
          <div class="group relative flex flex-col rounded-[40px] bg-white/[0.02] border border-white/5 overflow-hidden hover:border-orange-500/30 transition-all duration-500">
            <!-- Event Image -->
            <div class="relative aspect-video overflow-hidden">
              <img src={event.image} alt={event.titulo} class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-110" />
              <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
              <div class="absolute top-6 left-6">
                <span class={`px-4 py-1.5 rounded-full text-[10px] font-black uppercase tracking-widest ${
                  event.status === 'disponible' ? 'bg-green-500 text-white' : 'bg-orange-500 text-white'
                }`}>
                  {event.status === 'disponible' ? 'Boletos Disponibles' : 'Próximamente'}
                </span>
              </div>
            </div>

            <!-- Event Info -->
            <div class="p-8 flex-1 flex flex-col justify-between space-y-6">
              <div class="space-y-4">
                <div class="space-y-1">
                  <p class="text-[10px] font-black uppercase tracking-[0.2em] text-orange-500">{event.fecha}</p>
                  <h3 class="text-3xl font-black uppercase tracking-tighter text-white group-hover:text-orange-500 transition-colors leading-none">{event.titulo}</h3>
                  <p class="text-sm font-bold text-white/40 uppercase tracking-widest">{event.lugar} // {event.ciudad}</p>
                </div>
                <p class="text-sm text-white/60 font-bold leading-relaxed line-clamp-2">
                  {event.descripcion}
                </p>
              </div>

              <div class="flex items-center justify-between pt-6 border-t border-white/5">
                <div>
                  <p class="text-[10px] font-black uppercase tracking-widest text-white/40">Desde</p>
                  <p class="text-2xl font-black text-white tracking-tighter">${event.precio_min}</p>
                </div>
                <a href={`/evento/${event.id}`} class="px-6 py-4 bg-white text-black text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-orange-500 hover:text-white transition-all transform hover:-translate-y-1">
                  Ver Detalles
                </a>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </main>
</Layout>
