---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Eventos",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};

// Fetch events from Supabase, fallback to mock data
let events = [];
try {
  const { data, error } = await supabase
    .from('events')
    .select('*')
    .eq('is_active', true)
    .order('event_date', { ascending: true });

  if (!error && data && data.length > 0) {
    events = data.map((e: any) => {
      const d = new Date(e.event_date);
      const months = ['ENE','FEB','MAR','ABR','MAY','JUN','JUL','AGO','SEP','OCT','NOV','DEC'];
      const fecha = `${d.getDate()} ${months[d.getMonth()]} ${d.getFullYear()}`;
      const hora = `${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')} HRS`;
      const statusMap: Record<string, string> = { battle: 'disponible', concert: 'proximo', meet_greet: 'disponible', other: 'proximo' };
      return {
        id: e.id,
        titulo: e.name,
        fecha,
        hora,
        lugar: e.location || 'Por confirmar',
        ciudad: e.location?.split(',').pop()?.trim() || 'Torreón',
        imagen: e.image_url || 'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=800&q=80',
        descripcion: e.description || '',
        precio_min: 0,
        status: statusMap[e.event_type] || 'proximo'
      };
    });
  } else {
    throw new Error('No events or error');
  }
} catch (e) {
  // Fallback mock data
  events = [
    {
      id: 'e1',
      titulo: 'WILD BATTLE VOL. 12',
      fecha: '15 JUL 2026',
      hora: '20:00 HRS',
      lugar: 'FORO WILD GVNG',
      ciudad: 'TORREÓN',
      imagen: 'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=800&q=80',
      descripcion: 'BATALLA DE FREESTYLE 1V1. 16 COMPETIDORES. PREMIO: $5,000 MXN + TOKENS.',
      precio_min: 200,
      status: 'disponible'
    },
    {
      id: 'e2',
      titulo: 'NOCHE UNDERGROUND',
      fecha: '02 AGO 2026',
      hora: '21:00 HRS',
      lugar: 'SALÓN CARIBE',
      ciudad: 'TORREÓN',
      imagen: 'https://images.unsplash.com/photo-1459749411177-042180ce673c?auto=format&fit=crop&w=800&q=80',
      descripcion: 'CONCIERTO CON ARTISTAS DE LA CREW. INVITADOS ESPECIALES DEL NORTE.',
      precio_min: 350,
      status: 'proximo'
    },
    {
      id: 'e3',
      titulo: 'MEET & GREET CREW',
      fecha: '20 AGO 2026',
      hora: '17:00 HRS',
      lugar: 'CASA BOSQUE',
      ciudad: 'TORREÓN',
      imagen: 'https://images.unsplash.com/photo-1589578236639-5381345b6687?auto=format&fit=crop&w=800&q=80',
      descripcion: 'CONOCE A LOS ARTISTAS DE WILD GVNG. FOTOS, AUTÓGRAFOS Y MERCH EXCLUSIVO.',
      precio_min: 0,
      status: 'disponible'
    }
  ];
}
---

<Layout config={config}>
  min-h-screen pb-20 selection:bg-wild-orange selection:text-black

    <!-- Top Bar -->
    <div class="bg-gradient-to-r from-black via-[#111] to-black border-b border-white/10 py-3">
        <div class="container mx-auto px-4 max-w-wide flex justify-between items-center">
            <span class="text-label-sm font-black uppercase tracking-widest text-wild-orange animate-pulse">Wild Tour 2026</span>
            <div class="flex gap-4">
                <span class="text-label-sm font-bold uppercase tracking-widest text-white">Tickets & VIP</span>
            </div>
        </div>
    </div>

    <div class="container mx-auto px-4 py-8 max-w-wide space-y-24 relative z-10 animate-fade-in-up">

      <!-- Header Brutalista -->
      <div class="border-b border-white/10 pb-8 mt-8 relative">
        <div class="absolute bottom-0 left-0 w-32 h-1 bg-wild-orange z-10"></div>
        <div class="flex flex-col md:flex-row items-end gap-6 mb-8">
          <h1 class="text-7xl md:text-9xl font-black tracking-tighter text-white uppercase leading-none hover:text-wild-orange transition-colors duration-500 cursor-default drop-shadow-2xl">
            TOUR
          </h1>
          <div class="flex flex-col mb-4 md:mb-6">
             <span class="text-xl font-bold text-white bg-wild-orange px-4 py-1 inline-block w-fit transform skew-x-12 shadow-lg shadow-wild-orange/20">SHOWS EN VIVO</span>
             <span class="text-sm font-mono text-gray-500 tracking-widest mt-2 text-right">MUNDIAL • 2024-2025</span>
          </div>
        </div>
      </div>

      <!-- Lista de Eventos (Estilo Ticket Moderno) -->
      <div class="space-y-12">
        {events.map((event, index) => (
          <div class="group relative flex flex-col lg:flex-row bg-neutral-950 border border-white/10 rounded-wild-lg overflow-hidden hover:border-wild-orange transition-all duration-300 hover:shadow-wild-glow hover:-translate-y-1 animate-stagger" style={`animation-delay: ${index * 100}ms`}>

            <!-- Caja de Fecha (Talón Izquierdo) -->
            <div class="lg:w-56 bg-white text-black p-8 flex flex-col justify-between border-b lg:border-b-0 lg:border-r border-dashed border-black/20 relative pattern-dots">
               <!-- Semi-círculos de perforación -->
               <div class="absolute -right-[8px] top-1/2 -translate-y-1/2 w-4 h-8 bg-black rounded-l-full hidden lg:block z-10"></div>
               <div class="absolute -left-[8px] top-1/2 -translate-y-1/2 w-4 h-8 bg-black rounded-r-full hidden lg:block z-10"></div>

               <div class="font-mono font-bold text-xl leading-none opacity-50">
                 N.º<span class="text-wild-orange">{String(index + 1).padStart(3, '0')}</span>
               </div>
               <div class="text-center my-6 lg:my-0">
                 <span class="block text-5xl font-black tracking-tighter">{event.fecha.split(' ')[0]}</span>
                 <span class="block text-2xl font-bold uppercase tracking-widest mt-1">{event.fecha.split(' ')[1]}</span>
               </div>
               <div class="font-mono text-xs font-black text-center border-2 border-black p-1 uppercase tracking-widest">
                 {event.hora}
               </div>
            </div>

            <!-- Main Info (Center) -->
            <div class="flex-1 p-6 lg:p-10 relative overflow-hidden">
               <!-- Background Image Faded -->
               <div class="absolute inset-0 opacity-20 group-hover:opacity-40 transition-opacity grayscale group-hover:grayscale-0 duration-700">
                  <img src={event.imagen} width="800" height="500" class="w-full h-full object-cover" />
               </div>
               <div class="absolute inset-0 bg-gradient-to-r from-neutral-950 via-neutral-950/90 to-transparent"></div>

               <div class="relative z-10 flex flex-col justify-between h-full space-y-6">
                  <div>
                    <div class="flex items-center gap-3 mb-4">
                       <div class="text-label-sm font-mono font-bold uppercase tracking-widest">
                         {event.status === 'sold_out' ? (
                           <span class="bg-red-600 text-white px-2 py-1 rounded">AGOTADO</span>
                         ) : event.status === 'proximo' ? (
                           <span class="bg-white/10 text-white px-2 py-1 rounded border border-white/10">PRÓXIMAMENTE</span>
                         ) : (
                           <span class="bg-wild-orange text-white px-2 py-1 rounded animate-pulse shadow-lg shadow-wild-orange/20">DISPONIBLE</span>
                         )}
                       </div>
                       <span class="text-white/50 text-sm font-mono tracking-widest uppercase flex items-center gap-2">
                         <span class="w-1.5 h-1.5 rounded-full bg-wild-orange"></span>
                         {event.ciudad}
                       </span>
                    </div>
                    <h2 class="text-4xl md:text-6xl font-black text-white uppercase tracking-tighter leading-none group-hover:text-white transition-colors drop-shadow-lg">
                      {event.titulo}
                    </h2>
                    <p class="text-wild-orange font-mono text-lg mt-2 uppercase font-bold tracking-tight">{event.lugar}</p>
                  </div>

                  <p class="text-gray-400 font-medium max-w-xl text-sm md:text-base uppercase tracking-wide border-l-4 border-wild-orange pl-4 py-1">
                     {event.descripcion}
                  </p>
               </div>
            </div>

            <!-- Action / Barcode (Right Stub) -->
            <div class="lg:w-72 bg-[#111] border-t lg:border-t-0 lg:border-l border-dashed border-white/10 p-8 flex flex-col justify-between items-center relative">

               <div class="w-full text-right mb-6">
                  <span class="block text-white/40 text-label-sm font-mono uppercase tracking-widest mb-1">General Admission</span>
                  <span class="block text-4xl font-black text-white">${event.precio_min}</span>
               </div>

               <!-- Barcode Visual -->
               <div class="w-full h-12 bg-white rounded-sm flex items-end justify-between px-3 pb-1 my-4 opacity-70 group-hover:opacity-100 transition-opacity mix-blend-screen">
                  {Array.from({ length: 24 }).map(() => (
                     <div class="bg-black w-[2px] h-[80%]"></div>
                  ))}
                  {Array.from({ length: 8 }).map(() => (
                     <div class="bg-black w-[4px] h-[100%]"></div>
                  ))}
               </div>

               <a href={`/evento/${event.id}`} class={`w-full py-4 px-6 font-black uppercase text-center text-xs tracking-[0.2em] rounded-wild-lg transition-all duration-300 transform active:scale-95 ${
                  event.status === 'sold_out'
                  ? 'bg-white/5 text-gray-500 cursor-not-allowed border border-white/5'
                  : 'bg-white text-black hover:bg-wild-orange hover:text-white hover:shadow-lg hover:shadow-wild-orange/30'
               }`}>
                  {event.status === 'sold_out' ? 'Sold Out' : 'Comprar Tickets'}
               </a>
            </div>

          </div>
        ))}
      </div>

    </div>
  </div>
</Layout>

<style is:global define:vars={{ streetAccent: tenant.primary_color }}>
  :root {
    --street-accent: var(--streetAccent);

    /* Wild Palette Shared */
    --wild-orange: #FF5500;
    --wild-light-orange: #FF8C00;
    --wild-blood: #8A0303;
    --wild-crimson: #DC143C;
    --wild-dark-red: #4A0404;
  }

  .pattern-dots {
    background-image: radial-gradient(#000 1px, transparent 1px);
    background-size: 10px 10px;
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }

  .animate-stagger {
    opacity: 0;
    animation: fadeInUp 0.6s cubic-bezier(0.4, 0, 0.2, 1) forwards;
  }
</style>
