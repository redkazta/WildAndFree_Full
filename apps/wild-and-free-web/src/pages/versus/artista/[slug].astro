// Merge DB data with Mock Data
const mockArtist = mockArtists.find(a => a.slug === slug);
const artist = dbArtist ? {
    ...dbArtist,
    stats: dbArtist.stats || (mockArtist ? mockArtist.stats : {}),
    tracks: mockArtist ? mockArtist.tracks : [],
    estilo: mockArtist ? mockArtist.estilo : '',
    origen: mockArtist ? mockArtist.origen : ''
} : mockArtist;

if (!artist) {
  return Astro.redirect('/404');
}

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: `Versus - ${artist.nombre}`,
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};
---

<Layout config={config}>
  <div class="min-h-screen bg-[#0a0a0a] text-white font-sans overflow-hidden relative selection:bg-[var(--wild-orange)] selection:text-black">
    
    <!-- ARCADE BACKGROUND -->
    <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-30 pointer-events-none z-0"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-black via-transparent to-black pointer-events-none z-0"></div>
    
    <!-- TOP BAR -->
    <div class="relative z-50 bg-black/90 backdrop-blur-md border-b border-white/10 py-3">
        <div class="container mx-auto px-4 flex justify-between items-center">
            <a href="/versus" class="flex items-center gap-3 hover:text-[var(--primary)] transition-colors">
                <div class="w-3 h-3 bg-[var(--primary)] animate-pulse rounded-full shadow-[0_0_10px_var(--primary)]"></div>
                <span class="text-xs font-black uppercase tracking-[0.2em] arcade-font">&lt; VOLVER A VERSUS</span>
            </a>
            <div class="text-xs font-mono text-gray-500 font-bold">FASE: ANÁLISIS DE CARTA</div>
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="container mx-auto px-4 py-8 h-[calc(100vh-60px)] flex items-center justify-center">
        
        <div class="w-full max-w-6xl bg-black/40 border-4 border-white/10 rounded-xl flex flex-col md:flex-row overflow-hidden backdrop-blur-md relative group animate-fade-in-down h-[80vh]">
            
             <!-- Corner Decorations -->
             <div class="absolute top-0 left-0 w-8 h-8 border-t-4 border-l-4 border-[var(--primary)] rounded-tl-lg z-20"></div>
             <div class="absolute top-0 right-0 w-8 h-8 border-t-4 border-r-4 border-[var(--primary)] rounded-tr-lg z-20"></div>
             <div class="absolute bottom-0 left-0 w-8 h-8 border-b-4 border-l-4 border-[var(--primary)] rounded-bl-lg z-20"></div>
             <div class="absolute bottom-0 right-0 w-8 h-8 border-b-4 border-r-4 border-[var(--primary)] rounded-br-lg z-20"></div>

            <!-- BIG PORTRAIT (LEFT) -->
            <div class="w-full md:w-5/12 h-1/2 md:h-full relative overflow-hidden bg-black border-r-4 border-[var(--primary)]/50">
                <img src={artist.imagenes.profile} class="w-full h-full object-cover object-top opacity-90 contrast-125 transition-transform duration-[5s] hover:scale-110" />
                <div class="absolute inset-0 bg-gradient-to-r from-black/60 via-transparent to-transparent"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-black via-transparent to-transparent"></div>
                
                <!-- Character Name Plate -->
                <div class="absolute bottom-8 left-0 bg-gradient-to-r from-[var(--secondary)] to-transparent py-3 px-8 w-full transform -skew-x-12 -translate-x-4 border-t border-white/20 border-b border-white/20">
                    <h2 class="text-4xl md:text-5xl font-black text-white italic uppercase tracking-tighter leading-none drop-shadow-md transform skew-x-12 pl-4" style="text-shadow: 3px 3px 0px #000;">
                        {artist.nombre}
                    </h2>
                    <p class="text-[10px] font-black uppercase tracking-[0.4em] text-white/80 transform skew-x-12 pl-4 mt-1">{artist.estilo} • {artist.origen}</p>
                </div>
            </div>

            <!-- STATS & INFO (RIGHT) -->
            <div class="w-full md:w-7/12 h-1/2 md:h-full bg-zinc-900/95 p-6 md:p-12 flex flex-col justify-between relative overflow-hidden">
                
                <!-- Background Element -->
                <div class="absolute top-0 right-0 text-[200px] font-black text-white/5 leading-none pointer-events-none select-none -translate-y-4 translate-x-4 overflow-hidden">VS</div>

                <div class="space-y-8 relative z-10">
                    <!-- Bio Section -->
                    <div class="border-l-4 border-[var(--primary)] pl-4 py-2 bg-white/5 rounded-r-lg backdrop-blur-sm">
                        <h4 class="text-[10px] font-black uppercase text-[var(--primary)] tracking-widest mb-1 flex items-center gap-2">
                            <span class="w-2 h-2 bg-[var(--primary)] rounded-full"></span>
                            Perfil de Carta
                        </h4>
                        <p class="text-gray-300 font-medium text-sm leading-relaxed italic">"{artist.bio}"</p>
                    </div>
                    
                    <!-- STAT BARS -->
                    <div class="space-y-4 pt-2">
                        <!-- Power -->
                        <div class="flex items-center gap-3 group/stat">
                            <span class="w-20 text-xs font-black text-red-500 uppercase tracking-wider group-hover/stat:scale-110 transition-transform">Poder</span>
                            <div class="flex-1 h-5 bg-black border border-white/20 skew-x-[-12deg] overflow-hidden relative">
                                <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/diagonal-stripes.png')] opacity-20"></div>
                                <div class="h-full bg-gradient-to-r from-red-900 via-red-600 to-red-400 w-0 animate-fill-bar" style={`width: ${artist.stats.power || 80}%; animation-delay: 0.1s`}></div>
                            </div>
                            <span class="text-sm font-black font-mono text-white w-8 text-right">{artist.stats.power || 80}</span>
                        </div>
                        <!-- Speed -->
                        <div class="flex items-center gap-3 group/stat">
                            <span class="w-20 text-xs font-black text-blue-400 uppercase tracking-wider group-hover/stat:scale-110 transition-transform">Velocidad</span>
                            <div class="flex-1 h-5 bg-black border border-white/20 skew-x-[-12deg] overflow-hidden relative">
                                <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/diagonal-stripes.png')] opacity-20"></div>
                                <div class="h-full bg-gradient-to-r from-blue-900 via-blue-600 to-cyan-400 w-0 animate-fill-bar" style={`width: ${artist.stats.speed || 75}%; animation-delay: 0.2s`}></div>
                            </div>
                            <span class="text-sm font-black font-mono text-white w-8 text-right">{artist.stats.speed || 75}</span>
                        </div>
                        <!-- Tech -->
                        <div class="flex items-center gap-3 group/stat">
                            <span class="w-20 text-xs font-black text-green-500 uppercase tracking-wider group-hover/stat:scale-110 transition-transform">Técnica</span>
                            <div class="flex-1 h-5 bg-black border border-white/20 skew-x-[-12deg] overflow-hidden relative">
                                <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/diagonal-stripes.png')] opacity-20"></div>
                                <div class="h-full bg-gradient-to-r from-green-900 via-green-600 to-lime-400 w-0 animate-fill-bar" style={`width: ${artist.stats.technique || 85}%; animation-delay: 0.3s`}></div>
                            </div>
                            <span class="text-sm font-black font-mono text-white w-8 text-right">{artist.stats.technique || 85}</span>
                        </div>
                    </div>
                </div>

                <!-- SPECIAL MOVES (TRACKS) -->
                <div class="mt-8 relative z-10 flex-1 overflow-y-auto custom-scrollbar pr-2 min-h-0">
                    <h3 class="text-sm font-black text-white uppercase mb-4 border-b border-white/20 pb-2 flex justify-between items-center bg-white/5 px-3 py-2 rounded">
                        <span class="text-[var(--primary)]">Habilidades Especiales</span>
                        <span class="text-[10px] text-gray-400 tracking-widest">SKILLS // MOVES</span>
                    </h3>
                    <ul class="space-y-3">
                        {(artist.tracks || ['Pista Desconocida 1', 'Pista Desconocida 2']).map((track: string, i: number) => (
                            <li class="flex items-center justify-between group cursor-pointer hover:bg-white/10 p-3 rounded transition-all border border-transparent hover:border-[var(--primary)]/30">
                                <div class="flex items-center gap-4">
                                    <span class="text-[var(--primary)] font-black font-mono text-xs w-20 text-right opacity-70 group-hover:opacity-100 transition-opacity">LVL {[1, 2, 3, 5][i]}</span>
                                    <span class="text-white font-bold uppercase text-xs md:text-sm group-hover:text-[var(--primary)] transition-colors tracking-wide">{track}</span>
                                </div>
                                <div class="flex gap-1">
                                    <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse"></span>
                                    <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse delay-75"></span>
                                    <span class="w-2 h-2 rounded-full bg-red-500 animate-pulse delay-150"></span>
                                </div>
                            </li>
                        ))}
                    </ul>
                </div>

            </div>
        </div>
    </div>
  </div>
</Layout>

<style>
  .arcade-font {
    font-family: 'Courier New', Courier, monospace;
  }
  
  .custom-scrollbar::-webkit-scrollbar {
    width: 6px;
  }
  .custom-scrollbar::-webkit-scrollbar-track {
    background: rgba(255,255,255,0.05);
  }
  .custom-scrollbar::-webkit-scrollbar-thumb {
    background: var(--primary);
    border-radius: 3px;
  }
  
  @keyframes slideInLeft {
    from { transform: translateX(-50px); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
  }
  @keyframes slideInRight {
    from { transform: translateX(50px); opacity: 0; }
    to { transform: translateX(0); opacity: 1; }
