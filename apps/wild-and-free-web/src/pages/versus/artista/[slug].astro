import tenantConfig from '../../../../../../packages/shared-types/tenant-config.json';

export async function getStaticPaths() {
  // Same mock data source as versus.astro to ensure paths exist
  const mockArtists = [
    { slug: 'lil-kiro' }, { slug: 'fantasma-neon' }, { slug: 'sombra-v' }, { slug: 'onda-cristal' },
    { slug: 'jinete-nocturno' }, { slug: 'nova-k' }, { slug: 'sable' }, { slug: 'tormenta' },
    { slug: 'vibora-x' }, { slug: 'luna-negra' }, { slug: 'rojo-fuego' }, { slug: 'ciber-punk' },
    { slug: 'fantasma-g' }, { slug: 'microfono-de-hierro' }, { slug: 'rosa-de-terciopelo' },
    { slug: 'toxico-b' }, { slug: 'llamarada-solar' }, { slug: 'hielo-seco' }, { slug: 'la-bestia' },
    { slug: 'karmma' }
  ];

  let dbSlugs: string[] = [];
  try {
    const { data: dbArtists } = await supabase.from('artists').select('slug');
    if (dbArtists) {
      dbSlugs = dbArtists.map((a: any) => a.slug);
    }
  } catch (e) {
    console.warn('Could not fetch artists from Supabase during build.');
  }

  const allSlugs = [...new Set([...mockArtists.map(a => a.slug), ...dbSlugs])];
  return allSlugs.map(slug => ({ params: { slug } }));
}

const { slug } = Astro.params;

// --- DATA FETCHING (Same as versus.astro to ensure consistency) ---
let dbArtist = null;
try {
  const { data, error } = await supabase
    .from('artists')
    .select('*')
    .eq('slug', slug)
    .single();
  if (!error) dbArtist = data;
} catch (e) {
  console.warn('Could not fetch artist from Supabase.');
}

