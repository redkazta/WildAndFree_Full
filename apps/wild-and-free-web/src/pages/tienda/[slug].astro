---
import Layout from '../../layouts/Layout.astro';
import { supabase } from '../../lib/supabase';
import tenantConfig from '../../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Producto",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};

export async function getStaticPaths() {
  const { data: products } = await supabase
    .from('store_products')
    .select('slug')
    .eq('is_active', true);

  if (!products) return [];
  return products
    .filter((p: any) => p.slug)
    .map((p: any) => ({ params: { slug: p.slug } }));
}

const { slug } = Astro.params;
let product: any = null;
let variants: any[] = [];
let relatedProducts: any[] = [];

if (slug) {
  const { data } = await supabase
    .from('store_products')
    .select('*')
    .eq('slug', slug)
    .single();
  if (data) {
    product = {
      id: data.id, name: data.name, price: Number(data.base_price),
      image: data.image_url || '', category: data.category || 'otros',
      description: data.description || '', inStock: data.is_active !== false,
      slug: data.slug || slug
    };

    // Fetch variants
    const { data: vData } = await supabase
      .from('product_variants')
      .select('*')
      .eq('product_id', data.id)
      .order('color', { ascending: true })
      .order('size', { ascending: true });

    if (vData && vData.length > 0) {
      variants = vData.map((v: any) => ({
        id: v.id, size: v.size, color: v.color,
        stock: v.stock, sku: v.sku, image_url: v.image_url || ''
      }));
    }

    // Related products
    const { data: related } = await supabase
      .from('store_products')
      .select('*')
      .eq('is_active', true)
      .neq('id', data.id)
      .limit(4);
    if (related) {
      relatedProducts = related.map((p: any) => ({
        id: p.id, name: p.name, price: Number(p.base_price),
        image: p.image_url || '', slug: p.slug || '', inStock: p.is_active !== false
      }));
    }
  }
}

// Extract unique sizes and colors maintaining order
const uniqueSizes = [...new Set(variants.map((v: any) => v.size))];
const uniqueColors = [...new Set(variants.map((v: any) => v.color))];
const hasVariants = variants.length > 0;
const firstVariant = variants[0] || null;

// Serialized for client-side use
const variantsJson = JSON.stringify(variants);
const uniqueColorsJson = JSON.stringify(uniqueColors);
const uniqueSizesJson = JSON.stringify(uniqueSizes);
---

<Layout config={config}>
  <div class="min-h-screen bg-[var(--bg)] text-[var(--text)] pb-20">
    <div class="max-w-6xl mx-auto px-4 md:px-8 pt-8">
      <nav class="flex items-center gap-2 text-xs text-[var(--text-muted)]">
        <a href="/tienda" class="hover:text-[var(--primary)] transition-colors">Tienda</a>
        <span>/</span>
        {product && <span class="text-[var(--text)]">{product.category}</span>}
        <span>/</span>
        <span class="text-[var(--primary)]">{product?.name || 'Producto'}</span>
      </nav>
    </div>

    {product ? (
      <div class="max-w-6xl mx-auto px-4 md:px-8 py-8" id="product-page" data-variants={variantsJson} data-colors={uniqueColorsJson} data-sizes={uniqueSizesJson}>
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
          <!-- IMAGE -->
          <div class="relative aspect-square bg-[var(--bg-card)] rounded-2xl border border-[var(--border-faint)] overflow-hidden flex items-center justify-center">
            {product.image ? (
              <img src={product.image} alt={product.name} class="w-full h-full object-cover" />
            ) : (
              <div class="flex flex-col items-center gap-3 bg-[var(--bg-card)] w-full h-full absolute inset-0 justify-center">
                <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                <span class="text-sm font-bold text-[var(--text-muted)]">Sin imagen</span>
              </div>
            )}
            {!product.inStock && (
              <div class="absolute inset-0 bg-[var(--bg)]/80 flex items-center justify-center">
                <span class="text-[var(--text)] text-lg font-black uppercase tracking-[0.2em] border-2 border-[var(--text)] px-4 py-2 -rotate-12">Agotado</span>
              </div>
            )}
          </div>

          <!-- INFO -->
          <div class="flex flex-col gap-6" id="product-info">
            <div>
              <p class="text-xs font-bold uppercase tracking-widest text-[var(--primary)] mb-2">{product.category}</p>
              <h1 class="text-3xl md:text-4xl font-black uppercase leading-tight">{product.name}</h1>
            </div>
            <p class="text-3xl font-black text-[var(--primary)]">${product.price}</p>
            {product.description && <p class="text-sm text-[var(--text-secondary)] leading-relaxed">{product.description}</p>}

            {hasVariants && (
              <>
                <!-- COLOR SELECTOR -->
                <div>
                  <label class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] mb-3 block">Color: <span id="selected-color" class="text-[var(--text)]">{uniqueColors[0]}</span></label>
                  <div class="flex gap-2 flex-wrap" id="color-options">
                    {uniqueColors.map((color: string, ci: number) => {
                      const isFirst = ci === 0;
                      const colorHex = color === 'Negro' ? '#000000' : color === 'Blanco' ? '#ffffff' : color === 'Gris oscuro' ? '#444444' : '#888888';
                      const borderCls = color === 'Blanco' ? 'border-[var(--border)]' : 'border-transparent';
                      return (
                        <button class={`color-btn w-10 h-10 rounded-full border-2 ${isFirst ? 'ring-2 ring-[var(--primary)]' : ''} ${borderCls} transition-all hover:scale-110`} data-color={color} style={{background: colorHex}} title={color}></button>
                      );
                    })}
                  </div>
                </div>

                <!-- SIZE SELECTOR -->
                <div>
                  <label class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] mb-3 block">Talla: <span id="selected-size" class="text-[var(--text)]">{uniqueSizes[0]}</span></label>
                  <div class="flex gap-2 flex-wrap" id="size-options">
                    {uniqueSizes.map((size: string, si: number) => {
                      const isFirst = si === 0;
                      return (
                        <button class={`size-btn px-5 py-2.5 rounded-lg border text-xs font-black uppercase tracking-wider transition-all ${isFirst ? 'bg-[var(--primary)] text-[var(--bg)] border-[var(--primary)]' : 'border-[var(--border)] text-[var(--text)] hover:border-[var(--primary)] hover:text-[var(--primary)]'}`} data-size={size}>{size}</button>
                      );
                    })}
                  </div>
                </div>
              </>
            )}

            <!-- STOCK & SKU -->
            {firstVariant && (
              <div class="flex items-center gap-4 text-[10px] font-bold uppercase tracking-wider">
                <span class="text-[var(--text-muted)]">SKU: <span id="variant-sku" class="text-[var(--text)]">{firstVariant.sku}</span></span>
                <span class="text-[var(--border)]">|</span>
                <span class="text-[var(--text-muted)]">Stock: <span id="variant-stock" class="text-[var(--primary)]">{firstVariant.stock} uds.</span></span>
              </div>
            )}

            <!-- QUANTITY -->
            <div>
              <label class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] mb-2 block">Cantidad</label>
              <div class="flex items-center gap-3">
                <button id="qty-minus" class="w-10 h-10 rounded-lg border border-[var(--border)] flex items-center justify-center text-[var(--text)] hover:bg-[var(--bg-card)] transition-colors font-bold text-lg">−</button>
                <span id="qty-value" class="text-lg font-black w-8 text-center">1</span>
                <button id="qty-plus" class="w-10 h-10 rounded-lg border border-[var(--border)] flex items-center justify-center text-[var(--text)] hover:bg-[var(--bg-card)] transition-colors font-bold text-lg">+</button>
              </div>
            </div>

            <!-- ACTIONS -->
            <div class="flex gap-3 mt-2">
              <button id="add-to-cart-main"
                class="flex-1 py-4 rounded-xl font-black text-xs uppercase tracking-[0.15em] transition-all bg-[var(--primary)] text-[var(--bg)] hover:brightness-110"
                disabled={!product.inStock}
                data-product={JSON.stringify(product)}>
                {product.inStock ? 'Agregar al Carrito' : 'Agotado'}
              </button>
              <button id="toggle-wishlist-main"
                class="w-14 h-14 rounded-xl border border-[var(--border)] flex items-center justify-center text-[var(--text-muted)] hover:text-[#DC143C] hover:border-[#DC143C] transition-all toggle-wishlist-btn"
                data-product={JSON.stringify(product)}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
              </button>
            </div>

            <!-- SHIPPING INFO -->
            <div class="border border-[var(--border-faint)] rounded-xl p-4 space-y-2 text-xs text-[var(--text-muted)]">
              <div class="flex items-center gap-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                <span>Envío gratis en pedidos mayores a $999</span>
              </div>
              <div class="flex items-center gap-2">
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/></svg>
                <span>Devoluciones sin costo</span>
              </div>
            </div>
          </div>
        </div>

        {relatedProducts.length > 0 && (
          <section class="mt-16">
            <div class="flex items-center gap-4 mb-6">
              <span class="w-2 h-8 bg-[var(--primary)] rounded-sm"></span>
              <h2 class="text-xl font-black uppercase tracking-tight">También te puede gustar</h2>
              <div class="h-[1px] flex-1 bg-[var(--border-faint)]"></div>
            </div>
            <div class="grid grid-cols-2 md:grid-cols-4 gap-5">
              {relatedProducts.map(rp => (
                <a href={`/tienda/${rp.slug}`} class="group bg-[var(--bg)] rounded-xl overflow-hidden border border-[var(--border-faint)] hover:border-[var(--primary)]/40 transition-all block">
                  <div class="aspect-square bg-[var(--bg-card)] overflow-hidden flex items-center justify-center">
                    {rp.image ? (
                      <img src={rp.image} alt={rp.name} class="w-full h-full object-cover group-hover:scale-105 transition-all duration-500" />
                    ) : (
                      <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
                    )}
                  </div>
                  <div class="p-3">
                    <p class="text-xs font-bold line-clamp-1">{rp.name}</p>
                    <p class="text-sm font-black text-[var(--primary)] mt-1">${rp.price}</p>
                  </div>
                </a>
              ))}
            </div>
          </section>
        )}
      </div>
    ) : (
      <div class="max-w-6xl mx-auto px-4 md:px-8 py-20 text-center">
        <p class="text-xl font-black text-[var(--text-muted)] uppercase">Producto no encontrado</p>
        <a href="/tienda" class="inline-block mt-4 px-6 py-3 bg-[var(--primary)] text-[var(--bg)] rounded-xl font-bold text-xs uppercase tracking-wider">Volver a la Tienda</a>
      </div>
    )}
  </div>
</Layout>

<div id="cart-toast" class="fixed bottom-24 left-1/2 -translate-x-1/2 bg-[var(--primary)] text-[var(--bg)] px-6 py-3 rounded-full shadow-2xl flex items-center gap-3 translate-y-24 opacity-0 transition-all duration-300 z-50">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6L9 17l-5-5"/></svg>
  <span class="text-xs font-black uppercase tracking-wider" id="cart-toast-message">Agregado al carrito</span>
</div>

<div id="wishlist-toast" class="fixed bottom-8 left-1/2 -translate-x-1/2 bg-[var(--bg)] border border-[#DC143C] text-[var(--text)] px-6 py-3 rounded-full shadow-2xl flex items-center gap-3 translate-y-24 opacity-0 transition-all duration-300 z-50">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="#DC143C" stroke="none"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
  <span class="text-xs font-bold uppercase tracking-wider" id="wishlist-toast-message">Agregado a tu lista</span>
</div>

<style>
  .color-btn { position: relative; cursor: pointer; }
  .color-btn:hover::after { content: ''; position: absolute; inset: -3px; border-radius: 50%; border: 2px solid var(--primary); }
</style>

<script>
  import { cartStore } from '../../lib/cart.js';

  var attachProduct = function() {
    var pageEl = document.getElementById('product-page');
    if (!pageEl) return;
    var product = JSON.parse(document.getElementById('add-to-cart-main')?.dataset.product || '{}');
    var allVariants = JSON.parse(pageEl?.dataset.variants || '[]');
    var colors = JSON.parse(pageEl?.dataset.colors || '[]');
    var sizes = JSON.parse(pageEl?.dataset.sizes || '[]');
    var hasVariants = allVariants.length > 0;
    var qty = 1;

    // Variant state (only used if hasVariants)
    var selectedColor = colors[0] || null;
    var selectedSize = sizes[0] || null;
    var currentVariant = hasVariants ? (allVariants.find(function(v) { return v.color === selectedColor && v.size === selectedSize; }) || allVariants[0]) : null;

    function getVariant(color, size) {
      return allVariants.find(function(v) { return v.color === color && v.size === size; }) || null;
    }

    function updateVariantDisplay() {
      if (!hasVariants) return;
      currentVariant = getVariant(selectedColor, selectedSize) || currentVariant;
      if (currentVariant) {
        var skuEl = document.getElementById('variant-sku');
        var stockEl = document.getElementById('variant-stock');
        if (skuEl) skuEl.textContent = currentVariant.sku;
        if (stockEl) stockEl.textContent = currentVariant.stock + ' uds.';
      }
    }

    function updateSizeAvailability() {
      if (!hasVariants) return;
      document.querySelectorAll('.size-btn').forEach(function(btn) {
        var size = btn.dataset.size;
        var v = getVariant(selectedColor, size);
        if (!v || v.stock <= 0) {
          btn.disabled = true;
          btn.classList.add('opacity-30', 'cursor-not-allowed', 'line-through');
        } else {
          btn.disabled = false;
          btn.classList.remove('opacity-30', 'cursor-not-allowed', 'line-through');
        }
      });
    }

    // Variant selectors (only if variants exist)
    if (hasVariants) {
      document.querySelectorAll('.color-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          document.querySelectorAll('.color-btn').forEach(function(b) { b.classList.remove('ring-2', 'ring-[var(--primary)]'); });
          this.classList.add('ring-2', 'ring-[var(--primary)]');
          selectedColor = this.dataset.color;
          var selEl = document.getElementById('selected-color');
          if (selEl) selEl.textContent = selectedColor;
          updateVariantDisplay();
          updateSizeAvailability();
        });
      });

      document.querySelectorAll('.size-btn').forEach(function(btn) {
        btn.addEventListener('click', function() {
          if (this.disabled) return;
          document.querySelectorAll('.size-btn').forEach(function(b) {
            b.className = b.className.replace(/bg-\[var\(--primary\)\] text-\[var\(--bg\)\] border-\[var\(--primary\)\]/, '');
            b.classList.add('border-[var(--border)]', 'text-[var(--text)]');
            b.classList.remove('bg-[var(--primary)]', 'text-[var(--bg)]', 'border-[var(--primary)]');
          });
          this.classList.add('bg-[var(--primary)]', 'text-[var(--bg)]', 'border-[var(--primary)]');
          this.classList.remove('border-[var(--border)]', 'text-[var(--text)]');
          selectedSize = this.dataset.size;
          var selEl = document.getElementById('selected-size');
          if (selEl) selEl.textContent = selectedSize;
          updateVariantDisplay();
        });
      });

      // Init variant display
      updateVariantDisplay();
      updateSizeAvailability();
    }

    // --- ALWAYS ATTACHED (Qty, Cart, Wishlist) ---

    // Quantity
    var qtyValue = document.getElementById('qty-value');
    document.getElementById('qty-minus')?.addEventListener('click', function() {
      if (qty > 1) { qty--; if (qtyValue) qtyValue.textContent = String(qty); }
    });
    document.getElementById('qty-plus')?.addEventListener('click', function() {
      var max = currentVariant?.stock || 99;
      if (qty < max) { qty++; if (qtyValue) qtyValue.textContent = String(qty); }
    });

    // Add to cart
    document.getElementById('add-to-cart-main')?.addEventListener('click', async function() {
      try {
        if (hasVariants) {
          currentVariant = getVariant(selectedColor, selectedSize) || allVariants[0];
          if (!currentVariant || currentVariant.stock <= 0) { alert('Esta variante está agotada'); return; }
        }

        var item = {
          id: product.id,
          name: product.name || 'Producto',
          price: Number(product.price) || 0,
          image: product.image || ''
        };
        if (hasVariants) {
          item.variant_id = currentVariant.id;
          item.size = selectedSize;
          item.color = selectedColor;
          item.sku = currentVariant.sku;
        }
        await cartStore.addToCart(item, qty);
        
        // Show toast confirmation, stay on page
        var toast = document.getElementById('cart-toast');
        var msg = document.getElementById('cart-toast-message');
        if (msg) msg.textContent = item.name + ' agregado al carrito';
        if (toast) {
          toast.classList.remove('translate-y-24', 'opacity-0');
          setTimeout(function() {
            toast.classList.add('translate-y-24', 'opacity-0');
          }, 2500);
        }
      } catch (err) {
        console.error('[product] add-to-cart error:', err);
      }
    });

    // Wishlist
    document.getElementById('toggle-wishlist-main')?.addEventListener('click', async function() {
      try {
        var was = cartStore.isInWishlist(product.id);
        await cartStore.toggleWishlist(product);
        var toast = document.getElementById('wishlist-toast');
        var msg = document.getElementById('wishlist-toast-message');
        var icon = this.querySelector('svg');
        if (!was) {
          if (icon) icon.style.fill = 'currentColor';
          this.classList.add('text-[#DC143C]');
          if (msg) msg.textContent = product.name + ' guardado';
        } else {
          if (icon) icon.style.fill = 'none';
          this.classList.remove('text-[#DC143C]');
          if (msg) msg.textContent = product.name + ' eliminado';
        }
        if (toast) {
          toast.classList.remove('translate-y-24', 'opacity-0');
          setTimeout(function() { toast.classList.add('translate-y-24', 'opacity-0'); }, 2500);
        }
      } catch (err) {
        console.error('[product] wishlist error:', err);
      }
    });

    // Save to recently viewed
    function saveRecentlyViewed() {
      if (!product.id) return;
      try {
        var viewed = JSON.parse(localStorage.getItem('wild_recently_viewed') || '[]');
        viewed = viewed.filter(function(p) { return p.id !== product.id; });
        viewed.unshift({ id: product.id, name: product.name, price: product.price, image: product.image, slug: product.slug || '' });
        if (viewed.length > 8) viewed = viewed.slice(0, 8);
        localStorage.setItem('wild_recently_viewed', JSON.stringify(viewed));
      } catch(e) {}
    }
    saveRecentlyViewed();
  };

  // Init cart
  var initDetail = async function() {
    if (!cartStore.initialized) await cartStore.init();
  };
  initDetail();
  attachProduct();
  document.addEventListener('astro:page-load', function() {
    initDetail();
    attachProduct();
  });
</script>
