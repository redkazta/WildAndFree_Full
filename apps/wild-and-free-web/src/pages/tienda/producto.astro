---
import Layout from '../../layouts/Layout.astro';
import tenantConfig from '../../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Producto",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};
---

<Layout config={config}>
  <div class="min-h-screen bg-[var(--bg)] text-[var(--text)] pb-20">
    <!-- Breadcrumb -->
    <div class="max-w-6xl mx-auto px-4 md:px-8 pt-8">
      <nav class="flex items-center gap-2 text-xs text-[var(--text-muted)]">
        <a href="/tienda" class="hover:text-[var(--primary)] transition-colors">Tienda</a>
        <span>/</span>
        <span id="bc-category" class="text-[var(--text)]"></span>
        <span>/</span>
        <span id="bc-name" class="text-[var(--primary)]">Cargando...</span>
      </nav>
    </div>

    <!-- Loading state -->
    <div id="product-loading" class="max-w-6xl mx-auto px-4 md:px-8 py-20 text-center">
      <p class="text-[var(--text-muted)] animate-pulse">Cargando producto...</p>
    </div>

    <!-- Product content (hidden until loaded) -->
    <div id="product-content" class="hidden max-w-6xl mx-auto px-4 md:px-8 py-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10">
        <!-- Imagen -->
        <div class="relative aspect-square bg-[var(--bg-card)] rounded-2xl border border-[var(--border-faint)] overflow-hidden flex items-center justify-center" id="product-image-container">
        </div>

        <!-- Info -->
        <div class="flex flex-col gap-6">
          <div>
            <p class="text-xs font-bold uppercase tracking-widest text-[var(--primary)] mb-2" id="product-category"></p>
            <h1 class="text-3xl md:text-4xl font-black uppercase leading-tight" id="product-name"></h1>
          </div>
          <p class="text-3xl font-black text-[var(--primary)]" id="product-price"></p>
          <p class="text-sm text-[var(--text-secondary)] leading-relaxed" id="product-description"></p>
          <!-- Cantidad -->
          <div>
            <label class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] mb-2 block">Cantidad</label>
            <div class="flex items-center gap-3">
              <button id="qty-minus" class="w-10 h-10 rounded-lg border border-[var(--border)] flex items-center justify-center text-[var(--text)] hover:bg-[var(--bg-card)] transition-colors font-bold text-lg">−</button>
              <span id="qty-value" class="text-lg font-black w-8 text-center">1</span>
              <button id="qty-plus" class="w-10 h-10 rounded-lg border border-[var(--border)] flex items-center justify-center text-[var(--text)] hover:bg-[var(--bg-card)] transition-colors font-bold text-lg">+</button>
            </div>
          </div>
          <!-- Acciones -->
          <div class="flex gap-3 mt-2">
            <button id="add-to-cart-main" class="flex-1 py-4 rounded-xl font-black text-xs uppercase tracking-[0.15em] transition-all bg-[var(--primary)] text-[var(--bg)] hover:brightness-110">
              Agregar al Carrito
            </button>
            <button id="toggle-wishlist-main" class="w-14 h-14 rounded-xl border border-[var(--border)] flex items-center justify-center text-[var(--text-muted)] hover:text-[#DC143C] hover:border-[#DC143C] transition-all">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
            </button>
          </div>
          <!-- Envío info -->
          <div class="border border-[var(--border-faint)] rounded-xl p-4 space-y-2 text-xs text-[var(--text-muted)]">
            <div class="flex items-center gap-2">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="1" y="3" width="15" height="13"/><polygon points="16 8 20 8 23 11 23 16 16 16 16 8"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
              <span>Envío gratis en pedidos mayores a $999</span>
            </div>
            <div class="flex items-center gap-2">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/></svg>
              <span>Devoluciones sin costo</span>
            </div>
          </div>
        </div>
      </div>

      <!-- Productos Relacionados -->
      <section id="related-section" class="mt-16 hidden">
        <div class="flex items-center gap-4 mb-6">
          <span class="w-2 h-8 bg-[var(--primary)] rounded-sm"></span>
          <h2 class="text-xl font-black uppercase tracking-tight">También te puede gustar</h2>
          <div class="h-[1px] flex-1 bg-[var(--border-faint)]"></div>
        </div>
        <div id="related-grid" class="grid grid-cols-2 md:grid-cols-4 gap-5"></div>
      </section>
    </div>

    <!-- Not found -->
    <div id="product-not-found" class="hidden max-w-6xl mx-auto px-4 md:px-8 py-20 text-center">
      <p class="text-xl font-black text-[var(--text-muted)] uppercase">Producto no encontrado</p>
      <a href="/tienda" class="inline-block mt-4 px-6 py-3 bg-[var(--primary)] text-[var(--bg)] rounded-xl font-bold text-xs uppercase tracking-wider">Volver a la Tienda</a>
    </div>
  </div>
</Layout>

<!-- Toast wishlist -->
<div id="wishlist-toast" class="fixed bottom-8 left-1/2 -translate-x-1/2 bg-[var(--bg)] border border-[#DC143C] text-[var(--text)] px-6 py-3 rounded-full shadow-2xl flex items-center gap-3 translate-y-24 opacity-0 transition-all duration-300 z-50">
  <svg width="16" height="16" viewBox="0 0 24 24" fill="#DC143C" stroke="none"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"></path></svg>
  <span class="text-xs font-bold uppercase tracking-wider" id="wishlist-toast-message">Agregado a tu lista</span>
</div>

<script>
  import { cartStore } from '../../lib/cart.js';
  import { supabase } from '../../lib/supabase.js';

  let currentProduct: any = null;
  let qty = 1;

  function setImageFallback(container: HTMLElement) {
    container.innerHTML = `
      <div class="flex flex-col items-center gap-3 bg-[var(--bg-card)] w-full h-full absolute inset-0 justify-center">
        <svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><text x="12" y="16" text-anchor="middle" font-size="10" font-weight="900" fill="var(--text-muted)" stroke="none">?</text></svg>
        <span class="text-sm font-bold text-[var(--text-muted)]">Sin imagen</span>
      </div>`;
  }

  async function loadProduct() {
    const params = new URLSearchParams(window.location.search);
    const productId = params.get('id');

    if (!productId) {
      document.getElementById('product-loading')!.classList.add('hidden');
      document.getElementById('product-not-found')!.classList.remove('hidden');
      return;
    }

    const { data, error } = await supabase
      .from('store_products')
      .select('*')
      .eq('id', productId)
      .single();

    if (error || !data) {
      console.error('Product fetch error:', error);
      document.getElementById('product-loading')!.classList.add('hidden');
      document.getElementById('product-not-found')!.classList.remove('hidden');
      return;
    }

    currentProduct = {
      id: data.id, name: data.name, price: Number(data.base_price),
      image: data.image_url || '', category: data.category || 'otros',
      description: data.description || '', inStock: data.is_active !== false
    };

    // Fill breadcrumb
    document.getElementById('bc-category')!.textContent = currentProduct.category;
    document.getElementById('bc-name')!.textContent = currentProduct.name;

    // Fill product info
    document.getElementById('product-category')!.textContent = currentProduct.category;
    document.getElementById('product-name')!.textContent = currentProduct.name;
    document.getElementById('product-price')!.textContent = `$${currentProduct.price}`;
    document.getElementById('product-description')!.textContent = currentProduct.description || '';

    // Image
    const imgContainer = document.getElementById('product-image-container')!;
    if (currentProduct.image) {
      const img = document.createElement('img');
      img.src = currentProduct.image;
      img.alt = currentProduct.name;
      img.className = 'w-full h-full object-cover';
      img.onerror = () => setImageFallback(imgContainer);
      imgContainer.appendChild(img);
    } else {
      setImageFallback(imgContainer);
    }

    // Agotado overlay
    if (!currentProduct.inStock) {
      imgContainer.innerHTML += `<div class="absolute inset-0 bg-[var(--bg)]/80 flex items-center justify-center z-10"><span class="text-[var(--text)] text-lg font-black uppercase tracking-[0.2em] border-2 border-[var(--text)] px-4 py-2 -rotate-12">Agotado</span></div>`;
      const cartBtn = document.getElementById('add-to-cart-main')!;
      cartBtn.textContent = 'Agotado';
      cartBtn.disabled = true;
      cartBtn.className = 'flex-1 py-4 rounded-xl font-black text-xs uppercase tracking-[0.15em] transition-all bg-[var(--bg-card)] text-[var(--text-muted)] cursor-not-allowed border border-[var(--border-faint)]';
    }

    // Show content
    document.getElementById('product-loading')!.classList.add('hidden');
    document.getElementById('product-content')!.classList.remove('hidden');

    // Load related products
    const { data: related } = await supabase
      .from('store_products')
      .select('*')
      .eq('is_active', true)
      .neq('id', productId)
      .limit(4);

    if (related && related.length > 0) {
      const section = document.getElementById('related-section')!;
      const grid = document.getElementById('related-grid')!;
      grid.innerHTML = related.map((p: any) => {
        const img = p.image_url
          ? `<img src="${p.image_url}" alt="${p.name}" class="w-full h-full object-cover group-hover:scale-105 transition-all duration-500" onerror="this.style.display='none';this.nextElementSibling.style.display='flex'" /><div style="display:none" class="absolute inset-0 items-center justify-center bg-[var(--bg-card)]"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><text x="12" y="16" text-anchor="middle" font-size="10" font-weight="900" fill="var(--text-muted)" stroke="none">?</text></svg></div>`
          : `<div class="absolute inset-0 items-center justify-center flex bg-[var(--bg-card)]"><svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><text x="12" y="16" text-anchor="middle" font-size="10" font-weight="900" fill="var(--text-muted)" stroke="none">?</text></svg></div>`;
        return `<a href="/tienda/producto?id=${p.id}" class="group bg-[var(--bg)] rounded-xl overflow-hidden border border-[var(--border-faint)] hover:border-[var(--primary)]/40 transition-all block">
          <div class="relative aspect-square bg-[var(--bg-card)] overflow-hidden">${img}</div>
          <div class="p-3">
            <p class="text-xs font-bold line-clamp-1">${p.name}</p>
            <p class="text-sm font-black text-[var(--primary)] mt-1">$${Number(p.base_price)}</p>
          </div>
        </a>`;
      }).join('');
      section.classList.remove('hidden');
    }
  }

  // Quantity controls
  const qtyValue = document.getElementById('qty-value');
  document.getElementById('qty-minus')?.addEventListener('click', () => { if (qty > 1) { qty--; if (qtyValue) qtyValue.textContent = String(qty); }});
  document.getElementById('qty-plus')?.addEventListener('click', () => { if (qty < 10) { qty++; if (qtyValue) qtyValue.textContent = String(qty); }});

  // Add to cart
  document.getElementById('add-to-cart-main')?.addEventListener('click', async () => {
    if (!currentProduct) return;
    await cartStore.addToCart(currentProduct, qty);
    window.location.href = '/checkout';
  });

  // Wishlist
  document.getElementById('toggle-wishlist-main')?.addEventListener('click', async () => {
    if (!currentProduct) return;
    const was = cartStore.isInWishlist(currentProduct.id);
    await cartStore.toggleWishlist(currentProduct);
    const toast = document.getElementById('wishlist-toast');
    const msg = document.getElementById('wishlist-toast-message');
    const btn = document.getElementById('toggle-wishlist-main')!;
    const icon = btn.querySelector('svg');
    if (!was) { if (icon) icon.style.fill = 'currentColor'; btn.classList.add('text-[#DC143C]'); if (msg) msg.textContent = 'Agregado a tu lista'; }
    else { if (icon) icon.style.fill = 'none'; btn.classList.remove('text-[#DC143C]'); if (msg) msg.textContent = 'Eliminado de tu lista'; }
    toast?.classList.remove('translate-y-24', 'opacity-0');
    setTimeout(() => toast?.classList.add('translate-y-24', 'opacity-0'), 2500);
  });

  // Init
  const init = async () => { if (!cartStore.initialized) await cartStore.init(); loadProduct(); };
  init();
</script>
