---
import ErpLayout from '../../layouts/ErpLayout.astro';
---

<ErpLayout title="Mi Perfil" activeModule="configuracion">
  <div style="max-width:1000px;">

    <!-- Tabs Navigation -->
    <div id="perfil-tabs" class="erp-grid" style="grid-template-columns:1fr;gap:0;margin-bottom:24px;">
      <div style="display:flex;gap:0;border-bottom:2px solid var(--border);overflow-x:auto;">
        <button class="tab-btn active" data-tab="account" style="border-bottom:3px solid var(--primary);">👤 Cuenta</button>
        <button class="tab-btn" data-tab="profile" style="border-bottom:3px solid transparent;">📋 Perfil</button>
        <button class="tab-btn" data-tab="preferences" style="border-bottom:3px solid transparent;">⚙️ Preferencias</button>
        <button class="tab-btn" data-tab="danger" style="border-bottom:3px solid transparent;">⚠️ Seguridad</button>
      </div>
    </div>

    <!-- Tab: Cuenta -->
    <div class="tab-content active" id="tab-account">
      <div class="erp-grid" style="grid-template-columns:1fr 1fr;">
        <div class="erp-card">
          <div class="erp-card-title">Información General</div>
          <div style="display:grid;gap:12px;padding:16px 0;">
            <div>
              <span class="field-label">Email</span>
              <div class="field-value" id="pf-email">-</div>
            </div>
            <div>
              <span class="field-label">Rol</span>
              <div class="field-value" id="pf-role">-</div>
            </div>
            <div>
              <span class="field-label">Miembro desde</span>
              <div class="field-value" id="pf-created">-</div>
            </div>
            <div>
              <span class="field-label">Último acceso</span>
              <div class="field-value" id="pf-last">-</div>
            </div>
          </div>
        </div>
        <div class="erp-card">
          <div class="erp-card-title">Avatar</div>
          <div style="display:flex;flex-direction:column;align-items:center;gap:16px;padding:24px 0;">
            <div id="pf-avatar" style="width:80px;height:80px;border-radius:50%;background:linear-gradient(135deg,var(--primary),var(--primary-hover));display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:700;color:#fff;overflow:hidden;background-size:cover;background-position:center;"></div>
            <div style="font-size:12px;font-weight:600;" id="pf-display-name">-</div>
            <button class="erp-btn" id="pf-avatar-edit-btn" style="font-size:10px;cursor:pointer;">📷 Editar Avatar</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab: Perfil -->
    <div class="tab-content" id="tab-profile" style="display:none;">
      <div class="erp-card">
        <div class="erp-card-title">Datos del Perfil</div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;padding:16px 0;">
          <div>
            <span class="field-label">Nombre</span>
            <div class="field-value" id="pf-nombre">-</div>
          </div>
          <div>
            <span class="field-label">Username</span>
            <div class="field-value" id="pf-username">-</div>
          </div>
          <div style="grid-column:1/-1;">
            <span class="field-label">Bio</span>
            <div class="field-value" id="pf-bio" style="font-style:italic;">-</div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab: Preferencias -->
    <div class="tab-content" id="tab-preferences" style="display:none;">
      <div class="erp-card">
        <div class="erp-card-title">Apariencia</div>
        <div style="display:grid;gap:16px;padding:16px 0;">
          <div style="display:flex;align-items:center;justify-content:space-between;">
            <div>
              <div style="font-size:13px;font-weight:600;">Tema Oscuro / Claro</div>
              <div style="font-size:11px;color:var(--text-muted);">Cambia entre modo claro y oscuro</div>
            </div>
            <div class="toggle-switch">
              <label class="toggle-label">
                <input type="checkbox" id="pf-theme-input" />
                <span class="toggle-slider"></span>
              </label>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Tab: Seguridad -->
    <div class="tab-content" id="tab-danger" style="display:none;">
      <div class="erp-card" style="border-color:var(--danger);">
        <div class="erp-card-title" style="color:var(--danger);">Zona de Peligro</div>
        <div style="display:flex;justify-content:space-between;align-items:center;padding:16px 0;">
          <div>
            <div style="font-size:13px;font-weight:600;">Cerrar Sesión</div>
            <div style="font-size:11px;color:var(--text-muted);">Termina tu sesión actual</div>
          </div>
          <button id="pf-logout" class="erp-btn erp-btn--danger">Cerrar Sesión</button>
        </div>
      </div>
    </div>

  </div>

  <!-- Avatar Edit Dialog -->
  <dialog id="erp-avatar-dialog" style="background:var(--bg);border:1px solid var(--border);border-radius:16px;padding:0;max-width:400px;width:90vw;box-shadow:0 20px 60px rgba(0,0,0,0.5);">
    <div style="display:flex;flex-direction:column;">
      <div style="display:flex;justify-content:space-between;align-items:center;padding:14px 18px;border-bottom:1px solid var(--border);">
        <span style="font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;">Editar Avatar</span>
        <button id="erp-dialog-close" style="background:none;border:none;color:var(--text);cursor:pointer;font-size:16px;padding:4px;">✕</button>
      </div>
      <div style="padding:18px;display:flex;flex-direction:column;align-items:center;gap:16px;">
        <div id="erp-dialog-current" style="width:100px;height:100px;border-radius:50%;border:2px solid var(--border);overflow:hidden;display:flex;align-items:center;justify-content:center;background:var(--bg-card);">
          <img id="erp-dialog-current-img" src="" alt="" style="width:100%;height:100%;object-fit:cover;display:none;" />
          <span id="erp-dialog-initials" style="font-size:2rem;font-weight:800;color:var(--primary);">U</span>
        </div>
        <div id="erp-dialog-preview-wrap" style="display:none;">
          <img id="erp-dialog-preview-img" src="" alt="Preview" style="width:100px;height:100px;border-radius:50%;object-fit:cover;border:2px solid var(--primary);" />
          <div style="font-size:10px;color:var(--text-muted);text-align:center;margin-top:4px;">Nueva foto</div>
        </div>
        <input type="file" id="erp-dialog-file" accept="image/png,image/jpeg,image/webp" style="display:none;" />
        <button id="erp-dialog-upload-btn" class="erp-btn" style="font-size:10px;cursor:pointer;">📷 Subir foto</button>
        <div id="erp-dialog-msg" style="font-size:10px;color:var(--text-muted);"></div>
      </div>
      <div style="display:flex;justify-content:flex-end;gap:8px;padding:12px 18px;border-top:1px solid var(--border);">
        <button id="erp-dialog-cancel" class="erp-btn">Cancelar</button>
        <button id="erp-dialog-confirm" class="erp-btn erp-btn--primary" style="display:none;">Confirmar</button>
      </div>
    </div>
  </dialog>

  <!-- Logout Overlay -->
  <div id="logout-overlay" style="display:none;position:fixed;inset:0;z-index:9999;background:var(--bg);opacity:0;transition:opacity 0.4s ease;display:flex;align-items:center;justify-content:center;flex-direction:column;gap:16px;">
    <div style="width:40px;height:40px;border:3px solid var(--border);border-top:3px solid var(--primary);border-radius:50%;animation:spin 0.8s linear infinite;"></div>
    <span style="font-size:13px;font-weight:600;color:var(--text-secondary);">Cerrando sesión...</span>
  </div>
</ErpLayout>

<script>
  import { supabase } from '../../lib/supabase';

  // Tab switching
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => {
        b.style.borderBottomColor = 'transparent';
        b.classList.remove('active');
      });
      btn.style.borderBottomColor = 'var(--primary)';
      btn.classList.add('active');
      document.querySelectorAll('.tab-content').forEach(tc => tc.style.display = 'none');
      const tab = document.getElementById('tab-' + btn.dataset.tab);
      if (tab) tab.style.display = 'block';
    });
  });

  async function loadData() {
    const { data: { session } } = await supabase.auth.getSession();
    if (!session?.user) return;

    const user = session.user;
    const set = (id, val) => { const el = document.getElementById(id); if (el) el.textContent = val || '-'; };

    set('pf-email', user.email);
    set('pf-email', user.email);

    // Get role directly from user_roles + roles
    try {
      const { data: myRoles } = await supabase
        .from('user_roles')
        .select('role_id')
        .eq('user_id', user.id);
      if (myRoles?.length) {
        const ids = [...new Set(myRoles.map(r => r.role_id).filter(Boolean))];
        const { data: roleNames } = await supabase
          .from('roles')
          .select('name, internal_name')
          .in('id', ids);
        if (roleNames?.length) {
          const names = roleNames.map(r => r.name || r.internal_name).filter(Boolean);
          set('pf-role', names.join(', ').toUpperCase());
        }
      }
    } catch(e) {}

    set('pf-created', new Date(user.created_at).toLocaleDateString('es-MX'));
    set('pf-last', user.last_sign_in_at ? new Date(user.last_sign_in_at).toLocaleString('es-MX') : 'Nunca');
    set('pf-avatar', (user.email?.[0] || 'U').toUpperCase());
    set('pf-display-name', user.email?.split('@')[0] || 'Usuario');

    // Load profile + avatar
    try {
      const { data: profileData } = await supabase
        .from('profiles')
        .select('nombre,username,bio,avatar_url')
        .eq('id', user.id)
        .single();
      if (profileData) {
        set('pf-nombre', profileData.nombre);
        set('pf-username', profileData.username);
        set('pf-bio', profileData.bio);
        if (profileData.nombre) set('pf-display-name', profileData.nombre);
        if (profileData.avatar_url) {
          const av = document.getElementById('pf-avatar');
          if (av) {
            av.style.backgroundImage = `url(${profileData.avatar_url})`;
            av.textContent = '';
          }
        }
      }
    } catch(e) {}

    // Avatar edit button opens dialog
    var pendingAvatarFile = null;

    function loadErpAvatarDialog() {
      var curImg = document.getElementById('erp-dialog-current-img');
      var initials = document.getElementById('erp-dialog-initials');
      var previewWrap = document.getElementById('erp-dialog-preview-wrap');
      var confirmBtn = document.getElementById('erp-dialog-confirm');
      var msg = document.getElementById('erp-dialog-msg');
      var fileInput = document.getElementById('erp-dialog-file');
      if (fileInput) fileInput.value = '';
      pendingAvatarFile = null;
      if (previewWrap) previewWrap.style.display = 'none';
      if (confirmBtn) confirmBtn.style.display = 'none';
      if (msg) msg.textContent = '';
      if (profileData.avatar_url && curImg) {
        curImg.src = profileData.avatar_url;
        curImg.style.display = 'block';
        if (initials) initials.style.display = 'none';
      } else if (initials) {
        initials.textContent = (profileData.nombre || user.email || 'U')[0].toUpperCase();
        initials.style.display = 'block';
        if (curImg) curImg.style.display = 'none';
      }
    }

    document.getElementById('pf-avatar-edit-btn')?.addEventListener('click', function() {
      loadErpAvatarDialog();
      var dialog = document.getElementById('erp-avatar-dialog');
      if (dialog) dialog.showModal();
    });

    document.getElementById('erp-dialog-upload-btn')?.addEventListener('click', function() {
      var fileInput = document.getElementById('erp-dialog-file');
      if (fileInput) { fileInput.value = ''; fileInput.click(); }
    });

    document.getElementById('erp-dialog-file')?.addEventListener('change', function(e) {
      var file = e.target.files && e.target.files[0];
      if (!file) return;
      pendingAvatarFile = file;
      var previewWrap = document.getElementById('erp-dialog-preview-wrap');
      var previewImg = document.getElementById('erp-dialog-preview-img');
      var confirmBtn = document.getElementById('erp-dialog-confirm');
      if (previewImg) previewImg.src = URL.createObjectURL(file);
      if (previewWrap) previewWrap.style.display = 'block';
      if (confirmBtn) confirmBtn.style.display = 'inline-flex';
    });

    document.getElementById('erp-dialog-confirm')?.addEventListener('click', async function() {
      if (!pendingAvatarFile) return;
      var msg = document.getElementById('erp-dialog-msg');
      var confirmBtn = document.getElementById('erp-dialog-confirm');
      if (confirmBtn) confirmBtn.disabled = true;
      if (msg) msg.textContent = 'Subiendo...';
      try {
        var ext = pendingAvatarFile.name.split('.').pop() || 'png';
        var path = user.id + '/avatar.' + ext;
        var { error: uploadError } = await supabase.storage
          .from('avatars')
          .upload(path, pendingAvatarFile, { upsert: true });
        if (uploadError) throw uploadError;
        var { data: { publicUrl } } = supabase.storage
          .from('avatars')
          .getPublicUrl(path);
        await supabase.from('profiles').upsert({ id: user.id, avatar_url: publicUrl }, { onConflict: 'id' });
        var av = document.getElementById('pf-avatar');
        if (av) { av.style.backgroundImage = 'url(' + publicUrl + ')'; av.textContent = ''; }
        if (msg) msg.textContent = 'Avatar actualizado';
        dispatchEvent(new CustomEvent('avatar-updated', { detail: publicUrl }));
        var sidebarAv = document.getElementById('erpUserAvatar');
        if (sidebarAv) { sidebarAv.style.backgroundImage = 'url(' + publicUrl + ')'; sidebarAv.textContent = ''; }
        setTimeout(function() { var d = document.getElementById('erp-avatar-dialog'); if (d) d.close(); }, 800);
      } catch (e) {
        if (msg) msg.textContent = 'Error: ' + (e.message || e);
      }
      if (confirmBtn) confirmBtn.disabled = false;
      pendingAvatarFile = null;
    });

    document.getElementById('erp-dialog-close')?.addEventListener('click', function() {
      var d = document.getElementById('erp-avatar-dialog'); if (d) d.close();
    });
    document.getElementById('erp-dialog-cancel')?.addEventListener('click', function() {
      var d = document.getElementById('erp-avatar-dialog'); if (d) d.close();
    });

    // Theme toggle
    const themeCheck = document.getElementById('pf-theme-input');
    if (themeCheck) {
      const current = document.documentElement.getAttribute('data-theme') || localStorage.getItem('wg-theme') || 'dark';
      themeCheck.checked = current === 'light';
      themeCheck.addEventListener('change', () => {
        const next = themeCheck.checked ? 'light' : 'dark';
        document.documentElement.setAttribute('data-theme', next);
        localStorage.setItem('wg-theme', next);
      });
    }
  }

  // Logout
  document.getElementById('pf-logout')?.addEventListener('click', async () => {
    const overlay = document.getElementById('logout-overlay');
    if (overlay) {
      overlay.style.display = 'flex';
      requestAnimationFrame(() => overlay.style.opacity = '1');
    }
    await supabase.auth.signOut();
    setTimeout(() => window.location.href = '/', 500);
  });

  loadData();
</script>

<style>
  #erp-avatar-dialog::backdrop { background:rgba(0,0,0,0.7); }
  @keyframes spin {
    to { transform: rotate(360deg); }
  }
  .tab-btn {
    padding: 12px 24px;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    cursor: pointer;
    background: none;
    border: none;
    color: var(--text-muted);
    transition: all 0.2s;
    white-space: nowrap;
  }
  .tab-btn:hover { color: var(--text); }
  .tab-btn.active { color: var(--primary); }
  .field-label {
    display: block;
    font-size: 10px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 4px;
  }
  .field-value {
    font-size: 14px;
    font-weight: 600;
  }
</style>
