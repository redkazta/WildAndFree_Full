---
import ErpLayout from '../../layouts/ErpLayout.astro';
---

<ErpLayout title="Pedidos" activeModule="pedidos">
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;">
    <div style="display:flex;gap:8px;">
      <button class="erp-btn erp-btn--ghost filter-btn active" data-filter="all">Todos</button>
      <button class="erp-btn erp-btn--ghost filter-btn" data-filter="pending">Pendientes</button>
      <button class="erp-btn erp-btn--ghost filter-btn" data-filter="paid">Pagados</button>
      <button class="erp-btn erp-btn--ghost filter-btn" data-filter="shipped">Enviados</button>
      <button class="erp-btn erp-btn--ghost filter-btn" data-filter="delivered">Entregados</button>
    </div>
  </div>

  <div class="erp-card" style="overflow-x:auto;">
    <table class="erp-table" id="ordersTable">
      <thead>
        <tr>
          <th>#</th>
          <th>Cliente</th>
          <th>Items</th>
          <th>Total</th>
          <th>Método</th>
          <th>Envío</th>
          <th>Estado</th>
          <th>Fecha</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody id="ordersBody">
        <tr><td colspan="9" class="erp-loading">Cargando pedidos...</td></tr>
      </tbody>
    </table>
  </div>
</ErpLayout>

<script>
  import { supabase } from '../../lib/supabase';

  const perms: string[] = (window as any).__wildPermissions || [];
  const canView = perms.includes('*') || perms.includes('orders.view');
  const canManage = perms.includes('*') || perms.includes('orders.manage');

  if (!canView) {
    document.querySelector('.erp-content')!.innerHTML = '<div class="erp-card" style="text-align:center;padding:60px;"><p style="color:rgba(255,255,255,0.3);">No tienes permiso para ver pedidos.</p></div>';
    throw new Error('Permission denied');
  }

  let currentFilter = 'all';

  async function loadOrders(filter = 'all') {
    currentFilter = filter;
    let query = supabase.from('store_orders').select('*, profiles(nombre, username), store_order_items(quantity, unit_price, product_variants(size, color, store_products(name)))');
    if (filter !== 'all') query = query.eq('status', filter);
    query = query.order('created_at', { ascending: false });

    const { data: orders } = await query;
    const tbody = document.getElementById('ordersBody');
    if (!orders?.length) {
      tbody.innerHTML = '<tr><td colspan="9" style="text-align:center;color:rgba(255,255,255,0.3);padding:40px;">Sin pedidos</td></tr>';
      return;
    }

    tbody.innerHTML = orders.map(o => `
      <tr>
        <td style="font-weight:700;">#${o.id.slice(0,8)}</td>
        <td>${o.profiles?.nombre || o.profiles?.username || 'N/A'}</td>
        <td>${o.store_order_items?.length || 0} items</td>
        <td style="font-weight:700;">$${o.total}</td>
        <td>${o.payment_method || '-'}</td>
        <td>${o.shipping_type || '-'}</td>
        <td><span class="erp-status erp-status--${o.status}">${o.status}</span></td>
        <td style="font-size:11px;color:rgba(255,255,255,0.4);">${new Date(o.created_at).toLocaleDateString('es-MX')}</td>
        <td>
          ${canManage ? `<select class="erp-btn erp-btn--ghost" style="padding:4px 8px;font-size:11px;" onchange="updateOrderStatus('${o.id}', this.value)">
            <option value="pending" ${o.status==='pending'?'selected':''}>Pendiente</option>
            <option value="paid" ${o.status==='paid'?'selected':''}>Pagado</option>
            <option value="processing" ${o.status==='processing'?'selected':''}>Procesando</option>
            <option value="shipped" ${o.status==='shipped'?'selected':''}>Enviado</option>
            <option value="delivered" ${o.status==='delivered'?'selected':''}>Entregado</option>
            <option value="cancelled" ${o.status==='cancelled'?'selected':''}>Cancelado</option>
          </select>` : `<span class="erp-status erp-status--${o.status}" style="font-size:11px;">${o.status}</span>`}
        </td>
      </tr>
    `).join('');
  }

  (window as any).updateOrderStatus = async (id: string, status: string) => {
    await supabase.from('store_orders').update({ status, updated_at: new Date().toISOString() }).eq('id', id);
    loadOrders(currentFilter);
  };

  document.querySelectorAll('.filter-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');
      loadOrders(btn.dataset.filter);
    });
  });

  loadOrders();
</script>
