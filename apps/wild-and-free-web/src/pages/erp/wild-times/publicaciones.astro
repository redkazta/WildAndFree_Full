---
import ErpLayout from '../../../layouts/ErpLayout.astro';
---

<ErpLayout title="The Wild Times — Publicaciones" activeModule="publicaciones">
  <div style="display:flex;align-items:center;justify-content:space-between;margin-bottom:20px;flex-wrap:wrap;gap:10px;">
    <div>
      <h2 style="margin:0 0 4px;font-size:18px;font-weight:800;">✍️ Publicaciones</h2>
      <p style="margin:0;font-size:12px;color:var(--text-muted);">Publicaciones generales, eventos y promociones del feed de la crew.</p>
    </div>
    <button class="erp-btn erp-btn--primary" id="newPostBtn">+ Nueva Publicación</button>
  </div>

  <!-- Form -->
  <div id="postForm" class="erp-card" style="display:none;margin-bottom:24px;">
    <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
      <div class="erp-card-title" style="margin-bottom:0;" id="formTitle">Nueva Publicación</div>
      <button class="erp-btn erp-btn--ghost" onclick="closeForm()" style="font-size:11px;">✕ Cerrar</button>
    </div>
    <input type="hidden" id="editPostId" />
    <div style="display:grid;gap:12px;">
      <div>
        <label style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:4px;">Título (opcional)</label>
        <input id="postTitle" type="text" placeholder="Título de la publicación" style="width:100%;background:var(--bg-card);border:1px solid var(--border-muted);border-radius:8px;padding:10px;color:var(--text);font-size:13px;" />
      </div>
      <div>
        <label style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:4px;">Contenido *</label>
        <textarea id="postContent" rows="4" placeholder="Contenido de la publicación..." style="width:100%;background:var(--bg-card);border:1px solid var(--border-muted);border-radius:8px;padding:10px;color:var(--text);font-size:13px;resize:vertical;font-family:inherit;"></textarea>
      </div>
      <div>
        <label style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:4px;">Imagen</label>
        <div style="display:flex;gap:10px;align-items:center;flex-wrap:wrap;">
          <input type="file" id="postImageFile" accept="image/jpeg,image/png,image/webp,image/gif" style="flex:1;min-width:180px;background:var(--bg-card);border:1px solid var(--border-muted);border-radius:8px;padding:8px;color:var(--text);font-size:12px;" />
          <input type="hidden" id="postImage" />
          <div id="postImagePreview" style="display:none;width:80px;height:60px;border-radius:8px;overflow:hidden;border:1px solid var(--border-muted);flex-shrink:0;"><img id="postImagePreviewImg" src="" alt="" style="width:100%;height:100%;object-fit:cover;" /></div>
          <button type="button" id="postImageRemove" style="display:none;padding:6px 10px;border-radius:8px;border:1px solid var(--border-muted);background:var(--bg-card);color:var(--danger);font-size:11px;cursor:pointer;font-family:inherit;">✕ Quitar</button>
        </div>
        <p style="font-size:10px;color:var(--text-muted);margin:4px 0 0;">JPG, PNG, WebP o GIF · máx 5MB</p>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr 1fr;gap:12px;">
        <div>
          <label style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:4px;">Tipo</label>
          <select id="postType" style="width:100%;background:var(--bg-card);border:1px solid var(--border-muted);border-radius:8px;padding:10px;color:var(--text);font-size:13px;">
            <option value="general">📝 General</option>
            <option value="event">🎤 Evento</option>
            <option value="promotion">🏷️ Promoción</option>
          </select>
        </div>
        <div>
          <label style="font-size:11px;font-weight:700;color:var(--text-muted);text-transform:uppercase;letter-spacing:0.05em;display:block;margin-bottom:4px;">Estado</label>
          <select id="postStatus" style="width:100%;background:var(--bg-card);border:1px solid var(--border-muted);border-radius:8px;padding:10px;color:var(--text);font-size:13px;">
            <option value="published">Publicado</option>
            <option value="pending">Borrador</option>
          </select>
        </div>
        <div style="display:flex;align-items:flex-end;">
          <button class="erp-btn erp-btn--primary" onclick="savePost()" style="width:100%;">Guardar</button>
        </div>
      </div>
    </div>
  </div>

  <!-- List -->
  <div class="erp-card" style="overflow-x:auto;">
    <table class="erp-table">
      <thead>
        <tr>
          <th>Título</th>
          <th>Tipo</th>
          <th>Estado</th>
          <th>Autor</th>
          <th>Fecha</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody id="postsBody">
        <tr><td colspan="6" class="erp-loading">Cargando publicaciones...</td></tr>
      </tbody>
    </table>
  </div>
</ErpLayout>

<script>
  import { supabase } from '../../../lib/supabase';
  import { waitForPermissions } from '../../../lib/erp-permissions';

  const { perms, role } = await waitForPermissions();
  const canManage = perms.includes('*') || perms.includes('content.manage');

  if (!canManage) {
    document.querySelector('.erp-content')!.innerHTML = '<div class="erp-card" style="text-align:center;padding:60px;"><p style="color:var(--border-soft);">No tienes permiso para gestionar publicaciones.</p></div>';
    throw new Error('Permission denied');
  }

  const TYPES = ['general', 'event', 'promotion'];
  const typeLabels: Record<string, string> = { general: '📝 General', event: '🎤 Evento', promotion: '🏷️ Promo' };
  let allPosts: any[] = [];

  async function loadPosts() {
    const { data: posts, error } = await supabase
      .from('crew_posts')
      .select('*, profiles:author_id(nombre, username, avatar_url)')
      .in('post_type', TYPES)
      .order('created_at', { ascending: false });

    if (error || !posts) {
      document.getElementById('postsBody')!.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--border-soft);padding:30px;">Error al cargar</td></tr>';
      return;
    }
    allPosts = posts;
    renderPosts();
  }

  function renderPosts() {
    const tbody = document.getElementById('postsBody')!;
    if (allPosts.length === 0) {
      tbody.innerHTML = '<tr><td colspan="6" style="text-align:center;color:var(--border-soft);padding:30px;">Sin publicaciones aún. Crea la primera.</td></tr>';
      return;
    }
    const statusLabels: Record<string, string> = { published: '✅ Publicado', pending: '📝 Borrador' };
    tbody.innerHTML = allPosts.map(p => `
      <tr>
        <td style="font-weight:700;max-width:250px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">${p.title || p.content?.slice(0, 40) || 'Sin título'}</td>
        <td style="font-size:12px;">${typeLabels[p.post_type] || p.post_type}</td>
        <td><span class="erp-status erp-status--${p.status === 'published' ? 'approved' : 'pending'}">${statusLabels[p.status] || p.status}</span></td>
        <td style="font-size:12px;color:var(--text-secondary);">${p.profiles?.nombre || p.profiles?.username || '—'}</td>
        <td style="font-size:11px;color:var(--text-muted);">${new Date(p.published_at || p.created_at).toLocaleDateString('es-MX')}</td>
        <td>
          <div style="display:flex;gap:6px;">
            <button class="erp-btn erp-btn--ghost" style="padding:4px 8px;font-size:11px;" onclick="editPost('${p.id}')">Editar</button>
            <button class="erp-btn erp-btn--danger" style="padding:4px 8px;font-size:11px;" onclick="deletePost('${p.id}')">Eliminar</button>
          </div>
        </td>
      </tr>
    `).join('');
  }

  (window as any).openForm = () => {
    document.getElementById('postForm')!.style.display = 'block';
    document.getElementById('formTitle')!.textContent = 'Nueva Publicación';
    document.getElementById('editPostId')!.value = '';
    (document.getElementById('postTitle') as HTMLInputElement).value = '';
    (document.getElementById('postContent') as HTMLTextAreaElement).value = '';
    (document.getElementById('postImage') as HTMLInputElement).value = '';
    (document.getElementById('postType') as HTMLSelectElement).value = 'general';
    (document.getElementById('postStatus') as HTMLSelectElement).value = 'published';
    clearImagePreview();
    document.getElementById('postForm')!.scrollIntoView({ behavior: 'smooth' });
  };

  // ── Upload imagen desde dispositivo ──
  function clearImagePreview() {
    const preview = document.getElementById('postImagePreview') as HTMLElement;
    const removeBtn = document.getElementById('postImageRemove') as HTMLElement;
    (document.getElementById('postImage') as HTMLInputElement).value = '';
    (document.getElementById('postImageFile') as HTMLInputElement).value = '';
    if (preview) preview.style.display = 'none';
    if (removeBtn) removeBtn.style.display = 'none';
  }

  async function uploadImage(file: File): Promise<string | null> {
    const formData = new FormData();
    formData.append('image', file);
    try {
      const res = await fetch('/api/upload-image', {
        method: 'POST',
        body: formData,
      });
      const data = await res.json();
      if (!res.ok || !data.success) {
        alert(data.error || 'Error al subir imagen');
        return null;
      }
      return data.url;
    } catch (e) {
      alert('Error al subir imagen');
      return null;
    }
  }

  (document.getElementById('postImageFile') as HTMLInputElement)?.addEventListener('change', async (e) => {
    const input = e.target as HTMLInputElement;
    const file = input.files?.[0];
    if (!file) return;
    const url = await uploadImage(file);
    if (url) {
      (document.getElementById('postImage') as HTMLInputElement).value = url;
      const preview = document.getElementById('postImagePreview') as HTMLElement;
      const previewImg = document.getElementById('postImagePreviewImg') as HTMLImageElement;
      const removeBtn = document.getElementById('postImageRemove') as HTMLElement;
      if (previewImg) previewImg.src = url;
      if (preview) preview.style.display = 'block';
      if (removeBtn) removeBtn.style.display = 'inline-block';
    } else {
      input.value = '';
    }
  });

  (document.getElementById('postImageRemove') as HTMLElement)?.addEventListener('click', clearImagePreview);

  (window as any).closeForm = () => {
    document.getElementById('postForm')!.style.display = 'none';
  };

  (window as any).savePost = async () => {
    const editId = (document.getElementById('editPostId') as HTMLInputElement).value;
    const title = (document.getElementById('postTitle') as HTMLInputElement).value.trim();
    const content = (document.getElementById('postContent') as HTMLTextAreaElement).value.trim();
    const imageUrl = (document.getElementById('postImage') as HTMLInputElement).value.trim();
    const postType = (document.getElementById('postType') as HTMLSelectElement).value;
    const status = (document.getElementById('postStatus') as HTMLSelectElement).value;

    if (!content) return alert('El contenido es requerido');

    const { data: { session } } = await supabase.auth.getSession();
    const authorId = session?.user?.id;

    if (editId) {
      const { error } = await supabase.from('crew_posts').update({
        title: title || null, content,
        image_url: imageUrl || null,
        post_type: postType,
        status,
        published_at: status === 'published' ? new Date().toISOString() : undefined,
        updated_at: new Date().toISOString(),
      }).eq('id', editId);
      if (error) { alert('Error al actualizar'); return; }
    } else {
      if (!authorId) { alert('Debes iniciar sesión'); return; }
      const now = new Date().toISOString();
      const { error } = await supabase.from('crew_posts').insert({
        author_id: authorId,
        title: title || null, content,
        image_url: imageUrl || null,
        post_type: postType,
        status,
        published_at: status === 'published' ? now : null,
      });
      if (error) { alert('Error al crear'); return; }
    }

    (window as any).closeForm();
    loadPosts();
  };

  (window as any).editPost = (id: string) => {
    const p = allPosts.find(x => x.id === id);
    if (!p) return;
    document.getElementById('postForm')!.style.display = 'block';
    document.getElementById('formTitle')!.textContent = 'Editar Publicación';
    document.getElementById('editPostId')!.value = p.id;
    (document.getElementById('postTitle') as HTMLInputElement).value = p.title || '';
    (document.getElementById('postContent') as HTMLTextAreaElement).value = p.content || '';
    (document.getElementById('postImage') as HTMLInputElement).value = p.image_url || '';
    (document.getElementById('postType') as HTMLSelectElement).value = p.post_type || 'general';
    (document.getElementById('postStatus') as HTMLSelectElement).value = p.status || 'pending';
    // Preview si ya tiene imagen
    if (p.image_url) {
      const preview = document.getElementById('postImagePreview') as HTMLElement;
      const previewImg = document.getElementById('postImagePreviewImg') as HTMLImageElement;
      const removeBtn = document.getElementById('postImageRemove') as HTMLElement;
      if (previewImg) previewImg.src = p.image_url;
      if (preview) preview.style.display = 'block';
      if (removeBtn) removeBtn.style.display = 'inline-block';
    } else {
      clearImagePreview();
    }
    document.getElementById('postForm')!.scrollIntoView({ behavior: 'smooth' });
  };

  (window as any).deletePost = async (id: string) => {
    if (!confirm('¿Eliminar esta publicación?')) return;
    const { error } = await supabase.from('crew_posts').delete().eq('id', id);
    if (error) { alert('Error al eliminar'); return; }
    loadPosts();
  };

  document.getElementById('newPostBtn')?.addEventListener('click', () => (window as any).openForm());

  loadPosts();
</script>
