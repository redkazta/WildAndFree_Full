---
import ErpLayout from '../../layouts/ErpLayout.astro';
---

<ErpLayout title="Versus" activeModule="versus">
  <!-- Tabs -->
  <div style="display:flex;gap:4px;margin-bottom:24px;background:rgba(255,255,255,0.03);border-radius:8px;padding:4px;width:fit-content;">
    <button class="tab-btn active" onclick="switchTab('freestylers')">Freestylers</button>
    <button class="tab-btn" onclick="switchTab('battles')">Battles</button>
  </div>

  <!-- Freestylers Tab -->
  <div id="tab-freestylers" class="tab-content active">
    <div class="erp-card" style="margin-bottom:24px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <div class="erp-card-title" style="margin-bottom:0;">Freestylers</div>
        <button class="erp-btn erp-btn--primary" onclick="openFreestylerForm()">+ Nuevo Freestyler</button>
      </div>

      <!-- Freestyler Form -->
      <div id="freestylerForm" style="display:none;margin-bottom:16px;padding:16px;background:rgba(255,255,255,0.03);border-radius:8px;border:1px solid rgba(255,255,255,0.06);">
        <input type="hidden" id="freestylerEditId" />
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
          <div>
            <label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:rgba(255,255,255,0.5);margin-bottom:6px;">Nombre</label>
            <input type="text" id="freestylerName" style="width:100%;padding:8px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:6px;color:#fff;font-size:13px;" />
          </div>
          <div>
            <label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:rgba(255,255,255,0.5);margin-bottom:6px;">Slug</label>
            <input type="text" id="freestylerSlug" placeholder="auto-generado desde nombre" style="width:100%;padding:8px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:6px;color:#fff;font-size:13px;" />
          </div>
        </div>
        <div style="display:grid;grid-template-columns:1fr 1fr;gap:12px;margin-bottom:12px;">
          <div>
            <label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:rgba(255,255,255,0.5);margin-bottom:6px;">Avatar URL</label>
            <input type="text" id="freestylerAvatar" placeholder="https://..." style="width:100%;padding:8px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:6px;color:#fff;font-size:13px;" />
          </div>
          <div>
            <label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:rgba(255,255,255,0.5);margin-bottom:6px;">Bio</label>
            <input type="text" id="freestylerBio" placeholder="Breve descripción" style="width:100%;padding:8px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:6px;color:#fff;font-size:13px;" />
          </div>
        </div>
        <div style="display:flex;gap:8px;">
          <button class="erp-btn erp-btn--primary" onclick="saveFreestyler()">Guardar</button>
          <button class="erp-btn erp-btn--ghost" onclick="closeFreestylerForm()">Cancelar</button>
        </div>
      </div>

      <div style="overflow-x:auto;">
        <table class="erp-table">
          <thead>
            <tr>
              <th>Avatar</th>
              <th>Nombre</th>
              <th>Slug</th>
              <th>Activo</th>
              <th>Creado</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody id="freestylersBody">
            <tr><td colspan="6" class="erp-loading">Cargando freestylers...</td></tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Stats Editor -->
    <div class="erp-card" id="statsEditor" style="display:none;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <div class="erp-card-title" style="margin-bottom:0;">Stats de <span id="statsFreestylerName">—</span></div>
        <button class="erp-btn erp-btn--ghost" onclick="closeStatsEditor()">Cerrar</button>
      </div>
      <div id="statsSliders" style="display:grid;grid-template-columns:1fr 1fr;gap:16px;"></div>
      <div style="margin-top:16px;">
        <button class="erp-btn erp-btn--primary" onclick="saveStats()">Guardar Stats</button>
      </div>
    </div>
  </div>

  <!-- Battles Tab -->
  <div id="tab-battles" class="tab-content" style="display:none;">
    <div class="erp-card" style="margin-bottom:24px;">
      <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:16px;">
        <div class="erp-card-title" style="margin-bottom:0;">Battles</div>
        <button class="erp-btn erp-btn--primary" onclick="openBattleForm()">+ Nueva Battle</button>
      </div>

      <!-- Battle Form -->
      <div id="battleForm" style="display:none;margin-bottom:16px;padding:16px;background:rgba(255,255,255,0.03);border-radius:8px;border:1px solid rgba(255,255,255,0.06);">
        <div style="display:grid;grid-template-columns:1fr auto 1fr;gap:12px;margin-bottom:12px;align-items:end;">
          <div>
            <label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:rgba(255,255,255,0.5);margin-bottom:6px;">Freestyler 1</label>
            <select id="battleFs1" style="width:100%;padding:8px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:6px;color:#fff;font-size:13px;">
              <option value="">Seleccionar...</option>
            </select>
          </div>
          <div style="padding-bottom:8px;font-size:18px;font-weight:900;color:#C98300;">VS</div>
          <div>
            <label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:rgba(255,255,255,0.5);margin-bottom:6px;">Freestyler 2</label>
            <select id="battleFs2" style="width:100%;padding:8px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:6px;color:#fff;font-size:13px;">
              <option value="">Seleccionar...</option>
            </select>
          </div>
        </div>
        <div style="display:flex;gap:8px;">
          <button class="erp-btn erp-btn--primary" onclick="saveBattle()">Crear Battle</button>
          <button class="erp-btn erp-btn--ghost" onclick="closeBattleForm()">Cancelar</button>
        </div>
      </div>

      <!-- Complete Battle Modal -->
      <div id="completeBattleModal" style="display:none;margin-bottom:16px;padding:16px;background:rgba(255,255,255,0.03);border-radius:8px;border:1px solid rgba(255,255,255,0.06);">
        <input type="hidden" id="completeBattleId" />
        <div style="display:grid;grid-template-columns:1fr auto 1fr;gap:12px;margin-bottom:12px;align-items:center;">
          <div id="completeFs1Name" style="text-align:center;font-weight:700;color:#fff;font-size:14px;"></div>
          <div style="font-size:14px;font-weight:900;color:rgba(255,255,255,0.3);">VS</div>
          <div id="completeFs2Name" style="text-align:center;font-weight:700;color:#fff;font-size:14px;"></div>
        </div>
        <div style="margin-bottom:12px;">
          <label style="display:block;font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.05em;color:rgba(255,255,255,0.5);margin-bottom:6px;">Seleccionar Ganador</label>
          <select id="battleWinner" style="width:100%;padding:8px 12px;background:rgba(255,255,255,0.05);border:1px solid rgba(255,255,255,0.1);border-radius:6px;color:#fff;font-size:13px;">
            <option value="">Seleccionar...</option>
          </select>
        </div>
        <div style="display:flex;gap:8px;">
          <button class="erp-btn erp-btn--primary" onclick="completeBattle()">Completar Battle</button>
          <button class="erp-btn erp-btn--ghost" onclick="closeCompleteBattleModal()">Cancelar</button>
        </div>
      </div>

      <div style="overflow-x:auto;">
        <table class="erp-table">
          <thead>
            <tr>
              <th>Freestyler 1</th>
              <th></th>
              <th>Freestyler 2</th>
              <th>Ganador</th>
              <th>Votos</th>
              <th>Estado</th>
              <th>Creado</th>
              <th>Acciones</th>
            </tr>
          </thead>
          <tbody id="battlesBody">
            <tr><td colspan="8" class="erp-loading">Cargando battles...</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>
</ErpLayout>

<style>
  .tab-btn {
    padding: 8px 20px;
    border-radius: 6px;
    border: none;
    background: transparent;
    color: rgba(255,255,255,0.5);
    font-size: 13px;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.15s;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .tab-btn:hover {
    color: #fff;
    background: rgba(255,255,255,0.05);
  }
  .tab-btn.active {
    background: rgba(201,131,0,0.15);
    color: #C98300;
  }
  .stat-slider-row {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .stat-slider-row label {
    display: flex;
    justify-content: space-between;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: rgba(255,255,255,0.5);
  }
  .stat-slider-row label span {
    color: #C98300;
    font-weight: 800;
  }
  .stat-slider-row input[type="range"] {
    -webkit-appearance: none;
    width: 100%;
    height: 6px;
    border-radius: 3px;
    background: rgba(255,255,255,0.1);
    outline: none;
  }
  .stat-slider-row input[type="range"]::-webkit-slider-thumb {
    -webkit-appearance: none;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #C98300;
    cursor: pointer;
  }
  .stat-slider-row input[type="range"]::-moz-range-thumb {
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: #C98300;
    cursor: pointer;
    border: none;
  }
  .avatar-cell {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .avatar-cell img {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    background: rgba(255,255,255,0.05);
  }
  .avatar-cell .no-avatar {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: rgba(255,255,255,0.05);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 14px;
    color: rgba(255,255,255,0.3);
  }
  .toggle-switch {
    position: relative;
    display: inline-block;
    width: 36px;
    height: 20px;
  }
  .toggle-switch input {
    opacity: 0;
    width: 0;
    height: 0;
  }
  .toggle-slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(255,255,255,0.1);
    border-radius: 20px;
    transition: 0.2s;
  }
  .toggle-slider::before {
    content: "";
    position: absolute;
    height: 14px;
    width: 14px;
    left: 3px;
    bottom: 3px;
    background: #fff;
    border-radius: 50%;
    transition: 0.2s;
  }
  .toggle-switch input:checked + .toggle-slider {
    background: #C98300;
  }
  .toggle-switch input:checked + .toggle-slider::before {
    transform: translateX(16px);
  }
  .btn-sm {
    padding: 5px 10px;
    font-size: 10px;
  }
  .vs-badge {
    font-size: 11px;
    font-weight: 900;
    color: #C98300;
    background: rgba(201,131,0,0.12);
    padding: 2px 8px;
    border-radius: 4px;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';

  let allFreestylers: any[] = [];
  let allBattles: any[] = [];
  let currentStatsFsId: string | null = null;
  let currentStats: Record<string, number> = {
    flow: 0,
    punchline: 0,
    estructura: 0,
    puesta_en_escena: 0,
    doble_tempo: 0,
    figuras_literarias: 0,
  };

  const STAT_LABELS: Record<string, string> = {
    flow: 'Flow',
    punchline: 'Punchline',
    estructura: 'Estructura',
    puesta_en_escena: 'Puesta en Escena',
    doble_tempo: 'Doble Tempo',
    figuras_literarias: 'Figuras Literarias',
  };

  // --- Tab switching ---
  (window as any).switchTab = (tab: string) => {
    document.querySelectorAll('.tab-btn').forEach((b: Element) => b.classList.remove('active'));
    document.querySelectorAll('.tab-content').forEach((c: Element) => { (c as HTMLElement).style.display = 'none'; });
    document.querySelector(`.tab-btn:nth-child(${tab === 'freestylers' ? 1 : 2})`)?.classList.add('active');
    const panel = document.getElementById(`tab-${tab}`);
    if (panel) panel.style.display = '';
  };

  // --- Freestylers ---
  async function loadFreestylers() {
    const { data, error } = await supabase
      .from('freestylers')
      .select('*')
      .order('created_at', { ascending: false });
    if (error) { console.error(error); return; }
    allFreestylers = data || [];
    renderFreestylers();
    populateBattleDropdowns();
  }

  function renderFreestylers() {
    const tbody = document.getElementById('freestylersBody');
    if (!tbody) return;
    if (!allFreestylers.length) {
      tbody.innerHTML = '<tr><td colspan="6" class="erp-loading">No hay freestylers</td></tr>';
      return;
    }
    tbody.innerHTML = allFreestylers.map(f => `
      <tr>
        <td>
          <div class="avatar-cell">
            ${f.avatar_url
              ? `<img src="${f.avatar_url}" alt="${f.name}" />`
              : `<div class="no-avatar">👤</div>`
            }
          </div>
        </td>
        <td style="font-weight:600;color:#fff;">${f.name}</td>
        <td style="color:rgba(255,255,255,0.5);font-size:12px;">${f.slug || '—'}</td>
        <td>
          <label class="toggle-switch">
            <input type="checkbox" ${f.is_active ? 'checked' : ''} onchange="toggleActive('${f.id}', this.checked)" />
            <span class="toggle-slider"></span>
          </label>
        </td>
        <td style="color:rgba(255,255,255,0.5);font-size:12px;">${f.created_at ? new Date(f.created_at).toLocaleDateString('es') : '—'}</td>
        <td>
          <div style="display:flex;gap:4px;">
            <button class="erp-btn erp-btn--ghost btn-sm" onclick="openStatsEditor('${f.id}')">📊 Stats</button>
            <button class="erp-btn erp-btn--ghost btn-sm" onclick="editFreestyler('${f.id}')">✏️</button>
            <button class="erp-btn erp-btn--danger btn-sm" onclick="deleteFreestyler('${f.id}')">🗑️</button>
          </div>
        </td>
      </tr>
    `).join('');
  }

  (window as any).toggleActive = async (id: string, checked: boolean) => {
    const { error } = await supabase.from('freestylers').update({ is_active: checked, updated_at: new Date().toISOString() }).eq('id', id);
    if (error) console.error(error);
  };

  (window as any).openFreestylerForm = (id?: string) => {
    const form = document.getElementById('freestylerForm');
    if (form) form.style.display = '';
    if (id) {
      const f = allFreestylers.find(x => x.id === id);
      if (f) {
        (document.getElementById('freestylerEditId') as HTMLInputElement).value = f.id;
        (document.getElementById('freestylerName') as HTMLInputElement).value = f.name || '';
        (document.getElementById('freestylerSlug') as HTMLInputElement).value = f.slug || '';
        (document.getElementById('freestylerAvatar') as HTMLInputElement).value = f.avatar_url || '';
        (document.getElementById('freestylerBio') as HTMLInputElement).value = f.bio || '';
      }
    } else {
      (document.getElementById('freestylerEditId') as HTMLInputElement).value = '';
      (document.getElementById('freestylerName') as HTMLInputElement).value = '';
      (document.getElementById('freestylerSlug') as HTMLInputElement).value = '';
      (document.getElementById('freestylerAvatar') as HTMLInputElement).value = '';
      (document.getElementById('freestylerBio') as HTMLInputElement).value = '';
    }
  };

  (window as any).closeFreestylerForm = () => {
    const form = document.getElementById('freestylerForm');
    if (form) form.style.display = 'none';
  };

  (window as any).editFreestyler = (id: string) => {
    (window as any).openFreestylerForm(id);
  };

  (window as any).saveFreestyler = async () => {
    const editId = (document.getElementById('freestylerEditId') as HTMLInputElement).value;
    const name = (document.getElementById('freestylerName') as HTMLInputElement).value.trim();
    const slug = (document.getElementById('freestylerSlug') as HTMLInputElement).value.trim() || name.toLowerCase().replace(/\s+/g, '-').replace(/[^a-z0-9-]/g, '');
    const avatar_url = (document.getElementById('freestylerAvatar') as HTMLInputElement).value.trim();
    const bio = (document.getElementById('freestylerBio') as HTMLInputElement).value.trim();

    if (!name) { alert('El nombre es obligatorio'); return; }

    if (editId) {
      const { error } = await supabase.from('freestylers').update({ name, slug, avatar_url, bio, updated_at: new Date().toISOString() }).eq('id', editId);
      if (error) { console.error(error); alert('Error al actualizar'); return; }
    } else {
      const { error } = await supabase.from('freestylers').insert({ name, slug, avatar_url, bio, is_active: true });
      if (error) { console.error(error); alert('Error al crear'); return; }
    }
    (window as any).closeFreestylerForm();
    await loadFreestylers();
  };

  (window as any).deleteFreestyler = async (id: string) => {
    if (!confirm('¿Eliminar este freestyler?')) return;
    const { error } = await supabase.from('freestylers').delete().eq('id', id);
    if (error) { console.error(error); alert('Error al eliminar'); return; }
    await loadFreestylers();
  };

  // --- Stats ---
  (window as any).openStatsEditor = async (freestylerId: string) => {
    currentStatsFsId = freestylerId;
    const f = allFreestylers.find(x => x.id === freestylerId);
    document.getElementById('statsFreestylerName').textContent = f?.name || '—';

    const editor = document.getElementById('statsEditor');
    if (editor) editor.style.display = '';

    // Load existing stats
    const { data, error } = await supabase.from('freestyler_stats').select('*').eq('freestyler_id', freestylerId);
    if (!error && data) {
      currentStats = {
        flow: 0, punchline: 0, estructura: 0, puesta_en_escena: 0, doble_tempo: 0, figuras_literarias: 0,
      };
      data.forEach((s: any) => { if (s.stat_name in currentStats) currentStats[s.stat_name] = s.stat_value; });
    }

    renderStatSliders();
  };

  function renderStatSliders() {
    const container = document.getElementById('statsSliders');
    if (!container) return;
    container.innerHTML = Object.entries(STAT_LABELS).map(([key, label]) => `
      <div class="stat-slider-row">
        <label>${label} <span id="stat-val-${key}">${currentStats[key] ?? 0}</span></label>
        <input type="range" min="0" max="100" value="${currentStats[key] ?? 0}" oninput="updateStat('${key}', this.value)" />
      </div>
    `).join('');
  }

  (window as any).updateStat = (key: string, val: string) => {
    currentStats[key] = parseInt(val, 10);
    const el = document.getElementById(`stat-val-${key}`);
    if (el) el.textContent = val;
  };

  (window as any).saveStats = async () => {
    if (!currentStatsFsId) return;
    // Upsert each stat
    const ops = Object.entries(currentStats).map(async ([stat_name, stat_value]) => {
      // Check if exists
      const { data: existing } = await supabase.from('freestyler_stats').select('id').eq('freestyler_id', currentStatsFsId).eq('stat_name', stat_name).single();
      if (existing) {
        return supabase.from('freestyler_stats').update({ stat_value }).eq('id', existing.id);
      } else {
        return supabase.from('freestyler_stats').insert({ freestyler_id: currentStatsFsId, stat_name, stat_value });
      }
    });
    const results = await Promise.all(ops);
    const hasError = results.some(r => r.error);
    if (hasError) { alert('Error al guardar stats'); return; }
    alert('Stats guardadas');
  };

  (window as any).closeStatsEditor = () => {
    currentStatsFsId = null;
    const editor = document.getElementById('statsEditor');
    if (editor) editor.style.display = 'none';
  };

  // --- Battles ---
  function populateBattleDropdowns() {
    const opts = '<option value="">Seleccionar...</option>' + allFreestylers.filter(f => f.is_active).map(f => `<option value="${f.id}">${f.name}</option>`).join('');
    const fs1 = document.getElementById('battleFs1');
    const fs2 = document.getElementById('battleFs2');
    if (fs1) fs1.innerHTML = opts;
    if (fs2) fs2.innerHTML = opts;
  }

  async function loadBattles() {
    const { data, error } = await supabase
      .from('versus_battles')
      .select('*')
      .order('created_at', { ascending: false });
    if (error) { console.error(error); return; }
    allBattles = data || [];
    renderBattles();
  }

  function getNameById(id: string | null): string {
    if (!id) return '—';
    const f = allFreestylers.find(x => x.id === id);
    return f?.name || 'Desconocido';
  }

  function renderBattles() {
    const tbody = document.getElementById('battlesBody');
    if (!tbody) return;
    if (!allBattles.length) {
      tbody.innerHTML = '<tr><td colspan="8" class="erp-loading">No hay battles</td></tr>';
      return;
    }
    tbody.innerHTML = allBattles.map(b => `
      <tr>
        <td style="font-weight:600;color:#fff;">${getNameById(b.freestyler1_id)}</td>
        <td><span class="vs-badge">VS</span></td>
        <td style="font-weight:600;color:#fff;">${getNameById(b.freestyler2_id)}</td>
        <td style="color:${b.winner_id ? '#00ff88' : 'rgba(255,255,255,0.3)'}; font-weight:600;">${b.winner_id ? getNameById(b.winner_id) : '—'}</td>
        <td style="font-weight:700;color:#C98300;">${b.total_votes || 0}</td>
        <td>
          <span class="erp-status ${b.status === 'active' ? 'erp-status--pending' : 'erp-status--approved'}">${b.status === 'active' ? 'Activa' : 'Completada'}</span>
        </td>
        <td style="color:rgba(255,255,255,0.5);font-size:12px;">${b.created_at ? new Date(b.created_at).toLocaleDateString('es') : '—'}</td>
        <td>
          <div style="display:flex;gap:4px;">
            ${b.status === 'active' ? `<button class="erp-btn erp-btn--ghost btn-sm" onclick="openCompleteBattle('${b.id}')">🏆 Completar</button>` : ''}
            <button class="erp-btn erp-btn--danger btn-sm" onclick="deleteBattle('${b.id}')">🗑️</button>
          </div>
        </td>
      </tr>
    `).join('');
  }

  (window as any).openBattleForm = () => {
    const form = document.getElementById('battleForm');
    if (form) form.style.display = '';
    populateBattleDropdowns();
  };

  (window as any).closeBattleForm = () => {
    const form = document.getElementById('battleForm');
    if (form) form.style.display = 'none';
  };

  (window as any).saveBattle = async () => {
    const fs1 = (document.getElementById('battleFs1') as HTMLSelectElement).value;
    const fs2 = (document.getElementById('battleFs2') as HTMLSelectElement).value;

    if (!fs1 || !fs2) { alert('Selecciona ambos freestylers'); return; }
    if (fs1 === fs2) { alert('Selecciona freestylers diferentes'); return; }

    const { error } = await supabase.from('versus_battles').insert({
      freestyler1_id: fs1,
      freestyler2_id: fs2,
      total_votes: 0,
      status: 'active',
    });
    if (error) { console.error(error); alert('Error al crear battle'); return; }
    (window as any).closeBattleForm();
    await loadBattles();
  };

  (window as any).openCompleteBattle = (battleId: string) => {
    const b = allBattles.find(x => x.id === battleId);
    if (!b) return;
    document.getElementById('completeBattleId').value = battleId;
    document.getElementById('completeFs1Name').textContent = getNameById(b.freestyler1_id);
    document.getElementById('completeFs2Name').textContent = getNameById(b.freestyler2_id);

    const winnerSelect = document.getElementById('battleWinner') as HTMLSelectElement;
    winnerSelect.innerHTML = `<option value="">Seleccionar ganador...</option>
      <option value="${b.freestyler1_id}">${getNameById(b.freestyler1_id)}</option>
      <option value="${b.freestyler2_id}">${getNameById(b.freestyler2_id)}</option>`;

    const modal = document.getElementById('completeBattleModal');
    if (modal) modal.style.display = '';
  };

  (window as any).closeCompleteBattleModal = () => {
    const modal = document.getElementById('completeBattleModal');
    if (modal) modal.style.display = 'none';
  };

  (window as any).completeBattle = async () => {
    const battleId = (document.getElementById('completeBattleId') as HTMLInputElement).value;
    const winnerId = (document.getElementById('battleWinner') as HTMLSelectElement).value;
    if (!winnerId) { alert('Selecciona un ganador'); return; }

    const { error } = await supabase.from('versus_battles').update({
      winner_id: winnerId,
      status: 'completed',
      completed_at: new Date().toISOString(),
    }).eq('id', battleId);
    if (error) { console.error(error); alert('Error al completar battle'); return; }
    (window as any).closeCompleteBattleModal();
    await loadBattles();
  };

  (window as any).deleteBattle = async (id: string) => {
    if (!confirm('¿Eliminar esta battle?')) return;
    const { error } = await supabase.from('versus_battles').delete().eq('id', id);
    if (error) { console.error(error); alert('Error al eliminar'); return; }
    await loadBattles();
  };

  // --- Init ---
  (async () => {
    await loadFreestylers();
    await loadBattles();
  })();
</script>
