---
import ErpLayout from '../../layouts/ErpLayout.astro';
---

<ErpLayout title="Usuarios" activeModule="usuarios">
  <!-- Stats -->
  <div class="erp-grid" style="margin-bottom:24px;">
    <div class="erp-card">
      <div class="erp-card-title">Total Usuarios</div>
      <div class="erp-stat" id="statTotal">-</div>
    </div>
    <div class="erp-card">
      <div class="erp-card-title">Artistas</div>
      <div class="erp-stat" id="statArtists">-</div>
    </div>
    <div class="erp-card">
      <div class="erp-card-title">Staff</div>
      <div class="erp-stat" id="statStaff">-</div>
    </div>
    <div class="erp-card">
      <div class="erp-card-title">Fans</div>
      <div class="erp-stat" id="statFans">-</div>
    </div>
  </div>

  <!-- Pending Artist Verifications -->
  <div id="verificationsSection" style="display:none;margin-bottom:24px;">
    <h2 style="margin-bottom:12px;font-size:14px;font-weight:800;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-muted);">Verificaciones de Artista Pendientes</h2>
    <div class="erp-card" style="overflow-x:auto;">
      <table class="erp-table">
        <thead>
          <tr>
            <th>Username</th>
            <th>Nombre</th>
            <th>Avatar</th>
            <th>Fecha Solicitud</th>
            <th>Acciones</th>
          </tr>
        </thead>
        <tbody id="verificationsBody">
          <tr><td colspan="5" class="erp-loading">Cargando...</td></tr>
        </tbody>
      </table>
    </div>
  </div>

  <!-- Search & Filter -->
  <div style="display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;flex-wrap:wrap;gap:12px;">
    <div style="display:flex;gap:8px;align-items:center;flex-wrap:wrap;">
      <input
        type="text"
        id="searchInput"
        placeholder="Buscar por username o nombre..."
        style="background:var(--bg-card);border:1px solid var(--border-muted);border-radius:8px;padding:8px 14px;color:#fff;font-size:13px;outline:none;min-width:240px;"
      />
      <select id="roleFilter" class="erp-btn erp-btn--ghost" style="padding:8px 12px;font-size:12px;">
        <option value="all">Todos</option>
        <option value="admin">Admin</option>
        <option value="artist">Artist</option>
        <option value="staff">Staff</option>
        <option value="fan">Fan</option>
        <option value="guest">Guest</option>
      </select>
    </div>
    <span style="font-size:11px;color:var(--border-soft);" id="userCount">-</span>
  </div>

  <!-- Users Table -->
  <div class="erp-card" style="overflow-x:auto;">
    <table class="erp-table">
      <thead>
        <tr>
          <th>Username</th>
          <th>Nombre</th>
          <th>Avatar</th>
          <th>Artista Verificado</th>
          <th>Tags</th>
          <th>Creado</th>
          <th>Acciones</th>
        </tr>
      </thead>
      <tbody id="usersBody">
        <tr><td colspan="7" class="erp-loading">Cargando usuarios...</td></tr>
      </tbody>
    </table>
  </div>

  <!-- User Detail Modal -->
  <div id="detailModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:100;display:none;place-items:center;">
    <div class="erp-card" style="width:90%;max-width:560px;max-height:85vh;overflow-y:auto;position:relative;">
      <button onclick="closeModal('detailModal')" style="position:absolute;top:16px;right:16px;background:none;border:none;color:var(--text-muted);font-size:18px;cursor:pointer;">✕</button>
      <h3 style="font-size:16px;font-weight:800;margin-bottom:16px;color:#C98300;">Detalle del Usuario</h3>
      <div id="detailContent" style="font-size:13px;"></div>
    </div>
  </div>

  <!-- Role Management Modal -->
  <div id="roleModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:100;display:none;place-items:center;">
    <div class="erp-card" style="width:90%;max-width:440px;max-height:85vh;overflow-y:auto;position:relative;">
      <button onclick="closeModal('roleModal')" style="position:absolute;top:16px;right:16px;background:none;border:none;color:var(--text-muted);font-size:18px;cursor:pointer;">✕</button>
      <h3 style="font-size:16px;font-weight:800;margin-bottom:4px;color:#C98300;">Gestionar Roles</h3>
      <p id="roleModalUser" style="font-size:12px;color:var(--text-muted);margin-bottom:16px;"></p>
      <div id="roleCheckboxes" style="display:flex;flex-direction:column;gap:8px;margin-bottom:20px;"></div>
      <div style="display:flex;gap:8px;justify-content:flex-end;">
        <button class="erp-btn erp-btn--ghost" onclick="closeModal('roleModal')">Cancelar</button>
        <button class="erp-btn erp-btn--primary" id="saveRolesBtn" onclick="saveUserRoles()">Guardar Roles</button>
      </div>
    </div>
  </div>

  <!-- Tag Management Modal -->
  <div id="tagModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:100;display:none;place-items:center;">
    <div class="erp-card" style="width:90%;max-width:440px;max-height:85vh;overflow-y:auto;position:relative;">
      <button onclick="closeModal('tagModal')" style="position:absolute;top:16px;right:16px;background:none;border:none;color:var(--text-muted);font-size:18px;cursor:pointer;">✕</button>
      <h3 style="font-size:16px;font-weight:800;margin-bottom:4px;color:#C98300;">Gestionar Tags</h3>
      <p id="tagModalUser" style="font-size:12px;color:var(--text-muted);margin-bottom:16px;"></p>
      <div id="tagCheckboxes" style="display:flex;flex-direction:column;gap:8px;margin-bottom:20px;"></div>
      <div style="display:flex;gap:8px;justify-content:flex-end;">
        <button class="erp-btn erp-btn--ghost" onclick="closeModal('tagModal')">Cancelar</button>
        <button class="erp-btn erp-btn--primary" id="saveTagsBtn" onclick="saveUserTags()">Guardar Tags</button>
      </div>
    </div>
  </div>

  <!-- Edit Profile Modal -->
  <div id="editModal" style="display:none;position:fixed;inset:0;background:rgba(0,0,0,0.7);z-index:100;display:none;place-items:center;">
    <div class="erp-card" style="width:90%;max-width:440px;max-height:85vh;overflow-y:auto;position:relative;">
      <button onclick="closeModal('editModal')" style="position:absolute;top:16px;right:16px;background:none;border:none;color:var(--text-muted);font-size:18px;cursor:pointer;">✕</button>
      <h3 style="font-size:16px;font-weight:800;margin-bottom:16px;color:#C98300;">Editar Perfil</h3>
      <div style="display:flex;flex-direction:column;gap:12px;">
        <label style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-muted);">Username</label>
        <input id="editUsername" type="text" style="background:var(--bg-card);border:1px solid var(--border-muted);border-radius:8px;padding:8px 14px;color:#fff;font-size:13px;outline:none;" />
        <label style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-muted);">Nombre</label>
        <input id="editNombre" type="text" style="background:var(--bg-card);border:1px solid var(--border-muted);border-radius:8px;padding:8px 14px;color:#fff;font-size:13px;outline:none;" />
        <label style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-muted);">Phone</label>
        <input id="editPhone" type="text" style="background:var(--bg-card);border:1px solid var(--border-muted);border-radius:8px;padding:8px 14px;color:#fff;font-size:13px;outline:none;" />
        <label style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-muted);">Ubicación</label>
        <input id="editUbicacion" type="text" style="background:var(--bg-card);border:1px solid var(--border-muted);border-radius:8px;padding:8px 14px;color:#fff;font-size:13px;outline:none;" />
        <label style="font-size:11px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:var(--text-muted);">Avatar URL</label>
        <input id="editAvatar" type="text" style="background:var(--bg-card);border:1px solid var(--border-muted);border-radius:8px;padding:8px 14px;color:#fff;font-size:13px;outline:none;" />
      </div>
      <div style="display:flex;gap:8px;justify-content:flex-end;margin-top:20px;">
        <button class="erp-btn erp-btn--ghost" onclick="closeModal('editModal')">Cancelar</button>
        <button class="erp-btn erp-btn--primary" onclick="saveProfileEdit()">Guardar</button>
      </div>
    </div>
  </div>
</ErpLayout>

<style>
  #detailModal, #roleModal, #tagModal, #editModal {
    display: none;
    place-items: center;
  }
  #detailModal.active, #roleModal.active, #tagModal.active, #editModal.active {
    display: grid;
  }
  #searchInput::placeholder { color: var(--border-soft); }
  #searchInput:focus { border-color: #C98300; }
  .checkbox-row {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 8px 12px;
    border-radius: 8px;
    background: var(--bg-card);
    border: 1px solid var(--border-faint);
    cursor: pointer;
    transition: background 0.15s;
  }
  .checkbox-row:hover { background: var(--border-faint); }
  .checkbox-row input[type="checkbox"] {
    accent-color: #C98300;
    width: 16px;
    height: 16px;
    cursor: pointer;
  }
  .checkbox-row label {
    font-size: 13px;
    color: var(--text);
    cursor: pointer;
    user-select: none;
    margin: 0;
  }
  .avatar-sm {
    width: 32px;
    height: 32px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--bg-card);
  }
  .tag-pill {
    display: inline-block;
    font-size: 10px;
    font-weight: 700;
    padding: 2px 8px;
    border-radius: 10px;
    background: rgba(201,131,0,0.15);
    color: #C98300;
    margin: 1px 2px;
  }
  .action-btn {
    background: var(--bg-card);
    border: 1px solid var(--bg-hover);
    color: var(--text-secondary);
    padding: 4px 8px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.15s;
  }
  .action-btn:hover { background: var(--border-muted); color: #fff; }
  .detail-field {
    display: flex;
    justify-content: space-between;
    padding: 8px 0;
    border-bottom: 1px solid var(--bg-card);
  }
  .detail-label {
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }
  .detail-value {
    color: var(--text);
    text-align: right;
    max-width: 60%;
    word-break: break-word;
  }
</style>

<script>
  import { supabase } from '../../lib/supabase';
  import { waitForPermissions } from '../../lib/erp-permissions';

  const { perms, role } = await waitForPermissions();
  const canView = perms.includes('*') || perms.includes('users.view');
  const canManage = perms.includes('*') || perms.includes('users.manage');
  const canVerify = perms.includes('*') || perms.includes('users.verify_artist');

  if (!canView) {
    document.querySelector('.erp-content')!.innerHTML = '<div class="erp-card" style="text-align:center;padding:60px;"><p style="color:var(--border-soft);">No tienes permiso para ver usuarios.</p></div>';
    throw new Error('Permission denied');
  }

  // --- State ---
  let allProfiles = [];
  let allRoles = [];
  let allTags = [];
  let userRolesMap = {};   // userId -> [{role_id, role_name, role_id_val}]
  let userTagsMap = {};    // userId -> [{tag_id, tag_name}]
  let currentRoleUserId = null;
  let currentTagUserId = null;
  let currentEditUserId = null;
  let currentFilter = 'all';
  let searchQuery = '';

  // --- Helpers ---
  (window as any).closeModal = (id: string) => {
    document.getElementById(id)?.classList.remove('active');
  };

  function openModal(id: string) {
    document.getElementById(id)?.classList.add('active');
  }

  function esc(s: string) {
    if (!s) return '';
    return s.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
  }

  function formatDate(iso: string) {
    if (!iso) return '-';
    return new Date(iso).toLocaleDateString('es-MX', { day:'2-digit', month:'short', year:'numeric' });
  }

  // --- Load Data ---
  async function loadAllData() {
    const [rolesRes, tagsRes] = await Promise.all([
      supabase.from('roles').select('id, name, internal_name').order('name'),
      supabase.from('tags').select('id, name').order('name')
    ]);
    allRoles = rolesRes.data || [];
    allTags = tagsRes.data || [];

    await loadProfiles();
    await loadVerifications();
  }

  async function loadProfiles() {
    const { data: profiles, count } = await supabase
      .from('profiles')
      .select('*', { count: 'exact' })
      .order('created_at', { ascending: false });

    allProfiles = profiles || [];

    // Load roles for all users
    const { data: allUserRoles } = await supabase
      .from('user_roles')
      .select('user_id, role_id');

    userRolesMap = {};
    (allUserRoles || []).forEach((ur: any) => {
      if (!userRolesMap[ur.user_id]) userRolesMap[ur.user_id] = [];
      const role = allRoles.find((r: any) => r.id === ur.role_id);
      userRolesMap[ur.user_id].push({
        role_id: ur.role_id,
        role_name: role?.name || ur.role_id,
        role_internal: role?.internal_name || ''
      });
    });

    // Load tags for all users
    const { data: allUserTags } = await supabase
      .from('user_has_tags')
      .select('user_id, tag_id');

    userTagsMap = {};
    (allUserTags || []).forEach((ut: any) => {
      if (!userTagsMap[ut.user_id]) userTagsMap[ut.user_id] = [];
      const tag = allTags.find((t: any) => t.id === ut.tag_id);
      userTagsMap[ut.user_id].push({
        tag_id: ut.tag_id,
        tag_name: tag?.name || ut.tag_id
      });
    });

    renderStats();
    renderUsersTable();
  }

  // --- Stats ---
  function renderStats() {
    const total = allProfiles.length;
    let artists = 0, staff = 0, fans = 0;
    allProfiles.forEach((p: any) => {
      const roles = (userRolesMap[p.id] || []).map((r: any) => r.role_internal);
      if (roles.includes('artist') || roles.includes('admin')) artists++;
      if (roles.includes('staff') || roles.includes('staff_manager') || roles.includes('staff_marketing')) staff++;
      if (roles.includes('fan')) fans++;
    });
    document.getElementById('statTotal')!.textContent = String(total);
    document.getElementById('statArtists')!.textContent = String(artists);
    document.getElementById('statStaff')!.textContent = String(staff);
    document.getElementById('statFans')!.textContent = String(fans);
  }

  // --- Artist Verifications ---
  async function loadVerifications() {
    const { data: pending } = await supabase
      .from('profiles')
      .select('*')
      .eq('verification_status', 'pending');

    const section = document.getElementById('verificationsSection')!;
    const tbody = document.getElementById('verificationsBody')!;

    if (!pending || pending.length === 0) {
      section.style.display = 'none';
      return;
    }

    section.style.display = 'block';
    tbody.innerHTML = pending.map((p: any) => `
      <tr>
        <td style="font-weight:700;">${esc(p.username || '-')}</td>
        <td>${esc(p.nombre || '-')}</td>
        <td><img class="avatar-sm" src="${esc(p.avatar_url || '')}" alt="" onerror="this.style.display='none'" /></td>
        <td style="font-size:11px;color:var(--text-muted);">${formatDate(p.created_at)}</td>
        <td>
          <div style="display:flex;gap:6px;">
            ${canVerify ? `<button class="erp-btn erp-btn--primary" style="padding:4px 10px;font-size:10px;" onclick="approveVerification('${p.id}')">Aprobar</button>` : ''}
            ${canVerify ? `<button class="erp-btn erp-btn--danger" style="padding:4px 10px;font-size:10px;" onclick="rejectVerification('${p.id}')">Rechazar</button>` : ''}
          </div>
        </td>
      </tr>
    `).join('');
  }

  (window as any).approveVerification = async (userId: string) => {
    await supabase.from('profiles').update({ verification_status: 'approved', is_verified_artist: true }).eq('id', userId);
    loadVerifications();
    loadProfiles();
  };

  (window as any).rejectVerification = async (userId: string) => {
    await supabase.from('profiles').update({ verification_status: 'rejected' }).eq('id', userId);
    loadVerifications();
  };

  // --- Users Table ---
  function renderUsersTable() {
    let filtered = allProfiles;

    // Search
    if (searchQuery) {
      const q = searchQuery.toLowerCase();
      filtered = filtered.filter((p: any) =>
        (p.username || '').toLowerCase().includes(q) ||
        (p.nombre || '').toLowerCase().includes(q)
      );
    }

    // Role filter
    if (currentFilter !== 'all') {
      filtered = filtered.filter((p: any) => {
        const roles = (userRolesMap[p.id] || []).map((r: any) => r.role_internal);
        if (currentFilter === 'staff') {
          return roles.includes('staff') || roles.includes('staff_manager') || roles.includes('staff_marketing');
        }
        return roles.includes(currentFilter);
      });
    }

    document.getElementById('userCount')!.textContent = `${filtered.length} usuario${filtered.length !== 1 ? 's' : ''}`;

    const tbody = document.getElementById('usersBody')!;
    if (filtered.length === 0) {
      tbody.innerHTML = '<tr><td colspan="7" style="text-align:center;color:var(--border-soft);padding:40px;">Sin resultados</td></tr>';
      return;
    }

    tbody.innerHTML = filtered.map((p: any) => {
      const tags = userTagsMap[p.id] || [];
      const tagsHtml = tags.length > 0
        ? tags.map((t: any) => `<span class="tag-pill">${esc(t.tag_name)}</span>`).join('')
        : '<span style="color:var(--border-soft);font-size:11px;">-</span>';

      const verifiedBadge = p.is_verified_artist
        ? '<span class="erp-status erp-status--approved">Verificado</span>'
        : p.verification_status === 'pending'
          ? '<span class="erp-status erp-status--pending">Pendiente</span>'
          : '<span style="color:var(--border-soft);font-size:11px;">No</span>';

      return `
        <tr>
          <td style="font-weight:700;">${esc(p.username || '-')}</td>
          <td>${esc(p.nombre || '-')}</td>
          <td><img class="avatar-sm" src="${esc(p.avatar_url || '')}" alt="" onerror="this.style.display='none'" /></td>
          <td>${verifiedBadge}</td>
          <td style="max-width:180px;">${tagsHtml}</td>
          <td style="font-size:11px;color:var(--text-muted);">${formatDate(p.created_at)}</td>
          <td>
            <div style="display:flex;gap:4px;flex-wrap:wrap;">
              <button class="action-btn" title="Ver detalles" onclick="viewDetail('${p.id}')">👁</button>
              ${canManage ? `<button class="action-btn" title="Gestionar roles" onclick="openRoleModal('${p.id}')">🛡</button>` : ''}
              ${canManage ? `<button class="action-btn" title="Gestionar tags" onclick="openTagModal('${p.id}')">🏷</button>` : ''}
              ${canManage ? `<button class="action-btn" title="Editar perfil" onclick="openEditModal('${p.id}')">✏️</button>` : ''}
            </div>
          </td>
        </tr>
      `;
    }).join('');
  }

  // --- Detail Modal ---
  (window as any).viewDetail = (userId: string) => {
    const p = allProfiles.find((x: any) => x.id === userId);
    if (!p) return;

    const roles = userRolesMap[userId] || [];
    const tags = userTagsMap[userId] || [];

    const rolesHtml = roles.length > 0
      ? roles.map((r: any) => `<span class="tag-pill" style="background:rgba(0,191,255,0.12);color:#00bfff;">${esc(r.role_name)}</span>`).join(' ')
      : '<span style="color:var(--border-soft);">Sin roles</span>';

    const tagsHtml = tags.length > 0
      ? tags.map((t: any) => `<span class="tag-pill">${esc(t.tag_name)}</span>`).join(' ')
      : '<span style="color:var(--border-soft);">Sin tags</span>';

    const content = document.getElementById('detailContent')!;
    content.innerHTML = `
      <div style="display:flex;align-items:center;gap:16px;margin-bottom:20px;">
        <img src="${esc(p.avatar_url || '')}" alt="" style="width:64px;height:64px;border-radius:50%;object-fit:cover;background:var(--bg-card);" onerror="this.style.display='none'" />
        <div>
          <div style="font-size:18px;font-weight:800;color:#fff;">${esc(p.username || '-')}</div>
          <div style="font-size:13px;color:var(--text-muted);">${esc(p.nombre || '-')}</div>
        </div>
      </div>

      <div class="detail-field">
        <span class="detail-label">ID</span>
        <span class="detail-value" style="font-size:11px;font-family:monospace;">${esc(p.id)}</span>
      </div>
      <div class="detail-field">
        <span class="detail-label">Username</span>
        <span class="detail-value">${esc(p.username || '-')}</span>
      </div>
      <div class="detail-field">
        <span class="detail-label">Nombre</span>
        <span class="detail-value">${esc(p.nombre || '-')}</span>
      </div>
      <div class="detail-field">
        <span class="detail-label">Phone</span>
        <span class="detail-value">${esc(p.phone || '-')}</span>
      </div>
      <div class="detail-field">
        <span class="detail-label">Ubicación</span>
        <span class="detail-value">${esc(p.ubicacion || '-')}</span>
      </div>
      <div class="detail-field">
        <span class="detail-label">Avatar URL</span>
        <span class="detail-value" style="font-size:11px;word-break:break-all;">${esc(p.avatar_url || '-')}</span>
      </div>
      <div class="detail-field">
        <span class="detail-label">Artista Verificado</span>
        <span class="detail-value">${p.is_verified_artist ? '<span class="erp-status erp-status--approved">Sí</span>' : 'No'}</span>
      </div>
      <div class="detail-field">
        <span class="detail-label">Verificación</span>
        <span class="detail-value">${esc(p.verification_status || 'none')}</span>
      </div>
      <div class="detail-field">
        <span class="detail-label">Creado</span>
        <span class="detail-value">${formatDate(p.created_at)}</span>
      </div>
      <div class="detail-field">
        <span class="detail-label">Actualizado</span>
        <span class="detail-value">${formatDate(p.updated_at)}</span>
      </div>

      <div style="margin-top:20px;">
        <div class="detail-label" style="margin-bottom:8px;">Roles</div>
        <div>${rolesHtml}</div>
      </div>
      <div style="margin-top:16px;">
        <div class="detail-label" style="margin-bottom:8px;">Tags</div>
        <div>${tagsHtml}</div>
      </div>
    `;

    openModal('detailModal');
  };

  // --- Role Modal ---
  (window as any).openRoleModal = (userId: string) => {
    currentRoleUserId = userId;
    const p = allProfiles.find((x: any) => x.id === userId);
    document.getElementById('roleModalUser')!.textContent = p ? `${p.username || p.nombre || userId}` : userId;

    const userRoleIds = (userRolesMap[userId] || []).map((r: any) => r.role_id);

    const container = document.getElementById('roleCheckboxes')!;
    container.innerHTML = allRoles.map((role: any) => {
      const checked = userRoleIds.includes(role.id) ? 'checked' : '';
      return `
        <div class="checkbox-row" onclick="this.querySelector('input').click()">
          <input type="checkbox" id="role_${role.id}" value="${role.id}" ${checked} onclick="event.stopPropagation()" />
          <label for="role_${role.id}">${esc(role.name)} <span style="color:var(--border-soft);font-size:11px;">(${esc(role.internal_name || '')})</span></label>
        </div>
      `;
    }).join('');

    openModal('roleModal');
  };

  (window as any).saveUserRoles = async () => {
    if (!currentRoleUserId) return;
    const btn = document.getElementById('saveRolesBtn')!;
    btn.textContent = 'Guardando...';
    (btn as HTMLButtonElement).disabled = true;

    const selectedRoleIds = Array.from(document.querySelectorAll('#roleCheckboxes input[type="checkbox"]:checked'))
      .map((el: any) => el.value);

    // Delete existing
    await supabase.from('user_roles').delete().eq('user_id', currentRoleUserId);

    // Insert new
    if (selectedRoleIds.length > 0) {
      const rows = selectedRoleIds.map((roleId: string) => ({
        user_id: currentRoleUserId,
        role_id: roleId
      }));
      await supabase.from('user_roles').insert(rows);
    }

    btn.textContent = 'Guardar Roles';
    (btn as HTMLButtonElement).disabled = false;
    closeModal('roleModal');
    await loadProfiles();
    await loadVerifications();
  };

  // --- Tag Modal ---
  (window as any).openTagModal = (userId: string) => {
    currentTagUserId = userId;
    const p = allProfiles.find((x: any) => x.id === userId);
    document.getElementById('tagModalUser')!.textContent = p ? `${p.username || p.nombre || userId}` : userId;

    const userTagIds = (userTagsMap[userId] || []).map((t: any) => t.tag_id);

    const container = document.getElementById('tagCheckboxes')!;
    container.innerHTML = allTags.map((tag: any) => {
      const checked = userTagIds.includes(tag.id) ? 'checked' : '';
      return `
        <div class="checkbox-row" onclick="this.querySelector('input').click()">
          <input type="checkbox" id="tag_${tag.id}" value="${tag.id}" ${checked} onclick="event.stopPropagation()" />
          <label for="tag_${tag.id}">${esc(tag.name)}</label>
        </div>
      `;
    }).join('');

    openModal('tagModal');
  };

  (window as any).saveUserTags = async () => {
    if (!currentTagUserId) return;
    const btn = document.getElementById('saveTagsBtn')!;
    btn.textContent = 'Guardando...';
    (btn as HTMLButtonElement).disabled = true;

    const selectedTagIds = Array.from(document.querySelectorAll('#tagCheckboxes input[type="checkbox"]:checked'))
      .map((el: any) => el.value);

    // Delete existing
    await supabase.from('user_has_tags').delete().eq('user_id', currentTagUserId);

    // Insert new
    if (selectedTagIds.length > 0) {
      const rows = selectedTagIds.map((tagId: string) => ({
        user_id: currentTagUserId,
        tag_id: tagId
      }));
      await supabase.from('user_has_tags').insert(rows);
    }

    btn.textContent = 'Guardar Tags';
    (btn as HTMLButtonElement).disabled = false;
    closeModal('tagModal');
    await loadProfiles();
  };

  // --- Edit Profile Modal ---
  (window as any).openEditModal = (userId: string) => {
    const p = allProfiles.find((x: any) => x.id === userId);
    if (!p) return;
    currentEditUserId = userId;
    (document.getElementById('editUsername') as HTMLInputElement).value = p.username || '';
    (document.getElementById('editNombre') as HTMLInputElement).value = p.nombre || '';
    (document.getElementById('editPhone') as HTMLInputElement).value = p.phone || '';
    (document.getElementById('editUbicacion') as HTMLInputElement).value = p.ubicacion || '';
    (document.getElementById('editAvatar') as HTMLInputElement).value = p.avatar_url || '';
    openModal('editModal');
  };

  (window as any).saveProfileEdit = async () => {
    if (!currentEditUserId) return;
    const updates = {
      username: (document.getElementById('editUsername') as HTMLInputElement).value || null,
      nombre: (document.getElementById('editNombre') as HTMLInputElement).value || null,
      phone: (document.getElementById('editPhone') as HTMLInputElement).value || null,
      ubicacion: (document.getElementById('editUbicacion') as HTMLInputElement).value || null,
      avatar_url: (document.getElementById('editAvatar') as HTMLInputElement).value || null,
      updated_at: new Date().toISOString()
    };
    await supabase.from('profiles').update(updates).eq('id', currentEditUserId);
    closeModal('editModal');
    await loadProfiles();
  };

  // --- Search & Filter ---
  document.getElementById('searchInput')?.addEventListener('input', (e: any) => {
    searchQuery = e.target.value;
    renderUsersTable();
  });

  document.getElementById('roleFilter')?.addEventListener('change', (e: any) => {
    currentFilter = e.target.value;
    renderUsersTable();
  });

  // Close modals on backdrop click
  ['detailModal', 'roleModal', 'tagModal', 'editModal'].forEach(id => {
    document.getElementById(id)?.addEventListener('click', (e: any) => {
      if (e.target.id === id) closeModal(id);
    });
  });

  // Escape key closes modals
  document.addEventListener('keydown', (e: KeyboardEvent) => {
    if (e.key === 'Escape') {
      ['detailModal', 'roleModal', 'tagModal', 'editModal'].forEach(closeModal);
    }
  });

  // --- Init ---
  loadAllData();
</script>
