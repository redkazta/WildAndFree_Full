---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Checkout",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};
---

<Layout config={config}>
  <div class="min-h-screen bg-[var(--bg)] text-[var(--text)] pb-20 pt-8">
    <div class="max-w-6xl mx-auto px-4 md:px-8">

      <!-- Steps -->
      <div class="flex items-center justify-center gap-2 mb-10">
        <div class="flex items-center gap-2" id="step-1-indicator">
          <span class="w-8 h-8 rounded-full bg-[var(--primary)] text-[var(--bg)] flex items-center justify-center text-xs font-black">1</span>
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--primary)]">Carrito</span>
        </div>
        <div class="w-8 h-[1px] bg-[var(--border-faint)]"></div>
        <div class="flex items-center gap-2" id="step-2-indicator">
          <span class="w-8 h-8 rounded-full bg-[var(--bg-card)] text-[var(--text-muted)] flex items-center justify-center text-xs font-black border border-[var(--border-faint)]">2</span>
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--text-muted)]">Envío</span>
        </div>
        <div class="w-8 h-[1px] bg-[var(--border-faint)]"></div>
        <div class="flex items-center gap-2" id="step-3-indicator">
          <span class="w-8 h-8 rounded-full bg-[var(--bg-card)] text-[var(--text-muted)] flex items-center justify-center text-xs font-black border border-[var(--border-faint)]">3</span>
          <span class="text-xs font-bold uppercase tracking-wider text-[var(--text-muted)]">Pago</span>
        </div>
      </div>

      <!-- Step 1: Carrito -->
      <div id="step-1" class="checkout-step">
        <h2 class="text-2xl font-black uppercase mb-6">Tu Carrito</h2>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <div class="lg:col-span-2">
            <div id="checkout-items" class="space-y-4 min-h-[200px]">
              <p class="text-center text-[var(--text-muted)] py-10">Cargando tu carrito...</p>
            </div>
          </div>
          <div class="lg:col-span-1">
            <div class="bg-[var(--bg)] p-6 rounded-xl border border-[var(--border-faint)] sticky top-24">
              <h3 class="text-lg font-black uppercase mb-4 border-b border-[var(--border-faint)] pb-3">Resumen</h3>
              <div class="space-y-2 text-sm mb-4">
                <div class="flex justify-between text-[var(--text-muted)]"><span>Subtotal</span><span id="checkout-subtotal">$0.00</span></div>
                <div class="flex justify-between text-[var(--text-muted)]"><span>Envío</span><span class="text-[var(--primary)]">GRATIS</span></div>
                <div class="flex justify-between text-[var(--text)] font-black text-lg pt-3 border-t border-[var(--border-faint)]"><span>Total</span><span id="checkout-total">$0.00</span></div>
              </div>
              <button id="to-step-2" class="w-full py-3 bg-[var(--primary)] text-[var(--bg)] font-black text-xs uppercase tracking-[0.15em] rounded-xl hover:brightness-110 transition-all">Continuar al Envío</button>
              <a href="/tienda" class="block text-center text-xs text-[var(--text-muted)] hover:text-[var(--text)] uppercase font-bold tracking-wider mt-3">Seguir Comprando</a>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 2: Envío -->
      <div id="step-2" class="checkout-step hidden">
        <h2 class="text-2xl font-black uppercase mb-6">Datos de Envío</h2>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <div class="lg:col-span-2">
            <form id="shipping-form" class="bg-[var(--bg)] p-6 rounded-xl border border-[var(--border-faint)] space-y-5">
              <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                <div>
                  <label class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] mb-1.5 block">Nombre completo *</label>
                  <input type="text" id="ship-name" required class="w-full bg-[var(--bg)] border border-[var(--border)] rounded-lg px-4 py-3 text-sm text-[var(--text)] focus:outline-none focus:border-[var(--primary)] transition-colors" placeholder="Tu nombre" />
                </div>
                <div>
                  <label class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] mb-1.5 block">Teléfono *</label>
                  <input type="tel" id="ship-phone" required class="w-full bg-[var(--bg)] border border-[var(--border)] rounded-lg px-4 py-3 text-sm text-[var(--text)] focus:outline-none focus:border-[var(--primary)] transition-colors" placeholder="871-123-4567" />
                </div>
              </div>
              <div>
                <label class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] mb-1.5 block">Calle y número *</label>
                <input type="text" id="ship-address" required class="w-full bg-[var(--bg)] border border-[var(--border)] rounded-lg px-4 py-3 text-sm text-[var(--text)] focus:outline-none focus:border-[var(--primary)] transition-colors" placeholder="Av. Revolución 1234" />
              </div>
              <div>
                <label class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] mb-1.5 block">Colonia / Fraccionamiento</label>
                <input type="text" id="ship-colonia" class="w-full bg-[var(--bg)] border border-[var(--border)] rounded-lg px-4 py-3 text-sm text-[var(--text)] focus:outline-none focus:border-[var(--primary)] transition-colors" placeholder="Col. Centro" />
              </div>
              <div class="grid grid-cols-1 md:grid-cols-3 gap-5">
                <div>
                  <label class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] mb-1.5 block">Ciudad *</label>
                  <input type="text" id="ship-city" required class="w-full bg-[var(--bg)] border border-[var(--border)] rounded-lg px-4 py-3 text-sm text-[var(--text)] focus:outline-none focus:border-[var(--primary)] transition-colors" placeholder="Torreón" />
                </div>
                <div>
                  <label class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] mb-1.5 block">Estado *</label>
                  <input type="text" id="ship-state" required class="w-full bg-[var(--bg)] border border-[var(--border)] rounded-lg px-4 py-3 text-sm text-[var(--text)] focus:outline-none focus:border-[var(--primary)] transition-colors" placeholder="Coahuila" />
                </div>
                <div>
                  <label class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] mb-1.5 block">Código Postal *</label>
                  <input type="text" id="ship-zip" required class="w-full bg-[var(--bg)] border border-[var(--border)] rounded-lg px-4 py-3 text-sm text-[var(--text)] focus:outline-none focus:border-[var(--primary)] transition-colors" placeholder="27000" />
                </div>
              </div>
              <div>
                <label class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] mb-1.5 block">Referencias</label>
                <textarea id="ship-references" rows="2" class="w-full bg-[var(--bg)] border border-[var(--border)] rounded-lg px-4 py-3 text-sm text-[var(--text)] focus:outline-none focus:border-[var(--primary)] transition-colors resize-none" placeholder="Casa azul, entre calles..."></textarea>
              </div>
            </form>
          </div>
          <div class="lg:col-span-1">
            <div class="bg-[var(--bg)] p-6 rounded-xl border border-[var(--border-faint)] sticky top-24">
              <h3 class="text-lg font-black uppercase mb-4 border-b border-[var(--border-faint)] pb-3">Resumen</h3>
              <div id="step2-summary" class="space-y-2 text-sm mb-4"></div>
              <div class="flex gap-3 mt-4">
                <button id="back-to-step-1" class="flex-1 py-3 border border-[var(--border)] rounded-xl font-bold text-xs uppercase tracking-widest hover:bg-[var(--bg-card)] transition-all">Atrás</button>
                <button id="to-step-3" class="flex-1 py-3 bg-[var(--primary)] text-[var(--bg)] font-black text-xs uppercase tracking-[0.15em] rounded-xl hover:brightness-110 transition-all">Ir a Pago</button>
              </div>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 3: Pago -->
      <div id="step-3" class="checkout-step hidden">
        <h2 class="text-2xl font-black uppercase mb-6">Método de Pago</h2>
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
          <div class="lg:col-span-2 space-y-4">

            <!-- Tarjeta -->
            <label class="payment-option block bg-[var(--bg)] p-5 rounded-xl border border-[var(--border-faint)] cursor-pointer hover:border-[var(--primary)]/40 transition-all has-[:checked]:border-[var(--primary)] has-[:checked]:bg-[var(--primary)]/5">
              <div class="flex items-center gap-4">
                <input type="radio" name="payment" value="card" checked class="accent-[var(--primary)] w-4 h-4" />
                <div class="flex items-center gap-3 flex-1">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text)" stroke-width="2"><rect x="1" y="4" width="22" height="16" rx="2"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
                  <span class="font-bold text-sm">Tarjeta de Crédito / Débito</span>
                </div>
                <div class="flex gap-1">
                  <span class="text-[10px] font-black px-2 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-faint)]">VISA</span>
                  <span class="text-[10px] font-black px-2 py-1 rounded bg-[var(--bg-card)] border border-[var(--border-faint)]">MC</span>
                </div>
              </div>
              <div id="card-fields" class="mt-5 space-y-4 pl-8">
                <div>
                  <label class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] mb-1.5 block">Número de tarjeta</label>
                  <input type="text" id="card-number" maxlength="19" class="w-full bg-[var(--bg)] border border-[var(--border)] rounded-lg px-4 py-3 text-sm text-[var(--text)] focus:outline-none focus:border-[var(--primary)] transition-colors" placeholder="1234 5678 9012 3456" />
                </div>
                <div class="grid grid-cols-2 gap-4">
                  <div>
                    <label class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] mb-1.5 block">Vencimiento</label>
                    <input type="text" id="card-expiry" maxlength="5" class="w-full bg-[var(--bg)] border border-[var(--border)] rounded-lg px-4 py-3 text-sm text-[var(--text)] focus:outline-none focus:border-[var(--primary)] transition-colors" placeholder="MM/AA" />
                  </div>
                  <div>
                    <label class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] mb-1.5 block">CVV</label>
                    <input type="text" id="card-cvv" maxlength="4" class="w-full bg-[var(--bg)] border border-[var(--border)] rounded-lg px-4 py-3 text-sm text-[var(--text)] focus:outline-none focus:border-[var(--primary)] transition-colors" placeholder="123" />
                  </div>
                </div>
                <div>
                  <label class="text-xs font-bold uppercase tracking-widest text-[var(--text-muted)] mb-1.5 block">Nombre en la tarjeta</label>
                  <input type="text" id="card-name" class="w-full bg-[var(--bg)] border border-[var(--border)] rounded-lg px-4 py-3 text-sm text-[var(--text)] focus:outline-none focus:border-[var(--primary)] transition-colors" placeholder="Como aparece en la tarjeta" />
                </div>
              </div>
            </label>

            <!-- OXXO -->
            <label class="payment-option block bg-[var(--bg)] p-5 rounded-xl border border-[var(--border-faint)] cursor-pointer hover:border-[var(--primary)]/40 transition-all has-[:checked]:border-[var(--primary)] has-[:checked]:bg-[var(--primary)]/5">
              <div class="flex items-center gap-4">
                <input type="radio" name="payment" value="oxxo" class="accent-[var(--primary)] w-4 h-4" />
                <div class="flex items-center gap-3 flex-1">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text)" stroke-width="2"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2z"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                  <span class="font-bold text-sm">OXXO Pay</span>
                </div>
                <span class="text-[10px] text-[var(--text-muted)]">Pago en efectivo</span>
              </div>
              <p class="mt-3 pl-8 text-xs text-[var(--text-muted)]">Recibirás un código de referencia para pagar en cualquier tienda OXXO. Válido por 24 horas.</p>
            </label>

            <!-- PayPal -->
            <label class="payment-option block bg-[var(--bg)] p-5 rounded-xl border border-[var(--border-faint)] cursor-pointer hover:border-[var(--primary)]/40 transition-all has-[:checked]:border-[var(--primary)] has-[:checked]:bg-[var(--primary)]/5">
              <div class="flex items-center gap-4">
                <input type="radio" name="payment" value="paypal" class="accent-[var(--primary)] w-4 h-4" />
                <div class="flex items-center gap-3 flex-1">
                  <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="var(--text)" stroke-width="2"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2z"/><path d="M8 12h4c1.1 0 2-.9 2-2s-.9-2-2-2H8v8"/></svg>
                  <span class="font-bold text-sm">PayPal</span>
                </div>
                <span class="text-[10px] text-[var(--text-muted)]">Redirect</span>
              </div>
              <p class="mt-3 pl-8 text-xs text-[var(--text-muted)]">Serás redirigido a PayPal para completar el pago de forma segura.</p>
            </label>
          </div>

          <div class="lg:col-span-1">
            <div class="bg-[var(--bg)] p-6 rounded-xl border border-[var(--border-faint)] sticky top-24">
              <h3 class="text-lg font-black uppercase mb-4 border-b border-[var(--border-faint)] pb-3">Tu Pedido</h3>
              <div id="step3-summary" class="space-y-3 text-sm mb-4"></div>
              <div class="border-t border-[var(--border-faint)] pt-3 space-y-2 text-sm">
                <div class="flex justify-between text-[var(--text-muted)]"><span>Subtotal</span><span id="pay-subtotal">$0.00</span></div>
                <div class="flex justify-between text-[var(--text-muted)]"><span>Envío</span><span class="text-[var(--primary)]">GRATIS</span></div>
                <div class="flex justify-between text-[var(--text)] font-black text-lg pt-2 border-t border-[var(--border-faint)]"><span>Total</span><span id="pay-total">$0.00</span></div>
              </div>
              <div class="flex gap-3 mt-5">
                <button id="back-to-step-2" class="flex-1 py-3 border border-[var(--border)] rounded-xl font-bold text-xs uppercase tracking-widest hover:bg-[var(--bg-card)] transition-all">Atrás</button>
                <button id="place-order" class="flex-1 py-3 bg-[var(--primary)] text-[var(--bg)] font-black text-xs uppercase tracking-[0.15em] rounded-xl hover:brightness-110 transition-all">Pagar</button>
              </div>
              <p class="text-[10px] text-[var(--text-muted)] text-center mt-3">Al continuar aceptas nuestros <a href="/terminos" class="underline hover:text-[var(--text)]">términos y condiciones</a></p>
            </div>
          </div>
        </div>
      </div>

      <!-- Step 4: Confirmación -->
      <div id="step-4" class="checkout-step hidden text-center py-20">
        <div class="w-20 h-20 rounded-full bg-[var(--primary)]/10 flex items-center justify-center mx-auto mb-6">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="var(--primary)" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
        </div>
        <h2 class="text-3xl font-black uppercase mb-3">¡Pedido Confirmado!</h2>
        <p class="text-[var(--text-muted)] mb-2">Tu orden <span class="text-[var(--primary)] font-bold" id="order-id">WG-0000</span> está siendo procesada.</p>
        <p class="text-xs text-[var(--text-muted)] mb-8">Recibirás un correo con los detalles de tu compra.</p>
        <a href="/tienda" class="inline-block px-8 py-3 bg-[var(--primary)] text-[var(--bg)] rounded-xl font-black text-xs uppercase tracking-[0.15em] hover:brightness-110 transition-all">Seguir Comprando</a>
      </div>

    </div>
  </div>
</Layout>

<style>
  .checkout-step.hidden { display: none; }
</style>

<script>
  import { cartStore, CartEvents } from '../lib/cart.js';

  let currentStep = 1;
  const steps = [1, 2, 3, 4];

  function showStep(n: number) {
    currentStep = n;
    steps.forEach(s => {
      const el = document.getElementById(`step-${s}`);
      const ind = document.getElementById(`step-${s}-indicator`);
      if (el) el.classList.toggle('hidden', s !== n);
      if (ind) {
        const dot = ind.querySelector('span:first-child') as HTMLElement;
        const label = ind.querySelector('span:last-child') as HTMLElement;
        if (s <= n) {
          dot.className = 'w-8 h-8 rounded-full bg-[var(--primary)] text-[var(--bg)] flex items-center justify-center text-xs font-black';
          label.className = 'text-xs font-bold uppercase tracking-wider text-[var(--primary)]';
        } else {
          dot.className = 'w-8 h-8 rounded-full bg-[var(--bg-card)] text-[var(--text-muted)] flex items-center justify-center text-xs font-black border border-[var(--border-faint)]';
          label.className = 'text-xs font-bold uppercase tracking-wider text-[var(--text-muted)]';
        }
      }
    });
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function renderCart() {
    const cart = cartStore.cart;
    const container = document.getElementById('checkout-items');
    const subtotalEl = document.getElementById('checkout-subtotal');
    const totalEl = document.getElementById('checkout-total');
    if (!container) return;

    if (cart.length === 0) {
      container.innerHTML = `
        <div class="text-center py-10">
          <p class="text-[var(--text-muted)] mb-4">Tu carrito está vacío.</p>
          <a href="/tienda" class="inline-block px-6 py-3 bg-[var(--primary)] text-[var(--bg)] font-black text-xs uppercase tracking-widest rounded-xl">Ir a la Tienda</a>
        </div>`;
      if (subtotalEl) subtotalEl.textContent = '$0.00';
      if (totalEl) totalEl.textContent = '$0.00';
      return;
    }

    container.innerHTML = cart.map(item => `
      <div class="flex gap-4 items-center bg-[var(--bg)] p-4 rounded-xl border border-[var(--border-faint)]">
        <div class="w-20 h-20 bg-[var(--bg-card)] flex-shrink-0 rounded-lg overflow-hidden flex items-center justify-center">
          ${item.image ? `<img src="${item.image}" width="80" height="80" class="w-full h-full object-cover" />` : `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="var(--text-muted)" stroke-width="1.5"><rect x="3" y="3" width="18" height="18" rx="2"/><text x="12" y="16" text-anchor="middle" font-size="10" font-weight="900" fill="var(--text-muted)" stroke="none">?</text></svg>`}
        </div>
        <div class="flex-1 min-w-0">
        <h4 class="font-bold text-sm text-[var(--text)] uppercase truncate">${item.name || 'Producto'}</h4>
        ${item.size || item.color ? `<p class="text-[10px] text-[var(--text-muted)] font-bold uppercase tracking-wider mt-0.5">${item.size || ''}${item.size && item.color ? ' / ' : ''}${item.color || ''}</p>` : ''}
        <p class="text-xs text-[var(--text-muted)]">$${item.price} c/u</p>
        <div class="flex items-center gap-3 mt-2">
          <div class="flex items-center border border-[var(--border)] rounded-lg overflow-hidden">
            <button class="px-3 py-1 text-[var(--text)] hover:bg-[var(--bg-card)] transition-colors qty-btn" data-key="${item.cart_key || item.id}" data-action="decrease">−</button>
            <span class="px-3 text-sm font-bold">${item.quantity}</span>
            <button class="px-3 py-1 text-[var(--text)] hover:bg-[var(--bg-card)] transition-colors qty-btn" data-key="${item.cart_key || item.id}" data-action="increase">+</button>
          </div>
          <button class="text-xs text-[var(--secondary)] hover:underline font-bold uppercase remove-btn" data-key="${item.cart_key || item.id}">Eliminar</button>
        </div>
      </div>
        <p class="font-black text-[var(--primary)] text-lg">$${(item.price * item.quantity).toFixed(2)}</p>
      </div>`).join('');

    const total = cart.reduce((acc, item) => acc + (item.price * item.quantity), 0);
    if (subtotalEl) subtotalEl.textContent = `$${total.toFixed(2)}`;
    if (totalEl) totalEl.textContent = `$${total.toFixed(2)}`;

    container.querySelectorAll('.qty-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const t = e.currentTarget as HTMLElement;
        const key = t.dataset.key!;
        const action = t.dataset.action;
        const item = cart.find((i: any) => (i.cart_key || i.id) === key);
        if (!item) return;
        if (action === 'increase') cartStore.addToCart(item, 1);
        else if (action === 'decrease') { if (item.quantity > 1) cartStore.addToCart({ ...item, quantity: 0 }, -1); else cartStore.removeFromCart(key); }
      });
    });

    container.querySelectorAll('.remove-btn').forEach(btn => {
      btn.addEventListener('click', (e) => {
        const key = (e.currentTarget as HTMLElement).dataset.key!;
        cartStore.removeFromCart(key);
      });
    });
  }

  function renderSummary(targetId: string) {
    const cart = cartStore.cart;
    const total = cart.reduce((acc, item) => acc + (item.price * item.quantity), 0);
    const el = document.getElementById(targetId);
    if (!el) return;
    el.innerHTML = cart.map(item => `
      <div class="flex justify-between items-start">
        <span class="text-[var(--text-muted)] truncate max-w-[70%]">${item.name || 'Producto'}${item.size || item.color ? ' (' + (item.size || '') + (item.size && item.color ? ' / ' : '') + (item.color || '') + ')' : ''} × ${item.quantity}</span>
        <span class="font-bold flex-shrink-0">$${(item.price * item.quantity).toFixed(2)}</span>
      </div>`).join('');
    const subtotalEl = document.getElementById('pay-subtotal');
    const totalEl = document.getElementById('pay-total');
    if (subtotalEl) subtotalEl.textContent = `$${total.toFixed(2)}`;
    if (totalEl) totalEl.textContent = `$${total.toFixed(2)}`;
  }

  // Navigation
  document.getElementById('to-step-2')?.addEventListener('click', () => { showStep(2); renderSummary('step2-summary'); });
  document.getElementById('back-to-step-1')?.addEventListener('click', () => showStep(1));
  document.getElementById('to-step-3')?.addEventListener('click', () => {
    const form = document.getElementById('shipping-form') as HTMLFormElement;
    if (form && !form.checkValidity()) { form.reportValidity(); return; }
    showStep(3); renderSummary('step3-summary');
  });
  document.getElementById('back-to-step-2')?.addEventListener('click', () => showStep(2));

  document.getElementById('place-order')?.addEventListener('click', async () => {
    const btn = document.getElementById('place-order') as HTMLButtonElement;
    btn.disabled = true;
    btn.textContent = 'Procesando...';

    const paymentMethod = (document.querySelector('input[name="payment"]:checked') as HTMLInputElement)?.value || 'card';
    const shipping = {
      name: (document.getElementById('ship-name') as HTMLInputElement)?.value || '',
      phone: (document.getElementById('ship-phone') as HTMLInputElement)?.value || '',
      address: (document.getElementById('ship-address') as HTMLInputElement)?.value || '',
      colonia: (document.getElementById('ship-colonia') as HTMLInputElement)?.value || '',
      city: (document.getElementById('ship-city') as HTMLInputElement)?.value || '',
      state: (document.getElementById('ship-state') as HTMLInputElement)?.value || '',
      zip: (document.getElementById('ship-zip') as HTMLInputElement)?.value || '',
      references: (document.getElementById('ship-references') as HTMLTextAreaElement)?.value || ''
    };

    const cart = cartStore.cart;
    const total = cart.reduce((acc, item) => acc + (item.price * item.quantity), 0);
    const orderId = 'WG-' + Math.random().toString(36).substring(2, 6).toUpperCase();

    // Try to save order to Supabase
    try {
      const { supabase } = await import('../lib/supabase');
      const { data: { session } } = await supabase.auth.getSession();
      const userId = session?.user?.id || null;

      const { data: newOrder, error: orderError } = await supabase.from('store_orders').insert({
        user_id: userId,
        total: total,
        shipping_address: `${shipping.name} | ${shipping.phone} | ${shipping.address}, ${shipping.colonia}, ${shipping.city}, ${shipping.state} ${shipping.zip} | Ref: ${shipping.references}`,
        payment_method: paymentMethod,
        status: 'pending',
        shipping_type: 'estandar'
      }).select('id').single();

      if (!orderError && newOrder) {
        const orderItems = cart.map(item => ({
          order_id: newOrder.id,
          variant_id: item.variant_id || null,
          quantity: item.quantity,
          unit_price: item.price
        }));
        await supabase.from('store_order_items').insert(orderItems);
      }
    } catch (e) { console.log('Order save skipped (no DB connection)'); }

    // Clear cart
    for (const item of [...cart]) {
      await cartStore.removeFromCart(item.cart_key || item.id);
    }

    document.getElementById('order-id').textContent = orderId;
    btn.disabled = false;
    btn.textContent = 'Pagar';
    showStep(4);
  });

  // Card number formatting
  document.getElementById('card-number')?.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    let v = input.value.replace(/\D/g, '').substring(0, 16);
    input.value = v.replace(/(.{4})/g, '$1 ').trim();
  });

  document.getElementById('card-expiry')?.addEventListener('input', (e) => {
    const input = e.target as HTMLInputElement;
    let v = input.value.replace(/\D/g, '').substring(0, 4);
    if (v.length >= 2) v = v.substring(0, 2) + '/' + v.substring(2);
    input.value = v;
  });

  // Init
  const initCheckout = async () => {
    if (!cartStore.initialized) await cartStore.init();
    renderCart();
  };
  initCheckout();
  window.addEventListener(CartEvents.UPDATED, renderCart);
  document.addEventListener('astro:page-load', initCheckout);
</script>
