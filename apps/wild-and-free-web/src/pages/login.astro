---
import Layout from '../layouts/Layout.astro';
---

<Layout config={{
  name: "Wild Gvng - Login",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>
  <div class="login-container">
    <div class="login-card group">
      <div class="absolute inset-0 bg-gradient-to-br from-wild-orange/20 via-transparent to-red-600/20 opacity-0 group-hover:opacity-100 transition-opacity duration-1000 rounded-3xl -z-10"></div>
      <div class="login-header">
        <div class="flex flex-col items-center mb-8">
          <a href="/" class="text-4xl font-black tracking-[0.2em] mb-2">
            <span class="text-wild-orange">WILD</span>
            <span class="text-[var(--text)]">GVNG</span>
          </a>
          <div class="h-1 w-12 bg-wild-orange rounded-full"></div>
        </div>
        <h2 class="text-3xl font-black tracking-tighter text-[var(--text)] uppercase">Bienvenido de nuevo</h2>
        <p class="text-[var(--text-muted)] font-bold uppercase tracking-widest text-[10px] mt-2">Ingresa a la cultura urbana</p>
      </div>

      <form class="login-form space-y-6">
        <div class="space-y-2">
          <label for="email" class="text-[10px] font-black uppercase tracking-[0.2em] text-[var(--text-faint)] ml-1">Correo Electrónico</label>
          <input type="email" id="email" name="email" placeholder="tu@email.com" class="w-full px-6 py-4 bg-[var(--bg-card)] border border-[var(--border)] rounded-2xl text-[var(--text)] font-bold focus:border-wild-orange focus:bg-[var(--bg-card)] transition-all outline-none" required />
        </div>

        <div class="form-group">
          <div class="flex items-center justify-between mb-2">
            <label for="password" class="block text-[10px] font-black uppercase tracking-widest text-[var(--text-muted)]">Contraseña</label>
            <a href="/recuperar-password" class="text-[10px] text-wild-orange hover:text-[var(--text)] font-bold uppercase tracking-widest transition-colors">¿Olvidaste tu contraseña?</a>
          </div>
          <div class="relative">
            <input
              type="password"
              id="password"
              placeholder="••••••••"
              required
              class="w-full bg-[var(--bg-card)] border border-[var(--border)] rounded-xl px-5 py-4 pr-12 text-[var(--text)] text-sm focus:border-wild-orange transition-all outline-none"
            >
            <button type="button" id="togglePassword" class="absolute right-3 top-1/2 -translate-y-1/2 text-[var(--text-faint)] hover:text-wild-orange transition-colors" aria-label="Mostrar contraseña">
              <svg id="eyeOpen" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg id="eyeClosed" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="hidden"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
        </div>

        <div class="flex items-center justify-between px-1">
          <label class="flex items-center gap-2 cursor-pointer group/check">
            <input type="checkbox" id="remember" name="remember" class="hidden" />
            <div class="w-5 h-5 border-2 border-[var(--border)] rounded-lg flex items-center justify-center group-hover/check:border-wild-orange transition-all">
              <div class="w-2.5 h-2.5 bg-wild-orange rounded-sm opacity-0 check-mark transition-opacity"></div>
            </div>
            <span class="text-[10px] font-black uppercase tracking-widest text-[var(--text-faint)] group-hover/check:text-[var(--text)] transition-colors">Recordarme</span>
          </label>
        </div>

        <button type="submit" class="w-full py-5 bg-white text-black text-xs font-black uppercase tracking-[0.3em] rounded-2xl hover:bg-wild-orange hover:text-[var(--text)] transition-all transform hover:-translate-y-1 shadow-2xl shadow-white/5 hover:shadow-wild-orange/20">
          Iniciar Sesión
        </button>
      </form>

      <div class="relative my-10">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-[var(--border-faint)]"></div></div>
        <div class="relative flex justify-center text-[10px] font-black uppercase tracking-[0.2em]"><span class="bg-[var(--bg)] px-4 text-[var(--text-faint)]">o continuar con</span></div>
      </div>

      <div class="grid grid-cols-1 gap-4">
        <button class="social-btn flex items-center justify-center gap-3 py-4 bg-[var(--bg-card)] border border-[var(--border)] rounded-2xl hover:bg-[var(--bg-card)] transition-all group/social" type="button">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-[var(--text)] group-hover/social:text-wild-orange transition-colors">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <span class="text-[10px] font-black uppercase tracking-widest text-[var(--text)]">Google</span>
        </button>
      </div>

      <div class="mt-10 text-center">
        <p class="text-[10px] font-black uppercase tracking-widest text-[var(--text-faint)]">
          ¿No tienes una cuenta? <a href="/registro" class="text-wild-orange hover:text-[var(--text)] transition-colors">Regístrate ahora</a>
        </p>
      </div>
    </div>
  </div>

<style>
  input:checked + div .check-mark {
    opacity: 1;
  }
</style>
</Layout>

<script>
  import { supabase } from '../lib/supabase'
  import { ensureProfile } from '../lib/profile.js'
  import { withLoadingState, getInputValue } from '../lib/form-helpers'

  // Toggle password visibility
  const toggleBtn = document.getElementById('togglePassword')
  const passInput = document.getElementById('password') as HTMLInputElement | null
  const eyeOpen = document.getElementById('eyeOpen')
  const eyeClosed = document.getElementById('eyeClosed')
  if (toggleBtn && passInput) {
    toggleBtn.addEventListener('click', () => {
      const isPassword = passInput.type === 'password'
      passInput.type = isPassword ? 'text' : 'password'
      eyeOpen?.classList.toggle('hidden', !isPassword)
      eyeClosed?.classList.toggle('hidden', isPassword)
    })
  }

  const form = document.querySelector('.login-form')
  const googleBtn = document.querySelector('.social-btn')

  if (googleBtn) {
    googleBtn.addEventListener('click', async () => {
      const { error } = await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: `${window.location.origin}/auth/callback` }
      })
      if (error) alert(error.message)
    })
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null

      const email = getInputValue('email').trim()
      const password = getInputValue('password')

      if (!email || !password) {
        alert('Completa correo y contraseña.')
        return
      }

      await withLoadingState(submitBtn, 'Iniciando sesión...', async () => {
        const { error } = await supabase.auth.signInWithPassword({ email, password })
        if (error) {
          alert(error.message)
          return
        }

        const { data } = await supabase.auth.getSession()
        if (data?.session) await ensureProfile(data.session)
        window.location.href = '/'
      })
    })
  }
</script>

<style>
  .login-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    background: linear-gradient(135deg, #000 0%, #111 50%, #000 100%);
    position: relative;
  }

  .login-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background:
      radial-gradient(circle at 20% 80%, rgba(201, 131, 0, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(138, 3, 3, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }

  .login-card {
    background: rgba(17, 17, 17, 0.9);
    border: 1px solid rgba(201, 131, 0, 0.3);
    border-radius: 16px;
    padding: 48px;
    max-width: 420px;
    width: 100%;
    backdrop-filter: blur(10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    position: relative;
    z-index: 1;
  }

  .login-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 24px;
  }

  .logo-line {
    font-weight: 900;
    font-size: 24px;
    letter-spacing: 0.25em;
    color: #fff;
    text-transform: uppercase;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .login-header h2 {
    margin: 0 0 8px 0;
    font-size: 24px;
    color: #fff;
    font-family: 'Noto Sans JP', sans-serif;
    letter-spacing: 0.05em;
  }

  .login-header p {
    margin: 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 14px;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .login-form {
    margin-bottom: 24px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    font-family: 'Noto Sans JP', sans-serif;
    letter-spacing: 0.02em;
  }

  .form-group input {
    width: 100%;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(201, 131, 0, 0.3);
    border-radius: 8px;
    color: #fff;
    font-size: 14px;
    font-family: 'Noto Sans JP', sans-serif;
    transition: all 0.2s;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--primary-color);
    background: rgba(201, 131, 0, 0.1);
    box-shadow: 0 0 0 2px rgba(201, 131, 0, 0.2);
  }

  .form-group input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .form-options {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .checkbox-container {
    display: flex;
    align-items: center;
    cursor: pointer;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.8);
    font-family: 'Noto Sans JP', sans-serif;
  }

  .checkbox-container input {
    display: none;
  }

  .checkmark {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(201, 131, 0, 0.3);
    border-radius: 3px;
    margin-right: 8px;
    position: relative;
    transition: all 0.2s;
  }

  .checkbox-container input:checked + .checkmark {
    background: var(--primary-color);
    border-color: var(--primary-color);
  }

  .checkbox-container input:checked + .checkmark::after {
    content: 'âœ“';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #000;
    font-weight: bold;
    font-size: 10px;
  }

  .forgot-link {
    color: var(--primary-color);
    text-decoration: none;
    font-size: 14px;
    font-family: 'Noto Sans JP', sans-serif;
    transition: all 0.2s;
  }

  .forgot-link:hover {
    color: #e69500;
    text-decoration: underline;
  }

  .submit-btn {
    width: 100%;
    padding: 14px;
    background: var(--primary-color);
    border: none;
    border-radius: 8px;
    color: #000;
    font-size: 16px;
    font-weight: 600;
    font-family: 'Noto Sans JP', sans-serif;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
  }

  .submit-btn:hover {
    background: #e69500;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(201, 131, 0, 0.3);
  }

  .divider {
    text-align: center;
    margin: 32px 0;
    position: relative;
  }

  .divider::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(201, 131, 0, 0.3), transparent);
  }

  .divider span {
    background: #111;
    padding: 0 16px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    font-family: 'Noto Sans JP', sans-serif;
    position: relative;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .social-login {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
  }

  .social-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(201, 131, 0, 0.2);
    border-radius: 8px;
    color: #fff;
    font-size: 14px;
    font-family: 'Noto Sans JP', sans-serif;
    cursor: pointer;
    transition: all 0.2s;
  }

  .social-btn:hover {
    background: rgba(201, 131, 0, 0.1);
    border-color: var(--primary-color);
    transform: translateY(-1px);
  }

  .social-btn.google:hover {
    background: rgba(66, 133, 244, 0.1);
    border-color: #4285f4;
  }

  .signup-link {
    text-align: center;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
    font-family: 'Noto Sans JP', sans-serif;
  }

  .signup-link a {
    color: var(--primary-color);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s;
  }

  .signup-link a:hover {
    color: #e69500;
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .login-card {
      padding: 32px 24px;
      margin: 20px;
    }

    .social-login {
      flex-direction: column;
    }

    .form-options {
      flex-direction: column;
      gap: 12px;
      align-items: flex-start;
    }
  }
</style>
