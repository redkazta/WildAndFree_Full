---
import Layout from '../layouts/Layout.astro';
---

<Layout config={{
  name: "Wild Gvng - Login",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>
  <div class="login-page">
    <div class="login-card group">
      <!-- Feedback -->
      <div id="form-alert" class="form-alert" role="alert" aria-live="polite" hidden>
        <span class="form-alert-icon" aria-hidden="true">
          <svg class="icon-error" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
          <svg class="icon-success" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M8.5 12.5l2.5 2.5 4.5-5"/></svg>
        </span>
        <p id="form-alert-text" class="form-alert-text"></p>
        <button type="button" class="form-alert-close" aria-label="Cerrar aviso">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
        </button>
      </div>

      <!-- Logo -->
      <div class="login-header text-center mb-12">
        <a href="/" class="inline-block mb-6">
          <span class="logo-wild text-wild-orange">WILD</span>
          <span class="logo-gvng text-white">GVNG</span>
        </a>
        <div class="w-14 h-[3px] bg-wild-orange mx-auto mb-6"></div>
        <h1 class="text-3xl font-black uppercase tracking-tighter text-white">Inicia sesión</h1>
        <p class="mt-3 text-[10px] font-black uppercase tracking-[0.25em] text-white/50">Accede a tu cuenta</p>
      </div>

      <!-- Form -->
      <form class="login-form space-y-5" autocomplete="on">
        <div class="space-y-2">
          <label for="email" class="block text-[10px] font-black uppercase tracking-[0.2em] text-white/40 ml-1">Correo Electrónico</label>
          <input type="email" id="email" name="email" placeholder="tu@email.com" required
            class="w-full px-5 py-4 bg-white/[0.04] border border-white/20 rounded-2xl text-white text-sm font-bold placeholder:text-white/30 focus:border-wild-orange focus:bg-white/[0.06] focus:ring-2 focus:ring-wild-orange/20 transition-all outline-none" />
        </div>

        <div class="space-y-2">
          <div class="flex items-center justify-between mb-2">
            <label for="password" class="text-[10px] font-black uppercase tracking-[0.2em] text-white/40">Contraseña</label>
            <a href="/recuperar-password" class="text-[10px] font-black uppercase tracking-widest text-wild-orange hover:text-white transition-colors">¿Olvidaste tu contraseña?</a>
          </div>
          <div class="relative">
            <input type="password" id="password" name="password" placeholder="••••••••" required
              class="w-full bg-white/[0.04] border border-white/20 rounded-2xl px-5 py-4 pr-12 text-white text-sm font-bold placeholder:text-white/30 focus:border-wild-orange focus:bg-white/[0.06] focus:ring-2 focus:ring-wild-orange/20 transition-all outline-none" />
            <button type="button" id="togglePassword" class="pw-toggle absolute right-4 top-1/2 -translate-y-1/2 text-white/40 hover:text-wild-orange transition-colors" aria-label="Mostrar contraseña" aria-pressed="false">
              <svg id="eyeOpen" class="pw-eye" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/><circle cx="12" cy="12" r="3"/></svg>
              <svg id="eyeClosed" class="pw-eye" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19m-6.72-1.07a3 3 0 1 1-4.24-4.24"/><line x1="1" y1="1" x2="23" y2="23"/></svg>
            </button>
          </div>
        </div>

        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 cursor-pointer group/check">
            <input type="checkbox" id="remember" name="remember" class="hidden" />
            <div class="w-5 h-5 border-2 border-white/20 rounded-lg flex items-center justify-center group-hover/check:border-wild-orange transition-colors">
              <div class="w-2.5 h-2.5 bg-wild-orange rounded-sm opacity-0 check-mark transition-opacity"></div>
            </div>
            <span class="text-[10px] font-black uppercase tracking-widest text-white/40 group-hover/check:text-white transition-colors">Recordarme</span>
          </label>
        </div>

        <button type="submit" id="loginSubmit" class="w-full py-4 bg-wild-orange text-black text-xs font-black uppercase tracking-[0.25em] rounded-2xl hover:brightness-110 transition-all transform hover:-translate-y-0.0 shadow-lg shadow-wild-orange/20 disabled:cursor-not-allowed">
          Iniciar Sesión
        </button>
      </form>

      <!-- Divider -->
      <div class="relative my-8">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-white/10"></div></div>
        <div class="relative flex justify-center text-[10px] font-black uppercase tracking-[0.2em]"><span class="bg-black px-4 text-white/40">o continuar con</span></div>
      </div>

      <!-- Social -->
      <div class="grid grid-cols-1 gap-3">
        <button id="googleBtn" class="social-btn flex items-center justify-center gap-3 py-4 bg-white/[0.03] border border-white/10 rounded-2xl hover:border-wild-orange/50 hover:bg-white/[0.06] transition-all group" type="button">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-white/60 group-hover:text-wild-orange transition-colors">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <span class="text-[10px] font-black uppercase tracking-widest text-white/70 group-hover:text-white transition-colors">Google</span>
        </button>
      </div>

      <!-- Footer -->
      <div class="mt-10 text-center">
        <p class="text-[10px] font-black uppercase tracking-widest text-white/40">
          ¿No tienes una cuenta? <a href="/registro" class="text-wild-orange hover:text-white transition-colors">Regístrate ahora</a>
        </p>
      </div>
    </div>
  </div>

  <style>
    /* Page */
    .login-page {
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 40px 20px;
      background: var(--bg);
      position: relative;
      overflow: hidden;
    }

    /* Card */
    .login-card {
      background: var(--bg-card);
      border: 1px solid rgba(201, 131, 0, 0.25);
      border-radius: 16px;
      padding: 48px 40px;
      max-width: 440px;
      width: 100%;
      box-shadow: 0 24px 60px rgba(0, 0, 0, 0.6);
      position: relative;
      z-index: 1;
    }

    /* Logo */
    .logo-wild {
      font-size: 2.5rem;
      font-weight: 900;
      letter-spacing: 0.25em;
      transition: color 0.3s;
    }
    .logo-gvng {
      font-size: 2.5rem;
      font-weight: 900;
      letter-spacing: 0.25em;
      transition: color 0.3s;
    }

    /* Feedback alert */
    .form-alert {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      margin-bottom: 24px;
      padding: 12px 14px;
      border-radius: 12px;
      border: 1px solid var(--secondary, #8a0303);
      background: rgba(138, 3, 3, 0.12);
      color: #ffffff;
      animation: alertIn 0.25s ease-out;
    }
    .form-alert[hidden] { display: none !important; }

    /* El Layout global reutiliza .hidden para el sidebar; aquí controlamos
       los ojos y la alerta con estilos propios para evitar colisiones. */
    .pw-toggle .pw-eye { display: block; }
    .pw-toggle .pw-eye.is-off { display: none; }

    .form-alert.is-error {
      border-color: rgba(138, 3, 3, 0.6);
      background: rgba(138, 3, 3, 0.14);
    }
    .form-alert.is-success {
      border-color: var(--primary, #c98300);
      background: var(--primary-soft, rgba(201, 131, 0, 0.12));
    }
    .form-alert-icon {
      display: flex;
      flex-shrink: 0;
      margin-top: 1px;
      color: var(--secondary, #8a0303);
    }
    .form-alert.is-success .form-alert-icon { color: var(--primary, #c98300); }
    .form-alert .icon-success { display: none; }
    .form-alert.is-success .icon-error { display: none; }
    .form-alert.is-success .icon-success { display: block; }
    .form-alert-text {
      flex: 1;
      font-size: 11px;
      font-weight: 700;
      line-height: 1.5;
      letter-spacing: 0.02em;
      color: var(--text, #ffffff);
    }
    .form-alert-close {
      flex-shrink: 0;
      color: var(--text-muted, rgba(255,255,255,0.5));
      transition: color 0.2s;
    }
    .form-alert-close:hover { color: var(--text, #ffffff); }

    @keyframes alertIn {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* Invalid field state */
    .field-invalid {
      border-color: var(--secondary, #8a0303) !important;
      box-shadow: 0 0 0 3px rgba(138, 3, 3, 0.18) !important;
    }

    /* Responsive */
    @media (max-width: 480px) {
      .login-card {
        padding: 36px 24px;
        margin: 20px;
      }
      .logo-wild, .logo-gvng {
        font-size: 2rem;
      }
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase'
    import { ensureProfile } from '../lib/profile.js'
    import { withLoadingState, getInputValue } from '../lib/form-helpers'

    // ===== Visual feedback =====
    const alertBox = document.getElementById('form-alert')
    const alertText = document.getElementById('form-alert-text')
    const emailInput = document.getElementById('email') as HTMLInputElement | null

    function clearFieldErrors() {
      document.querySelectorAll('.field-invalid').forEach(el => el.classList.remove('field-invalid'))
    }

    function showAlert(message: string, type: 'error' | 'success' = 'error') {
      if (!alertBox || !alertText) return
      alertText.textContent = message
      alertBox.classList.remove('is-error', 'is-success')
      alertBox.classList.add(type === 'success' ? 'is-success' : 'is-error')
      alertBox.hidden = false
      // Replay animation
      alertBox.style.animation = 'none'
      void alertBox.offsetWidth
      alertBox.style.animation = ''
    }

    function hideAlert() {
      if (alertBox) alertBox.hidden = true
    }

    function markInvalid(input: HTMLInputElement | null) {
      input?.classList.add('field-invalid')
    }

    /** Traduce los mensajes de error de Supabase Auth al español. */
    function translateAuthError(message: string): string {
      const msg = (message || '').toLowerCase()
      if (msg.includes('invalid login credentials')) return 'Correo o contraseña incorrectos. Intenta de nuevo.'
      if (msg.includes('email not confirmed')) return 'Aún no confirmas tu correo. Revisa tu bandeja de entrada.'
      if (msg.includes('too many requests') || msg.includes('rate limit')) return 'Demasiados intentos. Espera un momento e intenta de nuevo.'
      if (msg.includes('user not found')) return 'No existe una cuenta con ese correo.'
      if (msg.includes('invalid email')) return 'El correo no tiene un formato válido.'
      if (msg.includes('network') || msg.includes('failed to fetch')) return 'Sin conexión. Revisa tu internet e intenta de nuevo.'
      return 'No pudimos iniciar sesión. Verifica tus datos e intenta de nuevo.'
    }

    alertBox?.addEventListener('click', (e) => {
      if ((e.target as HTMLElement)?.closest('.form-alert-close')) hideAlert()
    })
    emailInput?.addEventListener('input', () => { emailInput.classList.remove('field-invalid'); hideAlert() })

    // Toggle password visibility
    const toggleBtn = document.getElementById('togglePassword') as HTMLButtonElement | null
    const passInput = document.getElementById('password') as HTMLInputElement | null
    const eyeOpen = document.getElementById('eyeOpen')
    const eyeClosed = document.getElementById('eyeClosed')

    passInput?.addEventListener('input', () => { passInput.classList.remove('field-invalid'); hideAlert() })

    // Ojo abierto = contraseña oculta; ojo tachado = contraseña visible
    function renderEye(isPassword: boolean) {
      eyeOpen?.classList.toggle('is-off', !isPassword)
      eyeClosed?.classList.toggle('is-off', isPassword)
      toggleBtn?.setAttribute('aria-pressed', String(!isPassword))
      toggleBtn?.setAttribute('aria-label', isPassword ? 'Mostrar contraseña' : 'Ocultar contraseña')
    }
    renderEye(true)

    toggleBtn?.addEventListener('click', (e) => {
      e.preventDefault()
      e.stopPropagation()
      if (!passInput) return
      const isPassword = passInput.type === 'password'
      passInput.type = isPassword ? 'text' : 'password'
      renderEye(!isPassword)
    })

    const form = document.querySelector('.login-form')
    const googleBtn = document.getElementById('googleBtn')

    if (googleBtn) {
      googleBtn.addEventListener('click', async () => {
        const { error } = await supabase.auth.signInWithOAuth({
          provider: 'google',
          options: { redirectTo: `${window.location.origin}/auth/callback` }
        })
        if (error) showAlert(translateAuthError(error.message))
      })
    }

    if (form) {
      form.addEventListener('submit', async (e) => {
        e.preventDefault()
        const submitBtn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null
        hideAlert()
        clearFieldErrors()

        const email = getInputValue('email').trim()
        const password = getInputValue('password')

        if (!email && !password) {
          markInvalid(emailInput)
          markInvalid(passInput)
          showAlert('Completa correo y contraseña.')
          emailInput?.focus()
          return
        }
        if (!email) {
          markInvalid(emailInput)
          showAlert('Ingresa tu correo electrónico.')
          emailInput?.focus()
          return
        }
        if (!password) {
          markInvalid(passInput)
          showAlert('Ingresa tu contraseña.')
          passInput?.focus()
          return
        }

        await withLoadingState(submitBtn, 'Iniciando sesión...', async () => {
          const { error } = await supabase.auth.signInWithPassword({ email, password })
          if (error) {
            if (error.message.toLowerCase().includes('invalid login credentials')) {
              markInvalid(passInput)
              passInput?.focus()
              passInput?.select()
            }
            showAlert(translateAuthError(error.message))
            return
          }

          const { data } = await supabase.auth.getSession()
          if (data?.session) await ensureProfile(data.session)
          showAlert('¡Bienvenido de vuelta! Entrando...', 'success')
          setTimeout(() => { window.location.href = '/' }, 600)
        })
      })
    }
  </script>