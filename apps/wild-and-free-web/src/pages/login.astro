---
import Layout from '../layouts/Layout.astro';
---

<Layout config={{
  name: "Wild Gvng - Login",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>
  <div class="login-container">
    <div class="login-card">
      <div class="login-header">
        <div class="logo-text">
          <span class="logo-line">WILD</span>
          <span class="logo-line">GVNG</span>
        </div>
        <h2>Iniciar Sesión</h2>
        <p>Accede a tu cuenta de Wild Gvng</p>
      </div>
      
      <form class="login-form">
        <div class="form-group">
          <label for="email">Correo Electrónico</label>
          <input type="email" id="email" name="email" placeholder="tu@email.com" required />
        </div>
        
        <div class="form-group">
          <label for="password">Contraseña</label>
          <input type="password" id="password" name="password" placeholder="••••••••" required />
        </div>
        
        <div class="form-options">
          <label class="checkbox-container">
            <input type="checkbox" id="remember" name="remember" />
            <span class="checkmark"></span>
            Recordarme
          </label>
          <a href="#" class="forgot-link">¿Olvidaste tu contraseña?</a>
        </div>
        
        <button type="submit" class="submit-btn">Iniciar Sesión</button>
      </form>
      
      <div class="divider">
        <span>o continuar con</span>
      </div>
      
      <div class="social-login">
        <button class="social-btn google" type="button">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          Google
        </button>
      </div>
      
      <div class="signup-link">
        <p>¿No tienes una cuenta? <a href="/registro">Regístrate</a></p>
      </div>
    </div>
  </div>
</Layout>

<script type="module">
  import { supabase } from '../lib/supabaseClient'

  const form = document.querySelector('.login-form')
  const googleBtn = document.querySelector('.social-btn.google')

  if (googleBtn) {
    googleBtn.addEventListener('click', async () => {
      await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: `${window.location.origin}/auth/callback` }
      })
    })
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const email = document.getElementById('email')?.value?.trim()
      const password = document.getElementById('password')?.value
      if (!email || !password) return

      const { error } = await supabase.auth.signInWithPassword({ email, password })
      if (error) {
        alert(error.message)
        return
      }
      window.location.href = '/'
    })
  }
</script>

<style>
  .login-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    background: linear-gradient(135deg, #000 0%, #111 50%, #000 100%);
    position: relative;
  }

  .login-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 20% 80%, rgba(201, 131, 0, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(138, 3, 3, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }

  .login-card {
    background: rgba(17, 17, 17, 0.9);
    border: 1px solid rgba(201, 131, 0, 0.3);
    border-radius: 16px;
    padding: 48px;
    max-width: 420px;
    width: 100%;
    backdrop-filter: blur(10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    position: relative;
    z-index: 1;
  }

  .login-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 24px;
  }

  .logo-line {
    font-weight: 900;
    font-size: 24px;
    letter-spacing: 0.25em;
    color: #fff;
    text-transform: uppercase;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .login-header h2 {
    margin: 0 0 8px 0;
    font-size: 24px;
    color: #fff;
    font-family: 'Noto Sans JP', sans-serif;
    letter-spacing: 0.05em;
  }

  .login-header p {
    margin: 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 14px;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .login-form {
    margin-bottom: 24px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    font-family: 'Noto Sans JP', sans-serif;
    letter-spacing: 0.02em;
  }

  .form-group input {
    width: 100%;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(201, 131, 0, 0.3);
    border-radius: 8px;
    color: #fff;
    font-size: 14px;
    font-family: 'Noto Sans JP', sans-serif;
    transition: all 0.2s;
  }

  .form-group input:focus {
    outline: none;
    border-color: var(--primary-color);
    background: rgba(201, 131, 0, 0.1);
    box-shadow: 0 0 0 2px rgba(201, 131, 0, 0.2);
  }

  .form-group input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .form-options {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .checkbox-container {
    display: flex;
    align-items: center;
    cursor: pointer;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.8);
    font-family: 'Noto Sans JP', sans-serif;
  }

  .checkbox-container input {
    display: none;
  }

  .checkmark {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(201, 131, 0, 0.3);
    border-radius: 3px;
    margin-right: 8px;
    position: relative;
    transition: all 0.2s;
  }

  .checkbox-container input:checked + .checkmark {
    background: var(--primary-color);
    border-color: var(--primary-color);
  }

  .checkbox-container input:checked + .checkmark::after {
    content: '✓';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #000;
    font-weight: bold;
    font-size: 10px;
  }

  .forgot-link {
    color: var(--primary-color);
    text-decoration: none;
    font-size: 14px;
    font-family: 'Noto Sans JP', sans-serif;
    transition: all 0.2s;
  }

  .forgot-link:hover {
    color: #e69500;
    text-decoration: underline;
  }

  .submit-btn {
    width: 100%;
    padding: 14px;
    background: var(--primary-color);
    border: none;
    border-radius: 8px;
    color: #000;
    font-size: 16px;
    font-weight: 600;
    font-family: 'Noto Sans JP', sans-serif;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
  }

  .submit-btn:hover {
    background: #e69500;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(201, 131, 0, 0.3);
  }

  .divider {
    text-align: center;
    margin: 32px 0;
    position: relative;
  }

  .divider::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(201, 131, 0, 0.3), transparent);
  }

  .divider span {
    background: #111;
    padding: 0 16px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    font-family: 'Noto Sans JP', sans-serif;
    position: relative;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .social-login {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
  }

  .social-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(201, 131, 0, 0.2);
    border-radius: 8px;
    color: #fff;
    font-size: 14px;
    font-family: 'Noto Sans JP', sans-serif;
    cursor: pointer;
    transition: all 0.2s;
  }

  .social-btn:hover {
    background: rgba(201, 131, 0, 0.1);
    border-color: var(--primary-color);
    transform: translateY(-1px);
  }

  .social-btn.google:hover {
    background: rgba(66, 133, 244, 0.1);
    border-color: #4285f4;
  }

  .signup-link {
    text-align: center;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
    font-family: 'Noto Sans JP', sans-serif;
  }

  .signup-link a {
    color: var(--primary-color);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s;
  }

  .signup-link a:hover {
    color: #e69500;
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .login-card {
      padding: 32px 24px;
      margin: 20px;
    }
    
    .social-login {
      flex-direction: column;
    }
    
    .form-options {
      flex-direction: column;
      gap: 12px;
      align-items: flex-start;
    }
  }
</style>
