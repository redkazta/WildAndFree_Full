---
import Layout from '../../../layouts/Layout.astro';
import tenantConfig from '../../../../../../packages/shared-types/tenant-config.json';
import { createClient } from '@supabase/supabase-js';

// RDCP: mantiene la URL antigua /the-wild-times/p/[id] viva y redirige a /noticias/[id].
export async function getStaticPaths() {
  const __supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL as string,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string
  );
  const { data: posts } = await __supabase
    .from('crew_posts')
    .select('id')
    .eq('status', 'published');
  const rows = posts || [];
  return rows.map((p: any) => ({ params: { id: p.id } }));
}

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - THE WILD TIMES",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};
---

<Layout config={config}>
  <p style="padding:10px 16px;font-family:sans-serif;font-size:14px;">
    Redirigiendo a la publicación...
  </p>
</Layout>

<script>
  const m = window.location.pathname.match(/\/the-wild-times\/p\/([^/?]+)/);
  if (m && m[1]) {
    window.location.replace('/noticias/' + m[1]);
  } else {
    window.location.replace('/the-wild-times');
  }
</script>
