---
import { createClient } from '@supabase/supabase-js';
import { postSlug } from '../../../lib/slug';

// RDCP: la URL antigua /the-wild-times/p/[id] redirige a la URL nueva con slug.
export async function getStaticPaths() {
  const __supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL as string,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string
  );
  const { data: posts } = await __supabase
    .from('crew_posts')
    .select('id, title')
    .eq('status', 'published');
  const rows: Array<{ slug: string; id: string; title?: string | null }> = [];
  const seen = new Map<string, number>();
  for (const p of posts || []) {
    let slug = postSlug(p.id, p.title);
    const count = seen.get(postSlug(p.id, p.title)) || 0;
    if (count > 0) slug = `${slug}-${count + 1}`;
    seen.set(postSlug(p.id, p.title), count + 1);
    rows.push({ slug, id: p.id, title: p.title });
  }
  return rows.map((r) => ({
    params: { id: r.id },
    props: { slug: r.slug },
  }));
}

const { slug } = Astro.props;
const target = `/the-wild-times/${slug}`;
---

<p style="padding:16px;font-family:sans-serif;">Redirigiendo a la publicación…</p>

<script define:vars={{ target }}>
  // Doble seguridad: si el meta no es suficiente (client router), forzamos navegación.
  window.location.replace(target);
</script>
