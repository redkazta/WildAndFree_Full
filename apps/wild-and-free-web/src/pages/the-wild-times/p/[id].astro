---
export const prerender = false;
import { createClient } from '@supabase/supabase-js';
import { postShortId, postTypePath } from '../../../lib/slug';

// RDCP: la URL antigua /the-wild-times/p/[id] redirige a la nueva URL por tipo con id corto.
const { id } = Astro.params;

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL as string,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string
);

const { data: post } = await supabase
  .from('crew_posts')
  .select('id, title, post_type')
  .eq('id', id)
  .eq('status', 'published')
  .maybeSingle();

const target = post
  ? `${postTypePath(post.post_type)}/${postShortId(post.id)}`
  : '/the-wild-times';
---

<meta charset="UTF-8"><meta http-equiv="refresh" content="0; url={target}">

<script define:vars={{ target }}>
  window.location.replace(target);
</script>
