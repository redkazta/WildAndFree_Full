---
import { createClient } from '@supabase/supabase-js';
import { postShortId, postTypePath } from '../../../lib/slug';

// RDCP: la URL antigua /the-wild-times/p/[id] redirige a la nueva URL por tipo con id corto.
export async function getStaticPaths() {
  const __supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL as string,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string
  );
  const { data: posts } = await __supabase
    .from('crew_posts')
    .select('id, post_type')
    .eq('status', 'published');
  const rows: Array<{ id: string; target: string }> = [];
  for (const p of posts || []) {
    rows.push({
      id: p.id,
      target: `${postTypePath(p.post_type)}/${postShortId(p.id)}`,
    });
  }
  return rows.map((r) => ({
    params: { id: r.id },
    props: { target: r.target },
  }));
}

const { target } = Astro.props;
---

<p style="padding:16px;font-family:sans-serif;">Redirigiendo a la publicación…</p>

<script define:vars={{ target }}>
  window.location.replace(target);
</script>
