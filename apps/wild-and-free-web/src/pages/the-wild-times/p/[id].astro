---
import { createClient } from '@supabase/supabase-js';
import { postShortId } from '../../../lib/slug';

// RDCP: la URL antigua /the-wild-times/p/[id] redirige a la URL nueva con id corto.
export async function getStaticPaths() {
  const __supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL as string,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string
  );
  const { data: posts } = await __supabase
    .from('crew_posts')
    .select('id')
    .eq('status', 'published');
  const rows: Array<{ id: string; shortId: string }> = [];
  const seen = new Map<string, number>();
  for (const p of posts || []) {
    let short = postShortId(p.id);
    const count = seen.get(postShortId(p.id)) || 0;
    if (count > 0) short = `${short}-${count + 1}`;
    seen.set(postShortId(p.id), count + 1);
    rows.push({ id: p.id, shortId: short });
  }
  return rows.map((r) => ({
    params: { id: r.id },
    props: { shortId: r.shortId },
  }));
}

const { shortId } = Astro.props;
const target = `/the-wild-times/${shortId}`;
---

<p style="padding:16px;font-family:sans-serif;">Redirigiendo a la publicación…</p>

<script define:vars={{ target }}>
  // Redirige a la URL nueva con id corto.
  window.location.replace(target);
</script>
