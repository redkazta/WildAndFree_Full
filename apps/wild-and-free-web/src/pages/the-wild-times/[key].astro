---
export const prerender = false;
import { createClient } from '@supabase/supabase-js';
import { postShortId, postSlug, postTypePath } from '../../lib/slug';

// RDCP: redirige las URLs viejas de The Wild Times (/the-wild-times/[shortId]
// o /the-wild-times/[slug]) a la nueva URL separada por tipo con id corto.
const { key } = Astro.params;

const supabase = createClient(
  import.meta.env.PUBLIC_SUPABASE_URL as string,
  import.meta.env.PUBLIC_SUPABASE_ANON_KEY as string
);

// Busca un post publicado cuyo shortId o slug coincida.
const { data: posts } = await supabase
  .from('crew_posts')
  .select('id, title, post_type')
  .eq('status', 'published');

const target = (posts || []).reduce<string | null>((acc, p) => {
  if (acc) return acc;
  if (postShortId(p.id) === key || (p.title && postSlug(p.id, p.title) === key)) {
    return `${postTypePath(p.post_type)}/${postShortId(p.id)}`;
  }
  return null;
}, null) || '/the-wild-times';
---

<meta charset="UTF-8"><meta http-equiv="refresh" content="0; url={target}">

<script define:vars={{ target }}>
  window.location.replace(target);
</script>
