---
import Layout from '../layouts/Layout.astro';
import { supabase } from '../lib/supabase.js';

// Verificar autenticación
const { data: { session } } = await supabase.auth.getSession();

if (!session) {
  return Astro.redirect('/login');
}

// Obtener tags del usuario
const { data: userTags } = await supabase
  .from('user_has_tags')
  .select(`
    tag_id,
    tags (
      id,
      name,
      color,
      animation
    )
  `)
  .eq('user_id', session.user.id);

// Obtener todos los tags disponibles
const { data: allTags } = await supabase
  .from('tags')
  .select('*')
  .order('name', { ascending: true });

// Tags asignados al usuario
// @ts-ignore
const assignedTagIds = userTags?.map(ut => ut.tag_id) || [];
---

<Layout config={{
  name: "Gestionar Tags - Wild And Free",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>
  <div class="min-h-screen">
    <div class="container mx-auto px-4 py-8">
      <div class="max-w-4xl mx-auto">
        <div class="mb-8">
          <h1 class="text-3xl font-bold mb-2">GESTIONAR TAGS</h1>
          <p class="text-white/60">Personaliza tu perfil con tags que reflejen tu identidad en la comunidad</p>
        </div>

        <div class="grid md:grid-cols-2 gap-8">
          <!-- Tags Asignados -->
          <div class="bg-white/5 rounded-lg p-6 border border-white/10">
            <h2 class="text-xl font-bold mb-4">TUS TAGS ACTUALES</h2>
            <div id="assigned-tags" class="flex flex-wrap gap-2 mb-6">
              {userTags?.map((tag: any) => (
                <span 
                  class="role-tag text-sm"
                  style={`background: linear-gradient(135deg, ${tag.tags.color}40 0%, ${tag.tags.color}10 100%); border-color: ${tag.tags.color}; box-shadow: 0 0 10px -2px ${tag.tags.color};`}
                >
                  {tag.tags.name}
                  <button 
                    class="ml-2 text-red-400 hover:text-red-300"
                    onclick={`removeTag(${tag.tags.id})`}
                  >
                    ×
                  </button>
                </span>
              ))}
              {(!userTags || userTags.length === 0) && (
                <p class="text-white/60 text-sm">No tienes tags asignados</p>
              )}
            </div>
          </div>

          <!-- Tags Disponibles -->
          <div class="bg-white/5 rounded-lg p-6 border border-white/10">
            <h2 class="text-xl font-bold mb-4">TAGS DISPONIBLES</h2>
            <div id="available-tags" class="flex flex-wrap gap-2">
              {allTags?.map((tag: any) => {
                // @ts-ignore
                const isAssigned = assignedTagIds.includes(tag.id);
                return (
                  <button
                    class={`role-tag text-sm transition-all hover:scale-105 ${
                      isAssigned ? 'opacity-50 cursor-not-allowed' : 'hover:bg-white/10'
                    }`}
                    style={`background: linear-gradient(135deg, ${tag.color}40 0%, ${tag.color}10 100%); border-color: ${tag.color}; box-shadow: 0 0 10px -2px ${tag.color};`}
                    onclick={isAssigned ? '' : `addTag(${tag.id})`}
                    disabled={isAssigned}
                  >
                    {tag.name}
                    {isAssigned && <span class="ml-1">âœ“</span>}
                  </button>
                );
              })}
            </div>
          </div>
        </div>

        <div class="mt-8 text-center">
          <a href="/perfil" class="inline-block bg-wild-orange hover:bg-orange-600 text-white px-6 py-3 rounded-lg font-bold transition-colors">
            VOLVER AL PERFIL
          </a>
        </div>
      </div>
    </div>
  </div>

  <script>
    import { supabase } from '../lib/supabase.js';
    import { assignTagToUser, removeTagFromUser } from '../lib/tags.js';

    async function loadTags() {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return;

        // Recargar la página para ver cambios
        window.location.reload();
      } catch (error) {
        console.error('Error loading tags:', error);
        alert('Error al cargar tags');
      }
    }

    // @ts-ignore
    window.addTag = async function(tagId: number) {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return;

        // @ts-ignore
        const result = await assignTagToUser(session.user.id, tagId);
        
        // @ts-ignore
        if (result.success) {
          await loadTags();
        } else {
          alert('Error al agregar tag');
        }
      } catch (error) {
        console.error('Error adding tag:', error);
        alert('Error al agregar tag');
      }
    };

    // @ts-ignore
    window.removeTag = async function(tagId: number) {
      try {
        const { data: { session } } = await supabase.auth.getSession();
        if (!session) return;

        if (confirm('¿Quieres remover este tag?')) {
          // @ts-ignore
          const result = await removeTagFromUser(session.user.id, tagId);
          
          // @ts-ignore
          if (result.success) {
            await loadTags();
          } else {
            alert('Error al remover tag');
          }
        }
      } catch (error) {
        console.error('Error removing tag:', error);
        alert('Error al remover tag');
      }
    };
  </script>

  <style>
    .role-tag {
        --tag-glow: rgba(255, 255, 255, 0.9);
        --tag-glow-soft: rgba(255, 255, 255, 0.35);
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 8px 20px;
        border-radius: 9999px;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.15em;
        border: 1px solid var(--border-soft);
        backdrop-filter: blur(16px);
        transition: all 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94);
        margin: 6px;
        background: linear-gradient(135deg, rgba(255, 255, 255, 0.08), rgba(255, 255, 255, 0.02));
        background-size: 200% 200%;
        background-position: 0% 50%;
        color: #fff !important;
        box-shadow: 0 6px 35px rgba(0, 0, 0, 0.25), 0 0 24px -6px var(--tag-glow), 0 0 60px -24px var(--tag-glow);
        text-shadow: 0 0 10px rgba(0,0,0,0.5);
        position: relative;
        overflow: hidden;
        outline: none !important;
        cursor: pointer;
        user-select: none;
        filter: saturate(1.15);
        will-change: transform, filter, box-shadow;
        animation: wild-pulse 2.8s infinite ease-in-out;
    }

    .role-tag::before {
        content: '';
        position: absolute;
        inset: -35%;
        background: radial-gradient(circle, var(--tag-glow-soft) 0%, transparent 60%);
        opacity: 0.45;
        filter: blur(10px);
        animation: halo-pulse 2.8s infinite ease-in-out;
        pointer-events: none;
    }

    .role-tag::after {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        background: linear-gradient(120deg, transparent, var(--text-muted), transparent);
        transform: translateX(-100%) skewX(-15deg);
        animation: tag-shine 3.2s ease-in-out infinite;
    }

    .role-tag:hover {
        transform: scale(1.05);
        filter: brightness(1.2);
    }

    .role-tag:hover::after {
        animation-duration: 2.2s;
    }

    @keyframes wild-pulse {
        0% { 
            box-shadow: 0 0 5px rgba(255, 255, 255, 0.1), inset 0 0 0 rgba(255,255,255,0); 
            transform: scale(1);
            filter: brightness(1);
        }
        50% { 
            box-shadow: 0 0 20px rgba(255, 255, 255, 0.3), inset 0 0 10px var(--border-muted); 
            transform: scale(1.05);
            filter: brightness(1.3);
            border-color: rgba(255, 255, 255, 0.9);
        }
        100% { 
            box-shadow: 0 0 5px rgba(255, 255, 255, 0.1), inset 0 0 0 rgba(255,255,255,0); 
            transform: scale(1);
            filter: brightness(1);
        }
    }

    @keyframes tag-shine {
        0% { transform: translateX(-120%) skewX(-15deg); opacity: 0; }
        20% { opacity: 0.9; }
        60% { transform: translateX(120%) skewX(-15deg); opacity: 0.8; }
        100% { transform: translateX(120%) skewX(-15deg); opacity: 0; }
    }

    @keyframes halo-pulse {
        0% { opacity: 0.35; transform: scale(0.96); }
        50% { opacity: 0.9; transform: scale(1.06); }
        100% { opacity: 0.35; transform: scale(0.96); }
    }
  </style>
</Layout>
