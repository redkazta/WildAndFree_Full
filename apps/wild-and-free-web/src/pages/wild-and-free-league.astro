---
import Layout from '../layouts/Layout.astro';

const config = {
  name: "Wild Gvng - Wild and Free League",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
};

// 16 Initial participants (Mock) with high-quality street photography
const initialParticipants = [
  { id: 'p1', name: 'Lil Kiro', image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=400&h=400&fit=crop&q=80' },
  { id: 'p2', name: 'Neon Ghost', image: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&fit=crop&q=80' },
  { id: 'p3', name: 'Shadow V', image: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=400&h=400&fit=crop&q=80' },
  { id: 'p4', name: 'Nova K', image: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400&h=400&fit=crop&q=80' },
  { id: 'p5', name: 'Sable', image: 'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=400&h=400&fit=crop&q=80' },
  { id: 'p6', name: 'Storm Trooper', image: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=400&h=400&fit=crop&q=80' },
  { id: 'p7', name: 'Midnight Rider', image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=400&h=400&fit=crop&q=80' },
  { id: 'p8', name: 'Crystal Wave', image: 'https://images.unsplash.com/photo-1531746020798-e6953c6e8e04?w=400&h=400&fit=crop&q=80' },
  { id: 'p9', name: 'Drill King', image: 'https://images.unsplash.com/photo-1531384441138-2736e62e0919?w=400&h=400&fit=crop&q=80' },
  { id: 'p10', name: 'Flow Master', image: 'https://images.unsplash.com/photo-1508700115892-45ecd05ae2ad?w=400&h=400&fit=crop&q=80' },
  { id: 'p11', name: 'Rhyme Slayer', image: 'https://images.unsplash.com/photo-1493225255756-d9584f8606e9?w=400&h=400&fit=crop&q=80' },
  { id: 'p12', name: 'Beat Beast', image: 'https://images.unsplash.com/photo-1524504388940-b1c1722653e1?auto=format&fit=crop&w=400&h=400&q=80' },
  { id: 'p13', name: 'Word Smith', image: 'https://images.unsplash.com/photo-1521119989659-a83eee488004?w=400&h=400&fit=crop&q=80' },
  { id: 'p14', name: 'Urban Soul', image: 'https://images.unsplash.com/photo-1519345182560-3f2917c472ef?w=400&h=400&fit=crop&q=80' },
  { id: 'p15', name: 'Ghetto Star', image: 'https://images.unsplash.com/photo-1463453091185-61582044d556?w=400&h=400&fit=crop&q=80' },
  { id: 'p16', name: 'Street Legend', image: 'https://images.unsplash.com/photo-1552374196-c4e7ffc6e126?w=400&h=400&fit=crop&q=80' },
];
---

<Layout config={config}>
  <main class="min-h-screen bg-black pt-32 pb-40 px-4 overflow-x-hidden">
    <div class="max-w-[1600px] mx-auto space-y-12">
      <div class="space-y-4 text-center">
        <h1 class="text-6xl md:text-8xl font-black tracking-tighter text-white uppercase leading-none">
          WILD <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-red-600">AND FREE</span>
        </h1>
        <p class="text-xl text-white font-bold uppercase tracking-[0.3em]">Liga de Freestyle • Fase de Eliminación</p>
      </div>

      <!-- Realtime Status -->
      <div class="flex justify-center">
        <div id="realtime-status" class="flex items-center gap-3 px-6 py-2 bg-black border-2 border-white rounded-full">
          <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
          <span class="text-[10px] font-black text-white uppercase tracking-widest">Sincronización en Tiempo Real Activa</span>
        </div>
      </div>

      <!-- Participants Pool -->
      <div class="bg-white/[0.02] border border-white/5 rounded-[2rem] p-8 space-y-6">
        <h3 class="text-xs font-black text-orange-500 uppercase tracking-[0.4em] text-center">Participantes Disponibles</h3>
        <div id="participants-pool" class="grid grid-cols-8 gap-4 max-w-4xl mx-auto">
          {initialParticipants.map(p => (
            <div 
              draggable="true" 
              id={p.id}
              data-name={p.name}
              data-image={p.image}
              class="participant-item group relative aspect-square rounded-xl overflow-hidden cursor-grab active:cursor-grabbing border-2 border-white hover:border-orange-500 transition-all shadow-xl"
            >
              <img src={p.image} alt={p.name} class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-110 transition-all duration-500" />
              <div class="participant-used hidden absolute inset-0 bg-black/70 flex items-center justify-center">
                <div class="w-10 h-10 border-2 border-white flex items-center justify-center text-white font-black text-xl leading-none">×</div>
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end justify-center pb-1">
                <span class="text-[7px] font-black text-white text-center uppercase tracking-tight">{p.name}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Tournament Bracket -->
      <div class="tournament-wrap py-10">
        <div class="bracket">
          <svg id="bracket-lines" class="bracket-lines" aria-hidden="true"></svg>
          <div class="side side-left">
            <div class="col col-r1">
              {[1, 2, 3, 4].map(i => (
                <div class="match match-r1 match-left">
                  <div class="bracket-slot" data-side="left" data-round="1" data-slot={`l1-m${i}-p1`}></div>
                  <div class="bracket-slot" data-side="left" data-round="1" data-slot={`l1-m${i}-p2`}></div>
                </div>
              ))}
            </div>
            <div class="col col-r2">
              {[1, 2].map(i => (
                <div class="match match-r2 match-left">
                  <div class="bracket-slot" data-side="left" data-round="2" data-slot={`l2-m${i}-p1`}></div>
                  <div class="bracket-slot" data-side="left" data-round="2" data-slot={`l2-m${i}-p2`}></div>
                </div>
              ))}
            </div>
            <div class="col col-r3">
              <div class="match match-r3 match-left">
                <div class="bracket-slot" data-side="left" data-round="3" data-slot="l3-m1-p1"></div>
                <div class="bracket-slot" data-side="left" data-round="3" data-slot="l3-m1-p2"></div>
              </div>
            </div>
          </div>

          <div class="col col-final">
            <div class="final-title">
              <span class="text-orange-500">WILD</span> <span class="text-white">GVNG</span>
            </div>
            <p class="champion-text">CAMPEÓN WILD AND FREE FECHA #1</p>
            <div class="final-row">
              <div class="bracket-slot final" data-side="left" data-round="4" data-slot="final-p1"></div>
              <div class="final-vs">VS</div>
              <div class="bracket-slot final" data-side="right" data-round="4" data-slot="final-p2"></div>
            </div>
            <div class="winner-row">
              <div class="bracket-slot winner" data-side="center" data-round="5" data-slot="winner"></div>
            </div>
          </div>

          <div class="side side-right">
            <div class="col col-r3">
              <div class="match match-r3 match-right">
                <div class="bracket-slot" data-side="right" data-round="3" data-slot="r3-m1-p1"></div>
                <div class="bracket-slot" data-side="right" data-round="3" data-slot="r3-m1-p2"></div>
              </div>
            </div>
            <div class="col col-r2">
              {[1, 2].map(i => (
                <div class="match match-r2 match-right">
                  <div class="bracket-slot" data-side="right" data-round="2" data-slot={`r2-m${i}-p1`}></div>
                  <div class="bracket-slot" data-side="right" data-round="2" data-slot={`r2-m${i}-p2`}></div>
                </div>
              ))}
            </div>
            <div class="col col-r1">
              {[1, 2, 3, 4].map(i => (
                <div class="match match-r1 match-right">
                  <div class="bracket-slot" data-side="right" data-round="1" data-slot={`r1-m${i}-p1`}></div>
                  <div class="bracket-slot" data-side="right" data-round="1" data-slot={`r1-m${i}-p2`}></div>
                </div>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </main>
</Layout>

<style>
  .tournament-wrap {
    display: flex;
    justify-content: center;
  }

  .bracket {
    width: 100%;
    max-width: 1400px;
    display: flex;
    position: relative;
    align-items: flex-start;
    justify-content: center;
    gap: 24px;
  }

  .bracket-lines {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    overflow: visible;
    z-index: 5;
  }

  .side {
    display: flex;
    align-items: flex-start;
    gap: 24px;
  }

  .col {
    display: flex;
    flex-direction: column;
    position: relative;
  }

  .col-r1 {
    gap: 24px;
  }

  .col-r2 {
    padding-top: 66px;
    gap: 156px;
  }

  .col-r3 {
    padding-top: 198px;
    gap: 0;
  }

  .match {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .col-final {
    position: relative;
    width: 420px;
    flex: 0 0 420px;
  }

  .final-title {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    font-size: 28px;
    font-weight: 900;
    letter-spacing: -0.04em;
    font-style: italic;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .final-row {
    padding-top: 250px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    width: 420px;
  }

  .final-vs {
    font-size: 18px;
    font-weight: 900;
    color: #c98300;
    letter-spacing: 0.2em;
    font-style: italic;
    width: 40px;
    text-align: center;
  }

  .winner-row {
    margin-top: 34px;
    display: flex;
    justify-content: center;
    width: 420px;
  }

  .champion-text {
    position: absolute;
    top: 44px;
    left: 50%;
    transform: translateX(-50%);
    width: 420px;
    text-align: center;
    font-size: 10px;
    font-weight: 900;
    color: #c98300;
    text-transform: uppercase;
    letter-spacing: 0.4em;
    white-space: nowrap;
  }

  .bracket-slot {
    width: 130px;
    height: 50px;
    background: #000;
    border: 1px solid #ffffff;
    border-radius: 4px;
    position: relative;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0,0,0,0.8);
  }

  .bracket-slot.drag-over {
    background: #111;
    border-color: #C98300;
    transform: scale(1.05);
    z-index: 50;
  }

  .bracket-slot.filled {
    border-color: #ffffff;
  }

  .bracket-slot.locked {
    border-color: #c98300;
  }

  .bracket-slot.final {
    width: 150px;
    height: 60px;
    border-width: 2px;
  }

  .bracket-slot.winner {
    width: 180px;
    height: 70px;
    border: 3px solid #C98300;
    box-shadow: 0 0 30px rgba(201, 131, 0, 0.4);
  }

  .slot-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    opacity: 0.8;
    filter: none;
  }

  .bracket-slot.locked .slot-bg-img {
    opacity: 1;
    filter: grayscale(100%) contrast(1.1) brightness(0.55);
  }

  .slot-overlay {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.2);
  }

  .bracket-slot.locked .slot-overlay {
    background: rgba(0,0,0,0.75);
  }

  .slot-aka-box {
    background: #000;
    padding: 2px 10px;
    border: 1px solid #fff;
    box-shadow: 0 2px 5px rgba(0,0,0,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .bracket-slot.locked .slot-aka-box {
    background: rgba(0,0,0,0.9);
    border-width: 2px;
    padding: 4px 12px;
  }

  .slot-name {
    font-size: 9px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #fff;
    white-space: nowrap;
  }

  .bracket-slot.locked .slot-name {
    font-size: 10px;
    letter-spacing: 0.15em;
  }

  .remove-btn {
    position: absolute;
    top: 2px;
    right: 2px;
    z-index: 30;
    width: 16px;
    height: 16px;
    background: #ff0000;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 900;
    color: white;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .bracket-slot:hover .remove-btn {
    opacity: 1;
  }

  .slot-menu-btn {
    position: absolute;
    top: 2px;
    left: 2px;
    z-index: 30;
    width: 16px;
    height: 16px;
    background: #000;
    border: 1px solid #ffffff;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    font-weight: 900;
    line-height: 1;
    opacity: 0;
    transition: opacity 0.2s ease;
  }

  .bracket-slot.filled:hover .slot-menu-btn {
    opacity: 1;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  // --- Drag and Drop Logic ---
  const slots = document.querySelectorAll('.bracket-slot');
  const participants = document.querySelectorAll('.participant-item');
  let bracketState: Record<string, any> = {};

  // Realtime Channel
  const channel = supabase.channel('wild-league', {
    config: {
      broadcast: { self: true },
    },
  });

  channel
    .on('broadcast', { event: 'state-update' }, (payload) => {
      updateBracketUI(payload.payload.state);
    })
    .subscribe();

  const usedParticipantIds = () => {
    const used = new Set<string>();
    Object.values(bracketState || {}).forEach((v: any) => {
      if (v?.locked && v?.id) used.add(v.id);
    });
    return used;
  };

  const syncPoolUsedUI = () => {
    const used = usedParticipantIds();
    participants.forEach((p) => {
      const isUsed = used.has(p.id);
      const overlay = p.querySelector('.participant-used');
      if (isUsed) {
        p.classList.add('is-used');
        p.setAttribute('draggable', 'false');
        overlay?.classList.remove('hidden');
      } else {
        p.classList.remove('is-used');
        p.setAttribute('draggable', 'true');
        overlay?.classList.add('hidden');
      }
    });
  };

  participants.forEach(p => {
    p.addEventListener('dragstart', (e: any) => {
      if (p.classList.contains('is-used')) return;
      e.dataTransfer.setData('participantId', p.id);
      e.dataTransfer.setData('name', p.getAttribute('data-name'));
      e.dataTransfer.setData('image', p.getAttribute('data-image'));
    });
  });

  slots.forEach(slot => {
    slot.addEventListener('dragover', (e) => {
      e.preventDefault();
      slot.classList.add('drag-over');
    });

    slot.addEventListener('dragleave', () => {
      slot.classList.remove('drag-over');
    });

    slot.addEventListener('drop', (e: any) => {
      e.preventDefault();
      slot.classList.remove('drag-over');
      
      const id = e.dataTransfer.getData('participantId');
      const name = e.dataTransfer.getData('name');
      const image = e.dataTransfer.getData('image');
      const sourceSlotId = e.dataTransfer.getData('sourceSlotId');
      const slotId = slot.getAttribute('data-slot');

      if (slotId && id) {
        if (bracketState?.[slotId]?.locked) return;
        if (sourceSlotId && bracketState?.[sourceSlotId]?.locked) return;
        if (sourceSlotId && sourceSlotId !== slotId) {
          delete bracketState[sourceSlotId];
          const sourceEl = document.querySelector(`[data-slot="${sourceSlotId}"]`);
          if (sourceEl) {
            sourceEl.innerHTML = '';
            sourceEl.classList.remove('filled');
            sourceEl.classList.remove('locked');
            (sourceEl as HTMLElement).setAttribute('draggable', 'false');
          }
        }
        bracketState[slotId] = { id, name, image, locked: false };
        renderSlot(slot, { id, name, image });
        channel.send({
          type: 'broadcast',
          event: 'state-update',
          payload: { state: bracketState },
        });
      }
    });
  });

  function renderSlot(slot: Element, data: any) {
    const slotId = slot.getAttribute('data-slot');
    const locked = Boolean(bracketState?.[slotId || '']?.locked);
    const draggable = Boolean(data?.id) && !locked;
    slot.innerHTML = `
      <img src="${data.image}" class="slot-bg-img" />
      <div class="slot-overlay">
        <div class="slot-aka-box ${locked ? '' : 'hidden'}">
          <span class="slot-name">${data.name}</span>
        </div>
      </div>
      <button class="slot-menu-btn" data-slot="${slotId}" aria-label="Opciones">⋮</button>
      <button class="remove-btn ${locked ? 'hidden' : ''}" data-slot="${slotId}">×</button>
    `;
    slot.classList.add('filled');
    slot.classList.toggle('locked', locked);
    (slot as HTMLElement).setAttribute('draggable', draggable ? 'true' : 'false');
    
    slot.querySelector('.remove-btn')?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (slotId) {
        if (bracketState?.[slotId]?.locked) return;
        delete bracketState[slotId];
        channel.send({
          type: 'broadcast',
          event: 'state-update',
          payload: { state: bracketState },
        });
        slot.innerHTML = '';
        slot.classList.remove('filled');
        syncPoolUsedUI();
      }
    });

    (slot as HTMLElement).addEventListener('dragstart', (e: any) => {
      if (!slotId) return;
      const current = bracketState?.[slotId];
      if (!current) return;
      if (current.locked) return;
      e.dataTransfer.setData('participantId', current.id);
      e.dataTransfer.setData('name', current.name);
      e.dataTransfer.setData('image', current.image);
      e.dataTransfer.setData('sourceSlotId', slotId);
      e.dataTransfer.effectAllowed = 'move';
    });
  }

  function updateBracketUI(state: Record<string, any>) {
    bracketState = state;
    document.querySelectorAll('.bracket-slot').forEach((slotEl) => {
      const slotId = slotEl.getAttribute('data-slot');
      if (!slotId) return;
      const data = bracketState?.[slotId];
      if (!data) {
        slotEl.innerHTML = '';
        slotEl.classList.remove('filled');
        slotEl.classList.remove('locked');
        (slotEl as HTMLElement).setAttribute('draggable', 'false');
        return;
      }
      renderSlot(slotEl, data);
    });
    syncPoolUsedUI();
    requestAnimationFrame(drawBracketLines);
  }

  // --- Context menu: advance to next round ---
  const getNextSlotId = (slotId: string) => {
    if (slotId.startsWith('l1-m')) {
      const m = parseInt(slotId.split('-')[1].slice(1), 10);
      if (m === 1) return 'l2-m1-p1';
      if (m === 2) return 'l2-m1-p2';
      if (m === 3) return 'l2-m2-p1';
      if (m === 4) return 'l2-m2-p2';
    }
    if (slotId.startsWith('l2-m')) {
      const m = parseInt(slotId.split('-')[1].slice(1), 10);
      if (m === 1) return 'l3-m1-p1';
      if (m === 2) return 'l3-m1-p2';
    }
    if (slotId.startsWith('l3-m')) return 'final-p1';
    if (slotId.startsWith('r1-m')) {
      const m = parseInt(slotId.split('-')[1].slice(1), 10);
      if (m === 1) return 'r2-m1-p1';
      if (m === 2) return 'r2-m1-p2';
      if (m === 3) return 'r2-m2-p1';
      if (m === 4) return 'r2-m2-p2';
    }
    if (slotId.startsWith('r2-m')) {
      const m = parseInt(slotId.split('-')[1].slice(1), 10);
      if (m === 1) return 'r3-m1-p1';
      if (m === 2) return 'r3-m1-p2';
    }
    if (slotId.startsWith('r3-m')) return 'final-p2';
    if (slotId === 'final-p1' || slotId === 'final-p2') return 'winner';
    return null;
  };

  const menu = document.createElement('div');
  menu.id = 'bracket-context-menu';
  menu.className = 'fixed z-[20000] hidden';
  menu.innerHTML = `
    <div class="bg-black border border-white shadow-[0_10px_30px_rgba(0,0,0,1)]">
      <button data-action="advance" class="block w-full text-left px-4 py-3 text-xs font-black uppercase tracking-widest text-white hover:bg-white hover:text-black">Avanzarlo a siguiente ronda</button>
      <button data-action="lock" class="block w-full text-left px-4 py-3 text-xs font-black uppercase tracking-widest text-white hover:bg-orange-500 hover:text-black border-t border-white">Bloquear</button>
    </div>
  `;
  document.body.appendChild(menu);

  const hideMenu = () => menu.classList.add('hidden');
  document.addEventListener('click', hideMenu);
  document.addEventListener('scroll', hideMenu, true);

  const connections = [
    { from: ['l1-m1-p1', 'l1-m1-p2'], to: 'l2-m1-p1' },
    { from: ['l1-m2-p1', 'l1-m2-p2'], to: 'l2-m1-p2' },
    { from: ['l1-m3-p1', 'l1-m3-p2'], to: 'l2-m2-p1' },
    { from: ['l1-m4-p1', 'l1-m4-p2'], to: 'l2-m2-p2' },
    { from: ['l2-m1-p1', 'l2-m1-p2'], to: 'l3-m1-p1' },
    { from: ['l2-m2-p1', 'l2-m2-p2'], to: 'l3-m1-p2' },
    { from: ['l3-m1-p1', 'l3-m1-p2'], to: 'final-p1' },
    { from: ['r1-m1-p1', 'r1-m1-p2'], to: 'r2-m1-p1' },
    { from: ['r1-m2-p1', 'r1-m2-p2'], to: 'r2-m1-p2' },
    { from: ['r1-m3-p1', 'r1-m3-p2'], to: 'r2-m2-p1' },
    { from: ['r1-m4-p1', 'r1-m4-p2'], to: 'r2-m2-p2' },
    { from: ['r2-m1-p1', 'r2-m1-p2'], to: 'r3-m1-p1' },
    { from: ['r2-m2-p1', 'r2-m2-p2'], to: 'r3-m1-p2' },
    { from: ['r3-m1-p1', 'r3-m1-p2'], to: 'final-p2' },
    { from: ['final-p1', 'final-p2'], to: 'winner' },
  ];

  const getSlotEl = (slotId: string) => document.querySelector(`.bracket-slot[data-slot="${slotId}"]`) as HTMLElement | null;

  const getPoint = (el: HTMLElement, side: 'left' | 'right') => {
    const rect = el.getBoundingClientRect();
    const parent = (document.querySelector('.bracket') as HTMLElement).getBoundingClientRect();
    const x = side === 'left' ? rect.left - parent.left : rect.right - parent.left;
    const y = rect.top - parent.top + rect.height / 2;
    return { x, y, rect, parent };
  };

  const drawPath = (svg: SVGSVGElement, d: string) => {
    const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
    path.setAttribute('d', d);
    path.setAttribute('stroke', '#ffffff');
    path.setAttribute('stroke-width', '2');
    path.setAttribute('fill', 'none');
    path.setAttribute('stroke-linecap', 'square');
    svg.appendChild(path);
  };

  const drawBracketLines = () => {
    const bracket = document.querySelector('.bracket') as HTMLElement | null;
    const svg = document.getElementById('bracket-lines') as SVGSVGElement | null;
    if (!bracket || !svg) return;

    const rect = bracket.getBoundingClientRect();
    const w = Math.max(1, Math.round(rect.width));
    const h = Math.max(1, Math.round(rect.height));
    svg.setAttribute('width', String(w));
    svg.setAttribute('height', String(h));
    svg.setAttribute('viewBox', `0 0 ${w} ${h}`);
    svg.innerHTML = '';

    const offset1 = 12;
    const offset2 = 12;

    for (const c of connections) {
      const fromA = getSlotEl(c.from[0]);
      const fromB = getSlotEl(c.from[1]);
      const to = getSlotEl(c.to);
      if (!fromA || !fromB || !to) continue;

      if (c.to === 'winner') {
        const a = getPoint(fromA, 'right');
        const b = getPoint(fromB, 'left');
        const winnerRect = to.getBoundingClientRect();
        const parentRect = (document.querySelector('.bracket') as HTMLElement).getBoundingClientRect();

        const xJoin = Math.round(winnerRect.left - parentRect.left + winnerRect.width / 2);
        const yA = Math.round(a.y);
        const yB = Math.round(b.y);
        const yJoin = Math.round((yA + yB) / 2);
        const yWinnerTop = Math.round(winnerRect.top - parentRect.top);

        drawPath(svg, `M ${Math.round(a.x)} ${yA} L ${xJoin} ${yA}`);
        drawPath(svg, `M ${Math.round(b.x)} ${yB} L ${xJoin} ${yB}`);
        drawPath(svg, `M ${xJoin} ${yA} L ${xJoin} ${yB}`);
        drawPath(svg, `M ${xJoin} ${yJoin} L ${xJoin} ${yWinnerTop}`);
        continue;
      }

      const sideA = (fromA.getAttribute('data-side') || 'left') as 'left' | 'right';
      const dir = sideA === 'left' ? 1 : -1;
      const startA = getPoint(fromA, sideA === 'left' ? 'right' : 'left');
      const startB = getPoint(fromB, sideA === 'left' ? 'right' : 'left');
      const targetSide = dir === 1 ? 'left' : 'right';
      const end = getPoint(to, targetSide);

      const x1 = Math.round(((startA.x + startB.x) / 2) + dir * offset1);
      const x2 = Math.round(end.x - dir * offset2);
      const yA = Math.round(startA.y);
      const yB = Math.round(startB.y);
      const yJoin = Math.round((yA + yB) / 2);
      const yEnd = Math.round(end.y);

      drawPath(svg, `M ${Math.round(startA.x)} ${yA} L ${x1} ${yA}`);
      drawPath(svg, `M ${Math.round(startB.x)} ${yB} L ${x1} ${yB}`);
      drawPath(svg, `M ${x1} ${yA} L ${x1} ${yB}`);
      drawPath(svg, `M ${x1} ${yJoin} L ${x2} ${yJoin}`);
      drawPath(svg, `M ${x2} ${yJoin} L ${x2} ${yEnd}`);
      drawPath(svg, `M ${x2} ${yEnd} L ${Math.round(end.x)} ${yEnd}`);
    }
  };

  window.addEventListener('resize', () => requestAnimationFrame(drawBracketLines));

  const showMenuAt = (x: number, y: number, slotId: string) => {
    const menuEl = menu as HTMLElement;
    const menuWidth = 260;
    const menuHeight = 96;
    const padding = 8;
    const clampedX = Math.min(Math.max(x, padding), window.innerWidth - menuWidth - padding);
    const clampedY = Math.min(Math.max(y, padding), window.innerHeight - menuHeight - padding);
    menuEl.style.left = `${clampedX}px`;
    menuEl.style.top = `${clampedY}px`;
    menuEl.style.width = `${menuWidth}px`;
    menuEl.dataset.slot = slotId;

    const locked = Boolean(bracketState?.[slotId]?.locked);
    const lockBtn = menuEl.querySelector('button[data-action="lock"]') as HTMLButtonElement | null;
    const advanceBtn = menuEl.querySelector('button[data-action="advance"]') as HTMLButtonElement | null;
    [lockBtn, advanceBtn].forEach((b) => {
      if (!b) return;
      b.classList.remove('opacity-50', 'pointer-events-none');
    });
    if (locked) {
      lockBtn?.classList.add('opacity-50', 'pointer-events-none');
      advanceBtn?.classList.add('opacity-50', 'pointer-events-none');
    }
    menu.classList.remove('hidden');
  };

  document.addEventListener('contextmenu', (e) => {
    const slot = (e.target as HTMLElement).closest('.bracket-slot') as HTMLElement | null;
    if (!slot) return;
    const slotId = slot.getAttribute('data-slot');
    if (!slotId) return;
    if (!bracketState?.[slotId]) return;
    e.preventDefault();
    showMenuAt(e.clientX, e.clientY, slotId);
  });

  document.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('.slot-menu-btn') as HTMLElement | null;
    if (!btn) return;
    e.preventDefault();
    e.stopPropagation();
    const slotId = btn.getAttribute('data-slot');
    if (!slotId) return;
    if (!bracketState?.[slotId]) return;
    const rect = btn.getBoundingClientRect();
    showMenuAt(rect.left, rect.bottom + 6, slotId);
  });

  menu.addEventListener('click', (e) => {
    const btn = (e.target as HTMLElement).closest('button');
    if (!btn) return;
    const action = btn.getAttribute('data-action');
    const fromSlot = (menu as HTMLElement).dataset.slot;
    hideMenu();
    if (!fromSlot) return;
    const data = bracketState?.[fromSlot];
    if (!data) return;

    if (action === 'lock') {
      if (data.locked) return;
      bracketState[fromSlot] = { ...data, locked: true };
      const el = document.querySelector(`[data-slot="${fromSlot}"]`);
      if (el) renderSlot(el, bracketState[fromSlot]);
      syncPoolUsedUI();
      channel.send({
        type: 'broadcast',
        event: 'state-update',
        payload: { state: bracketState },
      });
      return;
    }

    if (action === 'advance') {
      if (data.locked) return;
      const next = getNextSlotId(fromSlot);
      if (!next) return;
      if (bracketState?.[next]?.locked) return;
      bracketState[next] = { ...data, locked: false };
      const nextEl = document.querySelector(`[data-slot="${next}"]`);
      if (nextEl) renderSlot(nextEl, bracketState[next]);
      syncPoolUsedUI();
      channel.send({
        type: 'broadcast',
        event: 'state-update',
        payload: { state: bracketState },
      });
    }
  });

  // Initial sync
  syncPoolUsedUI();
  requestAnimationFrame(drawBracketLines);
</script>
