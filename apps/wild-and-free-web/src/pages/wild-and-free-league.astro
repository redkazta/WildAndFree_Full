---
import Layout from '../layouts/Layout.astro';

const config = {
  name: "Wild Gvng - Wild and Free League",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
};

// 16 Initial participants (Mock) with high-quality street photography
const initialParticipants = [
  { id: 'p1', name: 'Lil Kiro', image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=400&h=400&fit=crop&q=80' },
  { id: 'p2', name: 'Neon Ghost', image: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&h=400&fit=crop&q=80' },
  { id: 'p3', name: 'Shadow V', image: 'https://images.unsplash.com/photo-1472099645785-5658abf4ff4e?w=400&h=400&fit=crop&q=80' },
  { id: 'p4', name: 'Nova K', image: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=400&h=400&fit=crop&q=80' },
  { id: 'p5', name: 'Sable', image: 'https://images.unsplash.com/photo-1539571696357-5a69c17a67c6?w=400&h=400&fit=crop&q=80' },
  { id: 'p6', name: 'Storm Trooper', image: 'https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=400&h=400&fit=crop&q=80' },
  { id: 'p7', name: 'Midnight Rider', image: 'https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=400&h=400&fit=crop&q=80' },
  { id: 'p8', name: 'Crystal Wave', image: 'https://images.unsplash.com/photo-1531746020798-e6953c6e8e04?w=400&h=400&fit=crop&q=80' },
  { id: 'p9', name: 'Drill King', image: 'https://images.unsplash.com/photo-1531384441138-2736e62e0919?w=400&h=400&fit=crop&q=80' },
  { id: 'p10', name: 'Flow Master', image: 'https://images.unsplash.com/photo-1508700115892-45ecd05ae2ad?w=400&h=400&fit=crop&q=80' },
  { id: 'p11', name: 'Rhyme Slayer', image: 'https://images.unsplash.com/photo-1493225255756-d9584f8606e9?w=400&h=400&fit=crop&q=80' },
  { id: 'p12', name: 'Beat Beast', image: 'https://images.unsplash.com/photo-1520127873598-120e2db099ae?w=400&h=400&fit=crop&q=80' },
  { id: 'p13', name: 'Word Smith', image: 'https://images.unsplash.com/photo-1521119989659-a83eee488004?w=400&h=400&fit=crop&q=80' },
  { id: 'p14', name: 'Urban Soul', image: 'https://images.unsplash.com/photo-1519345182560-3f2917c472ef?w=400&h=400&fit=crop&q=80' },
  { id: 'p15', name: 'Ghetto Star', image: 'https://images.unsplash.com/photo-1463453091185-61582044d556?w=400&h=400&fit=crop&q=80' },
  { id: 'p16', name: 'Street Legend', image: 'https://images.unsplash.com/photo-1552374196-c4e7ffc6e126?w=400&h=400&fit=crop&q=80' },
];
---

<Layout config={config}>
  <main class="min-h-screen bg-black pt-32 pb-40 px-4 overflow-x-auto">
    <div class="max-w-[1600px] mx-auto space-y-12">
      <div class="space-y-4 text-center">
        <h1 class="text-6xl md:text-8xl font-black tracking-tighter text-white uppercase leading-none">
          WILD <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-red-600">AND FREE</span>
        </h1>
        <p class="text-xl text-white font-bold uppercase tracking-[0.3em]">Liga de Freestyle • Fase de Eliminación</p>
      </div>

      <!-- Realtime Status -->
      <div class="flex justify-center">
        <div id="realtime-status" class="flex items-center gap-3 px-6 py-2 bg-white/5 border border-white/10 rounded-full">
          <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
          <span class="text-[10px] font-black text-white/60 uppercase tracking-widest">Sincronización en Tiempo Real Activa</span>
        </div>
      </div>

      <!-- Participants Pool -->
      <div class="bg-white/[0.02] border border-white/5 rounded-[2rem] p-8 space-y-6">
        <h3 class="text-xs font-black text-orange-500 uppercase tracking-[0.4em] text-center">Participantes Disponibles</h3>
        <div id="participants-pool" class="grid grid-cols-8 gap-4 max-w-4xl mx-auto">
          {initialParticipants.map(p => (
            <div 
              draggable="true" 
              id={p.id}
              data-name={p.name}
              data-image={p.image}
              class="participant-item group relative aspect-square rounded-xl overflow-hidden cursor-grab active:cursor-grabbing border-2 border-white/10 hover:border-orange-500 transition-all shadow-xl"
            >
              <img src={p.image} alt={p.name} class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-110 transition-all duration-500" />
              <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex items-end justify-center pb-1">
                <span class="text-[7px] font-black text-white text-center uppercase tracking-tight">{p.name}</span>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Tournament Bracket -->
      <div class="tournament-container py-10 flex justify-center items-center gap-2 max-w-full overflow-hidden scale-90 origin-top">
        
        <!-- LEFT SIDE -->
        <div class="flex gap-4 items-center">
          <!-- Round of 16 (Left) -->
          <div class="space-y-4">
            {[1, 2, 3, 4].map(i => (
              <div class="bracket-match space-y-2 relative">
                <div class="bracket-slot left" data-slot={`l1-m${i}-p1`}></div>
                <div class="bracket-slot left" data-slot={`l1-m${i}-p2`}></div>
                <!-- Connector to next round -->
                <div class="absolute -right-4 top-1/2 w-4 h-px bg-white"></div>
              </div>
            ))}
          </div>
          <!-- Quarter Finals (Left) -->
          <div class="space-y-16">
            {[1, 2].map(i => (
              <div class="bracket-match space-y-2 relative">
                <div class="bracket-slot left" data-slot={`l2-m${i}-p1`}></div>
                <div class="bracket-slot left" data-slot={`l2-m${i}-p2`}></div>
                <!-- Connector to next round -->
                <div class="absolute -right-4 top-1/2 w-4 h-px bg-white"></div>
              </div>
            ))}
          </div>
          <!-- Semis (Left) -->
          <div class="space-y-32">
            <div class="bracket-match space-y-2 relative">
              <div class="bracket-slot left" data-slot={`l3-m1-p1`}></div>
              <div class="bracket-slot left" data-slot={`l3-m1-p2`}></div>
              <!-- Connector to final -->
              <div class="absolute -right-4 top-1/2 w-4 h-px bg-white"></div>
            </div>
          </div>
        </div>

        <!-- CENTER (FINAL) -->
        <div class="flex flex-col items-center gap-6 px-4">
          <div class="text-center py-4">
            <h2 class="text-4xl font-black italic tracking-tighter">
              <span class="text-orange-500">WILD</span> <span class="text-white">GVNG</span>
            </h2>
          </div>
          <div class="flex gap-4 items-center">
            <div class="bracket-slot final" data-slot="final-p1"></div>
            <span class="text-2xl font-black text-orange-500 italic">VS</span>
            <div class="bracket-slot final" data-slot="final-p2"></div>
          </div>
          <div class="bracket-slot winner" data-slot="winner"></div>
          <p class="text-[9px] font-black text-orange-500 uppercase tracking-[0.4em]">CAMPEÓN WILD AND FREE FECHA #1</p>
        </div>

        <!-- RIGHT SIDE -->
        <div class="flex gap-4 items-center flex-row-reverse">
          <!-- Round of 16 (Right) -->
          <div class="space-y-4">
            {[1, 2, 3, 4].map(i => (
              <div class="bracket-match space-y-2 relative">
                <div class="bracket-slot right" data-slot={`r1-m${i}-p1`}></div>
                <div class="bracket-slot right" data-slot={`r1-m${i}-p2`}></div>
                <!-- Connector to next round -->
                <div class="absolute -left-4 top-1/2 w-4 h-px bg-white"></div>
              </div>
            ))}
          </div>
          <!-- Quarter Finals (Right) -->
          <div class="space-y-16">
            {[1, 2].map(i => (
              <div class="bracket-match space-y-2 relative">
                <div class="bracket-slot right" data-slot={`r2-m${i}-p1`}></div>
                <div class="bracket-slot right" data-slot={`r2-m${i}-p2`}></div>
                <!-- Connector to next round -->
                <div class="absolute -left-4 top-1/2 w-4 h-px bg-white"></div>
              </div>
            ))}
          </div>
          <!-- Semis (Right) -->
          <div class="space-y-32">
            <div class="bracket-match space-y-2 relative">
              <div class="bracket-slot right" data-slot={`r3-m1-p1`}></div>
              <div class="bracket-slot right" data-slot={`r3-m1-p2`}></div>
              <!-- Connector to final -->
              <div class="absolute -left-4 top-1/2 w-4 h-px bg-white"></div>
            </div>
          </div>
        </div>

      </div>
    </div>
  </main>
</Layout>

<style>
  .bracket-slot {
    width: 130px;
    height: 50px;
    background: #000;
    border: 1px solid #ffffff;
    border-radius: 4px;
    position: relative;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    overflow: hidden;
    box-shadow: 0 4px 10px rgba(0,0,0,0.8);
  }

  .bracket-slot.drag-over {
    background: #111;
    border-color: #C98300;
    transform: scale(1.05);
    z-index: 50;
  }

  .bracket-slot.filled {
    border-color: #ffffff;
  }

  .bracket-slot.final {
    width: 150px;
    height: 60px;
    border-width: 2px;
  }

  .bracket-slot.winner {
    width: 180px;
    height: 70px;
    border: 3px solid #C98300;
    box-shadow: 0 0 30px rgba(201, 131, 0, 0.4);
  }

  .slot-bg-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.8;
    filter: grayscale(100%);
  }

  .slot-overlay {
    position: relative;
    z-index: 10;
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(0,0,0,0.2);
  }

  .slot-aka-box {
    background: #000;
    padding: 2px 10px;
    border: 1px solid #fff;
    box-shadow: 0 2px 5px rgba(0,0,0,0.5);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .slot-name {
    font-size: 9px;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: #fff;
    white-space: nowrap;
  }

  /* Vertical Connectors */
  .bracket-match::after {
    content: '';
    position: absolute;
    right: -2px;
    top: 25%;
    height: 50%;
    width: 1px;
    background: #ffffff;
  }
  
  .flex-row-reverse .bracket-match::after {
    left: -2px;
    right: auto;
  }

  .remove-btn {
    position: absolute;
    top: 2px;
    right: 2px;
    z-index: 30;
    width: 16px;
    height: 16px;
    background: #ff0000;
    border-radius: 4px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 10px;
    font-weight: 900;
    color: white;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .bracket-slot:hover .remove-btn {
    opacity: 1;
  }
</style>

<script>
  import { supabase } from '../lib/supabase';

  // --- Drag and Drop Logic ---
  const slots = document.querySelectorAll('.bracket-slot');
  const participants = document.querySelectorAll('.participant-item');
  let bracketState: Record<string, any> = {};

  // Realtime Channel
  const channel = supabase.channel('wild-league', {
    config: {
      broadcast: { self: true },
    },
  });

  channel
    .on('broadcast', { event: 'state-update' }, (payload) => {
      updateBracketUI(payload.payload.state);
    })
    .subscribe();

  participants.forEach(p => {
    p.addEventListener('dragstart', (e: any) => {
      e.dataTransfer.setData('participantId', p.id);
      e.dataTransfer.setData('name', p.getAttribute('data-name'));
      e.dataTransfer.setData('image', p.getAttribute('data-image'));
    });
  });

  slots.forEach(slot => {
    slot.addEventListener('dragover', (e) => {
      e.preventDefault();
      slot.classList.add('drag-over');
    });

    slot.addEventListener('dragleave', () => {
      slot.classList.remove('drag-over');
    });

    slot.addEventListener('drop', (e: any) => {
      e.preventDefault();
      slot.classList.remove('drag-over');
      
      const id = e.dataTransfer.getData('participantId');
      const name = e.dataTransfer.getData('name');
      const image = e.dataTransfer.getData('image');
      const slotId = slot.getAttribute('data-slot');

      if (slotId && id) {
        bracketState[slotId] = { id, name, image };
        renderSlot(slot, { id, name, image });
        channel.send({
          type: 'broadcast',
          event: 'state-update',
          payload: { state: bracketState },
        });
      }
    });
  });

  function renderSlot(slot: Element, data: any) {
    const slotId = slot.getAttribute('data-slot');
    slot.innerHTML = `
      <img src="${data.image}" class="slot-bg-img" />
      <div class="slot-overlay">
        <div class="slot-aka-box">
          <span class="slot-name">${data.name}</span>
        </div>
      </div>
      <button class="remove-btn" data-slot="${slotId}">×</button>
    `;
    slot.classList.add('filled');
    
    slot.querySelector('.remove-btn')?.addEventListener('click', (e) => {
      e.stopPropagation();
      if (slotId) {
        delete bracketState[slotId];
        channel.send({
          type: 'broadcast',
          event: 'state-update',
          payload: { state: bracketState },
        });
        slot.innerHTML = '';
        slot.classList.remove('filled');
      }
    });
  }

  function updateBracketUI(state: Record<string, any>) {
    bracketState = state;
    Object.entries(state).forEach(([slotId, data]: [string, any]) => {
      const slot = document.querySelector(`[data-slot="${slotId}"]`);
      if (slot) {
        renderSlot(slot, data);
      }
    });
  }
</script>
