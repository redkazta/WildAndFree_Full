---
export const prerender = false;
import PostArticle from '../../components/PostArticle.astro';
import NotFound from '../../components/PostNotFound.astro';
import { resolvePostIdByShortId } from '../../lib/post-resolve';

const { shortId } = Astro.params;
const postId = (await resolvePostIdByShortId(shortId || '', 'general')) || null;
---

{postId ? <PostArticle postId={postId} /> : <NotFound typeLabel="noticia" />}
