    font-family: inherit;
  }
  .back-btn:hover { color: #C98300; }
  .form-header { text-align: center; margin-bottom: 32px; }
  .role-icon-lg { font-size: 2.5rem; margin-bottom: 8px; }
  .role-badge-lg {
    display: inline-block;
    background: linear-gradient(135deg, #facc15, #f59e0b);
    color: #000;
    font-size: 0.55rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    padding: 4px 14px;
    border-radius: 100px;
    margin-bottom: 8px;
  }
  .form-title {
    font-size: 1.75rem;
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.02em;
    margin: 0 0 4px;
  }
  .form-subtitle {
    font-size: 0.7rem;
    color: var(--text-muted);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin: 0;
  }

  /* ===== FIELDS ===== */
  .field-label {
    display: block;
    font-size: 0.6rem;
    font-weight: 900;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-muted);
    margin-bottom: 6px;
    margin-left: 4px;
  }
  .field-input {
    width: 100%;
    padding: 14px 18px;
    background: var(--bg-card);
    border: 1px solid var(--bg-hover);
    border-radius: 14px;
    color: #fff;
    font-size: 0.85rem;
    font-weight: 600;
    transition: all 0.2s;
    outline: none;
    font-family: inherit;
    box-sizing: border-box;
  }
  .field-input:focus {
    border-color: #C98300;
    background: rgba(201,131,0,0.06);
  }
  .field-input::placeholder { color: var(--border-soft); }

  textarea.field-input { min-height: 80px; }

  /* ===== GENRE CHIPS ===== */
  .genre-chip {
    cursor: pointer;
  }
  .genre-chip span {
    display: inline-block;
    padding: 6px 14px;
    border-radius: 100px;
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    background: var(--bg-card);
    border: 1px solid var(--bg-hover);
    color: var(--text-muted);
    transition: all 0.2s;
  }
  .genre-chip input:checked + span {
    background: rgba(239,68,68,0.2);
    border-color: rgba(239,68,68,0.5);
    color: #ef4444;
  }
  .genre-chip:hover span {
    border-color: var(--border-soft);
    color: #fff;
  }

  /* ===== STAFF OPTION CARDS ===== */
  .staff-option { cursor: pointer; }
  .staff-option-card {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 16px 12px;
    border-radius: 16px;
    background: var(--bg-card);
    border: 1px solid var(--border-faint);
    transition: all 0.2s;
    color: var(--text-muted);
  }
  .staff-option input:checked + .staff-option-card {
    background: rgba(250,204,21,0.08);
    border-color: rgba(250,204,21,0.4);
    color: #facc15;
  }
  .staff-option:hover .staff-option-card {
    border-color: var(--border-soft);
  }

  /* ===== CHECKBOX ===== */
  .checkbox-label {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    cursor: pointer;
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    transition: color 0.2s;
  }
  .checkbox-label:hover { color: #fff; }
  .check-box {
    width: 18px;
    height: 18px;
    border: 2px solid var(--border-muted);
    border-radius: 5px;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-top: 1px;
    flex-shrink: 0;
    transition: all 0.2s;
