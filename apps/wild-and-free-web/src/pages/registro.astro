    border-color: rgba(250,204,21,0.15);
  }
  @media (max-width: 640px) {
    .form-wrapper { padding: 32px 20px; border-radius: 24px; }
  }
  .back-btn {
    background: none;
    border: none;
    color: var(--text-muted);
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
