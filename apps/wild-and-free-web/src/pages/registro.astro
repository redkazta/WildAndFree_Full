---
import Layout from '../layouts/Layout.astro';
---

<Layout config={{
  name: "Wild Gvng - Registro",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>
  <div class="register-container">
    <div class="register-card group">
      <div class="absolute inset-0 bg-gradient-to-br from-orange-500/20 via-transparent to-red-600/20 opacity-0 group-hover:opacity-100 transition-opacity duration-1000 rounded-3xl -z-10"></div>
      <div class="register-header">
        <div class="flex flex-col items-center mb-8">
          <a href="/" class="text-4xl font-black tracking-[0.2em] mb-2">
            <span class="text-orange-500">WILD</span>
            <span class="text-white">GVNG</span>
          </a>
          <div class="h-1 w-12 bg-orange-500 rounded-full"></div>
        </div>
        <h2 class="text-3xl font-black tracking-tighter text-white uppercase">Únete a la Crew</h2>
        <p class="text-white/60 font-bold uppercase tracking-widest text-[10px] mt-2">Forma parte del movimiento urbano</p>
      </div>
      
      <form class="register-form space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="fullName" class="text-[10px] font-black uppercase tracking-[0.2em] text-white/40 ml-1">Nombre Completo</label>
            <input type="text" id="fullName" name="fullName" placeholder="Tu nombre" class="w-full px-6 py-4 bg-white/5 border border-white/10 rounded-2xl text-white font-bold focus:border-orange-500 focus:bg-white/10 transition-all outline-none" required />
          </div>
          <div class="space-y-2">
            <label for="username" class="text-[10px] font-black uppercase tracking-[0.2em] text-white/40 ml-1">Usuario</label>
            <input type="text" id="username" name="username" placeholder="@usuario" class="w-full px-6 py-4 bg-white/5 border border-white/10 rounded-2xl text-white font-bold focus:border-orange-500 focus:bg-white/10 transition-all outline-none" />
          </div>
        </div>
        
        <div class="space-y-2">
          <label for="email" class="text-[10px] font-black uppercase tracking-[0.2em] text-white/40 ml-1">Correo Electrónico</label>
          <input type="email" id="email" name="email" placeholder="tu@email.com" class="w-full px-6 py-4 bg-white/5 border border-white/10 rounded-2xl text-white font-bold focus:border-orange-500 focus:bg-white/10 transition-all outline-none" required />
        </div>

        <div class="space-y-2">
          <label for="phone" class="text-[10px] font-black uppercase tracking-[0.2em] text-white/40 ml-1">Teléfono</label>
          <input type="tel" id="phone" name="phone" placeholder="+52 55 0000 0000" class="w-full px-6 py-4 bg-white/5 border border-white/10 rounded-2xl text-white font-bold focus:border-orange-500 focus:bg-white/10 transition-all outline-none" required />
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="password" class="text-[10px] font-black uppercase tracking-[0.2em] text-white/40 ml-1">Contraseña</label>
            <input type="password" id="password" name="password" placeholder="••••••••" class="w-full px-6 py-4 bg-white/5 border border-white/10 rounded-2xl text-white font-bold focus:border-orange-500 focus:bg-white/10 transition-all outline-none" required />
          </div>
          <div class="space-y-2">
            <label for="confirmPassword" class="text-[10px] font-black uppercase tracking-[0.2em] text-white/40 ml-1">Confirmar</label>
            <input type="password" id="confirmPassword" name="confirmPassword" placeholder="••••••••" class="w-full px-6 py-4 bg-white/5 border border-white/10 rounded-2xl text-white font-bold focus:border-orange-500 focus:bg-white/10 transition-all outline-none" required />
          </div>
        </div>
        
        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div class="space-y-2">
            <label for="location" class="text-[10px] font-black uppercase tracking-[0.2em] text-white/40 ml-1">Ubicación</label>
            <select id="location" name="location" class="w-full px-6 py-4 bg-white/5 border border-white/10 rounded-2xl text-white font-bold focus:border-orange-500 focus:bg-white/10 transition-all outline-none appearance-none cursor-pointer">
              <option value="" class="bg-[#111]">País</option>
              <option value="MX" class="bg-[#111]">🇲🇽 México</option>
              <option value="ES" class="bg-[#111]">🇪🇸 España</option>
              <option value="CO" class="bg-[#111]">🇨🇴 Colombia</option>
              <option value="AR" class="bg-[#111]">🇦🇷 Argentina</option>
            </select>
          </div>
          <div class="space-y-2">
            <label for="birthdate" class="text-[10px] font-black uppercase tracking-[0.2em] text-white/40 ml-1">Nacimiento</label>
            <input type="date" id="birthdate" name="birthdate" class="w-full px-6 py-4 bg-white/5 border border-white/10 rounded-2xl text-white font-bold focus:border-orange-500 focus:bg-white/10 transition-all outline-none" />
          </div>
        </div>
        
        <div class="space-y-4 pt-2">
          <label class="flex items-start gap-3 cursor-pointer group/check">
            <input type="checkbox" id="terms" name="terms" class="hidden" required />
            <div class="w-5 h-5 border-2 border-white/10 rounded-lg flex items-center justify-center mt-0.5 group-hover/check:border-orange-500 transition-all shrink-0">
              <div class="w-2.5 h-2.5 bg-orange-500 rounded-sm opacity-0 check-mark transition-opacity"></div>
            </div>
            <span class="text-[10px] font-black uppercase tracking-widest text-white/40 group-hover/check:text-white transition-colors">Acepto los <a href="#" class="text-orange-500 hover:underline">términos y condiciones</a></span>
          </label>
          
          <label class="flex items-start gap-3 cursor-pointer group/check">
            <input type="checkbox" id="newsletter" name="newsletter" class="hidden" />
            <div class="w-5 h-5 border-2 border-white/10 rounded-lg flex items-center justify-center mt-0.5 group-hover/check:border-orange-500 transition-all shrink-0">
              <div class="w-2.5 h-2.5 bg-orange-500 rounded-sm opacity-0 check-mark transition-opacity"></div>
            </div>
            <span class="text-[10px] font-black uppercase tracking-widest text-white/40 group-hover/check:text-white transition-colors">Recibir noticias y lanzamientos</span>
          </label>
        </div>
        
        <button type="submit" class="w-full py-5 bg-white text-black text-xs font-black uppercase tracking-[0.3em] rounded-2xl hover:bg-orange-500 hover:text-white transition-all transform hover:-translate-y-1 shadow-2xl shadow-white/5 hover:shadow-orange-500/20">
          Crear Cuenta
        </button>
      </form>
      
      <div class="relative my-10">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-white/5"></div></div>
        <div class="relative flex justify-center text-[10px] font-black uppercase tracking-[0.2em]"><span class="bg-[#111] px-4 text-white/20">o regístrate con</span></div>
      </div>
      
      <div class="grid grid-cols-1 gap-4">
        <button class="social-btn flex items-center justify-center gap-3 py-4 bg-white/5 border border-white/10 rounded-2xl hover:bg-white/10 transition-all group/social" type="button">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-white group-hover/social:text-orange-500 transition-colors">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          <span class="text-[10px] font-black uppercase tracking-widest text-white">Google</span>
        </button>
      </div>
      
      <div class="mt-8 text-center">
        <p class="text-[10px] font-black uppercase tracking-widest text-white/40 leading-relaxed">
          Al registrarte, aceptas nuestros <br/>
          <a href="/terminos" class="text-orange-500 hover:text-white transition-colors underline decoration-orange-500/30">Términos y Condiciones</a>
        </p>
      </div>

      <div class="mt-8 text-center pt-8 border-t border-white/5">
        <p class="text-[10px] font-black uppercase tracking-widest text-white/40">
          ¿Ya tienes una cuenta? <a href="/login" class="text-orange-500 hover:text-white transition-colors">Inicia sesión</a>
        </p>
      </div>
    </div>
  </div>

<style>
  input:checked + div .check-mark {
    opacity: 1;
  }
  
  .register-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    background: #000;
    position: relative;
    overflow-x: hidden;
  }

  .register-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 20% 80%, rgba(201, 131, 0, 0.15) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(138, 3, 3, 0.15) 0%, transparent 50%);
    pointer-events: none;
  }

  .register-card {
    background: rgba(17, 17, 17, 0.95);
    border: 1px solid rgba(255, 255, 255, 0.05);
    border-radius: 40px;
    padding: 60px;
    max-width: 600px;
    width: 100%;
    backdrop-filter: blur(20px);
    box-shadow: 0 40px 100px -20px rgba(0, 0, 0, 0.8);
    position: relative;
    z-index: 1;
  }

  @media (max-width: 640px) {
    .register-card {
      padding: 40px 24px;
      border-radius: 30px;
    }
  }
</style>
</Layout>

<script type="module">
  import { supabase } from '../lib/supabase'

  const form = document.querySelector('.register-form')
  const googleBtn = document.querySelector('.social-btn')

  if (googleBtn) {
    googleBtn.addEventListener('click', async () => {
      const { error } = await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: `${window.location.origin}/auth/callback` }
      })
      if (error) alert(error.message)
    })
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const submitBtn = form.querySelector('button[type="submit"]')
      const originalText = submitBtn.textContent

      const fullName = document.getElementById('fullName')?.value?.trim()
      const username = document.getElementById('username')?.value?.trim()
      const email = document.getElementById('email')?.value?.trim()
      const phone = document.getElementById('phone')?.value?.trim()
      const password = document.getElementById('password')?.value
      const confirmPassword = document.getElementById('confirmPassword')?.value
      const location = document.getElementById('location')?.value
      const birthdate = document.getElementById('birthdate')?.value

      if (!email || !password || !fullName) return
      
      if (password !== confirmPassword) {
        alert('Las contraseñas no coinciden.')
        return
      }

      submitBtn.disabled = true
      submitBtn.textContent = 'Creando cuenta...'
      submitBtn.style.opacity = '0.5'

      const { error } = await supabase.auth.signUp({
        email,
        password,
        options: {
          data: {
            nombre: fullName,
            username: username || null,
            phone: phone || null,
            ubicacion: location || 'Torreón Coahuila',
            birthdate,
            role: 'fan'
          },
          emailRedirectTo: `${window.location.origin}/auth/callback`
        }
      })

      if (error) {
        alert(error.message)
        submitBtn.disabled = false
        submitBtn.textContent = originalText
        submitBtn.style.opacity = '1'
        return
      }

      alert('¡Registro exitoso! Por favor revisa tu correo para confirmar tu cuenta.')
      window.location.href = '/login'
    })
  }
</script>

<style>
  .register-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 40px 20px;
    background: linear-gradient(135deg, #000 0%, #111 50%, #000 100%);
    position: relative;
  }

  .register-container::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 20% 80%, rgba(201, 131, 0, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(138, 3, 3, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }

  .register-card {
    background: rgba(17, 17, 17, 0.9);
    border: 1px solid rgba(201, 131, 0, 0.3);
    border-radius: 16px;
    padding: 48px;
    max-width: 480px;
    width: 100%;
    backdrop-filter: blur(10px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
    position: relative;
    z-index: 1;
  }

  .register-header {
    text-align: center;
    margin-bottom: 32px;
  }

  .logo-text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-bottom: 24px;
  }

  .logo-line {
    font-weight: 900;
    font-size: 24px;
    letter-spacing: 0.25em;
    color: #fff;
    text-transform: uppercase;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .register-header h2 {
    margin: 0 0 8px 0;
    font-size: 24px;
    color: #fff;
    font-family: 'Noto Sans JP', sans-serif;
    letter-spacing: 0.05em;
  }

  .register-header p {
    margin: 0;
    color: rgba(255, 255, 255, 0.6);
    font-size: 14px;
    font-family: 'Noto Sans JP', sans-serif;
  }

  .register-form {
    margin-bottom: 24px;
  }

  .form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    margin-bottom: 8px;
    color: #fff;
    font-size: 14px;
    font-weight: 500;
    font-family: 'Noto Sans JP', sans-serif;
    letter-spacing: 0.02em;
  }

  .form-group input,
  .form-group select {
    width: 100%;
    padding: 12px 16px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(201, 131, 0, 0.3);
    border-radius: 8px;
    color: #fff;
    font-size: 14px;
    font-family: 'Noto Sans JP', sans-serif;
    transition: all 0.2s;
  }

  .form-group input:focus,
  .form-group select:focus {
    outline: none;
    border-color: var(--primary-color);
    background: rgba(201, 131, 0, 0.1);
    box-shadow: 0 0 0 2px rgba(201, 131, 0, 0.2);
  }

  .form-group input::placeholder {
    color: rgba(255, 255, 255, 0.4);
  }

  .form-group select {
    cursor: pointer;
  }

  .form-group select option {
    background: #111;
    color: #fff;
  }

  .form-options {
    margin-bottom: 24px;
  }

  .checkbox-container {
    display: flex;
    align-items: flex-start;
    cursor: pointer;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.8);
    font-family: 'Noto Sans JP', sans-serif;
    line-height: 1.4;
  }

  .checkbox-container input {
    display: none;
  }

  .checkmark {
    width: 16px;
    height: 16px;
    border: 2px solid rgba(201, 131, 0, 0.3);
    border-radius: 3px;
    margin-right: 8px;
    margin-top: 2px;
    position: relative;
    transition: all 0.2s;
    flex-shrink: 0;
  }

  .checkbox-container input:checked + .checkmark {
    background: var(--primary-color);
    border-color: var(--primary-color);
  }

  .checkbox-container input:checked + .checkmark::after {
    content: '✓';
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    color: #000;
    font-weight: bold;
    font-size: 10px;
  }

  .link {
    color: var(--primary-color);
    text-decoration: none;
    transition: all 0.2s;
  }

  .link:hover {
    color: #e69500;
    text-decoration: underline;
  }

  .submit-btn {
    width: 100%;
    padding: 14px;
    background: var(--primary-color);
    border: none;
    border-radius: 8px;
    color: #000;
    font-size: 16px;
    font-weight: 600;
    font-family: 'Noto Sans JP', sans-serif;
    letter-spacing: 0.05em;
    cursor: pointer;
    transition: all 0.2s;
    text-transform: uppercase;
  }

  .submit-btn:hover {
    background: #e69500;
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(201, 131, 0, 0.3);
  }

  .divider {
    text-align: center;
    margin: 32px 0;
    position: relative;
  }

  .divider::before {
    content: '';
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    height: 1px;
    background: linear-gradient(90deg, transparent, rgba(201, 131, 0, 0.3), transparent);
  }

  .divider span {
    background: #111;
    padding: 0 16px;
    color: rgba(255, 255, 255, 0.6);
    font-size: 12px;
    font-family: 'Noto Sans JP', sans-serif;
    position: relative;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .social-login {
    display: flex;
    gap: 12px;
    margin-bottom: 24px;
  }

  .social-btn {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    padding: 12px;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(201, 131, 0, 0.2);
    border-radius: 8px;
    color: #fff;
    font-size: 14px;
    font-family: 'Noto Sans JP', sans-serif;
    cursor: pointer;
    transition: all 0.2s;
  }

  .social-btn:hover {
    background: rgba(201, 131, 0, 0.1);
    border-color: var(--primary-color);
    transform: translateY(-1px);
  }

  .social-btn.google:hover {
    background: rgba(66, 133, 244, 0.1);
    border-color: #4285f4;
  }

  .login-link {
    text-align: center;
    font-size: 14px;
    color: rgba(255, 255, 255, 0.6);
    font-family: 'Noto Sans JP', sans-serif;
  }

  .login-link a {
    color: var(--primary-color);
    text-decoration: none;
    font-weight: 500;
    transition: all 0.2s;
  }

  .login-link a:hover {
    color: #e69500;
    text-decoration: underline;
  }

  @media (max-width: 480px) {
    .register-card {
      padding: 32px 24px;
      margin: 20px;
    }
    
    .form-row {
      grid-template-columns: 1fr;
    }
    
    .social-login {
      flex-direction: column;
    }
  }
</style>
