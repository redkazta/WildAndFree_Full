---
import Layout from '../layouts/Layout.astro';
---

<Layout config={{
  name: "Wild Gvng - Elige tu Camino",
  primary_color: "#C98300",
  secondary_color: "#8A0303"
}}>

<!-- ==================== STEP 1: CHARACTER SELECT ==================== -->
<div id="step-select" class="register-container">
  <div class="select-wrapper">
    <!-- Logo -->
    <div class="flex flex-col items-center mb-4">
      <a href="/" class="text-5xl font-black tracking-[0.2em] mb-2">
        <span class="text-wild-orange">WILD</span>
        <span class="text-white">GVNG</span>
      </a>
      <div class="h-1 w-16 bg-wild-orange rounded-full"></div>
    </div>

    <h1 class="select-title">ELIGE TU CAMINO</h1>
    <p class="select-subtitle">¿Cómo quieres formar parte del movimiento?</p>

    <div class="cards-grid">
      <!-- WILD ONES -->
      <button class="role-card role-wildones" data-role="wildones" onclick="selectRole('wildones')">
        <div class="role-glow"></div>
        <div class="role-icon">🔥</div>
        <h2 class="role-name">WILD ONES</h2>
        <p class="role-label">Fan / Miembro</p>
        <p class="role-desc">Únete a la crew. Accede a contenido exclusivo, eventos, la tienda y la radio.</p>
        <div class="role-perks">
          <span>🎤 Eventos</span>
          <span>🛍 Tienda</span>
          <span>📻 Radio</span>
        </div>
        <div class="role-cta">UNIRME →</div>
      </button>

      <!-- STAFF / SPONSOR (Premium Center) -->
      <button class="role-card role-staff" data-role="staff" onclick="selectRole('staff')">
        <div class="role-glow role-glow-premium"></div>
        <div class="role-badge">EXCLUSIVO</div>
        <div class="role-icon">⭐</div>
        <h2 class="role-name">LIDERAR</h2>
        <p class="role-label">Staff / Patrocinador</p>
        <p class="role-desc">Forma parte del equipo. Colabora en el proyecto, patrocina eventos o únete al staff.</p>
        <div class="role-perks">
          <span>🤝 Staff</span>
          <span>💰 Patrocinio</span>
          <span>📊 ERP</span>
        </div>
        <div class="role-cta role-cta-premium">POSTULARME →</div>
      </button>

      <!-- ARTISTA -->
      <button class="role-card role-artista" data-role="artista" onclick="selectRole('artista')">
        <div class="role-glow"></div>
        <div class="role-icon">🎤</div>
        <h2 class="role-name">ARTISTA</h2>
        <p class="role-label">Músico / Creador</p>
        <p class="role-desc">Sube tu música, hazte visible, participa en batallas y conecta con la escena underground.</p>
        <div class="role-perks">
          <span>🎶 Música</span>
          <span>⚔️ Batallas</span>
          <span>📈 Perfil</span>
        </div>
        <div class="role-cta">PUBLICAR →</div>
      </button>
    </div>

    <div class="mt-10 text-center">
      <p class="text-[10px] font-black uppercase tracking-widest text-white/40">
        ¿Ya tienes una cuenta? <a href="/login" class="text-wild-orange hover:text-white transition-colors">Inicia sesión</a>
      </p>
    </div>
  </div>
</div>

<!-- ==================== STEP 2: GVNGSTER FORM ==================== -->
<div id="step-wildones" class="register-container hidden">
  <div class="form-wrapper">
    <button class="back-btn" onclick="goBack()">← VOLVER</button>
    <div class="form-header">
      <div class="role-icon-lg">🔥</div>
    <h2 class="form-title">ÚNETE A LOS <span class="text-wild-orange">WILD ONES</span></h2>
    <p class="form-subtitle">Crea tu cuenta de miembro</p>
    </div>

    <form id="form-wildones" class="register-form space-y-5">
      <input type="hidden" name="role" value="fan" />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="space-y-2">
          <label class="field-label">Nombre Completo</label>
          <input type="text" name="fullName" placeholder="Tu nombre" class="field-input" required />
        </div>
        <div class="space-y-2">
          <label class="field-label">Usuario</label>
          <input type="text" name="username" placeholder="@usuario" class="field-input" />
        </div>
      </div>

      <div class="space-y-2">
        <label class="field-label">Correo Electrónico</label>
        <input type="email" name="email" placeholder="tu@email.com" class="field-input" required />
      </div>

      <div class="space-y-2">
        <label class="field-label">Teléfono</label>
        <input type="tel" name="phone" placeholder="+52 55 0000 0000" class="field-input" />
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="space-y-2">
          <label class="field-label">Contraseña</label>
          <input type="password" name="password" placeholder="••••••••" class="field-input" required />
        </div>
        <div class="space-y-2">
          <label class="field-label">Confirmar</label>
          <input type="password" name="confirmPassword" placeholder="••••••••" class="field-input" required />
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="space-y-2">
          <label class="field-label">Ubicación</label>
          <select name="location" class="field-input cursor-pointer">
            <option value="" class="bg-[#111]">País</option>
            <option value="MX" class="bg-[#111]">🇲🇽 México</option>
            <option value="ES" class="bg-[#111]">🇪🇸 España</option>
            <option value="CO" class="bg-[#111]">🇨🇴 Colombia</option>
            <option value="AR" class="bg-[#111]">🇦🇷 Argentina</option>
          </select>
        </div>
        <div class="space-y-2">
          <label class="field-label">Nacimiento</label>
          <input type="date" name="birthdate" class="field-input" />
        </div>
      </div>

      <div class="space-y-3 pt-2">
        <label class="checkbox-label">
          <input type="checkbox" name="terms" class="hidden" required />
          <div class="check-box"><div class="check-mark"></div></div>
          <span>Acepto los <a href="/terminos" class="text-wild-orange hover:underline">términos y condiciones</a></span>
        </label>
        <label class="checkbox-label">
          <input type="checkbox" name="newsletter" class="hidden" />
          <div class="check-box"><div class="check-mark"></div></div>
          <span>Recibir noticias y lanzamientos</span>
        </label>
      </div>

      <button type="submit" class="submit-btn submit-wildones">
        UNIRME A LA CREW
      </button>

      <div class="relative my-6">
        <div class="absolute inset-0 flex items-center"><div class="w-full border-t border-white/5"></div></div>
        <div class="relative flex justify-center text-[10px] font-black uppercase tracking-[0.2em]"><span class="bg-[#111] px-4 text-white/20">o regístrate con</span></div>
      </div>

      <button type="button" class="social-btn google-btn" id="google-wildones">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" class="text-white">
          <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
          <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
          <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
          <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
        </svg>
        <span class="text-[10px] font-black uppercase tracking-widest text-white">Google</span>
      </button>
    </form>
  </div>
</div>

<!-- ==================== STEP 2: ARTISTA FORM ==================== -->
<div id="step-artista" class="register-container hidden">
  <div class="form-wrapper">
    <button class="back-btn" onclick="goBack()">← VOLVER</button>
    <div class="form-header">
      <div class="role-icon-lg">🎤</div>
      <h2 class="form-title">REGISTRO <span class="text-red-500">ARTISTA</span></h2>
      <p class="form-subtitle">Crea tu perfil de artista y empieza a publicar</p>
    </div>

    <form id="form-artista" class="register-form space-y-5">
      <input type="hidden" name="role" value="artist" />

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="space-y-2">
          <label class="field-label">Nombre Artístico</label>
          <input type="text" name="stageName" placeholder="Tu nombre en escena" class="field-input" required />
        </div>
        <div class="space-y-2">
          <label class="field-label">Nombre Real</label>
          <input type="text" name="fullName" placeholder="Tu nombre completo" class="field-input" required />
        </div>
      </div>

      <div class="space-y-2">
        <label class="field-label">Usuario</label>
        <input type="text" name="username" placeholder="@usuario" class="field-input" />
      </div>

      <div class="space-y-2">
        <label class="field-label">Correo Electrónico</label>
        <input type="email" name="email" placeholder="tu@email.com" class="field-input" required />
      </div>

      <div class="space-y-2">
        <label class="field-label">Teléfono</label>
        <input type="tel" name="phone" placeholder="+52 55 0000 0000" class="field-input" />
      </div>

      <div class="space-y-2">
        <label class="field-label">Género Musical</label>
        <div class="flex flex-wrap gap-2">
          <label class="genre-chip"><input type="checkbox" name="genres" value="rap" class="hidden" /><span>Rap</span></label>
          <label class="genre-chip"><input type="checkbox" name="genres" value="trap" class="hidden" /><span>Trap</span></label>
          <label class="genre-chip"><input type="checkbox" name="genres" value="reggaeton" class="hidden" /><span>Reggaetón</span></label>
          <label class="genre-chip"><input type="checkbox" name="genres" value="freestyle" class="hidden" /><span>Freestyle</span></label>
          <label class="genre-chip"><input type="checkbox" name="genres" value="rnb" class="hidden" /><span>R&B</span></label>
          <label class="genre-chip"><input type="checkbox" name="genres" value="otro" class="hidden" /><span>Otro</span></label>
        </div>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="space-y-2">
          <label class="field-label">Contraseña</label>
          <input type="password" name="password" placeholder="••••••••" class="field-input" required />
        </div>
        <div class="space-y-2">
          <label class="field-label">Confirmar</label>
          <input type="password" name="confirmPassword" placeholder="••••••••" class="field-input" required />
        </div>
      </div>

      <div class="space-y-2">
        <label class="field-label">Ubicación</label>
        <select name="location" class="field-input cursor-pointer">
          <option value="" class="bg-[#111]">País</option>
          <option value="MX" class="bg-[#111]">🇲🇽 México</option>
          <option value="ES" class="bg-[#111]">🇪🇸 España</option>
          <option value="CO" class="bg-[#111]">🇨🇴 Colombia</option>
          <option value="AR" class="bg-[#111]">🇦🇷 Argentina</option>
        </select>
      </div>

      <div class="space-y-2">
        <label class="field-label">Links (opcional)</label>
        <input type="text" name="socialLinks" placeholder="Instagram, YouTube, Spotify..." class="field-input" />
      </div>

      <div class="space-y-3 pt-2">
        <label class="checkbox-label">
          <input type="checkbox" name="terms" class="hidden" required />
          <div class="check-box"><div class="check-mark"></div></div>
          <span>Acepto los <a href="/terminos" class="text-wild-orange hover:underline">términos y condiciones</a></span>
        </label>
      </div>

      <button type="submit" class="submit-btn submit-artista">
        CREAR PERFIL DE ARTISTA
      </button>
    </form>
  </div>
</div>

<!-- ==================== STEP 2: STAFF / SPONSOR FORM ==================== -->
<div id="step-staff" class="register-container hidden">
  <div class="form-wrapper form-wrapper-premium">
    <button class="back-btn" onclick="goBack()">← VOLVER</button>
    <div class="form-header">
      <div class="role-badge-lg">⭐ EXCLUSIVO</div>
      <div class="role-icon-lg">🤝</div>
      <h2 class="form-title">ÚNETE AL <span class="text-yellow-400">EQUIPO</span></h2>
      <p class="form-subtitle">Staff, patrocinadores y colaboradores</p>
    </div>

    <form id="form-staff" class="register-form space-y-5">
      <input type="hidden" name="role" value="staff" />

      <div class="space-y-2">
        <label class="field-label">¿Cómo te llamas?</label>
        <input type="text" name="fullName" placeholder="Tu nombre completo" class="field-input" required />
      </div>

      <div class="space-y-2">
        <label class="field-label">Correo Electrónico</label>
        <input type="email" name="email" placeholder="tu@empresa.com" class="field-input" required />
      </div>

      <div class="space-y-2">
        <label class="field-label">¿Qué buscas?</label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
          <label class="staff-option">
            <input type="radio" name="staffType" value="staff" class="hidden" required />
            <div class="staff-option-card">
              <span class="text-2xl">🛠</span>
              <span class="font-black text-xs uppercase tracking-wider">Staff</span>
              <span class="text-[9px] text-white/40">Únete al equipo de trabajo</span>
            </div>
          </label>
          <label class="staff-option">
            <input type="radio" name="staffType" value="sponsor" class="hidden" />
            <div class="staff-option-card">
              <span class="text-2xl">💰</span>
              <span class="font-black text-xs uppercase tracking-wider">Patrocinador</span>
              <span class="text-[9px] text-white/40">Apoya proyectos y eventos</span>
            </div>
          </label>
          <label class="staff-option">
            <input type="radio" name="staffType" value="collab" class="hidden" />
            <div class="staff-option-card">
              <span class="text-2xl">🤝</span>
              <span class="font-black text-xs uppercase tracking-wider">Colaborador</span>
              <span class="text-[9px] text-white/40">Aliados y creadores de contenido</span>
            </div>
          </label>
          <label class="staff-option">
            <input type="radio" name="staffType" value="media" class="hidden" />
            <div class="staff-option-card">
              <span class="text-2xl">📸</span>
              <span class="font-black text-xs uppercase tracking-wider">Medios</span>
              <span class="text-[9px] text-white/40">Prensa, podcasts, canales</span>
            </div>
          </label>
        </div>
      </div>

      <div class="space-y-2">
        <label class="field-label">Empresa / Organización (opcional)</label>
        <input type="text" name="company" placeholder="Nombre de tu empresa o proyecto" class="field-input" />
      </div>

      <div class="space-y-2">
        <label class="field-label">Cuéntanos sobre ti / tu propuesta</label>
        <textarea name="bio" rows="3" placeholder="¿Qué puedes aportar? ¿Qué te gustaría hacer con Wild Gvng?" class="field-input resize-none"></textarea>
      </div>

      <div class="space-y-2">
        <label class="field-label">Contraseña</label>
        <input type="password" name="password" placeholder="••••••••" class="field-input" required />
      </div>

      <div class="space-y-3 pt-2">
        <label class="checkbox-label">
          <input type="checkbox" name="terms" class="hidden" required />
          <div class="check-box"><div class="check-mark"></div></div>
          <span>Acepto los <a href="/terminos" class="text-wild-orange hover:underline">términos y condiciones</a></span>
        </label>
      </div>

      <button type="submit" class="submit-btn submit-staff">
        ENVIAR SOLICITUD
      </button>
    </form>
  </div>
</div>

<!-- ==================== STEP 3: CONFIRMACIÓN ==================== -->
<div id="step-confirm" class="register-container hidden">
  <div class="form-wrapper text-center">
    <div class="confirm-icon">✅</div>
    <h2 class="text-3xl font-black tracking-tighter text-white uppercase mb-4">¡Listo!</h2>
    <p class="text-white/60 font-bold text-sm mb-2" id="confirm-msg">Tu cuenta ha sido creada.</p>
    <p class="text-white/40 text-xs mb-8">Revisa tu correo para confirmar tu cuenta.</p>
    <a href="/login" class="submit-btn submit-wildones inline-block">IR A INICIAR SESIÓN</a>
  </div>
</div>

<style>
  /* ===== CONTAINER ===== */
  .register-container {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 80px 20px;
    background: #000;
    position: relative;
    overflow-x: hidden;
  }
  .register-container::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 20% 80%, rgba(201, 131, 0, 0.12) 0%, transparent 50%),
      radial-gradient(circle at 80% 20%, rgba(138, 3, 3, 0.12) 0%, transparent 50%);
    pointer-events: none;
  }
  .hidden { display: none !important; }

  /* ===== SELECT STEP ===== */
  .select-wrapper {
    max-width: 1000px;
    width: 100%;
    position: relative;
    z-index: 1;
  }
  .select-title {
    text-align: center;
    font-size: 2.5rem;
    font-weight: 900;
    color: #fff;
    letter-spacing: -0.05em;
    text-transform: uppercase;
    margin: 24px 0 8px;
    font-family: 'Inter', sans-serif;
  }
  .select-subtitle {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 48px;
  }

  /* ===== CARDS GRID ===== */
  .cards-grid {
    display: grid;
    grid-template-columns: 1fr 1.15fr 1fr;
    gap: 24px;
    align-items: start;
  }
  @media (max-width: 768px) {
    .cards-grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  /* ===== ROLE CARD ===== */
  .role-card {
    position: relative;
    background: rgba(17,17,17,0.9);
    border: 1px solid var(--border-faint);
    border-radius: 24px;
    padding: 40px 28px 32px;
    text-align: center;
    cursor: pointer;
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    overflow: hidden;
    font-family: inherit;
  }
  .role-card:hover {
    transform: translateY(-8px) scale(1.02);
  }

  .role-glow {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.5s;
    border-radius: 24px;
    pointer-events: none;
  }
  .role-card:hover .role-glow { opacity: 1; }

  .role-wildones .role-glow {
    background: radial-gradient(circle at 50% 0%, rgba(201,131,0,0.15) 0%, transparent 70%);
  }
  .role-wildones { border-color: rgba(201,131,0,0.15); }
  .role-wildones:hover { border-color: rgba(201,131,0,0.5); box-shadow: 0 20px 60px -15px rgba(201,131,0,0.2); }

  .role-staff {
    border-color: rgba(250,204,21,0.2);
	    background: var(--bg-card);
    padding-top: 48px;
    margin-top: -16px;
    z-index: 2;
  }
  .role-glow-premium {
    background: radial-gradient(circle at 50% 0%, rgba(250,204,21,0.12) 0%, transparent 70%);
  }
  .role-staff:hover { border-color: rgba(250,204,21,0.5); box-shadow: 0 20px 60px -15px rgba(250,204,21,0.15); }

  .role-artista .role-glow {
    background: radial-gradient(circle at 50% 0%, rgba(239,68,68,0.15) 0%, transparent 70%);
  }
  .role-artista { border-color: rgba(239,68,68,0.15); }
  .role-artista:hover { border-color: rgba(239,68,68,0.5); box-shadow: 0 20px 60px -15px rgba(239,68,68,0.2); }

  .role-badge {
    position: absolute;
    top: 12px;
    left: 50%;
    transform: translateX(-50%);
    background: linear-gradient(135deg, #facc15, #f59e0b);
    color: #000;
    font-size: 0.55rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    padding: 4px 14px;
    border-radius: 100px;
  }
  .role-icon { font-size: 3rem; margin-bottom: 16px; display: block; }
  .role-name {
    font-size: 1.5rem;
    font-weight: 900;
    color: #fff;
    letter-spacing: 0.1em;
    margin: 0 0 4px;
  }
  .role-label {
    font-size: 0.65rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.2em;
    color: var(--text-muted);
    margin: 0 0 16px;
  }
  .role-desc {
    font-size: 0.8rem;
    color: var(--text-muted);
    line-height: 1.6;
    margin: 0 0 20px;
  }
  .role-perks {
    display: flex;
    justify-content: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .role-perks span {
    font-size: 0.6rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    padding: 5px 10px;
    border-radius: 100px;
    background: var(--bg-card);
    color: var(--text-muted);
  }
  .role-cta {
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.2em;
    padding: 12px;
    border-radius: 14px;
    transition: all 0.3s;
  }
  .role-wildones .role-cta { background: rgba(201,131,0,0.15); color: #C98300; }
  .role-wildones:hover .role-cta { background: #C98300; color: #000; }

  .role-cta-premium { background: rgba(250,204,21,0.15); color: #facc15; }
  .role-staff:hover .role-cta-premium { background: linear-gradient(135deg, #facc15, #f59e0b); color: #000; }

  .role-artista .role-cta { background: rgba(239,68,68,0.15); color: #ef4444; }
  .role-artista:hover .role-cta { background: #ef4444; color: #fff; }

  /* ===== FORM STEP ===== */
  .form-wrapper {
    background: rgba(17,17,17,0.95);
    border: 1px solid var(--border-faint);
    border-radius: 32px;
    padding: 48px 40px;
    max-width: 560px;
    width: 100%;
    backdrop-filter: blur(20px);
    box-shadow: 0 40px 100px -20px rgba(0,0,0,0.8);
