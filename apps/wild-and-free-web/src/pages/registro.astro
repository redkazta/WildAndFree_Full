  .check-mark {
    width: 10px;
    height: 10px;
    background: #C98300;
    border-radius: 3px;
    opacity: 0;
    transition: opacity 0.2s;
  }
  input:checked + div .check-mark { opacity: 1; }
  input:checked + .check-box { border-color: #C98300; }

  /* ===== SUBMIT BUTTONS ===== */
  .submit-btn {
    width: 100%;
    padding: 16px;
    border: none;
    border-radius: 16px;
    font-size: 0.7rem;
    font-weight: 900;
    letter-spacing: 0.25em;
    cursor: pointer;
    transition: all 0.3s;
    text-transform: uppercase;
    font-family: inherit;
  }
  .submit-wildones {
    background: #C98300;
    color: #000;
  }
  .submit-wildones:hover {
    background: #e69500;
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(201,131,0,0.3);
  }
  .submit-artista {
    background: #ef4444;
    color: #fff;
  }
  .submit-artista:hover {
    background: #dc2626;
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(239,68,68,0.3);
  }
  .submit-staff {
    background: linear-gradient(135deg, #facc15, #f59e0b);
    color: #000;
  }
  .submit-staff:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 30px rgba(250,204,21,0.25);
  }

  /* ===== SOCIAL ===== */
  .social-btn {
    width: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 14px;
    background: var(--bg-card);
    border: 1px solid var(--bg-hover);
    border-radius: 14px;
    cursor: pointer;
    transition: all 0.2s;
    font-family: inherit;
  }
  .social-btn:hover {
    background: var(--bg-hover);
    border-color: var(--border-soft);
  }

  /* ===== CONFIRM ===== */
  .confirm-icon {
    font-size: 4rem;
    margin-bottom: 16px;
  }

  /* ===== ANIMATIONS ===== */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .role-card {
    animation: fadeUp 0.6s ease-out backwards;
  }
  .role-card:nth-child(1) { animation-delay: 0.1s; }
  .role-card:nth-child(2) { animation-delay: 0.2s; }
  .role-card:nth-child(3) { animation-delay: 0.3s; }
</style>

<script>
  import { supabase } from '../lib/supabase'
  import { ensureProfile } from '../lib/profile.js'

  function showStep(step: string) {
    document.querySelectorAll('.register-container').forEach(el => el.classList.add('hidden'))
    const target = document.getElementById(`step-${step}`)
    if (target) {
      target.classList.remove('hidden')
      target.style.animation = 'fadeUp 0.4s ease-out'
    }
  }

  // @ts-ignore
  window.selectRole = function(role: string) {
    showStep(role)
  }

  // @ts-ignore
  window.goBack = function() {
    showStep('select')
  }

  // ===== Handle all three forms =====
  document.querySelectorAll('.register-form').forEach(form => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault()
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement | null
      const roleInput = form.querySelector('input[name="role"]') as HTMLInputElement
      const role = roleInput?.value

      const fd = new FormData(form as HTMLFormElement)
      const email = (fd.get('email') as string || '').trim()
      const password = fd.get('password') as string || ''
      const fullName = (fd.get('fullName') as string || '').trim()
      const username = (fd.get('username') as string || '').trim()
      const phone = (fd.get('phone') as string || '').trim()
      const location = fd.get('location') as string || ''
      const birthdate = fd.get('birthdate') as string || ''

      if (!email || !password || !fullName) {
        alert('Completa nombre, correo y contraseña.')
        return
      }

      if (btn) {
        btn.disabled = true
        btn.textContent = 'CREANDO...'
      }

      try {
        const meta: Record<string, any> = {
          nombre: fullName,
          role: role,
          username: username || null,
          phone: phone || null,
          ubicacion: location || 'Torreón Coahuila',
          birthdate: birthdate || null,
        }

        // Extra fields per role
        if (role === 'artista') {
          const stageName = (fd.get('stageName') as string || '').trim()
          const genres = fd.getAll('genres') as string[]
          const socialLinks = (fd.get('socialLinks') as string || '').trim()
          meta.stage_name = stageName || fullName
          meta.genres = genres
          meta.social_links = socialLinks || null
        }

        if (role === 'staff') {
          const staffType = fd.get('staffType') as string || ''
          const company = (fd.get('company') as string || '').trim()
          const bio = (fd.get('bio') as string || '').trim()
          meta.staff_type = staffType
          meta.company = company || null
          meta.application_bio = bio || null
        }

        const { data, error } = await supabase.auth.signUp({
          email,
          password,
          options: {
            data: meta,
            emailRedirectTo: `${window.location.origin}/auth/callback`
          }
        })

        if (error) {
          alert(error.message)
          if (btn) { btn.disabled = false; btn.textContent = role === 'staff' ? 'ENVIAR SOLICITUD' : role === 'artista' ? 'CREAR PERFIL DE ARTISTA' : 'UNIRME A LA CREW' }
          return
        }

        if (data?.session) await ensureProfile(data.session)

        const confirmMsg = document.getElementById('confirm-msg')
        if (role === 'staff') {
          confirmMsg.textContent = 'Tu solicitud ha sido enviada. Te contactaremos pronto.'
        } else if (role === 'artista') {
          confirmMsg.textContent = 'Tu perfil de artista ha sido creado. Revisa tu correo para confirmar.'
        } else {
          confirmMsg.textContent = 'Bienvenido a los Wild Ones. Revisa tu correo para confirmar.'
        }
        showStep('confirm')
      } catch (err) {
        alert('Error inesperado. Intenta de nuevo.')
        if (btn) { btn.disabled = false; btn.textContent = role === 'staff' ? 'ENVIAR SOLICITUD' : role === 'artista' ? 'CREAR PERFIL DE ARTISTA' : 'UNIRME A LA CREW' }
      }
    })
  })

  // Google OAuth for Wild Ones
  const googleBtn = document.getElementById('google-wildones')
  if (googleBtn) {
    googleBtn.addEventListener('click', async () => {
      const { error } = await supabase.auth.signInWithOAuth({
        provider: 'google',
        options: { redirectTo: `${window.location.origin}/auth/callback` }
      })
      if (error) alert(error.message)
    })
  }

  // Genre chip toggle
  document.querySelectorAll('.genre-chip').forEach(chip => {
    chip.addEventListener('click', () => {
      const input = chip.querySelector('input') as HTMLInputElement
      if (input) input.checked = !input.checked
    })
  })
</script>
