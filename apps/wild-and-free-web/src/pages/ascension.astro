---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Ascensión",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};

const ascencionSteps = [
    {
        title: "ROOKIE",
        subtitle: "NIVEL 1",
        description: "El primer paso en el asfalto. Demuestra tu valía en las plazas locales y gana tus primeras batallas.",
        requirements: ["Ganar 3 batallas locales", "Tener perfil verificado"],
        icon: "🎤",
        color: "text-gray-400"
    },
    {
        title: "UNDERDOG",
        subtitle: "NIVEL 2",
        description: "Ya no eres un desconocido. Empiezas a hacer ruido y los veteranos te miran con respeto.",
        requirements: ["Top 8 en Torneo Regional", "100 Puntos de Liga"],
        icon: "🔥",
        color: "text-orange-400"
    },
    {
        title: "CONTENDER",
        subtitle: "NIVEL 3",
        description: "Estás a un paso de las grandes ligas. Tus rimas son letales y tu nombre pesa.",
        requirements: ["Ganar Torneo Regional", "300 Puntos de Liga"],
        icon: "⚔️",
        color: "text-red-500"
    },
    {
        title: "LEYENDA",
        subtitle: "NIVEL 4",
        description: "La cima de la cadena alimenticia. Solo los elegidos llegan aquí.",
        requirements: ["Campeón Nacional", "1000+ Puntos"],
        icon: "👑",
        color: "text-yellow-400"
    }
];

const nextEvents = [
    { title: "MICRO ABIERTO: PLAZA MAYOR", date: "15 MAR", time: "18:00", type: "Rookie" },
    { title: "TORNEO RELÁMPAGO: EL BÚNKER", date: "22 MAR", time: "20:00", type: "Underdog" },
];
---

<Layout config={config}>
  <div class="min-h-screen bg-[#050505] text-white pb-32 font-sans selection:bg-[var(--wild-orange)] selection:text-black">
    
    <!-- Background Texture -->
    <div class="fixed inset-0 bg-[url('https://www.transparenttextures.com/patterns/cubes.png')] opacity-10 pointer-events-none"></div>

    <div class="container mx-auto px-4 py-20 max-w-[1400px] relative z-10 animate-fade-in-up">
      
      <!-- HEADER -->
      <div class="text-center mb-20 space-y-4">
          <div class="inline-flex items-center gap-2 border border-white/20 px-4 py-1.5 rounded-full bg-white/5 backdrop-blur">
              <span class="w-2 h-2 bg-green-500 rounded-full animate-pulse"></span>
              <span class="text-[10px] font-black uppercase tracking-[0.2em] text-gray-300">Inscripciones Abiertas</span>
          </div>
          <h1 class="text-6xl md:text-9xl font-black uppercase tracking-tighter leading-none text-white">
              Ascen<span class="text-transparent bg-clip-text bg-gradient-to-r from-[var(--wild-orange)] to-yellow-500">sión</span>
          </h1>
          <p class="text-xl md:text-2xl text-gray-400 font-bold uppercase tracking-wide max-w-2xl mx-auto">
              El camino hacia la gloria empieza en el suelo. Sube de nivel, gana respeto y conquista la liga.
          </p>
      </div>

      <!-- STEPS / LADDER -->
      <div class="relative">
          <!-- Line connector (Desktop) -->
          <div class="hidden md:block absolute left-1/2 top-0 bottom-0 w-1 bg-gradient-to-b from-gray-800 via-[var(--wild-orange)] to-yellow-500 transform -translate-x-1/2 rounded-full opacity-30"></div>

          <div class="space-y-12 md:space-y-24">
              {ascencionSteps.map((step, i) => (
                  <div class={`flex flex-col md:flex-row items-center gap-8 ${i % 2 === 0 ? 'md:flex-row-reverse' : ''}`}>
                      
                      <!-- Content Box -->
                      <div class="w-full md:w-5/12">
                          <div class="group bg-[#111] border border-white/10 p-8 rounded-3xl hover:border-[var(--wild-orange)] transition-all duration-500 hover:-translate-y-2 shadow-2xl relative overflow-hidden">
                              <div class="absolute top-0 right-0 p-4 opacity-10 text-9xl font-black grayscale group-hover:grayscale-0 transition-all select-none">
                                  {step.icon}
                              </div>
                              
                              <div class="relative z-10">
                                  <span class={`text-xs font-black uppercase tracking-[0.3em] ${step.color} mb-2 block`}>{step.subtitle}</span>
                                  <h3 class="text-4xl font-black uppercase text-white mb-4 group-hover:text-[var(--wild-orange)] transition-colors">{step.title}</h3>
                                  <p class="text-gray-400 font-medium leading-relaxed mb-6 border-l-2 border-white/10 pl-4 group-hover:border-[var(--wild-orange)] transition-colors">
                                      {step.description}
                                  </p>
                                  
                                  <div class="bg-black/40 rounded-xl p-4 border border-white/5">
                                      <h4 class="text-[10px] font-black uppercase text-gray-500 mb-3 tracking-widest">Requisitos para Ascender</h4>
                                      <ul class="space-y-2">
                                          {step.requirements.map(req => (
                                              <li class="flex items-center gap-2 text-sm text-gray-300">
                                                  <svg class="w-4 h-4 text-[var(--wild-orange)]" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                                  {req}
                                              </li>
                                          ))}
                                      </ul>
                                  </div>
                              </div>
                          </div>
                      </div>

                      <!-- Center Icon (Desktop) -->
                      <div class="hidden md:flex w-2/12 justify-center relative">
                          <div class="w-16 h-16 bg-[#0a0a0a] border-4 border-[var(--wild-orange)] rounded-full flex items-center justify-center text-2xl z-10 shadow-[0_0_20px_var(--wild-orange)]">
                              {i + 1}
                          </div>
                      </div>

                      <!-- Spacer for alternate side -->
                      <div class="hidden md:block w-5/12"></div>
                  </div>
              ))}
          </div>
      </div>

      <!-- CTA / INSCRIPCIONES -->
      <div class="mt-32">
          <div class="bg-gradient-to-br from-[var(--wild-orange)] to-red-600 rounded-3xl p-12 md:p-20 text-center relative overflow-hidden group">
              <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20 mix-blend-overlay"></div>
              
              <div class="relative z-10 max-w-3xl mx-auto space-y-8">
                  <h2 class="text-4xl md:text-6xl font-black uppercase text-white leading-none drop-shadow-lg">
                      ¿Tienes lo que se necesita?
                  </h2>
                  <p class="text-xl text-white/90 font-bold max-w-xl mx-auto">
                      Las inscripciones para la liga de ascenso están abiertas. Regístrate ahora y empieza tu camino.
                  </p>
                  
                  <div class="flex flex-col md:flex-row gap-4 justify-center pt-4">
                      <button class="px-10 py-5 bg-white text-black font-black uppercase tracking-widest text-sm rounded-xl hover:scale-105 transition-transform shadow-2xl">
                          Registrarme Ahora
                      </button>
                      <button class="px-10 py-5 bg-black/20 border border-white/30 text-white font-black uppercase tracking-widest text-sm rounded-xl hover:bg-black/40 transition-colors">
                          Ver Reglamento
                      </button>
                  </div>
              </div>

              <!-- Upcoming Events Mini -->
              <div class="mt-12 pt-8 border-t border-white/20 grid grid-cols-1 md:grid-cols-2 gap-4 max-w-2xl mx-auto text-left relative z-10">
                  {nextEvents.map(event => (
                      <div class="bg-black/20 p-4 rounded-xl flex justify-between items-center backdrop-blur-sm">
                          <div>
                              <h4 class="text-sm font-black text-white uppercase">{event.title}</h4>
                              <p class="text-xs text-white/70 font-mono mt-1">{event.date} • {event.time}</p>
                          </div>
                          <span class="text-[10px] font-black uppercase bg-white text-black px-2 py-1 rounded">{event.type}</span>
                      </div>
                  ))}
              </div>
          </div>
      </div>

    </div>
  </div>
</Layout>

<style is:global define:vars={{ streetAccent: tenant.primary_color }}>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
</style>
