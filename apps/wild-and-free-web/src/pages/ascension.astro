---
import Layout from '../layouts/Layout.astro';
import tenantConfig from '../../../../packages/shared-types/tenant-config.json';

const tenant = tenantConfig['wild-and-free'];
const config = {
  name: "Wild Gvng - Ascensión (Final de Campeones)",
  primary_color: tenant.primary_color,
  secondary_color: tenant.secondary_color
};

const participants = [
    { name: "MC LÃSER", from: "Liga del Desierto", date: "15 ENE 2026", image: "https://images.unsplash.com/photo-1570295999919-56ceb5ecca61?w=400&q=80" },
    { name: "D-MENTE", from: "Batalla del Puente", date: "20 ENE 2026", image: "https://images.unsplash.com/photo-1535713875002-d1d0cf377fde?w=400&q=80" },
    { name: "K-ROAD", from: "Reyes del Parque", date: "02 FEB 2026", image: "https://images.unsplash.com/photo-1527980965255-d3b416303d12?w=400&q=80" },
    { name: "ZIKO", from: "Underground Bars", date: "05 FEB 2026", image: "https://images.unsplash.com/photo-1633332755192-727a05c4013d?w=400&q=80" },
    { name: "VENOM", from: "Sangre Nueva", date: "10 FEB 2026", image: "https://images.unsplash.com/photo-1500648767791-00dcc994a43e?w=400&q=80" },
    { name: "BLAZE", from: "Fuego Cruzado", date: "12 FEB 2026", image: "https://images.unsplash.com/photo-1531384441138-2736e62e0919?w=400&q=80" },
    { name: "FROST", from: "El Heladero", date: "14 FEB 2026", image: "https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?w=400&q=80" },
    { name: "SHADOW", from: "Noche de Sombras", date: "18 FEB 2026", image: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=400&q=80" },
    { name: "IRON", from: "Acero Puro", date: "20 FEB 2026", image: "https://images.unsplash.com/photo-1599566150163-29194dcaad36?w=400&q=80" },
    { name: "SOUL", from: "Alma Mater", date: "22 FEB 2026", image: "https://images.unsplash.com/photo-1542909168-82c3e7fdca5c?w=400&q=80" },
    { name: "RAPTOR", from: "Jurásico Flow", date: "25 FEB 2026", image: "https://images.unsplash.com/photo-1522075469751-3a3694c2dd77?w=400&q=80" },
    { name: "NOVA", from: "Estrella Fugaz", date: "28 FEB 2026", image: "https://images.unsplash.com/photo-1586297135537-94bc9ba060aa?w=400&q=80" },
    { name: "ECLIPSE", from: "Oscuridad Total", date: "01 MAR 2026", image: "https://images.unsplash.com/photo-1607990281513-2c110a25bd8c?w=400&q=80" },
    { name: "VIPER", from: "Veneno Puro", date: "03 MAR 2026", image: "https://images.unsplash.com/photo-1500917293891-ef795e70e1f6?w=400&q=80" },
    { name: "STORM", from: "Tormenta Perfecta", date: "05 MAR 2026", image: "https://images.unsplash.com/photo-1566492031773-4f4e44671857?w=400&q=80" },
    { name: "CYBER", from: "Futuro Remoto", date: "08 MAR 2026", image: "https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?w=400&q=80" },
];
---

<Layout config={config}>
  <div class="min-h-screen bg-black text-white pb-32 font-sans selection:bg-wild-orange selection:text-black">
    
    <!-- Header -->
    <div class="relative py-20 overflow-hidden border-b border-white/10">
        <div class="absolute inset-0 bg-[url('https://www.transparenttextures.com/patterns/carbon-fibre.png')] opacity-20"></div>
        <div class="absolute inset-0 bg-gradient-to-b from-black/80 to-black"></div>
        
        <div class="container mx-auto px-4 relative z-10 text-center">
            <span class="inline-block border border-wild-orange text-wild-orange text-label-sm font-black uppercase px-3 py-1 rounded mb-4 tracking-widest">
                Torneo de Campeones
            </span>
            <h1 class="text-6xl md:text-9xl font-black uppercase tracking-tighter leading-none text-white mb-6">
                ASCENSIÓN <span class="text-transparent bg-clip-text bg-gradient-to-r from-wild-orange to-wild-red">FINAL</span>
            </h1>
            <p class="text-xl text-gray-400 font-medium max-w-2xl mx-auto uppercase tracking-widest">
                16 Guerreros. 1 Solo Trono. La élite del freestyle se reúne aquí.
            </p>
        </div>
    </div>

    <!-- The 16 Roster Grid -->
    <div class="container mx-auto px-4 py-16 max-w-wide animate-fade-in-up">
        
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
            {participants.map((mc, i) => (
                <div class="group relative bg-neutral-950 border border-white/10 hover:border-wild-orange rounded-wild-lg overflow-hidden transition-all duration-500 hover:-translate-y-2 hover:shadow-wild-glow-lg">
                    
                    <!-- Number Badge -->
                    <div class="absolute top-4 right-4 z-20 font-black text-4xl text-white/5 group-hover:text-wild-orange/20 transition-colors pointer-events-none">
                        {(i + 1).toString().padStart(2, '0')}
                    </div>

                    <!-- Image Container -->
                    <div class="relative h-64 overflow-hidden">
                        <img src={mc.image} width="400" height="400" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 group-hover:scale-110" />
                        <div class="absolute inset-0 bg-gradient-to-t from-black via-black/20 to-transparent opacity-90 group-hover:opacity-60 transition-opacity"></div>
                        
                        <!-- Name Overlay -->
                        <div class="absolute bottom-0 left-0 p-6 w-full">
                            <h3 class="text-3xl font-black text-white uppercase italic tracking-tighter leading-none mb-1 group-hover:text-wild-orange transition-colors">
                                {mc.name}
                            </h3>
                            <div class="h-1 w-8 bg-wild-orange transform origin-left scale-x-0 group-hover:scale-x-100 transition-transform duration-300"></div>
                        </div>
                    </div>

                    <!-- Info -->
                    <div class="p-6 pt-4 bg-neutral-950 border-t border-white/5 relative">
                        <div class="space-y-3">
                            <div>
                                <p class="text-label-sm font-black text-gray-500 uppercase tracking-widest mb-1">Clasificado en</p>
                                <p class="text-xs font-bold text-white uppercase">{mc.from}</p>
                            </div>
                            <div class="flex justify-between items-center pt-2 border-t border-white/5">
                                <span class="text-label-sm font-mono text-gray-600 uppercase">{mc.date}</span>
                                <span class="w-2 h-2 bg-green-500 rounded-full shadow-[0_0_10px_rgba(34,197,94,0.5)] animate-pulse"></span>
                            </div>
                        </div>
                    </div>

                </div>
            ))}
        </div>

    </div>

    <!-- Footer CTA -->
    <div class="container mx-auto px-4 pb-20 text-center">
        <div class="inline-flex flex-col items-center gap-4 p-8 border border-white/10 rounded-wild-lg bg-white/5 backdrop-blur">
            <p class="text-xs font-bold text-gray-400 uppercase tracking-widest">El evento comienza en</p>
            <div class="text-4xl font-mono font-black text-wild-orange">
                04:12:33:59
            </div>
            <button class="mt-4 px-8 py-3 bg-white text-black font-black uppercase text-xs tracking-widest rounded-wild hover:bg-wild-orange transition-colors">
                Comprar Entradas
            </button>
        </div>
    </div>

  </div>
</Layout>

<style is:global define:vars={{ streetAccent: tenant.primary_color }}>
  @keyframes fadeInUp {
    from { opacity: 0; transform: translateY(40px); }
    to { opacity: 1; transform: translateY(0); }
  }
  .animate-fade-in-up {
    animation: fadeInUp 0.8s cubic-bezier(0.2, 0.8, 0.2, 1) forwards;
  }
</style>
