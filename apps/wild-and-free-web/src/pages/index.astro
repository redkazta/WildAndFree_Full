// Mock data for events
const events = [
  {
    id: 'e1',
    title: 'Wild Gvng Live',
    date: '2024-02-15',
    location: 'Club Underground',
    description: 'Noche de beats y líricas crudas con nuestros artistas principales.',
  },
  {
    id: 'e2',
