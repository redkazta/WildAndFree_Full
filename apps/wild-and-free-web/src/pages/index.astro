---

<Layout config={config}>
	<Hero crewName={config.name} />
	
	<main class="max-w-7xl mx-auto px-6 space-y-32 md:space-y-48 pb-32">
		<!-- Historia Section -->
		<section id="wild-and-free" class="relative group overflow-hidden rounded-3xl bg-gradient-to-br from-white/[0.03] to-transparent border border-white/5 p-8 md:p-16">
			<div class="absolute top-0 right-0 -mr-20 -mt-20 w-80 h-80 bg-orange-500/10 blur-[100px] rounded-full group-hover:bg-orange-500/20 transition-colors duration-700"></div>
			<div class="relative grid md:grid-cols-2 gap-12 items-center">
				<div class="space-y-6">
					<div class="inline-block px-4 py-1.5 rounded-full bg-orange-500/10 border border-orange-500/20 text-orange-500 text-xs font-bold uppercase tracking-widest">
						La liga original
					</div>
					<h2 class="text-4xl md:text-6xl font-black tracking-tighter leading-none">
						WILD <span class="text-transparent bg-clip-text bg-gradient-to-r from-orange-500 to-red-600">AND FREE</span>
					</h2>
					<div class="space-y-4 text-lg text-white font-bold leading-relaxed">
						<p>El movimiento que inició todo. WILD AND FREE no es solo un nombre, es una filosofía de vida que representa libertad absoluta, autenticidad cruda y resistencia contra lo establecido.</p>
						<p>Desde los primeros beats en los sótanos hasta los escenarios más grandes, mantenemos viva la esencia del underground.</p>
					</div>
				</div>
				<div class="relative group aspect-square rounded-2xl overflow-hidden shadow-2xl shadow-black/50">
					<img src="https://images.unsplash.com/photo-1493225255756-d9584f8606e9?auto=format&fit=crop&w=800&q=80" alt="WILD AND FREE" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-700 scale-105 group-hover:scale-100" loading="lazy" />
					<div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-60 group-hover:opacity-20 transition-opacity"></div>
				</div>
			</div>
		</section>

		<!-- Artistas Section -->
		<section id="artists" class="space-y-12 md:space-y-16 pt-20">
			<div class="flex flex-col md:flex-row items-center md:items-end justify-between border-b border-white/10 pb-8 gap-6">
				<div class="space-y-2 text-center md:text-left">
					<h2 class="text-4xl md:text-6xl font-black tracking-tighter text-white uppercase">NUESTRA CREW</h2>
					<p class="text-orange-500 font-black uppercase tracking-[0.3em] text-[10px] md:text-xs">Los rostros que lideran el asfalto</p>
				</div>
				<a href="/artistas" class="group flex items-center gap-2 text-white font-black uppercase tracking-[0.2em] text-[10px] hover:text-orange-500 transition-all">
					Ver todos <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
				</a>
			</div>
			<div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 md:gap-8">
				{artists.map((artist) => (
					<ArtistCard artist={artist} />
				))}
			</div>
		</section>

		<!-- Música Section -->
		<section id="music" class="space-y-12 md:space-y-16">
			<div class="flex flex-col md:flex-row items-center md:items-end justify-between border-b border-white/10 pb-8 gap-6">
				<div class="space-y-2 text-center md:text-left">
					<h2 class="text-4xl md:text-6xl font-black tracking-tighter text-white uppercase">ÚLTIMOS LANZAMIENTOS</h2>
					<p class="text-orange-500 font-black uppercase tracking-[0.3em] text-[10px] md:text-xs">Los beats que definen la cultura</p>
				</div>
				<a href="/musica" class="group flex items-center gap-2 text-white font-black uppercase tracking-[0.2em] text-[10px] hover:text-orange-500 transition-all">
					Ver música <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
				</a>
			</div>
			<MusicGrid tracks={tracks} />
		</section>

		<!-- Video Destacado -->
		<section id="featured-video" class="relative rounded-3xl overflow-hidden aspect-video group cursor-pointer shadow-2xl">
			<img src="https://images.unsplash.com/photo-1493225255756-d9584f8606e9?auto=format&fit=crop&w=1200&q=80" alt="Video Preview" class="w-full h-full object-cover grayscale group-hover:grayscale-0 group-hover:scale-105 transition-all duration-1000" />
			<div class="absolute inset-0 bg-black/60 group-hover:bg-black/40 transition-colors flex flex-col items-center justify-center gap-6">
				<div class="w-24 h-24 rounded-full bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center group-hover:scale-110 group-hover:bg-orange-500 transition-all duration-500">
					<svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor" class="text-white group-hover:text-black transform translate-x-1"><path d="M8 5v14l11-7z"/></svg>
				</div>
				<div class="text-center space-y-2">
					<h3 class="text-2xl font-black tracking-widest uppercase text-white">Video Oficial</h3>
					<p class="text-orange-500 font-black uppercase tracking-widest text-sm">Último lanzamiento visual</p>
				</div>
			</div>
		</section>

		<!-- Eventos Section -->
		<section id="events" class="space-y-12 md:space-y-16">
			<div class="flex flex-col md:flex-row items-center md:items-end justify-between border-b border-white/5 pb-8 gap-6">
				<div class="space-y-2 text-center md:text-left">
					<h2 class="text-4xl md:text-6xl font-black tracking-tighter text-white uppercase">PRÓXIMAS FECHAS</h2>
					<p class="text-orange-500 font-black uppercase tracking-widest text-[10px] md:text-sm">Donde el movimiento cobra vida</p>
				</div>
				<a href="/eventos" class="group flex items-center gap-2 text-orange-500 font-bold uppercase tracking-widest text-[10px] md:text-xs hover:text-white transition-colors">
					Ver todos
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover:translate-x-1 transition-transform"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
				</a>
			</div>
			<EventsList events={events} />
		</section>

		<!-- Shop Section -->
		<section id="shop" class="space-y-12 md:space-y-16">
			<div class="flex flex-col md:flex-row items-center md:items-end justify-between border-b border-white/5 pb-8 gap-6">
				<div class="space-y-2 text-center md:text-left">
					<h2 class="text-4xl md:text-6xl font-black tracking-tighter text-white uppercase">MERCH OFICIAL</h2>
					<p class="text-orange-500 font-black uppercase tracking-widest text-[10px] md:text-sm">Viste el movimiento</p>
				</div>
				<a href="/tienda" class="group flex items-center gap-2 text-orange-500 font-bold uppercase tracking-widest text-[10px] md:text-xs hover:text-white transition-colors">
					Ver tienda
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="transform group-hover:translate-x-1 transition-transform"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
				</a>
			</div>
			<ShopGrid products={products} />
		</section>

		<!-- CTA Section -->
		<section id="login" class="relative rounded-[3rem] overflow-hidden bg-white py-24 px-8 text-black text-center group">
			<div class="absolute inset-0 bg-[radial-gradient(circle_at_center,_var(--tw-gradient-stops))] from-orange-500/20 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-1000"></div>
			<div class="relative max-w-2xl mx-auto space-y-8">
				<h2 class="text-5xl md:text-7xl font-black tracking-tighter leading-none text-black">ÚNETE A LA CREW</h2>
				<p class="text-lg md:text-xl font-black text-black">Acceso exclusivo a drops, tickets y contenido detrás de escenas.</p>
				<div class="flex flex-wrap gap-4 justify-center">
					<a href="/registro" class="px-10 py-4 bg-black text-white text-xs font-black uppercase tracking-[0.2em] rounded-2xl hover:bg-orange-600 transition-all shadow-2xl">Registrarse Ahora</a>
				</div>
			</div>
		</section>
	</main>

	<Footer />
</Layout>

<style>
	/* Eliminamos los estilos antiguos para usar Tailwind puro */
</style>
