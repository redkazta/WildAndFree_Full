---
import Welcome from '../components/Welcome.astro';
import Layout from '../layouts/Layout.astro';

type HealthStatus = {
  status: string;
  engine: string;
  crew: string;
  timestamp: string;
};

let health: HealthStatus | null = null;

try {
  const res = await fetch('http://localhost:3000/gateway/health');
  if (res.ok) health = (await res.json()) as HealthStatus;
} catch {
  health = null;
}
---

<Layout>
	<h1>Service Health</h1>
	<p>Status: {health?.status ?? 'unavailable'}</p>
	<p>Engine: {health?.engine ?? 'unavailable'}</p>
	<p>Crew: {health?.crew ?? 'unavailable'}</p>
	<Welcome />
</Layout>
