    title: 'Sin Reglas',
    artist: 'Nova K',
    duration: '3:24',
    cover_url: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?auto=format&fit=crop&w=400&q=80',
  },
  {
