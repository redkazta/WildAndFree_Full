---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ArtistGrid from '../components/ArtistGrid.astro';
import MusicGrid from '../components/MusicGrid.astro';
import EventsList from '../components/EventsList.astro';
import ShopGrid from '../components/ShopGrid.astro';
import SectionHeader from '../components/SectionHeader.astro';
import Footer from '../components/Footer.astro';

import ArtistCard from '../components/ArtistCard.astro';

type Artist = {
  id: string;
  name: string;
  role: string;
  image_url: string;
};

type TenantConfig = {
  id: string;
  name: string;
  primary_color: string;
  secondary_color: string;
  modules: Record<string, boolean>;
};

type GatewayConfigResponse = {
  tenant_id: string;
  config: TenantConfig;
  data: { crew_name: string; artists: Artist[] };
};

let gatewayConfig: GatewayConfigResponse | null = null;

try {
  const res = await fetch('http://localhost:3000/gateway/config');
  if (res.ok) gatewayConfig = (await res.json()) as GatewayConfigResponse;
} catch {
  gatewayConfig = null;
}

const config: TenantConfig = gatewayConfig?.config ?? {
  id: 'wild-and-free',
  name: 'Wild Gvng',
  primary_color: 'rgb(201, 131, 0)',
  secondary_color: 'rgb(138, 3, 3)',
  modules: { wallet: true, events: true },
};

const artists: Artist[] = gatewayConfig?.data.artists ?? [
  {
    id: 'a1',
    name: 'Nova K',
    role: 'Rapero',
    image_url: 'https://images.unsplash.com/photo-1520975958221-7f61d4d6df4b?auto=format&fit=crop&w=800&q=80',
