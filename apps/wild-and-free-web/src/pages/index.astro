    image_url: 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=800&q=80',
  },
  {
    id: 'a4',
    name: 'Echo',
    role: 'DJ',
    image_url: 'https://images.unsplash.com/photo-1589578236639-5381345b6687?auto=format&fit=crop&w=800&q=80',
  },
];

// Mock data for music tracks
const tracks = [
  {
