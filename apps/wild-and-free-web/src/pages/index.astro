---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import MusicGrid from '../components/MusicGrid.astro';
import EventsList from '../components/EventsList.astro';
import ShopGrid from '../components/ShopGrid.astro';
import Footer from '../components/Footer.astro';

import ArtistCard from '../components/ArtistCard.astro';

type Artist = {
  id: string;
  name: string;
  role: string;
  image_url: string;
  stats?: {
    seguidores: string;
    oyentes: string;
  };
};

type TenantConfig = {
  id: string;
  name: string;
  primary_color: string;
  secondary_color: string;
  modules: Record<string, boolean>;
};

type GatewayConfigResponse = {
  tenant_id: string;
  config: TenantConfig;
  data: { crew_name: string; artists: Artist[] };
};

let gatewayConfig: GatewayConfigResponse | null = null;

try {
  const res = await fetch('http://localhost:3000/gateway/config');
  if (res.ok) gatewayConfig = (await res.json()) as GatewayConfigResponse;
} catch {
  gatewayConfig = null;
}

const config: TenantConfig = gatewayConfig?.config ?? {
  id: 'wild-and-free',
  name: 'Wild Gvng',
  primary_color: 'rgb(201, 131, 0)',
  secondary_color: 'rgb(138, 3, 3)',
  modules: { wallet: true, events: true },
};

const artists: Artist[] = gatewayConfig?.data.artists ?? [
  {
    id: 'a1',
    name: 'Nova K',
    role: 'Rapero',
    image_url: 'https://images.unsplash.com/photo-1520975958221-7f61d4d6df4b?auto=format&fit=crop&w=800&q=80',
    stats: { seguidores: '2.4M', oyentes: '850K' }
  },
  {
    id: 'a2',
    name: 'Sable',
    role: 'Productor',
    image_url: 'https://images.unsplash.com/photo-1520975693413-35e0000c0e4e?auto=format&fit=crop&w=800&q=80',
    stats: { seguidores: '1.2M', oyentes: '400K' }
  },
  {
    id: 'a3',
    name: 'Mira V',
    role: 'Rapera',
    image_url: 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=800&q=80',
    stats: { seguidores: '1.8M', oyentes: '600K' }
  },
  {
    id: 'a4',
    name: 'Echo',
    role: 'DJ',
    image_url: 'https://images.unsplash.com/photo-1589578236639-5381345b6687?auto=format&fit=crop&w=800&q=80',
    stats: { seguidores: '950K', oyentes: '300K' }
  },
];

const tracks = [
  {
    id: 't1',
    title: 'Sin Reglas',
    artist: 'Nova K',
    duration: '3:24',
    cover_url: 'https://images.unsplash.com/photo-1493225457124-a3eb161ffa5f?auto=format&fit=crop&w=400&q=80',
  },
  {
    id: 't2',
    title: 'Sueños de Medianoche',
    artist: 'Sable',
    duration: '4:12',
    cover_url: 'https://images.unsplash.com/photo-1571019613454-1cb2f99b2d8b?auto=format&fit=crop&w=400&q=80',
  },
  {
    id: 't3',
    title: 'Luces de Calle',
    artist: 'Mira V',
    duration: '2:58',
    cover_url: 'https://images.unsplash.com/photo-1514320291840-2e0a9bf2a9ae?auto=format&fit=crop&w=400&q=80',
  },
  {
    id: 't4',
    title: 'Underground',
    artist: 'Echo',
    duration: '3:45',
    cover_url: 'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=400&q=80',
  },
];

const events = [
  {
    id: 'e1',
    title: 'Wild Night CDMX',
    date: '15 MAR 2024',
    location: { nombre: 'Foro Indie Rocks', ciudad: 'CDMX' },
    status: 'disponible',
    tickets: {
      precio_min: 450,
      tipos: [
        { nombre: 'General', precio: 450, stock: 200 },
        { nombre: 'VIP', precio: 950, stock: 50 }
      ]
    },
    image_url: 'https://images.unsplash.com/photo-1470225620780-dba8ba36b745?auto=format&fit=crop&w=800&q=80',
  },
  {
    id: 'e2',
    title: 'Urban Fest GDL',
    date: '22 MAR 2024',
    location: { nombre: 'C3 Stage', ciudad: 'Guadalajara' },
    status: 'proximo',
    tickets: { precio_min: 350, tipos: [] },
    image_url: 'https://images.unsplash.com/photo-1459749411177-042180ce673c?auto=format&fit=crop&w=800&q=80',
  },
  {
    id: 'e3',
    title: 'Drill Sessions TRC',
    date: '05 ABR 2024',
    location: { nombre: 'Teatro Nazas', ciudad: 'Torreón' },
    status: 'disponible',
    tickets: { precio_min: 250, tipos: [] },
    image_url: 'https://images.unsplash.com/photo-1514525253361-bee871871771?auto=format&fit=crop&w=800&q=80',
  },
  {
    id: 'e4',
    title: 'Underground Gala',
    date: '12 ABR 2024',
    location: { nombre: 'Estudio 404', ciudad: 'CDMX' },
    status: 'disponible',
    tickets: { precio_min: 600, tipos: [] },
    image_url: 'https://images.unsplash.com/photo-1501386761578-eac5c94b800a?auto=format&fit=crop&w=800&q=80',
  }
];

const products = [
  {
    id: 'p1',
    name: 'Sudadera Wild Gvng',
    description: 'Sudadera premium de algodón con bordado de alta densidad. Diseñada para resistir la calle.',
    price_base: 45,
    image_url: 'https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&w=400&q=80',
    atributos: {
      tallas: ['S', 'M', 'L', 'XL'],
      colores: [{ nombre: 'Negro', hex: '#000' }, { nombre: 'Gris', hex: '#888' }]
    }
  },
  {
    id: 'p2',
    name: 'Gorra Logo',
    description: 'Gorra snapback clásica con el logo oficial en relieve.',
    price_base: 25,
    image_url: 'https://images.unsplash.com/photo-1588850561407-ed78c282e89b?auto=format&fit=crop&w=400&q=80',
    atributos: {
      tallas: ['Única'],
      colores: [{ nombre: 'Negro', hex: '#000' }]
    }
  },
  {
    id: 'p3',
    name: 'Jersey Oficial 2026',
    description: 'Edición limitada del jersey de la crew. Tejido transpirable de alto rendimiento.',
    price_base: 65,
    image_url: 'https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=400&q=80',
    atributos: {
      tallas: ['M', 'L', 'XL'],
      colores: [{ nombre: 'Naranja/Negro', hex: '#C98300' }]
    }
  },
  {
    id: 'p4',
    name: 'Beanie Street',
    description: 'Gorro de punto suave para las noches de graffiti y calle.',
    price_base: 20,
    image_url: 'https://images.unsplash.com/photo-1576871337632-b9aef4c17ab9?auto=format&fit=crop&w=400&q=80',
    atributos: {
      tallas: ['Única'],
      colores: [{ nombre: 'Negro', hex: '#000' }, { nombre: 'Rojo', hex: '#8A0303' }]
    }
  },
  {
    id: 'p5',
    name: 'Tote Bag Crew',
    description: 'Bolsa de tela resistente con el manifiesto de la gvng.',
    price_base: 15,
    image_url: 'https://images.unsplash.com/photo-1597484661643-2f5fef640dd1?auto=format&fit=crop&w=400&q=80',
    atributos: {
      tallas: ['Única'],
      colores: [{ nombre: 'Crudo', hex: '#F5F5F5' }]
    }
  },
  {
    id: 'p6',
    name: 'Windbreaker Pro',
    description: 'Rompevientos ligero y repelente al agua para el tour.',
    price_base: 85,
    image_url: 'https://images.unsplash.com/photo-1591047139829-d91aecb6caea?auto=format&fit=crop&w=400&q=80',
    atributos: {
      tallas: ['S', 'M', 'L'],
      colores: [{ nombre: 'Negro Mate', hex: '#111' }]
    }
  }
];
---

<Layout config={config}>
	<Hero crewName={config.name} />

	<!-- Marquee Ticker -->
	<div class="overflow-hidden bg-wild-orange py-4 border-y border-black/20">
		<div class="flex whitespace-nowrap animate-marquee">
			{Array(6).fill(null).map(() => (
				<span class="text-black font-black uppercase tracking-[0.3em] text-sm md:text-base mx-8 flex items-center gap-8">
					<span>Wild Gvng</span>
					<span class="w-2 h-2 bg-black rounded-full"></span>
					<span>Libertad Absoluta</span>
					<span class="w-2 h-2 bg-black rounded-full"></span>
					<span>Underground</span>
					<span class="w-2 h-2 bg-black rounded-full"></span>
					<span>Drill Sessions</span>
					<span class="w-2 h-2 bg-black rounded-full"></span>
					<span>La Liga Original</span>
					<span class="w-2 h-2 bg-black rounded-full"></span>
				</span>
			))}
		</div>
	</div>

	<main class="max-w-7xl mx-auto px-4 sm:px-6 space-y-20 md:space-y-48 pb-20 md:pb-32">
		<!-- Stats Banner -->
		<section class="grid grid-cols-2 md:grid-cols-4 gap-3 md:gap-6 -mt-10 md:-mt-16 relative z-10">
			{[
				{ num: '50+', label: 'Tracks' },
				{ num: '12+', label: 'Artistas' },
				{ num: '2.4M', label: 'Seguidores' },
				{ num: '15+', label: 'Eventos' },
			].map((stat) => (
				<div class="group bg-[#111] border border-white/10 rounded-wild-xl p-4 md:p-8 text-center hover:border-wild-orange/30 transition-all duration-500 hover:-translate-y-1">
					<div class="text-2xl md:text-4xl font-black text-white group-hover:text-wild-orange transition-colors">{stat.num}</div>
					<div class="text-label-sm font-black uppercase tracking-widest text-white/40 mt-1 md:mt-2">{stat.label}</div>
				</div>
			))}
		</section>

		<!-- Historia Section -->
		<section id="wild-and-free" class="relative group overflow-hidden rounded-wild-xl border border-white/10">
			<div class="absolute inset-0 bg-gradient-to-br from-white/[0.03] to-transparent"></div>
			<div class="absolute top-0 right-0 -mr-32 -mt-32 w-[500px] h-[500px] bg-wild-orange/10 blur-[150px] rounded-full group-hover:bg-wild-orange/20 transition-colors duration-1000"></div>
			<div class="absolute bottom-0 left-0 -ml-32 -mb-32 w-[400px] h-[400px] bg-wild-red/5 blur-[120px] rounded-full group-hover:bg-wild-red/10 transition-colors duration-1000"></div>
			<div class="relative grid md:grid-cols-2 gap-0">
				<div class="p-6 md:p-16 flex flex-col justify-center space-y-5 md:space-y-8">
					<div class="inline-flex items-center gap-3 px-3 md:px-4 py-1.5 md:py-2 rounded-full bg-wild-orange/10 border border-wild-orange/20 text-wild-orange text-label-sm md:text-xs font-black uppercase tracking-widest w-fit">
						<span class="relative flex h-2 w-2">
							<span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-wild-orange opacity-75"></span>
							<span class="relative inline-flex rounded-full h-2 w-2 bg-wild-orange"></span>
						</span>
						La liga original
					</div>
					<h2 class="text-4xl md:text-7xl font-black tracking-tighter leading-[0.9]">
						WILD<br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-wild-orange via-wild-red to-wild-orange bg-[length:200%_auto] animate-gradient-shift">AND FREE</span>
					</h2>
					<div class="space-y-3 md:space-y-4 text-base md:text-lg text-white font-bold leading-relaxed">
						<p class="border-l-2 border-wild-orange pl-4 md:pl-6">El movimiento que inició todo. WILD AND FREE no es solo un nombre, es una filosofía de vida que representa libertad absoluta, autenticidad cruda y resistencia contra lo establecido.</p>
						<p class="border-l-2 border-white/20 pl-4 md:pl-6">Desde los primeros beats en los sótanos hasta los escenarios más grandes, mantenemos viva la esencia del underground.</p>
					</div>
					<a href="#artists" class="group/link inline-flex items-center gap-2 md:gap-3 text-wild-orange font-black uppercase tracking-widest text-xs md:text-sm hover:text-white transition-colors w-fit">
						Conoce la crew
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="group-hover/link:translate-x-1 transition-transform"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
					</a>
				</div>
				<div class="relative aspect-[16/9] md:aspect-auto overflow-hidden">
					<img src="https://images.unsplash.com/photo-1493225255756-d9584f8606e9?auto=format&fit=crop&w=800&q=80" alt="WILD AND FREE" width="800" height="1000" class="w-full h-full object-cover grayscale group-hover:grayscale-0 transition-all duration-1000 scale-105 group-hover:scale-100" loading="lazy" />
					<div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent md:bg-gradient-to-t md:from-black/60 md:via-transparent md:to-transparent"></div>
					<div class="absolute bottom-6 md:bottom-8 left-6 md:left-8 right-6 md:right-8">
						<div class="flex items-center gap-3 md:gap-4">
							<div class="w-10 h-10 md:w-12 md:h-12 rounded-full bg-wild-orange flex items-center justify-center">
								<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="text-black"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
							</div>
							<div>
								<div class="text-label-sm font-black uppercase tracking-widest text-white/60">Est.</div>
								<div class="text-xl md:text-2xl font-black text-white">2024</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</section>

		<!-- Artistas Section -->
		<section id="artists" class="space-y-8 md:space-y-16 pt-12 md:pt-20">
			<div class="flex flex-col md:flex-row items-center md:items-end justify-between border-b border-white/10 pb-6 md:pb-8 gap-4 md:gap-6">
				<div class="space-y-2 md:space-y-3 text-center md:text-left">
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-label-sm font-black uppercase tracking-widest text-white/60">Crew 2024</div>
					<h2 class="text-4xl md:text-7xl font-black tracking-tighter text-white uppercase leading-none">NUESTRA<br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-wild-orange to-wild-red">CREW</span></h2>
					<p class="text-white/40 font-black uppercase tracking-[0.2em] md:tracking-[0.3em] text-label-sm max-w-md">Los rostros que lideran el asfalto y definen el sonido del underground</p>
				</div>
				<a href="/artistas" class="group flex items-center gap-2 md:gap-3 px-5 md:px-6 py-2.5 md:py-3 bg-white/5 border border-white/10 rounded-full text-white font-black uppercase tracking-[0.2em] text-label-sm hover:bg-wild-orange hover:border-wild-orange hover:text-black transition-all duration-300">
					Ver todos
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
				</a>
			</div>
			<div class="grid grid-cols-2 sm:grid-cols-2 lg:grid-cols-4 gap-4 md:gap-8">
				{artists.map((artist, i) => (
					<div class="group relative" style={`animation-delay: ${i * 100}ms`}>
						<ArtistCard artist={artist} />
					</div>
				))}
			</div>
		</section>

		<!-- Música Section -->
		<section id="music" class="space-y-8 md:space-y-16">
			<div class="flex flex-col md:flex-row items-center md:items-end justify-between border-b border-white/10 pb-6 md:pb-8 gap-4 md:gap-6">
				<div class="space-y-2 md:space-y-3 text-center md:text-left">
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-wild-orange/10 border border-wild-orange/20 text-label-sm font-black uppercase tracking-widest text-wild-orange">Nuevos Beats</div>
					<h2 class="text-4xl md:text-7xl font-black tracking-tighter text-white uppercase leading-none">ÚLTIMOS<br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-wild-orange to-wild-red">LANZAMIENTOS</span></h2>
					<p class="text-white/40 font-black uppercase tracking-[0.2em] md:tracking-[0.3em] text-label-sm max-w-md">Los beats que definen la cultura urbana</p>
				</div>
				<a href="/musica" class="group flex items-center gap-2 md:gap-3 px-5 md:px-6 py-2.5 md:py-3 bg-white/5 border border-white/10 rounded-full text-white font-black uppercase tracking-[0.2em] text-label-sm hover:bg-wild-orange hover:border-wild-orange hover:text-black transition-all duration-300">
					Ver música
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
				</a>
			</div>
			<MusicGrid tracks={tracks} />
		</section>

		<!-- Video Destacado -->
		<section id="featured-video" class="relative rounded-wild-xl overflow-hidden aspect-video group cursor-pointer">
			<img src="https://images.unsplash.com/photo-1493225255756-d9584f8606e9?auto=format&fit=crop&w=1200&q=80" alt="Video Preview" width="1200" height="675" class="w-full h-full object-cover grayscale group-hover:grayscale-0 scale-105 group-hover:scale-110 transition-all duration-[2000ms]" />
			<div class="absolute inset-0 bg-gradient-to-t from-black via-black/50 to-black/20 group-hover:from-black/80 group-hover:via-black/40 group-hover:to-black/10 transition-all duration-700"></div>
			<div class="absolute inset-0 flex flex-col items-center justify-center gap-4 md:gap-8 px-4">
				<div class="relative">
					<div class="absolute inset-0 rounded-full bg-wild-orange/30 blur-xl scale-150 animate-pulse"></div>
					<div class="relative w-16 h-16 md:w-28 md:h-28 rounded-full bg-white/10 backdrop-blur-xl border border-white/20 flex items-center justify-center group-hover:bg-wild-orange group-hover:border-wild-orange transition-all duration-500 group-hover:scale-110">
						<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" class="text-white group-hover:text-black transform translate-x-0.5 transition-colors md:translate-x-1"><path d="M8 5v14l11-7z"/></svg>
					</div>
				</div>
				<div class="text-center space-y-2 md:space-y-3">
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/10 border border-white/20 text-label-sm font-black uppercase tracking-widest text-white/80">Lanzamiento Visual</div>
					<h3 class="text-xl md:text-5xl font-black tracking-tighter uppercase text-white">SIN REGLAS</h3>
					<p class="text-wild-orange font-black uppercase tracking-widest text-label-sm md:text-sm">Video Oficial · Nova K</p>
				</div>
			</div>
		</section>

		<!-- Eventos Section -->
		<section id="events" class="space-y-8 md:space-y-16">
			<div class="flex flex-col md:flex-row items-center md:items-end justify-between border-b border-white/10 pb-6 md:pb-8 gap-4 md:gap-6">
				<div class="space-y-2 md:space-y-3 text-center md:text-left">
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-wild-red/10 border border-wild-red/20 text-label-sm font-black uppercase tracking-widest text-wild-red">En vivo</div>
					<h2 class="text-4xl md:text-7xl font-black tracking-tighter text-white uppercase leading-none">PRÓXIMAS<br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-wild-orange to-wild-red">FECHAS</span></h2>
					<p class="text-white/40 font-black uppercase tracking-[0.2em] md:tracking-[0.3em] text-label-sm max-w-md">Donde el movimiento cobra vida en el escenario</p>
				</div>
				<a href="/eventos" class="group flex items-center gap-2 md:gap-3 px-5 md:px-6 py-2.5 md:py-3 bg-white/5 border border-white/10 rounded-full text-white font-black uppercase tracking-[0.2em] text-label-sm hover:bg-wild-orange hover:border-wild-orange hover:text-black transition-all duration-300">
					Ver todos
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
				</a>
			</div>
			<EventsList events={events} />
		</section>

		<!-- Shop Section -->
		<section id="shop" class="space-y-8 md:space-y-16">
			<div class="flex flex-col md:flex-row items-center md:items-end justify-between border-b border-white/10 pb-6 md:pb-8 gap-4 md:gap-6">
				<div class="space-y-2 md:space-y-3 text-center md:text-left">
					<div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/5 border border-white/10 text-label-sm font-black uppercase tracking-widest text-white/60">Drop Limitado</div>
					<h2 class="text-4xl md:text-7xl font-black tracking-tighter text-white uppercase leading-none">MERCH<br/><span class="text-transparent bg-clip-text bg-gradient-to-r from-wild-orange to-wild-red">OFICIAL</span></h2>
					<p class="text-white/40 font-black uppercase tracking-[0.2em] md:tracking-[0.3em] text-label-sm max-w-md">Viste el movimiento, lleva la identidad</p>
				</div>
				<a href="/tienda" class="group flex items-center gap-2 md:gap-3 px-5 md:px-6 py-2.5 md:py-3 bg-white/5 border border-white/10 rounded-full text-white font-black uppercase tracking-[0.2em] text-label-sm hover:bg-wild-orange hover:border-wild-orange hover:text-black transition-all duration-300">
					Ver tienda
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 transition-transform"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
				</a>
			</div>
			<ShopGrid products={products} />
		</section>

		<!-- CTA Section -->
		<section id="login" class="relative rounded-wild-xl overflow-hidden border border-white/10 group">
