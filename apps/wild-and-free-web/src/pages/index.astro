---

<Layout config={config}>
	<Hero crewName={config.name} />
	
	<div class="content-separator"></div>

	<section id="wild-and-free" class="wild-free-section">
		<div class="wild-free-content">
			<SectionHeader title="WILD AND FREE" subtitle="La liga original" />
			<div class="wild-free-grid">
				<div class="wild-free-text">
					<p>El movimiento que inició todo. WILD AND FREE no es solo un nombre, es una filosofía de vida que representa libertad absoluta, autenticidad cruda y resistencia contra lo establecido.</p>
					<p>Desde los primeros beats en los sótanos hasta los escenarios más grandes, mantenemos viva la esencia del underground.</p>
				</div>
				<div class="wild-free-image">
					<img src="https://images.unsplash.com/photo-1493225255756-d9584f8606e9?auto=format&fit=crop&w=800&q=80" alt="WILD AND FREE" loading="lazy" />
				</div>
			</div>
		</div>
	</section>

	<div class="content-separator"></div>

	<section id="artistas" class="artists-section">
		<div class="artists-content">
			<SectionHeader title="Artistas" subtitle="El talento que mueve el movimiento" />
			<ArtistGrid artists={artists} />
		</div>
	</section>

	<div class="content-separator"></div>

	<section id="music" class="music-section">
		<div class="music-content">
			<SectionHeader title="Música" subtitle="Los beats que definen la cultura" />
			<MusicGrid tracks={tracks} />
		</div>
	</section>

	<div class="content-separator"></div>

	<section id="events" class="events-section">
		<div class="events-content">
			<SectionHeader title="Eventos" subtitle="Donde el movimiento cobra vida" />
			<EventsList events={events} />
		</div>
	</section>

	<div class="content-separator"></div>

	<section id="shop" class="shop-section">
		<div class="shop-content">
			<SectionHeader title="Tienda" subtitle="El estilo que representa" />
			<ShopGrid products={products} />
		</div>
	</section>

	<div class="content-separator"></div>

	<section id="about" class="about-section">
		<div class="about-content">
			<SectionHeader title="La Historia" subtitle="Quiénes somos" />
			<div class="about-grid">
				<div class="about-text">
					<p>Nacidos en el underground, forjados en el asfalto. Wild Gvng no es solo un colectivo, es un movimiento. Fusionamos trap, drill y sonidos experimentales para crear una atmósfera única que desafía lo convencional.</p>
					<p>Desde nuestros inicios en los barrios bajos hasta los escenarios más grandes, nuestra misión sigue siendo la misma: autenticidad cruda y sonido sin filtros.</p>
				</div>
				<div class="about-image">
					<img src="https://images.unsplash.com/photo-1493225255756-d9584f8606e9?auto=format&fit=crop&w=800&q=80" alt="Crew History" loading="lazy" />
				</div>
			</div>
		</div>
	</section>

	<div class="content-separator"></div>

	<section id="artists">
		<SectionHeader title="El Roster" subtitle="Conoce al equipo" />
		<ArtistGrid artists={artists} />
	</section>

	<div class="content-separator"></div>

	<section id="featured-video" class="video-section">
		<SectionHeader title="En Foco" subtitle="Último lanzamiento visual" />
		<div class="video-container">
			<div class="video-placeholder">
				<div class="play-icon">▶</div>
				<p>Reproducir Video Oficial</p>
			</div>
		</div>
	</section>

	<div class="content-separator"></div>

	<section id="music">
		<SectionHeader title="Lanzamientos" subtitle="Fresco del estudio" />
		<MusicGrid />
	</section>

	<div class="content-separator"></div>

	<section id="events">
		<SectionHeader title="Fechas Tour" subtitle="Venos en vivo" />
		<EventsList />
	</section>

	<div class="content-separator"></div>

	<section id="shop">
		<SectionHeader title="Merch Oficial" subtitle="Viste el movimiento" />
		<ShopGrid />
	</section>

	<div class="content-separator"></div>

	<section id="login" class="join-section">
		<div class="join-content">
			<h2 class="join-title">Únete a la Crew</h2>
			<p class="join-text">Acceso exclusivo a drops, tickets y contenido detrás de escenas.</p>
			<a href="/login" class="join-button">Acceso Miembros</a>
		</div>
	</section>

	<Footer />
</Layout>

<style>
	.content-separator {
		height: 1px;
		background: linear-gradient(90deg, transparent, rgba(255,255,255,0.1), transparent);
		margin: 120px 0;
	}

	.artists-section,
	.music-section,
	.events-section,
	.shop-section,
	.about-section,
	.wild-free-section {
		padding: 0 24px;
	}

	.wild-free-section {
		background: linear-gradient(135deg, rgba(0, 255, 65, 0.05) 0%, transparent 50%);
		border: 1px solid rgba(0, 255, 65, 0.1);
		border-radius: 8px;
		margin: 0 24px;
	}

	.wild-free-grid,
	.about-grid {
		display: grid;
		grid-template-columns: 1fr;
		gap: 48px;
		align-items: center;
		max-width: 1000px;
		margin: 0 auto;
		padding: 60px 0;
	}

	@media (min-width: 768px) {
		.wild-free-grid,
		.about-grid {
			grid-template-columns: 1fr 1fr;
		}
	}

	.wild-free-text p,
	.about-text p {
		color: #ccc;
		line-height: 1.8;
		margin-bottom: 24px;
		font-size: 16px;
	}

	.wild-free-image img,
	.about-image img {
		width: 100%;
		border-radius: 4px;
		filter: grayscale(100%);
		transition: filter 0.3s;
	}

	.wild-free-image img:hover,
	.about-image img:hover {
		filter: grayscale(0%);
	}

	.video-section {
		text-align: center;
	}

	.video-container {
		max-width: 1000px;
		margin: 0 auto;
		aspect-ratio: 16/9;
		background: #111;
		border: 1px solid rgba(255,255,255,0.1);
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: border-color 0.3s;
	}

	.video-container:hover {
		border-color: var(--primary-color);
	}

	.video-placeholder {
		color: rgba(255,255,255,0.5);
	}

	.play-icon {
		font-size: 48px;
		margin-bottom: 16px;
		color: var(--primary-color);
	}

	.join-section {
		padding: 100px 0;
		text-align: center;
		background: radial-gradient(circle at center, rgba(255,255,255,0.03) 0%, transparent 70%);
		border: 1px solid rgba(255,255,255,0.05);
	}

	.join-title {
		font-size: 48px;
		text-transform: uppercase;
		font-weight: 900;
		margin-bottom: 16px;
		letter-spacing: -0.03em;
	}

	.join-text {
		color: #888;
		margin-bottom: 32px;
		font-size: 18px;
	}

	.join-button {
		display: inline-block;
		padding: 16px 48px;
		background: #fff;
		color: #000;
		text-decoration: none;
		font-weight: 700;
		text-transform: uppercase;
		letter-spacing: 0.05em;
		clip-path: polygon(10px 0, 100% 0, 100% calc(100% - 10px), calc(100% - 10px) 100%, 0 100%, 0 10px);
		transition: transform 0.2s;
	}

	.join-button:hover {
		transform: scale(1.05);
	}
</style>
