---
import SidebarLeft from '../components/SidebarLeft.astro';
import ProfileModal from '../components/ProfileModal.astro';
import { sidebarStore } from '../components/sidebarStore.js';

export type Props = {
  config: {
    name: string;
    primary_color: string;
    secondary_color: string;
  };
};

const { config } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{config.name}</title>
		
		<!-- Google Fonts -->
		<link rel="preconnect" href="https://fonts.googleapis.com">
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
		<link href="https://fonts.googleapis.com/css2?family=Noto+Sans+JP:wght@400;500;700;900&display=swap" rel="stylesheet">
		
		<style>
			:root {
				--primary: {config.primary_color};
				--secondary: {config.secondary_color};
				--primary-color: {config.primary_color};
				--secondary-color: {config.secondary_color};
			}
			
			* {
				box-sizing: border-box;
				margin: 0;
				padding: 0;
			}
			
			body {
				font-family: 'Noto Sans JP', sans-serif;
				background: #111;
				color: #fff;
				line-height: 1.6;
				overflow-x: hidden;
			}
			
			/* Header Styles */
			.site-header {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				z-index: 1000;
				background: rgba(0, 0, 0, 0.95);
				backdrop-filter: blur(10px);
				border-bottom: 1px solid rgba(201, 131, 0, 0.2);
			}
			
			.header-content {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding: 16px 24px;
				max-width: 1400px;
				margin: 0 auto;
			}
			
			.header-left {
				display: flex;
				align-items: center;
				gap: 20px;
			}
			
			.header-center {
				flex: 1;
				display: flex;
				justify-content: center;
			}
			
			.header-right {
				display: flex;
				align-items: center;
				gap: 16px;
			}
			
			/* Logo */
			.logo {
				display: flex;
				flex-direction: column;
				line-height: 1;
			}
			
			.logo-text {
				display: flex;
				flex-direction: column;
				font-weight: 900;
				font-size: 24px;
				letter-spacing: 0.1em;
			}
			
			.logo-line {
				color: #fff;
				transition: all 0.3s ease;
			}
			
			.logo-line:first-child {
				color: var(--primary-color);
			}
			
			/* Navigation */
			.main-nav {
				display: flex;
				gap: 32px;
			}
			
			.nav-link {
				color: #fff;
				text-decoration: none;
				font-weight: 500;
				font-size: 14px;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				transition: all 0.2s ease;
				padding: 8px 16px;
				border-radius: 4px;
				display: flex;
				align-items: center;
				gap: 8px;
			}
			
			.nav-link:hover {
				color: var(--primary-color);
				background: rgba(201, 131, 0, 0.1);
			}
			
			.nav-icon {
				margin-right: 6px;
				opacity: 0.8;
				transition: all 0.2s ease;
			}
			
			.nav-link:hover .nav-icon {
				opacity: 1;
				transform: translateY(-1px);
			}
			
			/* Header Actions */
			.header-actions {
				display: flex;
				align-items: center;
				gap: 12px;
				position: relative;
			}
			
			.action-btn {
				background: none;
				border: none;
				color: #fff;
				cursor: pointer;
				padding: 8px;
				border-radius: 4px;
				transition: all 0.2s ease;
				position: relative;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			
			.action-btn:hover {
				color: var(--primary-color);
				background: rgba(201, 131, 0, 0.1);
			}
			
			.action-wrapper {
				position: relative;
			}
			
			.badge {
				position: absolute;
				top: -4px;
				right: -4px;
				background: var(--primary-color);
				color: #000;
				font-size: 10px;
				font-weight: 700;
				padding: 2px 6px;
				border-radius: 10px;
				min-width: 16px;
				height: 16px;
				display: flex;
				align-items: center;
				justify-content: center;
			}
			
			.login-btn {
				background: var(--primary-color);
				color: #000;
				text-decoration: none;
				padding: 10px 20px;
				border-radius: 4px;
				font-weight: 600;
				font-size: 14px;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				transition: all 0.2s ease;
			}
			
			.login-btn:hover {
				background: #fff;
				transform: translateY(-2px);
			}
			
			/* Menu Toggle */
			.menu-toggle {
				background: none;
				border: none;
				cursor: pointer;
				padding: 8px;
				display: flex;
				flex-direction: column;
				gap: 4px;
			}
			
			.hamburger-lines {
				display: flex;
				flex-direction: column;
				gap: 4px;
			}
			
			.hamburger-lines span {
				width: 20px;
				height: 2px;
				background: #fff;
				transition: all 0.3s ease;
			}
			
			.menu-toggle:hover .hamburger-lines span {
				background: var(--primary-color);
			}
			
			/* Layout Container */
			.layout-container {
				display: flex;
				min-height: 100vh;
				padding-top: 80px;
			}
			
			/* Main Content */
			main {
				flex: 1;
				padding: 24px;
				max-width: 1400px;
				margin: 0 auto;
				width: 100%;
			}
			
			.modal-footer {
				display: flex;
				gap: 10px;
				margin-top: 16px;
			}

			.btn-primary,
			.btn-secondary {
				display: inline-flex;
				align-items: center;
				justify-content: center;
				gap: 8px;
				padding: 10px 14px;
				border-radius: 8px;
				font-size: 13px;
				font-weight: 700;
				letter-spacing: 0.02em;
				text-decoration: none;
				cursor: pointer;
				transition: transform 0.15s ease, background 0.15s ease, color 0.15s ease, border-color 0.15s ease;
				white-space: nowrap;
			}

			.btn-primary {
				background: var(--primary-color);
				color: #000;
				border: 1px solid transparent;
			}

			.btn-primary:hover {
				background: #fff;
				transform: translateY(-1px);
			}

			.btn-secondary {
				background: rgba(255, 255, 255, 0.06);
				color: #fff;
				border: 1px solid rgba(255, 255, 255, 0.18);
			}

			.btn-secondary:hover {
				background: rgba(255, 255, 255, 0.1);
				border-color: rgba(255, 255, 255, 0.3);
				transform: translateY(-1px);
			}

			.wishlist-items {
				display: flex;
				flex-direction: column;
				gap: 10px;
			}

			.wishlist-item {
				display: grid;
				grid-template-columns: 44px 1fr auto;
				align-items: center;
				gap: 12px;
				padding: 10px;
				border-radius: 10px;
				border: 1px solid rgba(201, 131, 0, 0.15);
				background: rgba(255, 255, 255, 0.04);
				color: #fff;
				text-decoration: none;
				transition: background 0.15s ease, border-color 0.15s ease;
			}

			.wishlist-item:hover {
				background: rgba(201, 131, 0, 0.08);
				border-color: rgba(201, 131, 0, 0.35);
			}

			.wishlist-thumb {
				width: 44px;
				height: 44px;
				border-radius: 10px;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.12);
			}

			.wishlist-thumb img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}

			.wishlist-meta {
				min-width: 0;
			}

			.wishlist-name {
				font-size: 13px;
				font-weight: 800;
				letter-spacing: 0.02em;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			.wishlist-sub {
				font-size: 12px;
				color: rgba(255, 255, 255, 0.6);
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
				margin-top: 2px;
			}

			.wishlist-price {
				font-size: 12px;
				font-weight: 900;
				color: var(--primary-color);
			}

			.cart-items {
				display: flex;
				flex-direction: column;
				gap: 12px;
			}

			.cart-item {
				display: grid;
				grid-template-columns: 52px 1fr auto;
				gap: 12px;
				align-items: center;
				padding: 10px;
				border-radius: 10px;
				border: 1px solid rgba(255, 255, 255, 0.12);
				background: rgba(255, 255, 255, 0.04);
			}

			.cart-item-image {
				width: 52px;
				height: 52px;
				border-radius: 10px;
				overflow: hidden;
				border: 1px solid rgba(255, 255, 255, 0.12);
			}

			.cart-item-image img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				display: block;
			}

			.cart-item-info h4 {
				font-size: 13px;
				font-weight: 800;
				margin: 0 0 2px 0;
			}

			.cart-item-info p {
				font-size: 12px;
				margin: 0;
				color: rgba(255, 255, 255, 0.6);
			}

			.cart-item-info .price {
				display: inline-block;
				margin-top: 6px;
				font-size: 12px;
				font-weight: 900;
				color: var(--primary-color);
			}

			.cart-item-actions {
				display: flex;
				align-items: center;
				gap: 8px;
				font-size: 12px;
				color: rgba(255, 255, 255, 0.8);
			}

			.quantity-btn {
				width: 28px;
				height: 28px;
				border-radius: 8px;
				border: 1px solid rgba(255, 255, 255, 0.18);
				background: rgba(255, 255, 255, 0.06);
				color: #fff;
				cursor: pointer;
				transition: background 0.15s ease, border-color 0.15s ease;
			}

			.quantity-btn:hover {
				background: rgba(255, 255, 255, 0.1);
				border-color: rgba(255, 255, 255, 0.3);
			}

			.cart-total {
				margin-top: 14px;
				padding-top: 12px;
				border-top: 1px solid rgba(255, 255, 255, 0.12);
				display: flex;
				flex-direction: column;
				gap: 8px;
			}

			.total-line {
				display: flex;
				justify-content: space-between;
				font-size: 12px;
				color: rgba(255, 255, 255, 0.75);
			}

			.total-line.final {
				font-size: 13px;
				font-weight: 900;
				color: #fff;
			}
			
			/* Profile Modal Styles */
			.profile-header {
				display: flex;
				align-items: center;
				gap: 16px;
				margin-bottom: 24px;
				padding-bottom: 20px;
				border-bottom: 1px solid rgba(201, 131, 0, 0.2);
			}
			
			.profile-avatar {
				width: 64px;
				height: 64px;
				border-radius: 50%;
				overflow: hidden;
				border: 2px solid var(--primary-color);
			}
			
			.profile-avatar img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}
			
			.profile-info h4 {
				font-size: 16px;
				font-weight: 600;
				margin: 0 0 4px 0;
				color: #fff;
			}
			
			.profile-info p {
				font-size: 14px;
				color: rgba(255, 255, 255, 0.6);
				margin: 0;
			}
			
			.profile-menu {
				display: flex;
				flex-direction: column;
				gap: 8px;
			}
			
			.profile-link {
				display: flex;
				align-items: center;
				gap: 12px;
				padding: 12px 16px;
				color: #fff;
				text-decoration: none;
				border-radius: 6px;
				transition: all 0.2s ease;
				font-size: 14px;
				font-family: 'Noto Sans JP', sans-serif;
			}
			
			.profile-link:hover {
				background: rgba(201, 131, 0, 0.1);
			}
			
			/* Location Modal */
			.location-form {
				display: flex;
				flex-direction: column;
				gap: 16px;
			}
			
			.form-group {
				display: flex;
				flex-direction: column;
				gap: 8px;
			}
			
			.form-group label {
				font-size: 12px;
				color: rgba(255, 255, 255, 0.7);
				text-transform: uppercase;
				letter-spacing: 0.1em;
				font-family: 'Noto Sans JP', sans-serif;
			}
			
			.zipcode-input,
			.city-input,
			.country-select {
				background: rgba(255, 255, 255, 0.05);
				border: 1px solid rgba(201, 131, 0, 0.2);
				border-radius: 6px;
				padding: 12px 16px;
				color: #fff;
				font-family: 'Noto Sans JP', sans-serif;
				font-size: 14px;
				transition: all 0.2s;
			}
			
			.zipcode-input:focus,
			.city-input:focus,
			.country-select:focus {
				outline: none;
				border-color: var(--primary-color);
				background: rgba(201, 131, 0, 0.1);
				box-shadow: 0 0 0 2px rgba(201, 131, 0, 0.2);
			}
			
			.country-select {
				cursor: pointer;
			}
			
			.country-select option {
				background: #111;
				color: #fff;
			}
			
			.location-grid {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 12px;
			}
			
			.location-option {
				background: rgba(255, 255, 255, 0.05);
				border: 1px solid rgba(201, 131, 0, 0.2);
				border-radius: 6px;
				padding: 16px;
				color: #fff;
				cursor: pointer;
				transition: all 0.2s;
				font-family: 'Noto Sans JP', sans-serif;
				font-size: 14px;
			}
			
			.location-option:hover {
				background: rgba(201, 131, 0, 0.1);
				border-color: var(--primary-color);
			}
			
			/* Profile Modal Enhanced */
			.profile-authenticated {
				display: block;
			}
			
			.profile-guest {
				text-align: center;
				padding: 20px 0;
			}
			
			.profile-login-prompt {
				margin-bottom: 24px;
			}
			
			.profile-login-prompt h4 {
				margin: 0 0 8px 0;
				color: #fff;
				font-size: 16px;
				font-family: 'Noto Sans JP', sans-serif;
			}
			
			.profile-login-prompt p {
				margin: 0;
				color: rgba(255, 255, 255, 0.6);
				font-size: 14px;
				font-family: 'Noto Sans JP', sans-serif;
			}
			
			.profile-actions {
				display: flex;
				flex-direction: column;
				gap: 12px;
			}
			
			.profile-btn {
				width: 100%;
				text-align: center;
				text-decoration: none;
				padding: 12px 16px;
				border-radius: 6px;
				font-size: 14px;
				font-weight: 600;
				font-family: 'Noto Sans JP', sans-serif;
				transition: all 0.2s;
				text-transform: uppercase;
				letter-spacing: 0.05em;
				cursor: pointer;
			}
			
			.btn-primary.profile-btn {
				background: var(--primary-color);
				color: #000;
				border: none;
			}
			
			.btn-primary.profile-btn:hover {
				background: #fff;
				transform: translateY(-2px);
			}
			
			.btn-secondary.profile-btn {
				background: transparent;
				color: var(--primary-color);
				border: 1px solid var(--primary-color);
			}
			
			.btn-secondary.profile-btn:hover {
				background: var(--primary-color);
				color: #000;
			}
			
			.logout-btn {
				width: 100%;
				padding: 12px 16px;
				background: rgba(255, 255, 255, 0.05);
				border: 1px solid rgba(255, 255, 255, 0.3);
				color: rgba(255, 255, 255, 0.7);
				border-radius: 6px;
				font-size: 14px;
				font-weight: 600;
				font-family: 'Noto Sans JP', sans-serif;
				cursor: pointer;
				transition: all 0.2s;
				text-transform: uppercase;
				letter-spacing: 0.05em;
			}
			
			.logout-btn:hover {
				background: rgba(255, 255, 255, 0.1);
				color: #fff;
				border-color: #fff;
			}
			
			/* Responsive */
			@media (max-width: 768px) {
				.header-center {
					display: none;
				}
				
				.header-content {
					padding: 12px 16px;
				}
				
				.main-nav {
					flex-direction: column;
					gap: 16px;
				}
				
				.modal {
					min-width: 280px;
					padding: 20px;
				}
			}
		</style>
		<style is:global>
			.modal-overlay {
				position: fixed;
				inset: 0;
				background: rgba(0, 0, 0, 0.8);
				backdrop-filter: blur(5px);
				z-index: 2000;
				opacity: 0;
				visibility: hidden;
				transition: all 0.3s ease;
			}

			.modal-overlay.active {
				opacity: 1;
				visibility: visible;
			}

			.modal {
				position: fixed;
				top: 50%;
				left: 50%;
				transform: translate(-50%, -50%) scale(0.9);
				background: #111;
				border: 1px solid rgba(201, 131, 0, 0.3);
				border-radius: 12px;
				padding: 16px;
				width: 360px;
				max-width: 92vw;
				max-height: 90vh;
				overflow-y: auto;
				z-index: 2001;
				opacity: 0;
				visibility: hidden;
				pointer-events: none;
				box-shadow: 0 18px 50px rgba(0, 0, 0, 0.55);
				transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
			}

			.modal-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				gap: 10px;
				padding-bottom: 12px;
				margin-bottom: 12px;
				border-bottom: 1px solid rgba(255, 255, 255, 0.12);
			}

			.modal-title {
				font-size: 13px;
				font-weight: 900;
				letter-spacing: 0.08em;
				text-transform: uppercase;
				margin: 0;
			}

			.modal-close {
				background: transparent;
				border: 1px solid rgba(255, 255, 255, 0.16);
				color: rgba(255, 255, 255, 0.8);
				width: 32px;
				height: 32px;
				border-radius: 10px;
				display: inline-flex;
				align-items: center;
				justify-content: center;
				cursor: pointer;
				transition: background 0.15s ease, border-color 0.15s ease, color 0.15s ease;
			}

			.modal-close:hover {
				background: rgba(255, 255, 255, 0.08);
				border-color: rgba(255, 255, 255, 0.28);
				color: #fff;
			}

			.modal-content {
				color: #fff;
			}

			.modal.active {
				opacity: 1;
				visibility: visible;
				transform: translate(-50%, -50%) scale(1);
				pointer-events: auto;
			}

			.action-wrapper .modal {
				position: absolute;
				top: calc(100% + 8px);
				right: 0;
				left: auto;
				transform: none;
				transform-origin: top right;
			}

			.action-wrapper .modal.active {
				transform: none;
			}

			@media (max-width: 768px) {
				.action-wrapper .modal {
					position: fixed;
					top: 88px;
					left: 16px;
					right: 16px;
					max-width: calc(100vw - 32px);
					width: auto;
				}
			}
		</style>
	</head>
	<body style="--primary: {config.primary_color}; --secondary: {config.secondary_color};">
		<header class="site-header">
			<div class="wrap header-content">
				<div class="header-left">
					<button class="menu-toggle" aria-label="Menú">
						<div class="hamburger-lines">
							<span></span>
							<span></span>
							<span></span>
						</div>
					</button>
					<div class="logo">
						<div class="logo-text">
							<span class="logo-line">WILD</span>
							<span class="logo-line">GVNG</span>
						</div>
					</div>
				</div>
				
				<div class="header-center">
					<nav class="main-nav">
						<a href="/artistas" class="nav-link">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="nav-icon">
								<path d="M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z"/>
							</svg>
							Artistas
						</a>
						<a href="/musica" class="nav-link">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="nav-icon">
								<path d="M12 3v10.55c-.59-.34-1.27-.55-2-.55-2.21 0-4 1.79-4 4s1.79 4 4 4 4-1.79 4-4V7h4V3h-6z"/>
							</svg>
							Música
						</a>
						<a href="/eventos" class="nav-link">
							<svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" class="nav-icon">
