		<!-- Modal Overlay -->
		<div class="modal-overlay" id="modal-overlay"></div>
		
		<script>
			// Handle menu toggle for sidebar
			document.addEventListener('DOMContentLoaded', () => {
				const menuToggle = document.querySelector('.menu-toggle');
				if (menuToggle) {
					menuToggle.addEventListener('click', () => {
						// Toggle sidebar using the global sidebarStore
						if (window.sidebarStore) {
							window.sidebarStore.toggle();
						}
					});
				}

				// Handle header action buttons
				const locationBtn = document.querySelector('.location-btn');
				const wishlistBtn = document.querySelector('.wishlist-btn');
				const cartBtn = document.querySelector('.cart-btn');
				const profileBtn = document.querySelector('.profile-btn');

				// Modal system
				const modalOverlay = document.getElementById('modal-overlay');
				const modals = document.querySelectorAll('.modal');
				const modalCloseBtns = document.querySelectorAll('.modal-close');

				const isTouchDevice = window.matchMedia('(hover: none), (pointer: coarse)').matches || 'ontouchstart' in window;
				const hoverCapable = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

				const detectLocationBtn = document.querySelector('#location-modal #detect-location');
				const saveLocationBtn = document.querySelector('#location-modal #save-location');
				const zipcodeInput = document.querySelector('#location-modal #zipcode');
				const cityInput = document.querySelector('#location-modal #city');
				const countrySelect = document.querySelector('#location-modal #country');

				function syncSavedLocationToForm() {
					const savedLocation = localStorage.getItem('userLocation');
					if (!savedLocation) return;
					try {
						const location = JSON.parse(savedLocation);
						if (zipcodeInput) zipcodeInput.value = location.zipcode || '';
						if (cityInput) cityInput.value = location.city || '';
						if (countrySelect) countrySelect.value = location.country || '';
					} catch (e) {
						console.error('Error al cargar ubicación guardada:', e);
					}
				}

				function setButtonExpanded(modalId) {
					const map = {
						'location-modal': locationBtn,
						'wishlist-modal': wishlistBtn,
						'cart-modal': cartBtn,
						'profile-modal': profileBtn
					};
					Object.entries(map).forEach(([id, btn]) => {
						if (!btn) return;
						btn.setAttribute('aria-expanded', id === modalId ? 'true' : 'false');
					});
				}

				function closeAllPanels() {
					modalOverlay.classList.remove('active');
					modals.forEach(modal => {
						modal.classList.remove('active');
						modal.setAttribute('aria-hidden', 'true');
					});
					setButtonExpanded(null);
				}

				function openPanel(modalId) {
					const targetModal = document.getElementById(modalId);
					if (!targetModal) return;

					modals.forEach(modal => {
						if (modal !== targetModal) {
							modal.classList.remove('active');
							modal.setAttribute('aria-hidden', 'true');
						}
					});

					targetModal.classList.add('active');
					targetModal.setAttribute('aria-hidden', 'false');
					setButtonExpanded(modalId);
					modalOverlay.classList.remove('active');

					if (modalId === 'location-modal') {
						syncSavedLocationToForm();
					}
				}

				function togglePanel(modalId) {
					const targetModal = document.getElementById(modalId);
					if (!targetModal) return;
					if (targetModal.classList.contains('active')) {
						closeAllPanels();
						return;
					}
					openPanel(modalId);
				}

				// Modal event listeners
				if (modalOverlay) {
					modalOverlay.addEventListener('click', (e) => {
						if (e.target === modalOverlay) {
							closeAllPanels();
						}
					});
				}

				modalCloseBtns.forEach(btn => {
					btn.addEventListener('click', (e) => {
						e.preventDefault();
						closeAllPanels();
					});
				});

				[locationBtn, wishlistBtn, cartBtn, profileBtn].forEach(btn => {
					if (btn) btn.setAttribute('aria-expanded', 'false');
				});
				modals.forEach(modal => modal.setAttribute('aria-hidden', 'true'));

				function bindPanel(button, modalId) {
					if (!button) return;
					const wrapper = button.closest('.action-wrapper');
					if (!wrapper) return;

					if (hoverCapable && !isTouchDevice) {
						let leaveTimeout = null;
						wrapper.addEventListener('pointerenter', () => {
							clearTimeout(leaveTimeout);
							openPanel(modalId);
						});
						wrapper.addEventListener('pointerleave', () => {
							leaveTimeout = setTimeout(() => {
								closeAllPanels();
							}, 120);
						});
					} else {
						button.addEventListener('click', (e) => {
							e.preventDefault();
							e.stopPropagation();
							togglePanel(modalId);
						});
					}
				}

				bindPanel(locationBtn, 'location-modal');
				bindPanel(wishlistBtn, 'wishlist-modal');
				bindPanel(cartBtn, 'cart-modal');
				bindPanel(profileBtn, 'profile-modal');

				document.addEventListener('click', (e) => {
					if (!isTouchDevice) return;
					const active = document.querySelector('.modal.active');
					if (!active) return;
					if (e.target.closest('.action-wrapper')) return;
					closeAllPanels();
				});

				closeAllPanels();

				// Detectar ubicación automáticamente
				if (detectLocationBtn) {
					detectLocationBtn.addEventListener('click', () => {
						if (navigator.geolocation) {
							detectLocationBtn.textContent = 'Detectando...';
							detectLocationBtn.disabled = true;
							
							navigator.geolocation.getCurrentPosition(
								(position) => {
									// Simular datos basados en geolocalización
									console.log('Ubicación detectada:', position.coords);
									
									// Aquí normalmente harías una llamada a una API de geocoding
									// Por ahora, simularemos una ubicación
									zipcodeInput.value = '06600';
									cityInput.value = 'Ciudad de México';
									countrySelect.value = 'MX';
									
									detectLocationBtn.textContent = 'Detectar Ubicación';
									detectLocationBtn.disabled = false;
								},
								(error) => {
									console.error('Error al detectar ubicación:', error);
									alert('No se pudo detectar tu ubicación. Por favor, ingrésala manualmente.');
									detectLocationBtn.textContent = 'Detectar Ubicación';
									detectLocationBtn.disabled = false;
								}
							);
						} else {
							alert('Tu navegador no soporta geolocalización.');
						}
					});
				}

				// Guardar ubicación
				if (saveLocationBtn) {
					saveLocationBtn.addEventListener('click', () => {
						const zipcode = zipcodeInput.value.trim();
						const city = cityInput.value.trim();
						const country = countrySelect.value;
						
						if (!zipcode || !city || !country) {
							alert('Por favor, completa todos los campos.');
							return;
						}
						
						// Validar código postal (solo números para MX)
						if (country === 'MX' && !/^\d{5}$/.test(zipcode)) {
							alert('El código postal debe tener 5 dígitos.');
							return;
						}
						
						console.log('Ubicación guardada:', { zipcode, city, country });
						
						// Guardar en localStorage
						localStorage.setItem('userLocation', JSON.stringify({
							zipcode,
							city,
							country,
							timestamp: Date.now()
						}));
						
						// Actualizar el botón del header
						const locationBtn = document.querySelector('.location-btn');
						if (locationBtn) {
							locationBtn.setAttribute('title', `Ubicación: ${city}, ${country} (${zipcode})`);
						}
						
						closeAllPanels();
						alert('Ubicación guardada exitosamente.');
					});
				}

				// Función para actualizar UI según autenticación
				function updateAuthUI() {
					const isAuthenticated = localStorage.getItem('userAuth') === 'true';
					const profileAuth = document.getElementById('profile-authenticated');
					const profileGuest = document.getElementById('profile-guest');
					const loginBtn = document.querySelector('.login-btn');
					
					if (isAuthenticated) {
						// Mostrar perfil autenticado
						if (profileAuth) profileAuth.style.display = 'block';
						if (profileGuest) profileGuest.style.display = 'none';
						if (loginBtn) loginBtn.style.display = 'none';
						
						// Cargar datos del perfil
						const userProfile = JSON.parse(localStorage.getItem('userProfile') || '{}');
						const profileName = document.getElementById('profile-name');
						const profileEmail = document.getElementById('profile-email');
						const profileAvatar = document.getElementById('profile-avatar');
						
						if (profileName) profileName.textContent = userProfile.name || 'Usuario Wild';
						if (profileEmail) profileEmail.textContent = userProfile.email || 'miembro@wildgvng.com';
						if (profileAvatar && userProfile.avatar) profileAvatar.src = userProfile.avatar;
					} else {
						// Mostrar perfil invitado
						if (profileAuth) profileAuth.style.display = 'none';
						if (profileGuest) profileGuest.style.display = 'block';
						if (loginBtn) loginBtn.style.display = 'block';
					}
				}

				// Cargar estado de autenticación al inicio
				updateAuthUI();

				// Logout button
				const logoutBtn = document.getElementById('logout-btn');
				if (logoutBtn) {
					logoutBtn.addEventListener('click', () => {
						// Limpiar datos de autenticación
						localStorage.removeItem('userAuth');
						localStorage.removeItem('userProfile');
						
						// Actualizar UI
						updateAuthUI();
						closeAllPanels();
						
						console.log('Sesión cerrada');
					});
				}

				// Simulación de autenticación (para pruebas)
				// En producción, esto vendría de tu backend
				function simulateLogin() {
