---
import SidebarLeft from '../components/SidebarLeft.astro';
import { sidebarStore } from '../components/sidebarStore.js';

export type Props = {
  config: {
    name: string;
    primary_color: string;
    secondary_color: string;
  };
};

const { config } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{config.name}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="wrap header-content">
				<div class="header-left">
					<button class="menu-toggle" onclick="sidebarStore.toggle()">
						<span></span>
						<span></span>
						<span></span>
					</button>
					<div class="logo">WG</div>
				</div>
				<div class="header-center">
					<div class="main-title">WILD AND FREE</div>
				</div>
				<div class="header-right">
					<a href="/login" class="login-btn">Acceder</a>
				</div>
			</div>
		</header>
		
		<div class="layout-container">
			<SidebarLeft isOpen={false} onClose={() => sidebarStore.close()} />
			
			<main class="main-content">
				<slot />
			</main>
		</div>
	</body>
</html>

<style define:vars={{ primary: config.primary_color }}>
	:global(:root) {
		--primary-color: var(--primary);
	}

	:global(html) {
		background: #000000;
		color: #ffffff;
		font-family: 'Inter', system-ui, -apple-system, sans-serif;
		scroll-behavior: smooth;
	}

	:global(body) {
		margin: 0;
		min-height: 100vh;
		color: #ededed;
		background: #050505;
	}

	.layout-container {
		display: flex;
		min-height: 100vh;
	}

	.main-content {
		flex: 1;
		margin-left: 0;
		transition: margin-left 0.3s ease;
	}

	@media (min-width: 1024px) {
		.main-content {
			margin-left: 320px;
		}
	}

	.wrap {
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 24px;
	}

	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 1000;
		height: 80px;
		display: flex;
		align-items: center;
		background: rgba(0, 0, 0, 0.9);
		backdrop-filter: blur(12px);
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
	}

	.header-content {
		width: 100%;
		display: grid;
		grid-template-columns: 1fr auto 1fr;
		align-items: center;
		gap: 24px;
	}

	.header-left {
		display: flex;
		align-items: center;
		gap: 16px;
	}

	.header-center {
		text-align: center;
	}

	.header-right {
		display: flex;
		justify-content: flex-end;
		align-items: center;
	}

	.logo {
		font-weight: 900;
		font-size: 24px;
		letter-spacing: -0.05em;
		color: #fff;
		text-transform: uppercase;
	}

	.main-title {
		font-size: 20px;
		font-weight: 900;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: #fff;
		opacity: 0.9;
	}

	.menu-toggle {
		background: none;
		border: none;
		color: #fff;
		cursor: pointer;
		padding: 8px;
		display: flex;
		flex-direction: column;
		gap: 4px;
	}

	.menu-toggle span {
		width: 20px;
		height: 2px;
		background: currentColor;
		transition: all 0.2s;
	}

	.menu-toggle:hover span {
		background: var(--primary-color);
	}

	.login-btn {
		padding: 8px 20px;
		border: 1px solid rgba(255, 255, 255, 0.2);
		color: #fff;
		text-decoration: none;
		font-size: 12px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		font-weight: 700;
		transition: all 0.2s;
	}

	.login-btn:hover {
		background: var(--primary-color);
		border-color: var(--primary-color);
		color: #000;
	}

	:global(:root) {
		color-scheme: dark;
	}
</style>
