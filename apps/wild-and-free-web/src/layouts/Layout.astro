---
import SidebarLeft from '../components/SidebarLeft.astro';

export type Props = {
  config: {
    name: string;
    primary_color: string;
    secondary_color: string;
  };
};

const { config } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{config.name}</title>
		
		<style is:global>
			@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@100;300;400;500;600;700;800;900&display=swap');

			:root {
				--primary: #c98300;
				--secondary: #8a0303;
			}

			html {
				scroll-behavior: smooth;
				background: #000;
			}

			body {
				margin: 0;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				font-family: 'Outfit', sans-serif;
			}

			/* Custom Scrollbar */
			::-webkit-scrollbar {
				width: 8px;
			}
			::-webkit-scrollbar-track {
				background: #000;
			}
			::-webkit-scrollbar-thumb {
				background: #333;
				border-radius: 10px;
			}
			::-webkit-scrollbar-thumb:hover {
				background: #444;
			}

			.sidebar-open #sidebar {
				left: 0 !important;
			}

			.sidebar-open #sidebar-trigger {
				transform: translateX(-100px);
				opacity: 0;
			}

			.sidebar-open main, 
			.sidebar-open header {
				transform: none;
			}

			.sidebar-open main {
				opacity: 0.6;
				filter: blur(4px);
				pointer-events: none;
			}

			#sidebar-overlay {
				position: fixed;
				inset: 0;
				background: rgba(0, 0, 0, 0.4);
				backdrop-filter: blur(2px);
				z-index: 1500;
				opacity: 0;
				visibility: hidden;
				transition: all 0.5s ease;
			}

			.sidebar-open #sidebar-overlay {
				opacity: 1;
				visibility: visible;
			}

			header, main, #sidebar-trigger {
				transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1), opacity 0.5s ease, filter 0.5s ease;
			}

			/* Floating Popovers Design */
			.popover {
				position: absolute;
				top: 100%;
				left: 50%;
				width: 350px;
				background: rgba(10, 10, 10, 0.98);
				backdrop-filter: blur(10px);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 24px;
				box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.8);
				opacity: 0;
				visibility: hidden;
				transform: translateX(-50%) translateY(15px) scale(0.95);
				transition: all 0.3s cubic-bezier(0.23, 1, 0.32, 1);
				z-index: 1100;
				overflow: hidden;
				margin-top: 10px;
			}

			.group\/pop:hover .popover {
				opacity: 1;
				visibility: visible;
				transform: translateX(-50%) translateY(0) scale(1);
			}

			.popover::before {
				content: '';
				position: absolute;
				top: -10px;
				left: 0;
				right: 0;
				height: 10px;
				background: transparent;
			}

			.popover-header {
				padding: 20px 24px;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05);
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.popover-title {
				font-size: 14px;
				font-weight: 900;
				text-transform: uppercase;
				letter-spacing: 0.1em;
				color: #fff;
			}

			.popover-content {
				padding: 24px;
				max-height: 400px;
				overflow-y: auto;
			}

			/* Custom Scrollbar for Popover */
			.popover-content::-webkit-scrollbar {
				width: 4px;
			}
			.popover-content::-webkit-scrollbar-thumb {
				background: rgba(255, 255, 255, 0.1);
				border-radius: 10px;
			}

			.text-contrast {
				color: rgba(255, 255, 255, 0.95);
			}
			
			.text-muted {
				color: rgba(255, 255, 255, 0.65);
			}

			/* Mobile Adaptations */
			@media (max-width: 768px) {
				.popover {
					width: 90vw;
					left: 50%;
					transform: translateX(-50%) translateY(10px) scale(0.98);
				}
				
				#sidebar {
					width: 85vw;
					left: -85vw;
				}
				
				.sidebar-open #sidebar {
					left: 0 !important;
				}
			}
		</style>
	</head>
	<body class="bg-black text-white selection:bg-orange-500/30 selection:text-orange-200 overflow-x-hidden" style={`--primary: ${config.primary_color}; --secondary: ${config.secondary_color};`}>
		<header class="fixed top-0 left-0 right-0 z-[1000] bg-black/90 backdrop-blur-2xl border-b border-white/10 shadow-2xl">
			<div class="max-w-[1440px] mx-auto px-6 h-20 flex items-center justify-between">
				<div class="flex items-center gap-8">
					<button id="sidebar-trigger" class="p-2 text-white hover:text-orange-500 transition-all transform active:scale-90" aria-label="Abrir menú">
						<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
					</button>

					<a href="/" class="flex flex-col items-start group">
						<div class="flex items-baseline gap-1">
							<span class="text-3xl font-black tracking-tighter text-orange-500 italic leading-none group-hover:scale-105 transition-transform origin-left">WILD</span>
							<span class="text-3xl font-black tracking-tighter text-white italic leading-none group-hover:scale-105 transition-transform origin-left">GVNG</span>
						</div>
						<div class="h-1 w-full bg-gradient-to-r from-orange-500 to-transparent rounded-full mt-1 scale-x-0 group-hover:scale-x-100 transition-transform origin-left"></div>
					</a>
				</div>
				
				<nav class="hidden lg:flex items-center gap-2">
					<a href="/artistas" class="px-6 py-2.5 text-[12px] font-extrabold uppercase tracking-[0.15em] text-white hover:text-orange-500 hover:bg-white/5 rounded-full transition-all duration-300">
						Artistas
					</a>
					<a href="/musica" class="px-6 py-2.5 text-[12px] font-extrabold uppercase tracking-[0.15em] text-white hover:text-orange-500 hover:bg-white/5 rounded-full transition-all duration-300">
						Música
					</a>
					<a href="/eventos" class="px-6 py-2.5 text-[12px] font-extrabold uppercase tracking-[0.15em] text-white hover:text-orange-500 hover:bg-white/5 rounded-full transition-all duration-300">
						Eventos
					</a>
					<a href="/tienda" class="px-6 py-2.5 text-[12px] font-extrabold uppercase tracking-[0.15em] text-white hover:text-orange-500 hover:bg-white/5 rounded-full transition-all duration-300">
						Tienda
					</a>
				</nav>
				
				<div class="flex items-center gap-2 md:gap-6">
					<!-- Header Action Icons -->
					<div class="hidden sm:flex items-center gap-1 border-r border-white/10 pr-4 mr-2">
						<div class="relative group/pop">
							<button class="popover-trigger p-2.5 text-white hover:text-orange-500 hover:bg-white/5 rounded-lg transition-all" data-target="location-popover">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
							</button>
							<div id="location-popover" class="popover">
								<div class="popover-header">
									<span class="popover-title">Ubicación: Torreón Coahuila</span>
								</div>
								<div class="popover-content">
									<div class="space-y-4">
										<p class="text-sm text-white/60">Selecciona tu zona para ver eventos cercanos.</p>
										<div class="grid grid-cols-2 gap-2">
											<button class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-xs font-bold hover:bg-orange-500 hover:text-black transition-all">Torreón</button>
											<button class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-xs font-bold hover:bg-orange-500 hover:text-black transition-all">Gómez Palacio</button>
											<button class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-xs font-bold hover:bg-orange-500 hover:text-black transition-all">Lerdo</button>
											<button class="px-4 py-2 bg-white/5 border border-white/10 rounded-lg text-xs font-bold hover:bg-orange-500 hover:text-black transition-all">Monterrey</button>
										</div>
									</div>
								</div>
							</div>
						</div>

						<div class="relative group/pop">
							<button class="popover-trigger p-2.5 text-white hover:text-orange-500 hover:bg-white/5 rounded-lg transition-all relative" data-target="wishlist-popover">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
								<span class="absolute top-1.5 right-1.5 w-4 h-4 bg-orange-500 text-black text-[10px] font-black rounded-full flex items-center justify-center shadow-lg shadow-orange-500/40">3</span>
							</button>
							<div id="wishlist-popover" class="popover">
								<div class="popover-header">
									<span class="popover-title">Favoritos (3)</span>
								</div>
								<div class="popover-content">
									<div class="space-y-4">
										<div class="flex items-center gap-4 group/item">
											<div class="w-12 h-12 rounded-lg bg-white/5 overflow-hidden">
												<img src="https://images.unsplash.com/photo-1556821840-3a63f95609a7?auto=format&fit=crop&w=100&q=80" class="w-full h-full object-cover" />
											</div>
											<div class="flex-1">
												<h4 class="text-xs font-black uppercase">Hoodie Wild</h4>
												<p class="text-[10px] text-orange-500 font-bold">$45.00</p>
											</div>
											<button class="text-white/20 hover:text-red-500 transition-colors">
												<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 6h18M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
											</button>
										</div>
										<button class="w-full py-3 bg-white text-black text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-orange-500 transition-all">Ver Favoritos</button>
									</div>
								</div>
							</div>
						</div>

						<div class="relative group/pop">
							<button class="popover-trigger p-2.5 text-white hover:text-orange-500 hover:bg-white/5 rounded-lg transition-all relative" data-target="cart-popover">
								<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
								<span class="absolute top-1.5 right-1.5 w-4 h-4 bg-orange-500 text-black text-[10px] font-black rounded-full flex items-center justify-center shadow-lg shadow-orange-500/40">2</span>
							</button>
							<div id="cart-popover" class="popover">
								<div class="popover-header">
									<span class="popover-title">Tu Carrito</span>
								</div>
								<div class="popover-content">
									<div class="space-y-6">
										<div class="flex items-center gap-4">
											<div class="w-16 h-16 rounded-xl bg-white/5 overflow-hidden">
												<img src="https://images.unsplash.com/photo-1542291026-7eec264c27ff?auto=format&fit=crop&w=150&q=80" class="w-full h-full object-cover" />
											</div>
											<div class="flex-1">
												<h4 class="text-xs font-black uppercase">Camiseta Oficial</h4>
												<p class="text-[10px] text-white/40">Talla: L</p>
												<p class="text-xs font-black mt-1">$35.00</p>
											</div>
										</div>
										<div class="border-t border-white/5 pt-4 space-y-4">
											<div class="flex justify-between items-center">
												<span class="text-[10px] font-bold text-white/40 uppercase">Subtotal</span>
												<span class="text-sm font-black">$120.00</span>
											</div>
											<button class="w-full py-4 bg-orange-500 text-black text-[10px] font-black uppercase tracking-[0.2em] rounded-2xl hover:bg-white transition-all shadow-xl shadow-orange-500/20">Finalizar Compra</button>
										</div>
									</div>
								</div>
							</div>
						</div>
					</div>

					<div class="flex items-center gap-4">
						<div class="relative group/pop">
							<a href="/login" class="hidden sm:block text-[12px] font-extrabold uppercase tracking-[0.15em] text-white/60 hover:text-white transition-all py-4">Entrar</a>
							<div class="popover w-64">
								<div class="popover-header"><span class="popover-title text-center block w-full">Tu Cuenta</span></div>
								<div class="popover-content space-y-4">
									<p class="text-[10px] text-white/40 uppercase font-black text-center">Accede a contenido exclusivo</p>
									<a href="/login" class="block w-full py-3 bg-white text-black text-center text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-orange-500 hover:text-white transition-all">Iniciar Sesión</a>
									<a href="/perfil" class="block text-center text-[10px] text-white/60 hover:text-orange-500 font-black uppercase tracking-widest">Mi Perfil</a>
								</div>
							</div>
						</div>

						<div class="relative group/pop">
							<a href="/registro" class="group relative px-8 py-3.5 bg-white text-black text-[12px] font-black uppercase tracking-[0.15em] rounded-2xl hover:bg-orange-500 transition-all duration-500 transform hover:-translate-y-1 shadow-2xl shadow-white/5">
								<span class="relative z-10">Unirse</span>
								<div class="absolute inset-0 rounded-2xl bg-gradient-to-r from-orange-500 to-red-600 opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-0"></div>
							</a>
							<div class="popover w-72">
								<div class="popover-header"><span class="popover-title text-center block w-full">Sé parte de la Crew</span></div>
								<div class="popover-content space-y-4">
									<ul class="space-y-2">
										<li class="flex items-center justify-center gap-2 text-[10px] text-white font-bold uppercase tracking-widest"><span class="text-orange-500">✓</span> Acceso anticipado</li>
										<li class="flex items-center justify-center gap-2 text-[10px] text-white font-bold uppercase tracking-widest"><span class="text-orange-500">✓</span> Merch exclusiva</li>
										<li class="flex items-center justify-center gap-2 text-[10px] text-white font-bold uppercase tracking-widest"><span class="text-orange-500">✓</span> Eventos VIP</li>
									</ul>
									<a href="/registro" class="block w-full py-3 bg-orange-500 text-white text-center text-[10px] font-black uppercase tracking-widest rounded-xl hover:bg-white hover:text-black transition-all">Registrarse Ahora</a>
								</div>
							</div>
						</div>
					</div>
				</div>
			</div>
		</header>
		
		<div id="sidebar-overlay"></div>
		<SidebarLeft />
		
		<main class="pt-20">
			<slot />
		</main>
		
		<script>
			// Menu Toggle Logic
			const menuToggle = document.getElementById('sidebar-trigger');
			const sidebarClose = document.getElementById('sidebar-close');
			const sidebarOverlay = document.getElementById('sidebar-overlay');
			const body = document.body;
			const sidebar = document.getElementById('sidebar');

			const toggleSidebar = () => {
				body.classList.toggle('sidebar-open');
			};

			const closeSidebar = () => {
				body.classList.remove('sidebar-open');
			};

			if (menuToggle) {
				menuToggle.addEventListener('click', (e) => {
					e.stopPropagation();
					toggleSidebar();
				});
			}

			if (sidebarClose) {
				sidebarClose.addEventListener('click', (e) => {
					e.stopPropagation();
					closeSidebar();
				});
			}

			if (sidebarOverlay) {
				sidebarOverlay.addEventListener('click', () => {
					closeSidebar();
				});
			}

			// Popover Logic
			const triggers = document.querySelectorAll('.popover-trigger');
			const popovers = document.querySelectorAll('.popover');

			triggers.forEach(trigger => {
				trigger.addEventListener('click', (e) => {
					e.stopPropagation();
					const targetId = trigger.getAttribute('data-target');
					const targetPopover = document.getElementById(targetId);
					
					const isActive = targetPopover?.classList.contains('active');
					
					// Close all popovers
					popovers.forEach(p => p.classList.remove('active'));
					
					if (!isActive) {
						targetPopover?.classList.add('active');
					}
				});
			});

			// Close everything when clicking outside
			document.addEventListener('click', (e) => {
				// Sidebar: Close if open and clicking outside sidebar OR clicking on main content
				if (body.classList.contains('sidebar-open')) {
					const isClickInsideSidebar = sidebar?.contains(e.target as Node);
					const isClickOnToggle = menuToggle?.contains(e.target as Node);
					
					if (!isClickInsideSidebar && !isClickOnToggle) {
						closeSidebar();
					}
				}

				// Popovers
				const isTrigger = (e.target as HTMLElement).closest('.popover-trigger');
				const isPopover = (e.target as HTMLElement).closest('.popover');
				if (!isTrigger && !isPopover) {
					popovers.forEach(p => p.classList.remove('active'));
				}
			});

			// Close on ESC key
			document.addEventListener('keydown', (e) => {
				if (e.key === 'Escape') {
					closeSidebar();
					popovers.forEach(p => p.classList.remove('active'));
				}
			});

			// User Data Logic (Mock for Supabase integration)
			const userData = {
				location: 'Torreón Coahuila',
				wishlistCount: 3,
				cartCount: 2
			};

			// Update UI with user data
			const updateUserDataUI = () => {
				const wishlistBadge = document.querySelector('[data-target="wishlist-popover"] span');
				const cartBadge = document.querySelector('[data-target="cart-popover"] span');
				const locationText = document.querySelector('[data-target="location-popover"] .popover-title');
				const sidebarLocation = document.querySelector('.location-btn');

				if (wishlistBadge) wishlistBadge.textContent = userData.wishlistCount.toString();
				if (cartBadge) cartBadge.textContent = userData.cartCount.toString();
				if (locationText) locationText.textContent = `Ubicación: ${userData.location}`;
				if (sidebarLocation) sidebarLocation.textContent = `Ubicación: ${userData.location}`;
			};

			updateUserDataUI();

			// Location Selection
			const locationButtons = document.querySelectorAll('#location-popover button');
			locationButtons.forEach(btn => {
				btn.addEventListener('click', () => {
					userData.location = btn.textContent?.trim() || 'CDMX';
					updateUserDataUI();
					popovers.forEach(p => p.classList.remove('active'));
				});
			});

			// Header background on scroll
			const header = document.querySelector('header');
			window.addEventListener('scroll', () => {
				if (window.scrollY > 50) {
					header?.classList.add('bg-black/95', 'py-2');
					header?.classList.remove('bg-black/90', 'py-0');
				} else {
					header?.classList.add('bg-black/90', 'py-0');
					header?.classList.remove('bg-black/95', 'py-2');
				}
			});
		</script>
	</body>
</html>