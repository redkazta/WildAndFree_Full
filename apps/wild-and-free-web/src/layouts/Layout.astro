---
export type Props = {
  config: {
    id: string;
    name: string;
    primary_color: string;
    secondary_color: string;
    modules: Record<string, boolean>;
  };
};

const { config } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{config.name}</title>
	</head>
	<body>
		<div class="wrap">
			<slot />
		</div>
	</body>
</html>

<style define:vars={{ primaryColor: config.primary_color }}>
	:global(:root) {
		--primary-color: var(--primaryColor);
	}

	:global(html) {
		background: #050505;
		color: #ffffff;
		font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial,
			'Apple Color Emoji', 'Segoe UI Emoji';
	}

	:global(body) {
		margin: 0;
		min-height: 100vh;
		color: rgba(255, 255, 255, 0.92);
		background:
			radial-gradient(
				1200px 600px at 10% 10%,
				color-mix(in srgb, var(--primary-color) 16%, transparent 84%),
				transparent 60%
			),
			radial-gradient(900px 500px at 90% 20%, rgba(255, 255, 255, 0.06), transparent 55%),
			#050505;
	}

	.wrap {
		max-width: 1200px;
		margin: 0 auto;
		padding: 0 18px;
	}

	:global(:root) {
		color-scheme: dark;
	}
</style>
