---
import SidebarLeft from '../components/SidebarLeft.astro';
// import Player from '../components/Player.astro';
import RadioFloating from '../components/RadioFloating.astro';
import SpotifyFloating from '../components/SpotifyFloating.astro';
import { ClientRouter } from 'astro:transitions';
import Analytics from '@vercel/analytics/astro';

export type Props = {
  config: {
    name: string;
    primary_color: string;
    secondary_color: string;
  };
};

const { config } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
  { href: '/artistas', label: 'Artistas', iconPaths: ['M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2', 'M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8z'] },
  { href: '/versus', label: 'Versus', iconPaths: ['M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z', 'M14 2v6h6', 'M8 13h2', 'M8 17h2', 'M14 13h2', 'M14 17h2'] },
  { href: '/musica', label: 'Música', iconPaths: ['M9 18V5l12-2v13', 'M9 18a2 2 0 1 0 0-4', 'M21 16a2 2 0 1 0 0-4'] },
  { href: '/radio', label: 'Radio', iconPaths: ['M4.9 19.1C1 15.2 1 8.8 4.9 4.9', 'M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5', 'M12 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6z', 'M12 12v9'] },
  { href: '/podcasts', label: 'Podcasts', iconPaths: ['M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z', 'M19 10v2a7 7 0 0 1-14 0v-2', 'M12 19v4', 'M8 23h8'] },
  { href: '/eventos', label: 'Eventos', iconPaths: ['M3 6h18', 'M3 12h18', 'M3 18h18'] },
  { href: '/tienda', label: 'Tienda', iconPaths: ['M6 9h12l-1.2 11H7.2L6 9z', 'M9 9V6a3 3 0 0 1 6 0v3'] },
  { href: '/wild-and-free-league', label: 'WILD AND FREE', iconPaths: ['M12 2C9 2 6.5 4 6.5 6.5C6.5 8.1 7.2 9.5 8.5 10.5C8.8 10.7 9 11 9 11.5V15C9 15.6 9.4 16 10 16H14C14.6 16 15 15.6 15 15V11.5C15 11 15.2 10.7 15.5 10.5C16.8 9.5 17.5 8.1 17.5 6.5C17.5 4 15 2 12 2ZM12 4C13.7 4 15 5.1 15 6.5C15 7.4 14.6 8.2 13.9 8.7C13.3 9.1 13 9.8 13 10.5V14H11V10.5C11 9.8 10.7 9.1 10.1 8.7C9.4 8.2 9 7.4 9 6.5C9 5.1 10.3 4 12 4Z M9 18H15V20H9V18Z'] },
  { href: '/honor-and-free', label: 'HONOR AND FREE', iconPaths: ['M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z'] },
  { href: '/ascension', label: 'ASCENSIÓN', iconPaths: ['M8 18h2v-2h2v-2h2v-2h2v-2h2V8h2v12H6v-2h2z'] },
  { href: '/wild-writings', label: 'WILD WRITINGS', iconPaths: ['M4 20h16', 'M6 16l8-8 4 4-8 8-4 0 0-4z'] }
];

const isActive = (href: string) => {
  if (currentPath === href) return true;
  if (href === '/artistas' && currentPath.startsWith('/artista/')) return true;
  if (href === '/eventos' && currentPath.startsWith('/evento/')) return true;
  if (href === '/radio' && currentPath.startsWith('/radio')) return true;
  return false;
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{config.name}</title>
		<slot name="head" />
		<ClientRouter />

		<style is:global>
			@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@100;300;400;500;600;700;800;900&display=swap');

			:root {
				--primary: #c98300;
				--secondary: #8a0303;
			}

			html {
				scroll-behavior: smooth;
				background: #000;
			}

			body {
				margin: 0;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				font-family: 'Outfit', sans-serif;
				color: #fff;
			}

			/* Removed aggressive text overrides to allow custom styling */
			/*
			[class*="text-white/"] {
				color: #fff !important;
				opacity: 1 !important;
			}

			[class*="text-gray-"],
			[class*="text-slate-"],
			[class*="text-neutral-"],
			[class*="text-zinc-"],
			[class*="text-stone-"] {
				color: #fff !important;
				opacity: 1 !important;
			}

			.text-muted,
			.text-contrast {
				color: #fff !important;
				opacity: 1 !important;
			}
			*/

			::placeholder {
				color: #a1a1aa; /* zinc-400 */
				opacity: 1;
			}

			/* FOUC Prevention: hide auth UI until session resolves */
			.auth-actions-container {
				opacity: 0;
				transition: opacity 0.3s ease;
			}
			body[data-auth-loaded="true"] .auth-actions-container {
				opacity: 1;
			}

			/* Custom Scrollbar */
			::-webkit-scrollbar {
				width: 10px;
			}
			::-webkit-scrollbar-track {
				background: #000;
			}
			::-webkit-scrollbar-thumb {
				background: #ffffff;
				border-radius: 0;
			}
			::-webkit-scrollbar-thumb:hover {
				background: #c98300;
			}

			.sidebar-open #sidebar {
				left: 0 !important;
			}

			#sidebar {
				border-right-color: transparent;
			}

			.sidebar-open #sidebar {
				border-right-color: #ffffff;
			}

			.sidebar-open #sidebar-trigger {
				transform: translateX(-100px);
				opacity: 0;
			}

			.sidebar-open main {
				opacity: 0.6;
				filter: blur(4px);
				pointer-events: none;
			}

			#sidebar-overlay {
				position: fixed;
				inset: 0;
				background: rgba(0, 0, 0, 0.6);
				backdrop-filter: blur(4px);
				z-index: 1500;
				opacity: 0;
				visibility: hidden;
				transition: all 0.5s ease;
			}

			.sidebar-open #sidebar-overlay {
				opacity: 1;
				visibility: visible;
			}

			main, #sidebar-trigger {
				transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1), opacity 0.5s ease, filter 0.5s ease;
			}

			/* Floating Popovers Design */
			.popover {
				position: absolute;
				top: calc(100% + 15px);
				left: 50%;
				width: 320px;
				background: rgba(5, 5, 5, 0.95);
				backdrop-filter: blur(20px);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 16px;
				box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.8), 0 0 20px rgba(201, 131, 0, 0.1);
				opacity: 0;
				visibility: hidden;
				transform: translateX(-50%) translateY(10px) scale(0.95);
				transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
				z-index: 1100;
				overflow: hidden;
			}

			.popover.active {
				opacity: 1;
				visibility: visible;
				transform: translateX(-50%) translateY(0) scale(1);
			}

			.group\/pop:hover .popover {
				opacity: 1;
				visibility: visible;
				transform: translateX(-50%) translateY(0) scale(1);
			}

			/* Arrow indicator */
			.popover::before {
				content: '';
				position: absolute;
				top: -6px;
				left: 50%;
				transform: translateX(-50%) rotate(45deg);
				width: 12px;
				height: 12px;
				background: rgba(5, 5, 5, 0.95);
				border-left: 1px solid rgba(255, 255, 255, 0.1);
				border-top: 1px solid rgba(255, 255, 255, 0.1);
			}

			.popover-header {
				padding: 16px 20px;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05);
				background: linear-gradient(to right, rgba(255,255,255,0.02), transparent);
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.popover-title {
				font-size: 11px;
				font-weight: 900;
				text-transform: uppercase;
				letter-spacing: 0.2em;
				color: #fff;
				text-shadow: 0 0 10px rgba(255,255,255,0.3);
			}

			.popover-content {
				padding: 20px;
				max-height: 400px;
				overflow-y: auto;
			}

			/* Custom Scrollbar for Popover */
			.popover-content::-webkit-scrollbar {
				width: 4px;
			}
			.popover-content::-webkit-scrollbar-thumb {
				background: #ffffff;
			}

			/*
			.text-contrast {
				color: #ffffff;
			}

			.text-muted {
				color: #ffffff;
			}
			*/

			/* Mobile Adaptations */
			@media (max-width: 768px) {
				.popover {
					width: 95vw;
					left: 50%;
					transform: translateX(-50%) translateY(10px) scale(0.98);
				}

				#sidebar {
					width: 85vw;
					left: -85vw;
				}

				.sidebar-open #sidebar {
					left: 0 !important;
				}
			}
		</style>
	</head>
	<body class="bg-black text-white selection:bg-wild-orange/50 selection:text-white overflow-x-hidden" style={`--primary: ${config.primary_color}; --secondary: ${config.secondary_color}; --wild-orange: ${config.primary_color}; --wild-red: ${config.secondary_color}; --tenant-primary: ${config.primary_color}; --tenant-secondary: ${config.secondary_color}; --tenant-glow: ${config.primary_color}33;`}>
		<!-- Top Navigation Header Bar -->
		<header class="top-header">
			<div class="top-header-inner">
				<div class="top-header-left">
					<button id="sidebar-trigger" class="top-header-hamburger" aria-label="Abrir menú">
						<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
							<line x1="3" y1="6" x2="21" y2="6"></line>
							<line x1="3" y1="12" x2="21" y2="12"></line>
							<line x1="3" y1="18" x2="21" y2="18"></line>
						</svg>
					</button>
					<a href="/" class="top-header-logo-link">
						<img src="/wg_logo.png" alt="Wild Gvng" class="top-header-logo" />
						<span class="top-header-brand">
							<span class="top-header-brand-wild">WILD</span>
							<span class="top-header-brand-gvng">GVNG</span>
						</span>
					</a>
				</div>
				<div class="top-header-right">
					<a href="/login" class="top-header-login">Entrar</a>
					<a href="/registro" class="top-header-register">Unirse</a>
				</div>
			</div>
		</header>

		<style>
			.top-header {
				position: fixed;
				top: 0;
				left: 0;
				right: 0;
				height: 56px;
				z-index: 3000;
				background: rgba(0, 0, 0, 0.65);
				backdrop-filter: blur(16px);
				-webkit-backdrop-filter: blur(16px);
				border-bottom: 1px solid rgba(255, 255, 255, 0.08);
				transition: background 0.3s ease;
			}

			.top-header-inner {
				max-width: 1440px;
				margin: 0 auto;
				padding: 0 16px;
				height: 100%;
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.top-header-left {
				display: flex;
				align-items: center;
				gap: 12px;
			}

			.top-header-hamburger {
				display: flex;
				align-items: center;
				justify-content: center;
				width: 38px;
				height: 38px;
				color: #fff;
				background: rgba(255, 255, 255, 0.06);
				border: 1px solid rgba(255, 255, 255, 0.1);
				border-radius: 10px;
				cursor: pointer;
				transition: all 0.2s ease;
				flex-shrink: 0;
			}

			.top-header-hamburger:hover {
				color: var(--wild-orange, #c98300);
				background: rgba(201, 131, 0, 0.1);
				border-color: rgba(201, 131, 0, 0.3);
			}

			.top-header-hamburger:active {
				transform: scale(0.92);
			}

			.top-header-logo-link {
				display: flex;
				align-items: center;
				gap: 10px;
				text-decoration: none;
			}

			.top-header-logo {
				width: 32px;
				height: 32px;
				object-fit: contain;
				flex-shrink: 0;
			}

			.top-header-brand {
				display: flex;
				align-items: baseline;
				gap: 1px;
			}

			.top-header-brand-wild {
				font-size: 18px;
				font-weight: 900;
				letter-spacing: -0.04em;
				font-style: italic;
				color: #fff;
				line-height: 1;
			}

			.top-header-brand-gvng {
				font-size: 18px;
				font-weight: 900;
				letter-spacing: -0.04em;
				font-style: italic;
				color: var(--wild-orange, #c98300);
				line-height: 1;
			}

			.top-header-right {
				display: flex;
				align-items: center;
				gap: 8px;
			}

			.top-header-login {
				padding: 8px 16px;
				font-size: 11px;
				font-weight: 900;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: #fff;
				text-decoration: none;
				border-radius: 8px;
				transition: all 0.2s ease;
			}

			.top-header-login:hover {
				color: var(--wild-orange, #c98300);
				background: rgba(201, 131, 0, 0.1);
			}

			.top-header-register {
				padding: 8px 18px;
				font-size: 11px;
				font-weight: 900;
				text-transform: uppercase;
				letter-spacing: 0.12em;
				color: #000;
				background: #fff;
				text-decoration: none;
				border-radius: 8px;
				transition: all 0.2s ease;
			}

			.top-header-register:hover {
				background: var(--wild-orange, #c98300);
				color: #fff;
			}

			@media (max-width: 480px) {
				.top-header-inner {
					padding: 0 12px;
				}
				.top-header-brand-wild,
				.top-header-brand-gvng {
					font-size: 15px;
				}
				.top-header-login {
					padding: 6px 10px;
					font-size: 10px;
				}
				.top-header-register {
					padding: 6px 12px;
					font-size: 10px;
				}
			}
		</style>

		<div id="sidebar-overlay"></div>
		<SidebarLeft />
		<RadioFloating />
		<SpotifyFloating />

		<main class="pt-14">
			<slot />
		</main>

		<script>
			import { initLayout } from '../lib/layout';
			initLayout();
			document.addEventListener('astro:after-swap', () => {
				import('../lib/layout').then(({ initLayout }) => initLayout());
			});
		</script>
		<Analytics />
	</body>
</html>
