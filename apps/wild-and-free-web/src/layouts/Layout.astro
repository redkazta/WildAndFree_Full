---
export type Props = {
  tenant: {
    name: string;
    primary_color: string;
    secondary_color: string;
    logo_text: string;
  };
};

const { tenant } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{tenant.name}</title>
	</head>
	<body>
		<header class="site-header">
			<div class="wrap header-content">
				<div class="logo">{tenant.logo_text}</div>
				<nav>
					<a href="#artists" class="nav-link">Artists</a>
				</nav>
			</div>
		</header>
		<div class="wrap">
			<slot />
		</div>
	</body>
</html>

<style define:vars={{ primary: tenant.primary_color }}>
	:global(:root) {
		--primary-color: var(--primary);
	}

	:global(html) {
		background: #000000;
		color: #ffffff;
		font-family: 'Inter', system-ui, -apple-system, sans-serif;
	}

	:global(body) {
		margin: 0;
		min-height: 100vh;
		color: #ededed;
		background: 
			radial-gradient(circle at 50% 0%, color-mix(in srgb, var(--primary) 15%, transparent), transparent 40%),
			#050505;
	}

	.wrap {
		max-width: 1400px;
		margin: 0 auto;
		padding: 0 24px;
	}

	.site-header {
		position: fixed;
		top: 0;
		left: 0;
		right: 0;
		z-index: 100;
		padding: 24px 0;
		backdrop-filter: blur(8px);
		border-bottom: 1px solid rgba(255,255,255,0.05);
	}

	.header-content {
		display: flex;
		justify-content: space-between;
		align-items: center;
	}

	.logo {
		font-weight: 900;
		font-size: 24px;
		letter-spacing: -0.05em;
		color: #fff;
	}

	.nav-link {
		color: rgba(255,255,255,0.6);
		text-decoration: none;
		font-size: 14px;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		transition: color 0.2s;
	}

	.nav-link:hover {
		color: var(--primary-color);
	}

	:global(:root) {
		color-scheme: dark;
	}
</style>
