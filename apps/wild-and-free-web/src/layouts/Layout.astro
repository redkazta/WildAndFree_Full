---
import SidebarLeft from '../components/SidebarLeft.astro';
import RadioFloating from '../components/RadioFloating.astro';
import SpotifyFloating from '../components/SpotifyFloating.astro';
				import { ClientRouter } from 'astro:transitions';
				import Analytics from '@vercel/analytics/astro';

export type Props = {
  config: {
    name: string;
    primary_color: string;
    secondary_color: string;
  };
};

const { config } = Astro.props;
const currentPath = Astro.url.pathname;

const navItems = [
	{ href: '/the-wild-times', label: 'THE WILD TIMES', iconPaths: ['M4 22h16a2 2 0 002-2V4a2 2 0 00-2-2H4a2 2 0 00-2 2v16a2 2 0 002 2z', 'M6 8h5M6 12h8M6 16h12', 'M17 8h1M17 10h1'] },
		  { href: '/wild-writings', label: 'WILD WRITINGS', iconPaths: ['M15.232 5.232l3.536 3.536m-2.036-5.036a2.5 2.5 0 113.536 3.536L6.5 21.036H3v-3.572L16.732 3.732z', 'M3 21h18'] },
	  { href: '/artistas', label: 'Artistas', iconPaths: ['M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2', 'M12 3a4 4 0 1 0 0 8 4 4 0 0 0 0-8z'] },
  { href: '/versus', label: 'Versus', iconPaths: ['M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z', 'M14 2v6h6', 'M8 13h2', 'M8 17h2', 'M14 13h2', 'M14 17h2'] },
  { href: '/musica', label: 'Música', iconPaths: ['M9 18V5l12-2v13', 'M9 18a2 2 0 1 0 0-4', 'M21 16a2 2 0 1 0 0-4'] },
  { href: '/radio', label: 'Radio', iconPaths: ['M4.9 19.1C1 15.2 1 8.8 4.9 4.9', 'M7.8 16.2c-2.3-2.3-2.3-6.1 0-8.5', 'M12 12a3 3 0 1 0 0-6 3 3 0 0 0 0 6z', 'M12 12v9'] },
  { href: '/podcasts', label: 'Podcasts', iconPaths: ['M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z', 'M19 10v2a7 7 0 0 1-14 0v-2', 'M12 19v4', 'M8 23h8'] },
  { href: '/eventos', label: 'Eventos', iconPaths: ['M3 6h18', 'M3 12h18', 'M3 18h18'] },
  { href: '/tienda', label: 'Tienda', iconPaths: ['M6 9h12l-1.2 11H7.2L6 9z', 'M9 9V6a3 3 0 0 1 6 0v3'] },
  { href: '/wild-and-free-league', label: 'WILD AND FREE', iconPaths: ['M12 2C9 2 6.5 4 6.5 6.5C6.5 8.1 7.2 9.5 8.5 10.5C8.8 10.7 9 11 9 11.5V15C9 15.6 9.4 16 10 16H14C14.6 16 15 15.6 15 15V11.5C15 11 15.2 10.7 15.5 10.5C16.8 9.5 17.5 8.1 17.5 6.5C17.5 4 15 2 12 2ZM12 4C13.7 4 15 5.1 15 6.5C15 7.4 14.6 8.2 13.9 8.7C13.3 9.1 13 9.8 13 10.5V14H11V10.5C11 9.8 10.7 9.1 10.1 8.7C9.4 8.2 9 7.4 9 6.5C9 5.1 10.3 4 12 4Z M9 18H15V20H9V18Z'] },
  { href: '/honor-and-free', label: 'HONOR AND FREE', iconPaths: ['M12 2l3.09 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2z'] },
  { href: '/ascension', label: 'ASCENSIÓN', iconPaths: ['M8 18h2v-2h2v-2h2v-2h2v-2h2V8h2v12H6v-2h2z'] },
  { href: '/wild-writings', label: 'WILD WRITINGS', iconPaths: ['M4 20h16', 'M6 16l8-8 4 4-8 8-4 0 0-4z'] }
];

const isActive = (href: string) => {
  if (currentPath === href) return true;
  if (href === '/wild-writings' && currentPath === '/wild-writings') return true;
  	  if (href === '/the-wild-times' && currentPath.startsWith('/the-wild-times')) return true;
  	  if (href === '/artistas' && currentPath.startsWith('/artista/')) return true;
  if (href === '/eventos' && currentPath.startsWith('/evento/')) return true;
  if (href === '/radio' && currentPath.startsWith('/radio')) return true;
  return false;
};
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/png" href="/wg_logo.png" />
		<meta name="generator" content={Astro.generator} />
		<title>{config.name}</title>
		<slot name="head" />
		<script is:inline>
			// Theme: set data-theme BEFORE paint + re-apply on navigation
			(function() {
				function applyStoredTheme() {
					try {
						var saved = localStorage.getItem('wg-theme');
						document.documentElement.setAttribute('data-theme', saved === 'light' ? 'light' : 'dark');
					} catch(e) {
						document.documentElement.setAttribute('data-theme', 'dark');
					}
				}
				applyStoredTheme();
				// Re-apply on Astro client-side navigation
				document.addEventListener('astro:after-swap', applyStoredTheme);
			})();
		</script>
		<ClientRouter />

		<style is:global>
			@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@100;300;400;500;600;700;800;900&display=swap');

			/* ── SMOOTH THEME TRANSITION ── */
			html.theme-transition,
			html.theme-transition *,
			html.theme-transition *::before,
			html.theme-transition *::after {
				transition: background-color 0.2s ease, color 0.2s ease, border-color 0.2s ease !important;
			}

			/* ═══════════════════════════════════════════════
			   CSS VARIABLES — DARK MODE (default)
			   Pure black bg + pure white text + white borders
			   ═══════════════════════════════════════════════ */
			:root {
				--primary: #c98300;
				--primary-hover: #e69500;
				--primary-soft: rgba(201, 131, 0, 0.12);
				--primary-border: rgba(201, 131, 0, 0.25);
				--secondary: #8a0303;
				--secondary-soft: rgba(138, 3, 3, 0.08);
				--secondary-border: rgba(138, 3, 3, 0.15);
				--bg: #000000;
				--bg-card: rgba(255,255,255,0.06);
				--bg-hover: rgba(255,255,255,0.10);
				--border: #ffffff;
				--border-soft: rgba(255,255,255,0.35);
				--border-muted: rgba(255,255,255,0.18);
				--border-faint: rgba(255,255,255,0.08);
				--border-strong: #ffffff;
				--text: #ffffff;
				--text-secondary: #ffffff;
				--text-muted: #ffffff;
				--text-faint: #ffffff;
				--repost: #1da1f2;
				--event: #ff6b6b;
			}

			/* ═══════════════════════════════════════════════
			   CSS VARIABLES — LIGHT MODE
			   Pure white bg + pure black text + dark borders
			   ═══════════════════════════════════════════════ */
			[data-theme="light"] {
				--primary: #b37400;
				--primary-hover: #c98300;
				--primary-soft: rgba(179, 116, 0, 0.08);
				--primary-border: rgba(179, 116, 0, 0.20);
				--secondary: #8a0303;
				--secondary-soft: rgba(138, 3, 3, 0.04);
				--secondary-border: rgba(138, 3, 3, 0.10);
				--bg: #ffffff;
				--bg-card: rgba(0,0,0,0.025);
				--bg-hover: rgba(0,0,0,0.04);
				--border: rgba(0,0,0,0.15);
				--border-soft: rgba(0,0,0,0.08);
				--border-muted: rgba(0,0,0,0.06);
				--border-faint: rgba(0,0,0,0.03);
				--border-strong: rgba(0,0,0,0.25);
				--text: #000000;
				--text-secondary: #000000;
				--text-muted: #000000;
				--text-faint: #000000;
				--repost: #0d8bd9;
				--event: #d32f2f;
			}

			/* ═══════════════════════════════════════════════
			   BASE STYLES
			   ═══════════════════════════════════════════════ */
			html {
				scroll-behavior: smooth;
				background: var(--bg);
			}

			body {
				margin: 0;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				font-family: 'Outfit', sans-serif;
				background: var(--bg);
				color: var(--text);
			}


			::placeholder {
				color: var(--text-muted);
				opacity: 1;
			}

			/* FOUC Prevention: hide auth UI until session resolves */
			.auth-actions-container {
				opacity: 0;
				transition: opacity 0.3s ease;
			}
			body[data-auth-loaded="true"] .auth-actions-container {
				opacity: 1;
			}

			/* Custom Scrollbar */
			::-webkit-scrollbar {
				width: 10px;
			}
			::-webkit-scrollbar-track {
				background: var(--bg);
			}
			::-webkit-scrollbar-thumb {
				background: var(--border-soft);
				border-radius: 0;
			}
			::-webkit-scrollbar-thumb:hover {
				background: var(--primary);
			}

			.sidebar-open #sidebar {
				left: 0 !important;
			}

			#sidebar {
				border-right-color: transparent;
			}

			.sidebar-open #sidebar {
							border-right-color: var(--border);
						}

			.sidebar-open #sidebar-trigger {
				transform: translateX(-100px);
				opacity: 0;
			}

			.sidebar-open main,
			.sidebar-open header {
				transform: none;
			}

			.sidebar-open main {
				opacity: 0.6;
				filter: blur(4px);
				pointer-events: none;
			}

			#sidebar-overlay {
				position: fixed;
				inset: 0;
				background: rgba(0, 0, 0, 0.6);
				backdrop-filter: blur(4px);
				z-index: 1500;
				opacity: 0;
				visibility: hidden;
				transition: all 0.5s ease;
			}

			.sidebar-open #sidebar-overlay {
				opacity: 1;
				visibility: visible;
			}

			header, main, #sidebar-trigger {
				transition: transform 0.5s cubic-bezier(0.23, 1, 0.32, 1), opacity 0.5s ease, filter 0.5s ease;
			}

			/* Floating Popovers Design */
			.popover {
				position: absolute;
				top: calc(100% + 15px);
				left: 50%;
				width: 320px;
				background: var(--bg-card);
				backdrop-filter: blur(20px);
				border: 1px solid var(--border-muted);
				border-radius: 16px;
				box-shadow: 0 20px 50px -10px rgba(0, 0, 0, 0.8), 0 0 20px rgba(201, 131, 0, 0.1);
				opacity: 0;
				visibility: hidden;
				transform: translateX(-50%) translateY(10px) scale(0.95);
				transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
				z-index: 1100;
				overflow: hidden;
			}

			.popover.active {
				opacity: 1;
				visibility: visible;
				transform: translateX(-50%) translateY(0) scale(1);
			}

			.group\/pop:hover .popover {
				opacity: 1;
				visibility: visible;
				transform: translateX(-50%) translateY(0) scale(1);
			}

			/* Arrow indicator */
			.popover::before {
				content: '';
				position: absolute;
				top: -6px;
				left: 50%;
				transform: translateX(-50%) rotate(45deg);
				width: 12px;
				height: 12px;
				background: var(--bg-card);
				border-left: 1px solid var(--border-muted);
				border-top: 1px solid var(--border-muted);
			}

			.popover-header {
				padding: 16px 20px;
				border-bottom: 1px solid var(--border-faint);
				background: linear-gradient(to right, var(--bg-card), transparent);
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.popover-title {
				font-size: 11px;
				font-weight: 900;
				text-transform: uppercase;
				letter-spacing: 0.2em;
				color: var(--text);
				text-shadow: 0 0 10px var(--primary-soft);
			}

			.popover-content {
				padding: 20px;
				max-height: 400px;
				overflow-y: auto;
			}

			/* Custom Scrollbar for Popover */
			.popover-content::-webkit-scrollbar {
				width: 4px;
			}
			.popover-content::-webkit-scrollbar-thumb {
				background: #ffffff;
			}

			/*
			.text-contrast {
				color: #ffffff;
			}

			.text-muted {
				color: #ffffff;
			}
			*/

			/* Mobile Adaptations */
			@media (max-width: 768px) {
				.popover {
					width: 95vw;
					left: 50%;
					transform: translateX(-50%) translateY(10px) scale(0.98);
				}

				#sidebar {
					width: 85vw;
					left: -85vw;
				}

				.sidebar-open #sidebar {
					left: 0 !important;
				}

				/* Header mobile overrides */
				.wg-header {
					height: 56px !important;
				}

				.wg-header .wg-logo-img {
					width: 20px !important;
					height: 20px !important;
				}

				.wg-header .wg-wild-text,
				.wg-header .wg-gvng-text {
					font-size: 16px !important;
				}

				.wg-header .wg-right-section {
					display: none !important;
				}

				.wg-header .wg-login-link {
					display: inline-flex !important;
				}

				.wg-header .wg-login-btn {
					display: none !important;
				}

				.wg-header .wg-actions-desktop {
					display: none !important;
				}
			}

			/* ── TAG BADGE SYSTEM ── */
			.tag-badge {
				display: inline-flex;
				align-items: center;
				gap: 5px;
				padding: 4px 12px;
				border-radius: 100px;
				font-weight: 800;
				text-transform: uppercase;
				letter-spacing: 0.08em;
				font-family: 'JetBrains Mono', monospace;
				white-space: nowrap;
				border: 1.5px solid var(--tag-c, var(--primary));
				background: color-mix(in srgb, var(--tag-c, var(--primary)) 12%, transparent);
				color: var(--tag-c, var(--primary));
				position: relative;
				overflow: hidden;
				transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
				cursor: default;
			}
			.tag-badge:hover {
				transform: scale(1.08) translateY(-2px);
				box-shadow: 0 0 20px color-mix(in srgb, var(--tag-c) 40%, transparent), 0 4px 12px color-mix(in srgb, var(--tag-c) 20%, transparent);
				background: color-mix(in srgb, var(--tag-c) 22%, transparent);
				border-color: var(--tag-c);
			}
			.tag-badge:active {
				transform: scale(1.02);
				transition-duration: 0.1s;
			}
			.tag-badge-dot {
				width: 6px;
				height: 6px;
				border-radius: 50%;
				background: var(--tag-c, var(--primary));
				flex-shrink: 0;
				animation: dotPulse 2s ease-in-out infinite;
			}
			@keyframes dotPulse {
				0%, 100% { opacity: 1; transform: scale(1); }
				50% { opacity: 0.6; transform: scale(0.8); }
			}
			/* Sizes */
			.tag-sm { font-size: 0.45rem; padding: 2px 8px; }
			.tag-sm .tag-badge-dot { width: 4px; height: 4px; }
			.tag-md { font-size: 0.55rem; }
			.tag-lg { font-size: 0.65rem; padding: 5px 14px; }
			.tag-lg .tag-badge-dot { width: 7px; height: 7px; }

			/* ── GLOW: resplandor pulsante que respira ── */
			.tag-anim-glow {
				animation: tagGlow 2.5s ease-in-out infinite;
			}
			.tag-anim-glow:hover {
				animation: tagGlowHover 1s ease-in-out infinite;
			}
			@keyframes tagGlow {
				0%, 100% { box-shadow: 0 0 6px color-mix(in srgb, var(--tag-c) 25%, transparent); }
				50% { box-shadow: 0 0 20px color-mix(in srgb, var(--tag-c) 50%, transparent), 0 0 40px color-mix(in srgb, var(--tag-c) 15%, transparent); }
			}
			@keyframes tagGlowHover {
				0%, 100% { box-shadow: 0 0 15px color-mix(in srgb, var(--tag-c) 50%, transparent), 0 0 30px color-mix(in srgb, var(--tag-c) 25%, transparent); }
				50% { box-shadow: 0 0 30px color-mix(in srgb, var(--tag-c) 70%, transparent), 0 0 60px color-mix(in srgb, var(--tag-c) 30%, transparent); }
			}

			/* ── PULSE: escala orgánica suave ── */
			.tag-anim-pulse {
				animation: tagPulse 3s cubic-bezier(0.37, 0, 0.63, 1) infinite;
			}
			.tag-anim-pulse:hover {
				animation: tagPulseHover 0.6s ease-in-out infinite;
			}
			@keyframes tagPulse {
				0%, 100% { transform: scale(1); }
				50% { transform: scale(1.04); }
			}
			@keyframes tagPulseHover {
				0%, 100% { transform: scale(1.08) translateY(-2px); }
				50% { transform: scale(1.12) translateY(-3px); }
			}

			/* ── SHAKE: vibración dinámica ── */
			.tag-anim-shake {
				animation: tagShake 4s ease-in-out infinite;
			}
			.tag-anim-shake:hover {
				animation: tagShakeHover 0.5s ease-in-out infinite;
			}
			@keyframes tagShake {
				0%, 80%, 100% { transform: translateX(0) rotate(0); }
				85% { transform: translateX(-1.5px) rotate(-1deg); }
				90% { transform: translateX(1.5px) rotate(1deg); }
				95% { transform: translateX(-1px) rotate(-0.5deg); }
			}
			@keyframes tagShakeHover {
				0%, 100% { transform: translateX(-2px) rotate(-1deg); }
				25% { transform: translateX(2px) rotate(1deg); }
				50% { transform: translateX(-1.5px) rotate(-0.5deg); }
				75% { transform: translateX(1.5px) rotate(0.5deg); }
			}

			/* ── SHIMMER: destello de luz diagonal ── */
			.tag-anim-shimmer {
				overflow: hidden;
			}
			.tag-anim-shimmer::before {
				content: '';
				position: absolute;
				top: -50%;
				left: -100%;
				width: 60%;
				height: 200%;
				background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.3) 50%, transparent 60%);
				animation: tagShimmer 3s ease-in-out infinite;
			}
			.tag-anim-shimmer:hover::before {
				animation: tagShimmerFast 1s ease-in-out infinite;
			}
			@keyframes tagShimmer {
				0% { left: -100%; }
				100% { left: 200%; }
			}
			@keyframes tagShimmerFast {
				0% { left: -100%; }
				100% { left: 200%; }
			}

			/* ── BORDER GLOW: borde que respira ── */
			.tag-anim-border-glow {
				animation: borderGlow 3s ease-in-out infinite;
			}
			@keyframes borderGlow {
				0%, 100% { border-color: color-mix(in srgb, var(--tag-c) 40%, transparent); }
				50% { border-color: var(--tag-c); }
			}

			/* ── FLOAT: flotación sutil ── */
			.tag-anim-float {
				animation: tagFloat 3s ease-in-out infinite;
			}
			@keyframes tagFloat {
				0%, 100% { transform: translateY(0); }
				50% { transform: translateY(-3px); }
			}
		</style>
	</head>
	<body class="selection:bg-wild-orange/50 selection:text-[var(--text)] overflow-x-hidden" style={`--primary: ${config.primary_color}; --secondary: ${config.secondary_color}; --wild-orange: ${config.primary_color}; --wild-red: ${config.secondary_color}; --tenant-primary: ${config.primary_color}; --tenant-secondary: ${config.secondary_color}; --tenant-glow: ${config.primary_color}33;`}>
		<header class="fixed top-0 left-0 right-0 z-[1000] border-b-2 border-[var(--border)] shadow-2xl transition-all duration-500 wg-header" style="background: var(--bg);">
						<div class="w-full mx-auto px-4 md:px-8 h-20 flex items-center justify-between gap-2">
							<div class="flex items-center gap-2 md:gap-4 flex-shrink-0">
								<button id="sidebar-trigger" class="p-2 text-[var(--text)] hover:text-[var(--primary)] transition-all transform active:scale-90" aria-label="Abrir menú">
									<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="12" x2="21" y2="12"></line><line x1="3" y1="6" x2="21" y2="6"></line><line x1="3" y1="18" x2="21" y2="18"></line></svg>
								</button>

								<a href="/" class="flex items-center gap-0.5 group min-w-max">
									<img src="/wg_logo.png" alt="Wild Gvng" class="w-7 h-7 object-contain flex-shrink-0 wg-logo-img" />
									<span class="allow-color text-xl md:text-2xl font-black tracking-tighter text-[var(--text)] italic leading-none group-hover:scale-105 transition-transform origin-left wg-wild-text">WILD</span>
									<span class="allow-color text-xl md:text-2xl font-black tracking-tighter text-wild-orange italic leading-none group-hover:scale-105 transition-transform origin-left wg-gvng-text">GVNG</span>
								</a>
							</div>

				<nav class="hidden lg:flex items-center gap-0 flex-1 justify-center overflow-x-auto">
					{navItems.map(item => (
						<a
							href={item.href}
							class={`px-1.5 xl:px-2 py-1.5 text-[8px] xl:text-[9px] font-black uppercase tracking-[0.12em] rounded-full transition-all duration-300 whitespace-nowrap flex-shrink-0 ${isActive(item.href) ? 'text-[var(--primary)] bg-[var(--primary-soft)]' : 'text-[var(--text)] hover:text-[var(--primary)] hover:bg-[var(--bg-hover)]'}`}
						>
							<span class="flex items-center gap-1">
								<svg class="w-3 h-3 xl:w-3.5 xl:h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
									{item.iconPaths.map(path => <path d={path} />)}
								</svg>
								{item.label}
							</span>
						</a>
					))}
				</nav>

				<div class="flex items-center gap-1 xl:gap-2 flex-shrink-0 wg-right-section">
															<!-- Header Action Icons -->
