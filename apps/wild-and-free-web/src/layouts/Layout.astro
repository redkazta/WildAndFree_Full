---
import SidebarLeft from '../components/SidebarLeft.astro';

export type Props = {
  config: {
    name: string;
    primary_color: string;
    secondary_color: string;
  };
};

const { config } = Astro.props;
---

<!doctype html>
<html lang="es">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<title>{config.name}</title>
		
		<style is:global>
			@import url('https://fonts.googleapis.com/css2?family=Outfit:wght@100;300;400;500;600;700;800;900&display=swap');

			:root {
				--primary: #c98300;
				--secondary: #8a0303;
			}

			html {
				scroll-behavior: smooth;
				background: #000;
			}

			body {
				margin: 0;
				-webkit-font-smoothing: antialiased;
				-moz-osx-font-smoothing: grayscale;
				font-family: 'Outfit', sans-serif;
			}

			/* Custom Scrollbar */
			::-webkit-scrollbar {
				width: 8px;
			}
			::-webkit-scrollbar-track {
				background: #000;
			}
			::-webkit-scrollbar-thumb {
				background: #333;
				border-radius: 10px;
			}
			::-webkit-scrollbar-thumb:hover {
				background: #444;
			}

			.sidebar-open #sidebar {
				left: 0 !important;
			}

			.sidebar-open main {
				opacity: 0.2;
				filter: blur(15px);
				pointer-events: none;
			}

			.text-contrast {
				color: rgba(255, 255, 255, 0.95);
			}
			
			.text-muted {
				color: rgba(255, 255, 255, 0.65);
			}
		</style>
	</head>
	<body class="bg-black text-white selection:bg-orange-500/30 selection:text-orange-200 overflow-x-hidden" style={`--primary: ${config.primary_color}; --secondary: ${config.secondary_color};`}>
		<header class="fixed top-0 left-0 right-0 z-[1000] bg-black/90 backdrop-blur-2xl border-b border-white/10 shadow-2xl transition-all duration-500">
			<div class="max-w-[1440px] mx-auto px-6 h-20 flex items-center justify-between">
				<div class="flex items-center gap-6">
					<button id="menu-toggle" class="group flex flex-col gap-1.5 p-3 -ml-3 hover:bg-white/10 rounded-xl transition-all duration-300" aria-label="Menú">
						<span class="w-6 h-0.5 bg-white group-hover:bg-orange-500 transition-all duration-300"></span>
						<span class="w-6 h-0.5 bg-white group-hover:bg-orange-500 transition-all duration-300"></span>
						<span class="w-6 h-0.5 bg-white group-hover:bg-orange-500 transition-all duration-300"></span>
					</button>
					<a href="/" class="flex flex-col leading-none group">
						<div class="text-2xl font-black tracking-[0.15em] transition-transform duration-300 group-hover:scale-105">
							<span class="text-orange-500">WILD</span>
							<span class="text-white">GVNG</span>
						</div>
					</a>
				</div>
				
				<nav class="hidden lg:flex items-center gap-2">
					<a href="/artistas" class="px-6 py-2.5 text-[12px] font-extrabold uppercase tracking-[0.15em] text-white hover:text-orange-500 hover:bg-white/5 rounded-full transition-all duration-300">
						Artistas
					</a>
					<a href="/musica" class="px-6 py-2.5 text-[12px] font-extrabold uppercase tracking-[0.15em] text-white hover:text-orange-500 hover:bg-white/5 rounded-full transition-all duration-300">
						Música
					</a>
					<a href="/eventos" class="px-6 py-2.5 text-[12px] font-extrabold uppercase tracking-[0.15em] text-white hover:text-orange-500 hover:bg-white/5 rounded-full transition-all duration-300">
						Eventos
					</a>
					<a href="/tienda" class="px-6 py-2.5 text-[12px] font-extrabold uppercase tracking-[0.15em] text-white hover:text-orange-500 hover:bg-white/5 rounded-full transition-all duration-300">
						Tienda
					</a>
				</nav>
				
				<div class="flex items-center gap-2 md:gap-6">
					<!-- Header Action Icons -->
					<div class="hidden sm:flex items-center gap-1 border-r border-white/10 pr-4 mr-2">
						<button class="p-2.5 text-white hover:text-orange-500 hover:bg-white/5 rounded-lg transition-all" title="Ubicación">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
						</button>
						<button class="p-2.5 text-white hover:text-orange-500 hover:bg-white/5 rounded-lg transition-all relative" title="Favoritos">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M20.84 4.61a5.5 5.5 0 0 0-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 0 0-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 0 0 0-7.78z"/></svg>
							<span class="absolute top-1.5 right-1.5 w-4 h-4 bg-orange-500 text-black text-[10px] font-black rounded-full flex items-center justify-center">0</span>
						</button>
						<button class="p-2.5 text-white hover:text-orange-500 hover:bg-white/5 rounded-lg transition-all relative" title="Carrito">
							<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
							<span class="absolute top-1.5 right-1.5 w-4 h-4 bg-orange-500 text-black text-[10px] font-black rounded-full flex items-center justify-center">0</span>
						</button>
					</div>

					<div class="flex items-center gap-4">
						<a href="/login" class="hidden sm:block text-[12px] font-extrabold uppercase tracking-[0.15em] text-white hover:text-orange-500 transition-colors">Entrar</a>
						<a href="/registro" class="px-8 py-3 bg-white text-black text-[12px] font-black uppercase tracking-[0.15em] rounded-full hover:bg-orange-500 transition-all duration-300 transform hover:-translate-y-0.5 shadow-xl shadow-white/10">Unirse</a>
					</div>
				</div>
			</div>
		</header>
		
		<SidebarLeft />
		
		<main class="transition-all duration-500">
			<slot />
		</main>
		
		<script>
			// Menu Toggle Logic
			const menuToggle = document.getElementById('menu-toggle');
			const body = document.body;
			const sidebar = document.getElementById('sidebar');

			if (menuToggle) {
				menuToggle.addEventListener('click', (e) => {
					e.stopPropagation();
					body.classList.toggle('sidebar-open');
				});
			}

			// Close sidebar when clicking outside
			document.addEventListener('click', (e) => {
				if (body.classList.contains('sidebar-open')) {
					if (sidebar && !sidebar.contains(e.target as Node) && !menuToggle?.contains(e.target as Node)) {
						body.classList.remove('sidebar-open');
					}
				}
			});

			// Header background on scroll
			const header = document.querySelector('header');
			window.addEventListener('scroll', () => {
				if (window.scrollY > 50) {
					header?.classList.add('bg-black/95', 'py-4');
					header?.classList.remove('bg-black/80', 'py-6');
				} else {
					header?.classList.add('bg-black/80', 'py-6');
					header?.classList.remove('bg-black/95', 'py-4');
				}
			});
		</script>
	</body>
</html>