---
import Analytics from '@vercel/analytics/astro';

interface Props {
  title: string;
  activeModule?: string;
}

const { title, activeModule = 'dashboard' } = Astro.props;

const modules = [
  { id: 'dashboard', label: 'Dashboard', icon: '📊', href: '/erp' },
  { id: 'pedidos', label: 'Pedidos', icon: '📦', href: '/erp/pedidos' },
  { id: 'inventario', label: 'Inventario', icon: '🏷️', href: '/erp/inventario' },
  { id: 'contenido', label: 'Contenido', icon: '🎬', href: '/erp/contenido' },
  { id: 'usuarios', label: 'Usuarios', icon: '👥', href: '/erp/usuarios' },
  { id: 'tags', label: 'Tags', icon: '🏷️', href: '/erp/tags' },
  { id: 'eventos', label: 'Eventos', icon: '🎤', href: '/erp/eventos' },
  { id: 'versus', label: 'Versus', icon: '⚔️', href: '/erp/versus' },
  { id: 'correos', label: 'Correos', icon: '📧', href: '/erp/correos' },
  { id: 'configuracion', label: 'Config', icon: '⚙️', href: '/erp/configuracion' },
];
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} | Wild Gvng ERP</title>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap" rel="stylesheet" />
</head>
<body class="erp-body">
  <!-- Sidebar -->
  <aside class="erp-sidebar" id="sidebar">
    <div class="erp-sidebar-header">
      <a href="/erp" class="erp-logo">
        <div class="erp-logo-icon">
          <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 200 280" width="28" height="36" fill="none" stroke="currentColor" stroke-width="8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M 100 20 L 160 80 L 160 160 L 100 200 L 40 160 L 40 80 Z" fill="none" stroke="currentColor" stroke-width="8"/>
            <line x1="60" y1="100" x2="85" y2="110"/>
            <line x1="115" y1="110" x2="140" y2="100"/>
            <path d="M 90 135 Q 100 145 110 135" fill="none" stroke="currentColor" stroke-width="6"/>
            <line x1="100" y1="200" x2="100" y2="230"/>
            <circle cx="100" cy="255" r="20" fill="currentColor" stroke="none"/>
            <circle cx="108" cy="250" r="16" fill="#000" stroke="none"/>
            <circle cx="95" cy="260" r="18" fill="#000" stroke="none"/>
            <line x1="30" y1="235" x2="50" y2="255"/>
            <line x1="50" y1="235" x2="30" y2="255"/>
            <line x1="155" y1="240" x2="180" y2="240"/>
            <line x1="180" y1="240" x2="155" y2="270"/>
            <line x1="155" y1="270" x2="180" y2="270"/>
          </svg>
        </div>
        <div class="erp-logo-text">
          <span class="erp-logo-wild">WILD</span>
          <span class="erp-logo-gvng">GVNG</span>
        </div>
      </a>
      <span class="erp-badge">ERP</span>
    </div>

    <nav class="erp-nav">
      {modules.map(m => (
        <a
          href={m.href}
          class={`erp-nav-item ${activeModule === m.id ? 'erp-nav-item--active' : ''}`}
        >
          <span class="erp-nav-icon">{m.icon}</span>
          <span class="erp-nav-label">{m.label}</span>
          {activeModule === m.id && <span class="erp-nav-indicator"></span>}
        </a>
      ))}
    </nav>

    <div class="erp-sidebar-footer">
      <div class="erp-user-section">
        <div class="erp-user-avatar" id="erpUserAvatar">A</div>
        <div class="erp-user-info">
          <span class="erp-user-name" id="erpUserName">Admin</span>
          <span class="erp-user-role" id="erpUserBadge">Cargando...</span>
        </div>
      </div>
      <a href="/" class="erp-nav-item erp-nav-item--exit">
        <span class="erp-nav-icon">🚪</span>
        <span class="erp-nav-label">Salir</span>
      </a>
    </div>
  </aside>

  <!-- Main -->
  <div class="erp-main">
    <header class="erp-topbar">
      <button class="erp-menu-toggle" id="menuToggle" aria-label="Menu">
        <span></span><span></span><span></span>
      </button>
      <div class="erp-topbar-left">
        <h1 class="erp-page-title">{title}</h1>
        <span class="erp-page-subtitle">Panel de control</span>
      </div>
      <div class="erp-topbar-right">
        <div class="erp-search">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <input type="text" placeholder="Buscar..." class="erp-search-input" />
        </div>
        <div class="erp-notifications">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
          <span class="erp-notifications-badge">3</span>
        </div>
      </div>
    </header>
    <main class="erp-content">
      <slot />
    </main>
  </div>

  <style is:global>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    .erp-body {
      display: flex;
      min-height: 100vh;
      background: #050505;
      color: #e0e0e0;
      font-family: 'Space Grotesk', system-ui, sans-serif;
    }

    /* Sidebar */
    .erp-sidebar {
      width: 260px;
      background: linear-gradient(180deg, #0d0d0d 0%, #080808 100%);
      border-right: 1px solid rgba(255,255,255,0.04);
      display: flex;
      flex-direction: column;
      position: fixed;
      top: 0;
      left: 0;
      bottom: 0;
      z-index: 50;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
    }

    .erp-sidebar::before {
      content: '';
      position: absolute;
      top: 0;
      right: 0;
      width: 1px;
      height: 100%;
      background: linear-gradient(180deg, transparent 0%, rgba(201,131,0,0.3) 50%, transparent 100%);
    }

    .erp-sidebar-header {
      padding: 24px 20px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      border-bottom: 1px solid rgba(255,255,255,0.04);
    }

    .erp-logo {
      display: flex;
      align-items: center;
      gap: 12px;
      text-decoration: none;
    }

    .erp-logo-icon {
      width: 36px;
      height: 36px;
      background: linear-gradient(135deg, #C98300 0%, #FF5500 100%);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 16px;
      font-weight: 900;
      color: #000;
      box-shadow: 0 4px 12px rgba(201,131,0,0.3);
    }

    .erp-logo-text {
      display: flex;
      flex-direction: column;
      line-height: 1;
    }

    .erp-logo-wild {
      font-size: 14px;
      font-weight: 700;
      color: #fff;
      letter-spacing: 0.1em;
    }

    .erp-logo-gvng {
      font-size: 10px;
      font-weight: 500;
      color: rgba(255,255,255,0.4);
      letter-spacing: 0.2em;
    }

    .erp-badge {
      font-size: 8px;
      font-weight: 700;
      letter-spacing: 0.15em;
      background: rgba(201,131,0,0.15);
      color: #C98300;
      padding: 4px 8px;
      border-radius: 6px;
      border: 1px solid rgba(201,131,0,0.2);
    }

    .erp-nav {
      flex: 1;
      padding: 16px 12px;
      display: flex;
      flex-direction: column;
      gap: 4px;
      overflow-y: auto;
    }

    .erp-nav-item {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 11px 14px;
      border-radius: 10px;
      text-decoration: none;
      color: rgba(255,255,255,0.4);
      font-size: 13px;
      font-weight: 500;
      transition: all 0.2s ease;
      position: relative;
    }

    .erp-nav-item:hover {
      background: rgba(255,255,255,0.04);
      color: rgba(255,255,255,0.8);
    }

    .erp-nav-item--active {
      background: rgba(201,131,0,0.1);
      color: #C98300;
      font-weight: 600;
    }

    .erp-nav-item--active::before {
      content: '';
      position: absolute;
      left: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 3px;
      height: 20px;
      background: #C98300;
      border-radius: 0 3px 3px 0;
    }

    .erp-nav-icon { font-size: 16px; width: 24px; text-align: center; }

    .erp-nav-indicator { display: none; }

    .erp-sidebar-footer {
      padding: 16px 12px;
      border-top: 1px solid rgba(255,255,255,0.04);
    }

    .erp-user-section {
      display: flex;
      align-items: center;
      gap: 10px;
      padding: 10px 14px;
      margin-bottom: 8px;
      border-radius: 10px;
      background: rgba(255,255,255,0.02);
    }

    .erp-user-avatar {
      width: 32px;
      height: 32px;
      border-radius: 8px;
      background: linear-gradient(135deg, #C98300 0%, #FF5500 100%);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 12px;
      font-weight: 700;
      color: #000;
    }

    .erp-user-info {
      display: flex;
      flex-direction: column;
    }

    .erp-user-name {
      font-size: 12px;
      font-weight: 600;
      color: #fff;
    }

    .erp-user-role {
      font-size: 10px;
      font-weight: 500;
      color: rgba(255,255,255,0.4);
      text-transform: uppercase;
      letter-spacing: 0.1em;
    }

    .erp-nav-item--exit:hover {
      background: rgba(255,68,68,0.1);
      color: #ff4444;
    }

    /* Main */
    .erp-main {
      flex: 1;
      margin-left: 260px;
      display: flex;
      flex-direction: column;
      min-height: 100vh;
    }

    .erp-topbar {
      display: flex;
      align-items: center;
      gap: 16px;
      padding: 16px 28px;
      background: rgba(5,5,5,0.8);
      border-bottom: 1px solid rgba(255,255,255,0.04);
      backdrop-filter: blur(20px);
      position: sticky;
      top: 0;
      z-index: 40;
    }

    .erp-menu-toggle {
      display: none;
      flex-direction: column;
      gap: 5px;
      background: none;
      border: none;
      cursor: pointer;
      padding: 4px;
    }

    .erp-menu-toggle span {
      width: 20px;
      height: 2px;
      background: #fff;
      border-radius: 2px;
      transition: all 0.2s;
    }

    .erp-topbar-left {
      display: flex;
      flex-direction: column;
    }

    .erp-page-title {
      font-size: 18px;
      font-weight: 700;
      letter-spacing: -0.02em;
      color: #fff;
    }

    .erp-page-subtitle {
      font-size: 11px;
      color: rgba(255,255,255,0.3);
      letter-spacing: 0.05em;
    }

    .erp-topbar-right {
      margin-left: auto;
      display: flex;
      align-items: center;
      gap: 12px;
    }

    .erp-search {
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 8px 14px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.06);
      border-radius: 10px;
      transition: all 0.2s;
    }

    .erp-search:focus-within {
      border-color: rgba(201,131,0,0.3);
      background: rgba(255,255,255,0.06);
    }

    .erp-search svg { color: rgba(255,255,255,0.3); }

    .erp-search-input {
      background: none;
      border: none;
      outline: none;
      color: #fff;
      font-size: 12px;
      font-family: inherit;
      width: 160px;
    }

    .erp-search-input::placeholder { color: rgba(255,255,255,0.25); }

    .erp-notifications {
      position: relative;
      padding: 8px;
      border-radius: 10px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.06);
      cursor: pointer;
      transition: all 0.2s;
    }

    .erp-notifications:hover {
      background: rgba(255,255,255,0.08);
    }

    .erp-notifications svg { color: rgba(255,255,255,0.5); }

    .erp-notifications-badge {
      position: absolute;
      top: -2px;
      right: -2px;
      width: 16px;
      height: 16px;
      background: #ff4444;
      border-radius: 50%;
      font-size: 9px;
      font-weight: 700;
      color: #fff;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .erp-content {
      flex: 1;
      padding: 28px;
    }

    /* Cards */
    .erp-card {
      background: rgba(255,255,255,0.02);
      border: 1px solid rgba(255,255,255,0.05);
      border-radius: 14px;
      padding: 24px;
      transition: all 0.2s ease;
    }

    .erp-card:hover {
      border-color: rgba(255,255,255,0.08);
      background: rgba(255,255,255,0.03);
    }

    .erp-card-title {
      font-size: 11px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: rgba(255,255,255,0.35);
      margin-bottom: 12px;
    }

    .erp-stat {
      font-size: 32px;
      font-weight: 700;
      color: #fff;
      letter-spacing: -0.03em;
    }

    .erp-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
    }

    /* Tables */
    .erp-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 13px;
    }

    .erp-table th {
      text-align: left;
      padding: 12px 16px;
      font-size: 10px;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.12em;
      color: rgba(255,255,255,0.3);
      border-bottom: 1px solid rgba(255,255,255,0.05);
    }

    .erp-table td {
      padding: 12px 16px;
      border-bottom: 1px solid rgba(255,255,255,0.03);
      color: rgba(255,255,255,0.7);
    }

    .erp-table tr:hover td {
      background: rgba(255,255,255,0.02);
    }

    /* Status badges */
    .erp-status {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      font-size: 10px;
      font-weight: 600;
      padding: 4px 10px;
      border-radius: 6px;
      text-transform: uppercase;
      letter-spacing: 0.06em;
    }

    .erp-status::before {
      content: '';
      width: 6px;
      height: 6px;
      border-radius: 50%;
    }

    .erp-status--pending { background: rgba(255,200,0,0.1); color: #ffc800; }
    .erp-status--pending::before { background: #ffc800; }
    .erp-status--approved { background: rgba(0,255,136,0.1); color: #00ff88; }
    .erp-status--approved::before { background: #00ff88; }
    .erp-status--rejected { background: rgba(255,68,68,0.1); color: #ff4444; }
    .erp-status--rejected::before { background: #ff4444; }
    .erp-status--shipped { background: rgba(0,191,255,0.1); color: #00bfff; }
    .erp-status--shipped::before { background: #00bfff; }
    .erp-status--delivered { background: rgba(0,255,136,0.1); color: #00ff88; }
    .erp-status--delivered::before { background: #00ff88; }
    .erp-status--paid { background: rgba(0,255,136,0.1); color: #00ff88; }
    .erp-status--paid::before { background: #00ff88; }

    /* Buttons */
    .erp-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 10px 18px;
      border-radius: 10px;
      border: none;
      font-size: 12px;
      font-weight: 600;
      cursor: pointer;
      transition: all 0.2s ease;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-family: inherit;
    }

    .erp-btn--primary {
      background: linear-gradient(135deg, #C98300 0%, #e69500 100%);
      color: #000;
      box-shadow: 0 4px 12px rgba(201,131,0,0.25);
    }

    .erp-btn--primary:hover {
      transform: translateY(-1px);
      box-shadow: 0 6px 16px rgba(201,131,0,0.35);
    }

    .erp-btn--ghost {
      background: rgba(255,255,255,0.04);
      color: rgba(255,255,255,0.7);
      border: 1px solid rgba(255,255,255,0.08);
    }

    .erp-btn--ghost:hover {
      background: rgba(255,255,255,0.08);
      color: #fff;
    }

    .erp-btn--danger {
      background: rgba(255,68,68,0.1);
      color: #ff4444;
      border: 1px solid rgba(255,68,68,0.15);
    }

    .erp-btn--danger:hover {
      background: rgba(255,68,68,0.2);
    }

    /* Inputs */
    .erp-input {
      width: 100%;
      padding: 10px 14px;
      background: rgba(255,255,255,0.04);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 10px;
      color: #fff;
      font-size: 13px;
      font-family: inherit;
      transition: all 0.2s;
    }

    .erp-input:focus {
      outline: none;
      border-color: rgba(201,131,0,0.4);
      background: rgba(255,255,255,0.06);
    }

    .erp-input::placeholder { color: rgba(255,255,255,0.25); }

    /* Loading */
    .erp-loading {
      text-align: center;
      padding: 80px;
      color: rgba(255,255,255,0.2);
      font-size: 13px;
      letter-spacing: 0.05em;
    }

    /* Mobile */
    @media (max-width: 768px) {
      .erp-sidebar {
        transform: translateX(-100%);
      }

      .erp-sidebar--open {
        transform: translateX(0);
        box-shadow: 20px 0 60px rgba(0,0,0,0.5);
      }

      .erp-main {
        margin-left: 0;
      }

      .erp-menu-toggle {
        display: flex;
      }

      .erp-content {
        padding: 16px;
      }

      .erp-search {
        display: none;
      }
    }
  </style>

  <script>
    import { supabase } from '../lib/supabase';
    import { getRole } from '../lib/role';

    // Auth guard
    const { role, session } = await getRole();
    const allowed = ['admin', 'staff_manager', 'staff', 'staff_marketing'];

    if (!session || !allowed.includes(role)) {
      document.body.innerHTML = `
        <div style="min-height:100vh;display:grid;place-items:center;background:#050505;color:#fff;font-family:'Space Grotesk',system-ui;">
          <div style="text-align:center;padding:40px;">
            <div style="width:64px;height:64px;background:rgba(255,68,68,0.1);border-radius:16px;display:inline-flex;align-items:center;justify-content:center;margin-bottom:20px;">
              <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#ff4444" stroke-width="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            </div>
            <h1 style="font-size:20px;font-weight:700;color:#ff4444;margin-bottom:8px;">Acceso Denegado</h1>
            <p style="color:rgba(255,255,255,0.35);margin-bottom:28px;font-size:13px;">No tienes permisos para acceder al panel de administración.</p>
            <a href="/" style="display:inline-flex;align-items:center;gap:8px;padding:10px 20px;background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);border-radius:10px;color:#C98300;text-decoration:none;font-weight:600;font-size:13px;transition:all 0.2s;">← Volver al sitio</a>
          </div>
        </div>`;
      throw new Error('Access denied');
    }

    // Store global role + immediate wildcard permissions for admin
    (window as any).__wildRole = role;

    // Load detailed permissions for this role
    let permissions: string[] = [];

    if (role === 'admin') {
      // Admin gets ALL permissions via wildcard - no need to query
      permissions = ['*'];
    } else {
      // Load permissions from DB for non-admin roles
      const { data: userRoles } = await supabase
        .from('user_roles')
        .select('role_id')
        .eq('user_id', session.user.id);

      if (userRoles && userRoles.length > 0) {
        const roleIds = userRoles.map((r: any) => r.role_id);
        const { data: rolePerms } = await supabase
          .from('role_permissions')
          .select('permissions(name)')
          .in('role_id', roleIds);

        permissions = rolePerms?.map((rp: any) => rp.permissions?.name).filter(Boolean) || [];
      }
    }

    // Store permissions globally for ERP pages
    (window as any).__wildPermissions = permissions;
    const permAttr = permissions.includes('*') ? '*' : permissions.join(',');
    document.documentElement.setAttribute('data-permissions', permAttr);

    // Show user badge with role
    const badge = document.getElementById('erpUserBadge');
    if (badge) badge.textContent = role.toUpperCase();

    const userName = document.getElementById('erpUserName');
    if (userName) userName.textContent = session.user.email?.split('@')[0] || 'Admin';

    const userAvatar = document.getElementById('erpUserAvatar');
    if (userAvatar) userAvatar.textContent = (session.user.email?.[0] || 'A').toUpperCase();

    // Hide nav items based on permissions
    const permMap: Record<string, string> = {
      'inventario': 'inventory.view',
      'contenido': 'content.view',
      'usuarios': 'users.view',
      'tags': 'tags.manage',
      'eventos': 'events.manage',
      'versus': 'versus.manage',
      'configuracion': 'config.view',
      'correos': 'config.manage',
      'pedidos': 'orders.view'
    };

    // Admin sees everything - skip permission filtering
    if (role !== 'admin') {
      document.querySelectorAll('.erp-nav-item').forEach(item => {
        const href = item.getAttribute('href') || '';
        const mod = Object.keys(permMap).find(m => href.includes(m));
        if (mod && !permissions.includes(permMap[mod])) {
          item.style.display = 'none';
        }
      });
    }

    // Mobile menu
    const toggle = document.getElementById('menuToggle');
    const sidebar = document.getElementById('sidebar');
    toggle?.addEventListener('click', () => {
      sidebar?.classList.toggle('erp-sidebar--open');
    });

    // Close sidebar on nav click (mobile)
    document.querySelectorAll('.erp-nav-item').forEach(item => {
      item.addEventListener('click', () => {
        sidebar?.classList.remove('erp-sidebar--open');
      });
    });
  </script>
  <Analytics />
</body>
</html>
